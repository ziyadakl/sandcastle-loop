        // The merge rule (tokenmaxxing#29) judges the exact commit just
        // pushed, read against the same `origin/<base>...` range
        // `branchHasShippableContent` uses.
        const { files, change, headSha } = readRunChange(args.repoRoot, base, branch, {
          issueCount: shippedIssueNums.length,
          promotionFailed: opts?.promotionFailed === true,
          breakerTripped: opts?.breakerTrip !== undefined,
          previouslyShippedCount: opts?.previouslyShipped?.length ?? 0,
        });
        const body = buildRunPrBody({ branch, shippedIssueNums, files, change, opts });

        const pr = await openDraftPr({
          head: branch,
          base,
          title: `Sandcastle run: ${branch} (${shippedIssueNums.length} issues)`,
          body,
        });
        return {
          url: pr.url,
          ...(change !== undefined && headSha !== "" ? { mergeRule: { change, headSha } } : {}),
        };
      } catch (err) {
        return { error: (err as Error).message };
      }
    },
