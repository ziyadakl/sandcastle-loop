          // matched, the figure did not. The other five are the app or the
          // environment being broken, which is nobody's side of an argument.
          // Issue #1117: without this label the disagreement is invisible to
          // every query and can never be ruled.
          verdictNeeded: opts.verdict === "graded-mismatch",
        });
      } catch (err) {
        logErr(
          `reportScreenCheckWatch(#${n}, ${opts.verdict}) failed — the ` +
            `verdict is still in this run's telemetry and in the log, but the ` +
            `issue body may not carry it: ${(err as Error).message}`,
