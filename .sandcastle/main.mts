/**
 * Parse argv into a fully-defaulted {@link SandcastleArgs}. Throws on validation
 * errors with a precise message — the CLI entry catches and exits 2.
 *
 * Exported so tests can drive the orchestrator without re-implementing the
 * full default set.
 */
export function parseSandcastleArgs(argv: readonly string[]): {
  args: SandcastleArgs;
  showHelp: boolean;
} {
  const { values } = parseArgs({
    args: [...argv],
    strict: true,
    allowPositionals: false,
    options: {
      iterations: { type: "string" },
      "max-tickets": { type: "string" },
      issue: { type: "string" },
      "repo-root": { type: "string" },
      branch: { type: "string" },
      label: { type: "string" },
      "max-concurrent": { type: "string" },
      "implementer-model": { type: "string" },
      "reviewer-model": { type: "string" },
      "critique-model": { type: "string" },
      "merger-model": { type: "string" },
      "post-merge-reviewer-model": { type: "string" },
      "recovery-model": { type: "string" },
      "implementer-timeout-sec": { type: "string" },
      "reviewer-timeout-sec": { type: "string" },
      "hard-ceiling-sec": { type: "string" },
      "consecutive-failure-limit": { type: "string" },
      "quarantine-limit": { type: "string" },
      "log-file": { type: "string" },
      "dry-run": { type: "boolean" },
      recovery: { type: "string" },
      "no-retry": { type: "boolean" },
      "no-staging": { type: "boolean" },
      "stuck-detector": { type: "boolean" },
      provider: { type: "string" },
      backend: { type: "string" },
      opus: { type: "string" },
      budget: { type: "boolean" },
      sandbox: { type: "string" },
      "image-name": { type: "string" },
      "allow-dirty-sandcastle": { type: "boolean" },
      "allow-unreachable-sandbox-db": { type: "boolean" },
      "allow-unreachable-dev-bind": { type: "boolean" },
      help: { type: "boolean" },
    },
  });

  if (values.help === true) {
    return {
      args: defaultArgs(),
      showHelp: true,
    };
  }

  // #902: the cap counts TICKETS ATTEMPTED, not rounds. `--max-tickets` is the
  // real name; `--iterations` stays as a deprecated alias for the same field so
  // launchers and muscle memory keep working.
  if (values["max-tickets"] !== undefined && values.iterations !== undefined) {
    throw new Error("pass either --max-tickets or --iterations (its deprecated alias), not both");
  }
  if (values.iterations !== undefined) {
    process.stderr.write("sandcastle: --iterations is a deprecated alias for --max-tickets\n");
  }
  const iterations = parsePositiveInt(
    values["max-tickets"] ?? values.iterations,
    values["max-tickets"] !== undefined ? "--max-tickets" : "--iterations",
  );
  if (iterations === null) {
    throw new Error("--max-tickets is required and must be an integer ≥ 1 (--iterations is a deprecated alias)");
  }

  // Env var override: when the sandcastle-wrapper.sh re-launches us after a
  // hot-reload restart, it sets SANDCASTLE_REMAINING_ITERATIONS so the
  // --iterations cap is honored across the restart boundary.
  const envRemaining = process.env.SANDCASTLE_REMAINING_ITERATIONS;
  // parsePositiveInt throws on invalid strings — we want the loud failure.
  // It only returns null for undefined input, which the outer guard rules out.
  const effectiveIterations =
    envRemaining !== undefined && envRemaining !== ""
      ? parsePositiveInt(envRemaining, "SANDCASTLE_REMAINING_ITERATIONS")!
      : iterations;

  const issue =
    values.issue !== undefined
      ? (parsePositiveInt(values.issue, "--issue") ?? undefined)
      : undefined;

  // --provider overrides the implementer model with that provider's default
  // coding model. --implementer-model still wins if both are passed (more
  // specific flag).
  let provider: ProviderName | undefined;
  if (values.provider !== undefined) {
    if (!isProviderName(values.provider)) {
      throw new Error(
        `--provider: expected one of kimi|glm|anthropic, got ${JSON.stringify(values.provider)}`,
      );
    }
    provider = values.provider;
  }

  // --backend selects the agent backend. "codex" routes every role
  // to Codex models (dispatched to sandcastle.codex by backendForModel);
  // "claude" (default) uses models.ts. --provider (kimi/glm/anthropic) is a
  // claude-backend-only endpoint switch and cannot combine with codex.
  // --backend may be given explicitly, or INFERRED from an explicit
  // --implementer-model. The two must not disagree, or policy
  // (escalations/role defaults, which key off `args.backend`) would silently
  // split from dispatch (the agent factory + AGENTS.md staging, which key off
  // the model). So:
  //   - both given and they conflict  → hard-error (you said two opposite things)
  //   - only the model given          → infer the backend from it
  //   - neither                       → default claude
  // --implementer-model is the SOLE inference source; the other role-model
  // flags are validated against the resolved backend below (never inferred), so
  // after that check the invariant holds for EVERY role: backendForModel(roleModel)
  // === backend.
  const explicitBackend: AgentBackend | undefined = (() => {
    const v = values.backend;
    if (v === undefined) return undefined;
    if (v !== "claude" && v !== "codex") {
      throw new Error(
        `--backend: expected one of claude|codex, got ${JSON.stringify(v)}`,
      );
    }
    return v;
  })();
  const explicitImplModel = values["implementer-model"];
  const implModelBackend =
    explicitImplModel !== undefined
      ? backendForModel(explicitImplModel)
      : undefined;
  if (
    explicitBackend !== undefined &&
    implModelBackend !== undefined &&
    explicitBackend !== implModelBackend
  ) {
    throw new Error(
      `--backend ${explicitBackend} contradicts --implementer-model ` +
        `"${explicitImplModel}" (a ${implModelBackend} model). Pass a matching ` +
        `model, or drop --backend to infer it from the model.`,
    );
  }
  const backend: AgentBackend = explicitBackend ?? implModelBackend ?? "claude";
  if (backend === "codex" && provider !== undefined) {
    throw new Error(
      "--provider applies only to the claude backend; it cannot combine with --backend codex",
    );
  }

  // --opus selects the Opus model profile (5.5 vs 5). NOT a backend/provider —
  // both are the anthropic provider on the claude backend, differing only by the
  // model string on the opus-heavy roles. `"5"` (claude-opus-5, 1M default) is
  // claude-backend-only, so it cannot combine with codex or a --provider swap;
  // `"5.5"` (default) is a no-op that must never error.
  const opusProfile: OpusProfile = (() => {
    const v = values.opus;
    if (v === undefined) return "5.5";
    if (v !== "5.5" && v !== "5") {
      throw new Error(
        `--opus: expected one of 5.5|5, got ${JSON.stringify(v)}`,
      );
    }
    return v;
  })();
  if (opusProfile === "5" && backend === "codex") {
    throw new Error(
      "--opus 5 applies only to the claude backend; it cannot combine with --backend codex",
    );
  }
  if (opusProfile === "5" && provider !== undefined) {
    throw new Error(
      "--opus 5 applies only to the anthropic default; it cannot combine with --provider",
    );
  }

  // --budget selects `budgetModels` (via roleModelsFor), giving the implementer
  // a "Sonnet fix-it rung" ladder — Sonnet-5 first pass, a second Sonnet-5 pass
  // WITH reviewer feedback, then Opus 1M reserved for the round-3 grant — so the
  // cheap model is spent twice before any Opus. The implementer is the loop's
  // dominant token consumer, the single lever that moves the bill.
  // Claude-anthropic-only, mirroring --opus 5: a cheaper Anthropic ladder is
  // meaningless under a codex backend or a kimi/glm provider swap (which already
  // redirects the implementer), so a combination is an operator error, not a
  // silent no-op. An explicit --implementer-model still wins below.
  const budget = values.budget === true;
  if (budget && backend === "codex") {
    throw new Error(
      "--budget applies only to the claude backend; it cannot combine with --backend codex",
    );
  }
  if (budget && provider !== undefined) {
    throw new Error(
      "--budget applies only to the anthropic default; it cannot combine with --provider",
    );
  }
  // --budget + --opus 5 express CONTRADICTORY profiles and cannot both apply:
  // budget is cheapest-first (Sonnet fix-it rung, Opus reserved for the round-3
  // grant only), while --opus 5 is Opus-5-everywhere. There is no coherent
  // single map that is both, so reject the combo at parse time. Use --budget
  // with the default (5.5) profile.
  if (budget && opusProfile === "5") {
    throw new Error(
      "--budget cannot combine with --opus 5: they express contradictory model " +
        "profiles (budget is cheapest-first, --opus 5 is Opus-5-everywhere). " +
        "Use --budget with the default (5.5) profile.",
    );
  }

  // Reconcile the OTHER role-model flags against the resolved backend. A
  // sandcastle run is single-backend end-to-end: escalations, skill-discipline,
  // and AGENTS.md staging all key off `args.backend`, while per-role dispatch
  // keys off each role's model (agentForModel / backendForModel). A cross-backend
  // role model (e.g. `--backend codex --reviewer-model <claude-id>`) would
  // silently run that role on the other agent — the same split-brain the
  // implementer reconcile above closes. These flags are validated, NOT inferred
  // (only --implementer-model infers). Hard-error at parse so the
  // contradiction surfaces before any run.
  const roleModelFlags: ReadonlyArray<readonly [string, string | undefined]> = [
    ["--reviewer-model", values["reviewer-model"]],
    ["--critique-model", values["critique-model"]],
    ["--merger-model", values["merger-model"]],
    ["--post-merge-reviewer-model", values["post-merge-reviewer-model"]],
    ["--recovery-model", values["recovery-model"]],
  ];
  const mismatchedRoleModels: Array<{
    flag: string;
    model: string;
    modelBackend: AgentBackend;
  }> = [];
  for (const [flag, value] of roleModelFlags) {
    if (value === undefined) continue;
    const modelBackend = backendForModel(value);
    if (modelBackend !== backend) {
      mismatchedRoleModels.push({ flag, model: value, modelBackend });
    }
  }
  if (mismatchedRoleModels.length > 0) {
    const details = mismatchedRoleModels
      .map((m) => `${m.flag} "${m.model}" (a ${m.modelBackend} model)`)
      .join("; ");
    throw new Error(
      `backend resolved to "${backend}", but ${details} ` +
        `${mismatchedRoleModels.length === 1 ? "is" : "are"} for a different backend. ` +
        `A sandcastle run uses one backend for every role: pass matching ${backend} ` +
        `model(s), or set --backend to match.`,
    );
  }

  const roleModels = roleModelsFor({ backend, opusProfile, budget });

  const implementerModel =
    explicitImplModel ??
    (provider !== undefined
      ? defaultCodingModelFor(provider)
      : roleModels.implementer.default);

  const sandbox: "docker" | "mac-host" = (() => {
    const v = values.sandbox;
    if (v === undefined) return "docker";
    if (v !== "docker" && v !== "mac-host") {
      throw new Error(
        `--sandbox: expected one of docker|mac-host, got ${JSON.stringify(v)}`,
      );
    }
    return v;
  })();

  // Cross-host run-branch namespacing. When the lease is
  // ON and the run branch is AUTO-derived (no explicit --branch), suffix it
  // with this host's id so two hosts never push the SAME run branch and clobber
  // each other. An explicit --branch is the operator's word — left untouched.
  // OFF: the derived branch is unchanged (byte-for-byte legacy behavior).
  // `derived` is the bare, pre-suffix branch name — the same value whether or
  // not the lease then host-suffixes `branch` — so it doubles as the shared
  // `runId`. Computed once (one `detectBranchOr` call at most) and handed to
  // {@link deriveRunBranchAndId}, which owns the runId/branch rule.
  // `deriveRunBranchAndId` early-returns on an explicit `--branch` and never
  // reads `derived`, so the `??` short-circuit means `detectBranchOr("HEAD")`
  // only runs on the auto-derived path (no separate pre-decided intermediate).
  const { branch, runId } = deriveRunBranchAndId(
    values.branch,
    values.branch ?? detectBranchOr("HEAD"),
    crossHostLeaseEnabled(),
    resolveHostId(),
  );

  const args: SandcastleArgs = {
    iterations: effectiveIterations,
    issue,
    repoRoot: values["repo-root"] ?? process.cwd(),
    branch,
    runId,
    label: values.label ?? LABEL_READY,
    maxConcurrent:
      parsePositiveInt(values["max-concurrent"], "--max-concurrent") ?? 2,
    implementerModel,
    backend,
    opusProfile,
    budget,
    reviewerModel: values["reviewer-model"] ?? roleModels.reviewer.default,
    critiqueModel: values["critique-model"] ?? roleModels.critique.default,
    mergerModel: values["merger-model"] ?? roleModels.merger.default,
    postMergeReviewerModel:
      values["post-merge-reviewer-model"] ??
      roleModels.postMergeReviewer.default,
    recoveryModel: values["recovery-model"] ?? roleModels.recovery.default,
    implementerTimeoutSec:
      parsePositiveInt(
        values["implementer-timeout-sec"],
        "--implementer-timeout-sec",
      ) ?? 1200,
    // Recorded so runMain can apply the SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC
    // env fallback ONLY when the CLI flag was absent (CLI always wins).
    implementerTimeoutSecExplicit:
      values["implementer-timeout-sec"] !== undefined,
    reviewerTimeoutSec:
      parsePositiveInt(
        values["reviewer-timeout-sec"],
        "--reviewer-timeout-sec",
      ) ?? 600,
    hardCeilingSec:
      parsePositiveInt(values["hard-ceiling-sec"], "--hard-ceiling-sec") ??
      3600,
    consecutiveFailureLimit:
      parsePositiveInt(
        values["consecutive-failure-limit"],
        "--consecutive-failure-limit",
      ) ?? 3,
    quarantineLimit:
      parsePositiveInt(values["quarantine-limit"], "--quarantine-limit") ?? 8,
    logFile: values["log-file"],
    dryRun: values["dry-run"] === true,
    recoveryEnabled: values["recovery"] !== "off",
    retryEnabled: values["no-retry"] !== true,
    stagingEnabled: values["no-staging"] !== true,
    stuckDetector: values["stuck-detector"] === true,
    provider,
    sandbox,
    imageName: resolveImageName(
      values["repo-root"] ?? process.cwd(),
      values["image-name"],
    ),
    allowDirtySandcastle: values["allow-dirty-sandcastle"] === true,
    allowUnreachableSandboxDb:
      values["allow-unreachable-sandbox-db"] === true,
    allowUnreachableDevBind:
      values["allow-unreachable-dev-bind"] === true,
  };
  return { args, showHelp: false };
}

function parsePositiveInt(raw: unknown, flag: string): number | null {
  if (raw === undefined) return null;
  if (typeof raw !== "string") {
    throw new Error(`${flag}: expected a string, got ${typeof raw}`);
  }
  const n = Number(raw);
  if (!Number.isInteger(n) || n < 1) {
    throw new Error(
      `${flag}: expected an integer ≥ 1, got ${JSON.stringify(raw)}`,
    );
  }
  return n;
}

/**
 * Best-effort detection of the current git branch. Returns `fallback` if `git`
 * is unavailable or the repo is in a detached state.
 */
function detectBranchOr(fallback: string): string {
  try {
    const out = execFileSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
    return out.length > 0 ? out : fallback;
  } catch {
    return fallback;
  }
}

/**
 * Role-model map for a run's agent backend. Codex runs draw every
 * role — defaults, retry-ladder escalations, and the post-merge fixer — from
 * `codexModels`; everything else uses the Claude `models` map. Reading
 * escalations through this (not `models.X` directly) is what keeps a
 * `--backend codex` run from silently escalating onto a Claude model.
 *
 * On the claude backend the map is selected by precedence: budget first
 * (`budgetModels` — the implementer's Sonnet fix-it rung ladder, every other
 * role verbatim from `models`), then the Opus profile (`--opus 5` →
 * `opus5Models`), then the default `models`. Codex ignores both budget and the
 * profile. `--budget` and `--opus 5` are mutually exclusive at parse time, so
 * the budget-before-opus5 ordering here is belt-and-suspenders, not a real
 * conflict.
 */
export function roleModelsFor(a: {
  readonly backend?: AgentBackend;
  readonly opusProfile?: OpusProfile;
  readonly budget?: boolean;
}) {
  if (a.backend === "codex") return codexModels;
  if (a.budget === true) return budgetModels;
  return a.opusProfile === "5" ? opus5Models : models;
}

/**
 * Resolve the implementer model for a given retry attempt by walking an
 * `escalations` ladder. Attempt 2 (the first retry) → `escalations[0]`,
 * attempt 3 → `escalations[1]`, clamped to the last element so a shorter ladder
 * simply repeats its final rung. Under the default profile the implementer's
 * two rungs are both `claude-opus-5-5`, so every retry is the same model on a
 * fresh context with the reviewer's feedback. Under `--budget` the two-rung
 * ladder yields `claude-sonnet-5` on attempt 2 (the fix-it pass, WITH the
 * reviewer's HAS_BLOCKERS feedback) and `claude-opus-5-5` on attempt 3 (the
 * round-3 grant).
 */
export function escalationForAttempt(
  escalations: readonly string[],
  attemptNumber: number,
): string {
  return escalations[Math.min(attemptNumber - 2, escalations.length - 1)];
}

/**
 * Shared bounded-escalation scaffold behind the two retry ladders (merger,
 * post-merge fixer). (The recovery pass was a third until spec #1334 SG
 * replaced it with the fixer, which gets review rounds instead.) Owns ONLY the parts every ladder shares verbatim:
 *   - max attempts = 2 when an escalation rung exists, else exactly 1. An empty
 *     `escalations` array collapses this to a single dispatch — the legacy
 *     single-attempt path, byte-for-byte (attempt 1 runs, `shouldRetry` is
 *     never consulted, `beforeRetry` never fires).
 *   - the 1-based attempt counter;
 *   - per-attempt model selection: attempt 1 uses `firstModel`, later attempts
 *     use `escalationForAttempt(escalations, attempt)`;
 *   - `beforeRetry`, invoked ONLY before an escalated (attempt > 1) dispatch —
 *     never before attempt 1 (the merger uses it to discard a partial merge by
 *     resetting staging back to the integration tip).
 *
 * The per-site differences stay in the caller's thunks, NOT in this helper:
 * `run` performs the dispatch (and, for the throw-based merger, catches
 * internally and returns a status flag), and `shouldRetry` inspects the
 * just-produced result to decide whether to escalate. Each ladder keeps its own
 * attempt/retry log lines at the call site — they differ in content AND timing
 * (the merger logs inside its catch, the post-merge fixer at the start of
 * every pass), so folding them in here would lose per-site meaning.
 * `beforeRetry` receives the previous attempt's result so a caller can name
 * the prior marker in its retry log.
 */
export async function runWithEscalation<T>(opts: {
  readonly firstModel: string;
  readonly escalations: readonly string[];
  readonly run: (model: string, attempt: number) => Promise<T>;
  readonly shouldRetry: (result: T, attempt: number) => boolean;
  readonly beforeRetry?: (
    attempt: number,
    prevResult: T,
  ) => void | Promise<void>;
}): Promise<T> {
  const maxAttempts = opts.escalations.length > 0 ? 2 : 1;
  let attempt = 1;
  let result = await opts.run(opts.firstModel, attempt);
  while (attempt < maxAttempts && opts.shouldRetry(result, attempt)) {
    attempt++;
    if (opts.beforeRetry) await opts.beforeRetry(attempt, result);
    result = await opts.run(
      escalationForAttempt(opts.escalations, attempt),
      attempt,
    );
  }
  return result;
}

/**
 * The arg bag a NON-CLI entry point starts from (see the `args: defaultArgs()`
 * call site). Every value here must equal the `??` fallback the CLI parser
 * applies for the same flag in {@link parseSandcastleArgs} — two independent
 * literals for one default is exactly how `hardCeilingSec` came to say 1800
 * here and 3600 there for four days (2026-08-03 → 2026-08-07).
 *
 * Exported for unit testing: `main.test.mts` asserts the two agree.
 */
export function defaultArgs(): SandcastleArgs {
  return {
    iterations: 1,
    repoRoot: process.cwd(),
    branch: "HEAD",
    runId: "HEAD",
    label: LABEL_READY,
    maxConcurrent: 2,
    implementerModel: models.implementer.default,
    reviewerModel: models.reviewer.default,
    critiqueModel: models.critique.default,
    mergerModel: models.merger.default,
    postMergeReviewerModel: models.postMergeReviewer.default,
    recoveryModel: models.recovery.default,
    implementerTimeoutSec: 1200,
    implementerTimeoutSecExplicit: false,
    reviewerTimeoutSec: 600,
    // MUST equal parseSandcastleArgs' own `?? 3600` fallback — see this
    // function's doc comment and SandcastleArgs.hardCeilingSec.
    hardCeilingSec: 3600,
    consecutiveFailureLimit: 3,
    quarantineLimit: 8,
    opusProfile: "5.5",
    budget: false,
    dryRun: false,
    recoveryEnabled: true,
    retryEnabled: true,
    stagingEnabled: true,
    imageName: resolveImageName(process.cwd()),
    allowDirtySandcastle: false,
    allowUnreachableSandboxDb: false,
    allowUnreachableDevBind: false,
    sandbox: "docker",
    stuckDetector: false,
  };
}

// ---------------------------------------------------------------------------
// .env loader (minimal — no new deps)
// ---------------------------------------------------------------------------

/**
 * Keys we surface in the startup-log so the user can see which source each
 * one resolved from. PATH and friends would spam the log.
 */
const LOGGED_ENV_KEYS = new Set([
  "KIMI_API_KEY",
  "GLM_API_KEY",
  "ANTHROPIC_API_KEY",
  // The account pool's address and key (see POOL_ENV_KEYS / poolEnv).
  "ANTHROPIC_BASE_URL",
  "ANTHROPIC_AUTH_TOKEN",
  "GH_TOKEN",
  // Cross-host issue lease config — surfaced so an operator can
  // see at a glance whether the opt-in lease is on and how it's tuned.
  "SANDCASTLE_CROSS_HOST_LEASE",
  // Cross-host LANE SYNC (Task B) — code-sharing opt-in. Requires the
  // lease (see the startup guard in runMain); surfaced so an operator can see
  // at a glance whether lane sync is on.
  "SANDCASTLE_CROSS_HOST_SYNC",
  "SANDCASTLE_HOST_ID",
  "SANDCASTLE_LOCK_TTL_SEC",
  // First-pass reviewer escalation knobs — surfaced so an operator can see how
  // the "run the strong reviewer on big/sensitive diffs" policy is tuned.
  "SANDCASTLE_REVIEW_ESCALATE_DIFF_LINES",
  "SANDCASTLE_REVIEW_ESCALATE_PATHS",
]);

/**
 * Read env `key` via `getEnv`, normalize (`?? ""` default, trim, lowercase),
 * and return whether it reads as a truthy flag ("1"/"true", case-insensitive).
 * Shared body for the cross-host opt-in flags below.
 */
function envFlagEnabled(
  getEnv: (key: string) => string | undefined,
  key: string,
): boolean {
  const v = (getEnv(key) ?? "").trim().toLowerCase();
  return v === "1" || v === "true";
}

/**
 * Whether the cross-host issue lease is enabled for this run. OFF by
 * default: with the flag unset every lease dep is a byte-for-byte no-op, so a
 * single-host consumer never needs the new `git push` auth. Truthy = "1"/"true"
 * (case-insensitive). `getEnv` is an injectable seam for tests.
 */
function crossHostLeaseEnabled(
  getEnv: (key: string) => string | undefined = (k) => process.env[k],
): boolean {
  return envFlagEnabled(getEnv, "SANDCASTLE_CROSS_HOST_LEASE");
}

/**
 * Whether cross-host LANE SYNC (Task B) is enabled for this run. OFF
 * by default: with the flag unset both lane deps (syncLanes / publishLane) are
 * byte-for-byte no-ops, so a single-host consumer never fetches/pushes/ls-remotes
 * a lane ref and needs no new git auth. Truthy = "1"/"true" (case-insensitive),
 * matching {@link crossHostLeaseEnabled}. Sync REQUIRES the lease — sharing code
 * without the per-issue lock is unsafe — enforced by a LOUD startup guard in
 * runMain. `getEnv` is an injectable seam for tests.
 */
function crossHostSyncEnabled(
  getEnv: (key: string) => string | undefined = (k) => process.env[k],
): boolean {
  return envFlagEnabled(getEnv, "SANDCASTLE_CROSS_HOST_SYNC");
}

/**
 * Resolve the `SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC` env fallback for the
 * implementer idle-timeout. Returns the parsed positive integer, or null when
 * the var is unset OR blank/whitespace-only. A blank value is the shipped state
 * (`.env.example` ships the key with an empty value) and MUST be treated as
 * unset — falling through to the 1200 default, NOT crashing. This mirrors
 * {@link resolveLockTtlSec}, the sibling numeric env var that ships blank the
 * same way. A genuinely malformed value (e.g. "abc") still throws a
 * clearly-labeled error (reusing {@link parsePositiveInt}). `getEnv` is an
 * injectable seam for tests, matching {@link crossHostLeaseEnabled}. This must
 * be read in runMain, NOT at parse time: `loadDotenv` runs in the entrypoint
 * AFTER `parseSandcastleArgs` but BEFORE runMain, so the `.sandcastle/.env`
 * value isn't visible until then.
 */
export function implementerTimeoutFromEnv(
  getEnv: (key: string) => string | undefined = (k) => process.env[k],
): number | null {
  const raw = (getEnv("SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC") ?? "").trim();
  if (raw === "") return null;
  return parsePositiveInt(raw, "SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC");
}

/** Parse a single .env file into process.env. Earlier writers win — we never
 * overwrite an existing value. Silently no-ops if the file doesn't exist.
 * Returns the map of keys this file contributed (only counts the keys it
 * actually set, not ones that were already populated by an earlier source).
 */
function parseEnvFileInto(filePath: string): Record<string, true> {
  const contributed: Record<string, true> = {};
  if (!existsSync(filePath)) return contributed;
  const raw = readFileSync(filePath, "utf8");
  for (const rawLine of raw.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (line === "" || line.startsWith("#")) continue;
    const eq = line.indexOf("=");
    if (eq <= 0) continue;
    const key = line.slice(0, eq).trim();
    let value = line.slice(eq + 1).trim();
    const isDoubleQuoted = value.startsWith('"') && value.endsWith('"');
    const isSingleQuoted = value.startsWith("'") && value.endsWith("'");
    if (isDoubleQuoted || isSingleQuoted) {
      value = value.slice(1, -1);
    }
    // Double-quoted values get standard dotenv escape semantics: \n → newline,
    // \r → CR, \t → tab, \\ → literal backslash. Single-quoted stays literal.
    // Single-pass regex w/ callback so `\\n` resolves to `\n` literal, not LF.
    if (isDoubleQuoted) {
      value = value.replace(/\\([\\nrt])/g, (_match, ch: string) => {
        if (ch === "n") return "\n";
        if (ch === "r") return "\r";
        if (ch === "t") return "\t";
        return "\\";
      });
    }
    if (!(key in process.env)) {
      process.env[key] = value;
      contributed[key] = true;
    }
  }
  return contributed;
}

/**
 * Resolve sandcastle's env vars from a lookup chain into `process.env`.
 * Earlier sources win per-key; later sources only fill keys still missing.
 *
 * Order:
 *   1. process.env (shell exports — implicit; we never overwrite)
 *   2. $SANDCASTLE_ENV_FILE if set (escape hatch for secret-manager piping)
 *   3. <repoRoot>/.sandcastle/.env (sandcastle-specific overrides)
 *   4. <repoRoot>/.env (project-local override)
 *   5. $XDG_CONFIG_HOME/sandcastle/.env or ~/.config/sandcastle/.env
 *      (host-level default — write once per machine)
 *
 * The host-level path means a user can put `KIMI_API_KEY` once in
 * `~/.config/sandcastle/.env` and have every project + every worktree
 * inherit it. Per-project `.env` still wins for overrides.
 *
 * Exception: the pool settings (POOL_ENV_KEYS) come only from these files. A
 * launching shell's copy is dropped first: a Claude desktop-app session exports
 * ANTHROPIC_BASE_URL=https://api.anthropic.com into the shells it spawns, and
 * mac-host agents inherit process.env wholesale.
 *
 * Logs which source each known key came from. Unknown keys load silently.
 * Parser is intentionally tiny — install `dotenv` and replace `parseEnvFileInto`
 * if you need multiline / variable expansion.
 */
export function loadDotenv(repoRoot: string): void {
  for (const key of POOL_ENV_KEYS) {
    if (key in process.env) {
      delete process.env[key];
      console.log(
        `[env] ${key}: ignored the launching shell's value (pool settings come only from the sandcastle settings files)`,
      );
    }
  }
  const sources: { label: string; path: string }[] = [];
  const explicit = process.env.SANDCASTLE_ENV_FILE;
  if (explicit && explicit.trim() !== "") {
    sources.push({ label: "$SANDCASTLE_ENV_FILE", path: explicit });
  }
  sources.push({
    label: "<repoRoot>/.sandcastle/.env",
    path: path.join(repoRoot, ".sandcastle", ".env"),
  });
  sources.push({ label: "<repoRoot>/.env", path: path.join(repoRoot, ".env") });
  const xdg = process.env.XDG_CONFIG_HOME;
  const hostDir =
    xdg && xdg.trim() !== ""
      ? path.join(xdg, "sandcastle")
      : path.join(os.homedir(), ".config", "sandcastle");
  sources.push({
    label: "~/.config/sandcastle/.env",
    path: path.join(hostDir, ".env"),
  });

  const resolvedFrom = new Map<string, string>();
  for (const src of sources) {
    const got = parseEnvFileInto(src.path);
    for (const key of Object.keys(got)) {
      if (!resolvedFrom.has(key)) resolvedFrom.set(key, src.label);
    }
  }
  for (const key of LOGGED_ENV_KEYS) {
    if (process.env[key] && process.env[key]!.trim() !== "") {
      const from = resolvedFrom.get(key) ?? "process.env (shell)";
      console.log(`[env] ${key} ← ${from}`);
    }
  }
}

/**
 * Paths copied into each per-iteration worktree/container (Docker path) alongside
 * the git checkout. `node_modules` is always copied — it's gitignored but the
 * in-sandbox build needs it. `pnpm-workspace.yaml` is copied ONLY when present at
 * the repo root: pnpm 11 stores its `allowBuilds` build-script approval there (the
 * only place pnpm 11 reads it), and the loop's onSandboxReady `pnpm install` runs
 * inside the worktree, which receives only tracked files. Without this copy, a
 * gitignored approval file is invisible in-sandbox and every iteration re-hits
 * `ERR_PNPM_IGNORED_BUILDS`. The existence guard keeps npm / yarn / pnpm-10
 * projects (which have no such file) completely unaffected. `fileExists` is
 * injectable for tests.
 */
export function buildCopyToWorktree(
  repoRoot: string,
  fileExists: (p: string) => boolean = (p) => existsSync(p),
): string[] {
  const paths = ["node_modules"];
  if (fileExists(path.join(repoRoot, "pnpm-workspace.yaml"))) {
    paths.push("pnpm-workspace.yaml");
  }
  return paths;
}

// ---------------------------------------------------------------------------
// Pre-flight
// ---------------------------------------------------------------------------

// `plan-prompt.md` is NOT here, and its absence is the point: the planner is
// code now (`planDeterministic`, `lib/state/eligible-set.ts`), so there is no
// planner prompt to be missing. See that module's header for why.
const REQUIRED_PROMPT_FILES = [
  "implement-prompt.md",
  "review-prompt.md",
  "merge-prompt.md",
  "post-merge-review-prompt.md",
  "post-merge-fix-prompt.md",
] as const;

export interface PreflightResult {
  ok: boolean;
  errors: readonly string[];
}

/**
 * How long check #7d's in-container probe waits for the TCP handshake, and
 * the hard bound on the whole probe process.
 *
 * The connect budget matches the `PGCONNECT_TIMEOUT=5` that checks #7/#7b/#7c
 * already use for the host-side probes, so the two halves of the same question
 * are asked with the same patience. The hard bound exists because the default
 * `exec` here is `execFileSync` with NO timeout: a black-holed address would
 * otherwise hang launch forever, and this preflight's entire purpose is to
 * fail fast. Node owns the bound inside the container, so it is a kill that
 * can actually be delivered.
 */
const SANDBOX_DB_PROBE_CONNECT_MS = 5000;
const SANDBOX_DB_PROBE_HARD_MS = 15_000;

/**
 * Check #7d's payload: a bare TCP connect, run by `node -e` INSIDE a container
 * off the run's own sandbox image.
 *
 * A TCP connect and not `pg_isready`/`psql`: the sandbox image is
 * `node:22-bookworm-slim` and carries no Postgres client, and the fault this
 * check exists to catch is a NETWORK fault — the host firewall dropping the
 * docker bridge, which is what happened on 2026-08-05. Authentication and
 * database existence are already proven from the host by checks #7 and #7c;
 * the only thing those cannot see is whether the container can get there at
 * all, and a handshake answers exactly that in milliseconds.
 *
 * Host and port arrive as ARGV, never interpolated into this string, so an
 * operator-set `SANDCASTLE_TEST_DB_URL` cannot inject JavaScript here.
 * Writes the diagnosis to stderr so the caller's `stderr` carries it verbatim.
 *
 * EXPORTED for its tests only. A string of JavaScript is not typechecked by
 * anything — a syntax error in here would surface as a container that exits
 * non-zero with a `SyntaxError`, which check #7d would faithfully report as
 * "the sandbox cannot reach the test database": a preflight that refuses every
 * launch for a fault that does not exist. `main.test.mts` runs this exact
 * string through a real `node -e` against a real socket for that reason.
 */
export const SANDBOX_DB_TCP_PROBE_SCRIPT = `
const net = require("net");
const host = process.argv[1];
const port = Number(process.argv[2]);
let settled = false;
const done = (code, msg) => {
  if (settled) return;
  settled = true;
  if (msg) process.stderr.write(msg + "\\n");
  process.exit(code);
};
setTimeout(
  () => done(2, "probe did not settle within ${SANDBOX_DB_PROBE_HARD_MS}ms"),
  ${SANDBOX_DB_PROBE_HARD_MS},
).unref();
const sock = net.connect({ host, port });
sock.setTimeout(${SANDBOX_DB_PROBE_CONNECT_MS});
sock.on("connect", () => { sock.destroy(); done(0); });
sock.on("timeout", () => {
  sock.destroy();
  done(2, "TCP connect to " + host + ":" + port + " timed out after ${SANDBOX_DB_PROBE_CONNECT_MS}ms");
});
sock.on("error", (err) => {
  sock.destroy();
  done(2, "TCP connect to " + host + ":" + port + " failed: " + err.message);
});
`;

/**
 * Fix G's timing budget: how long the in-container bind probe waits for
 * `listen()` to either succeed or error before it gives up and reports
 * INCONCLUSIVE.
 *
 * A `listen()` on a local interface settles in milliseconds — a bind either
 * takes the address or bounces with EADDRNOTAVAIL/EADDRINUSE right away, at
 * the syscall, long before any Next.js compile. That is the whole reason this
 * check does NOT boot the real dev server: the fault it hunts (F12 — a bind
 * address with no interface in the sandbox namespace) is visible at `listen`,
 * so paying for a 1–2 minute cold compile to surface it would make the probe
 * slow and flaky for nothing. The 30s ceiling is only the "the call never came
 * back at all" backstop (a black-holed hostname whose resolution hangs); it
 * exists so a hung probe reports INCONCLUSIVE (which never aborts a run)
 * rather than wedging launch forever. Node owns the timer inside the
 * container, so it is a deadline that can actually be delivered.
 */
const SANDBOX_DEV_BIND_PROBE_HARD_MS = 30_000;

/**
 * Fix G's retry shape. Only a HARD bind error reproduced across EVERY attempt
 * aborts the run; a single healthy or inconclusive result anywhere in the
 * sequence lets the run proceed. Three attempts with a short capped-linear
 * backoff (the `cloneJobDatabase` idiom, lib/db/job-clone.ts) is enough to
 * tell a one-off hiccup from a standing, reproducible fault while keeping the
 * worst-case boot delay to a couple of seconds. A run-aborting guard that
 * misfired would kill healthy nights — the exact inverted failure mode — so
 * the bar to abort is deliberately "definite and repeated", never "seen once".
 */
const SANDBOX_DEV_BIND_PROBE_MAX_ATTEMPTS = 3;
const SANDBOX_DEV_BIND_BACKOFF_CAP_MS = 2000;

/**
 * The hard bind code that means "this address has no interface in the sandbox's
 * network namespace" — the exact, and ONLY, F12 fault. `EADDRNOTAVAIL` is what
 * a Tailscale IP with no interface inside the sandbox throws, synchronously at
 * `listen()`, and it is the same reason a Playwright `baseURL` on that address
 * is unreachable — an address with no local interface fails BOTH to bind and to
 * connect. Deliberately a set of ONE. In particular `EADDRINUSE` is NOT here:
 * it means the interface EXISTS and the port is merely occupied — the opposite
 * of "no interface", a transient/environmental condition rather than the
 * standing misconfiguration F12 is, so it falls through to INCONCLUSIVE like
 * `EACCES` (a privileged port) and every other `listen` error. A run-aborting
 * guard must fire only for the one fault it can be certain of.
 */
const SANDBOX_DEV_BIND_HARD_CODES = ["EADDRNOTAVAIL"] as const;

/**
 * Fix G's payload: a bare `net.createServer().listen(port, host)`, run by
 * `node -e` INSIDE a container off the run's own sandbox image — the SAME
 * shape as check #7d's `SANDBOX_DB_TCP_PROBE_SCRIPT`, but asking the opposite
 * question. #7d asks "can the container REACH the database" (an outbound
 * connect); this asks "can the container BIND the address `next dev` will
 * LISTEN on" (an inbound listen). It must run in the container, never on the
 * host, for the reason F12 exists: on the host the Tailscale IP in
 * `SANDCASTLE_DEV_HOST` binds fine (the host owns that interface), so a host-side
 * boot reports a FALSE GREEN; only inside the sandbox namespace is the address
 * absent and the bind doomed.
 *
 * It does NOT shell out to `scripts/safe-dev.sh` or boot Next.js: the sandbox
 * image carries neither the repo nor `node_modules` (both are bind-mounted /
 * `pnpm install`ed per job at runtime — see `.sandcastle/Dockerfile`), so
 * `next dev` cannot even start in a throwaway `docker run`. Instead it
 * REPRODUCES safe-dev.sh's bind decision from first principles — a faithful
 * port of `scripts/shared-host.sh` (`is_shared_host`) and `scripts/dev-host.sh`
 * — reading the very env the container was handed. The decision MUST be made
 * where the dev server will make it: same env + same namespace = same bind
 * address, proven by the same `listen` syscall, in milliseconds instead of
 * minutes.
 *
 * F12 FIRES THROUGH TWO CHANNELS, and this probe tests BOTH:
 *   1. THE BIND (`scripts/safe-dev.sh`): only a SHARED host adds `-H <dev-host>`
 *      to `next dev`; a private machine (the sandbox after Fix F) gets no `-H`
 *      and binds all interfaces. So the bind address is shared-gated.
 *   2. THE baseURL (`apps/nextjs/playwright.config.ts:33-39`): reads
 *      `scripts/dev-host.sh` UNCONDITIONALLY — no shared gate — to build
 *      `baseURL = http://<dev-host>:<port>`, and `webServer.url` polls it for
 *      120s. So even when the dev server binds `0.0.0.0` fine, a non-empty
 *      `SANDCASTLE_DEV_HOST` with no interface makes Playwright target a dead IP
 *      and every browser check times out — F12, through a channel the bind test
 *      alone cannot see. Concretely: revert ONLY the `SANDCASTLE_DEV_HOST` blank
 *      in `sandboxTestDbEnv` (keep the `SANDCASTLE_SHARED_HOST` one) and F12
 *      reopens here while a bind-only probe stays green.
 * So the probe `listen()`s on BOTH the shared-gated bind host AND the
 * unconditional `dev-host.sh` address (`SANDCASTLE_DEV_HOST || 127.0.0.1`), and a
 * hard failure on EITHER is DEAD. `listen`-fails is a faithful proxy for the
 * baseURL's connect-unreachable: an address with no local interface fails both
 * to bind and to connect.
 *
 * The port arrives as ARGV and the bind host is derived from env, never
 * interpolated into this string, so an operator-set value cannot inject
 * JavaScript here. Writes its diagnosis (including the resolved host:port) to
 * stderr so the caller carries it verbatim.
 *
 * EXPORTED for its tests only: a string of JavaScript is typechecked by
 * nothing, and a syntax error would make every container exit non-zero, which
 * this check would misread as "the sandbox dev server cannot bind" — a
 * preflight that refuses every launch for a fault that does not exist.
 * `main.test.mts` runs this exact string through a real `node -e` against real
 * bindable / unbindable addresses for that reason.
 *
 * Exit codes: 0 = healthy (bound and released), 2 = DEAD (a hard bind code),
 * 3 = INCONCLUSIVE (a non-hard error, or the settle deadline). The host-side
 * runner maps those three to {healthy, dead, inconclusive}; only `dead`,
 * reproduced across all attempts, ever aborts.
 */
export const SANDBOX_DEV_BIND_PROBE_SCRIPT = `
const net = require("net");
const fs = require("fs");
const env = process.env;
const port = Number(process.argv[1]);
const HARD_CODES = ${JSON.stringify(SANDBOX_DEV_BIND_HARD_CODES)};
// A shared host is one ONLY when SANDCASTLE_SHARED_HOST says so, evaluated as
// the CONTAINER sees it. The compare is case-SENSITIVE (TRUE/YES fall through
// to "not shared") — no toLowerCase here on purpose. No filesystem probe: a
// project's own dev scripts may guess "shared" from a directory, but this
// probe never does.
const isSharedHost = () => {
  const v = env.SANDCASTLE_SHARED_HOST || "";
  return v === "1" || v === "true" || v === "yes";
};
// Faithful port of scripts/dev-host.sh: it tests only \`-n\` (non-empty), so a
// whitespace value is "set" — no trim here on purpose; \`|| ""\` maps only the
// unset/empty case to "" to match \${VAR:-}.
const devHost = env.SANDCASTLE_DEV_HOST || "";
// CHANNEL 1 — scripts/safe-dev.sh bind: only a shared host gets \`-H\`, else next
// dev binds all interfaces. Shared-gated.
const shared = isSharedHost();
const bindHost = shared ? (devHost || "127.0.0.1") : "0.0.0.0";
// CHANNEL 2 — apps/nextjs/playwright.config.ts baseURL: reads dev-host.sh
// UNCONDITIONALLY (no shared gate). A dead SANDCASTLE_DEV_HOST kills every browser
// check via the 120s webServer.url poll even when the dev server bound 0.0.0.0.
const baseHost = devHost || "127.0.0.1";
// Probe both; dedupe (commonly baseHost === bindHost, or bindHost is 0.0.0.0).
const hosts = baseHost === bindHost ? [bindHost] : [bindHost, baseHost];
let settled = false;
const done = (code, msg) => {
  if (settled) return;
  settled = true;
  if (msg) process.stderr.write(msg + "\\n");
  process.exit(code);
};
setTimeout(
  () => done(3, "bind probe for " + hosts.join(",") + ":" + port + " did not settle within ${SANDBOX_DEV_BIND_PROBE_HARD_MS}ms (inconclusive)"),
  ${SANDBOX_DEV_BIND_PROBE_HARD_MS},
).unref();
// Sequential: listen on each host in turn, releasing the port between tries. A
// hard failure on EITHER channel is DEAD; only if ALL bind cleanly is it
// healthy.
let i = 0;
const probeNext = () => {
  if (i >= hosts.length) { done(0); return; }
  const h = hosts[i++];
  const server = net.createServer();
  server.on("error", (err) => {
    const code = err && err.code ? err.code : "";
    try { server.close(); } catch (e) {}
    if (HARD_CODES.indexOf(code) !== -1) {
      done(2, "the sandbox cannot use " + h + ":" + port + " (a next-dev bind / Playwright baseURL address): " + code + " (" + err.message + ")");
    } else {
      done(3, "bind to " + h + ":" + port + " failed non-hard: " + (code || err.message) + " (inconclusive)");
    }
  });
  server.listen(port, h, () => {
    server.close(() => probeNext());
  });
};
probeNext();
`;

/**
 * Pre-flight checks: gh auth, branch sanity, repo presence, prompt-file
 * presence, docker daemon. Pure — never mutates state. Tests call it
 * directly with their own runners.
 */
export function preflight(
  args: SandcastleArgs,
  opts: {
    exec?: (
      bin: string,
      args: readonly string[],
    ) => { ok: boolean; stdout?: string; stderr?: string };
    fileExists?: (p: string) => boolean;
    getEnv?: (key: string) => string | undefined;
    /** The project's settings; defaults to the installed config. */
    projectConfig?: ProjectConfig;
    /** Ask whether the per-job clone TEMPLATE database exists (check #7) —
     * `stdout` is `"1"` when found, empty otherwise. Injected so #7 is
     * testable without a live Postgres. */
    probeTemplateExists?: (
      adminUrl: string,
      templateDb: string,
    ) => { ok: boolean; stdout?: string; stderr?: string };
    /**
     * Dial the test database FROM INSIDE a container off the run's own image
     * (check #7d) — a different network path from every other probe here,
     * which all dial from the host. Injected so #7d is testable without
     * Docker. */
    probeSandboxDb?: (
      imageName: string,
      host: string,
      port: string,
    ) => { ok: boolean; stderr?: string };
    /**
     * BIND the sandbox dev server's listen address FROM INSIDE a container off
     * the run's own image (check #7f, Fix G). The opposite direction from
     * `probeSandboxDb`: an inbound `listen`, not an outbound connect. `env` is
     * the subset of the sandbox environment that drives the bind decision
     * (`SANDCASTLE_DEV_HOST` / `SANDCASTLE_SHARED_HOST`), forwarded into the probe
     * container as `-e`. Returns a THREE-state verdict, not a boolean, because
     * the abort rule turns on the difference between a confirmed dead bind and
     * an ambiguous timeout. Injected so #7f is testable without Docker. */
    probeDevServerBind?: (
      imageName: string,
      env: Record<string, string>,
      port: string,
    ) => { status: "healthy" | "dead" | "inconclusive"; stderr?: string };
    /**
     * Sync sleep between #7f's retries (default: a real `Atomics.wait` sleep).
     * Injected so tests exercise the retry/abort logic without waiting. */
    sleep?: (ms: number) => void;
  } = {},
): PreflightResult {
  const errors: string[] = [];
  const exec =
    opts.exec ??
    ((bin, a) => {
      try {
        // Capture stdout (the branch-base check below compares rev-parse
        // output). Other checks ignore it. stderr piped for error messages.
        const stdout = execFileSync(bin, [...a], {
          encoding: "utf8",
          stdio: ["ignore", "pipe", "pipe"],
        });
        return { ok: true, stdout };
      } catch (err) {
        return { ok: false, stderr: (err as Error).message };
      }
    });
  const fileExists = opts.fileExists ?? ((p) => existsSync(p));

  // 1. gh auth
  const gh = exec("gh", ["auth", "status"]);
  if (!gh.ok) errors.push(`gh auth status failed: ${gh.stderr ?? "unknown"}`);

  // 2. branch != main/master
  if (args.branch === "main" || args.branch === "master") {
    errors.push(
      `refuse to run on protected branch '${args.branch}' — pass --branch <feature>`,
    );
  }

  // 3. repo is git
  if (!fileExists(path.join(args.repoRoot, ".git"))) {
    errors.push(
      `--repo-root '${args.repoRoot}' is not a git repo (missing .git/)`,
    );
  }

  // 4. all 7 prompt files exist
  const sandcastleDir = path.join(args.repoRoot, ".sandcastle");
  for (const f of REQUIRED_PROMPT_FILES) {
    const full = path.join(sandcastleDir, f);
    if (!fileExists(full)) errors.push(`missing prompt file: ${full}`);
  }

  // 5. docker daemon — only required when using the docker sandbox provider.
  // The mac-host path runs no Docker commands, so skip this to avoid blocking
  // startup if Docker isn't running on the host.
  //
  // `dockerRunnable` records whether a container can actually be STARTED off
  // this image — daemon up AND image present. Check #7d below needs to know,
  // because a probe that boots a container would otherwise report "the test
  // database is unreachable from the sandbox" when the real (already-reported)
  // fault is that there is no sandbox at all.
  let dockerRunnable = args.sandbox === "docker";
  if (args.sandbox === "docker") {
    const dk = exec("docker", ["info"]);
    if (!dk.ok) {
      errors.push(`docker info failed: ${dk.stderr ?? "unknown"}`);
      dockerRunnable = false;
    }

    // 6. project's sandbox image exists locally. Without this check, the first
    // ticket immediately fails with "Image '<name>' not found locally" after
    // the run has already set up its branch, worktrees and status feed —
    // wasted setup + confusing first-run UX on any fresh worktree or
    // post-`docker prune` machine. Catch at boot instead and point the user at
    // the build command.
    if (dk.ok) {
      const img = exec("docker", ["image", "inspect", args.imageName]);
      if (!img.ok) {
        errors.push(
          `sandbox image '${args.imageName}' not found locally. Build it with: ` +
            `node_modules/.bin/sandcastle docker build-image --image-name ` +
            `${args.imageName} --dockerfile .sandcastle/Dockerfile`,
        );
        dockerRunnable = false;
      }
    }
  }

  // 7. The test database (opt-in: `testDatabase` in .sandcastle/project.json).
  // Off by default — a project that has not named a template database needs no
  // `psql`, no Postgres, and none of the probes below. When it is on, fail at
  // boot rather than mid-iteration after a model call has already burned
  // tokens: every sandbox this loop creates clones its own database from the
  // template via `psql`, so a missing binary, an unreachable server or a
  // missing template database would otherwise quarantine every issue in the
  // queue, one at a time. Skipped when `SANDCASTLE_TEST_DB_URL` is set: that
  // means "point every sandbox at THIS exact database", and no clone happens.
  const getEnv = opts.getEnv ?? ((k) => process.env[k]);
  const projectConfig = opts.projectConfig ?? getProjectConfig();
  const testDb = projectConfig.testDatabase;
  const directTestDbUrl = getEnv("SANDCASTLE_TEST_DB_URL");
  // `$0` carries the URL and `$1` the template name — never interpolated into
  // the shell string — so a password with shell metacharacters cannot break
  // the command. `PGCONNECT_TIMEOUT` keeps a black-holed host from hanging
  // the launch.
  const probeTemplateExists =
    opts.probeTemplateExists ??
    ((adminUrl: string, templateDb: string) =>
      exec("sh", [
        "-c",
        'PGCONNECT_TIMEOUT=5 exec psql "$0" -tAc "SELECT 1 FROM pg_database WHERE datname = \'$1\'"',
        adminUrl,
        templateDb,
      ]));
  if (testDb !== null && !directTestDbUrl) {
    const psql = exec("sh", ["-c", "command -v psql"]);
    if (!psql.ok) {
      errors.push(
        `psql not found on PATH — refusing to launch. Every sandbox this ` +
          `loop creates clones its own database from the template ` +
          `"${testDb.templateDb}" via psql (testDatabase in ` +
          `${PROJECT_CONFIG_RELATIVE_PATH}); install PostgreSQL client tools ` +
          `(your package manager's postgresql-client, or libpq on macOS) so ` +
          `psql is on PATH, then re-run the loop.`,
      );
    } else {
      let adminUrl = "";
      try {
        adminUrl = testDbAdminUrl({
          SANDCASTLE_TEST_DB_ADMIN_URL: getEnv("SANDCASTLE_TEST_DB_ADMIN_URL"),
          SANDCASTLE_TEST_PG_PORT: getEnv("SANDCASTLE_TEST_PG_PORT"),
        });
      } catch (err) {
        errors.push(
          `cannot resolve the admin database target needed to probe the ` +
            `per-job clone template "${testDb.templateDb}" — refusing to ` +
            `launch. ${(err as Error).message}`,
        );
      }
      if (adminUrl !== "") {
        const probe = probeTemplateExists(adminUrl, testDb.templateDb);
        // host:port only, never the whole URL — it may carry a password.
        const target = new URL(adminUrl).host;
        if (!probe.ok) {
          errors.push(
            `could not probe whether the per-job clone template ` +
              `"${testDb.templateDb}" exists at ${target} (is the test ` +
              `Postgres up?) — refusing to launch. Probe failed: ` +
              `${probe.stderr ?? "unknown"}`,
          );
        } else if ((probe.stdout ?? "").trim() !== "1") {
          errors.push(
            `the per-job clone template "${testDb.templateDb}" does not ` +
              `exist at ${target} — refusing to launch. Every ticket clones ` +
              `its own database from this template; create it and re-run ` +
              `the loop.`,
          );
        }
      }
    }
  }

  // 7d. THE SANDBOX'S OWN VIEW of the test database (2026-08-05 production
  // failure). Everything above dials Postgres from the HOST. The container
  // reaches the same database over a completely different path — the docker
  // bridge gateway (`172.17.0.1` on Linux, `host.docker.internal` on macOS,
  // see `sandboxTestDbHost`) — and on 2026-08-05 the host firewall dropped
  // exactly that path while every host-side probe stayed green. The loop
  // started, dispatched four issues, and each one spent ~19 minutes proving
  // the same environment fault: Playwright's globalSetup died with
  // `write CONNECT_TIMEOUT 172.17.0.1:55432`, the must-fail-first proof came
  // back inconclusive twice, and the ticket was quarantined
  // `stopped:no-failing-check`. With ~43 issues queued that is ~13 hours of
  // burn to learn one fact about the network.
  //
  // So ask that one fact ONCE, before anything is dispatched, from where it
  // actually matters: inside a container off this run's own image, on the
  // same default bridge network the loop's sandboxes use (the provider sets
  // no `network` option — see `lib/sandbox-provider.ts`). Seconds, not
  // minutes: a container start plus a TCP handshake.
  //
  // Docker-only, and deliberately: `--sandbox mac-host` runs the agent
  // natively on the host, so its `POSTGRES_URL` host is `localhost` and check
  // #7 above has already dialled it from that very process. Gated on
  // `dockerRunnable` so a stopped daemon or a missing image reports ITS own
  // error (checks #5/#6) instead of a misleading "the database is
  // unreachable" — that is the sensible degradation when the sandbox runtime
  // is the thing that is unavailable.
  //
  // Escape hatch: `--allow-unreachable-sandbox-db`, the same shape as check
  // #8's `--allow-dirty-sandcastle` (loud stderr WARN at the CLI entry so the
  // bypass never quietly becomes habit).
  if (
    dockerRunnable &&
    !args.allowUnreachableSandboxDb &&
    (testDb !== null || Boolean(directTestDbUrl))
  ) {
    const probeSandboxDb =
      opts.probeSandboxDb ??
      ((imageName: string, host: string, port: string) =>
        exec("docker", [
          "run",
          "--rm",
          // The image's own ENTRYPOINT is `sleep infinity` (it is kept alive
          // for `docker exec`), so it has to be replaced or the probe would
          // never run.
          "--entrypoint",
          "node",
          imageName,
          "-e",
          SANDBOX_DB_TCP_PROBE_SCRIPT,
          host,
          port,
        ]));
    let sandboxDbTarget: URL | undefined;
    try {
      // The SAME resolution `buildDefaultDeps` hands the container, so this
      // check and the runtime it guards can never disagree about the address.
      sandboxDbTarget = new URL(
        sandboxTestDbEnv(args.sandbox, {
          SANDCASTLE_TEST_DB_URL: getEnv("SANDCASTLE_TEST_DB_URL"),
          SANDCASTLE_TEST_PG_PORT: getEnv("SANDCASTLE_TEST_PG_PORT"),
        }).POSTGRES_URL,
      );
    } catch (err) {
      errors.push(
        `cannot resolve the database address the sandbox will be given — ` +
          `refusing to launch. ${(err as Error).message}`,
      );
    }
    if (sandboxDbTarget !== undefined) {
      const host = sandboxDbTarget.hostname;
      const port = sandboxDbTarget.port || "5432";
      const probe = probeSandboxDb(args.imageName, host, port);
      if (!probe.ok) {
        errors.push(
          `the sandbox cannot reach the test database at ${host}:${port} — ` +
            `refusing to launch. Every ticket tonight boots a real app and a ` +
            `real browser against that database, so with this unreachable NO ` +
            `check can run — and since #1198 that no longer stops a ticket ` +
            `early, it makes every ticket cost MORE: each one falls through ` +
            `the check-writer stage, spends a full builder and reviewer pass ` +
            `against an environment that cannot run a check, and ships (if ` +
            `at all) on the reviewer's word alone, labelled ` +
            `\`shipped-without-first-test\`. A whole night of unproven work ` +
            `is the thing being refused here. Note this is the CONTAINER's ` +
            `path to the database ` +
            `(the docker bridge gateway), not the host's — the host-side ` +
            `probes above passed, so the database itself is up and the fault ` +
            `is between the container and it. Most likely a host firewall ` +
            `dropping the docker bridge (allow ${host}:${port} from the ` +
            `docker network), or a bridge gateway that is not ${host} on this ` +
            `machine (\`docker network inspect bridge\`, then set ` +
            `SANDCASTLE_TEST_DB_URL). Probe failed: ${probe.stderr ?? "unknown"}`,
        );
      }
    }
  }

  // 7f. THE SANDBOX'S DEV SERVER BIND (Fix G — the systemic backstop for the
  // F12 class; see docs/reference/agent-failures.md).
  //
  // WHAT F12 WAS: the VPS repo-root `.env` set `SANDCASTLE_DEV_HOST` to the
  // host's own Tailscale IP so a human could reach the dev server from another
  // device. That `.env` is copied into every check sandbox, where that address
  // has NO interface. `scripts/safe-dev.sh` then ran `next dev -H <it>`, which
  // died with `EADDRNOTAVAIL`; the dev server never served; every browser /
  // screen ticket graded 0/0/0 and was quarantined `stopped:no-failing-check`
  // after burning its full budget. Seven tickets in one night, and the loop
  // blamed each TICKET, never the environment.
  //
  // WHY A SEPARATE CHECK when Fix F (blanking those two vars in
  // `sandboxTestDbEnv`) already fixed the FIRST instance: Fix F closed the one
  // mechanism we found. This is the class backstop — it catches ANY future
  // regression that re-hands the sandbox a dev-server bind address with no
  // interface in its namespace (a new host-only var, a reverted blank, a
  // policy flag left set), ONCE, before a single ticket is dispatched, instead
  // of grinding every browser ticket to a false `stopped:no-failing-check`.
  //
  // HOW, and why it mirrors check #7d exactly: boot one container off THIS
  // run's image and ask the one question a host-side check physically cannot —
  // can the address the sandbox's `next dev` will LISTEN on actually be BOUND
  // inside the sandbox's own network namespace? It must run in the container:
  // on the host the Tailscale IP binds fine (the host owns that interface), so
  // a host-side boot is a FALSE GREEN. The probe reproduces safe-dev.sh's bind
  // decision from the container's env + filesystem (see
  // SANDBOX_DEV_BIND_PROBE_SCRIPT for why it can't just run `next dev`) and
  // proves it with a `listen` syscall — milliseconds, and it fails FAST on a
  // hard bind error rather than waiting out a 1–2 minute Next.js cold compile.
  //
  // THE ABORT BAR IS DELIBERATELY HIGH. A run-aborting guard that misfired
  // would kill healthy nights — the exact inverted failure mode of the bug it
  // prevents. So it aborts ONLY on EADDRNOTAVAIL — the "this address has no
  // interface here" fault, which IS F12 — REPRODUCED across every attempt.
  // `EADDRINUSE` (a mere port collision, the interface exists) is NOT in the
  // abort set: it settles to `inconclusive` and never stops a run. A `healthy`
  // or `inconclusive`
  // result anywhere in the retry sequence lets the run proceed: a timeout
  // might just be a slow machine, and this guard must never be the reason a
  // good night died. Same Docker-only / `dockerRunnable` gating and same
  // escape-hatch shape as #7d, for the same reasons.
  // Off unless the host environment sets one of the two vars: with neither
  // set there is no host-only address to leak into the sandbox, so there is
  // nothing to probe.
  if (
    args.sandbox === "docker" &&
    dockerRunnable &&
    !args.allowUnreachableDevBind &&
    Boolean(getEnv("SANDCASTLE_DEV_HOST") || getEnv("SANDCASTLE_SHARED_HOST"))
  ) {
    const probeDevServerBind =
      opts.probeDevServerBind ??
      ((imageName: string, env: Record<string, string>, port: string) => {
        const envArgs = Object.entries(env).flatMap(([k, v]) => [
          "-e",
          `${k}=${v}`,
        ]);
        try {
          // Own execFileSync (not the shared `exec` seam): a THREE-state
          // verdict needs the container's exit code, which `exec` collapses to
          // a boolean. `docker run` propagates the container's exit code as its
          // own. Outer timeout > the script's 30s settle deadline so the
          // script reports its own INCONCLUSIVE first; if the OUTER timeout
          // ever fires (a wedged daemon), the SIGTERM lands here as a non-2
          // exit → inconclusive → never aborts.
          execFileSync(
            "docker",
            [
              "run",
              "--rm",
              ...envArgs,
              // Same ENTRYPOINT override as #7d — the image's `sleep infinity`
              // keep-alive would otherwise swallow the probe.
              "--entrypoint",
              "node",
              imageName,
              "-e",
              SANDBOX_DEV_BIND_PROBE_SCRIPT,
              port,
            ],
            {
              encoding: "utf8",
              stdio: ["ignore", "pipe", "pipe"],
              timeout: SANDBOX_DEV_BIND_PROBE_HARD_MS + 15_000,
            },
          );
          return { status: "healthy" as const };
        } catch (err) {
          const e = err as {
            status?: number;
            stderr?: string;
            message?: string;
          };
          const stderr = String(e.stderr ?? e.message ?? "");
          // Exit 2 is the ONLY code the script emits for a confirmed hard bind
          // failure. Everything else — the script's own exit 3, a docker
          // daemon error (125/126/127), an OOM-kill, the outer SIGTERM — is
          // inconclusive by construction and can never abort a run.
          return e.status === 2
            ? { status: "dead" as const, stderr }
            : { status: "inconclusive" as const, stderr };
        }
      });
    const sleep =
      opts.sleep ??
      ((ms: number) => {
        // Synchronous sleep: preflight is a pure, synchronous function, so the
        // capped-linear retry backoff cannot `await`. Atomics.wait blocks the
        // thread without a busy-loop. Total worst-case delay is a couple of
        // seconds, paid once at boot.
        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
      });

    // The bind decision reads only these two vars. Source them the way the
    // container will see them: `sandboxTestDbEnv` (Fix F) wins over the raw
    // env, so today both read `""` and the sandbox behaves like a private
    // machine (healthy). If Fix F ever regresses — the blanks removed from
    // `sandboxTestDbEnv` — the merge falls through to the real `.env` value,
    // which is exactly the address the sandbox would then be handed, and this
    // probe would reproduce F12's dead bind. That fall-through is what makes
    // this a real regression backstop and not a tautology.
    //
    // `sandboxTestDbEnv` THROWS when the resolved DB URL points at prod
    // (get-tests-off-prod-db). That is check #7d's fault to report, not this
    // one's — if the sandbox env can't even be constructed there is no bind
    // decision to make, so swallow it here and let #7d's own resolution do the
    // refusing. `bindEnv === undefined` skips the probe entirely.
    let bindEnv: Record<string, string> | undefined;
    try {
      const sandboxEnv = sandboxTestDbEnv(args.sandbox, {
        SANDCASTLE_TEST_DB_URL: getEnv("SANDCASTLE_TEST_DB_URL"),
        SANDCASTLE_TEST_PG_PORT: getEnv("SANDCASTLE_TEST_PG_PORT"),
        SANDCASTLE_DEV_HOST: getEnv("SANDCASTLE_DEV_HOST"),
        SANDCASTLE_SHARED_HOST: getEnv("SANDCASTLE_SHARED_HOST"),
      });
      bindEnv = {
        SANDCASTLE_DEV_HOST:
          sandboxEnv.SANDCASTLE_DEV_HOST ?? getEnv("SANDCASTLE_DEV_HOST") ?? "",
        SANDCASTLE_SHARED_HOST:
          sandboxEnv.SANDCASTLE_SHARED_HOST ??
          getEnv("SANDCASTLE_SHARED_HOST") ??
          "",
      };
    } catch {
      bindEnv = undefined;
    }
    // The dev port safe-dev.sh binds (scripts/worktree-port.sh → 4001 for the
    // main checkout). The exact number is not load-bearing here — a hard bind
    // failure is about the HOST having no interface, not the port — but a real,
    // non-privileged port keeps the probe faithful and dodges any EACCES noise.
    const port = getEnv("PORT") || "4001";

    let confirmedDead = false;
    let lastStderr = "";
    for (
      let attempt = 1;
      bindEnv !== undefined && attempt <= SANDBOX_DEV_BIND_PROBE_MAX_ATTEMPTS;
      attempt++
    ) {
      const probe = probeDevServerBind(args.imageName, bindEnv, port);
      if (probe.status !== "dead") {
        // healthy → the address binds; inconclusive → we cannot say. Neither
        // aborts. A retry that comes back non-dead clears an earlier dead.
        confirmedDead = false;
        break;
      }
      lastStderr = probe.stderr ?? "";
      if (attempt === SANDBOX_DEV_BIND_PROBE_MAX_ATTEMPTS) {
        confirmedDead = true;
        break;
      }
      sleep(Math.min(500 * attempt, SANDBOX_DEV_BIND_BACKOFF_CAP_MS));
    }
    if (confirmedDead) {
      errors.push(
        `the sandbox cannot use its own dev-server address — ` +
          `refusing to launch. Every browser/screen ticket tonight boots ` +
          `\`next dev\` in a sandbox and points Playwright at it; with this ` +
          `address dead the dev server never serves OR Playwright's baseURL ` +
          `never resolves, and every such check grades 0/0/0. Since #1198 ` +
          `that no longer stops the ticket early — it falls through the ` +
          `check-writer stage, spends a full builder and reviewer pass ` +
          `against an environment that cannot run a browser check, and ships ` +
          `(if at all) on the reviewer's word alone, labelled ` +
          `\`shipped-without-first-test\`. The cost went UP, not away. ` +
          `This is the F12 class (a host-only dev-server address — a ` +
          `Tailscale IP in SANDCASTLE_DEV_HOST, which safe-dev.sh binds AND ` +
          `playwright.config.ts targets unconditionally, or the ` +
          `SANDCASTLE_SHARED_HOST policy flag that forces that bind — riding the ` +
          `project .env into the sandbox, where it has no interface; see ` +
          `docs/reference/agent-failures.md). Fix F blanks those two vars in ` +
          `\`sandboxTestDbEnv()\`; a confirmed bind failure here means the ` +
          `sandbox is STILL being handed an unbindable address — check that ` +
          `blanking still fires, or that no new host-only bind var has crept ` +
          `into the sandbox env. Reproduced across ` +
          `${SANDBOX_DEV_BIND_PROBE_MAX_ATTEMPTS} attempts. Probe said: ` +
          `${lastStderr || "unknown"}. Bypass with --allow-unreachable-dev-bind ` +
          `if this probe is the wrong instrument (and own the risk).`,
      );
    }
  }

  // 8. Sandcastle source code dirty-check. Refuse-launch when
  // `.sandcastle/main.mts` has uncommitted modifications vs HEAD. This
  // is the discipline guard against the "patched locally but never
  // propagated upstream" failure mode that has bitten the loop twice
  // (the `.pnpm-store/` gitignore slip and the worktree pre-clean slip
  // — both shipped to consumers via in-place edits and never made it
  // back into the template). Either commit before launching, or opt
  // out with `--allow-dirty-sandcastle` (the bypass-warn at the CLI
  // entry surfaces the opt-out so it doesn't silently become habit).
  if (!args.allowDirtySandcastle) {
    // `-C args.repoRoot` is load-bearing: the default `exec` inherits
    // process.cwd() (see line ~700), but `--repo-root` is allowed to
    // diverge from cwd. Without -C, a launch from a different working
    // directory would silently check the wrong repo and either
    // false-negative (report clean) or false-positive (report dirty
    // against an unrelated repo).
    const dirty = exec("git", [
      "-C",
      args.repoRoot,
      "diff",
      "--quiet",
      "HEAD",
      "--",
      ".sandcastle/main.mts",
    ]);
    if (!dirty.ok) {
      errors.push(
        "uncommitted changes in .sandcastle/main.mts — commit before " +
          "launching (prevents 'patched locally but never propagated' " +
          "incidents). Bypass with --allow-dirty-sandcastle if you really " +
          "mean it (and own propagating the patch upstream yourself).",
      );
    }
  }

  // 9. Launch-checkout HEAD must be ATTACHED TO --branch, not merely at the
  // same commit. Worker worktrees are cut from the launch checkout's CURRENT
  // HEAD (`git worktree add` branches off HEAD), NOT from --branch, and
  // fastForwardIntegration advances --branch through whichever worktree has it
  // checked out. A SHA-only check had a hole: `git branch <run> <base>` with no
  // checkout leaves HEAD attached to <base> while <base> and <run> share a tip
  // — the SHAs match, yet every merged issue re-bases off the stale <base> and
  // re-does the foundation (the branch-base trap;
  // recurred on the scheduler repo 2026-07-02). So the check is now a single
  // ATTACHMENT model over `git symbolic-ref --short HEAD`, which real git always
  // resolves (→ the attached branch) or fails (→ detached). Both cases are
  // fatal-or-pass here; there is no third "same-sha-different-branch" hole left
  // to catch, so the old SHA-comparison fallback was removed.
  const headBranchRef = exec("git", [
    "-C",
    args.repoRoot,
    "symbolic-ref",
    "--quiet",
    "--short",
    "HEAD",
  ]);
  const attachedBranch =
    headBranchRef.ok && typeof headBranchRef.stdout === "string"
      ? headBranchRef.stdout.trim()
      : "";
  if (attachedBranch !== "") {
    // symbolic-ref resolved → HEAD is attached to `attachedBranch`. When that is
    // --branch the tips are equal by definition, so this is the whole check.
    if (attachedBranch !== args.branch) {
      errors.push(
        `launch checkout is on branch '${attachedBranch}', not the --branch ` +
          `'${args.branch}'. Worker worktrees are cut from the launch checkout's ` +
          `HEAD and --branch is advanced through the worktree that has it checked ` +
          `out, so a mismatch silently re-bases every issue off '${attachedBranch}' ` +
          `and re-does the foundation — even when the two branches currently share ` +
          `a commit. Run \`git -C ${args.repoRoot} checkout ${args.branch}\` (or ` +
          `pass the --branch you actually intend) and re-run the loop.`,
      );
    }
  } else if (!headBranchRef.ok) {
    // symbolic-ref exited non-zero → HEAD is DETACHED (attached to no branch).
    // The loop cuts worker worktrees from the launch HEAD and advances
    // --branch through the worktree that has it checked out; a detached HEAD is
    // attached to nothing, so --branch cannot advance and fastForwardIntegration
    // refuses every promotion — a mid-run dead-end. Detached *at* the branch tip
    // also re-creates the branch-base trap the instant --branch first moves.
    // Refuse at boot rather than let the run stall.
    errors.push(
      `launch checkout has a detached HEAD (attached to no branch), but the loop ` +
        `advances --branch '${args.branch}' through the launch worktree — a ` +
        `detached HEAD can't do that, so worker worktrees would strand on the ` +
        `detached commit and every promotion would be refused. Run ` +
        `\`git -C ${args.repoRoot} checkout ${args.branch}\` and re-run the loop.`,
    );
  }
  // Remaining case — headBranchRef.ok but no stdout — cannot occur with real git
  // (the default exec captures stdout); it only arises for legacy exec mocks that
  // don't pipe stdout, which must stay inert. Falling through with no error is
  // exactly that inert no-op.

  return {
    ok: errors.length === 0,
    errors,
  };
}

// ---------------------------------------------------------------------------
// Git identity helper — give the agent's `git commit` calls inside the
// container a FIXED machine identity ("Claude"), never the host's own
// user.name/user.email. Code the loop wrote must not land under the owner's
// name: `git log`/`git blame` are how he tells his own work from the loop's,
// and an email that matches his GitHub account makes every unattended commit
// look like he typed it. Hardcoded rather than read from host config so every
// host (this Mac, the VPS, any future machine) is covered without per-host
// setup. The email is deliberately one no GitHub account owns, so GitHub
// renders the author as an unlinked "Claude" instead of him.
//
// We also bypass mounting ~/.gitconfig (single-file Docker mounts are flaky on
// atomic-rename writes; cause "Device or resource busy" failures).
// ---------------------------------------------------------------------------

/**
 * Parse one dotenv-style file into a Record. Returns {} on read error.
 * Format: KEY=VALUE per line, `#` comments, blank lines skipped, single-
 * or double-quoted values stripped. Multi-line values are not supported.
 */
/**
 * Serialize a `KEY → value` record back into dotenv format suitable for
 * writing as a `.env` file in the agent sandbox. Uses **single-quoted**
 * values throughout — `KEY='value'`. Why single-quoted, not double:
 *
 * - The real `dotenv` npm package (used by `dotenv-cli` and dotenv-expand)
 *   only expands `\n` and `\r` inside double-quoted values. `\\`, `\"`,
 *   and `\t` are left LITERAL. That means a naive double-quoted
 *   `WINPATH="C:\\Users\\agent"` reads back as `C:\\Users\\agent`
 *   (doubled backslashes) — silent corruption.
 * - dotenv-expand expands `$VAR` / `${VAR}` against `process.env` in
 *   both quote styles. The escape is `\$`. Without escaping, a value
 *   containing `$PATH` becomes the host's literal PATH.
 *
 * Single-quoted values are taken LITERAL by dotenv (no escape
 *   processing), and `\$` still suppresses dotenv-expand. The single
 *   restriction: dotenv has no way to embed a single quote inside a
 *   single-quoted value, so we throw on `'` (vanishingly rare in real
 *   secrets, would silently corrupt otherwise).
 *
 * Mitigating context: the orchestrator already passes every projectEnv
 * key to the container via docker `env:` → `process.env`. `dotenv-cli`
 * defaults to `override: false`, so file values do NOT clobber the
 * already-populated process.env. The file's PRIMARY job is to exist
 * so `dotenv-cli -e ../../.env` doesn't error out. Correct content is
 * a defensive backstop in case the consumer toggles `override: true`.
 */
export function serializeDotenv(env: Record<string, string>): string {
  const lines: string[] = [];
  for (const key of Object.keys(env)) {
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
      throw new Error(
        `serializeDotenv: invalid key ${JSON.stringify(key)} — must match ` +
          `/^[A-Za-z_][A-Za-z0-9_]*$/`,
      );
    }
    const val = env[key]!;
    if (val.includes("'")) {
      throw new Error(
        `serializeDotenv: value for ${key} contains a single quote — not ` +
          `representable in single-quoted dotenv form`,
      );
    }
    if (/[\r\n]/.test(val)) {
      throw new Error(
        `serializeDotenv: value for ${key} contains a newline — not ` +
          `representable on one line`,
      );
    }
    // Escape `$` → `\$` so dotenv-expand doesn't substitute against the
    // process env. Inside single quotes the backslash is preserved by
    // dotenv's parser, then stripped by dotenv-expand when it sees `\$`.
    const escaped = val.replace(/\$/g, "\\$");
    lines.push(`${key}='${escaped}'`);
  }
  return lines.length > 0 ? `${lines.join("\n")}\n` : "";
}

/**
 * Container env fragment carrying the long-lived Claude subscription token.
 *
 * On macOS the `claude` CLI stores its subscription OAuth token in the login
 * Keychain rather than `~/.claude/.credentials.json`, so the bind-mounted
 * `~/.claude` dir carries no credential into the Linux container and every
 * agent reports "Not logged in". A token from `claude setup-token`, exported as
 * CLAUDE_CODE_OAUTH_TOKEN, is forwarded via `containerEnv` — the only channel
 * that reliably survives into `handle.run`. Empty when unset/blank so the
 * Linux/VPS file-mount path (and API-key setups) are untouched.
 */
export function oauthTokenEnv(
  env: NodeJS.ProcessEnv = process.env,
): Record<string, string> {
  const token = env.CLAUDE_CODE_OAUTH_TOKEN;
  return token && token.trim() !== "" ? { CLAUDE_CODE_OAUTH_TOKEN: token } : {};
}

/**
 * The account pool's settings: its address and the word sent as its key.
 * Read only from the sandcastle settings files (see `loadDotenv`, which drops
 * a launching shell's copy). Claude Code ranks ANTHROPIC_AUTH_TOKEN above
 * CLAUDE_CODE_OAUTH_TOKEN, so once these are set every agent draws from the
 * pool and the subscription token goes unused.
 */
export const POOL_ENV_KEYS = ["ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"] as const;

/**
 * Container env fragment carrying the pool settings. Same channel as
 * `oauthTokenEnv`: on the Docker path only keys named here cross into the
 * container. Each key is forwarded only when non-blank.
 */
export function poolEnv(
  env: NodeJS.ProcessEnv = process.env,
): Record<string, string> {
  const out: Record<string, string> = {};
  for (const key of POOL_ENV_KEYS) {
    const v = env[key];
    if (v && v.trim() !== "") out[key] = v;
  }
  return out;
}

/** Default cap (in tokens) forwarded as CLAUDE_CODE_MAX_OUTPUT_TOKENS when the
 * operator hasn't set one. Comfortably above a normal implementer/reviewer
 * turn so we don't truncate real work, but bounded so a runaway response
 * surfaces as a recognizable cap error (see isOutputCapError) instead of
 * burning the whole context window. */
const DEFAULT_MAX_OUTPUT_TOKENS = "32000";

/**
 * Container env fragment that sets a sane CLAUDE_CODE_MAX_OUTPUT_TOKENS
 * default. Nothing set this anywhere before (audit issue #2), so the agent
 * ran with the CLI's built-in cap and a large response could overflow it and
 * surface as the silent-quarantine output-cap error.
 *
 * Conservative: only fills in the default when NEITHER source has a (non-
 * blank) value. `env` is checked first so a fresh shell export always wins
 * (house style — a shell/host value wins over a stale project-`.env` one,
 * as `oauthTokenEnv` and `poolEnv` do by being spread after it); `projectEnv`
 * (the target repo's `.env`/`.env.local`, see `readProjectEnv`) is the
 * fallback so a value set ONLY there still survives instead of being
 * clobbered by the 32000 default. Only the literal default is ever
 * "clobbering" — an explicit value from either source always wins.
 */
export function maxOutputTokensEnv(
  env: NodeJS.ProcessEnv = process.env,
  projectEnv: Record<string, string> = {},
): Record<string, string> {
  const fromShell = env.CLAUDE_CODE_MAX_OUTPUT_TOKENS;
  if (fromShell && fromShell.trim() !== "") {
    return { CLAUDE_CODE_MAX_OUTPUT_TOKENS: fromShell };
  }
  const fromProject = projectEnv.CLAUDE_CODE_MAX_OUTPUT_TOKENS;
  if (fromProject && fromProject.trim() !== "") {
    return { CLAUDE_CODE_MAX_OUTPUT_TOKENS: fromProject };
  }
  return { CLAUDE_CODE_MAX_OUTPUT_TOKENS: DEFAULT_MAX_OUTPUT_TOKENS };
}

/** Command-tool cap forwarded into the sandbox. The builder prompt orders every
 * verification command wrapped in `timeout 900`, but Claude Code's Bash tool
 * stops watching a command after 120 000 ms by default and caps the tool's own
 * `timeout` parameter at 600 000 ms — so the shell timeout never got to fire.
 * On 2026-09-01, #1054 (the pin-a-task-template-to-a-person ticket whose
 * builder lost an hour) had a cold Playwright run cross the 2-minute cap
 * while its Next dev server was still booting; the agent lost the run, and
 * the orphaned dev server held the port for the rerun. This constant is
 * #1190 (the builder command-cap fix): 900 000 ms matches the prompt's own
 * bound; the loop's idle + hard-ceiling watchdogs still bound the turn above
 * it. Shell env wins over the project .env, which wins over the default, per
 * variable — same precedence as maxOutputTokensEnv. The runtime takes the
 * larger of the two, so the two variables are resolved independently on
 * purpose. */
export const DEFAULT_BASH_TIMEOUT_MS = "900000";

/**
 * Resolves BASH_DEFAULT_TIMEOUT_MS and BASH_MAX_TIMEOUT_MS independently —
 * one env-precedence lookup per variable, each falling shell → project .env
 * → DEFAULT_BASH_TIMEOUT_MS. Do NOT clamp one against the other: Claude
 * Code's own runtime takes the LARGER of the two as its effective ceiling
 * (see the constant's doc), so an operator who sets only
 * BASH_MAX_TIMEOUT_MS below 900s and leaves BASH_DEFAULT_TIMEOUT_MS at our
 * 900s default still gets a 900s-or-higher cap — that is correct, not an
 * "invalid pair" needing correction down.
 */
export function bashTimeoutEnv(
  env: NodeJS.ProcessEnv = process.env,
  projectEnv: Record<string, string> = {},
): Record<string, string> {
  const pick = (key: "BASH_DEFAULT_TIMEOUT_MS" | "BASH_MAX_TIMEOUT_MS") => {
    const fromShell = env[key];
    if (fromShell && fromShell.trim() !== "") return fromShell;
    const fromProject = projectEnv[key];
    if (fromProject && fromProject.trim() !== "") return fromProject;
    return DEFAULT_BASH_TIMEOUT_MS;
  };
  return {
    BASH_DEFAULT_TIMEOUT_MS: pick("BASH_DEFAULT_TIMEOUT_MS"),
    BASH_MAX_TIMEOUT_MS: pick("BASH_MAX_TIMEOUT_MS"),
  };
}

/**
 * Shell command run inside the sandbox at boot to materialize `.env` from
 * `$SANDCASTLE_PROJECT_DOTENV`. Exported so tests can assert structural
 * properties (atomic 0o600, backup-on-existing, no shell redirection)
 * without spinning up a real container.
 *
 * Behavior:
 *   1. If `.env` already exists, rename it to
 *      `.env.sandcastle-bak.<ISO-timestamp-safe>` (colons + dots in the
 *      timestamp are replaced with `-` so the filename is valid on every
 *      target FS).
 *   2. Write `process.env.SANDCASTLE_PROJECT_DOTENV` (or empty string
 *      fallback) to `.env` with `mode: 0o600` — the kernel applies the
 *      mode at create time via open(2), so there is no permissive-mode
 *      window between create and chmod.
 *
 * Implemented as `node -e` rather than shell because:
 *   - `printf %s > .env` is a shell redirect to `.env`, which the user's
 *     global CLAUDE.md forbids (RTK destroyed a `.env` on a VPS once via
 *     a similar pattern).
 *   - `chmod 600` after-create has a brief race window.
 *   - Node's `fs.writeFileSync` with `mode: 0o600` is atomic w.r.t. mode.
 *
 * Uses `require('fs')` (not ESM imports) because `node -e` doesn't do
 * ESM cleanly.
 */
export const WRITE_PROJECT_DOTENV_COMMAND =
  `node -e "` +
  `const fs=require('fs');` +
  `const p='.env';` +
  `if(fs.existsSync(p)){` +
  `const ts=new Date().toISOString().replace(/[:.]/g,'-');` +
  `fs.renameSync(p,p+'.sandcastle-bak.'+ts);` +
  `}` +
  `fs.writeFileSync(p,process.env.SANDCASTLE_PROJECT_DOTENV||'',{mode:0o600});` +
  `"`;

/**
 * onSandboxReady hook command: register the context7 docs MCP inside the
 * sandbox container at boot, so the implementer can pull live, version-correct
 * library documentation while coding.
 *
 * Why this runs *inside* the container instead of mounting host MCP config:
 *   - The loop bind-mounts the `~/.claude` *directory* but NOT the sibling
 *     `~/.claude.json` *file*, which is where user-scope MCP config actually
 *     lives — so a host-registered context7 never reaches the container.
 *   - `claude mcp add --scope user` run in-container writes the container's
 *     own `/home/agent/.claude.json`; the host config is never touched.
 *   - The key is read from `$CONTEXT7_API_KEY`, which the loop already
 *     forwards in as a docker env var (every root-`.env` key flows through
 *     `readProjectEnv` → `containerEnv`). Resolving it in the boot shell
 *     avoids any dependency on `${ENV}` expansion inside `~/.claude.json`.
 *
 * FAILS CLOSED: the whole command is guarded on a non-empty key and ends in
 * `|| true`, so a project without `CONTEXT7_API_KEY` gets graceful absence —
 * no context7, no error, no behavior change. It cannot break existing slices.
 * The same silence covers a REAL failure: a bad key or a network fault is
 * swallowed exactly as quietly as a missing key.
 *
 * Deliberately NOT generalized into a "register any MCP server" mechanism.
 */
export const REGISTER_CONTEXT7_MCP_COMMAND =
  `if [ -n "$CONTEXT7_API_KEY" ]; then ` +
  `claude mcp add --scope user --transport http context7 ` +
  `https://mcp.context7.com/mcp ` +
  `--header "CONTEXT7_API_KEY: $CONTEXT7_API_KEY" >/dev/null 2>&1 || true; ` +
  `fi`;

/**
 * Docker `onSandboxReady` staging command for the Codex `AGENTS.md` file. Copies
 * `.sandcastle/AGENTS.md` up to the worktree root (where Codex reads it) only
 * when the project ships our source AND has no `AGENTS.md` of its own
 * (no-clobber), then git-excludes our copy so the agent can't commit it.
 * `info/exclude` is resolved via `git rev-parse --git-path` because `.git` is a
 * FILE in a worktree (a literal path fails). FAILS CLOSED (`|| true`):
 * a best-effort cosmetic copy must never abort the onSandboxReady chain. The
 * mac-host mirror is `stageCodexAgentsMdIntoWorktree` in `mac-host-sandbox.ts` —
 * keep the two in lockstep.
 */
export const STAGE_CODEX_AGENTS_MD_COMMAND =
  "if [ -f .sandcastle/AGENTS.md ] && [ ! -f AGENTS.md ]; then " +
  "cp .sandcastle/AGENTS.md AGENTS.md; " +
  'ex="$(git rev-parse --git-path info/exclude)"; ' +
  'grep -qxF AGENTS.md "$ex" 2>/dev/null || echo AGENTS.md >> "$ex"; ' +
  "fi || true";

/**
 * Wall-clock bound on the in-sandbox dependency install (2026-08-31 freeze).
 *
 * On 2026-08-31 the loop froze for 6.5h because this `pnpm install` hung with
 * NO timeout: the SDK runs every `onSandboxReady` hook as a bare
 * `docker exec …` with no `AbortSignal` and no bound (`CreateSandboxOptions`
 * has no `signal`), so a wedged install is an INDEFINITE freeze the recovery
 * chain never sees. Ten minutes is generous for a `--frozen-lockfile
 * --prefer-offline` install off the bind-mounted lockfile (no network), yet
 * finite — so a hang is KILLED (coreutils exit 124/137) and `createSandbox`
 * fails loudly, routing into the per-issue catch chain instead of hanging.
 */
export const SANDBOX_INSTALL_TIMEOUT_MS = 10 * 60_000;

/**
 * The in-sandbox install `onSandboxReady` command, POSIX-`timeout`-wrapped so a
 * hung install self-kills (2026-08-31 freeze — see
 * {@link SANDBOX_INSTALL_TIMEOUT_MS}). `node:22-bookworm-slim` ships GNU
 * coreutils, so the `timeout` wrapper is really there. `--frozen-lockfile
 * --prefer-offline` keep the install off the network (the bind-mounted worktree
 * carries pnpm-lock.yaml), and `--ignore-scripts` skips lifecycle scripts
 * entirely — belt-and-suspenders even after the root `postinstall` (which
 * fetched `sherif@latest` over the network and hung the whole run for 6h on
 * 2026-08-31) was removed. The sandbox must never resolve a dependency over the
 * network at build time.
 */
export const SANDBOX_INSTALL_COMMAND = wrapWithPosixTimeout(
  "CI=true pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
  SANDBOX_INSTALL_TIMEOUT_MS,
);

function parseDotenvFile(filePath: string): Record<string, string> {
  let raw: string;
  try {
    raw = readFileSync(filePath, "utf-8");
  } catch {
    return {};
  }
  const env: Record<string, string> = {};
  for (const line of raw.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const eq = trimmed.indexOf("=");
    if (eq < 0) continue;
    const key = trimmed.slice(0, eq).trim();
    let val = trimmed.slice(eq + 1).trim();
    if (
      (val.startsWith('"') && val.endsWith('"')) ||
      (val.startsWith("'") && val.endsWith("'"))
    ) {
      val = val.slice(1, -1);
    }
    if (key) env[key] = val;
  }
  return env;
}

/**
 * Read the target project's dotenv files so the orchestrator can pass real
 * Supabase / Postgres / API-key values into the sandbox via docker `-e`.
 *
 * Why this is needed: target repos often keep their real
 * POSTGRES_URL in `.env` at the main-repo root and only symlink `.env.local`
 * into worktrees (and even that symlink is broken inside the bind-mounted
 * sandbox). Without surfacing those vars as docker env, the Next.js dev-
 * server can't initialise, playwright can't run, and every UI story HALTs.
 *
 * Search order (later files override earlier ones, matching Next.js's
 * `.env*` loading order):
 *
 *   1. mainRepoRoot/.env
 *   2. mainRepoRoot/.env.local
 *   3. repoRoot/.env             (worktree overlay)
 *   4. repoRoot/.env.local       (worktree overlay)
 *
 * `mainRepoRoot` is discovered via `git rev-parse --git-common-dir`, which
 * returns the shared .git directory even when invoked from a worktree.
 *
 * Security note: every key in these files reaches the sandbox process
 * environment. Don't put credentials there that you don't want the agent
 * to see / log.
 */
function readProjectEnv(repoRoot: string): Record<string, string> {
  const resolvedRepo = path.resolve(repoRoot);
  let mainRoot = resolvedRepo;
  try {
    const out = execFileSync("git", ["rev-parse", "--git-common-dir"], {
      cwd: resolvedRepo,
      encoding: "utf-8",
    });
    const commonDir = path.resolve(resolvedRepo, out.trim());
    mainRoot = path.dirname(commonDir);
  } catch {
    /* not a git repo; mainRoot stays = resolvedRepo */
  }

  const candidates = [
    path.join(mainRoot, ".env"),
    path.join(mainRoot, ".env.local"),
  ];
  if (resolvedRepo !== mainRoot) {
    candidates.push(
      path.join(resolvedRepo, ".env"),
      path.join(resolvedRepo, ".env.local"),
    );
  }

  const merged: Record<string, string> = {};
  for (const f of candidates) {
    Object.assign(merged, parseDotenvFile(f));
  }
  return merged;
}

/**
 * The test-database URL the sandbox is allowed to use — never the project's
 * production one.
 *
 * `readProjectEnv` above deliberately forwards the target repo's real `.env`
 * so the dev server / test runner can boot inside the container. For most keys
 * that is what we want; for the DATABASE it is exactly what we don't: that
 * `.env` may carry a live production URL. Overriding here covers BOTH channels
 * the value travels on: the docker `-e` environment AND the literal `.env` the
 * `writeProjectDotenv` boot hook writes inside the container (both are derived
 * from the same record at the call site).
 *
 * Only active when a test database is in use: `testDatabase` is set in
 * `.sandcastle/project.json`, or `SANDCASTLE_TEST_DB_URL` is set. Otherwise
 * the sandbox's database variables are left exactly as the project's own
 * `.env` has them.
 *
 * WHICH HOSTNAME depends on where the agent actually runs, so the default is
 * computed, not a constant. The disposable test Postgres is published on the
 * HOST, so:
 *
 *   - `--sandbox mac-host` runs the agent natively on the host (no container
 *     at all — see lib/mac-host-sandbox.ts, which spreads this same env into a
 *     bare host child), so `localhost` is correct there and
 *     `host.docker.internal` would not resolve.
 *   - docker on macOS: `localhost` inside a container is the container. The
 *     macOS runtimes (OrbStack, Docker Desktop) resolve
 *     `host.docker.internal`.
 *   - docker on LINUX: `host.docker.internal` does NOT exist unless the run
 *     adds `--add-host=host.docker.internal:host-gateway`, and the sandbox SDK
 *     exposes no flag for that. The default bridge gateway is the host and a
 *     test container publishes on 0.0.0.0, so `172.17.0.1` — Docker Engine's
 *     default bridge gateway — is used instead. UNVERIFIED on every Linux
 *     setup; if the gateway differs (`docker network inspect bridge`), set
 *     `SANDCASTLE_TEST_DB_URL`.
 *
 * `SANDCASTLE_TEST_DB_URL` overrides all of it, and `SANDCASTLE_TEST_PG_PORT`
 * changes the port of the default URL (default 55432) — without it, changing
 * the port silently points the sandbox at a closed one.
 */
export function sandboxTestDbHost(
  sandbox: "docker" | "mac-host",
  platform: string = process.platform,
): string {
  if (sandbox === "mac-host") return "localhost";
  return platform === "linux" ? "172.17.0.1" : "host.docker.internal";
}

/**
 * The env keys forced into the sandbox, overriding whatever the project's
 * dotenv files carry — the DB-URL pair (the test database's URL when one is in
 * use, otherwise blanked), PLUS the one credential in a Supabase project's dotenv with no
 * legitimate sandbox use at all: its live SERVICE-ROLE key, which bypasses
 * row-level security and authenticates straight to the real storage project
 * regardless of which Postgres the app is pointed at. Blanked to `""`, not
 * omitted: this object is spread OVER `readProjectEnv`'s output at the call
 * site, so an OMITTED key would leave the real value untouched. Harmless when
 * the project has no such key.
 *
 * This object also strips two host-only dev-server vars
 * (`SANDCASTLE_DEV_HOST`, `SANDCASTLE_SHARED_HOST`) for the same "correct on
 * the host, wrong in the sandbox" reason. Neither is a credential.
 * `SANDCASTLE_DEV_HOST` names a host network interface (a Tailscale IP) absent
 * from the sandbox's namespace; `SANDCASTLE_SHARED_HOST` is a shared-vs-private
 * POLICY FLAG that, left set, forces that dead bind. A project whose dev
 * server reads them (the loop does not) would fail with `EADDRNOTAVAIL` and
 * every browser check would grade nothing. Blanking both lets the sandbox dev
 * server bind loopback. This function is the single chokepoint every launch
 * path spreads over `readProjectEnv`, which is why both classes of override
 * live here despite the DB-focused name.
 */
export function sandboxTestDbEnv(
  sandbox: "docker" | "mac-host",
  env: NodeJS.ProcessEnv = process.env,
  platform: string = process.platform,
  config: ProjectConfig = getProjectConfig(),
): Record<string, string> {
  const hostOnly = {
    SUPABASE_SERVICE_ROLE_KEY: "",
    SANDCASTLE_DEV_HOST: "",
    SANDCASTLE_SHARED_HOST: "",
  };
  // No test database configured: the production-database fence still holds.
  // The project's own dotenv may carry a live database URL, so blank the pair
  // rather than forward it — a project with no database loses nothing, one
  // with a database fails closed instead of handing the agent the real one.
  if (config.testDatabase === null && !env.SANDCASTLE_TEST_DB_URL) {
    return { POSTGRES_URL: "", DATABASE_URL: "", ...hostOnly };
  }
  // `||` not `??` throughout: an empty string is never a legitimate port or
  // connection string, and `??` would keep it.
  const port = env.SANDCASTLE_TEST_PG_PORT || "55432";
  const url =
    env.SANDCASTLE_TEST_DB_URL ||
    `postgres://postgres:postgres@${sandboxTestDbHost(sandbox, platform)}:${port}/postgres`;
  if (url.includes("supabase.co")) {
    throw new Error(
      "SANDCASTLE_TEST_DB_URL points at a Supabase-hosted DB — refusing to " +
        "hand the sandbox a production database.",
    );
  }
  return { POSTGRES_URL: url, DATABASE_URL: url, ...hostOnly };
}

/**
 * The ADMIN connection (`CREATE`/`DROP DATABASE`, the template probe) for the
 * per-job database clones. Runs HOST-side — it shells out to the host's
 * `psql`, not to the agent's sandbox — so the host address is `localhost`.
 * `sandboxTestDbHost` above deliberately returns `host.docker.internal` /
 * `172.17.0.1` instead; those are how a CONTAINER reaches the same database
 * and are unreachable from here.
 *
 * `SANDCASTLE_TEST_DB_ADMIN_URL` is the operator escape hatch, guarded by
 * `assertDisposableDbTarget` so it cannot be used to smuggle production back
 * in. The guard is an ALLOWLIST (loopback/gateway host, never port 5432), so
 * the hatch can only redirect to another disposable local Postgres. That is
 * deliberate: nothing this loop writes has been reviewed by a human yet, and
 * "somewhere else" is not a property we can verify from a connection string.
 */
export function testDbAdminUrl(
  env: NodeJS.ProcessEnv = process.env,
): string {
  // `||` not `??`: an empty string is never a legitimate port or connection
  // string, and `??` would keep it.
  const port = env.SANDCASTLE_TEST_PG_PORT || "55432";
  const url =
    env.SANDCASTLE_TEST_DB_ADMIN_URL ||
    `postgres://postgres:postgres@localhost:${port}/postgres`;
  // Naming the escape hatch as the subject keeps the failure pointed at the
  // knob the operator actually turned — which is the port override when the
  // escape hatch is unset, because `SANDCASTLE_TEST_PG_PORT=5432` is the form
  // of this mistake that does not involve a hosted database at all.
  assertDisposableDbTarget(
    url,
    env.SANDCASTLE_TEST_DB_ADMIN_URL
      ? "SANDCASTLE_TEST_DB_ADMIN_URL"
      : "testDbAdminUrl (SANDCASTLE_TEST_PG_PORT)",
  );
  return url;
}

/**
 * The identity for commits made INSIDE the agent container, where no repo
 * config of ours is reachable. Definition and rationale live in
 * `lib/git/identity.ts` — one place, so a commit site cannot drift from it.
 */
function buildGitEnv(): Record<string, string> {
  return agentIdentityEnv();
}

/**
 * Pin the agent identity in the HOST repo's own git config, once per run.
 *
 * This is the BELT. The braces are `agentIdentityArgs()` spliced into each
 * host-side commit site (`lib/state/branch-checkpoint.ts`,
 * `lib/paths/protected-path-restore.ts`), which is what actually guarantees
 * the identity: `-c` travels with the command, so a read-only checkout, a
 * `config.lock` collision, or a fresh clone whose first action is a
 * stop/checkpoint cannot silently drop it back to the machine's own name.
 *
 * What this adds on top: it fixes the identity for git commands nobody here
 * wrote — an interactive session's own `git commit`, and the merge commits the
 * promote / converge / lane-sync paths create — on every host the loop runs
 * on, without per-host setup.
 *
 * Written to `--local` (this checkout only), and read with `--local` too:
 * reading the EFFECTIVE value would see a matching global setting, return
 * early, and leave the repo's guarantee resting on machine-wide state that
 * anything could later flip.
 *
 * Repo config, not `GIT_AUTHOR_*` env: env OUTRANKS `-c user.name`, so
 * exporting it would clobber the deliberate `sandcastle-lock` /
 * `sandcastle-status` / `sandcastle-telemetry` bookkeeping identities and
 * break the amend check that matches on the telemetry committer email. Config
 * is outranked by `-c`, so those keep working.
 *
 * Idempotent and self-healing. Failure warns and continues — the `-c` at each
 * commit site already carries the guarantee, so a config write is not worth
 * aborting a night's work over.
 */
export function ensureAgentGitIdentity(repoRoot: string): void {
  const set = (key: string, value: string): void => {
    try {
      const current = execFileSync(
        "git",
        ["-C", repoRoot, "config", "--local", key],
        { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
      ).trim();
      if (current === value) return;
    } catch {
      // Not set locally yet — fall through and write it.
    }
    try {
      execFileSync("git", ["-C", repoRoot, "config", "--local", key, value], {
        stdio: "ignore",
      });
    } catch (err) {
      process.stderr.write(
        `WARN: git identity: could not set ${key}=${value} on ${repoRoot} ` +
          `(${(err as Error).message}). Commits made by git commands outside ` +
          `this file — an interactive session, a merge — may land under the ` +
          `checkout's existing name this run.\n`,
      );
    }
  };
  const identity = agentCommitIdentity();
  set("user.name", identity.name);
  set("user.email", identity.email);
}

// ---------------------------------------------------------------------------
// Staging branch — git helpers
// ---------------------------------------------------------------------------

// The persistent staging branch name (`STAGING_BRANCH`, reused across
// iterations) is owned by `lib/state` and imported at the top of this file, so
// state-layer code that reasons about the strand names it from one place
// instead of re-hardcoding the literal.

/** `git branch --merged` format flag — emit short refnames (no leading "* "). */
const GIT_BRANCH_FORMAT_ARG = "--format=%(refname:short)";

/**
 * Absolute path to the dedicated staging worktree. Set by
 * `ensureStagingWorktree` during the CLI boot sequence (after preflight,
 * before `runMain`). The merger phase runs with this as its cwd so the launch
 * worktree's HEAD is never written to. Empty string when staging hasn't been
 * wired (e.g. unit tests that drive `runMain` directly without booting).
 */
let stagingWorktreePath = "";

/** Test seam: reset module-level staging path. Used by unit tests only. */
export function __setStagingWorktreePathForTests(p: string): void {
  stagingWorktreePath = p;
}

/**
 * Fix 1: a per-issue pipeline rejected because a PEER host holds a
 * live cross-host lease. This is the routine mutual-exclusion outcome — the
 * loser of a contended ticket — NOT a failure. The accounting loop dispatches on
 * `instanceof` this to SKIP the ticket (no consecutive-failure bump, no
 * `lastFailingIssue`) instead of letting a plain Error trip the circuit breaker.
 */
export class LeaseContendedError extends Error {
  readonly issue: number;
  constructor(issue: number) {
    super(`lease contended: #${issue} held by another host`);
    this.name = "LeaseContendedError";
    this.issue = issue;
  }
}

/**
 * Thrown when the project's `testDatabase.setupCommand` fails against a fresh
 * per-job clone. Carries the command's own output tail so the failure is
 * actionable from the run log alone, and lets the breaker/telemetry tell a
 * TEST-DATABASE fault apart from an ordinary ticket fault.
 */
export class TestDatabaseSetupError extends Error {
  constructor(detail: string) {
    super(`the test database setup command failed: ${detail}`);
    this.name = "TestDatabaseSetupError";
  }
}

/** How long `testDatabase.setupCommand` may run before it counts as failed. */
const TEST_DATABASE_SETUP_TIMEOUT_MS = 10 * 60 * 1000;

/**
 * Run the project's `testDatabase.setupCommand` (argv, no shell) in `cwd` with
 * the clone's connection string in `DATABASE_URL`. Rejects with the output
 * tail on a non-zero exit, a timeout, or a command that cannot start.
 */
export function runTestDatabaseSetup(
  command: readonly string[],
  cwd: string,
  databaseUrl: string,
): Promise<void> {
  return new Promise((resolve, reject) => {
    let tail = "";
    const keep = (chunk: Buffer): void => {
      tail = (tail + chunk.toString("utf8")).slice(-2000);
    };
    const child = spawn(command[0]!, command.slice(1), {
      cwd,
      env: { ...process.env, DATABASE_URL: databaseUrl, POSTGRES_URL: databaseUrl },
      stdio: ["ignore", "pipe", "pipe"],
    });
    const timer = setTimeout(() => child.kill("SIGKILL"), TEST_DATABASE_SETUP_TIMEOUT_MS);
    child.stdout?.on("data", keep);
    child.stderr?.on("data", keep);
    child.on("error", (err) => {
      clearTimeout(timer);
      reject(new Error(`\`${command.join(" ")}\` could not start: ${err.message}`));
    });
    child.on("close", (code, signal) => {
      clearTimeout(timer);
      if (code === 0) resolve();
      else
        reject(
          new Error(
            `\`${command.join(" ")}\` ${signal !== null ? `was killed (${signal})` : `exited ${code}`}` +
              ` — ${tail.trim().split("\n").slice(-5).join(" | ") || "no output"}`,
          ),
        );
    });
  });
}

/**
 * Fix 5: bounded git timeout for the cross-host LEASE ref ops only.
 * The general {@link runGit} — imported from `./lib/state/git-exec.js` — is
 * deliberately unbounded, but a hung lease `push`/`ls-remote` (dead TCP,
 * captive-portal NAT) would freeze the whole synchronous loop indefinitely.
 * `execFileSync`'s `timeout` kills the child and throws; being synchronous, the
 * timeout also frees the event loop — the point.
 */
const LEASE_GIT_TIMEOUT_MS = 30_000;

/**
 * Stderr/kill-signal signatures that mean a TRANSIENT network/timeout fault
 * worth a single retry. Deliberately narrow: a clean push rejection
 * (contention) and an auth failure are DETERMINISTIC — retrying them is
 * pointless and, for auth, dangerous (it would mask a systemic fault). Matched
 * case-insensitively as substrings.
 */
const LEASE_TRANSIENT_SIGNATURES: readonly string[] = [
  "etimedout",
  "timed out",
  "killed by timeout",
  "could not resolve host",
  "connection",
  "unable to access",
  "sigterm",
  "sigkill",
];

/**
 * Auth/permission signatures. A deterministic auth failure is NEVER retried
 * (the doc above says so). These VETO the transient classification even when a
 * transient substring also matches — git's HTTP 403/401 wording is
 * `fatal: unable to access '...': The requested URL returned error: 403`, which
 * contains the transient "unable to access" but must NOT be retried.
 */
const LEASE_AUTH_SIGNATURES: readonly string[] = [
  "403",
  "401",
  "authentication",
  "could not read username",
  "permission denied",
];

/** True when a FAILED lease git result looks transient (timeout/network). */
export function isTransientLeaseGitFailure(res: GitRunResult): boolean {
  if (res.ok) return false;
  const text = `${res.stderr}\n${res.stdout}`.toLowerCase();
  // Auth failures are deterministic — an auth signature vetoes any transient
  // match so a 403 "unable to access" is not pointlessly retried.
  if (LEASE_AUTH_SIGNATURES.some((sig) => text.includes(sig))) return false;
  return LEASE_TRANSIENT_SIGNATURES.some((sig) => text.includes(sig));
}

/**
 * Retry wrapper for a lease git call — pure over an injected single-attempt
 * runner so the retry policy is unit-testable without shelling out. Runs
 * `once`; on a TRANSIENT failure (see {@link isTransientLeaseGitFailure}) tries
 * once more (2 attempts total). Never retries a contention rejection or an auth
 * failure — those surface on the first result. No backoff: the retry only fires
 * after a genuine 30s timeout has already elapsed, so an immediate second try is
 * correct and a synchronous sleep would defeat the timeout's whole purpose.
 */
export function runGitLeaseRetrying(
  once: (...args: string[]) => GitRunResult,
  ...gitArgs: string[]
): GitRunResult {
  const MAX_ATTEMPTS = 2;
  let last = once(...gitArgs);
  for (
    let attempt = 2;
    attempt <= MAX_ATTEMPTS && isTransientLeaseGitFailure(last);
    attempt += 1
  ) {
    last = once(...gitArgs);
  }
  return last;
}

/** Single bounded-timeout git attempt for the lease backend (see runGitLease). */
function runGitLeaseOnce(repoRoot: string, ...gitArgs: string[]): GitRunResult {
  try {
    const stdout = execFileSync("git", gitArgs, {
      cwd: repoRoot,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
      timeout: LEASE_GIT_TIMEOUT_MS,
    });
    return { ok: true, stdout: stdout.trim(), stderr: "" };
  } catch (err) {
    const e = err as Error & {
      stderr?: Buffer | string;
      stdout?: Buffer | string;
      killed?: boolean;
      signal?: string;
    };
    const stderr =
      typeof e.stderr === "string" ? e.stderr : (e.stderr?.toString() ?? "");
    const stdout =
      typeof e.stdout === "string" ? e.stdout : (e.stdout?.toString() ?? "");
    // A timeout kill surfaces as `killed` + a signal, often with EMPTY stderr;
    // fold the signal into stderr so the retry classifier can see it.
    const signalNote = e.killed
      ? ` ${e.signal ?? "SIGTERM"} (killed by timeout)`
      : "";
    return {
      ok: false,
      stdout: stdout.trim(),
      stderr: (stderr.trim() || e.message) + signalNote,
    };
  }
}

/**
 * Lease-dedicated git runner passed to {@link createGitLockBackend}: a bounded
 * `execFileSync` under a small transient-only retry. The rest of the loop keeps
 * the unbounded {@link runGit}.
 */
function runGitLease(repoRoot: string, ...gitArgs: string[]): GitRunResult {
  return runGitLeaseRetrying(
    (...a: string[]) => runGitLeaseOnce(repoRoot, ...a),
    ...gitArgs,
  );
}

/**
 * True when the local `branch` ref has commits the default branch (`base`,
 * as `origin/<base>`) doesn't — i.e. there's something worth pushing/PR-ing.
 * Used by `finishRun` to distinguish a genuine no-op startup refusal (branch
 * never created, nothing to lose) from a run that ended early but left real
 * work sitting on a local branch.
 *
 * Deliberately asymmetric on failure: if the branch ref doesn't exist at all,
 * that's a real "nothing happened yet" — return false. If it EXISTS but we
 * can't establish a merge-base (e.g. `origin/<base>` isn't fetched locally),
 * we cannot tell whether it's ahead — assume yes rather than silently
 * dropping possibly-real work.
 */
export function branchHasCommitsAheadOfBase(
  repoRoot: string,
  branch: string,
  base: string,
): boolean {
  const branchTip = runGit(repoRoot, "rev-parse", "--verify", branch);
  if (!branchTip.ok) return false;
  const mergeBase = runGit(repoRoot, "merge-base", `origin/${base}`, branch);
  if (!mergeBase.ok) return true;
  return mergeBase.stdout.trim() !== branchTip.stdout.trim();
}

/**
 * The telemetry store's path as GIT prints it.
 *
 * git always speaks forward slashes; `REWORK_STORE_RELATIVE_PATH` is built with
 * `node:path`'s `join`, which uses the platform separator. They agree on darwin
 * and linux (the only hosts this loop runs on) but would not on win32 — where
 * the mismatch would fail SILENTLY at BOTH of the two sites that compare git
 * output against it (`branchHasShippableContent`'s `diff --name-only`, and
 * `fastForwardIntegration`'s `status --porcelain`), reading every telemetry-only
 * path as somebody else's content. Normalised once, here, rather than relying
 * on the coincidence twice.
 */
const REWORK_STORE_POSIX_PATH = REWORK_STORE_RELATIVE_PATH.split(path.sep).join(
  "/",
);

/**
 * Does this branch carry anything a HUMAN would want pushed — i.e. content, as
 * opposed to the loop's own bookkeeping?
 *
 * The distinction did not used to exist: before rework telemetry, a run that
 * shipped nothing made no commits at all, so `branchHasCommitsAheadOfBase`
 * doubled as "has content" and an all-quarantine run correctly ended in
 * "nothing to ship — no push, no PR". That is no longer true. A review-verdict
 * quarantine carries a `postSha`, so it WRITES a telemetry line, and that line
 * is committed — which makes "commits ahead of base" true on a run whose only
 * product is one JSONL row. Pushing that opens a fresh orphaned remote branch
 * per FAILED run, and leftover branches are a real, compounding cost in this
 * repo, not a neutral.
 *
 * So the question is asked of the DIFF, not of the commit count: is any path
 * other than the telemetry store touched between the base and the tip?
 *
 * ACCEPTED TRADE, stated rather than buried: on a ship-nothing run the
 * telemetry commit therefore stays local and is lost with the branch. That is
 * the right way round — the row describes a quarantine that has no shipped code
 * to be reworked later anyway, and a permanent orphan branch on origin costs
 * more than one lost row of "this failed" data.
 *
 * Fails OPEN (returns true) whenever git cannot answer: never silently withhold
 * a push of work that might be real.
 */
export function branchHasShippableContent(
  repoRoot: string,
  branch: string,
  base: string,
): boolean {
  if (!branchHasCommitsAheadOfBase(repoRoot, branch, base)) return false;
  // `origin/${base}...` — the SAME ref `branchHasCommitsAheadOfBase` merge-bases
  // against. Using the bare local `base` here instead would let a stale local
  // `main` make the two functions disagree about what is new.
  const diff = runGit(
    repoRoot,
    "diff",
    "--name-only",
    `origin/${base}...${branch}`,
  );
  if (!diff.ok) return true;
  const paths = diff.stdout
    .split("\n")
    .map((p) => p.trim())
    .filter((p) => p !== "");
  // Commits with an empty net diff (empty/revert-pair commits) are somebody
  // else's intent, so they still count as content.
  if (paths.length === 0) return true;
  return paths.some((p) => p !== REWORK_STORE_POSIX_PATH);
}

/**
 * How long the merge rule waits for the run PR's checks before leaving the PR
 * for the owner (tokenmaxxing#29). CI (lint, format, typecheck) takes about a
 * minute and a half; a Vercel preview can take several. A check still running
 * at the deadline is not a green check, so the PR simply waits.
 */
const RUN_PR_CHECKS_TIMEOUT_MS = 20 * 60_000;
const RUN_PR_CHECKS_POLL_MS = 30_000;

/**
 * The run PR's body (tokenmaxxing#29): Matt Pocock's `pr` skill shape —
 * Summary, Evidence, Merge Danger — then the loop's own bookkeeping: the
 * warnings, the `Closes #N` lines, the previously-shipped list and the run
 * report. The Merge Danger section sits between markers so `settleRunPr` can
 * replace its last line with the final outcome. Pure.
 */
export function buildRunPrBody(input: {
  readonly branch: string;
  readonly shippedIssueNums: readonly number[];
  /** The branch's diff against the base; `undefined` when it could not be read. */
  readonly files: readonly ChangedFile[] | undefined;
  readonly change: ChangeClass | undefined;
  readonly opts?: {
    readonly promotionFailed?: boolean;
    readonly previouslyShipped?: readonly { number: number; title: string }[];
    readonly breakerTrip?: string;
    readonly report?: string;
    readonly hostId?: string;
  };
}): string {
  const { branch, shippedIssueNums, opts } = input;
  const lead = `Autonomous run \`${branch}\`: ${shippedIssueNums.length} issue(s) certified by the loop.`;
  const danger =
    input.change === undefined
      ? [
          "## Merge Danger",
          "",
          "**Door:** unknown",
          "",
          "**Blast Radius:** unknown",
          "",
          `**Merge rule:** waits for ${getProjectConfig().ownerName} (the loop could not read this branch's diff).`,
        ].join("\n")
      : renderMergeDanger(input.change, plannedMergeLine(input.change));
  // `Closes #N` is the whole point: merging the PR closes the issues, so
  // "closed" can only mean "the code is on the default branch". Nothing
  // else in the pipeline is allowed to close them.
  const closes = shippedIssueNums.map((n) => `Closes #${n}`).join("\n");
  const bodyParts = [
    input.files === undefined ? ["## Summary", "", lead].join("\n") : renderSummary(lead, input.files),
    "",
    "## Evidence",
    "",
    `- **Before:** ${shippedIssueNums.map((n) => `#${n}`).join(", ") || "no issue"} open on the default branch.`,
    "  **After:** each one certified by the loop against its own acceptance checks on this branch;",
    "  CI runs on this PR, and the merge rule below reads its result.",
    "",
    mergeRuleSectionStart(),
    danger,
    mergeRuleSectionEnd(),
  ];
  if (opts?.breakerTrip) {
    bodyParts.push(
      "",
      "> [!WARNING]",
      "> **This run was CUT SHORT by the circuit breaker** —",
      `> ${opts.breakerTrip}. It did not work its way through the queue,`,
      "> so the issues below are what it managed before stopping, not the",
      "> night's plan. Read the run log before re-queuing.",
    );
  }
  if (opts?.promotionFailed) {
    bodyParts.push(
      "",
      "> [!WARNING]",
      "> **A final promotion FAILED during this run.** Certified work may be",
      "> stranded on the staging branch and this branch may be INCOMPLETE",
      "> relative to what was actually certified. Verify carefully before",
      "> merging — do not treat this as a clean run.",
    );
  }
  bodyParts.push(
    "",
    "---",
    "",
    "Merging this PR is what closes the issues below. They were labelled",
    "`shipped-local` while the work sat on this branch, because until it",
    "reaches the default branch it has not shipped in any sense that",
    "matters.",
    "",
    ...(getProjectConfig().landCheck !== null
      ? [
          `If this PR waits for you: run \`${getProjectConfig().landCheck!.join(" ")}\` before merging.`,
        ]
      : [
          "No pre-merge check is configured (`landCheck` in",
          "`.sandcastle/project.json`), so the loop does not land this PR itself:",
          "it waits for you.",
        ]),
    "",
    closes,
  );
  if (opts?.previouslyShipped && opts.previouslyShipped.length > 0) {
    bodyParts.push(
      "",
      "---",
      "",
      "**Previously shipped by an interrupted run (verify before merging):**",
      "",
      "These issues already carry `shipped-local` from an earlier run that",
      "never opened a PR. This run could not verify their code is actually",
      "present on this branch, so they are NOT in the `Closes` list above —",
      "check each one by hand and add `Closes #N` yourself once confirmed.",
      "",
      ...opts.previouslyShipped.map((i) => `- #${i.number} ${i.title}`),
    );
  }
  // Issue #1179's end-of-run report — appended last so it always sits
  // below the run's own bookkeeping, wrapped in its own marker section
  // so a RELAUNCH on this same branch can find and REPLACE just this
  // block later (see `upsertRunPrReport` in `lib/state/gh.ts`, called
  // by `finishRun` right after this function returns).
  if (opts?.report !== undefined) {
    const hostId = opts.hostId ?? resolveHostId();
    bodyParts.push(
      "",
      "---",
      "",
      runReportSectionStart(hostId),
      titleRunReport(opts.report, hostId),
      runReportSectionEnd(hostId),
    );
  }
  return bodyParts.join("\n");
}

/**
 * Read what the run branch changes against `origin/<base>` and classify it
 * under the merge rule (tokenmaxxing#29) — the diff, plus the SQL of every
 * added migration so the sorter (spec #1334) can tell a migration that only
 * adds from one that deletes or rewrites existing data.
 *
 * Everything is read at ONE commit, `headSha`, resolved first: the migration
 * content judged is exactly the commit `settleRunPr` later pins its land to.
 * A failed diff read leaves `files` and `change` undefined (the PR body then
 * says the door is unknown and the loop never self-merges); a migration whose
 * content cannot be read stays out of `migrationSql`, which the merge rule
 * treats as holding.
 */
export function readRunChange(
  repoRoot: string,
  base: string,
  branch: string,
  facts: Omit<RunFacts, "files" | "migrationSql">,
): { files?: ChangedFile[]; change?: ChangeClass; headSha: string } {
  const head = runGit(repoRoot, "rev-parse", branch);
  const headSha = head.ok ? head.stdout.trim() : "";
  if (headSha === "") return { headSha };
  const range = `origin/${base}...${headSha}`;
  const numstat = runGit(repoRoot, "diff", "--no-renames", "--numstat", range);
  const nameStatus = runGit(repoRoot, "diff", "--no-renames", "--name-status", range);
  if (!numstat.ok || !nameStatus.ok) return { headSha };
  const files = parseDiff(numstat.stdout, nameStatus.stdout);
  const migrationSql = new Map<string, string>();
  for (const f of files) {
    if (f.status !== "A" || !isMigrationSqlPath(f.path)) continue;
    const show = runGit(repoRoot, "show", `${headSha}:${f.path}`);
    // A failed read is left out on purpose: an unread migration holds the run.
    if (show.ok) migrationSql.set(f.path, show.stdout);
  }
  return { files, change: classifyChange({ ...facts, files, migrationSql }), headSha };
}

/**
 * Land a run whose PR the merge rule cleared: fast-forward `origin/<base>`
 * onto `headSha` with a plain, NON-forced push of that exact commit. No commit
 * is minted, so every landed commit keeps the agent authorship the loop
 * already gave it, and GitHub marks the run PR merged by itself.
 *
 * Never `gh pr merge` (project CLAUDE.md): GitHub mints that merge commit on
 * its own servers and stamps it with the owner's name. And never a force: if
 * `base` moved on since the run branch was cut, the push is refused, this
 * throws, and the PR waits for the owner. Pushes the sha straight to the
 * remote ref, so no local `base` branch (which may be checked out in some
 * worktree) is touched.
 */
export function landRunLocally(repoRoot: string, headSha: string, base: string): void {
  const push = runGitLease(repoRoot, "push", "origin", `${headSha}:refs/heads/${base}`);
  if (!push.ok) {
    throw new Error(`could not land ${headSha.slice(0, 12)} on ${base}: ${push.stderr.trim() || "push refused"}`);
  }
}

/** How long the pre-merge check may run before it counts as failed. */
const VERIFY_LAND_TIMEOUT_MS = 2 * 60 * 60 * 1000;

/**
 * Run the project's `landCheck` command (`.sandcastle/project.json`) on the
 * run branch tip before the loop lands its own run PR. Once per run, never
 * per ticket. Refuses — never guesses —
 * when the checkout is not at `headSha`, because a check of other bytes
 * proves nothing about the commit being landed. Never throws.
 *
 * In a normal run that refusal cannot fire: preflight check 9 refuses to
 * launch unless the checkout's HEAD is ATTACHED to `--branch`, so `HEAD` and
 * the run branch are the same ref; `readRunChange` reads `headSha` off that
 * ref; and nothing commits between `openRunPr` and the settle. It fires only
 * when something outside the loop moved the checkout mid-run, and then holding
 * the run for the owner is the right answer, not a check of other bytes.
 */
export async function verifyLandAt(
  repoRoot: string,
  headSha: string,
  landCheck: readonly string[] = getProjectConfig().landCheck ?? [],
): Promise<{ readonly ok: boolean; readonly why: string }> {
  const name = landCheck.join(" ");
  // No check configured: the loop never lands, so this should not be reached
  // — refuse rather than call an empty command a pass.
  if (landCheck.length === 0) {
    return { ok: false, why: "no pre-merge check is configured (landCheck)" };
  }
  const head = runGit(repoRoot, "rev-parse", "HEAD");
  if (!head.ok || head.stdout.trim() !== headSha) {
    return {
      ok: false,
      why:
        `the run checkout is at ${head.ok ? head.stdout.trim().slice(0, 12) : "an unreadable commit"}, ` +
        `not the commit being landed (${headSha.slice(0, 12)}), so the check could not run on it`,
    };
  }
  return await new Promise((resolve) => {
    let tail = "";
    const keep = (chunk: Buffer): void => {
      tail = (tail + chunk.toString("utf8")).slice(-2000);
    };
    const child = spawn(landCheck[0]!, landCheck.slice(1), { cwd: repoRoot, stdio: ["ignore", "pipe", "pipe"] });
    const timer = setTimeout(() => child.kill("SIGKILL"), VERIFY_LAND_TIMEOUT_MS);
    child.stdout?.on("data", keep);
    child.stderr?.on("data", keep);
    child.on("error", (err) => {
      clearTimeout(timer);
      resolve({ ok: false, why: `${name} could not start: ${err.message}` });
    });
    child.on("close", (code, signal) => {
      clearTimeout(timer);
      if (code === 0) resolve({ ok: true, why: `${name} passed` });
      else
        resolve({
          ok: false,
          why:
            `${name} ${signal !== null ? `was killed (${signal})` : `exited ${code}`}` +
            ` — ${tail.trim().split("\n").slice(-5).join(" | ") || "no output"}`,
        });
    });
  });
}

/** Name at most this many dirty paths in one log line. `-uall` expands an
 *  untracked DIRECTORY into every file under it, and a stray build output would
 *  otherwise put thousands of names in a single error the reader has to scroll
 *  past to find the one that matters. */
const MAX_DIRTY_PATHS_LOGGED = 20;

/** Join dirty paths for a log line, truncating rather than flooding it. */
function namesForLog(paths: readonly string[]): string {
  if (paths.length <= MAX_DIRTY_PATHS_LOGGED) return paths.join(", ");
  const shown = paths.slice(0, MAX_DIRTY_PATHS_LOGGED).join(", ");
  return `${shown}, +${paths.length - MAX_DIRTY_PATHS_LOGGED} more`;
}

/** The telemetry commit's exact subject. A CONSTANT rather than a literal at
 *  each site because {@link reworkTipIsAmendable} matches on it: a message that
 *  drifted from the matcher would silently stop the amend and quietly restore
 *  the one-commit-per-iteration pile it exists to prevent.
 *
 *  No `[skip ci]` (tokenmaxxing#29): CI here runs only on pull_request, so the
 *  marker never saved a push run. It only mattered when this commit was the
 *  run PR's head, which is every run whose last completion did not ship. There
 *  it suppressed every check, and the merge rule never merges a PR with none. */
const REWORK_COMMIT_MESSAGE = "chore(sandcastle): record rework telemetry";
/** Committer identity for that commit — see `commitReworkStore` for why it is
 *  set explicitly. Also the second amend gate: it is what distinguishes the
 *  loop's own commit from a human one that happens to share the subject. */
const REWORK_COMMIT_NAME = "sandcastle-telemetry";
const REWORK_COMMIT_EMAIL = "telemetry@sandcastle.local";

/**
 * Is the current tip a commit this loop may safely REWRITE?
 *
 * The loop appends one telemetry line per iteration, so committing each one
 * afresh puts twenty near-identical `chore(sandcastle): record rework telemetry`
 * commits into a twenty-iteration run's PR. Amending collapses them to one.
 *
 * Amending is history rewriting, so every gate below is a veto and the answer
 * is `false` whenever git cannot answer. In order:
 *   1. SUBJECT matches ours — necessary, and nowhere near sufficient on its own,
 *      since anyone can write that subject.
 *   2. COMMITTER is our synthetic identity — a human's commit cannot carry it
 *      unless they set it deliberately.
 *   3. EXACTLY ONE PARENT — never amend a merge commit (amending one rewrites a
 *      merge the promotion machinery made), and never amend a root commit.
 *   4. TOUCHES ONLY the store path — a commit that also carries product code is
 *      not ours no matter what its subject and committer say.
 *   5. NO OTHER BRANCH OR REMOTE-TRACKING REF REACHES IT. Asked of all of
 *      `refs/heads` and `refs/remotes`, not just `origin/<branch>`, because two
 *      different refs make it unsafe for two different reasons and one check
 *      covers both:
 *        - `origin/<branch>` ⇒ a peer host (or an earlier `finishRun`) already
 *          has the commit, and rewriting it turns the next push into a
 *          non-fast-forward rejection — `openRunPr` deliberately does not force.
 *        - `${STAGING_BRANCH}` ⇒ `resetStagingToIntegrationTip` has already
 *          pointed staging at this commit. Amending underneath it makes the
 *          integration tip stop being an ancestor of the staging tip, which
 *          drops every remaining promotion out of the clean fast-forward and
 *          into the `--no-ff` auto-merge path — a merge commit per iteration,
 *          caused by a HYGIENE fix.
 *      WHAT IT DOES NOT SCAN: the coordination refs, which live under
 *      `refs/sandcastle/*` (wip, lanes, strand, peers) and are therefore
 *      outside both prefixes. That is not an oversight to widen — a wip ref is
 *      a private checkpoint this loop reaps itself, and its holder is not
 *      pushing this branch. The gate's width is deliberate; the claim that it
 *      covered those refs was simply wrong.
 *
 * EXPORTED for testing, following `decideFirstPassReviewerModel` (`:2726`) —
 * this repo exports internals to test them rather than reaching through a full
 * `runMain`. Gate order matters when reading a `false`: an earlier veto hides a
 * later one, so the tests assert the amendable case FIRST.
 */
export function reworkTipIsAmendable(
  repoRoot: string,
  branch: string,
): boolean {
  // NUL-separated so a subject containing the separator cannot forge a field.
  const meta = runGit(
    repoRoot,
    "log",
    "-1",
    "--format=%s%x00%ce%x00%P",
    "HEAD",
  );
  if (!meta.ok) return false;
  const [subject, committerEmail, parents] = meta.stdout.split("\0");
  if (subject !== REWORK_COMMIT_MESSAGE) return false;
  if (committerEmail !== REWORK_COMMIT_EMAIL) return false;
  const parentShas = (parents ?? "")
    .trim()
    .split(/\s+/)
    .filter((p) => p !== "");
  if (parentShas.length !== 1) return false;
  const touched = runGit(repoRoot, "show", "--name-only", "--format=", "HEAD");
  if (!touched.ok) return false;
  const files = touched.stdout
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l !== "");
  if (files.length !== 1 || files[0] !== REWORK_STORE_POSIX_PATH) return false;
  // Every BRANCH and REMOTE-TRACKING ref that reaches HEAD, in one call —
  // `refs/sandcastle/*` is outside both prefixes and is not asked about, on
  // purpose (see gate 5). The branch being committed on is the one expected hit
  // and is filtered out; anything else — a peer's `origin/<branch>`,
  // `integration-candidate` — is somebody depending on this sha, and the amend
  // is off. Failure vetoes: an unanswerable "who else has this?" must never
  // read as "nobody".
  const holders = runGit(
    repoRoot,
    "for-each-ref",
    "--contains",
    "HEAD",
    "--format=%(refname)",
    "refs/heads",
    "refs/remotes",
  );
  if (!holders.ok) return false;
  const others = holders.stdout
    .split("\n")
    .map((r) => r.trim())
    .filter((r) => r !== "" && r !== `refs/heads/${branch}`);
  return others.length === 0;
}

/**
 * Commit the appended telemetry lines onto the integration branch, in the
 * LAUNCH worktree. Returns `true` when the store path is committed — including
 * when there was nothing left to commit, which is the same end state — and
 * `false` when the caller should keep its pending flag set and retry.
 *
 * WHY COMMIT AT ALL: an untracked file at the repo root is not merely
 * non-durable, it is actively harmful — `fastForwardIntegration` logs on any
 * dirt in the launch worktree, and until this file lands every promotion's merge
 * risks git's own "your local changes would be overwritten" refusal. Writing
 * without committing is strictly worse than not writing at all.
 *
 * WHY HERE AND NOT IN STAGING: `resetStagingToIntegrationTip` runs LATER in the
 * same iteration, so a commit made now is already part of the integration tip
 * staging is reset to — the merger stacks its merges on top and `merge-base
 * --is-ancestor` still passes, so this never pushes promotion into the
 * divergence/`--no-ff` path. A commit into the staging worktree would have been
 * reset away, and would have been skipped entirely on an all-quarantine
 * iteration (`mergedBranches.length === 0` `continue`s past the merge phase) —
 * losing precisely the rows this telemetry most needs.
 *
 * ALREADY-COMMITTED IS DETECTED BY EXIT CODE, NOT BY PROSE. This used to search
 * git's output for "nothing to commit"; git localises every one of those strings
 * through gettext and `runGit` passes no `env:`, so on a host with a non-English
 * `LANG` — the Linux VPS is the machine at risk — the already-committed case
 * misclassified as a failure and the loop retried it every iteration forever.
 * `git diff --cached --quiet` answers the same question with an exit code, in
 * every locale. It also subsumes the old "partial commit during a merge" special
 * case: git refuses the pathspec commit, the file stays staged, the caller's
 * flag stays set, and the next call retries once the worktree leaves that state.
 *
 * IDENTITY (`-c user.*`) mirrors `lib/state/issue-lease.ts`'s lock commit, and
 * is LOAD-BEARING for two separate reasons — do not remove it as defensive
 * clutter. First, `reworkTipIsAmendable` matches the committer email against
 * `REWORK_COMMIT_EMAIL` to decide whether the tip is this bookkeeping commit
 * and may be amended; drop the `-c` and every run appends instead of amending.
 * Second, a host with no `user.name`/`user.email` at all would fail the commit
 * outright, stranding every later promotion. (This comment previously cited
 * `buildGitEnv` as handling the no-identity case. It no longer does — it
 * returns a fixed identity; see `lib/git/identity.ts`.)
 * `--no-gpg-sign` is the other half — `runGit` is a deliberately UNBOUNDED
 * `execFileSync`, so a `commit.gpgsign=true` host whose key wants a pinentry
 * prompt would WEDGE the loop with no timeout to rescue it.
 *
 * Pathspec-limited (`git add -- <path>`, `git commit -- <path>`) so pre-existing
 * dirt in the launch worktree is neither committed nor disturbed — which holds
 * for `--amend` too: amending with a pathspec rebuilds the tip's tree from the
 * tip's own tree plus that one path. `--no-verify` because a repo-level
 * pre-commit hook (lint/typecheck/test) firing once per iteration would cost
 * minutes to validate a single appended JSON line no hook can check.
 */
export function commitReworkStore(
  repoRoot: string,
  branch: string,
  logError: (msg: string) => void,
): boolean {
  const added = runGit(repoRoot, "add", "--", REWORK_STORE_RELATIVE_PATH);
  if (!added.ok) {
    logError(
      `rework telemetry: git add ${REWORK_STORE_RELATIVE_PATH} failed: ${added.stderr} — ` +
        `the file is left uncommitted and the commit will be RETRIED at the next ` +
        `iteration/run end`,
    );
    return false;
  }
  // Exit 0 ⇒ the index matches HEAD for that path ⇒ the lines are already
  // committed (a retry after a partial success, or two calls in one iteration).
  // Terminal, not transient: attempting the commit anyway would fail, and
  // classifying THAT failure is the locale trap this replaced.
  const nothingStaged = runGit(
    repoRoot,
    "diff",
    "--cached",
    "--quiet",
    "--",
    REWORK_STORE_RELATIVE_PATH,
  );
  if (nothingStaged.ok) return true;
  const amend = reworkTipIsAmendable(repoRoot, branch) ? ["--amend"] : [];
  const committed = runGit(
    repoRoot,
    "-c",
    `user.name=${REWORK_COMMIT_NAME}`,
    "-c",
    `user.email=${REWORK_COMMIT_EMAIL}`,
    "commit",
    "--no-gpg-sign",
    "--no-verify",
    ...amend,
    "-m",
    REWORK_COMMIT_MESSAGE,
    "--",
    REWORK_STORE_RELATIVE_PATH,
  );
  if (committed.ok) return true;
  logError(
    `rework telemetry: git commit failed: ${committed.stderr} — ` +
      `${REWORK_STORE_RELATIVE_PATH} is left staged and the commit will be ` +
      `RETRIED at the next iteration/run end. (A merge in progress is the known ` +
      `benign cause: git refuses a pathspec commit until the worktree is out of ` +
      `that state, and the retry clears it.)`,
  );
  return false;
}

/**
 * Everything one run supplies to {@link recordReworkOutcome}, resolved ONCE at
 * the top of `runMain` so no two records can disagree about which run, host or
 * model map produced them.
 */
export interface ReworkRecordingContext {
  /** Absolute path to the JSONL. Derived from the MAIN repo root — deliberately
   *  NOT a worktree: the per-issue pipelines work from
   *  `.sandcastle/worktrees/<lane>`, which cleanup DELETES, so a record written
   *  there reports success and then evaporates. That is why the store refuses to
   *  default its path at all. */
  readonly storePath: string;
  readonly runId: string;
  readonly hostId: string;
  readonly dryRun: boolean;
  /** Issues already recorded this run. Enforces "exactly one line per issue per
   *  run" as a MECHANISM: the per-issue closure runs once per issue per
   *  ITERATION, and a dedup set costs one Set and removes the need to trust that
   *  a terminal outcome is never re-planned. Mutated here. */
  readonly recorded: Set<number>;
  readonly models?: ReworkRecordInput["models"];
  readonly bagRowFor: (issueNumber: number) => IssueTelemetryBagRow | undefined;
  readonly ledgerRowFor: (issueNumber: number) => IssueTelemetryRow | undefined;
  readonly log: (msg: string) => void;
  readonly logError: (msg: string) => void;
}

/**
 * Append one issue's terminal record. Returns `true` when a line was written,
 * so the caller knows there is something to commit.
 *
 * Best-effort in every direction: the store never throws, and this adds nothing
 * that can. The SHAPING of the record lives in
 * `lib/telemetry/rework-record-input.ts` — everything left here needs the run
 * (the dedup set, `--dry-run`, the store write, the missing-sha log).
 *
 * `shippedSha` (the store's one required MEASUREMENT field) comes from
 * `outcome.postSha`, the issue's own tip commit — the point a reader walks
 * history FORWARD from. The review-verdict quarantines carry it; the bare `HALT`
 * quarantines do not, and those records are correctly dropped rather than
 * invented, because THE SHA IS NOT AVAILABLE HERE. That is not the same claim as
 * "no commit exists": the skill-discipline gate's own comment says the
 * implementer's commits ARE on the agent's branch and merely have not merged. It
 * simply does not hand one back, and inventing one would make a reader walk
 * history from the wrong point. The consequence is a real, permanent blind spot,
 * so the report says so — see the "recorded quarantines are a FLOOR" note in
 * `scripts/rework-report.mts`.
 */
export function recordReworkOutcome(
  ctx: ReworkRecordingContext,
  issueNumber: number,
  status: IssueOutcome["status"],
  postSha: string | undefined,
): boolean {
  // "deferred" is NOT terminal — the issue is released back to
  // `ready-for-agent` and re-planned by the next iteration, so recording it
  // would both double-count the issue and score work that never shipped.
  if (status === "deferred") return false;
  // `--dry-run` skips every side effect that touches the world (claim,
  // quarantine, markDone); writing a tracked file and committing it is one.
  if (ctx.dryRun) return false;
  if (ctx.recorded.has(issueNumber)) return false;
  if (postSha === undefined || postSha === "") {
    // Logged rather than dropped in silence: a whole class of outcomes going
    // unrecorded is exactly how telemetry ends up quietly inert. Expected for a
    // bare `HALT` quarantine, NOT expected for an `ok` outcome — the ship paths
    // always carry a postSha.
    ctx.log(
      `[issue=${issueNumber}] rework telemetry: no ship sha for a ` +
        `'${status}' outcome — not recorded (there is no point in history to ` +
        `walk forward from, so the recorded quarantine count is a FLOOR)`,
    );
    return false;
  }
  const wrote = appendReworkRecord(
    buildReworkRecordInput({
      issueNumber,
      status,
      shippedSha: postSha,
      runId: ctx.runId,
      hostId: ctx.hostId,
      shippedAtIso: new Date().toISOString(),
      bagRow: ctx.bagRowFor(issueNumber),
      ledgerRow: ctx.ledgerRowFor(issueNumber),
      ...(ctx.models !== undefined ? { models: ctx.models } : {}),
    }),
    {
      path: ctx.storePath,
      onError: (err) =>
        ctx.logError(
          `rework telemetry skipped for #${issueNumber}: ${
            err instanceof Error ? err.message : String(err)
          }`,
        ),
    },
  );
  if (wrote) ctx.recorded.add(issueNumber);
  return wrote;
}

/**
 * The first-pass reviewer decision, plus the diff it was made from.
 *
 * The measurement is returned rather than discarded because it is the only
 * measure of an issue's actual output the loop ever computes, and it was
 * previously interpolated into a log string and thrown away.
 *
 * `diff` is OPTIONAL and absent in three cases: (a) the no-escalation-configured
 * path returns before any git runs; (b) the fail-quiet sizer swallowed a git
 * error; (c) the diff really was empty. (b) and (c) both surface as `{0, []}`
 * and are indistinguishable by construction — which is exactly why
 * {@link shouldRecordDiffMeasurement} rejects the SHAPE instead of trying to
 * tell the two apart. Reporting `0` in any of the three would claim "measured
 * an empty diff" when (a) and (b) measured nothing at all.
 */
export interface FirstPassReviewerDecision {
  /** Escalation model to use, or `undefined` for the cheap default. */
  readonly model: string | undefined;
  readonly diff?: DiffStats;
}

/**
 * Decide the model for the FIRST reviewer pass on `postSha`. Returns the
 * reviewer's escalation model when the change is substantial or touches a
 * sensitive path — one strong pass beats a cheap miss — and `undefined` (the
 * cheap default) for small, ordinary diffs so the common case is byte-identical
 * to prior behavior. Returns `undefined` when no reviewer escalation model is
 * configured; the sizer is fail-quiet so a git hiccup falls back to the default
 * too. IO-bound (runs git via {@link reviewDiffStats}); the pure, unit-tested
 * core is {@link parseNumstat} + {@link shouldEscalateReviewer}.
 *
 * EXPORTED for testing, following `roleModelsFor` (`:1197`) and
 * `branchHasCommitsAheadOfBase` — this repo exports internals to test them
 * rather than reaching through a full `runMain`.
 */
export function decideFirstPassReviewerModel(
  ctx: PipelineCtx,
  postSha: string,
): FirstPassReviewerDecision {
  const firstPassEscalations = roleModelsFor(ctx.args).reviewer.escalations;
  if (firstPassEscalations.length === 0) return { model: undefined };
  const reviewBase = reviewBaseForCommit(
    ctx.args.repoRoot,
    ctx.args.branch,
    postSha,
  );
  const stats = reviewDiffStats(ctx.args.repoRoot, reviewBase.ref, postSha);
  const { changedLines, changedFiles } = stats;
  // The ESCALATION decision above rightly uses whichever base resolved — the
  // `tip-parent` rescue exists so the reviewer always has something to look at.
  // TELEMETRY must not. On a zero-commit issue that rescue resolves to
  // `<postSha>~1`, i.e. the PRECEDING commit on the run branch, so the measured
  // paths belong to a DIFFERENT issue. Recording them would attribute another
  // ticket's files to this one, which is the precise corruption `shipDiffBase`
  // refuses for the same reason — the two sites must agree or the bad record
  // simply survives at whichever site still writes it.
  //
  // A fail-quiet `{0, []}` is likewise "nothing was measured", not "measured
  // empty", so it too is reported as an ABSENT diff rather than a zeroed one.
  const diff =
    reviewBase.kind === "fork-point" && shouldRecordDiffMeasurement(stats)
      ? stats
      : undefined;
  if (
    shouldEscalateReviewer({
      changedLines,
      changedFiles,
      diffLineThreshold: reviewEscalateDiffLinesFromEnv(),
      sensitivePathPatterns: reviewEscalatePathsFromEnv(),
    })
  ) {
    const review1Model = firstPassEscalations[0];
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] first-pass reviewer escalated to ` +
        `${review1Model} (changedLines=${changedLines}, ` +
        `changedFiles=${changedFiles.length})`,
    );
    return { model: review1Model, diff };
  }
  // Not escalating, but the diff WAS measured — report it regardless, so an
  // issue's output is recorded whether or not it tripped the threshold.
  return { model: undefined, diff };
}

/**
 * Stable certification token the implementer writes in the commit body when
 * the project's lint passes, and the lint-gate backstop greps for. Kept in
 * sync with implement-prompt.md by a prompt-contract rot-guard test.
 */
export const LINT_CERT_TOKEN = "SANDCASTLE-LINT: pass";
const LINT_CERT_RE = /SANDCASTLE-LINT:\s*pass\b/i;

/**
 * Does a commit-message body carry the lint pass-certification the implementer
 * is required to write (`SANDCASTLE-LINT: pass`)? Case- and spacing-insensitive;
 * `pass` must be a whole word so `SANDCASTLE-LINT: n/a` (a false "no lint
 * script" claim) does NOT satisfy it.
 */
export function commitMessageHasLintCert(message: string): boolean {
  return LINT_CERT_RE.test(message);
}

/**
 * Does the project at `repoRoot` define a non-empty `lint` script in its
 * package.json? Drives the lint-gate's dormancy — a project with no lint
 * script gets a graceful no-op, same philosophy as the skill gate. The
 * loop hardcodes pnpm, so the script (whatever it shells out to) is invoked
 * as `pnpm lint` in-sandbox by the implementer/reviewer. Fail-quiet: a
 * missing or malformed package.json reads as "no lint script" so a parse
 * error can never quarantine a slice.
 */
export function hasLintScript(repoRoot: string): boolean {
  try {
    const pkg = JSON.parse(
      readFileSync(path.join(repoRoot, "package.json"), "utf8"),
    ) as { scripts?: Record<string, unknown> };
    const lint = pkg.scripts?.lint;
    return typeof lint === "string" && lint.trim().length > 0;
  } catch {
    return false;
  }
}

/**
 * Is there a real code diff between two SHAs? True only when both refs resolve
 * (non-empty) and differ. The single source of truth for "this slice changed
 * code" — shared by the lint gate (`classifyLintCert`) and the migration/journal
 * gate in `shipAfterMigrations`, so their dormancy can never drift out of sync
 * (the two used to carry hand-written De Morgan opposites of this predicate).
 */
export function hasCodeDiff(preSha: string, postSha: string): boolean {
  return preSha !== "" && postSha !== "" && preSha !== postSha;
}

/**
 * Pure classifier for the lint-gate backstop. Given the project's lint-script
 * presence, the pre/post SHAs, and the shipped commit message (`null` when the
 * message could not be read), decide the gate status. Holding every branch in
 * one pure function — instead of the `Deps.checkLintCert` closure that does the
 * I/O — makes each dormancy case directly unit-testable, including the
 * safety-critical fail-quiet branch that must never quarantine on a git hiccup.
 *   - no `lint` script                → "dormant" (project doesn't lint)
 *   - no code diff (empty/equal SHAs) → "dormant"
 *   - message unreadable (`null`)     → "dormant" (fail-quiet: an infra/git
 *       hiccup must not quarantine a slice)
 *   - cert present                    → "pass"
 *   - cert absent                     → "missing" (quarantine for human triage)
 */
export function classifyLintCert(
  hasLint: boolean,
  preSha: string,
  postSha: string,
  message: string | null,
): { status: "pass" | "missing" | "dormant" } {
  if (!hasLint) return { status: "dormant" };
  if (!hasCodeDiff(preSha, postSha)) return { status: "dormant" };
  if (message === null) return { status: "dormant" };
  return commitMessageHasLintCert(message)
    ? { status: "pass" }
    : { status: "missing" };
}

/**
 * Stable certification token the implementer writes in the commit body when
 * the project's test suite passes, and the test-gate backstop greps for. A 1:1
 * mirror of {@link LINT_CERT_TOKEN}: the host never runs tests, it only confirms
 * this cert is present on a code-bearing diff. Kept in sync with
 * implement-prompt.md by a prompt-contract rot-guard test.
 */
export const TEST_CERT_TOKEN = "SANDCASTLE-TEST: pass";
const TEST_CERT_RE = /SANDCASTLE-TEST:\s*pass\b/i;

/**
 * Does a commit-message body carry the test pass-certification the implementer
 * is required to write (`SANDCASTLE-TEST: pass`)? Case- and spacing-insensitive;
 * `pass` must be a whole word so `SANDCASTLE-TEST: n/a` (a false "no test
 * script" claim) does NOT satisfy it. Mirror of `commitMessageHasLintCert`.
 */
export function commitMessageHasTestCert(message: string): boolean {
  return TEST_CERT_RE.test(message);
}

/**
 * Does the project at `repoRoot` define a non-empty `test` script in its
 * package.json? Drives the test-gate's dormancy — a project with no test
 * script gets a graceful no-op, same philosophy as the lint gate. Fail-quiet:
 * a missing or malformed package.json reads as "no test script" so a parse
 * error can never quarantine a slice. Mirror of `hasLintScript`.
 */
export function hasTestScript(repoRoot: string): boolean {
  try {
    const pkg = JSON.parse(
      readFileSync(path.join(repoRoot, "package.json"), "utf8"),
    ) as { scripts?: Record<string, unknown> };
    // The predicate itself lives in `lib/testing/workspace-packages.ts` and is
    // shared with the per-package discovery there — see manifestHasTestScript
    // for why one definition of "has a test script" has to serve both gates.
    return manifestHasTestScript(pkg);
  } catch {
    return false;
  }
}

/**
 * Pure classifier for the test-gate backstop. Given the project's test-script
 * presence, the pre/post SHAs, and the shipped commit message (`null` when the
 * message could not be read), decide the gate status. A 1:1 mirror of
 * `classifyLintCert` — same dormancy matrix, same fail-quiet branch that must
 * never quarantine on a git hiccup.
 *   - no `test` script               → "dormant" (project has no test suite)
 *   - no code diff (empty/equal SHAs) → "dormant"
 *   - message unreadable (`null`)     → "dormant" (fail-quiet: an infra/git
 *       hiccup must not quarantine a slice, cf. classifyLintCert)
 *   - cert present                    → "pass"
 *   - cert absent                     → "missing" (quarantine for human triage)
 */
export function classifyTestCert(
  hasTest: boolean,
  preSha: string,
  postSha: string,
  message: string | null,
): { status: "pass" | "missing" | "dormant" } {
  if (!hasTest) return { status: "dormant" };
  if (!hasCodeDiff(preSha, postSha)) return { status: "dormant" };
  if (message === null) return { status: "dormant" };
  return commitMessageHasTestCert(message)
    ? { status: "pass" }
    : { status: "missing" };
}

/**
 * Resolve a ref to its commit SHA. Returns "" if the ref does not exist
 * (caller decides whether that's an error or just first-iteration setup).
 */
function resolveRefSha(repoRoot: string, ref: string): string {
  const r = runGit(repoRoot, "rev-parse", "--verify", "--quiet", ref);
  return r.ok ? r.stdout : "";
}

/**
 * The `issue-<N>` check folders a resumed ticket's SAVED WORK created (#1361):
 * touched between the run branch's fork point and the saved-work tip, and
 * absent at that fork point — so an earlier run's folder already on the run
 * branch is never one of them (#972 gap 5). Fails closed: `[]` when git cannot
 * answer, which leaves the ticket refused at ship, never unchecked.
 */
function savedWorkCheckDirs(
  repoRoot: string,
  runBranch: string,
  savedTip: string,
  issueNumber: number,
): string[] {
  const base = runGit(repoRoot, "merge-base", runBranch, savedTip);
  if (!base.ok || base.stdout.length === 0) return [];
  const diff = runGit(repoRoot, "diff", "--name-only", "-z", base.stdout, savedTip);
  if (!diff.ok) return [];
  return issueCheckDirsIn(diff.stdout.split("\0"), issueNumber).filter((dir) => {
    const atBase = runGit(repoRoot, "ls-tree", "--name-only", base.stdout, "--", dir);
    return atBase.ok && atBase.stdout.trim().length === 0;
  });
}

/**
 * Reset the staging worktree to the integration tip.
 *
 * The staging worktree (`<repoRoot>/.sandcastle/worktrees/staging`) is
 * permanently checked out on `integration-candidate` by design (see
 * `ensureStagingWorktree`), so we use `git reset --hard` inside that worktree
 * rather than `git branch -f` against the launch worktree. The latter failed
 * on iter 2+ when the launch worktree was still parked on
 * `integration-candidate` from the prior iteration's `git checkout` —
 * structurally impossible now that the launch worktree is never written to.
 *
 * - If staging's current tip was left by a failed merge (caller passes
 *   `failureTagIssue > 0`), tag the tip first as `bad-merge-issue-<N>` so
 *   evidence is preserved without leaking branches. #902: this used to be the
 *   ROUND number (one staging reset per round); the rolling pool merges one
 *   ticket at a time, so it is now that ticket's own issue number.
 * - `git -C <stagingPath> reset --hard <integrationTip>` aligns the staging
 *   worktree (and its branch ref) with integration.
 *
 * Returns the integration tip SHA on success. Throws on any failure — the
 * caller is responsible for surfacing that to the outer pipeline catch.
 */
export function resetStagingToIntegrationTip(
  repoRoot: string,
  stagingPath: string,
  integrationBranch: string,
  failureTagIssue: number | null,
  log: (s: string) => void,
  logError: (s: string) => void,
): string {
  const integrationTip = resolveRefSha(repoRoot, integrationBranch);
  if (integrationTip === "") {
    throw new Error(
      `staging-reset: cannot resolve integration branch '${integrationBranch}'`,
    );
  }
  const stagingTip = resolveRefSha(repoRoot, STAGING_BRANCH);
  if (
    stagingTip !== "" &&
    failureTagIssue !== null &&
    failureTagIssue > 0
  ) {
    const tagName = `bad-merge-issue-${failureTagIssue}`;
    const tag = runGit(repoRoot, "tag", "-f", tagName, stagingTip);
    if (tag.ok) {
      log(
        `staging-reset: tagged failed staging tip ${stagingTip.slice(0, 8)} as ${tagName}`,
      );
    } else {
      logError(`staging-reset: failed to tag bad-merge: ${tag.stderr}`);
      // Non-fatal — proceed with reset.
    }
  }
  // Hard-reset the staging worktree to the integration tip. Because the
  // staging worktree owns `integration-candidate`'s HEAD, no other worktree
  // can contend; this is structurally race-free.
  const reset = runGit(stagingPath, "reset", "--hard", integrationTip);
  if (!reset.ok) {
    throw new Error(
      `staging-reset: 'git -C ${stagingPath} reset --hard ${integrationTip}' failed: ${reset.stderr}`,
    );
  }
  log(
    `staging-reset: ${STAGING_BRANCH} → ${integrationTip.slice(0, 8)} (from ${integrationBranch})`,
  );
  return integrationTip;
}

/**
 * Ensure a dedicated worktree exists at `<repoRoot>/.sandcastle/worktrees/staging`
 * checked out on `integration-candidate`. This is the merger's exclusive
 * workspace — the launch worktree is never written to by the loop.
 *
 * Idempotent: returns the staging path if it already exists and is valid.
 * Repairs broken state by force-removing the bad worktree and re-creating.
 *
 * Throws with a recovery instruction if the launch worktree itself is on
 * `integration-candidate` (from a previously-buggy run that left HEAD parked
 * there) — fixing that requires manual `git checkout` because git refuses to
 * create a second worktree on a branch already checked out elsewhere.
 */
export async function ensureStagingWorktree(
  repoRoot: string,
  baseBranch: string,
  log: (line: string) => void,
): Promise<string> {
  const stagingPath = path.join(repoRoot, ".sandcastle/worktrees/staging");

  // 1. If the staging path already exists, see if it's still a valid worktree
  //    on integration-candidate. If yes, fast-return. If broken, repair.
  if (existsSync(stagingPath)) {
    const head = runGit(stagingPath, "rev-parse", "--abbrev-ref", "HEAD");
    if (head.ok && head.stdout === STAGING_BRANCH) {
      log(`[staging] worktree ready at ${stagingPath}`);
      return stagingPath;
    }
    log(
      `[staging] worktree at ${stagingPath} is in unexpected state ` +
        `(HEAD=${head.ok ? head.stdout : "<unresolvable>"}); force-removing and re-creating`,
    );
    const remove = runGit(
      repoRoot,
      "worktree",
      "remove",
      "--force",
      ".sandcastle/worktrees/staging",
    );
    if (!remove.ok) {
      throw new Error(
        `ensureStagingWorktree: failed to remove broken staging worktree: ${remove.stderr}`,
      );
    }
  }

  // 2. Before creating: check that integration-candidate isn't already
  //    checked out in another worktree (specifically: the launch worktree
  //    from a previously-buggy run). If it is, abort with a recovery hint.
  // Route through the canonical "who has <branch> checked out" resolver
  // (findWorktreeForBranch). A list failure yields `undefined` here, matching
  // the prior `if (list.ok)` skip; git enforces one worktree per branch, so the
  // first match is the only match.
  const staleStaging = findWorktreeForBranch(repoRoot, STAGING_BRANCH);
  if (
    staleStaging &&
    path.resolve(staleStaging.path) !== path.resolve(stagingPath)
  ) {
    throw new Error(
      `Launch worktree HEAD is on ${STAGING_BRANCH} (from a previously-buggy run). ` +
        `Run \`git checkout ${baseBranch}\` in the launch worktree and re-run the loop.`,
    );
  }

  // 3. If integration-candidate branch doesn't exist locally, create it
  //    pointing at the base branch.
  const verify = runGit(
    repoRoot,
    "rev-parse",
    "--verify",
    "--quiet",
    `refs/heads/${STAGING_BRANCH}`,
  );
  if (!verify.ok) {
    const create = runGit(repoRoot, "branch", STAGING_BRANCH, baseBranch);
    if (!create.ok) {
      throw new Error(
        `ensureStagingWorktree: failed to create ${STAGING_BRANCH} branch from ${baseBranch}: ${create.stderr}`,
      );
    }
    log(`[staging] created ${STAGING_BRANCH} branch from ${baseBranch}`);
  }

  // 4. Create the worktree. `git worktree add` creates parent dirs as needed.
  //    Ensure the parent exists for completeness (older gits may not auto-mkdir).
  mkdirSync(path.dirname(stagingPath), { recursive: true });
  const add = runGit(
    repoRoot,
    "worktree",
    "add",
    ".sandcastle/worktrees/staging",
    STAGING_BRANCH,
  );
  if (!add.ok) {
    throw new Error(
      `ensureStagingWorktree: 'git worktree add' failed: ${add.stderr}`,
    );
  }
  log(`[staging] worktree ready at ${stagingPath}`);
  return stagingPath;
}

interface WorktreeEntry {
  path: string;
  branch: string | null;
}

/**
 * Parse `git worktree list --porcelain` output. Blocks are separated by
 * blank lines; each block has `worktree <path>` and (for attached HEADs)
 * `branch refs/heads/<name>`. Detached HEADs omit the branch line.
 */
export function parseWorktreeList(stdout: string): WorktreeEntry[] {
  const entries: WorktreeEntry[] = [];
  for (const block of stdout.split(/\n\s*\n/)) {
    let wtPath = "";
    let branch: string | null = null;
    for (const line of block.split("\n")) {
      if (line.startsWith("worktree "))
        wtPath = line.slice("worktree ".length).trim();
      else if (line.startsWith("branch "))
        branch = line.slice("branch ".length).trim();
    }
    if (wtPath !== "") entries.push({ path: wtPath, branch });
  }
  return entries;
}

/**
 * Find the linked worktree that has `branch` checked out (attached HEAD ==
 * `refs/heads/<branch>`), or `undefined` if none does — the single source of
 * truth for the `parseWorktreeList(...).find(w => w.branch === "refs/heads/X")`
 * pattern that was duplicated across the loop (staging preflight, worktree-
 * health cleanup, fast-forward promote) and is now also the launch-worktree
 * resolver for the cross-host lane-sync hook (Task B). Lists via the
 * injectable `git` runner (defaults to {@link runGit}); returns `undefined`
 * (never throws) on a list failure so callers that resolve a worktree path can
 * fall back gracefully. Callers that must DISTINGUISH a list failure from a
 * genuine not-found keep their own explicit `ok`-check.
 */
export function findWorktreeForBranch(
  repoRoot: string,
  branch: string,
  git: (repoRoot: string, ...args: string[]) => GitRunResult = runGit,
): WorktreeEntry | undefined {
  const listed = git(repoRoot, "worktree", "list", "--porcelain");
  if (!listed.ok) return undefined;
  return parseWorktreeList(listed.stdout).find(
    (w) => w.branch === `refs/heads/${branch}`,
  );
}

// ---------------------------------------------------------------------------
// Worktree-health: boot prune + lazy createSandbox repair (audit issue #1)
// ---------------------------------------------------------------------------
//
// A single corrupt git worktree — e.g. a leftover `00000000` directory whose
// `.git` link is gone, producing `git worktree list -> couldn't read
// .git/packed-refs` — used to kill the WHOLE loop. The fatal `git worktree
// list --porcelain` runs INSIDE the vendored SDK (`WorktreeManager.create ->
// listWorktrees`) which throws with no catch, so the very first `createSandbox`
// blows up the run. We can't patch the vendored SDK.
//
// SAFEST-REBUILD shape (this rework). The earlier fix was destructive and
// didn't actually repair:
//
//   Defect A (DATA-LOSS): it selected ANY non-root worktree whose dir
//   momentarily failed an `existsSync` check and then ran
//   `git worktree remove --force` + recursive `rmSync` on it. On this host
//   MULTIPLE loops share one workspace, so a sibling loop's LIVE worktree that
//   briefly fails `existsSync` (mid-op, EACCES, TOCTOU) got force-deleted —
//   destroying real work.
//
//   Defect B (DOESN'T REPAIR): when `git worktree list` returned `!ok` (the
//   real corruption symptom) it ran `git worktree prune` (which fails the SAME
//   way on packed-refs corruption) and returned having repaired nothing; and
//   the `existsSync` detector structurally can't see a dir-present-but-
//   internally-corrupt worktree. So the loop still died on SDK re-enumeration.
//
// The rebuild:
//   1. NO manual deletion. `git worktree prune` only clears administrative
//      registrations for worktrees whose working tree is gone, so it is the
//      safest tool here.
//      CORRECTED 2026-09-11 (issue #1260). This line used to read "NEVER
//      removes a live/healthy worktree". That is FALSE as a safety guarantee,
//      because a LIVE worktree is not continuously healthy. Measured on git
//      2.39.5: move a live worktree's directory aside and `git worktree prune`
//      reaps it on the spot ("gitdir file points to non-existent location").
//      The vendored SDK's own `rm -rf` sweep is what empties a live directory
//      between two heartbeats, and that is how a cleanup for a LANDED ticket
//      destroyed live issue #1260's registration mid-run. What makes every
//      prune below safe now is `git worktree lock`, not prune's own
//      restraint — see lib/paths/worktree-lock.ts.
//   2. A cheap, harmless boot `git worktree prune` to clear dangling regs.
//   3. The FIRST sandbox create is wrapped so that on a worktree-enumeration
//      failure we prune ONCE and retry ONCE; if it STILL fails we exit with a
//      clear, actionable error. NEVER delete, NEVER loop.

/**
 * Cheap, NON-DESTRUCTIVE boot pass: a single best-effort `git worktree prune`
 * to clear dangling administrative registrations (worktrees whose working tree
 * is gone). Runs ONCE, early in the boot sequence (after preflight, before
 * staging + the first sandbox).
 *
 * This cannot destroy a sibling loop's work, but NOT because prune is
 * inherently safe — a live worktree whose directory is momentarily gone IS
 * reaped (issue #1260; see the correction above and
 * lib/paths/worktree-lock.ts). It is safe because every in-flight ticket's
 * worktree is `git worktree lock`ed, which prune obeys. The destructive
 * `remove --force` + `rmSync` path that once did exactly that has been
 * removed entirely.
 *
 * KNOWN COST of that lock, here specifically: this boot prune can no longer
 * clear a DANGLING registration that a killed run left locked. Nothing wedges
 * — the next create for that branch releases its own lock in the pre-clean
 * before removing it — but the boot pass no longer tidies it in advance.
 *
 * NEVER throws — a failure (including the corrupt-packed-refs case, where prune
 * itself fails) logs a warning and the loop continues. The actual repair for
 * that case happens lazily in {@link createSandboxWithWorktreeRepair}.
 */
export function pruneCorruptWorktrees(
  repoRoot: string,
  log: (line: string) => void,
  deps: { git?: (repoRoot: string, ...gitArgs: string[]) => GitRunResult } = {},
): void {
  const git = deps.git ?? runGit;
  try {
    const pruned = git(repoRoot, "worktree", "prune");
    if (!pruned.ok) {
      log(
        `[worktree-health] boot 'git worktree prune' failed (continuing): ` +
          `${pruned.stderr || "unknown"}`,
      );
    }
  } catch (err) {
    // Absolute backstop: this pass must NEVER kill the loop.
    log(
      `[worktree-health] boot prune errored (continuing): ` +
        `${(err as Error).message}`,
    );
  }
}

/**
 * Wrap the FIRST sandbox create with a one-shot, NON-DESTRUCTIVE repair.
 *
 * The vendored SDK enumerates worktrees inside `createSandbox`
 * (`WorktreeManager.create -> listWorktrees`); a corrupt registration makes
 * that throw and there's no SDK catch. So we try the create once, and on
 * failure run `git worktree prune` ONCE (the only safe repair — it never
 * removes a live worktree) and retry the create ONCE. If it STILL fails, we
 * surface a clear, actionable error rather than dying silently or looping.
 *
 * NEVER deletes a worktree and NEVER loops. Provider-agnostic: it takes the
 * provider's own `createSandbox` as `create`, so it works identically across
 * docker / mac-host / codex. Injectable `git` keeps it unit-testable without a
 * real corrupt repo.
 */
export async function createSandboxWithWorktreeRepair(
  create: () => Promise<SandboxHandle>,
  git: (repoRoot: string, ...gitArgs: string[]) => GitRunResult,
  repoRoot: string,
  log: (line: string) => void,
): Promise<SandboxHandle> {
  try {
    return await create();
  } catch (firstErr) {
    // Does the original failure actually look like the worktree-enumeration
    // corruption this repair targets (the SDK's `git worktree list` /
    // packed-refs throw)? If not — a transient provider error, disk-full,
    // EACCES from the pre-clean, etc. — the prune+retry is incidental and we
    // must NOT relabel the failure as worktree corruption (it would send the
    // operator chasing a git problem that isn't there). We still prune+retry
    // once (cheap, harmless, and a transient error may clear), but on a second
    // failure we surface the REAL error untouched unless it's worktree-shaped.
    const looksLikeWorktreeCorruption = (msg: string): boolean =>
      /worktree|packed-refs|\.git\b/i.test(msg);
    const firstWasWorktree = looksLikeWorktreeCorruption(
      (firstErr as Error).message,
    );
    log(
      `[worktree-health] first sandbox create failed (${(firstErr as Error).message}); ` +
        `attempting 'git worktree prune' once, then one retry`,
    );
    // The only safe repair: prune dangling registrations. Best-effort — if it
    // fails (corrupt packed-refs fails prune the same way), we still try the
    // retry once, then surface a clear error below.
    try {
      const pruned = git(repoRoot, "worktree", "prune");
      if (!pruned.ok) {
        log(
          `[worktree-health] 'git worktree prune' failed: ${pruned.stderr || "unknown"}`,
        );
      }
    } catch (pruneErr) {
      log(
        `[worktree-health] 'git worktree prune' threw: ${(pruneErr as Error).message}`,
      );
    }

    try {
      return await create();
    } catch (secondErr) {
      // Only claim worktree corruption when the failure is actually
      // worktree-shaped (either the original or the post-prune failure). For an
      // unrelated cause, rethrow the real error unchanged so its message, type,
      // and stack survive — no misleading "run git worktree prune" advice.
      if (
        firstWasWorktree ||
        looksLikeWorktreeCorruption((secondErr as Error).message)
      ) {
        throw new Error(
          `sandcastle: corrupt git worktree state the loop can't auto-repair — ` +
            `run 'git worktree prune' / manual cleanup, then restart: ` +
            `${(secondErr as Error).message}`,
        );
      }
      throw secondErr;
    }
  }
}

/**
 * Fast-forward `integrationBranch` to the staging tip.
 *
 * If a worktree has `integrationBranch` checked out (typical case — the
 * launch worktree usually does), we `git merge --ff-only` inside that
 * worktree so HEAD + index + working tree all advance together. Using a
 * bare `git update-ref` here would silently strand the working tree on
 * the old snapshot — see commit history for the disk-drift incident.
 *
 * If the branch is not checked out anywhere, REFUSE (return false) rather than
 * `update-ref` the bare ref — advancing a ref no working tree tracks is the
 * silent-stranding behaviour above, and the branch-base preflight gate keeps
 * the launch worktree ON the run branch so this path is only reachable once the
 * branch is already stranded (scheduler incident, 2026-07-02).
 *
 * Divergence fallback (audit 2026-05-30, Issue 7): when an operator
 * commits to `integrationBranch` mid-iteration, staging is no longer an
 * ancestor of integration and `--ff-only` refuses. Rather than dump the
 * recovery on a human, attempt `git merge --no-ff` on the live worktree
 * with a deterministic commit message. Real conflicts still refuse
 * (they're author work). No-worktree divergence still refuses (the
 * orchestrator's launch worktree always has integrationBranch checked
 * out in practice; auto-merging into a bare ref adds complexity for a
 * case that doesn't occur).
 *
 * Returns true on success.
 */
export function fastForwardIntegration(
  repoRoot: string,
  integrationBranch: string,
  log: (s: string) => void,
  logError: (s: string) => void,
): boolean {
  const stagingTip = resolveRefSha(repoRoot, STAGING_BRANCH);
  if (stagingTip === "") {
    logError(`fast-forward: cannot resolve ${STAGING_BRANCH}`);
    return false;
  }
  const integrationTip = resolveRefSha(repoRoot, integrationBranch);
  if (integrationTip === "") {
    logError(
      `fast-forward: cannot resolve integration branch '${integrationBranch}'`,
    );
    return false;
  }
  // Explicit list-ok guard first: THIS site must distinguish a worktree-list
  // FAILURE (abort the promote) from a genuine not-found (proceed), which
  // findWorktreeForBranch collapses to `undefined`. Once the list is known-ok,
  // resolve the match through the canonical helper.
  const listed = runGit(repoRoot, "worktree", "list", "--porcelain");
  if (!listed.ok) {
    logError(`fast-forward: worktree list failed: ${listed.stderr}`);
    return false;
  }
  const liveWorktree = findWorktreeForBranch(repoRoot, integrationBranch);
  // Guard: both the fast-forward and the divergence `--no-ff` below run
  // `git merge` INSIDE the launch worktree. git refuses either merge if that
  // worktree has uncommitted changes the merge would touch ("Your local
  // changes to the following files would be overwritten by merge") — and
  // nothing here cleans it, so a single stray file silently strands EVERY
  // promotion, iteration after iteration, with only a cryptic git error in the
  // log. Convert the recurring silent strand into one actionable, file-named
  // failure. Do NOT auto-clean: the file may be a human's uncommitted work, and
  // `reset --hard` here would destroy it.
  //
  // THE LOOP DOES WRITE THE LAUNCH WORKTREE, at exactly one path:
  // `commitReworkRecords` appends the rework-telemetry JSONL here and commits it
  // in the same breath. That commit is best-effort and CAN fail persistently (an
  // ignore rule reintroduced by `/sandcastle-update` makes `git add` fail
  // forever, and no amount of retrying clears that), so this guard must never be
  // allowed to refuse on it: refusing would strand EVERY remaining promotion of
  // the run on `${STAGING_BRANCH}` while `finishRun` still opens a run PR saying
  // `Closes #N` for code that PR does not contain — a whole night's work lost to
  // one bookkeeping line. So that path is filtered out of the decision below.
  //
  // It is still LOGGED, and that log matters: the incoming merge does touch the
  // JSONL, so git may yet refuse it with its own cryptic "your local changes
  // would be overwritten" — and this line is what makes that diagnosable. When
  // the store is the only entry named, the cause is upstream, in the `rework
  // telemetry: git …` line earlier in the log, not out-of-band human editing.
  if (liveWorktree) {
    // `-uall` (list untracked FILES, not their directory) is load-bearing, not
    // tidiness: `.sandcastle/telemetry/` holds nothing but the store and is not
    // tracked yet, so plain porcelain collapses the whole thing to one
    // `?? .sandcastle/telemetry/` entry that matches no path — and the filter
    // below would then refuse on the loop's own file after all.
    const dirty = runGit(liveWorktree.path, "status", "--porcelain", "-uall");
    if (dirty.ok && dirty.stdout.trim() !== "") {
      // Porcelain lines are `XY <path>`, but runGit() has already trimmed the
      // whole blob — stripping the leading status-column space on the first
      // line — so a fixed slice would mangle it. Strip the 1–2 char status code
      // (plus any leading space) off each line instead.
      const paths = dirty.stdout
        .split("\n")
        .map((l) => l.replace(/^[ MADRCU?!]{1,2}\s+/, "").trim())
        .filter((f) => f !== "");
      const blocking = paths.filter((p) => p !== REWORK_STORE_POSIX_PATH);
      if (blocking.length === 0) {
        logError(
          `fast-forward: launch worktree ${liveWorktree.path} still has an ` +
            `uncommitted ${REWORK_STORE_POSIX_PATH} — the loop's own telemetry ` +
            `commit did not land (see the earlier \`rework telemetry: git …\` ` +
            `line for the cause). PROCEEDING with the promotion anyway, because ` +
            `refusing on the loop's own bookkeeping would strand every ` +
            `remaining promotion of this run; if git then refuses the merge, ` +
            `this is why.`,
        );
      } else {
        logError(
          `fast-forward: launch worktree ${liveWorktree.path} has uncommitted ` +
            `changes (${namesForLog(blocking)}) — the merge into ` +
            `${integrationBranch} would be refused or would overwrite them, so ` +
            `certified work stays stranded on ${STAGING_BRANCH}. Commit, stash, ` +
            `or discard these in the launch checkout, then re-run. (The only ` +
            `path the loop itself writes here is ${REWORK_STORE_POSIX_PATH}, ` +
            `which is excluded from this list — so these were introduced ` +
            `outside the loop.)`,
        );
        return false;
      }
    }
  }
  const ancestor = runGit(
    repoRoot,
    "merge-base",
    "--is-ancestor",
    integrationTip,
    stagingTip,
  );
  if (!ancestor.ok) {
    // Divergence — try auto --no-ff merge on the live worktree.
    if (!liveWorktree) {
      logError(
        `fast-forward refused: ${integrationBranch} (${integrationTip.slice(0, 8)}) ` +
          `is not an ancestor of ${STAGING_BRANCH} (${stagingTip.slice(0, 8)}); ` +
          `no live worktree on ${integrationBranch} — auto --no-ff not possible; ` +
          `human triage required`,
      );
      return false;
    }
    const mergeMsg = `Sandcastle: merge ${STAGING_BRANCH} into ${integrationBranch} [auto-no-ff]`;
    const noFf = runGit(
      liveWorktree.path,
      "merge",
      "--no-ff",
      "-m",
      mergeMsg,
      stagingTip,
    );
    if (!noFf.ok) {
      // Leave no half-applied merge state — next iteration's repair logic
      // assumes the launch worktree is on a clean integrationBranch. If
      // the abort itself fails (lock contention, NFS, simultaneous git),
      // surface it loudly — the next iteration's --ff-only will refuse
      // with "you have unmerged paths" and a quiet abort failure here
      // hides the real cause.
      const abort = runGit(liveWorktree.path, "merge", "--abort");
      if (!abort.ok) {
        logError(
          `fast-forward: merge --abort in ${liveWorktree.path} failed: ` +
            `${abort.stderr.trim()}; worktree may be in a partial-merge state ` +
            `— next iteration's FF will refuse with "unmerged paths"`,
        );
      }
      logError(
        `fast-forward refused: ${integrationBranch} (${integrationTip.slice(0, 8)}) ` +
          `is not an ancestor of ${STAGING_BRANCH} (${stagingTip.slice(0, 8)}); ` +
          `auto --no-ff also failed: ${noFf.stderr.trim()}; human triage required`,
      );
      return false;
    }
    log(
      `auto --no-ff merge (via worktree in ${liveWorktree.path}): ` +
        `${STAGING_BRANCH} ${stagingTip.slice(0, 8)} → ${integrationBranch} ` +
        `(divergence resolved)`,
    );
    return true;
  }
  if (liveWorktree) {
    const ff = runGit(liveWorktree.path, "merge", "--ff-only", stagingTip);
    if (!ff.ok) {
      logError(
        `fast-forward: merge --ff-only in ${liveWorktree.path} failed: ${ff.stderr}`,
      );
      return false;
    }
    log(
      `fast-forward (via worktree merge in ${liveWorktree.path}): ` +
        `${integrationBranch} ${integrationTip.slice(0, 8)} → ${stagingTip.slice(0, 8)}`,
    );
    return true;
  }
  // No worktree has `integrationBranch` checked out. A bare `git update-ref`
  // here would advance the ref while NO working tree tracks it — the exact
  // silent-stranding the disk-drift comment above warns about, and the
  // mechanism behind the 2026-07-02 branch-base incident (the launch checkout,
  // parked on a stale base, kept cutting worker worktrees off the old commit
  // while the run branch's ref crept forward underneath it). In normal
  // operation the branch-base preflight gate keeps the launch worktree ON the
  // run branch, so this path is only reachable once the run branch is already
  // stranded. Refuse loudly rather than deepen the corruption.
  logError(
    `fast-forward refused: no live worktree has '${integrationBranch}' checked ` +
      `out, so advancing it would strand the ref off every working tree (the ` +
      `branch-base trap). The launch checkout must stay on '${integrationBranch}' ` +
      `for the loop to layer correctly — run \`git -C ${repoRoot} checkout ` +
      `${integrationBranch}\` and re-run. Skipping promotion this iteration.`,
  );
  return false;
}

// ---------------------------------------------------------------------------
// Default deps (production wiring)
// ---------------------------------------------------------------------------

/**
 * Outer wall-clock watchdog around an SDK call. The SDK's own idle timer
 * resets on every output line, so an agent stuck in a trickle-output loop
 * (observed on a real monorepo: tsc retries after a host-level OOM kills
 * the tsc child silently — the loop driver only sees the agent emit small
 * reasoning tokens forever) can hang for hours. This ceiling fires
 * regardless of output activity.
 *
 * WHAT THE ABORT DOES AND DOES NOT DO. The SDK accepts `signal:
 * AbortSignal`, and `@ai-hero/sandcastle` documents it as "aborting
 * mid-iteration kills the in-flight agent subprocess"
 * (`dist/index.d.ts:971`). THAT IS FALSE for the docker sandbox. The SDK
 * only RACES the abort against the run
 * (`dist/index.js:316-323`, `Effect.raceFirst`), while the agent itself
 * runs as a bare `spawn("docker", ["exec", …])` with no signal wiring at
 * all (`dist/chunk-CP3TYXZA.js:214-265`). Aborting therefore abandons a
 * still-live promise: this function's rejection unblocks the ORCHESTRATOR
 * and nothing else. On 2026-08-07 the issue-#803 implementer kept working
 * inside its container for another 2h28m after its ceiling fired, still
 * writing into the log the loop was reading. Actually killing it is
 * `terminateSandboxProcessesOnAbort` in `lib/sandbox-provider.ts`, wired
 * to the very signal this function raises.
 *
 * Exported for unit testing. Production wiring is in {@link buildDefaultDeps}
 * which captures `args.hardCeilingSec` into a closure that calls this.
 */
export function withHardCeiling<T>(
  ceilingMs: number,
  label: string,
  invoke: (signal: AbortSignal) => Promise<T>,
): Promise<T> {
  const controller = new AbortController();
  const timer = setTimeout(() => {
    controller.abort(
      new Error(
        // Deliberately does NOT say "the SDK idle timer never fired". It
        // usually has not FAILED — it bounds GAPS BETWEEN output lines, so a
        // trickle-output hang or a genuinely long role never trips it, and
        // reading the old wording as a defect sent the 2026-08-07 #803
        // post-mortem hunting an SDK timer bug that did not exist. Keep the
        // literal "hard ceiling" prefix: STALL_RE matches on it.
        `hard ceiling: ${label} exceeded ${(ceilingMs / 1000).toFixed(0)}s wall-clock — aborting and killing the sandboxed agent. The SDK idle timer bounds gaps BETWEEN output lines, so it cannot catch a trickle-output or OOM-of-child hang.`,
      ),
    );
  }, ceilingMs);
  return invoke(controller.signal).finally(() => clearTimeout(timer));
}

// ---------------------------------------------------------------------------
// Sandbox provider construction lives in `./lib/sandbox-provider.ts` — both
// docker and mac-host implement the same uniform `SandboxProvider` shape,
// so `buildDefaultDeps` below picks one and calls `provider.topLevelRun` /
// `provider.createSandbox` without branching on the provider kind.
// ---------------------------------------------------------------------------

/**
 * Resolve the loop's run-log path and return a best-effort line appender.
 *
 * The loop's stdout/stderr is otherwise ephemeral, so after a hard death there
 * is no on-disk record of why it died — the post-mortem gap from the
 * a session audit. This writes every log line to a known path:
 * `<repoRoot>/.sandcastle/run.log` by default (already gitignored), or the
 * `--log-file` override, so the last run is always inspectable.
 *
 * ## Two files, and why (issue #1096)
 *
 * `run.log` is truncated once when the appender is created — one fresh log per
 * run, and every existing reader and doc reaches for that exact path. But a
 * truncated-per-run file means only the NEWEST run survives, and a refusal's
 * reasoning belongs to the run that refused, not the run someone reads it back
 * on: a refused ticket is closed on a LATER night, by which point the run that
 * refused it has been overwritten. That is why ten of the loop's thirteen
 * refusals cannot be attributed to any cause today — the evidence was gone.
 *
 * So alongside `run.log` this ALSO appends every line to a per-run archive
 * under `<repoRoot>/.sandcastle/logs/runs/<startedIso>-<runId>.log`, keyed by
 * the moment the appender was created and the run id, so no later run can
 * overwrite it (both paths are under the gitignored `.sandcastle/logs/`, so the
 * archive never reaches a commit). `/sandcastle-clean` already reaps
 * `.sandcastle/logs/**` older than seven days, so this needs no new rotation.
 *
 * Each line is flushed with `appendFileSync` (no buffering) so a hard death
 * loses nothing. Every write is best-effort per file: a non-writable path
 * silently drops THAT file and never throws, mirroring the status-store's
 * non-fatal philosophy — a log-write failure must never take the loop down.
 *
 * Exported for unit testing.
 */
export function createRunLogAppender(opts: {
  logFile?: string;
  repoRoot: string;
  /** The run id, for naming the per-run archive. Falls back to `"run"`. */
  runId?: string;
  /** Test seam for the archive filename's timestamp. */
  now?: () => Date;
}): (line: string) => void {
  const latest =
    opts.logFile ?? path.join(opts.repoRoot, ".sandcastle", "run.log");
  const startedIso = (opts.now?.() ?? new Date()).toISOString();
  // `:` and `.` are illegal (Windows) or awkward (shell) in filenames; the run
  // id is sanitized the same way so a slash in a host-suffixed run id cannot
  // escape the runs directory.
  const stamp = startedIso.replace(/[:.]/g, "-");
  const runSlug = (opts.runId ?? "run").replace(/[^A-Za-z0-9._-]+/g, "-");
  const archive = path.join(
    opts.repoRoot,
    ".sandcastle",
    "logs",
    "runs",
    `${stamp}-${runSlug}.log`,
  );

  // Each target is set up independently: run.log truncated (latest-run
  // pointer), the archive created fresh (a fresh per-run file, never an
  // overwrite of a prior run's). A failure on one must not disable the other.
  const targets: string[] = [];
  for (const target of [latest, archive]) {
    try {
      mkdirSync(path.dirname(target), { recursive: true });
      writeFileSync(target, "");
      targets.push(target);
    } catch {
      // non-writable path → that file is silently skipped
    }
  }

  return (line: string): void => {
    for (const target of targets) {
      try {
        appendFileSync(target, line);
      } catch {
        // best-effort; a log-write failure must never break the loop
      }
    }
  };
}

/**
 * Build the production {@link Deps} bag — wires sandcastle.run /
 * sandcastle.createSandbox / src/state/gh.ts wrappers / src/migrations/.
 *
 * `dryRun` short-circuits claim / quarantine / markDone / comment to log-only
 * operations so a misconfigured first run can't move labels.
 */
/**
 * Assembles the env fragment written into every sandbox container (docker and
 * mac-host alike — both paths route through this one function). Extracted
 * out of `buildDefaultDeps` during the #1190 review (the builder
 * command-cap fix) so the wiring between each *Env() helper and the
 * container is itself unit-testable: a spread deleted here fails a test
 * instead of only showing up as a mysteriously-uncapped builder run weeks
 * later.
 *
 * Order matters — see the inline comments at each spread for why.
 */
export function buildContainerEnv(
  projectEnv: Record<string, string>,
  gitEnv: Record<string, string>,
  env: NodeJS.ProcessEnv = process.env,
): Record<string, string> {
  // No GitHub credential ever enters a ticket's sandbox (spec #1334, SB): not
  // the host's GH_TOKEN (nothing forwards it any more) and not one that a
  // target repo's .env happens to carry, which would otherwise cross both as
  // an env var and inside the literal .env written at boot.
  const projectEnvNoGithub = withoutGithubCredentials(projectEnv);
  return {
    ...projectEnvNoGithub,
    ...gitEnv,
    // Serialize the project's .env contents so the onSandboxReady hook can
    // write a literal .env file inside the container at boot. Doing it via
    // an env var (instead of a shell heredoc inside the hook command) keeps
    // secrets out of the command string we log. See `writeProjectDotenv`.
    SANDCASTLE_PROJECT_DOTENV: serializeDotenv(projectEnvNoGithub),
    // Sane output-token cap so a large response surfaces as a recognizable,
    // bounded-retryable cap error (isOutputCapError) instead of overflowing
    // the CLI's built-in ceiling. Preserves an operator-set value from
    // EITHER source (shell env wins over project .env); only falls back to the 32000 default when neither sets it.
    // projectEnv must be passed explicitly — process.env alone would miss a
    // value set only in the target repo's .env (audit #2 rework).
    ...maxOutputTokensEnv(env, projectEnv),
    // The command tool's own cap, raised to the prompt's own `timeout 900`
    // (#1190, the builder command-cap fix).
    ...bashTimeoutEnv(env, projectEnv),
    // Subscription auth into the container: forward CLAUDE_CODE_OAUTH_TOKEN
    // when set (no-op otherwise). Required on macOS where the token lives in
    // the Keychain, not a mountable file. See oauthTokenEnv.
    ...oauthTokenEnv(env),
    // The pool's address and key, after projectEnv so a host-level value wins
    // over one leaked in through the target repo's .env. See poolEnv.
    ...poolEnv(env),
  };
}

export function buildDefaultDeps(args: SandcastleArgs): Deps {
  // pnpm install (not npm) — monorepos commonly use
  // pnpm's workspace:* protocol which npm refuses to parse. The Dockerfile
  // ships `corepack enable` so `pnpm` works without an extra global install.
  // CI=true is required: without it, pnpm refuses to repair the modules
  // dir on a fresh sandbox (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY)
  // because there's no TTY to confirm. The hook runs non-interactively
  // by definition, so the install hangs/exits without restoring the
  // per-package workspace symlinks (apps/nextjs/node_modules etc.).
  // The first hook writes a `.env` file from $SANDCASTLE_PROJECT_DOTENV
  // (populated below from the host's project .env files) BEFORE pnpm
  // install runs. Why: many target repos invoke `dotenv-cli -e ../../.env`
  // to launch their dev server (e.g. apps/nextjs/package.json's `with-env`
  // script). dotenv-cli errors out on a missing file and the dev server
  // never starts → playwright bounces the iteration even when the agent's
  // code is correct. Materializing the file from env vars keeps secrets
  // out of the shell command string itself (the JS reads from the env
  // var, which docker populates over a separate channel).
  //
  // We use `node -e` instead of `printf %s > .env && chmod 600 .env` for
  // two reasons:
  //   (a) atomic 0o600 at creation — `fs.writeFileSync` with `mode: 0o600`
  //       hands the kernel the mode in the open(2) call, so there's no
  //       window where the file exists with a permissive default mode
  //       between create and chmod. The old shell pattern had a race.
  //   (b) backup-on-existing — if a project ships its own `.env` (or a
  //       previous iteration left one behind), rename it to
  //       `.env.sandcastle-bak.<ISO-timestamp>` before writing fresh so
  //       we never silently clobber operator-authored content.
  const writeProjectDotenv = {
    command: WRITE_PROJECT_DOTENV_COMMAND,
  };
  // Best-effort context7 MCP registration (fails closed without the key —
  // see REGISTER_CONTEXT7_MCP_COMMAND). Ordered before `pnpm install` because
  // it depends only on the baked-in `claude` CLI and the forwarded env var,
  // not on the project's node_modules, so it can run as soon as the box is up.
  const registerContext7Mcp = {
    command: REGISTER_CONTEXT7_MCP_COMMAND,
  };
  // Docker `onSandboxReady` hooks. mac-host never reaches sandcastle.createSandbox
  // so it carries no analogous concept; if mac-host ever grows hook support
  // it'll live in MacHostProviderConfig, not as a shared variable.
  // Codex reads AGENTS.md from the agent's cwd (the worktree root), but ours
  // ships at .sandcastle/AGENTS.md. The staging command (no-clobber, git-excluded,
  // fail-closed) is STAGE_CODEX_AGENTS_MD_COMMAND; the mac-host mirror is
  // stageCodexAgentsMdIntoWorktree. Claude/Kimi/GLM runs skip this entirely.
  // `isCodexRun` gates on the spawn model (matching the agent factory / mac-host
  // router); escalations/role defaults gate on `args.backend`. The parse-time
  // reconcile guarantees the two agree.
  const isCodexRun = backendForModel(args.implementerModel) === "codex";
  const stageCodexAgentsMd = { command: STAGE_CODEX_AGENTS_MD_COMMAND };
  const dockerHooks = {
    sandbox: {
      onSandboxReady: [
        writeProjectDotenv,
        registerContext7Mcp,
        // The in-sandbox install, POSIX-`timeout`-wrapped so a hang self-kills
        // (2026-08-31 freeze: an unbounded install here froze the loop for 6.5h,
        // because the SDK runs every onSandboxReady hook as a bare `docker exec`
        // with no timeout). Flags + bound rationale live on SANDBOX_INSTALL_COMMAND
        // / SANDBOX_INSTALL_TIMEOUT_MS.
        { command: SANDBOX_INSTALL_COMMAND },
        ...(isCodexRun ? [stageCodexAgentsMd] : []),
      ],
    },
  } as const;
  const copyToWorktree = buildCopyToWorktree(args.repoRoot);

  // The agent's fixed "Claude" git identity. The container's safe.directory
  // will be set up by sandcastle itself; user.name/user.email come through as
  // env vars instead of via a mount.
  //
  // Also read the target project's .env.local so the dev-server / playwright
  // can find POSTGRES_URL / SUPABASE creds / etc. inside the sandbox.
  // gitEnv keys win on collision (don't let a stray .env.local override
  // the orchestrator's git identity).
  const gitEnv = buildGitEnv();
  // The DB URL is the one key we do NOT take from the project's dotenv files:
  // that is the production Supabase URL, and the repo's test guard refuses it.
  // See sandboxTestDbEnv. Applied to `projectEnv` itself (not just the docker
  // env below) so the container's written `.env` is overridden too.
  const projectEnv = {
    ...readProjectEnv(args.repoRoot),
    ...sandboxTestDbEnv(args.sandbox, process.env),
  };
  const containerEnv: Record<string, string> = buildContainerEnv(
    projectEnv,
    gitEnv,
  );

  // Pick sandbox provider once. Both docker and mac-host implement the same
  // `SandboxProvider` shape so the methods below call provider.topLevelRun /
  // provider.createSandbox uniformly. Docker-only construction config (hooks,
  // copyToWorktree, completionSignal, copyToWorktreeMs) is baked into the
  // adapter and ignored on the mac-host path.
  const provider: SandboxProvider = buildSandboxProvider(
    { ...args, crossHostSync: crossHostSyncEnabled() },
    containerEnv,
    {
      hooks: dockerHooks,
      copyToWorktree,
      copyToWorktreeMs: 600_000,
      completionSignal: [...SANDBOX_COMPLETION_SIGNALS],
    },
  );

  const dryLog = (action: string, ...rest: unknown[]): void => {
    process.stderr.write(
      `[dry-run] ${action} ${rest.map((r) => JSON.stringify(r)).join(" ")}\n`,
    );
  };

  // Sandcastle's default completion signal is `<promise>COMPLETE</promise>`.
  // We also accept `<promise>HALT</promise>` so the implementer's blocked-
  // story signal terminates cleanly — see provider config above. (Without
  // this, a HALT on iteration 1 would loop until the model token budget
  // exhausted; bit issue #83 on the 2026-05-08 smoke.) `SANDBOX_COMPLETION_
  // SIGNALS` is the SDK completion signal for EVERY docker-sandboxed role
  // (reviewer, judge, check-writer, and any other agent this provider config
  // dispatches), not only the implementer — the builder's own in-repo batch
  // loop in `runImplementer` (`lib/builder-progress.ts`'s
  // `runBuilderIterations`) separately reads the same list to stop A BUILDER
  // pass, so the docker provider and the host-side batch loop cannot drift
  // apart.

  const ceilingMs = args.hardCeilingSec * 1000;
  const withCeiling = <T,>(
    label: string,
    invoke: (signal: AbortSignal) => Promise<T>,
    capMs?: number,
  ): Promise<T> =>
    withHardCeiling(
      capMs === undefined ? ceilingMs : Math.min(ceilingMs, capMs),
      label,
      invoke,
    );

  // Tee every log line to a known on-disk run log (default
  // .sandcastle/run.log, gitignored) so a hard death is diagnosable
  // post-mortem — the loop's stderr is otherwise ephemeral.
  const appendRunLog = createRunLogAppender({
    logFile: args.logFile,
    repoRoot: args.repoRoot,
    runId: args.runId,
  });

  // One-shot guard for the worktree-health lazy repair (audit issue #1). The
  // vendored SDK enumerates worktrees inside the FIRST createSandbox; a corrupt
  // registration makes that throw uncaught. Only the first create needs the
  // prune-once-and-retry-once repair — once the loop is running the per-branch
  // pre-clean below keeps each subsequent box clean.
  let firstSandboxRepairDone = false;

  const log = (line: string): void => {
    process.stderr.write(`${line}\n`);
    appendRunLog(`${line}\n`);
  };
  const logErr = (line: string): void => {
    process.stderr.write(`ERROR: ${line}\n`);
    appendRunLog(`ERROR: ${line}\n`);
  };

  // ONE alarm per RUN for a recorded screen check that could not grade at
  // all — see `createScreenCheckAlarmGate`. Created here, in `buildDefaultDeps`,
  // so its scope is exactly one run: a fresh run always gets a fresh alarm,
  // and a night that breaks does not silence the next one.
  const screenCheckWatchAlarmGate = createScreenCheckAlarmGate();

  // Issue #908, Piece B, fixed under issue #915: reclaim any per-job clone
  // databases orphaned by a PREVIOUS orchestrator process that crashed
  // before its own sandbox's close() could drop its own database — see
  // `sweepOrphanedJobDatabases`. Runs once, awaited by EVERY concurrent
  // `createSandbox` caller, before any of them creates its own job
  // database.
  //
  // `createOnceGate` (not a plain boolean) is load-bearing: the old
  // `firstJobDbSweepDone = true` was set SYNCHRONOUSLY before the sweep's
  // own `await`, which stopped the sweep from running TWICE but did nothing
  // to stop a second, CONCURRENT `createSandbox` call from racing past the
  // guard while the first sweep was still awaiting its own `DROP DATABASE`
  // statements — that second call could clone its own job database and
  // have it dropped out from under it if the sweep's listing query happened
  // to run after the clone completed. Every caller now awaits the SAME
  // in-flight promise, so the sweep has FULLY finished (including
  // everything it awaits) before any job database is ever cloned.
  //
  // Best-effort: a sweep failure must not block the run — a run that cannot
  // dispatch jobs at all is worse than one with a stale orphan left for the
  // NEXT run's sweep to catch instead.
  const ensureJobDbSwept = createOnceGate(async () => {
    // No test database configured = no clones to reclaim, no psql to need.
    if (getProjectConfig().testDatabase === null) return;
    try {
      const swept = await sweepOrphanedJobDatabases({
        adminUrl: testDbAdminUrl(),
      });
      if (swept.dropped.length > 0) {
        log(
          `[db-clones] startup sweep reclaimed ${swept.dropped.length} ` +
            `orphaned job database(s): ${swept.dropped.join(", ")}`,
        );
      }
      if (swept.skippedAlive.length > 0) {
        log(
          `[db-clones] startup sweep left ${swept.skippedAlive.length} ` +
            `job database(s) alone — their creating process is still ` +
            `running (likely a sibling worktree checkout sharing this ` +
            `Postgres): ${swept.skippedAlive.join(", ")}`,
        );
      }
      if (swept.failed.length > 0) {
        logErr(
          `[db-clones] startup sweep FAILED to reclaim ` +
            `${swept.failed.length} orphaned job database(s): ` +
            swept.failed
              .map((f) => `${f.name} (${f.error})`)
              .join("; "),
        );
      }
    } catch (err) {
      logErr(
        `[db-clones] startup sweep errored (non-fatal): ${(err as Error).message}`,
      );
    }
  });

  // Cross-host issue lease. Everything below is inert unless the
  // opt-in flag is set: `leaseEnabled` false ⇒ every lease dep short-circuits
  // to today's behavior (acquire always wins, release/state/renew no-op) with
  // no git touched, so single-host consumers need no new push auth. When on,
  // the coordinator's registry tracks the leases THIS host currently holds so
  // renew can heartbeat them and release only ever deletes a ref we actually
  // own. The five lease methods live in the createLeaseCoordinator factory
  // (lib/state/issue-lease.ts) — a one-collaborator (`lockDeps`) seam that is unit-
  // testable against a fake LockBackend without the whole Deps graph.
  const leaseEnabled = crossHostLeaseEnabled();
  const lockDeps: LockDeps = {
    backend: createGitLockBackend({
      git: runGitLease,
      repoRoot: args.repoRoot,
    }),
    now: () => new Date().toISOString(),
    hostId: resolveHostId(),
    ttlSec: lockTtlSecOnce(), // Fix 8: single-resolved, memoized (see lockTtlSecOnce)
  };
  const leaseCoord = createLeaseCoordinator({
    lockDeps,
    leaseEnabled,
    dryRun: args.dryRun,
    logError: logErr,
    dryLog,
  });

  // Cross-host LANE SYNC (Task B). Like the lease, everything here is
  // inert unless the opt-in flag is set: `syncEnabled` false ⇒ syncLanes /
  // publishLane below short-circuit with NO git (no fetch/push/ls-remote), so a
  // single-host consumer is byte-for-byte unchanged. When on, lane git runs
  // ONLY through the bounded `runGitLease` runner (NEVER bare runGit) so a hung
  // fetch/push cannot wedge the loop. hostId matches the lease's namespace.
  const syncEnabled = crossHostSyncEnabled();
  const laneSync = createLaneSync({
    git: runGitLease,
    repoRoot: args.repoRoot,
    hostId: resolveHostId(),
  });

  // Cross-host STATUS SYNC (Task S5). Same gating + same BOUNDED
  // runner as lane-sync: inert unless `syncEnabled`, and status git runs ONLY
  // through `runGitLease` so a hung push/fetch cannot wedge the loop. Fail-soft
  // lives inside the module (publish returns {ok:false,error}; fetchPeers skips
  // bad peers) so no call site can crash the loop on a telemetry glitch.
  const statusSync = createStatusSync({
    git: runGitLease,
    repoRoot: args.repoRoot,
    hostId: resolveHostId(),
  });

  // Raw, provider-agnostic sandbox create (pre-clean + provider.createSandbox).
  // The exported `createSandbox` dep routes the FIRST call through the
  // worktree-health lazy repair, then calls this directly thereafter.
  const createSandboxRaw = async (
    spec: CreateSandboxSpec,
  ): Promise<SandboxHandle> => {
    // Pre-clean any stale worktree from a prior killed iteration. The
    // SDK's `cp -R src dest` (`CopyToWorktree.js:29,32`) has no
    // pre-clean: if `dest` already exists, `cp -R` recurses into it,
    // building `dest/node_modules/node_modules/...` until disk
    // exhaustion. Real bug — bit iteration 1 of the
    // budgeting branch. The SDK's `WorktreeManager.create()` handles a
    // missing path correctly via plain `git worktree add`, so this
    // guard hands it a clean slate. Three-tier fallback covers:
    //   1. Registered worktree (normal post-killed-iteration state)
    //      → `git worktree remove --force` clears reg + dir.
    //   2. Orphan dir git doesn't know about → `rmSync` removes it.
    //   3. Dangling registration with no dir → `git worktree prune`
    //      clears the registration so a fresh `add` succeeds.
    // Note: the mac-host provider runs its own pre-clean inside
    // `createSandbox` (see lib/mac-host-sandbox.ts:preCleanWorktree).
    // The outer pre-clean here is redundant on the mac-host path but
    // idempotent — letting it run keeps the orchestrator-side cleanup
    // contract identical across providers.
    const wtPath = path.join(args.repoRoot, worktreePathFor(spec.branch));
    // THE KILL-WINDOW CHECK (issue #1118). A check repair stands the worktree
    // back up on the code the builder was HANDED for the length of a whole
    // agent dispatch. A run killed inside that window leaves it there, and
    // nothing used to say so. `withWorktreeAt` now leaves a sentinel in the
    // COMMON git directory — which outlives both the kill and the worktree
    // removal below — and this is where the next run reads it.
    //
    // What it changes: the resume is REFUSED for this branch. The WIP ref may
    // hold a checkpoint taken mid-replay, and materialising that is
    // materialising the deletion of a whole night's work.
    // `commitWorktreeCheckpoint` refuses to write such a commit in the first
    // place, so in practice this should find nothing to save the ticket from —
    // it is the backstop for a checkpoint that came from a process which never
    // saw the sentinel, and the one place the interruption is ever REPORTED.
    const interruptedReplay = readReplaySentinel(args.repoRoot, wtPath);
    if (interruptedReplay !== undefined) {
      logErr(
        `worktree ${wtPath} was left mid-replay by a killed run (pid ` +
          `${interruptedReplay.pid}, started ${interruptedReplay.startedAtIso}): ` +
          `it was standing on ${interruptedReplay.atSha}, the code the builder ` +
          `was handed, and owed a restore to ${interruptedReplay.restoreToSha}, ` +
          `which is where that ticket's work is committed. Any saved checkpoint ` +
          `for this branch may therefore record the DELETION of that work, so ` +
          `it is not resumed from. Files the replay had moved aside, if the ` +
          `directory survived: ${interruptedReplay.holdDir || "(not recorded)"}.`,
      );
      clearReplaySentinel(args.repoRoot, wtPath);
    }
    // A worktree left here by a KILLED run is still LOCKED (issue #1260 — see
    // lib/paths/worktree-lock.ts), and both `git worktree remove --force` and
    // `git worktree prune` refuse a locked worktree. Drop our own lock first.
    //
    // OUTSIDE the `existsSync` gate below, and that placement is the whole
    // point. A killed run can leave the REGISTRATION locked with its DIRECTORY
    // already gone. Gate the unlock on the directory and that case is never
    // reached: prune cannot clear the registration, and the SDK's next
    // `git worktree add` dies for good on
    //   fatal: '<path>' is a missing but locked worktree
    // — the branch is then wedged until a human unlocks it by hand. Measured
    // on git 2.39.5; an earlier draft of this fix had the unlock inside the
    // gate and did exactly that.
    //
    // Resolved through git, keyed on the branch — never the derived path — so
    // it can only ever release a lock THIS loop took for THIS branch. A
    // `refused` answer means a lock we must not break: say so loudly and let
    // the remove below fail, rather than forcing past it.
    if (unlockOwnWorktree(args.repoRoot, spec.branch, runGit) === "refused") {
      logErr(
        `[issue-branch=${spec.branch}] its stale worktree is locked by ` +
          `something this loop did not lock — leaving it alone. This branch ` +
          `cannot be worked until that is cleared by hand: ` +
          `git worktree unlock ${wtPath}`,
      );
    }
    if (existsSync(wtPath)) {
      try {
        execFileSync("git", ["worktree", "remove", "--force", wtPath], {
          cwd: args.repoRoot,
          stdio: ["ignore", "pipe", "pipe"],
        });
      } catch {
        rmSync(wtPath, { recursive: true, force: true });
      }
    }
    try {
      execFileSync("git", ["worktree", "prune"], {
        cwd: args.repoRoot,
        stdio: ["ignore", "pipe", "ignore"],
      });
    } catch {
      // Best-effort. If a stale registration survives, the SDK's
      // collision-reuse path (WorktreeManager.js:~120) will hit it
      // first via `listWorktrees` and then fail loudly when
      // `hasUncommittedChanges` runs `git status` inside the now-
      // missing path. The error surfaces — just not through
      // `worktree add`.
    }

    // Branch reuse on pickup (docker path). When cross-host sync is
    // on and a WIP checkpoint exists on origin for this issue, fetch it and
    // point the local per-issue branch at that tip BEFORE the SDK's
    // `git worktree add <path> <branch>` — which reuses an existing branch's tip
    // — so the worktree is cut from the committed partial work. When the flag is
    // off (or no checkpoint, or a non-issue branch) NOTHING new runs: no
    // fetch/ls-remote, no branch write, and the SDK's create is byte-for-byte
    // today's behavior. Cross-host git goes through the BOUNDED `runGitLease`
    // (same convention as lane/status sync) so a hung fetch can't wedge the loop.
    // Decision (reuse vs fresh) is single-sourced in resolveReuseDecision so
    // this docker path and the mac-host path cannot silently diverge. It keeps
    // the flag-FIRST short-circuit — with sync off (or a non-issue branch) it
    // touches NO origin (no ls-remote), the inert-when-off contract. The branch
    // repoint below stays docker-specific (the SDK does the worktree add); only
    // the decision is shared. Cross-host git still goes through BOUNDED
    // runGitLease so a hung fetch can't wedge the loop.
    const reuse =
      // A branch left mid-replay never resumes — see the sentinel check at the
      // top of this function for why the checkpoint it would resume from
      // cannot be trusted.
      interruptedReplay !== undefined
        ? ({ reuse: false } as const)
        : await resolveReuseDecision({
            syncEnabled: crossHostSyncEnabled(),
            branch: spec.branch,
            repoRoot: args.repoRoot,
            git: runGitLease,
          });
    if (reuse.reuse) {
      // Fetch INTO the local WIP mirror (`+<ref>:<ref>`), not just to
      // FETCH_HEAD: the mirror is the lease pushWipRef checkpoints against, so a
      // resumed host that never writes it can never check its own work back in.
      // Refspec is single-sourced in wipMirrorFetchRefspec (shared with the
      // mac-host path), whose header carries the argument; the branch is then
      // repointed at the mirror we just wrote rather than FETCH_HEAD, so the ref
      // we lease against and the ref we work from are provably the same commit.
      runGitLease(
        args.repoRoot,
        "fetch",
        "origin",
        wipMirrorFetchRefspec(reuse.issue),
      );
      runGitLease(
        args.repoRoot,
        "branch",
        "-f",
        spec.branch,
        wipRef(reuse.issue),
      );
    }

    // Work around the SDK bug where createSandbox hardcodes
    // agentProviderEnv: {}, dropping per-call env injection. We bake the
    // implementer's provider env (kimi/glm creds + ANTHROPIC_BASE_URL)
    // into sandbox.env so it actually reaches the container. Anthropic
    // models return {} from envForModel (subscription path), so this is
    // a no-op for the default Anthropic case.
    const implEnv = envForModel(spec.implementerModel);
    let sandboxEnv = { ...containerEnv, ...implEnv };

    // Give THIS job its own copy of the test database instead of sharing the
    // one every other parallel job also writes to. Cloned from the project's
    // `testDatabase.templateDb` via Postgres's own `CREATE DATABASE ...
    // TEMPLATE` — a filesystem-level copy, not a re-seed — so the cost is small
    // and flat. Off unless `testDatabase` is set in .sandcastle/project.json,
    // and skipped when the operator has set the `SANDCASTLE_TEST_DB_URL`
    // escape hatch: that means "point every sandbox at THIS exact database",
    // which a per-job clone would silently defeat.
    //
    // The admin connection (`CREATE`/`DROP DATABASE`) runs HOST-side — see
    // `testDbAdminUrl` above for why psql cannot run this from inside the
    // container. The clone's OWN url, handed to the sandbox, uses the
    // container-reachable host `sandboxTestDbEnv` already resolved into
    // `containerEnv.POSTGRES_URL` — only the database NAME changes.
    let jobDb: string | null = null;
    let hostAdminUrl: string | null = null;
    const testDatabase = getProjectConfig().testDatabase;
    if (testDatabase !== null && !process.env.SANDCASTLE_TEST_DB_URL) {
      hostAdminUrl = testDbAdminUrl();
      jobDb = jobDatabaseName(spec.branch);
      const thisHostAdminUrl = hostAdminUrl;
      const thisJobDb = jobDb;
      // A `--dry-run` never writes to a database: no clone, no setup. The
      // sandbox is then pointed at the template itself, read-only in spirit.
      if (args.dryRun) {
        log(
          `[issue-branch=${spec.branch}] db-clones: DRY RUN — skipping the ` +
            `clone of "${testDatabase.templateDb}"`,
        );
        jobDb = null;
        hostAdminUrl = null;
      } else {
        await cloneJobDatabase({
          adminUrl: thisHostAdminUrl,
          templateDb: testDatabase.templateDb,
          jobDb: thisJobDb,
        });
        // The project's own step to bring the clone's schema up to date (for
        // example applying migrations the template has not seen). Runs
        // host-side from the repo root with the CLONE's url in `DATABASE_URL`;
        // a failure drops the clone and stops this ticket's sandbox.
        if (testDatabase.setupCommand !== undefined) {
          const cloneUrl = withDatabaseName(thisHostAdminUrl, thisJobDb);
          try {
            await runTestDatabaseSetup(testDatabase.setupCommand, args.repoRoot, cloneUrl);
          } catch (err) {
            await dropJobDatabase({ adminUrl: thisHostAdminUrl, jobDb: thisJobDb }).catch(
              () => undefined,
            );
            throw new TestDatabaseSetupError((err as Error).message);
          }
        }
        const jobDbUrl = withDatabaseName(containerEnv.POSTGRES_URL, thisJobDb);
        sandboxEnv = { ...sandboxEnv, POSTGRES_URL: jobDbUrl, DATABASE_URL: jobDbUrl };
        log(
          `[issue-branch=${spec.branch}] db-clones: cloned "${thisJobDb}" from ` +
            `"${testDatabase.templateDb}" for this job's own use`,
        );
      }
    }

    // Bound sandbox CREATION on the same wall-clock hard ceiling every agent run
    // already gets (2026-08-31 freeze). createSandbox is the one heavy step that
    // used to sit OUTSIDE the ceiling, and it runs the onSandboxReady hooks — the
    // `pnpm install` that hung with no timeout and froze the loop for 6.5h. The
    // SDK's createSandbox takes NO AbortSignal (CreateSandboxOptions has none),
    // so — exactly as the SDK itself does for run() — the ceiling can only unblock
    // the loop by RACING the abort here. The abandoned create promise is left
    // UNOBSERVED, not leaked: Task-1's in-hook POSIX `timeout` kills a hung
    // install itself, and the next iteration's pre-clean reaps any half-built
    // worktree (same "abort-then-reject, kill separately" model the agent run
    // uses via terminateSandboxProcessesOnAbort).
    const handle = await withCeiling(
      `createSandbox ${spec.branch}`,
      (signal) => {
        const create = (): Promise<ProviderSandboxHandle> =>
          new Promise<ProviderSandboxHandle>((resolve, reject) => {
            if (signal.aborted) {
              reject(signal.reason);
              return;
            }
            signal.addEventListener("abort", () => reject(signal.reason), {
              once: true,
            });
            provider
              .createSandbox({
                branch: spec.branch,
                mounts: spec.mounts,
                sandboxEnv,
              })
              .then(resolve, reject);
          });
        // Issue #915 fix: a clone that succeeds followed by a `provider.
        // createSandbox` that fails (worktree corruption, a Docker error, a
        // retry inside `createSandboxWithWorktreeRepair` minting a fresh clone
        // on its next attempt) used to leak `jobDb` forever — nothing else ever
        // calls `close()` on a handle that was never returned, so nothing else
        // ever drops it. `withJobDbCleanupOnFailure` is a no-op wrapper when
        // there's nothing to clean up (`jobDb === null`, the
        // SANDCASTLE_TEST_DB_URL escape hatch) and otherwise best-effort drops
        // the clone before rethrowing the ORIGINAL error unchanged. A ceiling
        // abort rejects `create()`, so this cleanup still runs on a timeout.
        return jobDb !== null && hostAdminUrl !== null
          ? withJobDbCleanupOnFailure(
              { adminUrl: hostAdminUrl, jobDb },
              create,
              (dropErr) =>
                logErr(
                  `[issue-branch=${spec.branch}] db-clones: createSandbox failed ` +
                    `after cloning "${jobDb}" — failed to drop the now-leaked ` +
                    `clone too (non-fatal — the next run's startup sweep will ` +
                    `reclaim it once this process exits): ${dropErr.message}`,
                ),
            )
          : create();
      },
    );
    // Issue #1260: LOCK the worktree the instant it exists, before any other
    // ticket can prune. A `git worktree lock` is enforced by git itself, so it
    // holds against this loop's own global prunes AND against the vendored
    // SDK's `pruneStale`, which runs on every sandbox create and, on the same
    // pass, `rm -rf`s any directory its post-prune listing no longer calls
    // active. Without this, a cleanup for a LANDED ticket destroyed live
    // #1260's registration mid-run and its reviewer died on
    // `not a git repository: .../.git/worktrees/agent-issue-1260`, throwing
    // away a finished build. Best-effort by design — see
    // lib/paths/worktree-lock.ts for why a failed lock must not stop a ticket.
    //
    // The path is the PROVIDER'S OWN answer (`handle.worktreePath`) wherever
    // it gives one, falling back to the derived path only when it does not.
    // That is the same rule `cleanupIssueBranch` now follows: a derivation
    // that drifts would otherwise leave the ticket silently unlocked.
    const lockPath = handle.worktreePath ?? worktreePathFor(spec.branch);
    const locked = lockWorktree(args.repoRoot, lockPath, spec.branch, runGit);
    if (locked === "failed") {
      logErr(
        `[issue-branch=${spec.branch}] could not lock its worktree — a cleanup ` +
          `or prune for ANOTHER ticket may now reap it mid-run (issue #1260). ` +
          `Continuing: a missing lock is a risk, not a reason to stop the ticket.`,
      );
    }

    // THE LEAK GUARD, and it is a FORWARD guard — say so plainly rather than
    // letting it read as protection that is doing work today.
    //
    // The hazard is real: anything that throws between the lock above and the
    // `return` below escapes `createSandbox`, so `runIssuePipeline` never
    // assigns `sandbox`, its `finally` never runs, and the lock outlives the
    // ticket. It self-heals on that branch's next run, but a ticket that is
    // quarantined and never retried keeps its lock for good — the leftover
    // that makes a later `/sandcastle-clean` refuse with no explanation.
    //
    // TODAY the only statement inside is `writeSandboxAgentSettings`, which
    // catches its own errors and cannot throw, so this catch never fires. It
    // is here because this region is where statements get ADDED, and the next
    // one will not come with a reviewer who remembers the lock. Do not delete
    // it as dead code; add inside it.
    try {
      // 2026-09-04 loop-config fix: the worktree is the sandboxed agent's cwd
      // on BOTH providers (docker's per-issue worktree, mac-host's `-C`), and
      // this is the earliest point it exists — right after the SDK/mac-host
      // create call returns and before the pipeline's first `sb.run`. Writing
      // here means every agent dispatched into this sandbox runs under the
      // loop's own Claude config, not whatever the launching host's
      // `~/.claude` carries. See lib/sandbox-agent-settings.ts's module doc
      // comment for the incident this closes.
      if (handle.worktreePath !== undefined) {
        writeSandboxAgentSettings(handle.worktreePath, { warn: logErr });
      }
    } catch (afterLock) {
      unlockOwnWorktree(args.repoRoot, spec.branch, runGit);
      throw afterLock;
    }
    return {
      branch: handle.branch,
      worktreePath: handle.worktreePath,
      // Straight from the shared decision computed above, so the check-writer
      // can tell a resumed worktree from a fresh one (issue #916, defect 2 —
      // see `SandboxHandle.resumedFromCheckpoint`). Same value the mac-host
      // provider sets from the same `resolveReuseDecision`.
      resumedFromCheckpoint: reuse.reuse,
      // Issue #1025: the clone this sandbox's POSTGRES_URL was pointed at. `null`
      // under the SANCASTLE_TEST_DB_URL escape hatch (no clone was minted). The
      // wrong-database guard in `runImplementer` reads this to know which
      // database the run was SUPPOSED to touch.
      jobDb,
      run: async (opts) => {
        // Spec #1368 decision 4: before each implement / review / check-writer
        // run (the fixer reuses the implement prompt), re-write the read-only
        // copy of THIS run's filled prompt into the workspace, so an agent
        // whose context was compacted rereads it instead of searching its
        // session record. Re-written every run so an edit cannot persist.
        // Best effort: never fails the run.
        writeInstructionsForRun(args.repoRoot, handle.worktreePath, opts, logErr);
        const r = await withCeiling(
          `sandbox run "${opts.name}"`,
          (signal) => handle.run({ ...opts, signal }),
          opts.ceilingMs,
        );
        // Forward the SDK's per-iteration session-capture metadata —
        // both `sessionFilePath` (when capture is wired) and `sessionId`
        // (always present for Claude agents) so the downstream consumer
        // can fall back to the conventional path layout. See
        // resolveSessionFilePath / the seam definition on RunHandle.
        return {
          stdout: r.stdout,
          commits: r.commits,
          iterations: r.iterations?.map((it) => ({
            sessionFilePath: it.sessionFilePath,
            sessionId: it.sessionId,
          })),
          // Forward the stuck-detector's deliberate-abort flag (issue #1207,
          // item 1). Without this line the fresh object above drops it, so the
          // carve-outs that read `stuckAborted` in `runImplementer` and
          // `runBuilderIterations` were dead on the real docker path: a stuck
          // abort was mistaken for an ordinary run and tripped the envelope /
          // skill / no-commit gates instead of routing the partial work to the
          // reviewer or the StuckError quarantine arm.
          stuckAborted: r.stuckAborted,
        };
      },
      // Forwarded verbatim — no `withCeiling` wrapper. The ceiling machinery
      // exists to bound AGENT runs, which are open-ended by nature; an exec is
      // already bounded by the `timeoutMs` its caller passes, and that bound is
      // enforced inside the sandbox where it can actually kill the process.
      exec: handle.exec,
      close: async () => {
        try {
          return await handle.close();
        } finally {
          // Drop THIS job's database now rather than waiting for the next
          // run's startup sweep — on a healthy exit there is no reason to
          // let it sit on disk for hours. A crash before this line ever
          // runs is exactly what the sweep exists to reclaim; failure here
          // is logged loudly, never thrown, so a stuck drop can't turn a
          // clean sandbox teardown into a crashed iteration.
          if (jobDb !== null && hostAdminUrl !== null) {
            try {
              await dropJobDatabase({ adminUrl: hostAdminUrl, jobDb });
            } catch (err) {
              logErr(
                `[issue-branch=${spec.branch}] db-clones: failed to drop job ` +
                  `database "${jobDb}" (non-fatal — the next run's startup ` +
                  `sweep will reclaim it): ${(err as Error).message}`,
              );
            }
          }
        }
      },
    };
  };

