// Fix 8: resolve the lease TTL exactly ONCE per process and memoize
// it, so the lease lifetime (lockDeps.ttlSec, in buildDefaultDeps) and the
// heartbeat cadence (~ttl/3, in runMain) can never desync on a mid-run env
// change — both read this single cached value.
let cachedLockTtlSec: number | undefined;
function lockTtlSecOnce(): number {
  if (cachedLockTtlSec === undefined) cachedLockTtlSec = resolveLockTtlSec();
  return cachedLockTtlSec;
}

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

/**
 * Issue chosen by the plan (or the one-shot --issue path) and pushed into the
 * parallel execute pool. `id` is a string for one historical reason — the
 * deleted planner AGENT emitted issue numbers as JSON strings — and stays one
 * because `dealer.ts` keys its stack and in-flight map on it;
 * `planDeterministic` mints it as `String(issue.number)`. We coerce when
 * calling gh.
 */
export interface PlanIssue {
  readonly id: string;
  readonly title: string;
  readonly branch: string;
}

/**
 * Args parsed from argv (or supplied programmatically in tests). Every
 * default lives here so consumers don't have to remember them.
 */
export interface SandcastleArgs {
  iterations: number;
  issue?: number;
  repoRoot: string;
  branch: string;
  /**
   * Shared-run identity: the pre-hostId-suffix branch name. All hosts
   * cooperating on ONE shared queue derive the SAME `runId` (so a cross-host
   * viewer folds their snapshots), while `branch` stays host-distinct for git
   * safety. With the lease OFF or an explicit `--branch`, `runId === branch`.
   * See {@link deriveRunBranchAndId}.
   */
  runId: string;
  label: string;
  maxConcurrent: number;
  implementerModel: string;
  reviewerModel: string;
  critiqueModel: string;
  mergerModel: string;
  postMergeReviewerModel: string;
  recoveryModel: string;
  implementerTimeoutSec: number;
  /**
   * Whether `--implementer-timeout-sec` was passed explicitly on the CLI.
   * When false, runMain applies a `SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC` env
   * fallback (resolved post-dotenv — see the fallback block in runMain). The
   * CLI flag always wins, even when its value equals the 1200 default.
   */
  implementerTimeoutSecExplicit: boolean;
  reviewerTimeoutSec: number;
  /**
   * Outer wall-clock ceiling around every SDK `run` / `handle.run` call.
   * Independent of the SDK's own idle timer, which resets on every
   * stdout line and so can be evaded by an agent that emits trickle
   * output while making no real progress (observed: tsc retry loops
   * after a host-level OOM kills the tsc child silently). When the
   * ceiling fires, an `AbortSignal` is raised. `lib/sandbox-provider.ts`
   * turns that signal into a real kill inside the sandbox — the SDK
   * itself does NOT (see `terminateSandboxProcessesOnAbort`).
   *
   * This bounds ONE WHOLE ROLE INVOCATION, not one iteration: the only
   * two call sites wrap an entire `sandbox run "<role>"` and an entire
   * `top-level run "<role>"` (see `withCeiling` in `buildDefaultDeps`).
   * A 90-minute implementer is therefore normal, not pathological.
   *
   * DEFAULT 3600s = 60 min, and it must stay there. 2026-08-03 tried to
   * lower it to 1800 on the theory that "any hang starting past minute 40
   * could ONLY be caught by this ceiling"; that change landed in the help
   * text and `defaultArgs()` but NOT in `parseSandcastleArgs`, so every
   * CLI-launched run kept using 3600 and nobody noticed for four days.
   * The drift is resolved in favour of 3600 because 1800 false-kills real
   * work. Evidence: the 2026-08-07 implementer for issue #803, log
   * `.sandcastle/logs/agent-issue-803-implementer.log` on the server,
   * banner `2026-08-07T05:46:36.664Z`. Its whole run contains exactly
   * three idle stretches, and the first two are ONE MINUTE each — so the
   * agent was demonstrably still doing real work well past minute 30, and
   * a 1800s ceiling would have killed it mid-work. (Its third idle
   * stretch, 118 unbroken minutes, began at `07:17:27Z` — half an hour
   * AFTER this ceiling fired at `06:46:36Z` — so it belongs to the
   * orphaned process, not to the live run. Do not read it as the agent
   * hanging for two hours under a live ceiling.)
   *
   * A STUCK agent is the IDLE TIMER's job, not this one
   * (`implementerTimeoutSec`, default 1200s, passed to the SDK as
   * `idleTimeoutSeconds`). This ceiling exists only for the case the idle
   * timer structurally cannot see: an agent emitting trickle output
   * forever. Do not re-purpose it as a stuck detector by lowering it.
   *
   * All three copies of this default — here, `defaultArgs()` and
   * `HELP_TEXT` — are asserted to agree by `main.test.mts` ("CLI defaults
   * match the non-CLI fallback bag"), so the 2026-08-03 split cannot
   * recur silently.
   */
  hardCeilingSec: number;
  /**
   * How many consecutive CRASHES end the run. An `error` outcome — the
   * pipeline could not even park the ticket — and a claim/pre-pipeline
   * rejection are the only things that count here.
   */
  consecutiveFailureLimit: number;
  /**
   * How many consecutive QUARANTINES end the run, counted separately from
   * {@link SandcastleArgs.consecutiveFailureLimit} (issue #969).
   *
   * Parking a ticket for a human is the loop working AS DESIGNED — a spec too
   * thin to build from, a review that would not clear, a gate that fired. A
   * crash is not. Scoring both on one counter meant a night of ordinary,
   * correctly-parked tickets read as a malfunctioning loop: on 2026-08-04,
   * with four tickets in flight per iteration, the 3-strike breaker tripped at
   * 5 and ended a 71-ticket run at iteration 3 of 71.
   *
   * There is still a CEILING, and it is deliberately generous rather than
   * absent: a night where every single ticket parks is burning money for
   * nothing, and the loop must stop by itself rather than wait for a human to
   * notice in the morning. 8 is comfortably above two full iterations at the
   * usual concurrency and comfortably below a whole night's queue.
   */
  quarantineLimit: number;
  logFile?: string;
  dryRun: boolean;
  /**
   * The fixer (spec #1334, SG). When true (the CLI default), any failure — a
   * review refusal after the builder's rounds, a failed ship-time check, a
   * time-out — hands the ticket to ONE fixer pass on the builder's own
   * prompt, with the builder's same three review rounds, shipping through
   * the ordinary ship gate. `--recovery off` turns it off: every failure then
   * stops the ticket where it happened.
   */
  recoveryEnabled: boolean;
  /**
   * Bounded retry ladder for the per-issue pipeline. When true (default), a
   * HAS_BLOCKERS verdict on the first reviewer pass triggers a second
   * implementer pass on `models.implementer.escalations[0]` (with the
   * reviewer's feedback in-prompt) followed by a second reviewer pass on
   * `models.reviewer.escalations[0]`. ALL_CLEAR at any point ships
   * immediately.
   *
   * On round-2 HAS_BLOCKERS, the loop optionally grants a third attempt:
   * if both rounds' CATEGORY SWEEP blocks parse AND every category that
   * was a "finding" in round 1 is now "ok" or "n/a" in round 2, the
   * implementer demonstrably resolved everything the reviewer asked
   * about — round 2's complaints are genuinely new and progress is
   * real, so we try once more rather than bouncing to needs-human. A
   * malformed or missing sweep in either round skips the grant
   * (conservative fallback; never produce a free retry on a parse
   * failure), and so does a single ROW the run could not read — see
   * `SweepStatus`'s `unreadable`, which is withheld conservatively and
   * reported as a reading failure rather than as an objection. Round 3
   * HAS_BLOCKERS → quarantine; there is no round 4.
   *
   * Set to false (via `--no-retry`) to fall back to one-shot behavior
   * (any HAS_BLOCKERS → quarantine immediately).
   */
  retryEnabled: boolean;
  /**
   * Route every merge through a persistent `integration-candidate` staging
   * branch and gate the fast-forward of `--branch` on a post-merge reviewer
   * pass (with a fixer escalation in between). Default: true.
   *
   * When false (`--no-staging`), the loop falls back to today's behavior:
   * the merger merges directly into `--branch`, the post-merge reviewer
   * runs but only logs warnings, no fix-loop runs, and per-issue labels go
   * straight `in-progress` → `done` on a successful merger pass.
   */
  stagingEnabled: boolean;
  /**
   * Implementer-side provider override. When set (via `--provider kimi|glm`),
   * the implementer model is replaced with that provider's default coding
   * model (`kimi-for-coding` for kimi, `glm-4.6` for glm) for both the
   * initial pass and the escalation slot. All other roles (reviewer, check-writer,
   * merger, post-merge-reviewer, post-merge-fixer, recovery) stay on whatever
   * `.sandcastle/models.ts` defines — typically Anthropic on subscription.
   *
   * Undefined means "no override — use models.ts as-is" (Anthropic everywhere
   * by default).
   */
  provider?: ProviderName;
  /**
   * Agent backend for this run. `"codex"` routes every role —
   * including retry-ladder escalations and the post-merge fixer — to Codex
   * models via {@link roleModelsFor}; `"claude"` (or undefined) uses
   * `models.ts`. Set by `--backend`. Undefined is treated as `"claude"`.
   */
  backend?: AgentBackend;
  /**
   * Launch-time Opus model profile (`--opus`, default `"5.5"`). NOT a backend —
   * both values run the same anthropic provider on the `claude` backend; they
   * differ only by the model string on the six opus-heavy roles. `"5"` swaps
   * {@link roleModelsFor} from `models` (`claude-opus-5-5`) to `opus5Models`
   * (`claude-opus-5`, empty escalations) — the step back. `"5"` is
   * claude-backend-only: it cannot combine with `--backend codex` or any
   * `--provider`. `"5.5"` is the byte-for-byte default.
   */
  opusProfile: OpusProfile;
  /**
   * Budget mode (`--budget`, default `false`). Selects `budgetModels` via
   * {@link roleModelsFor}, giving the implementer a "Sonnet fix-it rung"
   * ladder: Sonnet-5 first pass, a second Sonnet-5 pass WITH reviewer feedback
   * (cheap fix-it), then `claude-opus-5-5` reserved for the round-3 grant.
   * The implementer is the loop's dominant token consumer, so this is the main
   * cost lever. Claude-anthropic-only: cannot combine with `--backend codex` or
   * `--provider`. An explicit `--implementer-model` still wins over it.
   */
  budget: boolean;
  /**
   * Docker image to run the sandbox in. Defaults to the same name
   * `sandcastle docker build-image` produces — `sandcastle:<basename>` of
   * `--repo-root` (e.g. `~/Dev/myproj` → `sandcastle:myproj`). That match
   * is critical: sandcastle's own `docker()` would otherwise derive the
   * name from the per-issue WORKTREE dir (`sandcastle:agent-issue-83`)
   * which is never the image we just built. Override with `--image-name`.
   */
  imageName: string;
  /**
   * When true, the preflight `git diff --quiet HEAD -- .sandcastle/main.mts`
   * check is skipped (a warning is logged instead). The check exists to
   * prevent the "patched locally but never committed" failure mode that
   * has bitten the loop twice in a row: a downstream fix gets shipped in a
   * consumer's vendored copy of main.mts but never propagated upstream, so
   * the next `/sandcastle-update` clobbers the patch. Default false —
   * strictness is the norm; the flag exists for legitimate
   * "tweak-then-test-then-commit" workflows in the template repo itself.
   */
  allowDirtySandcastle: boolean;
  /**
   * When true, preflight check #7d — "can a container off this run's image
   * actually reach the test database" — is skipped (a warning is logged
   * instead). Default false.
   *
   * The check exists because on 2026-08-05 it could not: the host firewall
   * dropped the docker bridge, every host-side probe stayed green, and the
   * loop dispatched issue after issue into a sandbox where no check could
   * ever run — ~19 minutes each, quarantined `stopped:no-failing-check`.
   *
   * The hatch exists for the cases where the probe itself is the wrong
   * instrument rather than the environment being broken: a sandbox pointed at
   * a database that is deliberately started later, or a host whose docker
   * runtime refuses `docker run` for a reason unrelated to the loop. Strict
   * is the norm; this is the same shape as `--allow-dirty-sandcastle`, and
   * like it, using it prints a stderr WARN.
   */
  allowUnreachableSandboxDb: boolean;
  /**
   * When true, preflight check #7f — "can a container off this run's image
   * actually BIND the address its `next dev` server will listen on" — is
   * skipped (a warning is logged instead). Default false.
   *
   * This is Fix G, the systemic backstop for the F12 class (see
   * `docs/reference/agent-failures.md`): a host-only dev-server bind address
   * (a Tailscale IP in `SANDCASTLE_DEV_HOST`, or the `SANDCASTLE_SHARED_HOST`
   * policy flag that forces that bind) riding the project `.env` into the
   * check sandbox, where that address has no interface. `next dev -H <it>`
   * then fails with `EADDRNOTAVAIL`, the dev server never serves, every
   * browser/screen check grades 0/0/0, and each ticket is quarantined
   * `stopped:no-failing-check` after burning its full budget. Fix F blanks
   * those two vars in `sandboxTestDbEnv()` to prevent the first instance;
   * this check catches any FUTURE regression that re-hands the sandbox an
   * unbindable address, once, before a single ticket is dispatched.
   *
   * The hatch mirrors `--allow-unreachable-sandbox-db`: for the cases where
   * the probe itself is the wrong instrument rather than the environment
   * being broken. Strict is the norm; using it prints a stderr WARN.
   */
  allowUnreachableDevBind: boolean;
  /**
   * Sandbox provider. `"docker"` (default) runs each agent inside an
   * ephemeral Docker container. `"mac-host"` skips the container and
   * runs the agent natively on the macOS host — useful for development
   * on Apple Silicon where Docker-in-Docker or nested virtualisation is
   * unavailable. Wired via `--sandbox docker|mac-host`.
   */
  sandbox: "docker" | "mac-host";
  /**
   * Loop-cost ticket 03 opt-in (`--stuck-detector`). Docker-only live safety
   * net that aborts a demonstrably-spinning implementer and hands its
   * committed work to the reviewer. Default false = today's run path.
   */
  stuckDetector: boolean;
}

/**
 * Test-injection seam. When `deps` is supplied, the orchestrator delegates
 * every external side effect through these functions. Production callers
 * leave it undefined and get the real `sandcastle.run`/`sandcastle.createSandbox`
 * / gh wrappers via {@link buildDefaultDeps}.
 *
 * The shapes intentionally use a structural subset of `RunResult` /
 * `SandboxRunResult` / `Sandbox` so tests can return plain literals.
 */
export interface RunHandle {
  readonly stdout: string;
  readonly commits: readonly { sha: string }[];
  /**
   * Per-iteration session-capture metadata, threaded straight through from the
   * SDK's `SandboxRunResult.iterations` (see
   * `node_modules/@ai-hero/sandcastle/dist/Orchestrator.d.ts:32`). We expose
   * both `sessionFilePath` (the SDK's chosen path, set only when capture is
   * wired with `bindMountHandle`) and `sessionId` (always present for Claude
   * agents) so {@link resolveSessionFilePath} in skill-discipline can fall
   * back to the conventional `~/.claude/projects/<encoded>/<id>.jsonl`
   * layout when `sessionFilePath` is undefined. Audit Issue 1 (2026-05-30)
   * — without the `sessionId` fallback, every iteration on host-backed
   * orchestration was credited with zero skill invocations.
   * Optional because legacy test mocks return `{ stdout, commits }` without
   * iteration data.
   */
  readonly iterations?: readonly {
    readonly sessionFilePath?: string;
    readonly sessionId?: string;
  }[];
  /**
   * Set by the docker provider (loop-cost ticket 03) when it converts a
   * stuck-detector abort into a GRACEFUL result carrying whatever the aborted
   * implementer already committed. Downstream {@link runImplementer} reads it
   * to route that partial work to the reviewer instead of tripping its
   * envelope/skill/no-commit gates — those gates assume a normal run.
   * Absent/`false` on every ordinary run and on the mac-host path.
   */
  readonly stuckAborted?: boolean;
}

export interface SandboxHandle {
  readonly branch: string;
  readonly worktreePath?: string;
  run(opts: SandboxRunSpec): Promise<RunHandle>;
  /**
   * Run one command INSIDE the sandbox — the seam the test-verification gate
   * uses to re-run the shipped code's suites where their dependencies actually
   * live. See `lib/sandbox-exec.ts` for the full argument; the short version is
   * that the per-issue worktree's `node_modules` is Linux-built, so running it
   * on a Mac host verifies nothing.
   *
   * OPTIONAL only here, and only because the legacy test doubles throughout
   * `main.test.mts` implement `{ branch, run, close }` and nothing more. On
   * `ProviderSandboxHandle` — the shape real providers must satisfy — it is
   * REQUIRED, so a production provider cannot lose it silently. When it is
   * absent the gate reports inconclusive (which never blocks) rather than
   * crashing a ship path over a missing capability.
   *
   * A standalone {@link SandboxCommandRunner} field, not a method: the gate is
   * handed this function detached from its handle, so declaring it as a method
   * would permit a `this`-dependent implementation that breaks at the one call
   * site that matters.
   */
  readonly exec?: SandboxCommandRunner;
  /**
   * True when this worktree was cut from a saved WIP checkpoint rather than
   * from HEAD — i.e. the loop is RESUMING work it (or a peer host) started
   * earlier (decided by `resolveReuseDecision`). Both sandbox providers set
   * it from the same shared decision, so the two cannot diverge.
   *
   * Load-bearing for exactly one thing, and it is not a nicety (issue #916,
   * defect 2): a checkpoint commits the WHOLE worktree, check file included,
   * so on resume the check file is already on disk and
   * `hasPreexistingCheckFiles` reports "inherited" — which used to skip the
   * must-fail-first proof entirely, on a ticket whose check nobody had ever
   * seen fail. `runCheckWriter` reads this flag to tell that case apart from
   * Piece J's genuine human-committed inheritance.
   *
   * Optional, defaulting to "not resumed", because the legacy test doubles
   * throughout `main.test.mts` implement `{ branch, run, close }` and nothing
   * more. Absent therefore means "a fresh worktree", which is the SAFE
   * default here only because the resumed case is the one that RELAXES a
   * gate; a handle that forgets to set it pays for one extra proof run, it
   * never skips one.
   */
  readonly resumedFromCheckpoint?: boolean;
  /**
   * The per-job database clone this sandbox's tests must run against — the exact
   * name `main.mts` minted via `jobDatabaseName(branch)` and exported as
   * `POSTGRES_URL` into the sandbox (issue #1025). Load-bearing for the
   * wrong-database guard: `runImplementer` reads the database the run ACTUALLY
   * resolved to out of the run's stdout (`OBSERVED_DB_SENTINEL`) and refuses to
   * certify green when it is not this clone (the #1015 false green — a passing
   * run against a database the grader never reads).
   *
   * `null` when the operator pinned a single database via the
   * `SANDCASTLE_TEST_DB_URL` escape hatch (no clone was minted, so there is
   * nothing to compare against). `undefined` on the mac-host provider and the
   * legacy test doubles that provision no clone — absent therefore means "this
   * host did not mint a clone", which the guard treats as "cannot verify" and
   * skips, exactly like the escape-hatch case. A real docker run WITH a clone
   * always sets it, so the guard bites where the isolation exists.
   */
  readonly jobDb?: string | null;
  close(): Promise<unknown>;
}

/** Distilled "what to run" descriptor — the seam consumes this verbatim. */
export interface SandboxRunSpec {
  readonly name: string;
  readonly maxIterations?: number;
  readonly model: string;
  readonly promptFile: string;
  readonly promptArgs?: Record<string, string>;
  readonly idleTimeoutSeconds?: number;
  /**
   * Optional per-call wall-clock cap, in ms. The `deps.createSandbox(...).run`
   * wrapper below takes `min(args.hardCeilingSec * 1000, ceilingMs)` as the
   * ceiling it hands to `withCeiling` for THIS call, rather than the run's
   * whole-batch ceiling. Set by `runImplementer`'s batch loop
   * (`runBuilderIterations`, `lib/builder-progress.ts`) so a run split into
   * many `maxIterations: 1` passes still shares ONE hard ceiling across all
   * of them instead of each pass getting a fresh full budget. Both providers
   * (`lib/sandbox-provider.ts`, `lib/mac-host-sandbox.ts`) pick named fields
   * off this spec and never read this one — it exists only for the deps
   * wrapper here in `main.mts`.
   */
  readonly ceilingMs?: number;
}

export interface TopLevelRunSpec extends SandboxRunSpec {
  readonly mounts?: readonly {
    hostPath: string;
    sandboxPath: string;
    readonly?: boolean;
  }[];
  /**
   * Override the working directory for this top-level run. Used by the merger
   * to run inside the dedicated staging worktree at
   * `<repoRoot>/.sandcastle/worktrees/staging` rather than the launch worktree
   * — prevents the merger from leaving the launch HEAD parked on
   * `integration-candidate` across iterations (see ensureStagingWorktree).
   */
  readonly cwd?: string;
}

export interface CreateSandboxSpec {
  readonly branch: string;
  readonly mounts?: readonly {
    hostPath: string;
    sandboxPath: string;
    readonly?: boolean;
  }[];
  /**
   * Implementer model that will run inside this sandbox. Used to compute the
   * provider env (kimi/glm/anthropic) and bake it into the container at
   * startup via sandcastle's `sandbox.env`. Required because the SDK
   * (@ai-hero/sandcastle) drops per-call agent env on persistent sandboxes
   * — `createSandbox.js` hardcodes `agentProviderEnv: {}`, so the env we
   * pass through `claudeCode(model, { env })` never reaches the container
   * for `handle.run`. Only `sandbox.env` survives, and that's set at
   * sandbox-creation time. Implication: every call inside this sandbox
   * routes to the implementer's provider — if a reviewer escalation flips
   * to a different provider, that call mis-routes. With current model
   * defaults (implementer + reviewer both kimi-for-coding, escalations
   * both Anthropic), the bounded impact is: failed-Kimi pipelines escalate
   * inside the same sandbox and re-fail. Acceptable for now; revisit when
   * the SDK is patched upstream.
   */
  readonly implementerModel: string;
}

/**
 * What {@link Deps.runScreenCheckHarness} decided (issue #912, Piece F/K).
 * `record` is exactly the shape `IssueTelemetryBag.noteScreenCheck` expects
 * — the OBSERVED half of the record, kept separate from the implementer's
 * own `certification` (the CLAIMED half) all the way to disk.
 */
export interface ScreenCheckHarnessResult {
  readonly verdict: HarnessVerdict;
  readonly reason: string;
  readonly rerun: boolean;
  /**
   * Every DISTINCT database name the graded run announced (issue #1025), parsed
   * HOST-SIDE from the harness run's OWN combined stdout+stderr — the same output
   * the harness grades and `check-run-log.ts` persists, via the
   * `SANDCASTLE_OBSERVED_DB:` line `apps/nextjs/e2e/global-setup.ts` prints. The
   * ship funnel compares this against the clone the loop minted
   * (`enforceObservedDatabase`) and refuses to certify green on a database the
   * grader never read. Optional/`[]` on every route with no observation — a unit
   * run (no `global-setup` printing it) or a pre-#1025 test double.
   */
  readonly observedDatabases?: readonly string[];
  readonly record: {
    readonly screen?: string;
    readonly verdict: HarnessVerdict;
    readonly whenIso: string;
    readonly rerun: boolean;
    readonly pictureLink?: string;
    readonly pictureStored: boolean;
    /**
     * EVERY attempt's verdict, oldest first (length 1, or 2 after the one
     * allowed re-run) — the full story behind the single `verdict` above,
     * which since `moreEvidencedVerdict` is the MORE-EVIDENCED of the two
     * attempts rather than automatically the second. Without this, both
     * runs' outcomes were thrown away the moment the verdict was resolved,
     * and a human opening a ticket that stopped on a screen check had no way
     * to see that the other run said something different — let alone audit
     * which one was chosen. Carried all the way to
     * `.sandcastle/telemetry/issues.jsonl`.
     */
    readonly attemptVerdicts?: readonly HarnessVerdict[];
  };
}

/**
 * Where an `ALREADY_BUILT` ticket's work actually lives (issue #1110). `onMain`
 * / `onStaging` come from a cheap `git ls-tree` of the issue's committed check
 * slice on `origin/main` and `integration-candidate`; `"uncertain"` when any
 * lookup could not be resolved, which routes the ticket to a human.
 */
export type AlreadyBuiltLocation =
  | { readonly onMain: boolean; readonly onStaging: boolean }
  | "uncertain";

export interface Deps {
  /** Top-level `sandcastle.run({...})` wrapper. */
  run(spec: TopLevelRunSpec): Promise<RunHandle>;
  /** `sandcastle.createSandbox({...})` wrapper. */
  createSandbox(spec: CreateSandboxSpec): Promise<SandboxHandle>;
  /** Label state machine. */
  claim(issueNum: number): Promise<void>;
  markDone(issueNum: number, summary: string): Promise<void>;
  /**
   * Flip an issue's label to `merged-to-staging` after its branch lands on
   * `integration-candidate`. The issue stays open until staging certifies
   * and `promoteStagingToDone` fast-forwards integration.
   */
  markMergedToStaging(issueNum: number): Promise<void>;
  /**
   * Mechanically locate this ticket's already-built work, for the `ALREADY_BUILT`
   * disposal (issue #1110). The check-writer answers `ALREADY_BUILT` off what it
   * SEES in the worktree, which is not evidence about the product; this consults
   * the two locations that ARE — `origin/main` and `integration-candidate` — and
   * reports which contain the ticket's committed slice. Two cheap branch lookups,
   * seconds each — NOT a re-run of the acceptance check.
   *
   * FAIL-SAFE: any unresolved probe returns `"uncertain"`, and the caller
   * quarantines to a human rather than auto-closing. OPTIONAL for the same reason
   * {@link reportStop} is — a legacy/test `deps` that omits it is treated as
   * `"uncertain"`, i.e. the safe fallback. Production's `buildDefaultDeps` always
   * provides it.
   */
  locateAlreadyBuiltWork?(issueNum: number): Promise<AlreadyBuiltLocation>;
  /**
   * Promote every still-`merged-to-staging` issue in `issueNums` to `done`
   * with the shared `summary` comment, after staging fast-forwards into the
   * integration branch.
   */
  promoteStagingToDone(
    issueNums: readonly number[],
    summary: string,
  ): Promise<{ failed: readonly number[] }>;
  /**
   * Finish the run: push the run branch to `origin` and open a DRAFT PR
   * against the default branch, so a completed run ends with one reviewable
   * thing instead of a pile of commits on a machine.
   *
   * Before this existed the loop never pushed a real branch and never opened
   * a PR — its last act was relabelling issues on a branch that lived only on
   * the host that produced it, so every run ended with a human doing
   * archaeology to work out what had actually been built.
   *
   * Best-effort and non-fatal: the commits are safe in git either way, so a
   * failure here must not turn a successful run into a failed one. Returns
   * the PR URL when one was opened or already existed.
   *
   * `opts.promotionFailed` marks the PR body with a loud warning that a
   * final promotion refused during this run — the branch may be incomplete
   * relative to what was certified. `opts.previouslyShipped` lists issues
   * still carrying `shipped-local` from an interrupted prior run whose code
   * presence on THIS branch could not be verified — surfaced under a
   * distinct heading, deliberately NOT added to the `Closes #N` list.
   */
  openRunPr(
    branch: string,
    shippedIssueNums: readonly number[],
    opts?: {
      readonly promotionFailed?: boolean;
      readonly previouslyShipped?: readonly { number: number; title: string }[];
      /**
       * Set when the run ended on the circuit breaker rather than finishing —
       * the human-readable trip line ("N consecutive quarantine(s) ≥ limit
       * M"). Without it the PR body reads like a clean night for a run that
       * stopped itself part-way through its queue (issue #969).
       */
      readonly breakerTrip?: string;
      /**
       * The end-of-run report (issue #1179), pre-rendered by
       * `buildRunReport` and wrapped in its own marker section here — never
       * re-derived inside this Deps implementation, so the report a test
       * captures is byte-identical to the one `finishRun` computed. Absent
       * for callers that predate #1179 (every pre-#1179 test fixture);
       * omitted entirely from the PR body in that case.
       */
      readonly report?: string;
      /**
       * This host's own id (issue #1179 review, blocker 4 — the multi-host
       * fix). Required alongside `report` to key the report's marker
       * section and title so a shared run's PR carries one section PER
       * HOST rather than the last finisher overwriting every peer's.
       * Defaults to `resolveHostId()` when a caller supplies `report`
       * without it, so no pre-#1179 test fixture (which supplies neither)
       * has to change.
       */
      readonly hostId?: string;
    },
  ): Promise<{
    url?: string;
    error?: string;
    /**
     * What the merge rule needs (tokenmaxxing#29): the class of the diff this
     * PR carries and the exact commit that diff was read at. Absent when the
     * diff could not be read; the PR then simply waits for the owner.
     */
    mergeRule?: { readonly change: ChangeClass; readonly headSha: string };
  }>;
  /**
   * The merge rule (tokenmaxxing#29): wait for the run PR's checks, then merge
   * it when it is a two-way door with a small blast radius and every check is
   * green, or leave it for the owner. Never throws. OPTIONAL like
   * `upsertRunPrReport?`: fixtures that omit it skip the step, which leaves
   * the PR open, the safe side.
   */
  settleRunPr?(
    branch: string,
    change: ChangeClass,
    headSha: string,
  ): Promise<{ readonly merged: boolean; readonly why: string }>;
  /**
   * The pre-merge check before the loop lands its own run PR (spec #1334 fix
   * pass): the project's `landCheck` command on the run branch tip, `headSha`. Run ONCE per
   * run, only when the merge rule would merge — never per ticket (four at a
   * time crashed the server). `ok: false` leaves the PR waiting for the
   * owner, with `why` in the run report. Production's `settleRunPr` calls it
   * just before landing; OPTIONAL so fixtures never run the real check.
   */
  verifyLand?(headSha: string): Promise<{ readonly ok: boolean; readonly why: string }>;
  /**
   * Best-effort: re-fetch the run PR for `branch` and REPLACE its run-report
   * marker section with `report` (issue #1179). Exists as its OWN call,
   * separate from `openRunPr` above, because `openDraftPr` never edits an
   * existing PR's body — without this, a relaunch on the same branch (a
   * second healthy start that finds the first attempt's PR still open)
   * would leave the FIRST run's report frozen in place, describing a run
   * that never finished. Called after `openRunPr` returns, on every finish
   * that opened or found a PR — a fresh PR's body already carries the
   * report from `openRunPr`'s own `opts.report`, so this second write is a
   * same-content no-op there and the only one that matters on a relaunch.
   *
   * `hostId` (issue #1179 review, blocker 4): keys the marker section the
   * same way `openRunPr`'s `opts.hostId` does, so a relaunch on ONE host
   * only ever replaces that host's own section of a shared run's PR.
   *
   * OPTIONAL, matching `reportStop?` above: every pre-#1179 test fixture's
   * `deps` object omits it, and the call site uses
   * `ctx.deps.upsertRunPrReport?.(...)` — an absent implementation is a
   * no-op. Production's `buildDefaultDeps` always provides it.
   */
  upsertRunPrReport?(
    branch: string,
    report: string,
    hostId: string,
  ): Promise<{ readonly updated: boolean; readonly error?: string }>;
  quarantine(issueNum: number, reason: string, opts?: QuarantineOpts): Promise<void>;
  /**
   * Spec #1334, SC — record one failed attempt on the ticket's retry ledger
   * (the `sandcastle:retry-budget` body section) and, when it ends retries,
   * move the ticket from `quarantine` to `waiting-for-session`. A thin
   * pass-through to `recordRetryAttempt` (`lib/state/gh.ts`) in production;
   * its own dep so a scripted run can drive the budget without `gh`.
   *
   * OPTIONAL: absent is a no-op (nothing recorded), like `reportStop?`.
   */
  recordRetryAttempt?(
    issueNum: number,
    attempt: RetryAttempt,
  ): Promise<{ readonly decision: RetryDecision }>;
  /**
   * Spec #1334, SC — the run-start sweep's write for ONE ticket: re-decide on
   * a fresh fetch, then re-queue it (`retry`), move it to
