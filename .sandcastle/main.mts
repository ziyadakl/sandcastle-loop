      // NO label, ever — nothing was held back, so nothing may be filed as a
      // stop (issue #916).
      //
      // AN ALARM, for the systemic verdicts only (2026-08-04 review, blocker
      // 1). A per-ticket red check (a wrong figure, a check naming the wrong
      // screen) stays silent: it is on the issue body, and an alarm per
      // ticket would cost the owner a morning for nothing. `never-settled` /
      // `environment-fault` / `inconclusive` are not per-ticket claims: they
      // mean the app did not boot, or the practice database did not clone
      // tonight. Left silent, a dev server that fails to start ships eight
      // tickets behind eight watch sections and zero alarms, and the owner
      // finds out in the morning. Rate-limited to ONE per run, because the
      // same broken night produces the same verdict on every ticket and forty
      // pushes for one fact is how an alarm channel gets ignored.
      const watchAlarm = screenCheckWatchAlarmGate(opts.verdict);
      if (watchAlarm.alarm) {
        await raiseAlarm(
          {
            title: `Screen check could not grade: ${opts.verdict}`,
            body:
              `issue #${n}: a red screen check is recorded, not a stop, so ` +
              `this ticket shipped anyway — but the check ` +
              `produced no usable evidence at all (${opts.verdict}). That is ` +
              `the app or the environment, not this one ticket, so every ` +
              `other ticket tonight is shipping unchecked too. Only this ` +
              `first one is pushed; the rest are on their own issues and in ` +
              `the run log. ${opts.detail}`,
            issueNumber: n,
          },
          { logError: logErr },
        );
      } else if (isSystemicScreenCheckVerdict(opts.verdict)) {
        logErr(
          `[issue=${n}] screen-check recorded '${opts.verdict}': alarm ` +
            `suppressed, this run has already pushed one (${watchAlarm.suppressedCount} ` +
            `suppressed so far). The verdict is still on the issue body and ` +
            `in this run's telemetry.`,
        );
      }
    },
