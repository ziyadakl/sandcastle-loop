    async openRunPr(branch, shippedIssueNums, opts) {
      if (args.dryRun) {
        dryLog("openRunPr", branch, shippedIssueNums, opts);
        return {};
      }
      try {
        // Push through runGitLease, NEVER runGit: runGit is a synchronous
        // execFileSync with no timeout, and a network push through it can
        // wedge the loop indefinitely. runGitLease carries a 30s cap and a
        // retry classifier that correctly refuses to retry auth failures.
        //
        // MULTI-HOST CAVEAT — read this before diagnosing a rejected push.
        // This push is deliberately NOT forced, so it is rejected outright on a
        // non-fast-forward, and rework telemetry makes that MORE likely than it
        // used to be. Every host on a shared run now commits its own
        // `.sandcastle/telemetry/issues.jsonl` line to the SAME run-branch name
        // every iteration, so two hosts diverge on this branch even when they
        // shipped byte-identical code — the divergence is bookkeeping, not
        // conflicting work. The MERGE side of that is already solved
        // (`.gitattributes` gives the JSONL `merge=union`, which always takes
        // both lines); this PUSH side is not, and is not being papered over
        // with `--force`, because a force here would discard a peer's commits.
        // The correct recovery is to pull/merge the peer's branch (the union
        // driver resolves the JSONL with no conflict) and push again.
        const push = runGitLease(
          args.repoRoot,
          "push",
          "origin",
          `${branch}:refs/heads/${branch}`,
        );
        if (!push.ok) {
          return { error: `push failed: ${push.stderr.trim() || "unknown"}` };
        }

