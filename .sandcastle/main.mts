   */
  publishStatus(snapshotJson: string): Promise<PublishResult>;
  /**
   * Cross-host STATUS SYNC (Task S5) — discover every same-`runId`
   * PEER host's published status snapshot so the caller can fold them into the
   * local status.json. OFF ⇒ `[]` with NO git. Same for --dry-run. NEVER throws:
   * any fault at any step skips the bad peer, worst case returning `[]`.
   */
  fetchStatusPeers(runId: string): Promise<SandcastleStatus[]>;
  /**
   * LAUNCH-TIME REAPER (the reaper fix). Discover any orphaned `agent/issue-<N>`
   * worktree left behind by a HARD-killed prior loop (SIGKILL/OOM/laptop sleep),
   * checkpoint its in-flight WIP to the issue's WIP ref and RELEASE its lease —
   * the exact post-kill reap the graceful `--now` stop performs, now also run at
   * startup so a crashed run's work is rescued before the new loop begins. Wraps
   * {@link checkpointStop} bound to a real git runner in production; tests inject
   * a recorder. Called BEFORE startup label/lease reconciliation so WIP is saved
   * before the reconcile frees the issue for re-claim. Best-effort + NON-FATAL:
   * the caller wraps it so a fault only logs and never blocks the loop starting.
   * NO-OP on a clean launch — discovery returns empty when no agent worktrees
   * survive, so a normal start does no git work. The call is deliberately NOT
   * gated on a prior-status liveness probe: the single-instance lock acquired
   * above already proves no live loop of ours is running, and a reused PID that
   * probes "alive" must never suppress a real rescue (see the DEFECT-4 note at
   * the call site). Inert under `--dry-run`.
   */
  checkpointInflight(): Promise<readonly CheckpointStopResult[]>;
  /**
   * Spec #1368 decision 2 — remove the sandbox containers a dead run left at
   * loop start (they keep the agent's secrets, stopped or not), unless another
   * loop runs on this server. Production adapter: `lib/containers/sweep.ts`.
   * Skipped by `runMain` under --dry-run. Container environments are never
   * read or logged.
   */
  sweepLeftoverContainers(): Promise<LeftoverContainerResult>;
  /**
   * Spec #1368 decision 6 — stamp why a dead run's in-flight tickets stopped,
   * and publish the stamped snapshot to the dashboard. Resolves to the issue
   * numbers stamped. Production adapter: `lib/status/stop-cause-stamper.ts`.
   * Skipped by `runMain` under --dry-run.
   */
  stampStopCauses(): Promise<readonly number[]>;
  /**
   * Save a failed fixer's work to the ticket's WIP ref (spec #1334 fix pass),
   * so the ticket's next attempt resumes it rather than starting over — with
   * cross-host sync on; with it off the ref is kept locally, for recovery by
   * hand only (see `saveWorkToWipRef`'s doc comment for why). Wraps
   * `saveWorkToWipRef` (`lib/state/branch-checkpoint.ts`) in production.
   * OPTIONAL: absent saves nothing. Inert under `--dry-run`. Never throws.
   */
  saveFailedWork?(
    worktreePath: string,
    issueNumber: number,
  ): Promise<{ readonly saved: boolean; readonly detail: string }>;
  /** Logger (info-level). Tests inject a recorder; production logs to stderr. */
  log(line: string): void;
  /** Logger (error-level). */
  logError(line: string): void;
  /**
   * Optional per-ticket-attempt hook, fired by each worker right before it
   * asks the dealer for a card (#902: was `iterationStartHook`, fired once
   * per ROUND — the rolling pool has no rounds, so this fires once per
   * ATTEMPT instead, `ordinal` counting up across the whole run). Production
   * wires this to `undefined`. Tests use it to inject mid-run filesystem
   * mutations, or a SIGTERM, so a code path can be exercised without a real
   * recovery agent or operator interrupt.
   */
  ticketStartHook?: (ordinal: number) => void | Promise<void>;
  /**
   * The account pool's allowance state and the clock the loop waits on when
   * every pooled login is out (tokenmaxxing build plan 4.5, `lib/allowance.ts`).
   * `readAuthFiles` reads the pool's `GET /v0/management/auth-files`;
   * undefined when the loop is not on the pool. OPTIONAL so a test `deps`
   * that omits it gets the real clock and no pool reads. Production's
   * `buildDefaultDeps` always provides it.
   */
  poolAllowance?: PoolAllowanceDeps;
}

/** See {@link Deps.poolAllowance}. */
export interface PoolAllowanceDeps {
  readonly readAuthFiles?: () => Promise<unknown>;
  readonly now: () => number;
  readonly sleep: (ms: number) => Promise<void>;
}

const REAL_ALLOWANCE_CLOCK: PoolAllowanceDeps = {
  now: () => Date.now(),
  sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
};

export interface RunMainResult {
  /**
   * Process exit code: 0 / 1 / 2 per the spec, 3 for a sandbox-health
   * stall-streak abort (distinct from 2's clean out-of-iterations), or 75
   * for hot-reload restart.
   */
  exitCode: 0 | 1 | 2 | 3 | 75;
  /** Iterations completed (1-indexed; 0 means we exited before the first cycle). */
  iterationsRun: number;
  /**
   * Counters useful for tests. NOTE: `shippedIssues` means "reviewer-certified
   * this run" — NOT "landed on the integration branch". Under staging an issue
   * is pushed here at ship time but may still strand at the final fast-forward,
   * so do not treat membership as proof the code shipped. Authoritative
   * shipped/merged state lives in the status feed (`totals.merged`, per-issue
   * phase) and the git branch — not this counter.
   */
  shippedIssues: number[];
  quarantinedIssues: number[];
}

