      return await verifyProjectLint(exec);
    },
    async checkTestCert(repoRoot, preSha, postSha) {
      // Pure I/O: gather the two inputs, then delegate every status decision
      // to the pure `classifyTestCert` (directly unit-tested, including the
      // fail-quiet git-hiccup branch). An empty postSha can't be `git show`n,
      // so the message reads as null there — classifyTestCert maps it to
      // dormant either way. 1:1 mirror of the checkLintCert impl above.
      const hasTest = hasTestScript(repoRoot);
      let message: string | null = null;
      if (postSha !== "") {
        const msg = runGit(repoRoot, "show", "-s", "--format=%B", postSha);
        message = msg.ok ? msg.stdout : null;
      }
      return classifyTestCert(hasTest, preSha, postSha, message);
    },
    async verifyTestRun(worktreePath, changedFiles, exec) {
      // No worktree (a mock/legacy sandbox handle) means there is no tree to
      // resolve scope against. That is "could not verify", never "verified
      // clean".
      if (worktreePath === undefined) {
        return { status: "inconclusive", reason: "no worktree path available" };
      }
      // No exec means no way to reach the environment the dependencies live in.
      // Deliberately NOT a fallback to a host-side run: on the docker path the
      // host cannot execute that worktree's `node_modules` at all, so a
      // fallback would produce a confident-looking result that is really just
      // the platform mismatch in disguise. Better to say we could not verify.
      if (exec === undefined) {
        return {
          status: "inconclusive",
          reason: "sandbox does not expose command execution",
        };
      }
      // ABSENT ≠ ZERO, the same rule `shouldRecordDiffMeasurement` applies to
      // the measurement this list comes from. `reviewDiffStats` is fail-quiet:
      // a git hiccup and a genuinely empty diff both return `{0, []}`. An empty
      // list here would resolve to an empty scope and report `dormant`, and the
      // ticket would ship on the unverified cert — the gate silently switching
      // itself off on exactly the git failures it can't see. We cannot verify
      // what we cannot scope, so this is inconclusive.
      if (changedFiles.length === 0) {
        return {
          status: "inconclusive",
          reason: "no changed paths to scope the run to (diff unavailable)",
        };
      }
      // Scope is resolved against the WORKTREE, not `args.repoRoot`: the
      // worktree is the tree that holds the shipped code, and on a resume its
      // workspace layout can differ from the launch checkout's. This is a
      // host-side read of `pnpm-workspace.yaml` + `package.json` files, which
      // is safe on any platform — they are text, not binaries, and the docker
      // path bind-mounts the very same files the container sees.
      const scope = resolveTestScope(worktreePath, changedFiles);
      if (scope.workspaceDiscovered === 0) {
        // Discovery found no packages AT ALL — the workspace file is missing or
        // unparseable, not "this diff is package-free". Reporting dormant here
        // would silently switch the gate off for the whole repo.
        return {
          status: "inconclusive",
          reason:
            "no workspace packages discovered (workspace file unreadable)",
        };
      }
      if (scope.packages.length === 0) {
        return {
          status: "dormant",
          reason: `no test-bearing package in scope (${scope.unresolved.length} path(s) outside any package, ${scope.skipped.length} package(s) with no test script)`,
        };
      }
      // Bounded twice over inside `runScopedTests` — a per-package timeout the
      // sandbox itself enforces and an overall wall-clock ceiling the module
      // owns, so this call site cannot forget to bound it. The gate can neither
      // hang the loop nor outlive that ceiling.
      const names = scope.packages.map((p) => p.name).filter((n) => n !== "");
      // A package with no `name` in its manifest cannot be `--filter`ed, so it
      // is dropped — but SAID, not dropped silently. A nameless manifest is
      // broken, and a quietly-shrunken scope reads in the log exactly like a
      // scope that was always that size.
      const nameless = scope.packages.length - names.length;
      const { verdict } = await runScopedTests(exec, names);
      const scopeNote =
        nameless > 0
          ? ` [scope: ${names.join(", ")}; ${nameless} package(s) skipped — no name in manifest]`
          : ` [scope: ${names.join(", ")}]`;
      return { status: verdict.status, reason: `${verdict.reason}${scopeNote}` };
    },
    async captureSha(worktreePath) {
      try {
        return execFileSync("git", ["rev-parse", "HEAD"], {
          cwd: worktreePath,
          encoding: "utf8",
          stdio: ["ignore", "pipe", "ignore"],
        }).trim();
      } catch {
        return "";
      }
    },
    async runScreenCheckHarness(opts) {
      // #972 gap 1 — MINT A FRESH NONCE FOR THE SHIP-TIME RE-RUN.
      //
      // `checkCommand` arrives here as an already-BUILT string, persisted by the
      // check-writer stage with the must-fail-first proof's nonce baked into its
      // report path (`--outputFile` for vitest, `PLAYWRIGHT_JSON_OUTPUT_FILE`
      // for Playwright). The check imports real product code, so
      // builder-authored code runs inside the check's process — and replaying
      // the proof's nonce hands that code the exact report path the ship verdict
      // is read from. `buildCheckCommand`'s contract is one fresh nonce PER RUN,
      // so this re-run mints its own.
      //
      // A FRESH nonce is only safe PAIRED WITH A REBUILT COMMAND: the rebuilt
      // command writes its report under the fresh nonce, and the evidence is
      // read under the same nonce. A fresh nonce on the OLD command would key the
      // evidence to a value the command never writes under — every check would
      // read inconclusive, the gate silently switching itself off. So we rebuild
      // via `rebuildCheckCommandFor` from the check's own location (the same pure
      // rebuilder a first-test rewrite's green run uses), and only when both the
      // location and the worktree are in hand.
      //
      // FALLBACK, fail-closed: with no location (every test double, any caller
      // that ran no check-writer stage) or a rebuild that cannot resolve its
      // package, we replay the recovered nonce — precisely today's behaviour.
      // A command carrying no report path yields `""`, which `isSafeCheckNonce`
      // refuses, so the verdict is `inconclusive`, never a false green.
      const { command: runCommand, nonce: runNonce } = shipTimeRunCommand({
        checkCommand: opts.checkCommand,
        location: opts.location,
        checkPackage: opts.checkPackage,
        worktreePath: opts.worktreePath,
      });
      const check = await runHarnessScreenCheck(
        opts.kind,
        opts.exec,
        runCommand,
        runNonce,
        // Scaled by scenario count (issue #1176): `opts.testCount` undefined
        // (every test double, any caller that could not count) is
        // byte-identical to `CHECK_TIMEOUT_BUDGET_MS[kind]`, the prior
        // behaviour — `scaledCheckTimeoutBudgetMs` treats a missing count as
        // one scenario.
        scaledCheckTimeoutBudgetMs(opts.kind, opts.testCount),
        // PERSIST WHAT ACTUALLY HAPPENED, per attempt. Until this landed, the
        // one step that opens a browser and decides the ticket's fate was the
        // only one in the pipeline leaving no artifact at all: #803 stopped
        // `stopped:no-failing-check` and the stop report had to offer the owner
        // three possible causes because nothing on disk could distinguish them.
        // Skipped entirely when the caller did not say which per-issue branch
        // this is — a file named after the wrong branch is worse than no file.
        opts.sandboxBranch === undefined
          ? undefined
          : {
              repoRoot: args.repoRoot,
              branch: opts.sandboxBranch,
              issueNumber: opts.issueNumber,
              phase: "ship" as const,
              worktreePath: opts.worktreePath,
              onError: logErr,
            },
        // Issue #1176, finding 3: keeps the stall watchdog's progress clock
        // fresh across a genuine second attempt — see `runHarnessScreenCheck`'s
        // own `onAttempt` doc comment. `opts.onAttempt` is the caller's own
        // `ctx.status.noteProgress()`, threaded through rather than reached
        // for here, since this closure (built by `buildDefaultDeps(args)`)
        // has no `ctx`/`StatusStore` of its own.
        opts.onAttempt,
      );
      const whenIso = new Date().toISOString();

      // The receipt is only ever expected when Playwright actually produced
      // a real, classified result (any verdict but "inconclusive" — Piece
      // G's "the browser never rendered the page, so no picture was ever
      // taken" case). `graded-screen-check.ts`'s helper takes the
      // screenshot at a fixed, predictable path so the harness can find it
      // without depending on what any individual check happens to do.
      //
      // NEVER on the unit route (issue #956): vitest opens no browser, so there
      // is no picture and its absence is not a fault. Said with a `kind` test
      // rather than left to the `existsSync` below to come back false, because
      // "there was never going to be one" and "there should have been one and
      // it is missing" are different facts, and only the second is worth a
      // reader's attention.
      const pictureExpected =
        opts.kind === "browser" && check.verdict.verdict !== "inconclusive";
      let pictureStored = false;
      let pictureLink: string | undefined;

      if (pictureExpected && opts.worktreePath !== undefined) {
        const screenshotPath = path.join(
          opts.worktreePath,
          // `<package dir>/test-results/screen-check`, where the package dir
          // holds the e2e folder that holds the checks root.
          path.posix.dirname(path.posix.dirname(checksRoot())),
          "test-results/screen-check",
          `issue-${opts.issueNumber}.png`,
        );
        if (existsSync(screenshotPath)) {
          const slug = (opts.screen ?? "screen")
            .replace(/^\/+/, "")
            .replace(/[^a-zA-Z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "")
            .slice(0, 80) || "screen";
          const key = `${opts.branch}/issue-${opts.issueNumber}/${slug}.png`;
          const stored = await storeScreenCheckPicture({
            localPath: screenshotPath,
            key,
            env: pictureStoreEnvFromProcess(),
          });
          if (stored.stored) {
            pictureStored = true;
            pictureLink = stored.key;
          } else {
            // Piece G: a picture that was TAKEN but could not be FILED must
            // not stop the ticket — only mark it and shout, once.
            await raiseAlarm(
              {
                title: "Screen-check picture not stored",
                body: `issue #${opts.issueNumber}: a browser opened ${opts.screen ?? "(screen not stated)"} and the check was graded, but the receipt picture could not be filed — ${stored.reason}`,
                issueNumber: opts.issueNumber,
              },
              { logError: logErr },
            );
          }
        }
      }

      // Piece E/F says a never-settled verdict "trips the alarm" — the app is
      // broken for everyone that night, not this ticket's fault. It is NOT
      // alarmed here. A never-settled verdict stops the ticket, which reports
      // `stopped:could-not-grade`, which is in LOUD_STOP_REASONS, which raises
      // the alarm in `reportStop` above — the ONE place that owns "a loud stop
      // makes a noise", shared by all three loud labels. Raising it here as
      // well produced two alarms for one event, which is how an alarm channel
      // becomes the thing people learn to ignore.

      // Both runs' outcomes, in the run log, whenever there WAS a second run.
      // The final verdict is the more-evidenced of the two attempts, not
      // automatically the second one (`moreEvidencedVerdict`), so a re-run is
      // now a CHOICE between two observations that can genuinely disagree —
      // and a choice nobody can see is a choice nobody can audit. The durable
      // half of the same story rides on `record.attemptVerdicts` below to
      // `.sandcastle/telemetry/issues.jsonl`; this half is for whoever is
      // reading the run log of a ticket that stopped overnight.
      if (check.rerun) {
        const trail = check.attempts
          .map(
            (attempt, i) =>
              `attempt ${i + 1} ${attempt.verdict.verdict} — ${attempt.verdict.reason}`,
          )
          .join("; ");
        log(
          `[issue=${opts.issueNumber}] screen-check re-ran once: ${trail}; ` +
            `kept ${check.verdict.verdict} — the more-evidenced of the two, ` +
            `not automatically the later one`,
        );
      }

      // Issue #1025: the database(s) THIS graded run announced, read off the
      // harness run's own combined output — every attempt, unioned — so the ship
      // funnel can set it beside the clone the loop minted. This is the
      // load-bearing channel the review demanded (the harness output the grade
      // is read from), not the implementer agent's assistant text.
      const observedDatabases = parseObservedDatabases(
        check.attempts.map((a) => a.output).join("\n"),
      );
      return {
        verdict: check.verdict.verdict,
        reason: check.verdict.reason,
        rerun: check.rerun,
        observedDatabases,
        record: {
          screen: opts.screen,
          verdict: check.verdict.verdict,
          whenIso,
          rerun: check.rerun,
          pictureLink,
          pictureStored,
          attemptVerdicts: check.attempts.map((a) => a.verdict.verdict),
        },
      };
    },
    // Cross-host issue lease: the five lease methods come from the
    // createLeaseCoordinator factory above (extracted to lib/state/issue-lease.ts).
    // Spread here so the returned Deps shape is unchanged.
    ...leaseCoord,
    async syncLanes(branch, launchWorktreePath) {
      // OFF ⇒ byte-for-byte no-op: NO fetch/ls-remote/merge. Same for --dry-run.
      if (!syncEnabled) return { peers: [] };
      if (args.dryRun) {
        dryLog("syncLanes", branch, launchWorktreePath);
        return { peers: [] };
      }
      // Never throws on fetch-fail / conflict — results carry the per-peer
      // status for the loop to log + continue on the un-synced tip.
      return laneSync.syncInto(branch, launchWorktreePath);
    },
    async publishLane(branch) {
      // OFF ⇒ no-op with NO push. Same for --dry-run.
      if (!syncEnabled) return;
      if (args.dryRun) {
        dryLog("publishLane", branch);
        return;
      }
      // Throws LaneSyncError on a real push fault — the loop surfaces it LOUD.
      await laneSync.publish(branch);
    },
    async publishStatus(snapshotJson) {
      // OFF ⇒ no-op success with NO git. Same for --dry-run.
      if (!syncEnabled) return { ok: true };
      if (args.dryRun) {
        dryLog("publishStatus");
        return { ok: true };
      }
      // Fail-soft inside the module: never throws, returns {ok:false,error}.
      return statusSync.publish(snapshotJson);
    },
    async fetchStatusPeers(runId) {
      // OFF ⇒ no peers with NO git. Same for --dry-run.
      if (!syncEnabled) return [];
      if (args.dryRun) {
        dryLog("fetchStatusPeers", runId);
        return [];
      }
      // Fail-soft inside the module: never throws, worst case returns [].
      return statusSync.fetchPeers(runId);
    },
    async saveFailedWork(worktreePath, issueNumber) {
      if (args.dryRun) {
        dryLog("saveFailedWork", worktreePath, issueNumber);
        return { saved: false, detail: "dry run" };
      }
      return await saveWorkToWipRef(
        {
          repoRoot: args.repoRoot,
          wtPath: worktreePath,
          issue: issueNumber,
          hostId: resolveHostId(),
          pushToOrigin: crossHostSyncEnabled(),
        },
        makeExecFileGitRunner(),
      );
    },
    // Spec #1368 decisions 2 and 6. runMain skips both under --dry-run.
    sweepLeftoverContainers,
    stampStopCauses: makeStopCauseStamper({
      repoRoot: args.repoRoot,
      logError: (line) => logErr(`[startup] ${line}`),
    }),
    async checkpointInflight() {
      // DEFECT 2: INERT under --dry-run, mirroring every sibling dep
      // (release/publishStatus/syncLanes). A dry run must touch NO git — no
      // commit into a worktree, no WIP push, no lease delete — so we
      // short-circuit BEFORE discovery and return []. Logs one `[dry-run]` line
      // like its siblings.
      if (args.dryRun) {
        dryLog("checkpointInflight");
        return [];
      }
      // Launch-time reaper: bind the proven post-kill `checkpointStop`
      // to a real git runner and the current run's config, mirroring the thin
      // `scripts/checkpoint-stop.mts` runner (same hostId + integration-branch
      // resolution). `integrationBranch` is the run branch — commits a surviving
      // worktree has that the run branch does not are the rescued WIP, exactly
      // what the `--now` skill passes as `--integration-branch <run-branch>`.
      // `stagingBranch: null` SKIPS the certified-but-unpromoted staging strand
      // backup — that is the graceful `--now` stop's job (it runs when no agent
      // is active); the launch-time reaper only rescues per-issue worktrees.
      // Because the reaper runs at EVERY launch, its origin writes MUST honor
      // the inertness contract (a flag-off single-host consumer pushes
      // nothing new): `wipOriginPush: "when-sync"` captures each crashed WIP to a
      // LOCAL ref always and pushes it to origin only when `syncEnabled` — unlike
      // the graceful `--now` stop, which pushes unconditionally by default. The
      // lease DELETE is separately gated by `canReleaseLease` below (false when
      // lease-mode is off), so no origin write escapes when the flags are off.
      return checkpointStop(makeExecFileGitRunner(), {
        repoRoot: args.repoRoot,
        hostId: resolveHostId(),
        integrationBranch: args.branch,
        remote: "origin",
        stagingBranch: null,
        syncEnabled: crossHostSyncEnabled(),
        // Launch-time reaper: local WIP capture always, origin push only when
        // sync is on. The `--now` stop keeps the default
        // "always" push, so its behavior is byte-for-byte unchanged.
        wipOriginPush: "when-sync",
        // DEFECT 1: never yank a lease a PEER currently holds LIVE. Unlike the
        // graceful `--now` stop (whose leases are its own host's), the launch-
        // time reaper runs after a CRASH — this host's lease may have expired
        // and been re-claimed by a peer that is now actively working the issue,
        // so deleting `refs/locks/issue-<N>` here would strand the peer's work.
        // Release ONLY when the lease is NOT live. With lease-mode OFF there is
        // no lock ref at all, so releasing is pointless — return false and skip
        // the delete (DEFECT 5). WIP capture still runs regardless of this
        // guard, so the crashed work is always rescued.
        //
        // `leaseState` is TTL-based and owner-blind: it cannot tell a PEER's
        // live lease from THIS host's own crashed-but-not-yet-expired lease, so
        // a fast crash+restart within TTL reads "live" and leaves our own lock
        // ref standing until it lapses. That is intentional and harmless — the
        // single-instance lock guarantees we (and only we) will re-process the
        // issue, so a bounded wait for TTL expiry costs nothing and beats the
        // risk of yanking a real peer. Same conservative choice startup
        // reconciliation already makes (`st === "live"` → skip).
        canReleaseLease: async (issue) =>
          leaseEnabled && (await leaseCoord.leaseState(issue)) !== "live",
      });
    },
    log,
    logError: logErr,
    // Build plan 4.5: the pool's per-login state, read at the same address the
    // agents use. `loadDotenv` has already run, and it takes ANTHROPIC_BASE_URL
    // only from the sandcastle settings files.
    poolAllowance: {
      ...REAL_ALLOWANCE_CLOCK,
      readAuthFiles: poolAuthFilesReader({
        baseUrl: process.env.ANTHROPIC_BASE_URL,
      }),
    },
  };
  return deps;
}

/**
 * `parseBlockedBy` MOVED to `lib/state/blocked-by.ts` on 2026-09-03, alongside
 * `unresolvedBlockers` — the rule it feeds. Re-exported here because it was
 * exported from this module before, and because `buildBlockedByNote` below
 * still uses it for the advisory "nothing claimable" exit note.
 *
 * ⚠️ It IS part of the blocker gate now. It was not until 2026-09-03:
 * enforcement lived only in a planner PROMPT, and the planner misread #1065's
 * own first line — `Blocked-by: #1038` — and dealt it while #1038 was open in
 * the same refill. `eligibleForPlanning` now builds the plan from this rule,
 * and `blockedByGate` below re-checks every card again at deal time.
 */
export { parseBlockedBy };

/**
 * Build the "(note: …)" suffix for the "no claimable issues" exit (Issue E)
 * on the ONE road that never planned: `--issue N`, which bypasses planning
 * entirely. Every other road reads `lastPlanExclusions` through
 * {@link buildEligibilityNote} instead — the plan's own list, so the message
 * and the decision are one reading rather than two.
 *
 * Given the full set of open issues, find those carrying `readyLabel` whose
 * body declares `Blocked by: #N` for an `N` that is still unresolved. Without
 * this the operator can't tell "nothing ready" from "everything ready is
 * blocked".
 *
 * ⚠️ ONE READING OF THE RULE, on BOTH axes.
 *
 * The BLOCKER axis: this used to resolve blockers by open-set membership
 * ALONE, which is a DIFFERENT rule from the gate's — the loop stops a finished
 * ticket at `shipped-local` and leaves it open, so a blocker that is
 * done-and-merged-to-the-run-branch still counted as "open" here. The note
 * therefore told the operator a ticket was blocked at the very moment the gate
 * was happily dealing it. It calls {@link unresolvedBlockers} now — the same
 * function the gate calls.
 *
 * The QUEUE-LABEL axis, closed on the same terms: this hardcoded
 * `ready-for-agent` in both the filter and the wording while
 * `eligibleForPlanning` honoured `--label`, so a run on a different queue
 * label got a note about a queue it was not reading. `readyLabel` defaults to
 * {@link LABEL_READY} for the unit tests and any caller that has no args; the
 * one production call site passes `args.label`. The wording is
 * `buildEligibilityNote`'s — "#N is ready but …" — so the two notes read the
 * same whichever road produced them, and neither names a label that may be
 * wrong.
 *
 * Returns `""` when nothing ready is blocked; the caller then keeps the plain
 * exit message.
 *
 * Exported for unit testing.
 */
export function buildBlockedByNote(
  openIssues: readonly {
    number: number;
    body: string;
    labels: readonly string[];
  }[],
  readyLabel: string = LABEL_READY,
): string {
  const notes: string[] = [];
  const ready = openIssues
    .filter((i) => i.labels.includes(readyLabel))
    .sort((a, b) => a.number - b.number);
  for (const issue of ready) {
    const blockers = unresolvedBlockers(issue.body, openIssues);
    if (blockers.length === 0) continue;
    notes.push(
      `#${issue.number} is ready but ${describeUnresolvedBlockers(
        blockers,
        openIssues,
      )}`,
    );
  }
  return notes.length === 0 ? "" : ` (note: ${notes.join("; ")})`;
}

/**
 * THE BLOCKED-BY GATE (2026-09-03). Deterministic, host-side, run over every
 * planner pick before it is dealt — and again at deal time, because a card can
 * sit in the dealer's stack for hours while its blocker is still building.
 *
 * Why it STILL exists now that the plan itself is computed from the same rule
 * (`planDeterministic`, `lib/state/eligible-set.ts`): a card can sit on the
 * dealer's stack for HOURS between being planned and being picked up, and its
 * blocker's label can flip in that window — `shipped-local` back to
 * `in-progress` on a re-open, or a fresh blocker landing in the body. The plan
 * is a snapshot; this is the re-read at the moment of use.
 *
 * ONE `gh` round-trip: `listOpenIssuesWithBodies()` returns number + labels +
 * body for every open issue, which is both halves of the rule — the pick's own
 * declaration and the blockers' labels — so no second fetch is needed.
 *
 * FAILS CLOSED, ON EVERY ROAD. A pick is skipped when it is blocked, when the
 * listing could not be fetched, when the listing came back at its `--limit`
 * cap without the pick in it, and when the pick is simply not in a listing
 * that was NOT capped. That last one deserves saying out loud: the pick came
 * out of an open `ready-for-agent` listing moments earlier, so its absence
 * from the open set is an instrument disagreeing with itself, not evidence the
 * ticket closed — and nothing downstream re-checks blockers (lease acquisition
 * does not read a body). Skipping costs nothing: the issue keeps
 * `ready-for-agent` and is re-evaluated on the next refill or deal.
 *
 * ⚠️ SKIPPING IS NOT THE WHOLE ANSWER when the fetch itself failed. Skipping
 * every pick empties the plan; an empty plan drains the dealer; a drained
 * dealer with nothing in flight ends the run — and the run then reported
 * `done` / exit 0, "no claimable issues — exiting cleanly". A broken
 * instrument would have read to a person as a quiet, healthy night. That is
 * the identical failure {@link ELIGIBLE_SET_FAILURE} exists to stop on the
 * planning road. So the fetch is retried once after a short
 * backoff, and a second failure is reported as {@link BlockedByGateResult.
 * unreadable} — which the PLAN-time caller turns into a loud throw and the
 * DEAL-time caller into a run-level flag that forces an unhealthy, non-zero
 * exit. The dispatch decision stays "skip"; only the run's VERDICT changes.
 *
 * Exported for unit testing.
 */
export interface BlockedByGateResult {
  /** Issue number → the reason it must NOT be dealt. Absent = clear to deal. */
  readonly skips: ReadonlyMap<number, string>;
  /**
   * TRUE only when the gate COULD NOT SEE — the open-issue fetch failed twice.
   * Distinct from a full map of genuine blocks, which is a healthy answer. A
   * run must never be reported complete on the strength of this.
   */
  readonly unreadable: boolean;
  /** The fetch error behind `unreadable`, for the log and the stop message. */
  readonly failure?: string;
}

/** Grep handle for the fail-loud plan-time throw, twin of ELIGIBLE_SET_FAILURE. */
const BLOCKED_BY_GATE_FAILURE = "BLOCKED_BY_GATE_FAILURE";

/**
 * Grep handle for the fail-loud throw on the PLANNING road (2026-09-03), the
 * same discipline as `BLOCKED_BY_GATE_FAILURE` above it.
 *
 * The planner is code now (`planDeterministic`, `lib/state/eligible-set.ts`),
 * and code that cannot read the open-issue listing has no candidates — which
 * is byte-identical, from the dealer's point of view, to a genuinely empty
 * queue. Left silent, that drained the pool, wrote `done`, exited 0 and told a
 * person "no claimable issues — exiting cleanly" on the strength of a `gh`
 * outage. So the planning road throws instead.
 */
const ELIGIBLE_SET_FAILURE = "ELIGIBLE_SET_FAILURE";

/** Backoff between the two fetch attempts. Short: a worker is waiting. */
const BLOCKED_BY_GATE_RETRY_MS = 2_000;

/**
 * Read the open-issue listing, retrying ONCE after a short backoff.
 *
 * `runGh` throws on the first failure with no retry of its own (unlike
 * `transitionLabel`, which wraps its writes in `withRetry`), and the
 * overwhelmingly common failure here is a transient one — a network blip, GH
 * rate-limit jitter, an intermittent auth lookup. Ending a night's work on the
 * first hiccup would be its own bug; retrying forever would hide a real outage.
 *
 * ONE definition, two readers: the planner ({@link runMain}'s
 * `readOpenIssuesForPlanning`) and {@link blockedByGate}. They must spend the
 * same number of attempts, because a run where one of them gives up sooner
 * than the other reports a mixture of "blocked" and "blind" that nobody can
 * untangle from a log. Neither throws from here — each caller decides what its
 * own blindness means.
 */
type OpenIssueListing = Awaited<ReturnType<Deps["listOpenIssuesWithBodies"]>>;

async function readOpenIssuesTwice(
  fetchOpen: () => Promise<OpenIssueListing>,
  logError: (line: string) => void,
  opts: {
    /** Log prefix, so a reader can tell which caller went blind. */
    readonly tag: string;
    /** Test seam: a no-op sleep, so the retry costs no wall-clock in tests. */
    readonly sleep?: (ms: number) => Promise<void>;
    readonly retryDelayMs?: number;
  },
): Promise<{ readonly open?: OpenIssueListing; readonly lastError: string }> {
  const delayMs = opts.retryDelayMs ?? BLOCKED_BY_GATE_RETRY_MS;
  const sleep =
    opts.sleep ??
    ((ms: number): Promise<void> =>
      new Promise((resolve) => setTimeout(resolve, ms)));
  let lastError = "";
  for (let attempt = 1; attempt <= 2; attempt += 1) {
    try {
      return { open: await fetchOpen(), lastError };
    } catch (err) {
      lastError = (err as Error).message;
      if (attempt === 1) {
        logError(
          `${opts.tag} open-issue fetch failed: ${lastError} — retrying ` +
            `once in ${delayMs}ms`,
        );
        await sleep(delayMs);
      }
    }
  }
  return { lastError };
}

export async function blockedByGate(
  issueNumbers: readonly number[],
  deps: Pick<Deps, "listOpenIssuesWithBodies" | "logError">,
  opts: {
    /**
     * Where the open-issue listing comes from. Defaults to a direct
     * `deps.listOpenIssuesWithBodies()`; `runMain` passes the run-scoped memo
     * (`lib/state/open-issue-memo.ts`) so the plan-time sweep and the per-card
     * deal-time checks seconds later share ONE round-trip instead of nine.
     */
    readonly fetchOpen?: () => Promise<
      Awaited<ReturnType<Deps["listOpenIssuesWithBodies"]>>
    >;
    /** Test seam: a no-op sleep, so the retry costs no wall-clock in tests. */
    readonly sleep?: (ms: number) => Promise<void>;
    readonly retryDelayMs?: number;
  } = {},
): Promise<BlockedByGateResult> {
  const skips = new Map<number, string>();
  if (issueNumbers.length === 0) return { skips, unreadable: false };
  const fetchOpen =
    opts.fetchOpen ?? ((): Promise<OpenIssueListing> =>
      deps.listOpenIssuesWithBodies());
  const named = issueNumbers.map((n) => `#${n}`).join(", ");

  // ONE retry, then give up — see `readOpenIssuesTwice` for why.
  const { open, lastError } = await readOpenIssuesTwice(
    fetchOpen,
    deps.logError,
    {
      tag: "[blocked-by gate]",
      sleep: opts.sleep,
      retryDelayMs: opts.retryDelayMs,
    },
  );
  if (open === undefined) {
    deps.logError(
      `[blocked-by gate] open-issue fetch failed twice: ${lastError} — ` +
        `skipping ${named} (fail closed; they stay ${LABEL_READY}). The gate ` +
        `is BLIND, not clear: this run must not be reported as a healthy ` +
        `completion.`,
    );
    for (const n of issueNumbers) {
      skips.set(n, `blocker check could not run (${lastError})`);
    }
    return { skips, unreadable: true, failure: lastError };
  }

  // A listing that came back AT its cap may be missing rows, so "not in the
  // list" stops meaning "closed" and starts meaning "cannot see it" — for the
  // PICK below and, just as importantly, for every BLOCKER it declares
  // (`listingTruncated`, `lib/state/blocked-by.ts`). The PLAN-time road halts
  // outright on a capped listing (`ELIGIBLE_SET_FAILURE`, `runMain`); this
  // deal-time gate does not need to halt because it can simply refuse to clear
  // what it cannot read.
  const truncated = open.length >= GH_OPEN_ISSUE_LIST_LIMIT;
  const rowsByNumber = new Map(open.map((i) => [i.number, i]));
  for (const n of issueNumbers) {
    // A plan entry whose id is not an issue number at all (`Number("not-an-
    // issue")` → NaN) is NOT this gate's business, and swallowing it here as
    // "missing from the listing" would be a downgrade: the dispatch pool has
    // its own guard that refuses such an entry LOUDLY, by name, and it can
    // only do that if the entry reaches it.
    if (!Number.isInteger(n) || n <= 0) continue;
    const row = rowsByNumber.get(n);
    if (row === undefined) {
      skips.set(
        n,
        truncated
          ? `its body could not be read (the open-issue listing came back at ` +
              `its ${GH_OPEN_ISSUE_LIST_LIMIT}-row cap and #${n} was not in it)`
          : `its body could not be read (#${n} was not in the open-issue ` +
              `listing at all, though the plan had just picked it out of an ` +
              `open ${LABEL_READY} listing — the two views disagree)`,
      );
      continue;
    }
    const unresolved = unresolvedBlockers(row.body, open, {
      listingTruncated: truncated,
    });
    if (unresolved.length > 0) {
      skips.set(n, describeUnresolvedBlockers(unresolved, open));
    }
  }
  return { skips, unreadable: false };
}

// ---------------------------------------------------------------------------
// Per-issue pipeline
// ---------------------------------------------------------------------------

interface IssueOutcome {
  /** "ok" => marked done; "quarantined" => label flipped to needs-human;
   *  "error" => unhandled and not yet quarantined (caller decides);
   *  "deferred" => transient rate-limit, label flipped back to ready-for-agent
   *  for retry next iteration. */
  status: "ok" | "quarantined" | "error" | "deferred";
  /** Marker that ended the pipeline ("ALL_CLEAR" / "HALT" / etc), if any. */
  finalMarker?: string;
  /** Most recent commit SHA on the branch, if any. */
  postSha?: string;
  /** Skills invoked by the implementer attempt whose code actually shipped
   *  (the one whose commits are now on the branch the merger picks up).
   *  Empty for non-"ok" outcomes and for already-built work no build pass
   *  touched. Surfaced to the post-merge reviewer as information — a missing
   *  record never fails the rollup (spec #1334, SG). */
  skillsInvoked?: readonly string[];
  /** True when the pipeline failed because an SDK call exceeded its idle
   *  timeout or the host's wall-clock hard ceiling fired. Surfaces stall-
   *  shaped failures to runMain's sandbox-health detector — a streak of
   *  iterations where every outcome is `stalled` indicates the sandbox
   *  itself is sick (orbstack memory pressure, docker degraded, etc.)
   *  and the loop should pause for operator intervention rather than
   *  burning more tokens. */
  stalled?: boolean;
}

/**
 * The issues whose freshly-built branches Phase 3 merges this cycle: the `"ok"`
 * outcomes, MINUS the #1110 case-2 auto-close, which reports `"ok"` for the
 * ship accounting but built no branch (its code was already certified on
 * `integration-candidate` by a prior run). Including it would drag its empty
 * per-issue branch through the merger, re-churn its `shipped-local` label, and
 * couple it to the promotion fence and a sibling's batch-failure quarantine —
 * two real bugs. This is the single seam that keeps it out; unit-tested
 * directly so the exclusion cannot silently regress.
 */
export function selectMergeBatch<I>(
  completed: readonly {
    issue: I;
    outcome: { status: string; finalMarker?: string };
  }[],
): I[] {
  return completed
    .filter(
      (c) =>
        c.outcome.status === "ok" && !builtNothing(c.outcome.finalMarker),
    )
    .map((c) => c.issue);
}

/**
 * Returns the subset of `candidateBranches` that are reachable from `launchBranch`
 * — i.e. branches whose tips git considers merged. Always prefer this over
 * trusting the merger's output text: a partial merger (some conflicts skipped)
 * can report success while leaving branches unmerged.
 *
 * Read-only — never mutates repo state.
 */
export function verifyLandedBranches(
  repoRoot: string,
  launchBranch: string,
  candidateBranches: readonly string[],
  warn: (msg: string) => void,
): readonly string[] {
  if (candidateBranches.length === 0) return [];
  let mergedOutput: string;
  try {
    mergedOutput = execFileSync(
      "git",
      ["branch", "--merged", launchBranch, GIT_BRANCH_FORMAT_ARG],
      { cwd: repoRoot, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    );
  } catch (err) {
    warn(
      `verifyLandedBranches: git branch --merged ${launchBranch} failed: ${(err as Error).message}`,
    );
    return [];
  }
  const mergedSet = new Set(
    mergedOutput
      .split("\n")
      .map((s) => s.trim())
      .filter((s) => s.length > 0),
  );
  return candidateBranches.filter((b) => mergedSet.has(b));
}

// worktreePathFor lives in `./lib/worktree-path.ts` (imported at top of file
// so mac-host-sandbox.ts can import it without depending on this 4k-line
// orchestrator). Re-exported here so external consumers of main.mjs keep
// working.
export { worktreePathFor };

/**
 * Per-branch cleanup for the sandcastle loop.
 *
 * Side effects: removes the sub-worktree at
 * `.sandcastle/worktrees/<wtName>` AND deletes the local branch
 * `<branch>`. Both are mutations on the repo at `repoRoot`.
 *
 * Order is LOAD-BEARING — `git worktree remove` MUST run before
 * `git branch -d`. Reverse order silently no-ops: `git branch -d`
 * refuses to delete a branch that is currently checked out in ANY
 * worktree, and our setup always has the branch checked out in its
 * sub-worktree. Do NOT add a "branch only" fast path.
 *
 * `--force` is a FALLBACK ONLY. First try a clean `git worktree
 * remove <path>`. Escalate to `--force` only when (a) the clean
 * remove fails AND (b) `git status --porcelain` inside the worktree
 * is empty (i.e. the working tree is clean and git is just being
 * cautious about something benign like a dangling registration).
 *
 * The branch delete uses SHA-pinned `git update-ref -d` rather than
 * `git branch -d`. `branch -d` performs its own HEAD-based merge
 * check internally, which has the same false-negative as the old
 * pre-check whenever repoRoot's HEAD isn't on `launchBranch`. The
 * two-step safety net (pre-check merged-status against `launchBranch`,
 * then `update-ref -d <ref> <expected-sha>`) provides equivalent
 * guarantees: merge-safety from the pre-check, ref-race-safety from
 * the SHA pin. Never `branch -D` — that's an unguarded escalation.
 *
 * ISSUE #1260 — THE PATH COMES FROM GIT, AND THE LOCK GATES THE REMOVE.
 * On 2026-09-11 a cleanup for landed tickets destroyed LIVE issue #1260's
 * worktree registration mid-run, and its reviewer died on
 * `not a git repository: .../.git/worktrees/agent-issue-1260` with a finished
 * build already paid for. Two rules close that, and BOTH are load-bearing:
 *
 *   1. The worktree path is whatever `git worktree list --porcelain` says
 *      holds THIS branch — never `worktreePathFor(branch)`. A derived path
 *      that is wrong names some other ticket's live folder, and `git worktree
 *      remove` would happily delete it. When git reports no worktree for the
 *      branch there is simply nothing to remove; the derived path is NOT used
 *      as a fallback, because that is exactly the guess this rule forbids.
 *   2. Every in-flight ticket's worktree is LOCKED (`lib/paths/worktree-lock.ts`).
 *      This cleanup unlocks ONE worktree — the one git says holds this branch,
 *      locked by this loop for this branch — and refuses outright on a foreign
 *      lock, a lock naming a different branch, or a listing it could not read.
 *      Anything it does not unlock, git itself refuses to remove or prune.
 *
 * Best-effort: never throws. Returns one of:
 *   "ok"                       — both steps succeeded
 *   "skipped-unmerged"         — branch isn't reachable from launchBranch
 *   "skipped-worktree-error"   — worktree remove failed AND we
 *                                couldn't proceed to branch delete
 *   "skipped-branch-error"     — worktree removed but branch delete
 *                                had an unexpected error
 *   "skipped-worktree-locked"  — the worktree is not this cleanup's to remove
 *                                (issue #1260). NOTHING is touched, not even
 *                                the branch: a branch whose worktree is still
 *                                standing is a branch some other ticket may
 *                                still be working in.
 *
 * The caller emits the result to logs and proceeds to the next branch.
 *
 * `git` is injectable, but ONLY for the Step 0 guard — the registration
 * lookup and the unlock. Every destructive operation below (the removes, the
 * prune, the branch delete) still shells out through `execFileSync` directly,
 * because each depends on catching a throw rather than reading an `ok` flag.
 * So this parameter does NOT make the whole function runnable against a fake;
 * the tests that cover the removal drive real git worktrees in a temp repo,
 * which is the right instrument for it anyway.
 */
export function cleanupIssueBranch(
  repoRoot: string,
  branch: string,
  launchBranch: string,
  warn: (msg: string) => void,
  git: (repoRoot: string, ...gitArgs: string[]) => GitRunResult = runGit,
):
  | "ok"
  | "skipped-unmerged"
  | "skipped-worktree-error"
  | "skipped-branch-error"
  | "skipped-worktree-locked" {
  // Step 0 (issue #1260): ask git which worktree — if any — holds this
  // branch, and whether this cleanup is allowed to remove it.
  const permission = mayRemoveWorktree(
    branch,
    findRegisteredWorktree(repoRoot, branch, git),
  );
  if (permission.decision === "refuse") {
    warn(`worktree cleanup ${branch} refused: ${permission.why}`);
    return "skipped-worktree-locked";
  }

  // Only ever the path git itself reported for THIS branch. `undefined` means
  // git has no worktree for the branch, so Step 1 is skipped entirely.
  const wtPath = permission.decision === "go" ? permission.path : undefined;
  /** Whether THIS loop's lock is standing on that worktree and must come off
   * before it can be removed. Read out here, next to the path, because
   * TypeScript cannot re-narrow `permission` inside the block below. */
  const holdsOurLock = permission.decision === "go" && permission.locked;

  // Step 1: worktree remove (clean first, --force only on clean-but-busy).
  //
  // Skipped whole when git reports no worktree for this branch (issue #1260):
  // a prior run already removed it, or it was never created. The derived
  // `worktreePathFor(branch)` is deliberately NOT used as a fallback — a wrong
  // derivation names another ticket's live folder.
  if (wtPath !== undefined) {
    try {
      // Drop our own lock first. `git worktree remove` refuses a locked
      // worktree outright (even with `--force`), so without this every removal
      // below would fail and the folder would accumulate. `mayRemoveWorktree`
      // has already established this lock is ours and names this branch.
      if (holdsOurLock) unlockWorktree(repoRoot, wtPath, git);
      execFileSync("git", ["worktree", "remove", wtPath], {
        cwd: repoRoot,
        stdio: ["ignore", "pipe", "ignore"],
      });
    } catch (err1) {
      // Clean remove failed. Try --force only if the working tree is clean.
      let canForce = false;
      try {
        const status = execFileSync("git", ["status", "--porcelain"], {
          // `wtPath` is git's own absolute, realpath'd answer (issue #1260),
          // so it is used as-is — a `path.join(repoRoot, wtPath)` here would
          // glue an absolute path onto the repo root and point at nothing.
          cwd: wtPath,
          encoding: "utf8",
          stdio: ["ignore", "pipe", "ignore"],
        });
        canForce = status.trim().length === 0;
      } catch {
        // Worktree dir or registration missing; let prune handle it below.
      }
      if (canForce) {
        try {
          execFileSync("git", ["worktree", "remove", "--force", wtPath], {
            cwd: repoRoot,
            stdio: ["ignore", "pipe", "ignore"],
          });
        } catch (err2) {
          warn(
            `worktree remove --force ${wtPath} failed: ${(err2 as Error).message}`,
          );
          return "skipped-worktree-error";
        }
      } else {
        // Try a prune in case the registration is just dangling, then retry.
        try {
          execFileSync("git", ["worktree", "prune"], {
            cwd: repoRoot,
            stdio: ["ignore", "pipe", "ignore"],
          });
        } catch {
          // ignore — prune is best-effort
        }
        // Issue D: after prune, decide whether the worktree is genuinely still
        // registered. If `prune` already cleared a dangling registration, the
        // worktree is effectively gone and the retry-remove below would fail
        // with "not a working tree" — a misleading warn. Only retry (and warn
        // on failure) when the registration actually survived the prune.
        //
        // We match by branch ref (not by path): `git worktree list --porcelain`
        // reports realpath'd absolute paths, so a path comparison would
        // mis-classify under macOS symlinks (/var → /private/var in tmpdirs)
        // and silently suppress every warn. Branch-ref is an exact string and
        // there's a 1:1 branch↔worktree mapping here. If the list itself fails,
        // default to "still registered" so we fail toward surfacing the warn,
        // not hiding it.
        let stillRegistered = true;
        try {
          const listed = execFileSync(
            "git",
            ["worktree", "list", "--porcelain"],
            {
              cwd: repoRoot,
              encoding: "utf8",
              stdio: ["ignore", "pipe", "ignore"],
            },
          );
          stillRegistered = parseWorktreeList(listed).some(
            (e) => e.branch === `refs/heads/${branch}`,
          );
        } catch {
          stillRegistered = true;
        }
        if (stillRegistered) {
          try {
            execFileSync("git", ["worktree", "remove", wtPath], {
              cwd: repoRoot,
              stdio: ["ignore", "pipe", "ignore"],
            });
          } catch {
            warn(`worktree remove ${wtPath} failed: ${(err1 as Error).message}`);
            // Continue to branch delete anyway — registration may be gone already.
          }
        }
        // else: prune already cleaned it — fall through to branch delete with no warn.
      }
    }
  }

  // Step 2: SHA-pinned branch delete.
  //
  // Pre-check merge status against `launchBranch` (NOT HEAD): the
  // pipeline calls us from `args.repoRoot`, where HEAD usually matches
  // the launch branch but isn't guaranteed to — a mid-run manual checkout
  // or a detached HEAD can leave repoRoot pointed at some other ref. Using
  // HEAD here would falsely report "not merged" and skip cleanup of
  // branches that DID land, so we pin the check to launchBranch explicitly.
  //
  // We then delete via SHA-pinned `update-ref -d` rather than
  // `branch -d`, because `branch -d` performs the same HEAD-based
  // merge check internally — i.e. it has the same bug we just fixed
  // in the pre-check. The SHA pin keeps the "don't clobber a
  // concurrently-moved ref" safety that `branch -d` would otherwise
  // provide. Together the pre-check (merge-safety) and the SHA pin
  // (ref-race-safety) match what plain `branch -d` gave us when HEAD
  // was guaranteed to be on launchBranch.
  // Verify the branch actually exists locally before trying merge-checks.
  // A missing branch != unmerged — distinguish so the warn is accurate.
  let branchSha = "";
  try {
    branchSha = execFileSync(
      "git",
      ["rev-parse", "--verify", `refs/heads/${branch}`],
      {
        cwd: repoRoot,
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
      },
    ).trim();
  } catch {
    warn(`branch ${branch} does not exist locally; nothing to delete`);
    return "skipped-branch-error";
  }
  let isMerged = false;
  try {
    execFileSync("git", ["merge-base", "--is-ancestor", branch, launchBranch], {
      cwd: repoRoot,
      stdio: ["ignore", "pipe", "ignore"],
    });
    isMerged = true;
  } catch {
    isMerged = false;
  }
  if (!isMerged) {
    warn(
      `branch delete ${branch} refused: not fully merged into ${launchBranch}`,
    );
    return "skipped-unmerged";
  }
  try {
    execFileSync(
      "git",
      ["update-ref", "-d", `refs/heads/${branch}`, branchSha],
      {
        cwd: repoRoot,
        stdio: ["ignore", "pipe", "ignore"],
      },
    );
    return "ok";
  } catch (err) {
    warn(`update-ref -d ${branch} failed: ${(err as Error).message}`);
    return "skipped-branch-error";
  }
}

// Phase-1 cost telemetry capture (captureRoleCost) lives in
// ./lib/cost/capture.ts (imported above) so its "never throw into a run"
// contract is unit-testable directly instead of only through a full runMain.

interface PipelineCtx {
  readonly args: SandcastleArgs;
  readonly deps: Deps;
  /**
   * Run-scoped cost ledger (Phase-1 telemetry). Constructed once in
   * {@link runMain} next to the status store and threaded per-issue so each
   * role runner can fold its session's token usage in via {@link captureRoleCost}.
   * OPTIONAL so unit tests that build a bare ctx can omit it — capture no-ops
   * when it's absent, and never throws into the pipeline regardless.
   */
  readonly costLedger?: CostLedger;
  /**
   * Run-scoped WALL-CLOCK timing ledger (Phase-2 telemetry). Constructed
   * alongside {@link costLedger} in {@link runMain} and threaded the same way so
   * each role dispatch can be wrapped in {@link timeRole}. OPTIONAL for the same
   * reason as `costLedger` — a bare ctx omits it and `timeRole` no-ops.
   */
  readonly timingLedger?: TimingLedger;
  /**
   * Run-scoped PER-ISSUE telemetry ledger (issue × role → dollars, tokens,
   * wall-time). Constructed alongside {@link costLedger} and threaded the same
   * way; the `timeIssueRole` / `captureIssueRoleCost` wrappers fold into it and
   * the run-scoped ledgers from a single dispatch. OPTIONAL for the same reason
   * as its two siblings — a bare ctx omits it and both wrappers no-op.
   */
  readonly issueLedger?: IssueLedger;
  /**
   * This issue's counter bag: implementer attempts, reviewer blockers, ship
   * path, outcome — the loop's prose turned into numbers.
   *
   * A `readonly` reference to a MUTABLE object, deliberately. Every call site
   * is one optional-chained statement (`ctx.telemetry?.noteX(...)`) that
   * mutates in place, so instrumenting `runIssuePipeline` — a function with
   * many `return` statements — changes not one of them. Optional so a bare
   * test ctx makes every site a silent no-op.
   */
  readonly telemetry?: IssueTelemetryBag;
  /**
   * Run-wide event counters, shared by every issue in the run. The run-level
   * sibling of {@link telemetry}: that one counts "did #412 retry", this one
   * counts "how many retries did the whole run take". Optional on the same
   * bare-ctx-no-ops contract.
   *
   * ⚠️ `bump("implementerRetries")` is a RETRY EVENT (`attempts − 1`), while
   * `telemetry.noteImplementerAttempt(n)` takes the ORDINAL. They are not the
   * same call: bumping on a first pass would turn 18 first passes into 18
   * phantom retries and invert the headline this instrumentation exists for.
   */
  readonly runCounters?: RunCounters;
  /**
   * The run-wide "every pooled account is out" gate (build plan 4.5). The
   * pipeline catch closes it; each worker waits on it before it is dealt its
   * next ticket. Optional so a bare test ctx skips the wait.
   */
  readonly allowanceGate?: AllowanceGate;
  readonly ticketOrdinal: number;
  readonly issueNumber: number;
  readonly issue: PlanIssue;
  /**
   * This issue's body markdown, read ONCE when the issue was claimed.
   *
   * READ AT CLAIM TIME, NOT AT SHIP TIME, and that is the whole security
   * property. Its only consumer is the ship-time removal gate, which treats a
   * test file the ticket named as an intended deletion as already agreed by a
   * person (`lib/checkwriter/proof-demand.ts`'s `preauthorizedTestDeletions`).
   * No agent holds a GitHub key any more (spec #1334, SB), but the read stays
   * at claim time as defence in depth: a body fetched AFTER the builder ran
   * could otherwise be one an agent with a leaked key wrote itself. Fetched
   * before any agent starts, it cannot be.
   *
   * `undefined` when the fetch failed or the caller is a test that never set
   * it — which authorises nothing, so the gate stops exactly as it did before.
   */
  readonly issueBody?: string;
  /**
   * The ticket as every agent prompt shows it — `# title`, its labels, then
   * {@link issueBody} — rendered once at claim time and sent as
   * `{{ISSUE_SPEC}}` to the check-writer, builder, fixer and reviewer (spec
   * #1334, SB). The prompts used to fetch it with an in-sandbox `gh`, which
   * now holds no key and would hand the agent a blank ticket with no error.
   *
   * `undefined` when the read failed or a test never set it;
   * {@link issueSpecFor} then shows the title and says the text could not be
   * read — never a blank block.
   */
  readonly issueSpec?: string;
  /**
   * The OTHER tickets being worked in this same run — number, title and the
   * opening of each body — with THIS ticket's own entry already removed.
   *
   * WHY A TICKET NEEDS TO SEE ITS NEIGHBOURS. The check-writer runs before
   * every builder in the run, including its own, and writes one acceptance
   * check that has to still hold after ALL of this run's diffs land on the
   * integration branch — not just this ticket's. Handed only its own ticket
   * number, it cannot see that a sibling is about to make its fixture data
   * illegal or its asserted behaviour obsolete. The 2026-08-11 batch where
   * that actually happened is told once, in full, in
   * `lib/checkwriter/sibling-briefs.ts`'s module doc — see
   * {@link SiblingTicketBrief}.
   *
   * PROMPT CONTEXT ONLY, and the boundary is deliberate: this is read by a
   * prompt and by nothing else, and it is emphatically NOT {@link issueBody}.
   * That field, and only that field, reaches the ship-time removal gate's
   * `preauthorizedTestDeletions`, so no neighbour's text can widen what this
   * ticket is allowed to delete. Two fields, two collection points, no path
   * between them.
   *
   * Collected ONCE per iteration in {@link runMain}, before the dispatch pool
   * starts, and sliced per ticket. `undefined` on a bare test ctx and on any
   * caller that never collected them; `renderSiblingTickets` turns that into
   * the same "no other tickets" sentence the one-shot `--issue N` path gets,
   * so no prompt ever renders a hole and no dispatch can throw for a missing
   * key.
   */
  readonly siblingTickets?: readonly SiblingTicketBrief[];
  /**
   * Pre-computed required `Skill()` invocations for this issue's `type:X`
   * label, looked up by the orchestrator from the parsed `SANDCASTLE.md`
   * map. `undefined` when SANDCASTLE.md doesn't exist OR the issue's
   * `type:X` label has no matching section (graceful degradation rule).
   * `[]` when the type explicitly requires nothing (e.g. `type:cleanup`).
   * Threaded into {@link runImplementer} (and the post-merge fixer
   * union-set) so the skill-discipline gate can fail-fast on omissions.
   */
  readonly requiredSkills?: readonly string[];
  /**
   * SET WHEN THIS TICKET IS BEING BUILT WITHOUT A GOOD FIRST TEST (#1198 A),
   * and absent — the overwhelmingly common case — when it is not.
   *
   * Set exactly once, by `runCheckWriterStage`, onto the `ctx` it hands back
   * on the proceed path; `runIssuePipeline` adopts that ctx and every
   * downstream reader (both ship funnels, the reviewer dispatch, the ship-time
   * proof gate) sees it for free.
   *
   * ## Why it rides on `ctx` rather than on an input of its own
   *
   * This comment used to give two reasons. **The first one is now dead, and
   * saying so is the point of this paragraph** — do not re-derive it later and
   * conclude the field should stay put for a reason that stopped being true.
   *
   * The dead reason: `shipAfterMigrations` took a long positional parameter
   * list, so a new parameter had to be threaded through every call site, and a
   * site that forgot it would still COMPILE — it was optional — and then
   * silently refuse to ship a ticket the owner had decided must ship. Issue
   * #1227 removed that hazard outright. Its inputs are named now, and every
   * field is REQUIRED (`| undefined`, never `?`), so a forgotten field is a
   * type error. (The old numbers this comment quoted were stale anyway: it was
   * sixteen parameters and five running call sites, not fifteen and six.)
   *
   * **The reason this field stays on `ctx`:** it can be SET mid-road — by a
   * first-test rewrite the reviewer could not settle, or by the fixer taking
   * over a ticket whose test-writing step never finished — and `ctx` is what
   * the review rounds, the fixer and the ship gate all carry. A fact on `ctx`
   * reaches every one of them for free; as a ship input it would have to be
   * remembered at every call site. (There used to be a second ship funnel, the
   * rescue road's, where exactly such a hand-copied fact fell behind for
   * months — issue #969. Spec #1334 SG deleted that funnel.)
   * `ctx.requiredSkills` / `ctx.issueBody` are the same shape
   * of per-ticket fact travelling the same way.
   */
  readonly firstTestFellThrough?: FirstTestFallThrough;
  // Set by the ship gate's older-test check (`verifyOlderTestEdits`, spec
  // #1334 SH) when the finished diff edited an older ticket's test and the
  // edit was allowed; read at the ship moment.
  readonly olderTestEditRecord?: OlderTestEditRecord;
  /**
   * Status-feed store for the `sandcastle-watch` viewer. Constructed once in
   * {@link runMain} (after the single-instance lock) and threaded per-issue so
   * the pipeline can publish phase transitions. Every method is synchronous and
   * non-fatal — a write failure routes to `deps.logError` and never throws.
   */
  readonly status: StatusStore;
  /**
   * The first test's ONE rewrite (spec #1334), held for the WHOLE ticket.
   * Set the moment a reviewer's `GROUNDS: WRONG-CHECK` spends it, in the
   * builder's review rounds or the fixer's, so no later round — the fixer's,
   * after the builder spent it — can buy a second rewrite of the same test. A `readonly` reference to a MUTABLE cell, for the same reason
   * {@link PipelineCtx.telemetry} is.
   */
  readonly firstTestRewriteSpent: { current: boolean };
  /**
   * The ticket's first test after a PROVED rewrite (spec #1334). Once set,
   * every later review round — the builder's and the fixer's — and the ship
   * gate use THIS test's command, path and runner, never the check stage's
   * pre-rewrite one. `undefined` until a rewrite proves itself.
   */
  readonly rewrittenFirstTest?: RewrittenFirstTest;
  /**
   * LAYER 1 (issue #1118): the exact bytes of the check as it was ACCEPTED,
   * plus the config and setup files that decide what it does.
   *
   * Held in this process's MEMORY, which is the whole point. A dispatched
   * agent gets a filesystem and a shell, and every path it can reach is a path
   * it can write; it cannot reach a field on this object. The tamper restore
   * in `enforceProtectedPaths` and every graded run of a rewritten first test
   * read this copy, so an in-place edit to the check on disk — by the builder,
   * by the reviewer — cannot reach a grading run. The measured argument
   * for the shape is SWE-bench's: it lets the agent edit everything and
   * destroys its test edits at grading time, and a controlled experiment that
   * tampered seventeen test bodies to `pass` scored 0.0 with the restore
   * active and 1.0 without it.
   *
   * A MUTABLE cell: it is written once by `runCheckWriterStage` and once more
   * by a proved rewrite (`rewriteFirstTestOnce`), from call sites that are one
   * statement each.
   *
   * `undefined` — no freeze was taken, or this is a bare test ctx — is
   * ADDITIVE and never an error: a rewrite cannot be proved, so a reviewer's
   * `WRONG-CHECK` ships the ticket without a first test instead.
   */
  readonly frozenCheck?: { current: FrozenCheck | undefined };
  /**
   * PER-JOB protected-path globs (issue #909 / Piece C), on top of the
   * always-on {@link DEFAULT_PROTECTED_PATH_GLOBS}. This is the named seam
   * `docs/specs/2026-08-04-screen-check-design-lock.md` asked for, and issue
   * #911's check-writer is its producer: `runCheckWriterStage` populates it
   * with `[checkDirGlobForIssue(ctx.issueNumber)]` once the check-writer has
   * finished authoring (or recognised an inherited) check, so the SAME
   * protected-path lock that already bars the practice world bars the
   * builder from editing that check too — one mechanism, two uses.
   *
   * `undefined` on the ORIGINAL `ctx` a per-issue dispatch is constructed
   * with (`runMain`'s per-issue loop still never sets this field statically
   * — see {@link resolveProtectedPathGlobs}'s own doc comment on why a
   * static, issue-number-only glob is deliberately NOT stubbed in ahead of
   * time). It is populated dynamically, mid-pipeline, specifically so the
   * check-writer's OWN authoring pass — which runs before this field
   * exists — is free to create the file in the first place.
   */
  readonly protectedPathGlobs?: readonly string[];
}

export async function runImplementer(
  sb: SandboxHandle,
  ctx: PipelineCtx,
  opts: {
    // Attempt index: 1 = first pass, ≥2 = retry rounds. A plain number
    // rather than a fixed 1|2|3 literal union. Used only in comparisons / the
    // ATTEMPT_NUMBER prompt arg — never as an index.
    attemptNumber?: number;
    model?: string;
    reviewerFeedback?: string;
    /**
     * WHO is building (spec #1334, SG). `"implementer"` (the default) is the
     * builder. `"fixer"` is the one pass any failure hands the ticket to —
     * a review refusal after the builder's rounds, a failed ship-time check,
     * a time-out. The fixer runs the SAME prompt as the builder, on the same
     * worktree, so it gets the same certification envelope and the same
     * skill extraction; what changes is the run name (`fixer`,
     * `fixer-retry`, `fixer-retry-2`), the cost and time role (`recovery`,
     * the role the ledgers already carry), and that its first pass may
     * finish without a new commit — the work it was handed may already be
     * complete.
     */
    role?: "implementer" | "fixer";
    /**
     * What went wrong before the fixer was called, in the loop's own words —
     * rendered into `{{FIXER_BRIEF}}` on the fixer's FIRST pass only. Empty
     * on every builder pass and on the fixer's later rounds, which get the
     * reviewer's feedback instead, exactly like the builder's retries.
     */
    fixerBrief?: string;
    /**
     * Required principle names for the issue's `type:X` label, looked up by
     * the orchestrator from the parsed `SANDCASTLE.md` map and threaded in
     * per-issue. Surfaced to the implementer prompt as `{{REQUIRED_SKILLS}}`
     * so it can invoke and apply them.
     *
     * ADVISORY ONLY (spec #1334, SG). A missing record of a skill run is
     * never grounds to stop a ticket: the reviewer grades the diff against
     * the same principles itself. The host still EXTRACTS what was invoked
     * (`skillsInvoked`, shown to the reviewer and kept in telemetry), but
     * nothing compares it against this list any more.
     *
     * `undefined` (no SANDCASTLE.md or unknown `type:` label) and `[]` both
     * render as "".
     */
    requiredSkills?: readonly string[];
    /**
     * One-shot guard for the missing-envelope re-ask (audit #22). When the
     * implementer emits a real STORY_COMPLETE (not a `<rebuttal>`, not a
     * HALT) but drops the REQUIRED fenced ```json``` certification envelope,
     * `parseVerdict` throws {@link VerdictParseError} — a class neither
     * `isTransientError` nor `STALL_RE` covers, so the whole pass would be
     * wasted (recovery burn → quarantine, or immediate quarantine under
     * `--recovery off`). Instead we re-run the implementer ONCE with a terse
     * appended instruction surfaced via the `{{ENVELOPE_REASK}}` prompt
     * placeholder.
     *
     * `false`/`undefined` (default) on the FIRST pass → on a genuine
     * missing-envelope failure, recurse once with this flag set `true`.
     * `true` → this IS the re-ask: the `{{ENVELOPE_REASK}}` placeholder is
     * populated AND a second missing-envelope failure propagates as before
     * (the boolean can never recurse more than once). Mirrors the
     * single-retry discipline of `retryOnStall` in `runPostMergeReviewer`.
     */
    envelopeReask?: boolean;
  } = {},
): Promise<{
  commits: readonly { sha: string }[];
  stdout: string;
  skillsInvoked: readonly string[];
  /**
   * The implementer's own schema-validated certification envelope — its REPORT
   * CARD on whether a screen check was required and whether it ran one.
   *
   * Until issue #886 this was parsed for validity and then THROWN AWAY, so the
   * reviewer never saw it. That was a hole, not an omission: review-prompt.md's
   * EVIDENCE QUOTE section instructs the reviewer to verify "the
   * certification's `e2eAssertionLine` field" — a field name that exists ONLY in
   * this envelope — while the reviewer was handed nothing but the commit body,
   * which the implementer writes freely. The reviewer was grading a
   * self-report's paraphrase of a self-report it could not see.
   *
   * `undefined` is HONEST ABSENCE, never "clean": the three paths below skip the
   * parse entirely (rebuttal, HALT, stuck-abort), and a caller must render it as
   * "not produced", never as a passing certification.
   */
  certification: ImplementerOutputParsed | undefined;
}> {
  const attemptNumber = opts.attemptNumber ?? 1;
  const isFixer = opts.role === "fixer";
  // ORDINAL, not a retry event: this counts the pass itself (first pass = 1),
  // so `implementerAttempts` has a denominator for every issue — including the
  // ones that shipped first-try. The run-level `implementerRetries` bump lives
  // at the two RETRY dispatch sites instead, where `retries = attempts - 1`.
  // The fixer's passes are counted under `recovery`, not here.
  if (!isFixer) ctx.telemetry?.noteImplementerAttempt(attemptNumber);
  // Attempt 2 may legitimately produce zero new commits if the implementer
  // emits a <rebuttal> block instead of writing code. Attempt 1 must commit —
  // except the fixer's: the work it was handed may already be complete, and
  // the reviewer, not a commit count, decides that.
  const requireCommits = attemptNumber === 1 && !isFixer;
  const primaryModel =
    opts.model ?? (isFixer ? ctx.args.recoveryModel : ctx.args.implementerModel);
  // On attempt 1, allow a one-hop fallback to escalations[0] when the primary
  // throws a rate-limit error. Attempt 2 is already on the escalation, so no
  // further fallback — it just throws and the pipeline catch handles it.
  //
  // Budget-mode note (deliberate): under --budget, escalations[0] is Sonnet
  // (the fix-it rung), which is the SAME model as the primary — so an attempt-1
  // rate-limit fallback is a same-model retry after the transient window, NOT
  // an Opus escalation. That's intended: budget mode stays cheap on a transient
  // blip rather than jumping to Opus for a rate limit. Non-budget escalations[0]
  // is Opus[1m] as before.
  const fallbackModel =
    attemptNumber === 1 && !isFixer
      ? roleModelsFor(ctx.args).implementer.escalations[0]
      : undefined;
  const runName = isFixer
    ? attemptNumber === 1
      ? "fixer"
      : attemptNumber === 3
        ? "fixer-retry-2"
        : "fixer-retry"
    : attemptNumber === 1
      ? "implementer"
      : attemptNumber === 3
        ? "implementer-retry-2"
        : "implementer-retry";
  const timedRole = isFixer ? "recovery" : "implementer";
  /**
   * Batch the implementer into single-iteration passes (issue #1038,
   * 2026-09-04). The sandbox SDK re-runs a fresh `claude --print` per
   * iteration on the SAME worktree and inspects NOTHING between them — no
   * commit count, no HEAD movement, nothing — so a builder that writes prose
   * instead of code gets restarted blind, with a clean context, up to
   * `maxIterations` times. That happened eleven times in one hour on
   * 2026-09-04 before the 3600s hard ceiling finally killed the run (~$17,
   * zero commits, zero code).
   *
   * `sb.run` is now called with `maxIterations: 1` — ONE pass — and
   * `runBuilderIterations` (`lib/builder-progress.ts`) decides, after each
   * pass, whether to run another: a completion marker ends the batch
   * (`done`/`complete`); three consecutive passes with no marker AND no new
   * commit AND an unchanged worktree HEAD throw `BuilderNoProgressError`
   * instead of spending a fourth identical blind restart; reaching
   * `IMPLEMENTER_MAX_ITERATIONS` ends the batch exactly as the old single
   * call — capped at 100 iterations — would have. The loop lives HERE, in
   * the orchestrator, rather than inside the SDK, because the SDK exposes no
   * per-iteration hook to plug into (`@ai-hero/sandcastle`'s
   * `dist/index.d.ts` has no `onIteration`, no `shouldContinue`).
   *
   * The shared wall-clock ceiling (`deadlineMs`) is computed ONCE, outside
   * the batch, so every pass draws down the SAME budget the old one-shot
   * `sb.run` call would have had — a run split into ten passes must not get
   * ten times the ceiling. `SandboxRunSpec.ceilingMs` carries each pass's
   * remaining share down to `withCeiling` in `buildDefaultDeps`.
   *
   * Everything below this call reads the merged `BuilderBatchResult` exactly
   * as it read the old single-pass `RunHandle` — same fields
   * (`stdout`/`commits`/`iterations`/`stuckAborted`), now concatenated across
   * every pass the batch ran — so no downstream consumer changes.
   */
  const dispatch = () =>
    runWithRateLimitFallback(
      (model) => {
        const deadlineMs = Date.now() + ctx.args.hardCeilingSec * 1000;
        const worktreePath = sb.worktreePath;
        return runBuilderIterations({
          maxIterations: IMPLEMENTER_MAX_ITERATIONS,
          idleLimit: BUILDER_IDLE_ITERATION_LIMIT,
          deadlineMs,
          headSha:
            worktreePath === undefined
              ? undefined
              : () => ctx.deps.captureSha(worktreePath),
          log: (line) => ctx.deps.log(`[issue=${ctx.issueNumber}] ${line}`),
          runOnce: (_pass, ceilingMs) =>
            sb.run({
              name: runName,
              maxIterations: 1,
              ceilingMs,
              model,
              promptFile: "./.sandcastle/implement-prompt.md",
              idleTimeoutSeconds: ctx.args.implementerTimeoutSec,
              promptArgs: {
                ITERATION: String(ctx.ticketOrdinal),
                ISSUE_NUMBER: String(ctx.issueNumber),
                // The ticket text, read on the host at claim time — the
                // sandbox has no GitHub key to read it (spec #1334, SB).
                ISSUE_SPEC: issueSpecFor(ctx),
                STORY_TITLE: ctx.issue.title,
                BRANCH: ctx.issue.branch,
                ATTEMPT_NUMBER: String(attemptNumber),
                REVIEWER_FEEDBACK: opts.reviewerFeedback ?? "",
                // Spec #1334, SG: what failed before the fixer was called.
                // Empty on every builder pass, so the prompt's fixer section
                // stays inert.
                FIXER_BRIEF: opts.fixerBrief ?? "",
                // The implementer prompt's STEP 0 reads this and invokes and
                // applies each principle. Advisory: nothing stops on it (spec
                // #1334, SG). Empty string when undefined (no SANDCASTLE.md or
                // unknown type:label).
                REQUIRED_SKILLS: opts.requiredSkills?.join(", ") ?? "",
                // Audit #22: populated ONLY on the one-shot re-ask after the
                // implementer dropped the fenced ```json``` certification envelope
                // before STORY_COMPLETE. Empty string on the normal first pass so
                // the prompt's conditional block stays inert. The placeholder lint
                // (tests/lint-placeholders.test.ts) requires {{ENVELOPE_REASK}} in
                // implement-prompt.md to have this matching key.
                ENVELOPE_REASK: opts.envelopeReask
                  ? "Your previous final message ended without the REQUIRED fenced " +
                    "```json``` certification envelope before STORY_COMPLETE. " +
                    "Do NOT redo any work — your commits are already on the branch. " +
                    "Re-emit ONLY your final message, ending with the json envelope " +
                    "followed by the STORY_COMPLETE marker."
                  : "",
              },
            }),
        });
      },
      primaryModel,
      fallbackModel,
      ctx.deps.log,
      `${runName} (issue=${ctx.issueNumber})`,
      timedRole,
    );
  // Timed (and, below, costed) under the role's own literal name, one call
  // per role, so the telemetry rot-guard in `main.test.mts` can count every
  // attributable dispatch by name.
  const r = isFixer
    ? await timeIssueRole(ctx, "recovery", dispatch)
    : await timeIssueRole(ctx, "implementer", dispatch);
  // Extract Skill() invocations from the SDK's captured session JSONL — see
  // extractSkillInvocationsFromSession for why we cannot use the SDK's
  // `onAgentStreamEvent` callback for this (the AgentProvider allowlist
  // silently drops every Skill tool_use block). We walk each iteration's
  // sessionFilePath so primary and fallback attempts (and any
  // multi-iteration runs) all contribute, in the order the implementer
  // invoked them. Missing iterations array (legacy test mocks) yields [].
  const skillsInvoked: string[] = [];
  for (const it of r.iterations ?? []) {
    // Backend-aware: for Codex iterations this resolves the
    // ~/.codex rollout and parses skill-reads; for Claude it walks the
    // ~/.claude session JSONL as before. primaryModel reflects this run's
    // backend (all iterations share it).
    for (const name of await resolveAndExtractSkillInvocations(
      it,
      primaryModel,
    )) {
      skillsInvoked.push(name);
    }
  }
  // Phase-1 cost telemetry (best-effort): fold this run's token usage into the
  // run-scoped ledger under the builder's role (`recovery` for the fixer).
  // Never throws.
  if (isFixer) await captureIssueRoleCost(ctx, "recovery", r);
  else await captureIssueRoleCost(ctx, "implementer", r);
  // NO skill-discipline gate here any more (spec #1334, SG). A missing record
  // of a required `Skill()` run used to throw `MissingRequiredSkillsError`
  // and quarantine the ticket before review. The record is still extracted
  // above and shown to the reviewer, but it is never grounds to stop: the
  // reviewer grades the diff against the same principles itself.
  // `!opts.envelopeReask`: same self-defeat hazard. The re-ask recurses with
  // attemptNumber unthreaded, so requireCommits recomputes to true, but a
  // compliant re-ask makes NO new commits (the work is already on the
  // branch) — so this throw must not fire on a re-ask.
  //
  // `|| r.stuckAborted` (loop-cost ticket 03): a stuck-abort with ZERO
  // recovered commits has no partial work to review, so it must fall into the
  // existing no-commit quarantine/defer path — regardless of attemptNumber
  // (an attempt-2 stuck-abort is NOT a rebuttal, so the normal requireCommits
  // bypass must not let it through). A stuck-abort WITH commits skips this
  // throw (commits.length > 0) and flows on to the reviewer.
  // The builder stopped on a product question the ticket leaves open
  // (spec #1334 fix pass). Checked FIRST: such a pass rightly made no
  // commits, and the pipeline stops the ticket for the owner with the
  // question on it — never the fixer, which cannot answer a product question.
  const ticketQuestion = builderTicketQuestion(r.stdout);
  if (ticketQuestion !== undefined) throw new TicketUnclearError(ticketQuestion);
  if (r.stuckAborted && r.commits.length === 0) {
    // Stuck-abort with nothing committed: quarantine immediately via the
    // typed StuckError arm in the pipeline catch — must NOT fall through to
    // the fixer (loop-cost ticket 03, checkbox 3). A non-stuck
    // no-commit run keeps today's generic-Error path below.
    //
    // runImplementer no longer has the aborting tool/count (the provider
    // already converted the abort into this graceful result), so a
    // placeholder StuckError is sufficient — the catch arm keys off the type,
    // not the message.
    throw new StuckError("implementer", 0);
  }
  if (requireCommits && r.commits.length === 0 && !opts.envelopeReask) {
    throw new Error("implementer made no commits");
  }
  // Sandcastle's r.stdout is the parsed `result.result` from claude's final
  // stream event — already-extracted assistant text, NOT raw stream-json
  // envelopes. The frozen v1 references at archive/loop/agents.ts and archive/planner/planner.ts both
  // handle this with a dual-mode try (stream-json first, then fall back to
  // `alreadyAssistantText: true`). Without the fallback every implementer
  // run throws "no assistant text could be extracted" and triggers recovery,
  // doubling the per-issue Opus spend. Mirror the established pattern.
  //
  // The envelope is only required for STORY_COMPLETE (normal success).
  // Two paths legitimately skip it:
  //   - Attempt 2 with a <rebuttal>...</rebuttal> block (implementer
  //     disagrees with the reviewer; caller handles rebuttal extraction).
  //   - Any attempt that ends in HALT (per implement-prompt step 8 —
  //     HALT only requires `<promise>HALT</promise>`, no JSON envelope).
  //     Without this gate, parseVerdict throws on every HALT and the
  //     pipeline mis-classifies a clean HALT as an envelope-missing
  //     failure, burning a recovery pass.
  // Populated ONLY by the parse below. Stays `undefined` on the three paths
  // that legitimately skip the parse (rebuttal / HALT / stuck-abort) — see the
  // return type's doc comment for why that absence must never read as "clean".
  let certification: ImplementerOutputParsed | undefined;
  const rebuttalPresent =
    attemptNumber >= 2 && extractRebuttal(r.stdout) !== "";
  const halted = (() => {
    try {
      return extractMarker(r.stdout, IMPLEMENTER_MARKERS) === "HALT";
    } catch {
      return false;
    }
  })();
  // `!r.stuckAborted` (loop-cost ticket 03): a stuck-abort's stdout is the
  // "[stuck-detector] run aborted — …" banner, never a certification envelope.
  // Running parseVerdict on it would throw VerdictParseError and burn a
  // wasteful envelope re-ask; instead we skip the parse (like the HALT/rebuttal
  // cases) and return the recovered partial work for the reviewer to judge.
  if (!rebuttalPresent && !halted && !r.stuckAborted) {
    // Dual-mode parse (stream-json first, assistant-text fallback). On a
    // genuine missing-envelope failure — the implementer emitted a real
    // STORY_COMPLETE but dropped the fenced ```json``` certification
    // envelope — both attempts raise VerdictParseError. That class is NOT
    // covered by isTransientError / STALL_RE, so without intervention the
    // whole pass is wasted (recovery burn → quarantine, or immediate
    // quarantine under --recovery off). Re-ask the implementer ONCE for just
    // the envelope (audit #22), guarded by opts.envelopeReask so it can
    // never recurse more than once. We catch VerdictParseError ONLY
    // (instanceof) — any other thrown class (and the second re-ask failure)
    // propagates unchanged, exactly as before.
    let parseErr: unknown = null;
    try {
      certification = parseVerdict(r.stdout, ImplementerOutputSchema);
    } catch {
      try {
        certification = parseVerdict(r.stdout, ImplementerOutputSchema, {
          alreadyAssistantText: true,
        });
      } catch (err2) {
        parseErr = err2;
      }
    }
    if (parseErr !== null) {
      if (parseErr instanceof VerdictParseError && !opts.envelopeReask) {
        ctx.deps.logError(
          `implementer (issue=${ctx.issueNumber}) emitted STORY_COMPLETE ` +
            `without the required json envelope — re-asking once for the envelope`,
        );
        return runImplementer(sb, ctx, { ...opts, envelopeReask: true });
      }
      throw parseErr;
    }
  }
  // Issue #1025, guard 2 does NOT run here (review blocker 1). `r.stdout` is the
  // implementer AGENT's already-extracted assistant text, not the raw test-run
  // output — the `SANDCASTLE_OBSERVED_DB:` line `apps/nextjs/e2e/global-setup.ts`
  // prints goes to the Playwright process's own stdout, which reaches the host
  // only through the HARNESS run's captured output. So the observed-database
  // check lives at the ship funnel (`shipAfterMigrations`), where the graded
  // harness run's output is in hand and which the builder and the fixer both
  // ship through. See `enforceObservedDatabase`.
  // Second destination for the report card (issue #886). `status.json` is
  // per-machine and transient; the drained telemetry row lands in
  // `.sandcastle/telemetry/issues.jsonl`, which is git-tracked and therefore
  // survives the run and travels between the Mac and the VPS. Last write wins
  // across implementer attempts, which is correct: the envelope that ships is
  // the one attached to the final commit.
  ctx.telemetry?.noteImplementerCertification(certification);
  return { ...r, skillsInvoked, certification };
}

/**
 * Extract a `<rebuttal>...</rebuttal>` block from implementer stdout.
 * Returns the inner text (trimmed) or "" if no rebuttal was emitted.
 * Used on attempt 2 — the implementer may disagree with the reviewer
 * instead of writing code; main.mts forwards the rebuttal text into the
 * next reviewer pass as IMPLEMENTER_REBUTTAL.
 */
function extractRebuttal(stdout: string): string {
  const m = stdout.match(/<rebuttal>([\s\S]*?)<\/rebuttal>/);
  return m ? (m[1] ?? "").trim() : "";
}

/**
 * A single category's outcome in the reviewer's CATEGORY SWEEP block.
 *
 * THREE OF THESE ARE THE REVIEWER'S ANSWER. The fourth, `unreadable`, is the
 * RUN'S answer about the reviewer's answer, and it is never offered as a
 * choice in `review-prompt.md`.
 *
 * WHY A FOURTH OUTCOME EXISTS (owner decision on issue #1082, 2026-08-15;
 * built under issue #1128). Word for word:
 *
 *   "The checking step must emit one of a fixed, small set of outcomes —
 *    approved or objected — in a form that cannot be misread. Not free prose
 *    that something else then interprets."
 *   "A build stops only on a real objection. A step that approves, or that
 *    says something the parser does not recognise, must not be treated as an
 *    objection."
 *   "An unparseable response is its own outcome and must be visible as one.
 *    Silently converting 'I could not read this' into 'objected' is the
 *    present bug; converting it into 'approved' would be worse. Surface it."
 *
 * Before this there were three statuses and no way to say "I could not read
 * that row", so {@link chooseSweepSplit} coerced every unrecognised remainder
 * to `finding` — the run put an objection on the record that no reviewer had
 * stated. On the 2026-08-14 run that fabricated objection is what withheld two
 * tickets' third attempt. `unreadable` is that missing outcome.
 *
 * WHAT IT DOES NOT CHANGE. An unreadable row is still conservative at the
 * gate: it never grants the extra attempt, because "I could not read this" is
 * not evidence a prior complaint was fixed. What changes is that the run stops
 * CALLING it an objection, and quotes the reviewer's raw line whenever it
 * names one (the show-your-source rule, issue #1105).
 */
export type SweepStatus = "ok" | "n/a" | "finding" | "unreadable";

/**
 * One parsed sweep bullet: the label cut out of the reviewer's sentence, AND
 * the sentence it was cut from.
 *
 * WHY THE RAW LINE IS CARRIED (owner decision on issue #1105, closed). The run
 * must never state a reason it cannot show the source of. This map used to hold
 * the label alone and throw the reviewer's own words away, so
 * `thirdAttemptDenyReason` printed a category name with nothing to check it
 * against — and when the cut landed in the wrong place (issue #1082) that name
 * was a phantom nobody could tell from a real regression at three in the
 * morning. Keeping `line` is what lets every message quote its source verbatim
 * or refuse to use the label at all.
 */
export interface SweepEntry {
  readonly status: SweepStatus;
  /** The reviewer's bullet, verbatim, minus only the leading `- `. */
  readonly line: string;
}

/**
 * Every index at which a `": "` could separate a sweep bullet's CATEGORY from
 * its STATUS — that is, every one NOT nested inside brackets or quotes. Empty
 * when the line carries none. Exported for the regression tests.
 *
 * WHY THIS IS NOT `lastIndexOf(": ")` (issue #1082). The old rule took the LAST
 * `": "` on the line, so that a category whose own name holds a colon still
 * parsed — `Type safety (RFC: 1234): ok` has to split before `ok`, not before
 * `1234`. The comment beside it asserted the status token "never contains
 * `: `". That assumption is false, and it cost two tickets on the 2026-08-14
 * run. A reviewer explaining an `ok` in a parenthetical writes:
 *
 *   `- Execution evidence: ok (authoritative check re-run by me: "2 passed")`
 *
 * The last `": "` lands INSIDE the parenthetical. The category parses as
 * `execution evidence: ok (authoritative check re-run by me`, which matches no
 * real category, and the status parses as the remains of the explanation, which
 * matches no status word and so falls through to `finding`. A phantom category
 * is now on record. It appears in round one and not in round two, so
 * `priorFindingsResolved` denies the third attempt for a blocker nobody raised.
 *
 * STEP ONE: only a colon that is NOT nested can be a separator. A colon inside
 * `(...)`, `[...]`, `{...}` or a double-quoted run is skipped. That alone makes
 * the parenthetical above invisible to the split while leaving `Type safety
 * (RFC: 1234): ok` (whose inner colon sits at depth 1) parsing as it always did.
 *
 * STEP TWO, for the case step one does not reach. A FINDING's text is free
 * prose and may itself contain a top-level `": "` — `- Error handling:
 * unhandled reject at db.ts: "no such table"`. Taking the last one keys the
 * finding under `error handling: unhandled reject at db.ts`, which is another
 * phantom category and does the same harm by the same route. So the rule is:
 * take the LAST top-level `": "` whose remainder is a RECOGNISED status, and
 * fall back to the FIRST top-level `": "` when none is. A recognised status can
 * only ever be the real separator; free prose cannot be trusted to end at any
 * particular colon, so the earliest one gives the honest category name.
 *
 * This does not soften the strictness rule. `ok — actually it throws` is not a
 * recognised status, so it takes the first-colon path and stays a `finding`.
 *
 * LOSING A BULLET IS WORSE THAN MIS-SPLITTING ONE — an unparsed sweep silently
 * withholds a retry, which is the very harm this function exists to stop. So
 * malformed nesting must never swallow a line. An unbalanced CLOSER clamps the
 * depth at zero rather than going negative. An unbalanced OPENER or an odd
 * double quote cannot be clamped that way: they leave the scan nested to the
 * end of the line, and every colon after them is skipped, so the bullet
 * vanishes entirely. `Test fidelity (false-green: ok` — a one-character typo of
 * a category the reviewer prompt really ships — did exactly that, and the OLD
 * `lastIndexOf(": ")` rule parsed it fine. When the scan finds nothing AND ends
 * nested, it therefore runs again with nesting ignored, which is the old
 * behaviour. Mis-split, never dropped.
 */
export function topLevelColonSpaces(body: string): readonly number[] {
  const scan = (honourNesting: boolean) => {
    const found: number[] = [];
    let depth = 0;
    let inQuotes = false;
    for (let i = 0; i < body.length; i += 1) {
      const ch = body[i]!;
      if (honourNesting) {
        if (ch === '"') {
          inQuotes = !inQuotes;
          continue;
        }
        if (inQuotes) continue;
        if (ch === "(" || ch === "[" || ch === "{") {
          depth += 1;
          continue;
        }
        if (ch === ")" || ch === "]" || ch === "}") {
          if (depth > 0) depth -= 1;
          continue;
        }
      }
      if (depth === 0 && ch === ":" && body[i + 1] === " ") found.push(i);
    }
    return { found, ended: depth > 0 || inQuotes };
  };
  const strict = scan(true);
  if (strict.found.length > 0 || !strict.ended) return strict.found;
  return scan(false).found;
}

/** Where a sweep bullet splits, and the status that split yields. */
export interface SweepSplit {
  /** Index of the separating `": "` within the bullet body. */
  readonly splitAt: number;
  readonly status: SweepStatus;
}

/**
 * Choose a sweep bullet's separator and status, per {@link topLevelColonSpaces}'
 * two-step rule. Returns `null` when the line carries no separator at all.
 *
 * Exported so the tests exercise the SHIPPED selection rather than a copy of
 * it — an earlier revision inlined this loop in {@link extractCategorySweep}
 * and the test re-implemented it byte for byte, so the test proved only that
 * the copy matched itself.
 *
 * THREE STEPS, IN THIS ORDER, AND THE ORDER IS LOAD-BEARING.
 *
 * STEP A — an explicit `FINDING:` anywhere in the line wins. The fixed-token
 * contract in `review-prompt.md` lets a reviewer state an objection as
 * `FINDING: <text>`, and that text is free prose which may itself carry a
 * top-level colon. Without this step the backwards hunt of step B reaches past
 * it: `- Spec fit: FINDING: ok` splits at the SECOND colon, keys under the
 * phantom category `spec fit: finding`, and records the reviewer's stated
 * objection as `ok`. That is the fail-OPEN direction issue #1082 names as an
 * immediate launch gate — it ships work a reviewer objected to — so the
 * explicit objection is looked for BEFORE any approval is.
 *
 * THE SPLIT IS ALWAYS THE FIRST TOP-LEVEL COLON — never the colon the token
 * happened to be found at. The category name is whatever precedes the FIRST
 * colon and nothing else. Splitting at a later one mints a phantom category out
 * of the finding's own prose: `- Error handling: unhandled reject at db.ts:
 * FINDING: no table` would key under `error handling: unhandled reject at
 * db.ts`, a category present in round 1 and absent from round 2, which denies
 * the third attempt for a blocker nobody raised — fault 1 of issue #1082.
 *
 * Splitting early costs nothing, and the reason is worth stating because it is
 * easy to get backwards: `line` does NOT depend on `splitAt`. The whole bullet
 * body is stored regardless — {@link extractCategorySweep} does
 * `out.set(category, { status, line: body })` — so the entire finding text
 * survives whichever colon is chosen. Only the CATEGORY moves, and only the
 * first colon gives the honest one.
 *
 * STEP B — the last top-level colon whose remainder is a recognised APPROVAL.
 * Unchanged from the two-step rule this function has always run.
 *
 * STEP C — nothing was recognised. This is where the fourth outcome lands, and
 * where the old code was wrong: it returned `finding` flat, so an answer the
 * run could not read went on the record as an objection nobody had stated (the
 * owner's 2026-08-15 decision, quoted on {@link SweepStatus}). It now asks one
 * further question — does the remainder carry a readable answer at all?
 *
 *   - It carries words: that is a stated objection and stays a `finding`. This
 *     is not a hedge, it is the only safe reading, and it is what every
 *     reviewer in flight relies on: the sweep template shipped a bare
 *     `<one-line finding>` for years, so free prose IS how objections are
 *     written today. `OK but the tenant check is gone` and `N/A (actually it
 *     throws)` are complaints wearing an approval word, and calling either of
 *     them unreadable would bury a real objection just as surely as calling it
 *     `ok` would launder one.
 *   - It carries no letters and no digits — `**`, `—`, `✅`, empty — and there
 *     is nothing there to read either way. That is `unreadable`, and the run
 *     says so in those words rather than inventing a complaint.
 *
 * So the fail-OPEN direction is closed on both sides: an unrecognised answer
 * can become `finding` or `unreadable`, and never `ok` or `n/a`.
 */
export function chooseSweepSplit(body: string): SweepSplit | null {
  const colons = topLevelColonSpaces(body);
  if (colons.length === 0) return null;
  const remainderAt = (k: number): string => body.slice(colons[k]! + 2).trim();
  // STEP A. An explicit objection outranks any approval later in the line. The
  // split stays at the FIRST top-level colon wherever the token was found: the
  // category is what precedes that colon, never a slice of the finding's prose.
  for (let k = 0; k < colons.length; k += 1) {
    if (classifySweepStatus(remainderAt(k)) === "finding") {
      return { splitAt: colons[0]!, status: "finding" };
    }
  }
  // STEP B. The last remainder that is a recognised approval.
  for (let k = colons.length - 1; k >= 0; k -= 1) {
    const status = classifySweepStatus(remainderAt(k));
    if (status !== null) return { splitAt: colons[k]!, status };
  }
  // STEP C. Nothing recognised. Words mean a complaint; no words means the run
  // could not read the answer, and it must say that rather than invent one.
  return {
    splitAt: colons[0]!,
    status: statesSomething(remainderAt(0)) ? "finding" : "unreadable",
  };
}

/**
 * Does this remainder carry a readable answer at all? True when it holds at
 * least one letter or digit once markdown emphasis is stripped.
 *
 * This is the line between "the reviewer complained in prose" and "the run
 * could not read this row" ({@link chooseSweepSplit} step C). It is
 * deliberately the crudest test that separates them: any sharper guess about
 * whether a sentence is a complaint would be the run interpreting free prose,
 * which is the exact thing the owner's 2026-08-15 decision rules out. Words
 * present, the conservative reading is that a person is objecting; no words
 * present, there is nothing to interpret and pretending otherwise is how a
 * fabricated blocker gets onto the record.
 *
 * Unicode-aware on purpose: a reviewer writing a finding in a non-Latin script
 * has stated an objection and must not be filed as unreadable.
 */
function statesSomething(rest: string): boolean {
  return /[\p{L}\p{N}]/u.test(rest.replace(/[\s*_`]+/g, ""));
}

/**
 * The status a sweep value states, or `null` when it states none and the line
 * is therefore a finding. Split out of {@link extractCategorySweep} so the
 * separator search can ask "would this remainder be a real status?" without
 * duplicating the strictness rules. See that function's doc for why `ok` only
 * counts bare, dotted, or followed by a parenthetical.
 *
 * WHY MARKDOWN EMPHASIS IS TOLERATED (issue #1128, found by review on
 * 2026-08-17). `- Spec fit: **ok**` used to classify as a FINDING. The CATEGORY
 * half of the bullet has its emphasis stripped before matching, and the STATUS
 * half did not — so a reviewer that bolds its verdict had that verdict recorded
 * as a complaint. That is issue #1082's own harm by a third route: a false
 * finding in round 1 that is absent in round 2 denies the third attempt and
 * wakes a person for a blocker nobody raised. The codebase already concedes
 * reviewers do this — {@link extractCategorySweep}'s header and terminator
 * matchers tolerate `**`, `__` and backticks "because reviewers paste bolded
 * headers surprisingly often" — and the status half is where it costs money.
 *
 * THE STRIP IS DONE HERE, not at either call site, and that is the point.
 * {@link chooseSweepSplit} asks THIS function which colon separates the bullet,
 * so a strip applied only in {@link extractCategorySweep} would have the two
 * disagreeing: the split would be chosen against the un-stripped text and the
 * status read off a different one. One oracle, one answer.
 *
 * IT DOES NOT SOFTEN THE STRICTNESS RULE. Only emphasis around the status TOKEN
 * and around the whole value is ignored; everything else must still be exactly
 * a bare status or a single balanced parenthetical. `**ok** (mostly) but here:
 * a leak (bad)` is still a finding, so the fail-OPEN direction issue #1082
 * names as a launch gate stays closed.
 *
 * THE EXPLICIT `FINDING:` TOKEN (owner decision on issue #1082, 2026-08-15;
 * built under issue #1128). `review-prompt.md` now demands one of a fixed,
 * small set of bare tokens per row — `OK`, `N/A (<reason>)`, `FINDING:
 * <text>` — so that a verdict cannot be misread as prose or prose misread as a
 * verdict. `FINDING:` is the only one of the three the reviewer writes that
 * this function had no way to recognise before, and recognising it is what
 * lets {@link chooseSweepSplit} refuse to hunt for an approval PAST a stated
 * objection.
 *
 * NOTHING WAS NARROWED. Every shape accepted before this change is still
 * accepted — bare `ok`, `ok.`, `ok (...)`, `n/a`, `n/a (...)`, any case, and
 * the emphasis-stripped and balanced-parenthetical forms above. Reviewers
 * already mid-run wrote today's lowercase prose and their answers must keep
 * counting; the tokens are ADDITIVE. `unreadable` is never returned here: it
 * is the run's own outcome, decided one level up, and no reviewer may claim it.
 */
export function classifySweepStatus(valRaw: string): SweepStatus | null {
  // Emphasis wrapping the WHOLE value — `**ok (re-ran)**`. Same expression the
  // category name is normalised with, so the two halves of a bullet are read
  // by the same rule.
  const val = valRaw.replace(/^[\s*_`]+|[\s*_`]+$/g, "");
  // The explicit objection token. Emphasis is tolerated on the token exactly
  // as it is on `ok`, and the text after the colon is free prose that is NOT
  // inspected — a reviewer objecting must never have its own wording weighed
  // by a regex. `FINDING: ok` is an objection whose text happens to read
  // "ok", and it is recorded as an objection.
  if (/^finding[*_`]*\s*:\s*\S/i.test(val)) return "finding";
  // Emphasis wrapping only the TOKEN — `**ok** (re-ran: 4 passed)`, where the
  // trailing `**` sits mid-string and the strip above cannot reach it.
  const bare = /^(ok|n\/a)[*_`]*\.?$/i.exec(val);
  if (bare !== null) return bare[1]!.toLowerCase() === "ok" ? "ok" : "n/a";
  const withParenthetical = /^(ok|n\/a)[*_`]*\s*(\(.*)$/i.exec(val);
  if (withParenthetical === null) return null;
  if (!isOneBalancedGroup(withParenthetical[2]!)) return null;
  return withParenthetical[1]!.toLowerCase() === "ok" ? "ok" : "n/a";
}

/**
 * Parse the reviewer's CATEGORY SWEEP block. The block appears between
 * a line that IS exactly `CATEGORY SWEEP:` and one that starts with
 * `SWEEP COMPLETE.`. One bullet per category:
 * `- Spec fit: ok` / `- Spec fit: n/a (...)` / `- Spec fit: <finding text>`.
 * Returns a Map keyed on the lowercased, trimmed category name. Returns
 * null when the block is missing, empty, or unparsable — callers fall
 * back to (non-sweep-aware) behavior on null. This conservative fallback
 * matters: a malformed sweep should never accidentally grant extra retries.
 *
 * Classification is INTENTIONALLY strict (not permissive):
 * - `ok` only matches when the value is exactly `ok`, `ok.`, or `ok
 *   (parenthetical)`. A value like `ok — actually there's a bug` is a
 *   finding, NOT ok. An LLM reviewer that hedges with a leading `ok`
 *   should not get its real complaint silently classified resolved.
 * - `n/a` only matches when followed by `.`, end-of-string, or `(...)`.
 *   Same rationale.
 * - The placeholder-skip only matches the literal template emitted by
 *   the reviewer prompt (`<ok | n/a (...) | <finding>>`). A reviewer
 *   using `<one-line finding>` notation is treated as a real finding,
 *   not as an unfilled template.
 */
export function extractCategorySweep(
  stdout: string,
  logError: (msg: string) => void = () => {},
): Map<string, SweepEntry> | null {
  // Anchor both markers to a line start so a prose mention like
  // "the CATEGORY SWEEP: block below" doesn't shift the parse window.
  // Header / terminator detection is case-insensitive and tolerates
  // surrounding markdown emphasis (`**`, `__`, backticks) and an
  // optional space before the colon — reviewers paste bolded headers
  // surprisingly often.
  const isHeader = (line: string) =>
    /^[*_`]*\s*category\s+sweep\s*:\s*[*_`]*\s*$/i.test(line.trim());
  const isTerminator = (line: string) =>
    /^[*_`]*\s*sweep\s+complete\s*\.\s*[*_`]*\s*$/i.test(line.trim());

  const lines = stdout.split(/\r?\n/);
  let startIdx = -1;
  let endIdx = -1;
  for (let i = 0; i < lines.length; i += 1) {
    if (startIdx < 0 && isHeader(lines[i]!)) {
      startIdx = i;
    } else if (startIdx >= 0 && isTerminator(lines[i]!)) {
      endIdx = i;
      break;
    }
  }
  if (startIdx < 0 || endIdx < 0) return null;
  const out = new Map<string, SweepEntry>();
  // Severity ranking for the strictest-wins duplicate-category rule.
  //
  // WHERE `unreadable` SITS, AND WHY (issue #1128). A stated objection is the
  // strictest thing a row can say, so `finding` still outranks everything: if
  // the reviewer wrote the category twice and complained once, the complaint
  // is what survives. `unreadable` sits directly beneath it and ABOVE both
  // approvals, because the alternative is laundering — a category answered
  // once in words the run could not read and once `ok` would keep the `ok`,
  // and the run would then have no record that it failed to read anything.
  // Ranking it above the approvals keeps the conservative outcome and keeps
  // the failure visible, which is the whole point of the fourth outcome.
  const rank: Record<SweepStatus, number> = {
    finding: 3,
    unreadable: 2,
    "n/a": 1,
    ok: 0,
  };
  // Recognised template placeholders (left verbatim by a reviewer that
  // didn't fill the line in). Anything else inside `<...>` is treated as
  // a compact finding. The upper-case entries are the fixed-token template
  // `review-prompt.md` ships since issue #1128; the lower-case ones are the
  // template it shipped before, still emitted by any reviewer already in
  // flight, and they stay.
  const TEMPLATE_PLACEHOLDERS = new Set([
    "<ok | n/a (...) | <finding>>",
    "<ok | n/a (…) | <finding>>",
    "<ok|n/a(...)|<finding>>",
    "<ok | n/a (<reason>) | finding: <one-line finding>>",
    "<ok | n/a (…) | finding: <one-line finding>>",
    "<ok|n/a(<reason>)|finding:<one-line finding>>",
  ]);
  for (let i = startIdx + 1; i < endIdx; i += 1) {
    const bulletMatch = /^\s*-\s*(.+)$/.exec(lines[i]!);
    if (!bulletMatch) continue;
    const body = bulletMatch[1]!;
    const split = chooseSweepSplit(body);
    if (split === null) {
      // No top-level `": "` anywhere in the bullet — `- Security:OK`, with no
      // space after the colon, is the shape that does this. The row is dropped
      // from the map rather than recorded under some status, and the reason is
      // that there is no category name to key it under: without the separator
      // the parser recognises, any name taken off this line is the run's guess,
      // and issue #1105's show-your-source rule forbids naming a category the
      // run cannot cut out of the reviewer's own sentence.
      //
      // What is NOT allowed is dropping it in silence. The owner's decision on
      // issue #1082: "An unparseable response is its own outcome and must be
      // visible as one." So the raw bullet goes to the operator log, and an
      // objection written this way stops being a complaint that quietly
      // disappears and turns a deny into a grant.
      logError(
        `could not read this sweep line — no "<category>: <answer>" separator, ` +
          `so the row is dropped and no category is recorded for it: ` +
          JSON.stringify(body),
      );
      continue;
    }
    const { splitAt, status } = split;
    const rawCategory = body.slice(0, splitAt);
    const valRaw = body.slice(splitAt + 2).trim();
    if (TEMPLATE_PLACEHOLDERS.has(valRaw.toLowerCase())) continue;
    // Strip surrounding markdown emphasis from the category name before
    // lowercasing. `**Spec fit**` → `spec fit`.
    const category = rawCategory
      .replace(/^[\s*_`]+|[\s*_`]+$/g, "")
      .toLowerCase();
    if (category.length === 0) continue;
    // The two report-only rows (`lib/review/review-notes.ts`) never change
    // the verdict, so they never count here: a structure finding or a weak
    // first test can neither grant nor deny a review round.
    if (REPORT_ONLY_SWEEP_ROWS.has(category)) continue;
    // Duplicate-category resolution: strictest wins. If the existing
    // status outranks (or matches) the new one, keep existing; otherwise
    // replace. Either way, log the conflict — duplicate category lines
    // are a reviewer-prompt-violation that should surface to operators.
    if (out.has(category)) {
      const existing = out.get(category)!;
      if (rank[status] > rank[existing.status]) {
        logError(
          `category=${JSON.stringify(category)} ` +
            `existing=${existing.status} new=${status} — strictest-wins replaces existing`,
        );
        // The line moves with the status: whichever entry wins must be the
        // one whose source sentence gets quoted later.
        out.set(category, { status, line: body });
      } else {
        logError(
          `category=${JSON.stringify(category)} ` +
            `existing=${existing.status} new=${status} — strictest-wins keeps existing`,
        );
      }
      continue;
    }
    out.set(category, { status, line: body });
  }
  return out.size > 0 ? out : null;
}

/**
 * Decide whether the implementer demonstrably resolved every category
 * the reviewer flagged in round 1. Returns true iff round 1 had at
 * least one structured finding AND every such finding is now "ok" or
 * "n/a" in round 2. When true, round 2's HAS_BLOCKERS findings are
 * genuinely new -- round 1's complaints got fixed and the reviewer
 * surfaced a different bug. The loop grants a third attempt instead
 * of waking the user.
 *
 * An empty sweep1 (zero "finding" entries) is NOT evidence of progress:
 * the reviewer emitted HAS_BLOCKERS in round 1, so something was wrong,
 * but the sweep didn't classify it. Granting a third attempt on that
 * basis would be a vacuous freebie. Deny instead.
 *
 * Conservative on missing data: a category that was a finding in round 1
 * but is absent from round 2's sweep counts as unresolved.
 *
 * HOW AN `unreadable` ROW IS TREATED, AND WHY (issue #1128). It carries no
 * verdict, so it is never read as one — in EITHER direction:
 *
 *   - A round-1 row the run could not read states no complaint, so it is not
 *     something the implementer had to clear. It is skipped: it neither sets
 *     the "there was something to clear" flag nor denies on its own. Denial
 *     must rest on a genuine round-1 `finding` that round 2 did not clear.
 *   - It is equally not evidence that a complaint was CLEARED, so a round-1
 *     finding whose round-2 row is unreadable stays unresolved and denies.
 *     That is the fail-closed half: the run cannot read whether the objection
 *     was fixed, and it must never assume it was.
 *   - An unreadable row can never be the evidence that GRANTS. A sweep whose
 *     only round-1 rows are unreadable has no readable complaint to clear, so
 *     it falls into the vacuous case below and returns false. Turning "I could
 *     not read this" into "approved" is the outcome the owner called worse
 *     than the present bug.
 *
 * WHAT THIS CHANGED AGAINST BASE `8bbccacc`, stated plainly because an earlier
 * draft of this comment claimed the outcome was unchanged and that was FALSE.
 * On `8bbccacc` an unreadable remainder was coerced to `finding`, so a stray
 * `✅` on one row became a complaint that round 2's `ok` then "cleared" —
 * round 1 `- Spec fit: ✅` plus `- Perf: leaks a 500`, round 2 both `ok`,
 * granted the third attempt. The first version of the four-status code
 * short-circuited on any round-1 unreadable row and DENIED that same input,
 * costing a ticket its retry after every genuine complaint had been fixed —
 * a regression against the whole point of this branch. So round-1 unreadable
 * rows are skipped instead. Against base the outcomes now differ in one
 * direction only, and deliberately: where round 1's ONLY row was unreadable,
 * `8bbccacc` granted (having invented a complaint to clear) and this returns
 * false.
 *
 * A round-2 `unreadable` row under a category round 1 never complained about
 * is ignored here, exactly as a round-2 finding under a fresh category is.
 * This function answers one question — were ROUND 1's complaints cleared —
 * and a row about some other category is not an answer to it.
 */
export function priorFindingsResolved(
  sweep1: ReadonlyMap<string, SweepEntry>,
  sweep2: ReadonlyMap<string, SweepEntry>,
): boolean {
  let sawRound1Finding = false;
  for (const [cat, entry] of sweep1.entries()) {
    // Skips `ok`, `n/a` AND `unreadable`. Only a stated round-1 `finding` is
    // something the implementer had to clear; a row the run could not read
    // states nothing, so it is neither a complaint nor a clearance.
    if (entry.status !== "finding") continue;
    sawRound1Finding = true;
    const next = sweep2.get(cat);
    if (next === undefined) return false;
    if (next.status === "finding") return false;
    // Could not read round 2's answer for a category round 1 complained
    // about. Silence is not a fix.
    if (next.status === "unreadable") return false;
  }
  // Vacuous case: round 1 had no structured findings to clear, so we
  // have no positive evidence of progress -- deny the grant.
  if (!sawRound1Finding) return false;
  return true;
}

/**
 * Grant the third attempt on the LATEST review, when round 1 handed the loop
 * nothing it could read as a complaint but round 2 names a real one (issue
 * #1211).
 *
 * {@link priorFindingsResolved} answers only one question — were ROUND 1's
 * complaints cleared. It has to, and its vacuous branch denies whenever round 1
 * carried no readable finding, because an empty round 1 is no evidence of
 * PROGRESS. But "no evidence of progress" is the wrong test when round 2 itself
 * raises a fresh, stated objection with a file and a line: that is a genuine
 * bug the builder should get one pass to fix, not the content-free freebie the
 * vacuous deny exists to block. On 2026-09-05 ticket #1038 (retire the
 * hand-coded New Deal panel) stopped exactly here — review 1's sweep was empty
 * (`vacuous`), review 2 named a HARD one-line finding, and the run refused the
 * third round on the strength of round 1. A $93.87 run died on a one-line
 * change.
 *
 * So this reads the LATEST sweep. It grants iff:
 *
 *   - round 1 carried NO readable `finding` (a vacuous sweep, or an entirely
 *     unreadable one passed as `null`) — because if round 1 DID carry a
 *     finding, {@link priorFindingsResolved} already rules on it (progress,
 *     recurring blocker, or conservative-absent) and this path must never
 *     override that; in particular it must never grant past a builder stuck on
 *     the same complaint twice; AND
 *   - round 2 carries at least one stated `finding`.
 *
 * Both rounds vacuous → deny (a truly content-free refusal earns no freebie).
 * An `unreadable` round-2 row is never counted as a finding, so it can never be
 * the evidence that grants (owner decision on issue #1082: an answer the run
 * could not read is never turned into a grant). The caller still requires
 * `sweep2 !== null`, so an entirely unreadable latest review denies outright.
 */
export function latestSweepEarnsRound3(
  sweep1: ReadonlyMap<string, SweepEntry> | null,
  sweep2: ReadonlyMap<string, SweepEntry>,
): boolean {
  // Round 1 must have left no readable complaint. A `null` sweep (the whole
  // block was unparseable) counts as "no complaint" — it is the same "round 1
  // gave the loop nothing" the vacuous case is, at a larger scale.
  if (sweep1 !== null) {
    for (const entry of sweep1.values()) {
      if (entry.status === "finding") return false;
    }
  }
  // Round 2 must name a real, stated finding. `ok`, `n/a` and `unreadable` are
  // not findings, so none of them earns the attempt.
  for (const entry of sweep2.values()) {
    if (entry.status === "finding") return true;
  }
  return false;
}

/**
 * Diagnose why the third-attempt grant was denied. Returns a short
 * human-readable reason that operators auditing a quarantine can read
 * in the log to understand which of the four denial paths tripped.
 * Used purely for logging; the gate decision itself runs on the
 * returned boolean from `priorFindingsResolved`.
 *
 * SHOW YOUR SOURCE (owner decision on issue #1105, closed). Every category
 * name here was CUT OUT of a reviewer's sentence, and issue #1082 proved the
 * cut can land in the wrong place and mint a name nobody ever wrote. So the
 * rule is: quote the reviewer's own line verbatim beside the label, or do not
 * use the label at all. A message naming a category with no line behind it says
 * plainly that the reviewer's answer could not be read, and names nothing —
 * printing the label marked "unverified" was drafted and rejected, because it
 * recreates the same unreadable message at three in the morning.
 */
/**
 * The opening words of EVERY reason {@link thirdAttemptDenyReason} returns for
 * a reading failure, at either scale — a whole missing sweep block or one
 * unreadable row inside a block that parsed.
 *
 * It is a shared constant rather than repeated prose because the caller routes
 * on it: a reading failure goes to `logError`, where a person sees that the
 * INSTRUMENT failed, and a real objection goes to the ordinary log. Two copies
 * of the same sentence would drift, and the drift would silently send "I could
 * not read this" back down the channel reserved for stated objections — the
 * exact conflation issue #1082's owner decision exists to end.
 */
export const SWEEP_UNREADABLE_REASON_PREFIX =
  "could not read the reviewer's answer";

export function thirdAttemptDenyReason(
  sweep1: ReadonlyMap<string, SweepEntry> | null,
  sweep2: ReadonlyMap<string, SweepEntry> | null,
): string {
  // AN UNREADABLE ANSWER IS ITS OWN OUTCOME, and it is named as one (owner
  // decision on issue #1082, 2026-08-15; built under issue #1128). An
  // unreadable sweep still withholds the extra attempt, because "I could not
  // read this" is never evidence that the previous round's complaints were
  // fixed — but it is not evidence a complaint EXISTS either, so a single
  // unreadable ROW in round 1 no longer denies on its own (see
  // {@link priorFindingsResolved} for what that changed against base). What
  // changes here is what the run SAYS about it. `sweep1 unparsable` read, at three in the
  // morning, as though the reviewer had objected to something; on 2026-08-15
  // ticket #1038 was stopped with exactly that line while its reviewer had
  // approved the work. Turning "I could not read this" into a stated objection
  // is the bug; turning it into an approval would be worse. So it says which
  // one it is, in words, every time.
  //
  // TWO SCALES OF THE SAME OUTCOME. The whole block can be unreadable (the
  // two `null` branches directly below), and so can a single ROW inside a
  // block that otherwise parsed — that second scale is the `unreadable` status
  // added under issue #1128, handled in the loop further down. Both say the
  // same thing in the same words: the run could not read this, nobody
  // objected, and the extra attempt is withheld because an unreadable answer
  // is not evidence anything was fixed.
  //
  // THE REVIEWER NEVER PICKS `unreadable`. The RUN decides it, by failing to
  // read what the reviewer wrote, and `review-prompt.md` does not offer it as
  // a choice. Handing a reviewer a way to answer "unreadable" would give it a
  // fourth verdict nobody asked for.
  if (sweep1 === null) {
    return (
      `${SWEEP_UNREADABLE_REASON_PREFIX} — the round-1 CATEGORY SWEEP was ` +
      `missing or could not be parsed, so the loop has NO record of what the ` +
      `reviewer said. This is not an objection: nobody stated one. The extra ` +
      `attempt is withheld because an unreadable answer is never evidence the ` +
      `previous round's findings were fixed`
    );
  }
  if (sweep2 === null) {
    return (
      `${SWEEP_UNREADABLE_REASON_PREFIX} — the round-2 CATEGORY SWEEP was ` +
      `missing or could not be parsed, so the loop cannot tell whether round ` +
      `1's findings were cleared. This is not an objection: nobody stated one. ` +
      `The extra attempt is withheld because an unreadable answer is never ` +
      `evidence the previous round's findings were fixed`
    );
  }
  // A label with no source line behind it may not be printed. `line` is
  // always populated by `extractCategorySweep`; this guards a sweep built by
  // older code (a WIP checkpoint resumed across the upgrade).
  const cite = (entry: SweepEntry): string | null =>
    entry.line.trim().length > 0 ? JSON.stringify(entry.line.trim()) : null;
  // Re-derive, in the SAME order {@link priorFindingsResolved} walks, so the
  // reason names the row that actually decided the deny: a round-1 finding
  // still a finding (or absent, or unreadable) in round 2. Round-1 unreadable
  // rows are NOT a denial path any more, so they are not reported as one here;
  // they are described after the loop, where they are the only thing left.
  for (const [cat, entry] of sweep1.entries()) {
    if (entry.status !== "finding") continue;
    const next = sweep2.get(cat);
    const source = cite(entry);
    if (source === null) {
      return (
        `a round-1 finding was not resolved in round 2, but the reviewer's ` +
        `own line for it was not recorded — the loop cannot show where this ` +
        `label came from, so it does not name one`
      );
    }
    if (next === undefined) {
      return `category ${JSON.stringify(cat)} was a round-1 finding but is absent from round-2 sweep; round-1 line was ${source}`;
    }
    if (next.status === "finding") {
      const round2 = cite(next);
      return (
        `category ${JSON.stringify(cat)} was a finding in both rounds ` +
        `(recurring blocker); round-1 line was ${source}` +
        (round2 === null ? "" : `, round-2 line was ${round2}`)
      );
    }
    if (next.status === "unreadable") {
      // The round-1 complaint is real and quoted. What the run cannot do is
      // read round 2's answer to it — so it says that, and does NOT report a
      // recurring blocker it has no second objection for.
      const round2 = cite(next);
      return (
        `${SWEEP_UNREADABLE_REASON_PREFIX} for category ` +
        `${JSON.stringify(cat)} in round 2, which round 1 had flagged — so ` +
        `the loop cannot tell whether it was fixed. Round 2 stated no ` +
        `objection here: its answer could not be read. Round-1 line was ` +
        `${source}` +
        (round2 === null
          ? `, and the unreadable round-2 line was not recorded`
          : `, unreadable round-2 line was ${round2}`)
      );
    }
  }
  // No recurring blocker found. Every round-1 finding the loop could read was
  // cleared, so the deny can only be the vacuous case: round 1 handed the loop
  // nothing it could read as a complaint. If a row was unreadable, say so —
  // that is the honest description of why there was nothing to clear, and it
  // is NOT an objection, so it must never be worded as one.
  for (const [cat, entry] of sweep1.entries()) {
    if (entry.status !== "unreadable") continue;
    const source = cite(entry);
    if (source === null) {
      return (
        `${SWEEP_UNREADABLE_REASON_PREFIX} on a round-1 row, and the line it ` +
        `was cut from was not recorded either — the loop cannot show where ` +
        `this label came from, so it does not name one. This is not an ` +
        `objection: nobody stated one. Round 1 left no readable finding to ` +
        `clear, and an unreadable answer is never the evidence that grants ` +
        `the extra attempt`
      );
    }
    return (
      `${SWEEP_UNREADABLE_REASON_PREFIX} for category ${JSON.stringify(cat)} ` +
      `in round 1 — the loop cannot tell whether that row approved or ` +
      `objected. This is not an objection: nobody stated one. The reviewer's ` +
      `round-1 line, verbatim, was ${source}. Round 1 left no readable ` +
      `finding to clear, and an unreadable answer is never the evidence that ` +
      `grants the extra attempt`
    );
  }
  return "round-1 sweep had zero structured findings (vacuous)";
}

// Circuit breaker: if a (role, primary) pair fallbacks BREAKER_THRESHOLD times
// within BREAKER_WINDOW_MS, skip the primary entirely for subsequent calls
// until the rolling window empties. Protects against a known-broken primary
// (e.g. Kimi UA-bug phantom 429s) burning the fallback budget on every call.
const BREAKER_THRESHOLD = 3;
const BREAKER_WINDOW_MS = 60_000;
const fallbackHistory = new Map<string, number[]>();
// Per-issue deferral counter for transient rate-limit storms. Reset on success
// and on process restart (acceptable — a fresh process means the storm is over
// or the operator intervened).
const deferralCounts = new Map<number, number>();
const MAX_DEFERRALS = 3;

/**
 * The issue body captured on a ticket's FIRST claim this run (issue #958 item
 * 2). The body is re-read on every claim, and a deferred ticket is re-claimed by
 * the next iteration — so a builder that edited the ticket mid-run could add a
 * `Deletes-test:` line the deferral retry then honours, turning a never-waived
 * removal stop into a waived one. Its sandbox holds no GitHub key since spec
 * #1334 (SB); the pin stays as defence in depth.
 * Pinning the first-claim body shuts that: the retry reuses the body the ticket
 * carried before any agent ran. Reset on process restart, like
 * {@link deferralCounts}. See {@link pinnedClaimBody}.
 */
const firstClaimIssueBodies = new Map<number, string | undefined>();

/** Test-only: clear module-level transient-state maps. Production never calls
 * this; tests use it in `beforeEach` so prior tests' fallback-breaker or
 * defer-counter state can't bleed into ordering-sensitive cases. */
export function __resetTransientStateForTests(): void {
  fallbackHistory.clear();
  deferralCounts.clear();
  firstClaimIssueBodies.clear();
  stagingWorktreePath = "";
  cachedLockTtlSec = undefined; // Fix 8: re-read TTL env per test
}

/**
 * The `{{ISSUE_SPEC}}` value for one dispatch (spec #1334, SB): the ticket
 * text read on the host at claim time, or — when that read failed — the
 * planned title with a sentence saying the text could not be read. Never
 * empty, so no agent mistakes a failed read for a ticket with no
 * requirements.
 */
function issueSpecFor(ctx: PipelineCtx): string {
  return ctx.issueSpec ?? unreadIssueSpec(ctx.issueNumber, ctx.issue.title);
}

/**
 * Pin a ticket's issue body to its FIRST claim this run (issue #958 item 2).
 *
 * The first time an issue is seen, `freshBody` is stored and returned. On every
 * later claim — a deferral retry re-reads the body fresh — the body captured on
 * the first claim is returned instead, and `changedSinceFirstClaim` reports
 * whether the fresh read differs, so the caller can log a mid-run edit without
 * ever acting on it. This is the fix for a builder editing its own ticket to
 * pre-authorise a test deletion the deferral retry would otherwise honour.
 */
export function pinnedClaimBody(
  issueNumber: number,
  freshBody: string | undefined,
): {
  readonly body: string | undefined;
  readonly reusedFirstClaim: boolean;
  readonly changedSinceFirstClaim: boolean;
} {
  if (firstClaimIssueBodies.has(issueNumber)) {
    const pinned = firstClaimIssueBodies.get(issueNumber);
    return {
      body: pinned,
      reusedFirstClaim: true,
      changedSinceFirstClaim: freshBody !== pinned,
    };
  }
  firstClaimIssueBodies.set(issueNumber, freshBody);
  return {
    body: freshBody,
    reusedFirstClaim: false,
    changedSinceFirstClaim: false,
  };
}
function recentFallbacks(key: string): number[] {
  const now = Date.now();
  const fresh = (fallbackHistory.get(key) ?? []).filter(
    (t) => now - t < BREAKER_WINDOW_MS,
  );
  fallbackHistory.set(key, fresh);
  return fresh;
}

/**
 * Run a model-parameterized call with one rate-limit fallback. If the primary
 * call throws a rate-limit-shaped error AND a fallback model is provided, retry
 * once on the fallback. Any other error (or rate-limit on the fallback itself)
 * propagates to the caller.
 */
export async function runWithRateLimitFallback<T>(
  doRun: (model: string) => Promise<T>,
  primary: string,
  fallback: string | undefined,
  log: (m: string) => void,
  roleLabel: string,
  roleKey: string,
): Promise<T> {
  const breakerKey = `${roleKey}::${primary}`;
  if (
    fallback !== undefined &&
    recentFallbacks(breakerKey).length >= BREAKER_THRESHOLD
  ) {
    // Refresh timestamp so the breaker stays open while primary remains broken.
    // Without this, timestamps age out after 60s and the breaker closes even if
    // every call has been hitting the fallback.
    recentFallbacks(breakerKey).push(Date.now());
    log(
      `${roleLabel}: circuit breaker open for ${primary} — using ${fallback} directly`,
    );
    return await doRun(fallback);
  }
  try {
    return await doRun(primary);
  } catch (err) {
    const msg = (err as Error).message ?? "";
    log(
      `${roleLabel}: [isRateLimitError-audit] verdict=${isRateLimitError(msg)} primary=${primary} msg=${JSON.stringify(msg)}`,
    );
    if (!isRateLimitError(msg) || fallback === undefined) throw err;
    // Every pooled login is out (build plan 4.5): the fallback model draws on
    // the same empty pool, so retrying on it only spends time. Let the
    // pipeline catch wait for the reset instead.
    if (isPoolCooldownError(msg)) {
      log(`${roleLabel}: the account pool is empty; not falling back to ${fallback}`);
      throw err;
    }
    recentFallbacks(breakerKey).push(Date.now());
    // Jitter prevents concurrent workers (--max-concurrent N) from bursting
    // onto the fallback model at the same instant after a shared rate-limit.
    const jitterMs = 100 + Math.floor(Math.random() * 400);
    await new Promise((r) => setTimeout(r, jitterMs));
    log(
      `${roleLabel}: rate-limit on ${primary}; falling back to ${fallback} (jitter=${jitterMs}ms)`,
    );
    return await doRun(fallback);
  }
}

/**
 * Render the implementer's certification envelope for `{{IMPLEMENTER_CERTIFICATION}}`
 * (issue #886).
 *
 * Two properties the reviewer depends on, and neither is decoration:
 *
 *  - **Verbatim.** This is the exact object the host schema-validated, not a
 *    paraphrase. The commit-body certification block is free text the
 *    implementer writes by hand, so the two can disagree — and until now a
 *    disagreement was undetectable because only one side was ever shown.
 *  - **Absence is stated, never blank.** An empty block reads as "nothing to
 *    see"; the paths that produce no envelope (rebuttal, HALT, stuck-abort,
 *    and already-built work no build pass touched) each say so in words, so
 *    the reviewer cannot mistake a missing report card for a clean one.
 *
 * Total by construction: `JSON.stringify` on a zod-validated plain object
 * cannot throw, and the catch is a belt-and-braces guard because a throw here
 * would crash the entire review pass over a formatting detail.
 */
export function renderImplementerCertification(
  certification: ImplementerOutputParsed | undefined,
): string {
  if (certification === undefined) {
    return (
      "(no certification envelope was produced for this pass — the " +
      "implementer emitted a rebuttal, a HALT, or was stuck-aborted, or no " +
      "build pass ran at all (already-built work — see the review-situation " +
      "box). Treat this as ABSENT EVIDENCE, not as a passing certification.)"
    );
  }
  try {
    return JSON.stringify(certification, null, 2);
  } catch {
    return "(certification envelope could not be rendered — treat as ABSENT EVIDENCE.)";
  }
}

/**
 * The check-writer's outcome, fully resolved: the envelope's own claims
 * PLUS the host's own independent proof (issue #911, Piece D).
 */
export interface CheckWriterResult {
  readonly marker: CheckWriterMarker;
  /**
   * The host's own verdict on inheritance —
   * `hasPreexistingCheckFiles(...)` observed BEFORE this pass ran, and
   * ONLY that. NEVER OR'd with the envelope's own `inherited` claim: a
   * mismatch (agent claims inherited, host saw nothing pre-existing)
   * resolves to NOT inherited. See `schema.ts`'s doc comment for why the
   * host's observation is the sole source of truth here, and the
   * assignment site in `runCheckWriter` for the fix history.
   */
  readonly inherited: boolean;
  readonly screen?: string;
  /** Relative filename the envelope named (unvalidated — see `checkCommand`). */
  readonly checkPath?: string;
  /**
   * The workspace directory hosting a `UNIT_CHECK_WRITTEN` check, as the
   * envelope named it (`packages/<name>`; the schema already refused anything
   * else). `undefined` on every other marker. The npm package NAME the run
   * command needs is NEVER taken from here — see `resolveUnitCheckPackage`.
   */
  readonly checkPackage?: string;
  /**
   * WHERE this ticket's check lives and WHICH runner grades it, validated
   * once (issue #956). Present exactly when the marker writes a check
   * (`checkKindForMarker(marker) !== undefined`) AND the envelope named a
   * usable path — so `undefined` here is the one honest reading of "there is
   * no check to prove, lock, or re-run", and callers branch on it rather than
   * re-deriving a directory from the issue number and hoping the marker
   * agrees. See `must-fail-first-receipt.ts` for why the browser-directory/
   * unit-path pairing is unrepresentable on this value.
   */
  readonly checkLocation?: CheckLocation;
  /**
   * The command that runs the check — `buildCheckCommand`'s output on the
   * browser route, `buildUnitCheckCommand`'s on the unit one — or `undefined`
   * if the envelope named no usable check. One builder per runner, reused for
   * the must-fail-first proof and the ship-time re-run, so the two can never
   * drift into running different things.
   */
  readonly checkCommand?: string;
  readonly alreadyBuiltEvidence?: string;
  readonly worldDataNeeded?: string;
  readonly noScreenReason?: string;
  /** The product question a `TICKET_UNCLEAR` answer names. */
  readonly ticketQuestion?: string;
  /**
   * The must-fail-first proof's result, ONLY for a fresh (non-inherited)
   * outcome that wrote a check — `CHECKS_WRITTEN` or `UNIT_CHECK_WRITTEN`.
   * `undefined` for the other three markers and for an inherited check — see
   * the schema module's doc comment on why inheritance skips this proof
   * entirely.
   */
  readonly mustFailFirst?: "red" | "green" | "inconclusive";
  /**
   * WHY {@link mustFailFirst} reads what it reads, in the classifier's own
   * words (`classifyCheckRun`'s `reason`) — e.g. "no Playwright tally line in
   * the output", "did not complete — the bound fired", "observed green,
   * expected red — mismatch".
   *
   * Carried alongside the verdict so `buildAnywayNoFailingCheck` can put the concrete
   * cause in the quarantine message. Before 2026-08-05 it could not: the stop
   * said only "could not be run to a confirmed result twice in a row", which
   * is the same sentence whether the check is slow, the sandbox is wedged, or
   * the test database is unreachable — and a human triaging the quarantine
   * acts differently on each.
   *
   * NOT the output tail. That is bounded evidence for the run log
   * (`checkOutputTail`); this is the one-line verdict, and it is what goes on
   * the ticket. `undefined` wherever `mustFailFirst` is.
   */
  readonly mustFailFirstReason?: string;
  /**
   * A bounded, credential-redacted tail of the proof run's own output —
   * `runCheckCommand`'s `outputTail`, which `checkOutputTail` has already
   * redacted and capped at 4 KiB. Until 2026-08-31 this reached only the host
   * run log (the 10182 diagnostic) and then died there; it is carried on the
   * result so the retry brief handed to a second check-writer attempt can say
   * WHY the proof rejected the first check instead of re-dispatching blind.
   * `undefined` wherever `mustFailFirst` is, and on runs that produced no
   * output at all.
   */
  readonly mustFailFirstOutputTail?: string;
  /**
   * The proof's `inconclusive` was the SCREEN-UNREACHED shape (2026-09-01):
   * the runner demonstrably ran and reported a colour, but no grade mark,
   * refusal sentinel or nonce-keyed settled record says the check ever
   * reached its screen — `CheckRunVerdict.screenUnreached`, carried through.
   * Distinguishes a deterministic check-authored fault (a bad import, a dead
   * route — briefed writer retry) from a genuine environment fault (spawn
   * failure, timeout, no evidence line — `stopped:run-fault`). `undefined`
   * wherever `mustFailFirst` is, and on every non-inconclusive reading.
   */
  readonly mustFailFirstScreenUnreached?: boolean;
  /**
   * How many graded scenarios the must-fail-first RUN actually proved
   * (`verdict.proved.passed + verdict.proved.failed + verdict.proved.skipped`
   * — every one counts, including a `test.skip(` scenario that graded
   * neither pass nor fail, issue #1176 review finding 4), or, when the run
   * produced no nonce-signed tally, a static scan of the check's own source
   * (`countCheckScenarios`) — issue #1176. Feeds `scaledCheckTimeoutBudgetMs`
   * at ship time via `effectiveCheckTestCount`, which takes the LARGER of
   * this and a fresh static read rather than trusting this value alone, so a
   * real multi-scenario check gets a window sized to what it actually runs
   * instead of the single-scenario default. `undefined` wherever
   * `mustFailFirst` is, and on a read/count failure — which callers treat as
   * "use the base per-kind budget", exactly today's behaviour.
   */
  readonly mustFailFirstTestCount?: number;
  /**
   * This ticket resumed from a WIP checkpoint AND carried a valid durable
   * receipt (`lib/checkwriter/must-fail-first-receipt.ts`) proving THIS exact
   * check file was already observed to fail against untouched code, so the
   * proof was not re-run (issue #916, defect 2). `false` everywhere else,
   * including on Piece J's human-committed inheritance — that path never had
   * a loop-run proof to carry in the first place.
   *
   * Kept distinct from `inherited` because the two answer different
   * questions: `inherited` is "was a check file already here", this is "and
   * do we hold proof it can fail". A resumed worktree can be the first
   * without being the second, and that combination is exactly the hole this
   * closes.
   */
  readonly proofCarriedForward: boolean;
  /**
   * The must-fail-first proof was actually RUN, and it ran against a worktree
   * cut from a WIP checkpoint (2026-08-04 review, blocker 4). On such a
   * worktree the builder's work is usually already present, so a `green` or
   * `inconclusive` reading is not evidence the check is useless — it is the
   * expected reading when the fix works. `mustFailFirstUnproven` therefore
   * refuses to spend the ladder or stop the ticket on it; only a `red` here
   * means anything, and it means MORE than usual.
   *
   * `false` on every path that skipped the proof, and on every non-resumed
   * run — where a green genuinely does mean "this check cannot fail".
   */
  readonly proofRanOnResumedWorktree: boolean;
  /** This was the check-writer's second (and final) attempt. */
  readonly retried: boolean;
  readonly stdout: string;
}

/**
 * Turn a parsed envelope into the ONE validated {@link CheckLocation} this
 * ticket's check lives at, or `undefined` when the marker writes no check
 * (`ALREADY_BUILT`, `NEEDS_WORLD_DATA`, `NO_SCREEN_APPLIES`) or the envelope
 * named nothing usable (issue #956).
 *
 * The only place in this file that decides which runner's directory a check
 * belongs in. `checkKindForMarker` picks the door; the constructor behind it
 * applies that runner's own whitelist and builds that runner's own directory
 * and protected-path glob. A caller therefore cannot pair a browser directory
 * with a `.test.ts`, or a unit directory with a `.spec.ts`, because neither
 * pairing has a constructor.
 *
 * DEFENCE IN DEPTH on both `undefined` branches: `CheckWriterOutputSchema`'s
 * `superRefine` already refuses a `CHECKS_WRITTEN` without a safe `.spec.ts`
 * and a `UNIT_CHECK_WRITTEN` without both a safe `.test.ts` and a safe
 * `packages/*` directory, so a parsed envelope reaching here with a check
 * marker always yields a location today. It still returns `undefined` rather
 * than throwing, because the caller's job on that reading is to quarantine
 * loudly — never to fall through to "nothing to check", which is the exact
 * silent skip the schema-level whitelist exists to make unreachable.
 */
function checkWriterCheckLocation(
  marker: CheckWriterMarker,
  issueNumber: number,
  envelope: {
    readonly checkPath?: string;
    readonly checkPackage?: string;
  },
): CheckLocation | undefined {
  const kind = checkKindForMarker(marker);
  if (kind === undefined || envelope.checkPath === undefined) return undefined;
  if (kind === "browser") {
    return browserCheckLocation(issueNumber, envelope.checkPath);
  }
  if (envelope.checkPackage === undefined) return undefined;
  return unitCheckLocation(
    issueNumber,
    envelope.checkPackage,
    envelope.checkPath,
  );
}

/**
 * A best-effort scenario count for a committed check, read STATICALLY off
 * disk (issue #1176) — used to size the time budget BEFORE a run exists to
 * prove anything (the must-fail-first proof, its inconclusive re-run) and as
 * the fallback when a proof's own tally is unavailable (an inherited check
 * with no fresh proof this run). `undefined` on any read failure — no
 * worktree, no location, a missing or unreadable file — which every caller
 * treats as "use the base per-kind budget", exactly today's behaviour. Fails
 * closed on purpose: a budget this function cannot inform is not a budget
 * this function may shrink.
 */
function checkScenarioCountFor(
  worktreePath: string | undefined,
  location: CheckLocation | undefined,
): number | undefined {
  if (worktreePath === undefined || location === undefined) return undefined;
  try {
    const source = readFileSync(
      path.join(worktreePath, location.checkDir, location.checkPath),
      "utf8",
    );
    return countCheckScenarios(source);
  } catch {
    return undefined;
  }
}

/**
 * THE ONE PLACE the ship-time harness budget's test count is decided (issue
 * #1176, review finding 4). Every ship-harness call site used to thread its
 * OWN answer — a proof-run tally at one site (`shipAfterMigrations`'s
 * "first-pass-only" call, the only one of five that passed it), a bare
 * fallback to {@link checkScenarioCountFor} at the rest — with no site ever
 * comparing the two. That left two faults live at once: a stale or
 * undercounted proof tally could ship a SMALLER budget than the check
 * actually needs today, and (review finding 5) a proof tally is naturally a
 * touch smaller than reality on a `test.each(` table, since only the static
 * scan applies that heuristic.
 *
 * `proofTestCount` is the must-fail-first run's own tally
 * (`passed + failed + skipped`, issue #1176 finding 4's other half — see
 * `verify-checks.ts`'s `CheckRunVerdict.proved`), present only when this
 * ticket ran a fresh proof against the SAME check location being shipped —
 * `undefined` after a check repair, since the repaired file is a different
 * check the proof never counted. `worktreePath`/`location` are always the
 * check actually being shipped, repaired or not, so the static read is
 * always fresh.
 *
 * NEVER SMALLER THAN EITHER READING: the larger of the two, so a stale or
 * undercounted proof tally can only ever WIDEN the budget it would have
 * produced alone, never narrow it — the same "fails closed on a smaller
 * number never being safe" doctrine `checkScenarioCountFor`'s own doc
 * comment already states. `undefined` only when NEITHER reading exists,
 * which every caller already treats as "use the base per-kind budget".
 */
function effectiveCheckTestCount(
  worktreePath: string | undefined,
  location: CheckLocation | undefined,
  proofTestCount: number | undefined,
): number | undefined {
  const staticCount = checkScenarioCountFor(worktreePath, location);
  if (staticCount === undefined) return proofTestCount;
  if (proofTestCount === undefined) return staticCount;
  return Math.max(staticCount, proofTestCount);
}

/**
 * Which requirements does this check-writer's check FAIL to meet — empty when
 * it is fit to run as evidence (issue #956).
 *
 * The one place the two runners' scans are chosen between, so no caller can
 * run the browser scan over a vitest file. That mistake is not a near-miss: the
 * browser scan demands two helpers that live inside `apps/nextjs/e2e/lib/`, so
 * it would refuse EVERY unit check ever written, and the refusal message would
 * tell the agent to import a Playwright helper into a vitest test.
 *
 * Both scans return the same shape — a list of unmet requirements, in the
 * agent's own reading order — so one refusal message can name exactly what is
 * missing, and both FAIL CLOSED on an unreadable file. The three `[]` returns
 * here are the cases where nothing was ASKED, not cases where the answer was
 * "fine": no runnable command (the caller already treats that as unprovable),
 * no worktree to read from (a legacy/test-double handle, matching the guard
 * `hasPreexistingCheckFiles` applies), and no validated location. A missing
 * `packageDir` on the unit route is NOT one of them — it is passed through as
 * `""`, which `isSafeUnitCheckPackage` refuses, so that impossible-today
 * combination reports the requirement UNMET rather than silently clean.
 */
function missingCheckRequirements(opts: {
  readonly kind: CheckKind;
  readonly checkCommand: string | undefined;
  readonly worktreePath: string | undefined;
  readonly issueNumber: number;
  readonly location: CheckLocation | undefined;
  readonly packageDir: string | undefined;
}): readonly string[] {
  if (
    opts.checkCommand === undefined ||
    opts.worktreePath === undefined ||
    opts.location === undefined
  ) {
    return [];
  }
  // ASKED FIRST, ahead of either content scan (issue #1235). Both scans fail
  // closed on an unreadable file by reporting THEIR OWN requirement unmet, so a
  // file that is simply not there was being reported as a file that "does not
  // import at least one real product module" — which is what the #1271 sibling
  // repair of #1058's check was told, about a path with a doubled `issue-1058/`
  // segment in it that could never have existed. A missing file and a bad file
  // are two faults, and they no longer share one sentence.
  if (!checkFileIsOnDisk(opts.worktreePath, opts.location)) {
    return [CHECK_FILE_ON_DISK_REQUIREMENT];
  }
  return opts.kind === "browser"
    ? missingGradedHelperCalls(
        opts.worktreePath,
        opts.issueNumber,
        opts.location.checkPath,
      )
    : missingUnitCheckRequirements(
        opts.worktreePath,
        opts.packageDir ?? "",
        opts.issueNumber,
        opts.location.checkPath,
      );
}

/**
 * Dispatch the check-writer agent for one issue, BEFORE the implementer ever
 * runs (issue #911, Piece D of `docs/specs/2026-08-04-screen-check-design-
 * lock.md`). Reads the ticket plus the pre-build codebase and settles on
 * exactly one of the five allowed outcomes.
 *
 * `attempt` is the check-writer's OWN one-shot retry ladder — entirely
 * separate from the implementer/reviewer retry ladder in `runIssuePipeline`.
 * Piece D: "If they go green on day one, the check-writer gets exactly one
 * more go, then the ticket stops." `runIssuePipeline` is the caller that
 * decides whether a second attempt is warranted (mustFailFirst === "green"
 * on attempt 1) and passes `attempt: 2`.
 *
 * Does NOT decide whether the ticket proceeds, stops, or how the pipeline's
 * `preSha`/`protectedPathGlobs` should change — that orchestration lives in
 * `runIssuePipeline`, which is the only caller. This function's job ends at
 * "here is what the check-writer said, and here is independently-observed
 * proof of whether its check can fail."
 */
export async function runCheckWriter(
  sb: SandboxHandle,
  ctx: PipelineCtx,
  opts: {
    attempt?: number;
    repairBrief?: string;
    /**
     * The CALLER runs the proof, so this dispatch must not run its own.
     *
     * Set by `proveFirstTestRewrite` (spec #1334) and by nothing else. That
     * rewrite has a real pre-builder commit to replay against, so it stands
     * the tree back up on it, runs the rewrite there demanding red, then runs
     * it against the finished code demanding green — all of it host code
     * reading its own exit codes. This function's must-fail-first verdict is
     * read by nobody on that path, and running it anyway would cost a whole
     * discarded check run per rewrite (up to 420 s on a browser ticket) and an
     * ERROR line in the run log on every HONEST rewrite, because a rewrite
     * authored against the finished code comes back green here — the reading
     * this proof treats as a failure.
     *
     * The check-writer stage's own retries must never set it: they run before
     * any builder, so they have no pre-builder commit of their own and this
     * proof IS their red half (ruling 4).
     */
    proofRunByCaller?: boolean;
  } = {},
): Promise<CheckWriterResult> {
  const attempt = opts.attempt ?? 1;
  // `{{CHECK_DIR}}` STAYS THE BROWSER DIRECTORY (issue #956), and that is a
  // decision, not an oversight. At prompt time the marker does not exist yet —
  // the agent has not read the ticket — and the unit directory is a function of
  // a `checkPackage` the agent chooses DURING the pass, so there is no unit
  // path to substitute here. The alternatives were both worse: a second
  // placeholder would have to be filled with a guess, and a placeholder left
  // blank reads to a model as "put it wherever". So the prompt hands the one
  // directory that is knowable up front and tells the agent to derive the other
  // itself — `check-writer-prompt.md`'s `UNIT_CHECK_WRITTEN` section spells the
  // shape out literally as `<packageDir>/src/__checks__/issue-{{ISSUE_NUMBER}}/`.
  // Nothing rests on the agent getting that right: the host re-derives the same
  // directory from `checkPackage` via `unitCheckLocation` below and never reads
  // a path the agent composed.
  const checkDir = checkDirForIssue(ctx.issueNumber);
  // Host-observed inheritance is checked ONLY before attempt 1 — by attempt
  // 2 the check-writer's own attempt-1 pass may itself have added files to
  // the directory, and those are not "inherited", they are its own
  // rejected-as-green first try.
  const hostObservedPreexisting =
    attempt === 1 &&
    sb.worktreePath !== undefined &&
    hasPreexistingCheckFiles(sb.worktreePath, ctx.issueNumber);

  // No dedicated escalation ladder for this role — a single capable model,
  // one shot plus the one must-fail-first retry above. Rides the `critique`
  // model tier (`--critique-model`, `models.ts` `critique:`) — a name kept
  // from the design-critique stage spec #1334 deleted; the check-writer is
  // now that tier's main user. A single-pass read-and-judge role, not a
  // multi-round build role.
  const primaryModel = ctx.args.critiqueModel;
  // Which sandbox is THIS ticket actually running in (issue #933)? Read from
  // the issue's own worktree — `.sandcastle/profile` is a tracked, committed
  // file, so the worktree checked out for this ticket carries whichever
  // profile was active when that commit landed. `undefined` worktree (a
  // legacy/test-double sandbox handle) reads as "unknown", which
  // `profileHasBrowser` treats as browser-available — today's behaviour,
  // unchanged. This is ADVISORY input to the prompt only; the enforcement is
  // the code branch below, not this string.
  const browserAvailable = profileHasBrowser(
    sb.worktreePath !== undefined ? readActiveProfile(sb.worktreePath) : undefined,
  );
  const r = await timeIssueRole(ctx, "checkWriter", () =>
    sb.run({
      name: attempt === 1 ? "check-writer" : "check-writer-retry",
      maxIterations: 40,
      model: primaryModel,
      promptFile: "./.sandcastle/check-writer-prompt.md",
      idleTimeoutSeconds: ctx.args.implementerTimeoutSec,
      promptArgs: {
        ITERATION: String(ctx.ticketOrdinal),
        ISSUE_NUMBER: String(ctx.issueNumber),
        // Host-read ticket text; the sandbox has no GitHub key (spec #1334, SB).
        ISSUE_SPEC: issueSpecFor(ctx),
        BRANCH: ctx.issue.branch,
        CHECK_DIR: checkDir,
        CHECK_ATTEMPT: String(attempt),
        // EMPTY on every ordinary pass. Filled on a retry with the REASON the
        // previous attempt was refused — the host's own proof verdict before
        // any builder, or the reviewer's `WRONG-CHECK` reason after one (spec
        // #1334, `firstTestRewriteBrief`). Never the figure the application
        // produced: neither brief builder has a parameter it could arrive
        // through.
        REPAIR_BRIEF: opts.repairBrief ?? "",
        BROWSER_AVAILABLE: browserAvailable ? "true" : "false",
        // What the REST of this run is building (see
        // `PipelineCtx.siblingTickets`). Rendered rather than passed raw
        // because the empty case has to be a real sentence: `applyPromptArgs`
        // throws on a placeholder with no key, so "there are no siblings" can
        // never be expressed by leaving the key out — and a blank block reads
        // to a model as a section that failed to load rather than a run with
        // one ticket in it.
        SIBLING_TICKETS: renderSiblingTickets(ctx.siblingTickets),
      },
    }),
  );
  await captureIssueRoleCost(ctx, "checkWriter", r);

  const lineMarker = extractMarker(r.stdout, CHECK_WRITER_MARKERS);
  // `r.stdout` is ALREADY-EXTRACTED assistant text (Sandcastle's parsed
  // `result.result`), never a raw stream-json blob — same contract
  // `runImplementer` documents at its own `parseVerdict` call. No dual-mode
  // fallback here: unlike the implementer, the check-writer has no
  // envelope-reask mechanism, so a missing envelope propagates as a plain
  // `VerdictParseError` and quarantines like any other pipeline error.
  const envelope = parseVerdict(r.stdout, CheckWriterOutputSchema, {
    alreadyAssistantText: true,
  });

  // Finding #2 (2026-08-04 review, BLOCKER): `lineMarker` (above, the last
  // non-empty LINE) and `envelope.marker` (the fenced JSON BLOCK) are
  // extracted independently by two different passes over the SAME text —
  // nothing compared them before this. Every branch below reads `marker`;
  // every payload field (checkPath, screen, noScreenReason, …) comes from
  // `envelope` — a disagreement between them silently switches off BOTH
  // ship-time gates (see `CheckWriterMarkerEnvelopeMismatchError`'s own doc
  // comment for the exact mechanism). Stop loudly, immediately, before any
  // of the marker-branching logic below can act on either one alone.
  //
  // ONE pair is reconciled rather than stopped (2026-09-10): the two
  // "written" markers over each other, and only when the envelope is the
  // block the agent ended on. The rule, the #1249/#1235 story behind it and
  // the stale-draft guard all live on `reconcileCheckWriterMarkers`
  // (`lib/checkwriter/schema.ts`); here it is logged and counted so the
  // prompt fix that went in beside it can be measured.
  const reconciled = reconcileCheckWriterMarkers(
    lineMarker,
    envelope.marker,
    lastFenceMarkerOf(r.stdout),
  );
  if (reconciled.kind === "disagree") {
    throw new CheckWriterMarkerEnvelopeMismatchError({
      lineMarker: reconciled.lineMarker,
      envelopeMarker: reconciled.envelopeMarker,
    });
  }
  if (reconciled.kind === "reconciled") {
    ctx.deps.log(
      `WARN: [issue=${ctx.issueNumber}] check-writer: the outcome marker ` +
        `on the last line (${reconciled.lineMarker}) disagreed with the ` +
        `envelope's own marker field (${reconciled.marker}); both ` +
        `mean "a check was written", so the ENVELOPE's reading is taken ` +
        `(attempt ${attempt}). The check-writer prompt says the two must be ` +
        `the same string — a run that keeps logging this line has a prompt ` +
        `or model regression, not a ticket problem.`,
    );
    ctx.telemetry?.noteCheckWriterMarkerReconciled();
  }
  const marker = reconciled.marker;

  // The host's own observation is the SOLE source of truth here — never
  // OR'd with the agent's self-report. Inheritance is an objectively
  // observable fact (did a check file already exist in the worktree
  // BEFORE this pass ran?), so the envelope's own `inherited` claim adds
  // no signal a self-report could safely be trusted to add on top of it.
  // A mismatch (agent claims inherited, host saw nothing pre-existing)
  // resolves to NOT inherited, forcing the normal must-fail-first proof
  // rather than silently skipping it — and, transitively, keeping
  // `wentGreenOnUntouchedCode`'s twice-green stop reachable. FIXED
  // 2026-08-04: this used to read `hostObservedPreexisting ||
  // envelope.inherited === true`, which let a check-writer that merely
  // WROTE `"inherited": true` against an empty check directory skip the
  // must-fail-first proof entirely, on its own unverified word.
  //
  // ONE THING NARROWS IT (issue #916, defect 2). "A check file was already
  // here" is not the same statement as "someone already proved this check
  // can fail", and on a RESUMED worktree the two come apart completely: a
  // checkpoint commits the whole worktree, the check file included, so
  // every resumed ticket observes as inherited whether or not its proof was
  // ever run.
  //
  // Re-running the proof on a resume is not an option and never will be:
  // the builder has usually already changed the code, so the proof would go
  // GREEN for the most honest possible reason (the fix works) and stop a
  // healthy ticket. So the proof travels instead, as a durable receipt
  // committed next to the check — see `must-fail-first-receipt.ts`.
  //
  // PIECE J IS NOT EXEMPT, and this comment used to claim it was (2026-08-04
  // review, blocker 4). A human-committed check is unaffected on its FIRST
  // run — that worktree was never cut from a checkpoint — but checkpoint it
  // once and the resumed run lands here with `resumedFromCheckpoint` true and
  // no receipt to carry, because a receipt used to be minted only inside
  // `if (!inherited)`. So inheritance now mints one of its own (below), and
  // `proofRanOnResumedWorktree` keeps the remaining routes into that state
  // (a failed receipt write, a reformatted check, a ticket checkpointed
  // before this landed) from quarantining a healthy ticket.
  const resumedFromCheckpoint = sb.resumedFromCheckpoint === true;
  // WHERE this ticket's check lives, decided ONCE, from the marker and the
  // envelope together (issue #956). Everything below — the proof, the receipt,
  // the byte-lock, the refusal scan, the run command — reads this instead of
  // rebuilding `checkDirForIssue(...)` for itself, which is how a unit check
  // would otherwise end up proven against a browser directory it is not in.
  // `undefined` for the three markers that write no check, and for an envelope
  // whose path or package the whitelists refuse.
  const checkLocation = checkWriterCheckLocation(marker, ctx.issueNumber, {
    checkPath: envelope.checkPath,
    checkPackage: envelope.checkPackage,
  });
  const proofCarriedForward =
    hostObservedPreexisting &&
    resumedFromCheckpoint &&
    sb.worktreePath !== undefined &&
    checkLocation !== undefined &&
    mustFailFirstAlreadyProven(sb.worktreePath, checkLocation);
  const inherited =
    hostObservedPreexisting && (!resumedFromCheckpoint || proofCarriedForward);
  if (hostObservedPreexisting && resumedFromCheckpoint) {
    ctx.deps.log(
      proofCarriedForward
        ? `[issue=${ctx.issueNumber}] check-writer: resumed from a checkpoint ` +
            `carrying a red-proof receipt for ${envelope.checkPath} — the ` +
            `must-fail-first proof is carried forward, not re-run (there is ` +
            `no untouched code left on a resumed branch to run it against).`
        : `[issue=${ctx.issueNumber}] check-writer: resumed from a checkpoint ` +
            `with a pre-existing check but NO red-proof receipt for ` +
            `${envelope.checkPath ?? "(no checkPath)"} — refusing to treat it ` +
            `as inherited. The must-fail-first proof runs; if it comes back ` +
            `green the ordinary one-retry-then-stop ladder applies, because ` +
            `nothing here proves this check was ever seen to fail.`,
    );
  }

  let checkCommand: string | undefined;
  let mustFailFirst: "red" | "green" | "inconclusive" | undefined;
  /** Why {@link mustFailFirst} reads what it reads — see the field's doc on
   *  `CheckWriterResult`. Set on every path that assigns `mustFailFirst`. */
  let mustFailFirstReason: string | undefined;
  /** See `CheckWriterResult.mustFailFirstScreenUnreached`. */
  let mustFailFirstScreenUnreached: boolean | undefined;
  /** The redacted output tail from the same proof run — see the field's doc on
   *  `CheckWriterResult`. Set only where the proof actually ran. */
  let mustFailFirstOutputTail: string | undefined;
  /** See `CheckWriterResult.mustFailFirstTestCount` (issue #1176). */
  let mustFailFirstTestCount: number | undefined;
  let proofRanOnResumedWorktree = false;
  // BOTH check-writing outcomes take this path (issue #956). Everything inside
  // it is deliberately IDENTICAL across the two runners — the same refusal
  // scan-then-one-retry, the same must-fail-first proof, the same durable
  // receipt, the same sha256 byte-lock over the check's exact bytes. Only
  // three things vary, and each varies at exactly one line: which command
  // builder runs, which scan reads the file, and which grading rules
  // `runCheckCommand` applies. A parallel unit-flavoured copy of this block is
  // precisely how the two would drift into checking different things, which is
  // the defect `check-kind.ts` exists to prevent.
  //
  // ONE NONCE FOR THIS PROOF RUN. Both command builders key the runner's
  // machine-readable report on it, and `newCheckNonce`'s own contract is a
  // fresh one PER RUN — the check imports real product code, so builder-written
  // code executes inside the check's process, and a nonce reused across two
  // runs hands that code the report path the second verdict is read from.
  //
  // KNOWN GAP, NAMED RATHER THAN HIDDEN: the built string is carried on
  // `CheckWriterResult.checkCommand` all the way to the ship-time re-run, so
  // that re-run currently replays THIS nonce instead of minting its own. Fixing
  // it means threading the command's INPUTS (kind, package name, issue number,
  // relative path) to the ship funnel and rebuilding there, which is a reshape
  // of `CheckWriterStageResult` and both ship paths. Flagged here because a
  // silent reuse is exactly the shape the nonce exists to prevent.
  const checkKind = checkKindForMarker(marker);
  // ISSUE #933: a `browser` check ordered under a profile whose sandbox has
  // no browser stack (`.sandcastle/variants/minimal/Dockerfile` installs no
  // Playwright/chromium at all) can never be run — not "runs and fails",
  // never runs, for a reason that has nothing to do with the ticket. The
  // prompt already tells the agent this (`BROWSER_AVAILABLE` above), but a
  // prompt instruction is advisory; this is the branch that actually stops
  // it. Refused the SAME way an unsafe `checkPath` is refused — a
  // `VerdictParseError`, before any command is built — so it flows through
  // the identical, already-reviewed `runCheckWriterStage` quarantine path
  // rather than a new one.
  if (checkKind === "browser" && !browserAvailable) {
    throw new VerdictParseError(
      `check-writer-browser-check-under-browserless-profile: issue #${ctx.issueNumber} ` +
        `— the check-writer said ${marker}, which orders a browser ` +
        `(Playwright) check, but the active sandcastle profile has no ` +
        `browser stack (see .sandcastle/variants/minimal/overrides/` +
        `variant-intro.md: "the screen check does not exist under this ` +
        `variant"). A Playwright command can never succeed in this sandbox, ` +
        `regardless of the builder's fix. Use UNIT_CHECK_WRITTEN for a fix ` +
        `with no rendered surface, or NEEDS_WORLD_DATA/NO_SCREEN_APPLIES if ` +
        `neither runner can grade this ticket.`,
      new Error("checkKind=browser ordered under a browserless profile"),
      r.stdout,
    );
  }
  const proofNonce = newCheckNonce();
  if (checkKind !== undefined) {
    if (checkLocation === undefined) {
      // Unreachable today — the schema refuses a check marker whose path (and,
      // on the unit route, whose package) is missing or unsafe. Left explicit
      // so that if that guard ever regresses, the `checkCommand === undefined`
      // diagnostic below says so out loud instead of the ticket silently
      // shipping with no proof.
      checkCommand = undefined;
    } else if (checkKind === "browser") {
      checkCommand = buildCheckCommand(
        ctx.issueNumber,
        checkLocation.checkPath,
        proofNonce,
      );
    } else {
      // THE NPM PACKAGE NAME COMES FROM THE HOST'S DISK, NEVER THE ENVELOPE.
      // `buildUnitCheckCommand` interpolates that name into a shell string, so
      // letting the agent supply it would put agent-authored text one step from
      // a command line. The envelope may only name a DIRECTORY, whitelisted to
      // `packages/<name>` before anything is opened; `resolveUnitCheckPackage`
      // then reads that directory's own `package.json` and additionally proves
      // the package can actually host a check at all — a `SAFE_PACKAGE_NAME`
      // name, a runnable `test` script, and a vitest config on disk.
      //
      // `undefined` back from it means the envelope is UNUSABLE, and it must
      // be REFUSED AS A CHECK loudly rather than leaving `checkCommand` unset.
      // An unset command reads downstream as "nothing to check": the ship-time
      // gate engages only on `checkWriterCheckCommand !== undefined`, so the
      // ticket would ship with no check ever run AND nothing saying so — the
      // same silent skip the schema's own path whitelist exists to make
      // unreachable (see `lib/checkwriter/schema.ts`'s "Why an unusable
      // checkPath fails parsing"). `VerdictParseError` is the shape
      // `runCheckWriterStage` routes into
      // `buildAnywayUnusableCheckWriterEnvelope`. Since #1198 A that does NOT
      // stop the ticket: the reason is written onto the issue body as a
      // first-test fall-through, the builder IS dispatched, and the merge
      // carries `shipped-without-first-test`. What the throw still buys is
      // the loud, recorded refusal — this envelope never becomes a check.
      //
      // A MISSING WORKTREE IS NOT THAT CASE, and is deliberately not thrown on:
      // a legacy/test-double handle has no disk to read, which is "we could not
      // ask", not "the answer is no". It falls through to the same
      // `inconclusive` reading every other unaskable proof gets, with a reason
      // naming it — matching the `sb.worktreePath !== undefined` guard
      // `hasPreexistingCheckFiles` and the helper scan already apply.
      const resolved =
        sb.worktreePath !== undefined && envelope.checkPackage !== undefined
          ? resolveUnitCheckPackage(sb.worktreePath, envelope.checkPackage)
          : undefined;
      if (sb.worktreePath !== undefined && resolved === undefined) {
        throw new VerdictParseError(
          `check-writer-unusable-unit-check-package: issue #${ctx.issueNumber} ` +
            `— the check-writer said UNIT_CHECK_WRITTEN with checkPackage ` +
            `"${envelope.checkPackage ?? "(absent)"}", but the host cannot use ` +
            `that directory to run a check. It must be a real workspace ` +
            `package under packages/ whose package.json carries a usable name ` +
            `and a non-empty test script, AND which has a vitest config on ` +
            `disk — a test script alone does not prove vitest runs, and a run ` +
            `with no vitest tally can never be graded red (see ` +
            `lib/checkwriter/unit-check-path.ts). Refusing to proceed: an ` +
            `envelope with no runnable command reads downstream as "nothing to ` +
            `check" and would skip the whole ship-time gate.`,
          new Error(
            `resolveUnitCheckPackage returned undefined for ${envelope.checkPackage ?? "(absent)"}`,
          ),
          r.stdout,
        );
      }
      checkCommand =
        resolved === undefined
          ? undefined
          : buildUnitCheckCommand(
              resolved.packageName,
              ctx.issueNumber,
              checkLocation.checkPath,
              proofNonce,
            );
    }
    // Finding #5 (2026-08-04 review, BLOCKER) + issue #916 defect 1: nothing
    // verified the check file actually USES the two graded helpers — only
    // its PATH was ever validated, and then only the WAITING half.
    // `check-writer-prompt.md` tells the agent to call both and never
    // hand-roll, but a prompt naming a field is not evidence the field
    // arrives (Piece L).
    //
    // Both halves are load-bearing, for two DIFFERENT verdicts:
    //   - `waitForGradableScreen` throws the never-settled/claim-mismatch
    //     sentinels. A hand-rolled wait erases both, and every failure it
    //     produces misreads as something else.
    //   - `gradeScreenText` is the ONLY thing anywhere that emits
    //     `GRADED_FIGURE_SENTINEL`, and `lib/harness/verdict.ts` requires
    //     that sentinel to be PRESENT before it will return
    //     `graded-mismatch`. A check that finishes with a bare
    //     `expect(locator).toContainText("$1,234")` therefore files a
    //     genuinely wrong number on screen as `environment-fault` — which
    //     is recorded as the app or the environment being broken, never as
    //     a disagreement over the figure. That defeats the entire
    //     point of the gate, so it is refused here rather than discovered
    //     as a misfiled stop at 3am.
    //
    // THIS IS THE ONLY ENFORCEMENT POINT, deliberately. A second grep at
    // ship time would be a second place to drift, and it would buy nothing:
    // the moment this stage returns, `runCheckWriterStage` commits the check
    // directory and adds `checkLocation.checkDirGlob` to `protectedPathGlobs`,
    // so the file this function just read is the same file the harness runs
    // — any later edit to it trips the protected-path lock (issue #909) and
    // stops the ticket on its own. One structural read plus an existing
    // structural lock beats two independent greps.
    //
    // Applies to BOTH a freshly-authored and an inherited check (the
    // schema's own reasoning: "in practice `inherited` is only ever true
    // alongside CHECKS_WRITTEN" — an inherited check still has to be graded
    // by the same harness). Skipped only when there is no worktree to read
    // from (a legacy/test double handle) — matches `hasPreexistingCheckFiles`'s
    // own `sb.worktreePath !== undefined` guard just above.
    //
    // THE UNIT ROUTE GETS ITS OWN SCAN, NEVER THIS ONE (issue #956). The two
    // graded helpers are Playwright-only — they live in
    // `apps/nextjs/e2e/lib/graded-screen-check.ts` and exist to emit sentinels
    // a BROWSER classifier reads. Running this scan on a vitest check would
    // refuse every single one of them for not importing a Playwright helper it
    // has no business importing. `missingUnitCheckRequirements` asks the
    // equivalent question for that runner — does this check actually bind to
    // real product code — and returns the same shape (a list of unmet
    // requirements, empty when fine) so one refusal message serves both.
    const missingRequirements = missingCheckRequirements({
      kind: checkKind,
      checkCommand,
      worktreePath: sb.worktreePath,
      issueNumber: ctx.issueNumber,
      location: checkLocation,
      packageDir: envelope.checkPackage,
    });
    // ITS OWN SLUG AND ITS OWN SENTENCE (issue #1235). "There is no file there"
    // used to be reported in the words of whichever content scan could not read
    // it, so the one night it happened the run log said #1058's check "does not
    // import at least one real product module" — of a path
    // (`…/issue-1058/issue-1058/cross-team-relist-guard.test.ts`) that had never
    // existed, while the real file sat one directory up. Same error CLASS, so
    // the briefed-retry ladder and the quarantine road are unchanged; only the
    // sentence the reader gets is different, and it names the path.
    //
    // `checkLocation !== undefined` is a TYPE narrowing, not a doubt about
    // reachability: `missingCheckRequirements` returns `[]` the moment
    // `opts.location` is undefined, so this arm is only ever entered with a
    // validated location in hand. Naming it here lets the sentence below use
    // plain access instead of fallbacks like "(unknown directory)", which would
    // describe a state that cannot occur.
    if (
      checkLocation !== undefined &&
      missingRequirements.length === 1 &&
      missingRequirements[0] === CHECK_FILE_ON_DISK_REQUIREMENT
    ) {
      throw new CheckWriterMissingGradedHelperError({
        message:
          `check-writer-check-file-missing: the ` +
          `${CHECK_KIND_RUNNER_NAME[checkKind]} check file ` +
          `${checkFileRelPath(checkLocation)} ` +
          `does not ${CHECK_FILE_ON_DISK_REQUIREMENT}. checkPath is relative to ` +
          `this issue's own check directory ` +
          `(${checkLocation.checkDir}), NOT to the ` +
          `repository root — so name the file and any sub-directory INSIDE that ` +
          `directory and nothing above it. This is NOT a complaint about what ` +
          `the check contains: nothing could be read to complain about.`,
        missingHelpers: missingRequirements,
        // The default composition wraps each entry as `name(...) call(s)`,
        // which is right for a helper name and gibberish for a requirement
        // sentence (issue #1235) — so this site writes its own cause.
        causeMessage: `no check file at ${checkFileRelPath(checkLocation)}`,
        rawText: r.stdout,
      });
    }
    if (missingRequirements.length > 0) {
      throw new CheckWriterMissingGradedHelperError({
        message:
          // ONE slug per runner, both greppable, neither reused for the other:
          // an owner filtering the run log for a refused browser check must not
          // also collect every refused unit check, and vice versa.
          (checkKind === "browser"
            ? `check-writer-missing-graded-helper`
            : `check-writer-unit-check-not-bound`) +
          `: the ${CHECK_KIND_RUNNER_NAME[checkKind]} check file ` +
          `${checkLocation?.checkDir ?? "(unknown directory)"}/` +
          `${checkLocation?.checkPath ?? envelope.checkPath} ` +
          (checkKind === "browser"
            ? `never calls ${missingRequirements
                .map((h) => `${h}(...)`)
                .join(" and ")}`
            : `does not ${missingRequirements.join("; and does not ")}`) +
          `. ` +
          (checkKind === "browser"
            ? `A browser check MUST wait with waitForGradableScreen(page, ` +
              `{...}) and MUST finish with gradeScreenText(locator, expected) ` +
              `— both imported from ${path.posix.dirname(checksRoot())}/lib/graded-screen-check.ts ` +
              `(see check-writer-prompt.md and that file's header). Without ` +
              `waitForGradableScreen the harness loses the never-settled and ` +
              `claim-mismatch verdicts; without gradeScreenText it loses the ` +
              `graded-figure sentinel, so a genuinely WRONG NUMBER on screen ` +
              `gets filed as an environment fault and the owner is never asked ` +
              `to break the tie. Replace any bare ` +
              `expect(locator).toContainText(expected) with ` +
              `await gradeScreenText(locator, expected).`
            : `A unit check MUST import at least one module that is real ` +
              `product code — a relative import that climbs OUT of the check ` +
              `directory, or an @acme/… workspace import. A check that imports ` +
              `only vitest, node: builtins, or files beside it in its own ` +
              `check directory is bound to nothing: no diff the builder can ` +
              `write could turn it from red to green, so it proves nothing ` +
              `however it runs (see lib/checkwriter/unit-check-path.ts).`) +
          ` Refusing to run this check as evidence.`,
        missingHelpers: missingRequirements,
        rawText: r.stdout,
      });
    }
    if (inherited && !proofCarriedForward) {
      // PIECE J (blocker 4). The loop is waiving the proof on the ground that
      // a person already watched this check go red before the ticket was
      // queued. That ground is a fact about the branch, and it has to SURVIVE
      // — a checkpoint/resume re-reads this same directory and would
      // otherwise find nothing saying the proof was ever waived, run it
      // against the builder's own work, and stop a healthy ticket. Minted
      // here rather than at the red branch below because there is no red
      // branch on this path: nothing was run.
      //
      // Not minted when the proof was CARRIED forward — a valid receipt is
      // already sitting there, and rewriting it would move its timestamp and
      // relabel somebody else's basis as this run's.
      if (sb.worktreePath !== undefined && checkLocation !== undefined) {
        writeMustFailFirstReceipt(
          sb.worktreePath,
          checkLocation,
          "inherited-human-committed",
        );
      }
    }
    // A REPAIR DOES NOT RUN ITS OWN PROOF, AND NOTHING EVER READ THE ONE IT RAN.
    //
    // When a reviewer's `WRONG-CHECK` sends the check-writer back to rewrite
    // its first test after the build (spec #1334), `proveFirstTestRewrite`
    // runs the proof itself afterwards — the rewrite against the pre-builder
    // tree demanding red, the finished tree demanding green — and reads its
    // own exit codes. This proof's verdict is read by nobody on that path:
    // the rewrite looks at the marker, the location and the package, and at
    // none of the `mustFailFirst` fields.
    //
    // What it cost was real. One whole discarded check run per repair — up to
    // 420 s on a browser ticket — and an ERROR line in the run log on every
    // honest repair, because the rewrite is written against the FINISHED code
    // and so comes back green here, which is exactly the reading this proof
    // treats as a failure. An error logged on the success path is how a real
    // one stops being read.
    const isRepairDispatch = opts.proofRunByCaller === true;
    if (!inherited && isRepairDispatch) {
      ctx.deps.log(
        `[issue=${ctx.issueNumber}] check-writer: this dispatch is the first ` +
          `test's REWRITE, so the must-fail-first proof is not run here — the ` +
          `rewrite runs its own red-then-green proof against the pre-builder ` +
          `and finished trees, and reads its own exit codes.`,
      );
    }
    if (!inherited && !isRepairDispatch) {
      proofRanOnResumedWorktree = resumedFromCheckpoint;
      if (checkCommand === undefined) {
        // No safe command to run — cannot prove anything. Treated the same
        // as any other inconclusive proof (never blocks on its own, but
        // never counts as a proven-red check either).
        // DEFENCE IN DEPTH, near-unreachable today: `CheckWriterOutputSchema`'s
        // `superRefine` rejects a missing OR unsafe `checkPath` (and, on the
        // unit route, `checkPackage`) before this function ever builds a
        // command, and an unresolvable unit package throws above rather than
        // arriving here. The ONE reachable route left is a sandbox handle with
        // no worktree on the unit route, where the host cannot read the
        // package's manifest to learn its npm name — "we could not ask", not
        // "the answer is no". It still records and logs a reason, because the
        // whole point of the 2026-08-05 fix is that no path assigns
        // `inconclusive` in silence — if the schema guard ever regresses, this
        // one says so.
        mustFailFirst = "inconclusive";
        mustFailFirstReason =
          `no runnable ${CHECK_KIND_RUNNER_NAME[checkKind]} check command — ` +
          `the check-writer's checkPath (${envelope.checkPath ?? "(absent)"})` +
          (checkKind === "unit"
            ? ` in checkPackage (${envelope.checkPackage ?? "(absent)"})`
            : "") +
          ` is unsafe, was never stated, or names a package this host could ` +
          `not read, so no command builder would build one`;
        ctx.deps.logError(
          `[issue=${ctx.issueNumber}] check-writer: the must-fail-first proof ` +
            `could not even be ATTEMPTED — ${mustFailFirstReason}.`,
        );
      } else {
        // Scaled by scenario count (issue #1176): a single-scenario check
        // gets exactly `CHECK_TIMEOUT_BUDGET_MS[kind]`, byte-identical to
        // before; a multi-scenario file gets more, capped at
        // `CHECK_TIMEOUT_CEILING_MS`. The count is read STATICALLY off the
        // just-written check — there is no run yet to prove anything from —
        // and a read failure falls back to `undefined`, which
        // `scaledCheckTimeoutBudgetMs` treats as one scenario, exactly the
        // constant `lib/harness/timeout-budget-contract.test.ts` already pins
        // against the real Playwright/vitest configs.
        //
        // `kind` LEADS the call and has no default (issue #956): it selects
        // both the grading rules and the budget, and getting it wrong is not a
        // near-miss. A vitest run graded by Playwright's rules mints a
        // must-fail-first receipt from a bare non-zero exit code — which a
        // check with a deliberate syntax error produces without ever grading
        // anything.
        const staticTestCount = checkScenarioCountFor(
          sb.worktreePath,
          checkLocation,
        );
        const verdict = await runCheckCommand(
          checkKind,
          sb.exec,
          checkCommand,
          "red",
          // The SAME nonce the command above was built with — this is the one
          // place the two must agree, because the classifier reads the report
          // that command was told to write.
          proofNonce,
          scaledCheckTimeoutBudgetMs(checkKind, staticTestCount),
          // THE RUN #803 ACTUALLY DIED ON. `verdict.reason` and a 4 KiB tail
          // already reach the run log below, but the run log is a stream shared
          // by every ticket on the host and is not what anyone opens the next
          // morning. This writes the full transcript — command, budget, elapsed
          // time, exit code, whether the bound fired — to
          // `.sandcastle/logs/<branch>-checkrun-must-fail-first-1.log`, beside
          // the seven agent logs the same ticket already produces. Written even
          // when the run printed nothing at all, which is exactly the case that
          // left the owner guessing.
          {
            repoRoot: ctx.args.repoRoot,
            branch: sb.branch,
            issueNumber: ctx.issueNumber,
            phase: "must-fail-first" as const,
            worktreePath: sb.worktreePath,
            onError: ctx.deps.logError,
          },
          // The envelope's declared screen (2026-09-01): the settled-evidence
          // arm compares it against the nonce-keyed settled record, so a
          // check that settled some OTHER page cannot borrow the evidence.
          envelope.screen,
        );
        mustFailFirst =
          verdict.status === "pass"
            ? "red"
            : verdict.status === "fail"
              ? "green"
              : "inconclusive";
        mustFailFirstReason = verdict.reason;
        mustFailFirstOutputTail = verdict.outputTail;
        mustFailFirstScreenUnreached = verdict.screenUnreached;
        // The run's OWN tally, when it produced one, is more trustworthy
        // than the static scan above — it counts what actually graded rather
        // than what the source merely declares. Falls back to the static
        // count on an inconclusive run, which produces no tally at all.
        //
        // `+ skipped` (issue #1176, review finding 4): a `test.skip(`
        // scenario is neither `passed` nor `failed`, but it is still a
        // scenario the FILE holds and the check runner still had to spend
        // startup cost reaching — omitting it undercounted every file with
        // one, which is the exact failure mode `effectiveCheckTestCount`'s
        // "never smaller than either reading" rule exists to catch, but
        // fixing it at the source is cheaper than relying on that safety net.
        mustFailFirstTestCount =
          verdict.proved !== undefined
            ? verdict.proved.passed + verdict.proved.failed + verdict.proved.skipped
            : staticTestCount;
        // THE DIAGNOSTIC. Anything but `red` here is the loop declining to
        // trust this check, and until 2026-08-05 it declined in total silence:
        // `verdict.reason` was computed and dropped on the floor, so the two
        // tickets quarantined that night (#803, #813) cost ~19 minutes each
        // and left a run log that said only "could not be run to a confirmed
        // result". The actual cause — `write CONNECT_TIMEOUT 172.17.0.1:55432`,
        // the sandbox unable to reach the test Postgres at all — was sitting
        // in the check's own output the whole time.
        //
        // Logged for green as well as inconclusive: a check that PASSES
        // against untouched code is the other unproven reading, and its
        // author needs the same output to see why. Only `red` — the outcome
        // that proves the check works — stays quiet.
        //
        // The tail is bounded and credential-redacted by `checkOutputTail`
        // before it ever reaches here (POSTGRES_URL carries a password and
        // the failure prints the whole URL). `checkCommand` is
        // `buildCheckCommand`'s own output — a pnpm invocation with no
        // secrets in it — so it is safe to name in full, and naming it is
        // what makes the line reproducible by hand.
        if (mustFailFirst !== "red") {
          ctx.deps.logError(
            `[issue=${ctx.issueNumber}] check-writer: the must-fail-first ` +
              `proof came back '${mustFailFirst}' — ${verdict.reason}. ` +
              `Command: ${checkCommand}\n` +
              `--- tail of the check's own output ---\n` +
              `${verdict.outputTail ?? "(no output captured)"}\n` +
              `--- end of check output ---`,
          );
        }
        if (proofRanOnResumedWorktree && mustFailFirst !== "red") {
          // Recorded, never silent: this run shipped a check nobody proved on
          // it. It does not stop the ticket (see `mustFailFirstUnproven`), and
          // it should be rare — inheritance and a red proof both mint receipts
          // now, so getting here means the receipt could not be written, the
          // check was reformatted since, or this ticket was checkpointed
          // before receipts existed.
          ctx.deps.logError(
            `[issue=${ctx.issueNumber}] check-writer: the must-fail-first ` +
              `proof was re-run on a RESUMED worktree and came back ` +
              `'${mustFailFirst}'. That is not evidence the check is useless ` +
              `— the builder's work is already in this tree, so a check that ` +
              `passes here is a check whose fix landed. It is recorded and it ` +
              `does NOT stop the ticket. What it does mean is that this run ` +
              `holds no proof of its own: no valid receipt was carried in for ` +
              `${envelope.checkPath ?? "(no checkPath)"}.`,
          );
        }
        // The proof just came back RED. Write the durable receipt NOW, while
        // the check file is byte-for-byte what was proven — issue #916,
        // defect 2. `runCheckWriterStage`'s `ensureDirCommitted` commits the
        // whole check directory immediately after this returns, so the
        // receipt lands in the builder's hand-off baseline and travels with
        // any later checkpoint. Written ONLY for red: green and inconclusive
        // are the two readings that ride the one-retry-then-stop ladder, and
        // neither is a proof to carry anywhere.
        //
        // Best-effort by construction (`writeMustFailFirstReceipt` is total
        // and returns undefined on any failure): a receipt we fail to write
        // costs a resumed ticket one honest re-proof, never a false waiver.
        //
        // The BASIS is not always the pre-build one. On a resumed worktree
        // the builder's work is usually already in the tree, so a red result
        // here is real and worth carrying, but it was NOT observed "against
        // the code as it stood before the builder touched it" — which is what
        // this receipt's contract says. The record says which (2026-08-04
        // review).
        if (
          mustFailFirst === "red" &&
          sb.worktreePath !== undefined &&
          checkLocation !== undefined
        ) {
          const receipt = writeMustFailFirstReceipt(
            sb.worktreePath,
            checkLocation,
            proofRanOnResumedWorktree
              ? "proved-red-post-resume"
              : "proved-red-pre-build",
          );
          if (receipt === undefined) {
            ctx.deps.logError(
              `[issue=${ctx.issueNumber}] check-writer: the must-fail-first ` +
                `proof came back RED but its durable receipt could not be ` +
                `written to ${mustFailFirstReceiptRelPath(checkLocation)}. ` +
                `If this ticket is checkpointed and later resumed, nothing ` +
                `will say its check was ever proven: the proof re-runs against ` +
                `a worktree that already holds the builder's work, comes back ` +
                `green, and is recorded as a check that could not be proven on ` +
                `this run. It no longer STOPS the ticket (2026-08-04 review, ` +
                `blocker 4), but the resumed run will ship without a proof it ` +
                `already had. Worth looking at why this directory is not ` +
                `writable.`,
            );
          }
        }
      }
    }
  }

  return {
    marker,
    inherited,
    proofCarriedForward,
    proofRanOnResumedWorktree,
    screen: envelope.screen,
    // THE NORMALISED PATH, not the raw string the agent typed (issue #1235).
    // This value becomes `checkWriterCheckPathState`, whose only consumer is
    // the `CHECK_WRITER_CHECK_PATH` placeholder in the reviewer's prompt —
    // and that state is documented, where it is declared, as a BARE
    // filename. Returning the envelope string handed the reviewer
    // `issue-1058/x.test.ts` while the run itself used `x.test.ts`: the exact
    // doubled segment this branch exists to strip, leaking one layer further
    // out. Using the location's own path removes a disagreement rather than
    // creating one. The envelope string remains the fallback for
    // the case where no location could be built at all — there is nothing
    // normalised to report then.
    checkPath: checkLocation?.checkPath ?? envelope.checkPath,
    checkPackage: envelope.checkPackage,
    checkLocation,
    checkCommand,
    alreadyBuiltEvidence: envelope.alreadyBuiltEvidence,
    worldDataNeeded: envelope.worldDataNeeded,
    noScreenReason: envelope.noScreenReason,
    ticketQuestion: envelope.ticketQuestion,
    mustFailFirst: mustFailFirst as CheckWriterResult["mustFailFirst"],
    mustFailFirstReason,
    mustFailFirstOutputTail,
    mustFailFirstScreenUnreached,
    mustFailFirstTestCount,
    retried: attempt > 1,
    stdout: r.stdout,
  };
}

/**
 * The wire vocabulary `IssueTelemetryRow.checkWriterOutcome` speaks (issue
 * #911), delegated to `lib/checkwriter/outcome-key.ts` (issue #956).
 *
 * This was a `switch` over the four markers with its four return strings
 * spelled out AGAIN in a hand-written return-type union — the third copy of a
 * list `CHECK_WRITER_MARKERS` already owns. A marker added there and missed
 * here fell out of the switch as `undefined` and reached the telemetry bag,
 * which dropped it, leaving a blank column; the stale union meant the compiler
 * had nothing to object to. The local name survives only so this file's one
 * call site is untouched by that fix.
 */
function checkWriterOutcomeTelemetryKey(
  marker: CheckWriterMarker,
): CheckWriterOutcomeKey {
  return checkWriterOutcomeKey(marker);
}

/** What {@link runCheckWriterStage} decided: keep going, or the pipeline is done. */
export type CheckWriterStageResult =
  | {
      readonly proceed: true;
      readonly ctx: PipelineCtx;
      readonly preSha: string;
      /**
       * WHICH of the five things the check-writer said (issue #956). Threaded
       * to both ship paths, where `proofOfferedByMarker` turns it into the
       * strength of proof this ticket is offering and weighs that against what
       * the FINISHED diff demands — never against the claim at declaration
       * time, before a line of the builder's code existed.
       *
       * Replaces a `noScreenApplies` boolean. That boolean could only ask ONE
       * of the three questions the gate now asks, and it was a value derived
       * from this one sitting beside it: exactly the shape that goes stale on
       * the day a marker is added and nobody updates the derivation.
       */
      readonly marker: CheckWriterMarker;
      /**
       * WHICH RUNNER grades `checkCommand`, present exactly when it is. The
       * ship-time re-run must be given the same runner the must-fail-first
       * proof used, or it grades a vitest run by Playwright's rules — which
       * accepts a bare non-zero exit as a real failure and gives the run a
       * seven-minute browser budget.
       */
      readonly checkKind?: CheckKind;
      /**
       * The check the reviewer must treat as AUTHORITATIVE evidence, when
       * one exists (a real or inherited `CHECKS_WRITTEN`, or a
       * `UNIT_CHECK_WRITTEN` — absent for `NO_SCREEN_APPLIES`, which has no
       * check at all). Threaded into every `runReviewer` dispatch so
       * `review-prompt.md`'s `{{CHECK_WRITER_*}}` placeholders can tell the
       * reviewer which tests carry authority and which are the builder's own
       * scaffolding.
       */
      readonly checkPath?: string;
      /**
       * WHERE the committed check actually lives, and which runner grades it
       * (issue #1118). `checkPath` above is a BARE FILENAME with no directory,
       * so it cannot locate the file on disk — anything that must open the
       * real check needs this, the only value that can find it.
       * Present exactly when the marker wrote a check and the envelope named
       * a usable path.
       */
      readonly checkLocation?: CheckLocation;
      readonly checkCommand?: string;
      /**
       * The unit check's hosting package (`packages/<name>`), present exactly on
       * the unit route. Threaded so the ship-time re-run can rebuild a unit
       * command with a fresh nonce (issue #972 gap 1); the browser route needs
       * no package to rebuild.
       */
      readonly checkPackage?: string;
      readonly screen?: string;
      /**
       * How many graded scenarios the check-writer's check declares (issue
       * #1176) — `CheckWriterResult.mustFailFirstTestCount`, carried through
       * for the ship-time harness's `scaledCheckTimeoutBudgetMs` call.
       * `undefined` on every marker that wrote no check, mirroring
       * `checkKind`/`checkCommand` above.
       */
      readonly checkTestCount?: number;
      /**
       * SET WHEN THIS STAGE COULD NOT PRODUCE A GOOD FIRST TEST AND IS
       * PROCEEDING ANYWAY (#1198 A) — absent on every healthy ticket.
       *
       * Every one of the stops this replaces returned `proceed: false` and
       * spent nothing on a builder. That one stage produced 51 of 75 stops
       * since 2 August 2026, and 24 of 27 in the last two runs, on tickets
       * that had cost nothing yet; when a builder does run, 91 of 119
       * attempts ship. So the stage now hands the ticket on with this field
       * set, `runIssuePipeline` copies it onto `ctx`, and the reviewer's pass
       * becomes the only gate.
       *
       * The check artifacts beside it are still populated whenever a check
       * file was actually written: the reviewer is handed it as a PRE-FLIGHT
       * to run itself. What changes is that neither the ship-time proof gate
       * nor the ship-time harness may refuse on it — see
       * `shipAfterMigrations`.
       */
      readonly withoutFirstTest?: FirstTestFallThrough;
      /**
       * SET WHEN NO BUILD PASS MAY RUN BEFORE THE FIRST REVIEW (spec #1334,
       * SG): the check-writer answered `ALREADY_BUILT`. Either the worktree
       * was resumed from this ticket's own saved checkpoint and holds its
       * finished work, or the change is already in the code the worktree was
       * cut from. The ticket goes straight to the reviewer; a refusal is the
       * brief for an ordinary build round. Never handed to the owner.
       */
      readonly skipBuild?: ReviewSituation;
    }
  | { readonly proceed: false; readonly outcome: IssueOutcome };

/**
 * Best-effort current sha of the sandbox worktree, falling back to `preSha`
 * when there is no worktree to read (a legacy/test double handle). Used ONLY
 * by the check-writer's three stop paths to populate `IssueOutcome.postSha`
 * — without it, `recordReworkOutcome` silently DROPS the rework-store record
 * (it refuses to write with no non-empty `shippedSha`; see
 * `rework-store.ts`'s own doc comment on why a bare `HALT` with no sha is
 * "correctly dropped"), and these three stops would then never prove up in
 * `.sandcastle/telemetry/issues.jsonl` at all.
 */
async function currentSandboxSha(
  sandbox: SandboxHandle,
  preSha: string,
  ctx: PipelineCtx,
): Promise<string> {
  return sandbox.worktreePath
    ? await ctx.deps.captureSha(sandbox.worktreePath)
    : preSha;
}

/**
 * Apply one of the stop labels (issue #914's five, issue #923's four)
 * and note the
 * durable telemetry record — best-effort, mirroring `commentBestEffort`
 * above: a failure here must never crash the pipeline (the issue is ALREADY
 * quarantined via `needs-human` by the time this is called; this only adds
 * the finer-grained label, the body section, and the record).
 *
 * `detail` is the SAME human-readable text that goes into the issue body's
 * stop section AND the durable record's `stopReason.detail` — one piece of
 * prose, not paraphrased twice into two surfaces that can drift.
 */
async function reportStopBestEffort(
  ctx: PipelineCtx,
  label: StopReasonLabel,
  detail: string,
  disagreement?: DisagreementEvidence,
): Promise<void> {
  ctx.telemetry?.noteStopReason({ label, detail, disagreement });
  try {
    await ctx.deps.reportStop?.(ctx.issueNumber, { label, detail, disagreement });
  } catch (e) {
    ctx.deps.logError(
      `reportStop(${label}) failed for issue #${ctx.issueNumber}: ${(e as Error).message}`,
    );
  }
}

/**
 * The label-only twin of {@link reportStopBestEffort} (issue #923).
 *
 * Used by the two stop sites that ALREADY post a GitHub comment carrying
 * their full explanation — the skills-discipline gate and the stuck-detector
 * (the design-critique gate was a third until spec #1334 deleted it). **Owner
 * decision, 2026-08-16: that comment stays exactly where it is.** What they
 * lacked was a label, because a comment cannot be counted: without one, those
 * stop kinds are invisible to any tally of what the run did last night.
 *
 * `detail` still reaches the DURABLE RECORD (`ctx.telemetry.noteStopReason`)
 * as a one-line summary, which is not the issue body and does not conflict
 * with that ruling — it is what makes the stop countable with a reason
 * attached rather than as a bare tick.
 */
async function applyStopLabelBestEffort(
  ctx: PipelineCtx,
  explanation: StopExplanation,
): Promise<void> {
  ctx.telemetry?.noteStopReason({
    label: explanation.label,
    detail: explanation.detail,
  });
  if (ctx.deps.applyStopLabel === undefined) {
    // Never in production — `buildDefaultDeps` always supplies it. Said out
    // loud anyway: a silent no-op here would look identical to a stop that
    // was labelled, which is the shape of blindness this whole change exists
    // to remove.
    ctx.deps.logError(
      `applyStopLabel is not wired for issue #${ctx.issueNumber} — the stop ` +
        `is recorded but carries no ${explanation.label} label, so it will ` +
        `not appear in any count of tonight's stops.`,
    );
    return;
  }
  try {
    await ctx.deps.applyStopLabel(ctx.issueNumber, {
      label: explanation.label,
    });
  } catch (e) {
    ctx.deps.logError(
      `applyStopLabel(${explanation.label}) failed for issue #${ctx.issueNumber}: ${(e as Error).message}`,
    );
  }
}

/**
 * Put a first-test fall-through on the record: the telemetry counter and the
 * section on the issue BODY. Shared by the pre-build fall-through
 * ({@link buildAnywayWithoutFirstTest}) and the post-build one
 * (`rewriteFirstTestOnce`, spec #1334).
 *
 * Best-effort: a GitHub hiccup is logged, never thrown, so it can never turn
 * "go on without a first test" back into a stop. Double-optional on the bag,
 * like `ctx.status?.noteProgress?.()`: test doubles are hand-rolled partials.
 */
async function recordFirstTestFallThrough(
  ctx: PipelineCtx,
  fallThrough: FirstTestFallThrough,
): Promise<void> {
  ctx.telemetry?.noteFirstTestFallThrough?.(fallThrough.reason);
  try {
    await ctx.deps.applyFirstTestFallThroughReport?.(ctx.issueNumber, fallThrough);
  } catch (e) {
    ctx.deps.logError(
      `applyFirstTestFallThroughReport(${fallThrough.reason}) failed for issue ` +
        `#${ctx.issueNumber}: ${(e as Error).message}. The ticket still goes ` +
        `on — only the note on it is missing.`,
    );
  }
}

/**
 * BUILD ANYWAY (#1198 A) — the one place every first-test fall-through goes.
 *
 * ## The decision this implements
 *
 * The loop writes an independent test for a ticket before any code exists.
 * When it could not make that test good, it stopped the ticket and wrote no
 * code. On the loop's own records that single stage produced 51 of 75 stops
 * since 2 August 2026, and 24 of 27 in the last two runs — every one of them
 * with nothing spent on a builder. When a builder does run, 91 of 119
 * attempts ship, and three tickets killed this way were built by hand
 * afterwards and passed review first try.
 *
 * Owner's rule: when the first test cannot be made good, BUILD ANYWAY and let
 * the reviewer decide. So this function does what the stop it replaces did —
 * writes the diagnosis where a person will find it — and then hands the
 * ticket on.
 *
 * ## What it deliberately does NOT do
 *
 * It does not call `ctx.deps.quarantine`, and it applies no `stopped:*`
 * label. Both would mark a ticket held that is about to have a builder
 * dispatched on it, which is the exact misreading this ticket exists to end:
 * a `stopped:*` label is what every triage query, the eligible-set gate's
 * `Blocked-by:` rule and the run report all read as "this one is
 * parked".
 *
 * ## Why the body write cannot refuse the build
 *
 * The write is best-effort and its failure is logged, never thrown — the same
 * discipline `reportStopBestEffort` follows. A GitHub hiccup must not be able
 * to turn "build anyway" back into the stop it replaced; that would make the
 * owner's rule conditional on the API being up.
 */
async function buildAnywayWithoutFirstTest(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  opts: {
    readonly reason: FirstTestFallThrough["reason"];
    /** The diagnosis for the issue BODY — what the stop used to write. */
    readonly detail: string;
    /** The host run-log line. Says "building anyway", never "stopped". */
    readonly logLine: string;
    /**
     * The marker the ticket proceeds under.
     *
     * `ALREADY_BUILT` and `NEEDS_WORLD_DATA` are NORMALIZED AWAY here rather
     * than forbidden at the call sites, and the normalization is the whole
     * reason this parameter is not just read off `check`. Both offer no proof
     * at all (`proofOfferedByMarker` returns `undefined`), which the ship-time
     * gate refuses as `check-writer-marker-cannot-ship` and never waives — so
     * a fall-through carrying one would silently trade the stop it just
     * avoided for a stop at the ship funnel three agents later, which is worse
     * than either. `NO_SCREEN_APPLIES` is the honest reading: this ticket has
     * no usable check. Normalizing in ONE place means a caller passing
     * `result.marker` straight through — which every ladder site does, because
     * the ladder's own control flow already rules those two out — cannot be
     * the site that gets it wrong.
     */
    readonly marker: CheckWriterMarker;
    /**
     * The check-writer's result, when one was ever parsed. Present means the
     * reviewer is handed a real check to run as a pre-flight; absent means
     * this ticket genuinely has no check at all.
     */
    readonly check?: CheckWriterResult;
  },
): Promise<CheckWriterStageResult> {
  ctx.deps.logError(opts.logLine);
  const cannotShip =
    opts.marker === "ALREADY_BUILT" || opts.marker === "NEEDS_WORLD_DATA";
  if (cannotShip) {
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] first-test fall-through carried marker ` +
        `${opts.marker}, which offers no proof and cannot pass the ship-time ` +
        `gate. Proceeding as NO_SCREEN_APPLIES — this ticket has no usable ` +
        `check, and saying so is the only reading that lets the reviewer ` +
        `decide instead of the ship funnel refusing hours later.`,
    );
  }
  const marker: CheckWriterMarker = cannotShip
    ? "NO_SCREEN_APPLIES"
    : opts.marker;
  // A normalized marker means "no check", so no check artifacts may ride
  // along — `finishCheckWriterStage` drops them on that marker anyway, and
  // passing them would only make the two disagree.
  const check = cannotShip ? undefined : opts.check;
  const fallThrough: FirstTestFallThrough = {
    reason: opts.reason,
    detail: opts.detail,
  };
  await recordFirstTestFallThrough(ctx, fallThrough);
  return await finishCheckWriterStage(
    ctx,
    sandbox,
    preSha,
    marker,
    check,
    fallThrough,
  );
}

/**
 * The check-writer's stdout could not be parsed into a valid envelope at
 * all — `parseVerdict` threw `VerdictParseError` (issue #911's schema
 * module: no marker, no fenced JSON block, malformed JSON, or a
 * schema-validation failure such as an unsafe `checkPath`). Piece D's four
 * outcomes all assume a PARSEABLE envelope; this is a fifth, unmodelled
 * failure mode.
 *
 * BEFORE THE #914 FIX: `runCheckWriter` let `VerdictParseError` propagate
 * straight out of `runCheckWriterStage`, past every stop path this module
 * defines, into `runIssuePipeline`'s generic `catch` block — which has no
 * `instanceof VerdictParseError` arm, so a malformed envelope fell through
 * to the opt-in recovery pass and could ship as `RECOVERY_COMPLETE` with NO
 * check-writer pass at all. Routing it through this function's single,
 * modelled return closes that hole structurally: it can never reach the
 * fixer (the recovery pass's successor, spec #1334 SG), because it never
 * throws past here.
 *
 * SINCE #1198 A IT BUILDS RATHER THAN STOPS. It used to quarantine
 * `stopped:no-failing-check`, and that label is exactly the bucket the
 * measurement behind #1198 came from: an unreadable envelope killed the
 * ticket before a builder ever ran, over a fault that is the LOOP's clerical
 * failure — its own agent formatted an answer nobody could read — and not
 * a statement about whether the ticket's work is doable. The ticket now
 * proceeds with no check at all (`NO_SCREEN_APPLIES`, the honest reading:
 * there is no check to run, lock or re-run) and the reviewer decides.
 */
async function buildAnywayUnusableCheckWriterEnvelope(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  err: VerdictParseError,
  attempt: number,
): Promise<CheckWriterStageResult> {
  return await buildAnywayWithoutFirstTest(ctx, sandbox, preSha, {
    reason: "no-failing-check",
    logLine:
      `[issue=${ctx.issueNumber}] first-test fall-through (#1198) — the ` +
      `check-writer's attempt ${attempt} output could not be parsed into a ` +
      `valid envelope, so this ticket has NO first test. Building anyway; ` +
      `the reviewer's pass is the only gate. ${err.message.slice(0, 500)}`,
    detail:
      `The check-writer's output (attempt ${attempt}) could not be parsed ` +
      `into a valid envelope — no marker, malformed JSON, or a schema ` +
      `violation (e.g. an unsafe \`checkPath\` — see ` +
      `\`lib/checkwriter/schema.ts\`). That is the loop's own agent failing ` +
      `to format an answer, not a finding about this ticket, so the builder ` +
      `was dispatched with no first test at all.\n\n` +
      // safeFence, not a bare ```: the check-writer's parse errors quote the
      // agent's own stdout, which routinely contains fenced blocks that would
      // otherwise close this one early and mangle the issue body.
      `Raw parse error:\n\n${safeFence(err.message.slice(0, 2000))}`,
    // No envelope parsed, so there is no check and no marker to carry.
    // `NO_SCREEN_APPLIES` is the one marker that means exactly that.
    marker: "NO_SCREEN_APPLIES",
  });
}

/**
 * Finding #2 (2026-08-04 review): the check-writer's own outcome marker (last
 * line) disagreed with its own JSON envelope's `marker` field (fenced block)
 * — see {@link CheckWriterMarkerEnvelopeMismatchError}'s doc comment for the
 * silent-both-gates-off mechanism this guards against.
 *
 * Neither reading can be trusted over the other, so NEITHER is used: the
 * ticket proceeds with no check at all (`NO_SCREEN_APPLIES`, the honest
 * reading), which keeps both ship-time gates from being disarmed by a
 * half-believed envelope.
 *
 * SPEC #1334 (SF1) — THIS NO LONGER REACHES THE OWNER. It used to stop as
 * `stopped:check-disagreement` + `needs-human`, "the owner breaks the tie".
 * Owner decision: a first-test problem never stops a ticket and is never
 * handed to him — it is the loop's own agent failing to format an answer,
 * and he would only pass it straight to a session. So it takes the one
 * first-test outcome every other road takes: build, review, ship labelled
 * `shipped-without-first-test`, with the contradiction written on the body.
 *
 * NOT reached for the one pair the loop CAN settle itself (2026-09-10): the
 * two "written" markers over each other, which `reconcileCheckWriterMarkers`
 * resolves to the envelope with a warning instead of an error — see
 * `runCheckWriter`'s call to it, and the #1249/#1235 story on the function.
 */
async function buildAnywayCheckWriterMarkerMismatch(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  err: CheckWriterMarkerEnvelopeMismatchError,
  attempt: number,
): Promise<CheckWriterStageResult> {
  return await buildAnywayWithoutFirstTest(ctx, sandbox, preSha, {
    reason: "no-failing-check",
    logLine:
      `[issue=${ctx.issueNumber}] first-test fall-through — the ` +
      `check-writer's attempt ${attempt} output disagreed with itself: ` +
      `outcome marker said "${err.lineMarker}", envelope said ` +
      `"${err.envelopeMarker}". Neither reading is used, so this ticket has ` +
      `NO first test. Building anyway; the reviewer's pass is the only gate.`,
    detail:
      `The check-writer's own output disagreed with itself (attempt ` +
      `${attempt}): the outcome marker on the last line said ` +
      `\`${err.lineMarker}\`, but the fenced JSON envelope's own \`marker\` ` +
      `field said \`${err.envelopeMarker}\`. Neither reading can be trusted ` +
      `over the other, so neither was used: the builder was dispatched with ` +
      `no first test at all, and the reviewer's pass is the gate.`,
    marker: "NO_SCREEN_APPLIES",
  });
}

/**
 * Dispatch the check-writer, apply its one allowed retry (Piece D:
 * "must-fail-first"), and decide whether `runIssuePipeline` proceeds to the
 * implementer or stops the ticket here. This is the ONLY place the four
 * outcomes are routed — see the design-lock doc's "all four must be
 * distinctly wired": each of `ALREADY_BUILT`, `NEEDS_WORLD_DATA`, and
 * "green twice" gets its own quarantine reason and its own issue comment, so
 * they read as different events to whoever triages a stopped ticket, never
 * as the same generic failure.
 *
 * On a PROCEED result, returns a (possibly UPDATED) `ctx` and `preSha`:
 *
 *   - `preSha` advances to the sha AFTER the check-writer's own commit (if
 *     it made one) — "the state the builder is handed", which is what
 *     `enforceProtectedPaths` must restore to if the builder tampers with
 *     the check file. Using the pipeline's ORIGINAL preSha there would make
 *     the check-writer's own freshly-added file read as "didn't exist at
 *     base", and a tamper "restore" would DELETE it instead of putting it
 *     back.
 *   - `ctx.protectedPathGlobs` gains the per-issue check directory glob —
 *     `PipelineCtx`'s own doc comment names this exact seam. Populated only
 *     from THIS point forward, never earlier: the check-writer's own
 *     authoring pass must be able to create the file in the first place, so
 *     the directory cannot be protected while it is still being written.
 */
/**
 * Did this check-writer pass FAIL to prove its check can fail — and if so, in
 * which of the two ways? `undefined` means the proof genuinely came back red,
 * or that no proof was owed (an inherited check, or a marker that writes no
 * check at all).
 *
 * Asks `checkKindForMarker` rather than naming the check markers again (issue
 * #956): this is one of the four places that must agree about "does this
 * outcome produce a check", and the day a sixth marker arrives, a hand-written
 * `!== "CHECKS_WRITTEN"` here would quietly answer `undefined` — i.e. "nothing
 * to prove" — for an outcome that does write a check.
 *
 * The two unproven readings ride the SAME one-retry-then-stop ladder, which
 * is the correction made by the 2026-08-04 review (F2). Only `"green"` used
 * to count:
 *
 *   - `"green"` — the check ran and PASSED against untouched code. It cannot
 *     fail, so its later green says nothing.
 *   - `"inconclusive"` — the check never produced a result at all: it timed
 *     out, could not be spawned, or emitted no Playwright tally line to prove
 *     it ran (`classifyCheckRun`). Nothing was proven EITHER WAY, so its
 *     later green says exactly as little.
 *
 * Reading the second as "fine, carry on" made the whole must-fail-first rule
 * waivable by anything that merely made a night slow — and the budget half of
 * the same finding meant the proof was routinely given less time than a cold
 * dev-server boot alone (see `runCheckCommand`'s own doc comment). The
 * ship-time harness gate has always stopped on its own `inconclusive`, on the
 * stated principle that a ticket which cannot produce proof stops instead of
 * shipping; this is that same principle applied at the other end of the
 * pipeline.
 *
 * They are kept DISTINGUISHABLE rather than collapsed into one boolean
 * because the two stops need different words: "your check passes on broken
 * code" is a check-authoring problem, "we could not run your check" is
 * usually an environment problem, and a human triaging the quarantine acts on
 * them differently.
 */
function mustFailFirstUnproven(
  result: CheckWriterResult,
): "green" | "inconclusive" | undefined {
  if (checkKindForMarker(result.marker) === undefined) return undefined;
  if (result.inherited) return undefined;
  // ONE EXCEPTION, and it is the whole of blocker 4 (2026-08-04 review). When
  // the proof ran against a worktree cut from a WIP checkpoint, the builder's
  // work is usually already in it — so green there says "the fix works", not
  // "this check cannot fail", and reading it as the latter quarantines a
  // healthy ticket and abandons the checkpointed work. Nothing about that
  // reading is salvageable: there is no untouched code left on a resumed
  // branch to run the proof against, so a re-run cannot settle it either.
  // The verdict is still RECORDED (the caller notes it on telemetry before
  // asking this question) — it just cannot spend the ladder or stop anything.
  if (result.proofRanOnResumedWorktree) return undefined;
  return result.mustFailFirst === "green" ||
    result.mustFailFirst === "inconclusive"
    ? result.mustFailFirst
    : undefined;
}

/**
 * Everything one check-writer pass puts on the durable record. Both of
 * `runCheckWriterStage`'s passes (first attempt and the one retry) note the
 * identical set, so they live here rather than being spelled twice — a field
 * added to one and forgotten in the other is exactly how
 * `proofCarriedForward` came to be computed, returned and consumed by nothing
 * (2026-08-04 review).
 */
function noteCheckWriterTelemetry(
  ctx: PipelineCtx,
  result: CheckWriterResult,
): void {
  ctx.telemetry?.noteCheckWriterOutcome(
    checkWriterOutcomeTelemetryKey(result.marker),
  );
  if (result.inherited) ctx.telemetry?.noteCheckWriterInherited();
  if (result.proofCarriedForward) {
    ctx.telemetry?.noteCheckWriterProofCarriedForward();
  }
  if (result.mustFailFirst !== undefined) {
    ctx.telemetry?.noteCheckWriterMustFailFirst(result.mustFailFirst);
  }
}

/**
 * A CHECK THAT COULD NEVER FAIL — shared by every road the proof ladder can
 * exhaust: a check that came back green twice, a check that could never be
 * run to a confirmed result, and a check-writer refused for a missing graded
 * helper that still could not produce a provable check (issue #884's retry).
 *
 * Every sentence this writes names `result.mustFailFirstReason` — the
 * classifier's own words for WHY the proof did not come back red. It used to
 * name nothing: on 2026-08-05 the sandbox could not reach the test Postgres,
 * and two tickets were killed with a message that would have read identically
 * for a slow night, a wedged container or a badly-written check.
 *
 * ## Since #1198 A this BUILDS rather than stops
 *
 * This was `stopped:no-failing-check`, and it is the single largest source of
 * the 51-of-75 stops the owner's decision was measured from. The reasoning
 * that made it a stop is still true — a check that cannot fail proves nothing,
 * so its later green means nothing — but the conclusion drawn from it was
 * wrong: an unprovable check is a fact about the CHECK, and killing the ticket
 * over it throws away work whose code nobody has looked at yet. The check (and
 * the reviewer's own run of it) still travels with the ticket as evidence; it
 * is simply no longer the gate. The reviewer's pass is.
 */
async function buildAnywayNoFailingCheck(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  result: CheckWriterResult,
  stillUnproven: "green" | "inconclusive",
  /**
   * The REAL history (2026-09-01): how many times the check-writer was
   * dispatched on this ticket, and how many of its proofs were actually
   * OBSERVED green. The stop used to hard-code "twice, and both times it
   * PASSED" — a false history on the missing-helper road (attempt 1 was
   * refused statically and never ran a proof) and after the budgeted third
   * rewrite (three dispatches, not two).
   */
  history: { readonly writerAttempts: number; readonly greenProofs: number },
): Promise<CheckWriterStageResult> {
  // `(no reason recorded)` is reachable only from a CheckWriterResult built
  // before this field existed (a WIP checkpoint resumed across the upgrade),
  // so it stays a stated absence rather than an empty clause.
  const why = result.mustFailFirstReason ?? "(no reason recorded)";
  const times = (n: number): string =>
    n === 1 ? "once" : n === 2 ? "twice" : `${n} times`;
  const attempts = times(history.writerAttempts);
  const greens = times(history.greenProofs);
  const logLine =
    stillUnproven === "green"
      ? `[issue=${ctx.issueNumber}] first-test fall-through (#1198) — the ` +
        `check-writer was dispatched ${attempts} and its check's proof was ` +
        `observed to PASS against untouched code ${greens}, the final ` +
        `attempt included (screen: ${result.screen ?? "(not stated)"}). A ` +
        `check that cannot fail proves nothing — building anyway; the ` +
        `reviewer's pass is the only gate. Last proof verdict: ${why}`
      : `[issue=${ctx.issueNumber}] first-test fall-through (#1198) — the ` +
        `check-writer was dispatched ${attempts} and on the final attempt ` +
        `its check could not be run to a confirmed result (screen: ` +
        `${result.screen ?? "(not stated)"}). Nothing proves it can fail, so ` +
        `nothing would make its later green mean anything — building anyway; ` +
        `the reviewer's pass is the only gate. Last proof verdict: ${why}`;
  return await buildAnywayWithoutFirstTest(ctx, sandbox, preSha, {
    reason: "no-failing-check",
    logLine,
    detail:
      stillUnproven === "green"
        ? `The check-writer was dispatched ${attempts} for this ticket, and ` +
          `its check's proof run PASSED against the untouched, pre-fix code ` +
          `${greens} — the final attempt included. A check that can't fail ` +
          `proves nothing (docs/specs/2026-08-04-screen-check-design-lock.md, ` +
          `Piece D). Screen: \`${result.screen ?? "(not stated)"}\`.\n\n` +
          `What the loop observed on the final attempt: \`${why}\``
        : `The check-writer was dispatched ${attempts} for this ticket, and ` +
          `on the final attempt the loop could not run its check to a ` +
          `confirmed result against the untouched, pre-fix code — it timed ` +
          `out, could not be spawned, produced no Playwright tally line to ` +
          `prove it ran at all, or never proved it reached its screen. That ` +
          `is not "the check failed" and it is not "the check passed"; it is ` +
          `no proof either way, and a check nobody has ever seen fail proves ` +
          `nothing when it later comes back green ` +
          `(docs/specs/2026-08-04-screen-check-design-lock.md, Piece D). ` +
          `Screen: \`${result.screen ?? "(not stated)"}\`.\n\n` +
          `What the loop observed on the final attempt: \`${why}\`\n\n` +
          `The run log holds a redacted tail of the check's own output for ` +
          `this issue — that is where an environment fault (an unreachable ` +
          `test database, a dev server that never booted) actually names ` +
          `itself.`,
    // The check itself is real and still travels with the ticket: the
    // reviewer runs it as a pre-flight. What it may no longer do is decide.
    marker: result.marker,
    check: result,
  });
}

/**
 * The brief handed to a check-writer retry after its check PASSED the
 * must-fail-first proof against untouched code (2026-08-31). Until then that
 * retry was dispatched BLIND — the classifier's reason reached only the host
 * run log, and the second attempt was told nothing about why the first was
 * rejected, so it routinely rewrote the wrong thing or resubmitted the same
 * shape.
 *
 * SAME REDACTION DISCIPLINE AS `firstTestRewriteBrief`: the check-writer is
 * told the REASON only, never the
 * application's output. An earlier version of this brief quoted a 4 KiB
 * redacted tail of the run's own output, and the 2026-09-01 review removed
 * it: even PRE-FIX app output is observed behaviour, and observed behaviour
 * in the brief invites the cheapest possible rewrite — an assertion that
 * merely negates what was observed ("not X"), guaranteed red today and
 * weakly green after any change at all, which is a weak check minted by the
 * repair channel itself. What survives is the classifier's one-line verdict:
 * harness-level facts only (which colour the run proved, whether the bound
 * fired, whether the evidence line arrived) with no app text, no figures and
 * no DOM in it. The full tail still reaches the host run log
 * (`writeCheckRunLog`) for a person.
 */
export function mustFailFirstRetryBrief(opts: {
  readonly reason: string | undefined;
}): string {
  return [
    "Your previous check for this ticket was REJECTED: the loop ran it against",
    "the untouched, pre-fix code and it PASSED. A check that cannot fail",
    "proves nothing, so it was refused and you are being dispatched again.",
    "",
    "**Why the proof rejected it (the host's own classifier, verbatim):**",
    opts.reason ?? "(no reason recorded)",
    "",
    "The run's application output is deliberately withheld — you get the",
    "reason only, never what the app was observed to show. In particular, do",
    'not write an assertion that merely negates an observed value ("not X"):',
    "it goes red today and weakly green after any change at all. Assert the",
    "value the ticket REQUIRES.",
    "",
    "Any `.spec.ts`/`.test.ts` already sitting in this ticket's check directory",
    "is that rejected attempt — YOUR OWN previous try, not an inherited check.",
    "The inherit-and-leave-untouched rule does not apply to it. Rewrite it (or",
    "replace it outright) so it goes RED against the code as it stands today.",
    "",
    "This brief tells you why the proof failed. It does not tell you the value",
    "the finished fix should produce, and nothing above may be used as an",
    "expected figure: choose what you assert by the ticket's own rules, never",
    "by what the application was observed to do.",
  ].join("\n");
}

/**
 * The brief handed to the ONE re-ask a check-writer's envelope gets when
 * `parseVerdict` cannot make sense of it — no JSON fence, invalid JSON, or a
 * schema violation, most commonly a `.test.ts` filename on a `CHECKS_WRITTEN`
 * envelope or a `.spec.ts` filename on `UNIT_CHECK_WRITTEN` (fault 2,
 * 2026-09-01: ticket #1126's writer did exactly this on attempt 2 and the
 * ticket died with no retry — a mis-labelled envelope, not a broken check).
 *
 * The implementer already gets this exact one-shot re-ask (`envelopeReask`,
 * `runImplementer`'s `VerdictParseError` catch) — this is the check-writer's
 * missing counterpart. Deliberately distinct from `CheckWriterMarkerEnvelopeMismatchError`
 * (issue #914's last-line-vs-JSON-marker disagreement), which stays loud
 * with NO retry: that failure means the agent's own two signals of what it
 * did disagree with each other, which a re-ask cannot resolve. A schema
 * violation, by contrast, IS resolvable — the agent knows what it wrote, it
 * just filed the marker wrong — so one re-ask is warranted here and not
 * there.
 *
 * `err.message` is quoted verbatim, same discipline as `missingHelperRetryBrief`:
 * the parse error already names exactly what was wrong, so the fix is telling
 * the writer to re-emit the SAME envelope under the marker its own filename
 * implies — never to rewrite the check itself.
 */
export function envelopeRetryBrief(err: VerdictParseError): string {
  return [
    "Your previous check-writer output for this ticket could not be parsed",
    "into a valid envelope. You are being dispatched again, ONCE, to re-emit",
    "it correctly.",
    "",
    "**Why it could not be parsed (verbatim):**",
    err.message,
    "",
    "The filename decides the marker: a `.spec.ts` check belongs under",
    "`CHECKS_WRITTEN`; a `.test.ts` filename belongs in `UNIT_CHECK_WRITTEN`,",
    "with its own `checkPackage` field set. Mixing them — a `.test.ts`",
    "filename on `CHECKS_WRITTEN`, or a `.spec.ts` filename on",
    "`UNIT_CHECK_WRITTEN` — is rejected.",
    "",
    "Re-emit the WHOLE envelope with the marker that matches your filename.",
    "Do not rewrite the check itself — the check you already wrote may well",
    "be correct; only the envelope around it was wrong.",
  ].join("\n");
}

/**
 * The brief handed to a check-writer retry after its proof run produced a
 * result the classifier could not tie to the screen — the runner reported a
 * colour, but no grade mark, no refusal sentinel and no nonce-keyed settled
 * record says the check ever REACHED the screen it claims to grade
 * (2026-09-01, the environment split's third road).
 *
 * This shape repeated on a re-run of the exact same check, so it is almost
 * always the CHECK's own deterministic fault — a bad import, a dead route, a
 * hand-rolled wait that dies before `waitForGradableScreen` — not the
 * sandbox's. Ruling 6 discipline as above: the reason only, no app output.
 */
export function unreachedScreenRetryBrief(opts: {
  readonly reason: string | undefined;
}): string {
  return [
    "Your previous check for this ticket was REJECTED: the loop ran it twice",
    "against the untouched, pre-fix code, and both times it finished WITHOUT",
    "ever proving it reached the screen it claims to grade — no grade mark, no",
    "screen-check sentinel, and no settled record from `waitForGradableScreen`.",
    "A check that cannot look at the screen cannot prove a wrong figure,",
    "whichever colour it comes back, so it was refused and you are being",
    "dispatched again.",
    "",
    "**Why the proof rejected it (the host's own classifier, verbatim):**",
    opts.reason ?? "(no reason recorded)",
    "",
    "The usual causes are the check's own: a broken import, a route that does",
    "not exist, or a hand-rolled wait/assertion that dies before",
    "`waitForGradableScreen` ever runs. Rewrite the check so it signs in,",
    "navigates to the ticket's screen, and calls `waitForGradableScreen` and",
    "`gradeScreenText` for real — the failure it produces must come from those",
    "helpers or after them, or the harness cannot read it.",
    "",
    "Any `.spec.ts`/`.test.ts` already sitting in this ticket's check directory",
    "is that rejected attempt — YOUR OWN previous try, not an inherited check.",
    "The inherit-and-leave-untouched rule does not apply to it.",
    "",
    "The run's application output is deliberately withheld — you get the",
    "reason only. Choose what you assert by the ticket's own rules, never by",
    "what the application was observed to do.",
  ].join("\n");
}

/**
 * The brief handed to the retry after a static-scan refusal — the check never
 * called a required graded helper (or, on the unit route, never bound to real
 * product code). The refusal message already names the exact missing call;
 * until 2026-08-31 the log CLAIMED the second attempt was handed that name
 * while no channel actually carried it. This is the channel.
 */
export function missingHelperRetryBrief(
  err: CheckWriterMissingGradedHelperError,
): string {
  return [
    "Your previous check for this ticket was REFUSED before it was ever run:",
    "a static read of the file found it does not meet a structural requirement",
    "every check must meet. The refusal, verbatim, naming exactly what is",
    "missing:",
    "",
    err.message,
    "",
    "Any `.spec.ts`/`.test.ts` already sitting in this ticket's check directory",
    "is that refused attempt — YOUR OWN previous try, not an inherited check.",
    "Rewrite it so it makes the named call(s) for real — imported and invoked",
    "in live code, not mentioned in a comment or a string.",
  ].join("\n");
}

/**
 * Change 3 of the 2026-08-31 self-heal work: an INCONCLUSIVE must-fail-first
 * proof — a timeout, a spawn failure, no nonce-signed evidence line, a
 * connection-refused tail — is the ENVIRONMENT failing to produce evidence,
 * not the check failing to be a check. Re-dispatching the check-writer over it
 * burned the ticket's one writer retry on a fault no rewrite can touch, and
 * two of those in a row quarantined the ticket under a label that blamed it.
 *
 * So an inconclusive proof retries the RUN, exactly once: the same committed
 * check file, the same command (same nonce — deliberately, matching the
 * ship-time re-run's own documented reuse), no rewrite. A red on the re-run is
 * a real red and mints the same durable receipt the first-run red would have;
 * a green is a real green and rejoins the ordinary ladder; a second
 * inconclusive is settled by the caller (`settleInconclusiveProof`): the
 * environment shapes stop as `stopped:run-fault`, and the screen-unreached
 * shape goes to the briefed writer-retry road instead (2026-09-01).
 *
 * Returns the result UPDATED with the re-run's reading — never mutates the
 * one it was given.
 */
async function rerunInconclusiveProof(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  result: CheckWriterResult,
  /** Why the proof is run again: the first run was inconclusive, or a frozen
   *  file the first run depended on was edited and has just been restored. */
  why: "inconclusive" | "restored" = "inconclusive",
): Promise<CheckWriterResult> {
  const kind = checkKindForMarker(result.marker);
  const nonce =
    result.checkCommand !== undefined
      ? checkNonceFromCommand(result.checkCommand)
      : undefined;
  if (
    kind === undefined ||
    result.checkCommand === undefined ||
    nonce === undefined
  ) {
    // Nothing runnable to retry — the first inconclusive already named why
    // (no runnable command / no worktree to read). Hand back unchanged; the
    // caller settles it as an environment fault.
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] check-writer: the must-fail-first proof was ` +
        `inconclusive and there is no runnable command to retry — treating it ` +
        `as an environment fault without a re-run.`,
    );
    return result;
  }
  ctx.deps.log(
    why === "restored"
      ? `[issue=${ctx.issueNumber}] check-writer: a frozen file the ` +
          `must-fail-first proof ran against was edited and has been restored — ` +
          `running the proof again on the restored files (same check file).`
      : `[issue=${ctx.issueNumber}] check-writer: the must-fail-first proof was ` +
          `INCONCLUSIVE — that reads as the environment failing to produce ` +
          `evidence, not the check failing to be a check. Retrying the RUN once ` +
          `(same check file, no rewrite) before deciding anything.`,
  );
  // Scaled by scenario count (issue #1176), same reasoning as the first
  // attempt in `runCheckWriter`: a static read of the SAME committed check
  // this is about to re-run, byte-identical to the base budget when the read
  // fails or finds one scenario.
  const staticTestCount = checkScenarioCountFor(
    sandbox.worktreePath,
    result.checkLocation,
  );
  // #1198 second review, F3 — KEEP THE STALL WATCHDOG'S CLOCK FRESH. The first
  // proof run and this re-run sit back to back inside ONE phase with nothing
  // between them, so the phase can legitimately consume 2 x the check timeout
  // ceiling. #1198 C raised that ceiling from 15 to 45 minutes, which makes the
  // pair 90 minutes — the watchdog's ENTIRE window — and a healthy re-run would
  // be SIGKILLed for making no progress while it was doing exactly what it was
  // asked to. Same discipline as the check-writer's envelope re-ask;
  // optional-chained for the same reason it is, so a ctx without a status
  // sink is not a crash.
  ctx.status?.noteProgress?.();
  const verdict = await runCheckCommand(
    kind,
    sandbox.exec,
    result.checkCommand,
    "red",
    nonce,
    scaledCheckTimeoutBudgetMs(kind, staticTestCount),
    {
      repoRoot: ctx.args.repoRoot,
      branch: sandbox.branch,
      issueNumber: ctx.issueNumber,
      phase: "must-fail-first" as const,
      worktreePath: sandbox.worktreePath,
      onError: ctx.deps.logError,
    },
    result.screen,
  );
  const reading: NonNullable<CheckWriterResult["mustFailFirst"]> =
    verdict.status === "pass"
      ? "red"
      : verdict.status === "fail"
        ? "green"
        : "inconclusive";
  if (reading !== "red") {
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] check-writer: the re-run of the ` +
        `must-fail-first proof came back '${reading}' — ${verdict.reason}. ` +
        `Command: ${result.checkCommand}\n` +
        `--- tail of the check's own output ---\n` +
        `${verdict.outputTail ?? "(no output captured)"}\n` +
        `--- end of check output ---`,
    );
  }
  // A red on the re-run is as real as a first-run red, so it earns the same
  // durable receipt — without one, a checkpoint/resume would re-run the proof
  // against the builder's finished work and stop a healthy ticket (issue #916,
  // defect 2). Mirrors the receipt block inside `runCheckWriter`, resumed
  // worktrees excluded there before this is ever reached
  // (`mustFailFirstUnproven` returns undefined for them).
  if (
    reading === "red" &&
    sandbox.worktreePath !== undefined &&
    result.checkLocation !== undefined
  ) {
    writeMustFailFirstReceipt(
      sandbox.worktreePath,
      result.checkLocation,
      "proved-red-pre-build",
    );
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] check-writer: the re-run proved the check ` +
        `RED against untouched code` +
        (why === "restored"
          ? ` with the frozen files restored. Proceeding.`
          : ` — the first run's inconclusive was the environment, not the ` +
            `check. Proceeding.`),
    );
  }
  return {
    ...result,
    mustFailFirst: reading,
    mustFailFirstReason: verdict.reason,
    mustFailFirstOutputTail: verdict.outputTail,
    mustFailFirstScreenUnreached: verdict.screenUnreached,
    // Same preference order as the first attempt: the run's own tally beats
    // the static scan, which beats whatever the first (inconclusive) attempt
    // may have already carried. `+ skipped` for the same reason as the first
    // attempt's own tally (issue #1176, review finding 4).
    mustFailFirstTestCount:
      verdict.proved !== undefined
        ? verdict.proved.passed + verdict.proved.failed + verdict.proved.skipped
        : (staticTestCount ?? result.mustFailFirstTestCount),
  };
}

/**
 * The environment could not produce evidence about this ticket's check —
 * TWICE, on the same committed check, with no rewrite in between.
 *
 * ## Since #1198 A this BUILDS rather than stops
 *
 * It was `stopped:run-fault`, whose whole remedy was a re-queue — first by
 * hand, then automatically at the next healthy start (issue #1178). Both
 * remedies share one cost the owner refused to keep paying: the ticket sits
 * un-built for at least a night, and the sandbox fault that caused it says
 * NOTHING about whether the work is doable. Nothing here even established
 * that the check could not fail; the run never got a confirmed reading either
 * way. So the builder is dispatched, the reviewer runs the suites on the
 * finished code, and the reviewer's pass is the gate — which is a strictly
 * better use of a night than a re-queue that may hit the same wedged
 * container again.
 *
 * The check itself travels with the ticket. The reviewer may well succeed in
 * running it where the proof harness could not; if so that is real evidence,
 * and it reaches the reviewer as a pre-flight rather than as a gate.
 */
async function buildAnywayProofEnvironmentFault(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  result: CheckWriterResult,
): Promise<CheckWriterStageResult> {
  const why = result.mustFailFirstReason ?? "(no reason recorded)";
  return await buildAnywayWithoutFirstTest(ctx, sandbox, preSha, {
    reason: "run-fault",
    logLine:
      `[issue=${ctx.issueNumber}] first-test fall-through (#1198) — ` +
      `environment fault: the must-fail-first proof could not be run to a ` +
      `confirmed result twice on the same check (screen: ` +
      `${result.screen ?? "(not stated)"}). That is the sandbox failing to ` +
      `produce evidence, not this ticket's check failing to be a check — ` +
      `building anyway; the reviewer's pass is the only gate. Last verdict: ` +
      `${why}`,
    detail:
      `The loop could not RUN the check written for this ticket — twice in a ` +
      `row, on the exact same check file, with nothing changed in between. ` +
      `It timed out, could not be spawned, or produced no evidence it ran at ` +
      `all. **That is an environment fault, not a judgement about the ` +
      `ticket** — the check was never seen to pass or fail, so nothing here ` +
      `says anything is wrong with the work described. Which is exactly why ` +
      `the builder ran anyway.\n\n` +
      `What the loop observed on the final attempt: \`${why}\`\n\n` +
      `The run log holds a redacted tail of the check's own output for this ` +
      `issue — that is where the fault (an unreachable test database, a dev ` +
      `server that never booted, a wedged sandbox) actually names itself. ` +
      `Worth fixing for the next night's run, whatever happened to this ` +
      `ticket.`,
    marker: result.marker,
    check: result,
  });
}

/**
 * #909: catch the CHECK-WRITER editing a frozen protected path — the
 * practice-world answer key above all — in a commit the ship-time lock cannot
 * see.
 *
 * The ship-time lock ({@link enforceProtectedPaths}) starts from `nextPreSha`,
 * which has already ABSORBED the check-writer's hand-off commit, so a
 * protected-path edit committed there has identical content at both ends of the
 * ship comparison and is filtered out. The one window that still contains it is
 * ENTRY → post-check-writer. The check-writer is the only agent with a motive to
 * move the answer key it grades against — the 2026-08-16 ruling on #907 left
 * these files as little else — and the always-on lock has only ever constrained
 * the builder.
 *
 * The protected set is the ALWAYS-ON list ({@link resolveProtectedPathGlobs}
 * with no per-issue additions), NOT the per-issue check directory: `ownCheckDir`
 * is the directory this run's check-writer legitimately created, and files
 * inside it are its own output, never tampering. Without that exclusion every
 * check-writing ticket would flag on its own work.
 *
 * Returns the violation paths (empty when clean) and the outcome of restoring
 * each byte-for-byte from `entrySha`. The caller commits the restore and runs
 * the first test's proof again on the restored files; only a restore that
 * could not be done stops the ticket (spec #1334).
 *
 * FAILS CLOSED on an unmeasurable change. Empty/equal shas mean no change
 * happened, so nothing can have been tampered — those return clean. But when
 * the shas DIFFER (a real change) and `git diff` cannot report what moved, the
 * gate returns `unmeasurable: true` and the caller REFUSES — silence over a
 * real change is not an all-clear. This is the exact stance its sibling
 * {@link postMergeFixerProofRefusal} takes on the same "tip moved but git can't
 * measure" input; one gate failing open while its twin fails closed is the
 * inconsistency #972 exists to remove. (An earlier version returned empty
 * violations here, reading as a pass.)
 */
export function enforceCheckWriterProtectedPaths(
  worktreePath: string,
  entrySha: string,
  postCheckWriterSha: string,
  ownCheckDir: string | undefined,
): {
  readonly violations: readonly string[];
  readonly restored: ReturnType<typeof restoreProtectedPaths>;
  /** A real change (`entrySha !== postCheckWriterSha`) that `git diff` could
   *  not measure. The caller must fail closed — it cannot prove the frozen
   *  answer key was untouched. Absent/false on every measurable path. */
  readonly unmeasurable?: boolean;
} {
  if (
    entrySha === "" ||
    postCheckWriterSha === "" ||
    entrySha === postCheckWriterSha
  ) {
    return { violations: [], restored: [] };
  }
  const diff = runGit(
    worktreePath,
    "diff",
    "--name-only",
    entrySha,
    postCheckWriterSha,
  );
  if (!diff.ok) {
    // The diff failed. Distinguish two very different causes:
    //   - The path is a real git repo but git could not measure a real change
    //     (corrupt object, unresolvable ref while about to ship). This is the
    //     dangerous case — the frozen answer key cannot be cleared — so fail
    //     CLOSED, exactly as `postMergeFixerProofRefusal` does.
    //   - The path is not a git repo at all. Then no COMMIT ever happened, so
    //     there is nothing this gate (which catches a committed edit to a
    //     frozen file) could ever catch — return clean. Production always ships
    //     from a real worktree, so this branch is only the non-repo test/edge.
    const inRepo = runGit(worktreePath, "rev-parse", "--git-dir").ok;
    if (inRepo) return { violations: [], restored: [], unmeasurable: true };
    return { violations: [], restored: [] };
  }
  const changed = diff.stdout
    .split("\n")
    .map((s) => s.trim())
    .filter((s) => s.length > 0);
  const ownPrefix =
    ownCheckDir !== undefined && ownCheckDir.length > 0
      ? `${ownCheckDir}/`
      : undefined;
  const violations = detectProtectedPathViolations(
    changed,
    resolveProtectedPathGlobs(),
  ).filter((p) => ownPrefix === undefined || !p.startsWith(ownPrefix));
  if (violations.length === 0) return { violations: [], restored: [] };
  const restored = restoreProtectedPaths(worktreePath, entrySha, violations);
  return { violations, restored };
}

function issueSliceOnRef(
  git: (repoRoot: string, ...gitArgs: string[]) => GitRunResult,
  repoRoot: string,
  ref: string,
  issueNumber: number,
  missingRefMeans: "absent" | "uncertain",
): boolean | "uncertain" {
  const tree = git(repoRoot, "ls-tree", "-r", "--name-only", ref);
  if (!tree.ok) {
    // A failed `ls-tree` is either a non-existent ref or a genuine git fault.
    // Only the ref's own existence tells them apart; `rev-parse --verify`
    // bypasses the ambiguity the empty `ls-tree` output would leave.
    const exists = git(
      repoRoot,
      "rev-parse",
      "--verify",
      "--quiet",
      `${ref}^{commit}`,
    ).ok;
    if (exists) return "uncertain";
    return missingRefMeans === "absent" ? false : "uncertain";
  }
  // Anchored so `issue-1` never matches `issue-11`; matches either runner's
  // per-issue check directory anywhere in the tree.
  const re = new RegExp(`(?:^|/)(?:e2e/checks|__checks__)/issue-${issueNumber}/`);
  return tree.stdout.length > 0 && tree.stdout.split("\n").some((l) => re.test(l));
}

/**
 * Where does this `ALREADY_BUILT` ticket's work actually live (issue #1110)?
 *
 * Two cheap `ls-tree` reads — `origin/main` and `integration-candidate` — asked
 * about the issue's committed check slice. Any unresolved half makes the WHOLE
 * answer `"uncertain"`, so the caller sends the ticket to the reviewer (as
 * unconfirmed work) rather than acting on a partial reading.
 *
 * Read-only and side-effect-free. Injectable `git` for tests; production passes
 * the module {@link runGit}.
 */
export function probeAlreadyBuiltLocation(
  repoRoot: string,
  issueNumber: number,
  git: (repoRoot: string, ...gitArgs: string[]) => GitRunResult = runGit,
): AlreadyBuiltLocation {
  if (!Number.isInteger(issueNumber) || issueNumber <= 0) return "uncertain";
  const onMain = issueSliceOnRef(
    git,
    repoRoot,
    "origin/main",
    issueNumber,
    "uncertain",
  );
  const onStaging = issueSliceOnRef(
    git,
    repoRoot,
    STAGING_BRANCH,
    issueNumber,
    "absent",
  );
  if (onMain === "uncertain" || onStaging === "uncertain") return "uncertain";
  return { onMain, onStaging };
}

/**
 * Dispose of an `ALREADY_BUILT` verdict by WHERE the code is (issue #1110),
 * and since spec #1334 never by handing it to the owner:
 *
 *   1. resumed WIP                 — this ticket's own saved work, finished:
 *                                    straight to review, no build pass.
 *   2. on `integration-candidate`  — certified, waiting on the run's final pull
 *      but NOT on main               request (`shipped-local`): NOT rebuilt,
 *                                    flipped shipped-local and closed WITH the
 *                                    run's final PR.
 *   3. on `origin/main`, elsewhere, — to the reviewer, with no first test: if
 *      or probe uncertain             it confirms the work is already there the
 *                                    ticket closes as done; if not, it is built.
 *
 * Case 2 is the one path that closes with no reviewer, and only because the
 * ticket's slice was matched BY CONTENT on the staging branch the run PR
 * carries — so `Closes #N` is truthful and no empty branch is ever ridden
 * through the merge/promote flow. Nothing closes on the check-writer's word
 * alone.
 */
async function disposeAlreadyBuilt(
  sandbox: SandboxHandle,
  ctx: PipelineCtx,
  preSha: string,
  result: CheckWriterResult,
): Promise<CheckWriterStageResult> {
  const evidence = result.alreadyBuiltEvidence ?? "(no evidence recorded)";
  const postSha = await currentSandboxSha(sandbox, preSha, ctx);
  // Hand already-built work to the REVIEWER (spec #1334, SG), never to the
  // owner. No first test exists for it — the test-writer wrote none — so the
  // ticket proceeds as one with none: recorded on the body, and labelled
  // `shipped-without-first-test` if it ships.
  const toReview = async (
    situation: ReviewSituation,
    logLine: string,
    detail: string,
    reviewCtx: PipelineCtx = ctx,
  ): Promise<CheckWriterStageResult> => {
    const stage = await buildAnywayWithoutFirstTest(reviewCtx, sandbox, preSha, {
      reason: "already-built",
      detail,
      logLine,
      marker: "NO_SCREEN_APPLIES",
    });
    return stage.proceed ? { ...stage, skipBuild: situation } : stage;
  };

  // CASE 3 (resumed WIP). The marker was read off THIS ticket's own saved
  // work, resumed from its checkpoint — finished work, not the product. It
  // goes straight to review; it used to be handed to the owner
  // (`stopped:already-built`), which threw a finished build away.
  //
  // THE SAVED WORK'S OWN CHECK FOLDERS ARE LOCKED FOR IT (#1361), the way a
  // check-writer's folder is: on `protectedPathGlobs`, which is also the list
  // the ship gate reads as this ticket's own. Without them its own committed
  // first test read as another ticket's and a paid build was refused (#1311,
  // 2026-10-13). The trade: a fixer cannot repair a broken saved test — its
  // edits are restored from the saved work, like any locked check.
  if (sandbox.resumedFromCheckpoint === true) {
    const savedDirs = savedWorkCheckDirs(
      ctx.args.repoRoot,
      ctx.args.branch,
      preSha,
      ctx.issueNumber,
    );
    return toReview(
      { kind: "resumed-built", evidence },
      `[issue=${ctx.issueNumber}] already built — read on this ticket's own ` +
        `resumed, saved work: sending it straight to review, no build pass`,
      `This ticket was resumed from its own saved work, and the test-writing ` +
        `AI found that work already finished. No first test was written; the ` +
        `reviewer judged the finished work directly.\n\n` +
        `Evidence the test-writing AI read:\n${evidence}`,
      { ...ctx, protectedPathGlobs: savedDirs.map((dir) => `${dir}/**`) },
    );
  }

  // Mechanical location lookup. Fail-safe: an absent dep, a thrown error, or an
  // "uncertain" answer all resolve to `"uncertain"` and fall through to the
  // review below, as unconfirmed work.
  let location: AlreadyBuiltLocation = "uncertain";
  try {
    location =
      (await ctx.deps.locateAlreadyBuiltWork?.(ctx.issueNumber)) ?? "uncertain";
  } catch (err) {
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] already-built location lookup threw ` +
        `(${(err as Error).message}) — sending it to the reviewer as unconfirmed`,
    );
    location = "uncertain";
  }

  // CASE 2 (certified on staging, not yet on main). The work is complete and
  // waiting on the run's final pull request — `shipped-local`. Per the #1110
  // ruling it must NOT be rebuilt and NOT be closed by a human: it lands, and
  // closes, WITH the run's final PR.
  //
  // WHY AUTO-CLOSE IS SAFE HERE (and the "empty branch" hazard cannot apply):
  // this is case 2 precisely because the ticket's committed slice was matched
  // BY CONTENT on `integration-candidate`, which the run branch carries. So the
  // code that satisfies this ticket is provably on the branch the final PR
  // opens against, making `Closes #N` truthful. No builder ran, so this
  // ticket's per-issue branch is EMPTY.
  //
  // MECHANISM: `markDone` flips the label to `shipped-local` (the transition
  // #1110 named), and the `"ok"` outcome is what adds this number to runMain's
  // `shippedIssues` — the in-memory `Closes #N` list the final PR is built
  // from. The pipeline short-circuits (`proceed: false`) so no builder or
  // merger runs for this ticket, and the outcome carries the distinguishing
  // `finalMarker: "ALREADY_BUILT_ON_STAGING"`. That marker is REQUIRED
  // downstream: `runMain`'s Phase-3 merge set (`mergedBranches`, keyed on
  // `status === "ok"`) EXCLUDES it, so its empty branch never rides the merger,
  // its `shipped-local` label is never re-churned, and it never enters the
  // promotion fence or a sibling's batch-failure quarantine. Break that filter
  // and both re-appear as real bugs — see the exclusion at the `mergedBranches`
  // definition.
  //
  // LEASE: the staging `"ok"` post-loop HOLDS the lease expecting the promotion
  // path to release it, but this ticket is excluded from that path (above), so
  // hand the lease back here — the work is certified and no peer needs to touch
  // it. Release is a registry-guarded no-op if we don't hold it, so it is
  // always safe.
  //
  // Only under staging — with staging off there is no `integration-candidate`
  // branch to trust, and this arm is skipped for the review below.
  if (
    ctx.args.stagingEnabled &&
    location !== "uncertain" &&
    location.onStaging &&
    !location.onMain
  ) {
    const summary =
      `[issue=${ctx.issueNumber}] already certified on \`${STAGING_BRANCH}\` ` +
      `(matched by its committed check slice), not yet on \`origin/main\`. ` +
      `Marked \`shipped-local\`: NOT rebuilt, and it closes with the run's ` +
      `final pull request.\n\nEvidence the check-writer read:\n${evidence}`;
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] already-built — certified on ${STAGING_BRANCH}, ` +
        `not on origin/main: marking shipped-local to close with the run PR ` +
        `(#1110 case 2), not rebuilding`,
    );
    await ctx.deps.markDone(ctx.issueNumber, summary);
    await ctx.deps.releaseIssueLease(ctx.issueNumber);
    return {
      proceed: false,
      outcome: {
        status: "ok",
        finalMarker: ALREADY_BUILT_ON_STAGING_MARKER,
        postSha,
      },
    };
  }

  // CASE 1 (found on origin/main) and the FALLBACK (found on neither branch,
  // or the lookup could not be resolved). Both go to the reviewer, never to
  // the owner (spec #1334, SG): the reviewer reads the code the worktree was
  // cut from against the ticket. Confirmed with nothing built → the ticket
  // closes as done. Refused → the reviewer's findings brief an ordinary build
  // round, and the ticket is built.
  const onMain = location !== "uncertain" && location.onMain;
  return toReview(
    { kind: "already-built", evidence, onMain },
    `[issue=${ctx.issueNumber}] already built ` +
      (onMain
        ? `— its committed slice is on origin/main`
        : `— NOT confirmed on origin/main or ${STAGING_BRANCH}`) +
      `: sending it to the reviewer to confirm, no build pass`,
    `The test-writing AI reported this ticket's change as already built` +
      (onMain
        ? ` (its committed slice for issue #${ctx.issueNumber} is on \`origin/main\`).`
        : `, but the run could not confirm it on \`origin/main\` or ` +
          `\`${STAGING_BRANCH}\`` +
          (location === "uncertain" ? ` (a branch lookup could not be resolved)` : ``) +
          `.`) +
      ` No first test was written. The reviewer checks the code against the ` +
      `ticket: if it confirms, the ticket closes as done; if not, the ticket ` +
      `is built.\n\n` +
      `Evidence the test-writing AI read:\n${evidence}`,
  );
}

/**
 * One check-writer dispatch, with the envelope-failure ladder and the
 * telemetry note every dispatch owes — extracted (2026-09-01) because the
 * identical `runCheckWriter` + catch-ladder + `noteCheckWriterTelemetry`
 * block was pasted at four sites inside `runCheckWriterStage`, and a fifth
 * retry road (the screen-unreached brief) was about to make it five.
 *
 * Either the writer's result, or the stage-stopping quarantine the broken
 * envelope earned. Anything else still throws, exactly as the pasted copies
 * did.
 *
 * `rethrowMissingHelper` exists for the attempt-1 site only: a missing
 * graded helper there is a briefed retry, not a quarantine (issue #884), so
 * the caller catches it. On every retry site it stays what it always was —
 * a `VerdictParseError` subtype, quarantined as an unusable envelope.
 */
type CheckWriterDispatch =
  | {
      readonly kind: "result";
      readonly result: CheckWriterResult;
      /**
       * How many check-writer attempts this ONE call actually consumed —
       * 1 normally, 2 when the envelope re-ask (below) fired TRANSPARENTLY
       * WITHIN this call. Callers fold this into their own `writerAttempts`
       * counter so the NEXT dispatch's `attempt` number stays accurate even
       * though the re-ask never surfaces as a separate call at the call
       * site.
       *
       * #1191 finding E: this used to be computed as
       * `opts.envelopeReaskSpent === true ? 2 : 1` — which reports 2
       * whenever the CALLER passed in an already-spent flag (i.e. every
       * dispatch after the ticket's one re-ask has already fired on an
       * EARLIER call), not just when the re-ask fired inside this call.
       * Every dispatch after the latch therefore added a phantom +1 to
       * `writerAttempts`. It is now always 1 in the base (non-recursive)
       * case; the recursive re-ask branch adds 1 on top of whatever the
       * inner call reports, so a call where the re-ask actually fires
       * reports exactly 2 and every later, unrelated call reports 1.
       */
      readonly attemptsUsed: number;
      /**
       * Whether the ticket's one envelope re-ask has been spent as of this
       * call returning — either it came in already spent (`opts.
       * envelopeReaskSpent`) or it was just spent by the recursive branch
       * below. Callers latch their own `envelopeReaskSpentForTicket` off
       * THIS field, not off `attemptsUsed === 2` (see the finding-E note
       * above for why that check was wrong).
       */
      readonly reaskSpent: boolean;
    }
  | { readonly kind: "stop"; readonly stage: CheckWriterStageResult };

async function dispatchCheckWriter(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  opts: {
    readonly attempt: number;
    readonly repairBrief?: string;
    readonly rethrowMissingHelper?: boolean;
    /**
     * #1191 finding E corrected this comment: every one of the seven
     * `runCheckWriterStage` call sites DOES pass this (as
     * `envelopeReaskSpentForTicket`, its ticket-wide latch) — it is not
     * recursive-re-ask-only. What IS true is the effect: caps the envelope
     * re-ask (fault 2, 2026-09-01) at exactly one PER TICKET. A `true` here
     * means the ticket has already spent its one re-ask (on this call or an
     * earlier one), so a second `VerdictParseError` quarantines directly
     * instead of recursing again.
     */
    readonly envelopeReaskSpent?: boolean;
  },
): Promise<CheckWriterDispatch> {
  try {
    const result = await runCheckWriter(sandbox, ctx, {
      attempt: opts.attempt,
      ...(opts.repairBrief !== undefined
        ? { repairBrief: opts.repairBrief }
        : {}),
    });
    noteCheckWriterTelemetry(ctx, result);
    // Base case — this call made exactly ONE `runCheckWriter` attempt,
    // regardless of whether the ticket's re-ask had already been spent by
    // an EARLIER, unrelated call (#1191 finding E).
    return {
      kind: "result",
      result,
      attemptsUsed: 1,
      reaskSpent: opts.envelopeReaskSpent === true,
    };
  } catch (err) {
    if (
      opts.rethrowMissingHelper === true &&
      err instanceof CheckWriterMissingGradedHelperError
    ) {
      throw err;
    }
    if (err instanceof CheckWriterMarkerEnvelopeMismatchError) {
      return {
        kind: "stop",
        stage: await buildAnywayCheckWriterMarkerMismatch(
          ctx,
          sandbox,
          preSha,
          err,
          opts.attempt,
        ),
      };
    }
    if (err instanceof VerdictParseError) {
      // Fault 2 (2026-09-01): a check-writer envelope that fails to parse
      // used to quarantine on EVERY attempt, with no retry at all — unlike
      // the implementer, which already gets one re-ask for the identical
      // failure shape (`envelopeReask`, `runImplementer`). Ticket #1126's
      // writer put a `.test.ts` filename on a `CHECKS_WRITTEN` envelope on
      // attempt 2 and the ticket died outright, even though the parse error
      // names the exact fix. One briefed re-ask closes that gap; a SECOND
      // parse failure still quarantines exactly as before.
      //
      // `CheckWriterMissingGradedHelperError` is EXCLUDED from the re-ask
      // even though it IS a `VerdictParseError` subtype: it already gets
      // its own dedicated one-shot retry (issue #884, the
      // `rethrowMissingHelper` path at the attempt-1 call site in
      // `runCheckWriterStage`). Without this exclusion, a writer that
      // forgets the graded helper TWICE in a row would silently earn a
      // THIRD attempt from this generic road on top of the missing-helper
      // road's own retry — quietly doubling the "two strikes" stop the
      // owner already decided on for that failure shape. It still
      // quarantines exactly as before, just without spending the re-ask.
      if (
        !opts.envelopeReaskSpent &&
        !(err instanceof CheckWriterMissingGradedHelperError)
      ) {
        ctx.telemetry?.noteCheckWriterRetried();
        // Keep the stall watchdog's clock fresh across the extra dispatch
        // this re-ask is about to make (same discipline as every other
        // multi-round repair loop in this file).
        ctx.status?.noteProgress?.();
        const inner = await dispatchCheckWriter(ctx, sandbox, preSha, {
          ...opts,
          attempt: opts.attempt + 1,
          envelopeReaskSpent: true,
          repairBrief: envelopeRetryBrief(err),
          // Fault-2-review D2 (2026-09-02): the `...opts` spread above would
          // otherwise carry `rethrowMissingHelper: true` forward from the
          // attempt-1 call site. If THIS re-ask's own dispatch then throws
          // `CheckWriterMissingGradedHelperError` (a different failure shape
          // than the one that earned the re-ask), the inherited flag would
          // rethrow it past this function entirely, straight into the
          // attempt-1 caller's own catch — which would treat it as attempt
          // 1's own refusal and grant the #884 "one more go" retry AGAIN, a
          // third dispatch the two-strikes design never intended. Forcing it
          // false here means any failure on the re-ask — missing-helper
          // included — is handled ONLY by this function's own VerdictParseError
          // branch immediately above, which already excludes
          // `CheckWriterMissingGradedHelperError` from spending a SECOND
          // re-ask and quarantines it directly. Bound: at most two dispatches
          // from this road, never three.
          rethrowMissingHelper: false,
        });
        // #1191 finding E: this recursive call is the ONLY place a re-ask
        // can actually fire, so it is the only place attemptsUsed should
        // ever total 2 — THIS failed attempt, plus whatever the inner call
        // itself reports (1 in the base case). A "stop" from the inner call
        // (the re-ask's own attempt also failed to parse) passes through
        // unchanged; there is no attempt count to adjust on that branch.
        if (inner.kind === "stop") return inner;
        return { ...inner, attemptsUsed: inner.attemptsUsed + 1 };
      }
      return {
        kind: "stop",
        stage: await buildAnywayUnusableCheckWriterEnvelope(
          ctx,
          sandbox,
          preSha,
          err,
          opts.attempt,
        ),
      };
    }
    throw err;
  }
}

/**
 * THE ENVIRONMENT SPLIT, as one reusable settlement (2026-09-01; the
 * `rerunInconclusiveProof` + `buildAnywayProofEnvironmentFault` pair used to be
 * pasted at three sites). An INCONCLUSIVE proof re-runs ONCE on the same
 * committed check, then splits by shape:
 *
 *   - a spawn failure, a timeout, no output, no nonce-signed evidence line —
 *     the ENVIRONMENT failed to produce evidence, and a rewrite cannot fix a
 *     sandbox. Stops as `stopped:run-fault` (the "nothing about the ticket
 *     needs changing" label).
 *   - the SCREEN-UNREACHED shape (`mustFailFirstScreenUnreached`) — the
 *     runner ran and reported a colour, but nothing proves the check reached
 *     its screen. Repeating identically on a re-run, that is almost always
 *     the CHECK's own deterministic fault (a bad import, a dead route), so
 *     it is handed BACK to the caller, still inconclusive, for the briefed
 *     writer-retry road — stopping it as a run fault told a human "nothing
 *     about the ticket needs changing" about a check that was broken, and
 *     the ticket ping-ponged on every re-queue.
 *
 * Any non-inconclusive result passes straight through.
 */
type ProofSettlement =
  | { readonly kind: "result"; readonly result: CheckWriterResult }
  | { readonly kind: "stop"; readonly stage: CheckWriterStageResult };

async function settleInconclusiveProof(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  result: CheckWriterResult,
): Promise<ProofSettlement> {
  if (mustFailFirstUnproven(result) !== "inconclusive") {
    return { kind: "result", result };
  }
  const rerun = await rerunInconclusiveProof(ctx, sandbox, result);
  if (mustFailFirstUnproven(rerun) !== "inconclusive") {
    return { kind: "result", result: rerun };
  }
  if (rerun.mustFailFirstScreenUnreached === true) {
    return { kind: "result", result: rerun };
  }
  return {
    kind: "stop",
    stage: await buildAnywayProofEnvironmentFault(ctx, sandbox, preSha, rerun),
  };
}

export async function runCheckWriterStage(
  sandbox: SandboxHandle,
  ctx: PipelineCtx,
  preSha: string,
): Promise<CheckWriterStageResult> {
  ctx.status.setIssuePhase(ctx.issueNumber, "check-writer");
  // THE REAL HISTORY, tracked rather than inferred (2026-09-01). Every stop
  // and every dispatched CHECK_ATTEMPT reads these, because the old wording
  // hard-coded "twice" and "after its one retry" — false on the
  // missing-helper road (attempt 1 never ran a proof) and after the budgeted
  // third rewrite.
  let writerAttempts = 1;
  /** How many proofs were actually OBSERVED green — never assumed. */
  let greenProofs = 0;
  /** The one ordinary green-proof retry (Piece D). */
  let greenRetrySpent = false;
  /** The one screen-unreached retry (2026-09-01 environment split, road 3). */
  let unreachedRetrySpent = false;
  /**
   * Fault-2-review D1 (2026-09-02): a check-writer envelope's one re-ask
   * (`dispatchCheckWriter`'s own `VerdictParseError` branch) used to be
   * scoped PER DISPATCH SITE, not per ticket — every call site below
   * started its own `opts.envelopeReaskSpent` at `undefined`, so a ticket
   * that hit an unparseable envelope on, say, both the green-proof retry AND
   * the screen-unreached retry could spend TWO separate re-asks over its
   * lifetime. This flag is threaded into every dispatch's opts and flipped
   * true the moment ANY dispatch reports its `reaskSpent` field as `true`
   * (#1191 finding E: was `attemptsUsed === 2`, which over-fired — see the
   * field's own doc comment on `CheckWriterDispatch`), so every LATER
   * dispatch site in this same ticket starts already spent — at most one
   * envelope re-ask, ticket-wide.
   */
  let envelopeReaskSpentForTicket = false;

  /**
   * The four `dispatchCheckWriter` call sites below all fold a `"result"`
   * dispatch the same way: credit its `attemptsUsed` onto the ticket-wide
   * `writerAttempts` counter (minus 1, since the caller already counted
   * this dispatch as one attempt before calling it) and latch
   * `envelopeReaskSpentForTicket` once the re-ask has fired anywhere in
   * this ticket. #1191 finding E collapsed what were copy-pasted two-line
   * blocks into this one helper.
   */
  const foldCheckWriterAttempts = (dispatch: {
    readonly attemptsUsed: number;
    readonly reaskSpent: boolean;
  }): void => {
    writerAttempts += dispatch.attemptsUsed - 1;
    if (dispatch.reaskSpent) envelopeReaskSpentForTicket = true;
  };

  let result: CheckWriterResult;
  try {
    const first = await dispatchCheckWriter(ctx, sandbox, preSha, {
      attempt: 1,
      rethrowMissingHelper: true,
      envelopeReaskSpent: envelopeReaskSpentForTicket,
    });
    if (first.kind === "stop") return first.stage;
    result = first.result;
    foldCheckWriterAttempts(first);
  } catch (err) {
    // OWNER DECISION (issue #884): a check-writer that forgot a graded helper
    // gets one more go, then the ticket stops. It used to get NONE — the
    // refusal was an ordinary `VerdictParseError` and quarantined at attempt
    // 1 — which spends the owner's morning on the loop's own clerical error,
    // on "the cheapest retry in the design". The refusal message already
    // names the exact missing call, so the second attempt is handed the one
    // thing it needs to succeed. Kept DISTINCT from the plain
    // `VerdictParseError` (which `dispatchCheckWriter` quarantines) on
    // purpose: an envelope that cannot be read at all is not a clerical miss
    // and keeps its old stop-at-attempt-1 behaviour.
    //
    // This refusal retry is CLERICAL, not a proof observation — it does not
    // consume the green-proof retry below (2026-09-01; it used to, so one
    // observed green after a refusal jumped straight to the budget arm and
    // the stop claimed a "twice green" history that never happened).
    if (!(err instanceof CheckWriterMissingGradedHelperError)) throw err;
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] check-writer's check never calls a ` +
        `required graded helper — refusing it and giving it one more ` +
        `attempt, with a repair brief carrying the refusal verbatim (the ` +
        `exact missing call named) via the prompt's REPAIR_BRIEF slot ` +
        `(issue #884: "the cheapest retry in the design"). ${err.message}`,
    );
    ctx.telemetry?.noteCheckWriterRetried();
    writerAttempts += 1;
    const retry = await dispatchCheckWriter(ctx, sandbox, preSha, {
      attempt: writerAttempts,
      repairBrief: missingHelperRetryBrief(err),
      envelopeReaskSpent: envelopeReaskSpentForTicket,
    });
    if (retry.kind === "stop") return retry.stage;
    result = retry.result;
    foldCheckWriterAttempts(retry);
  }

  // THE PROOF LADDER (2026-08-31, restructured 2026-09-01). Every writer
  // attempt's proof takes the same road, in order:
  //
  //   1. THE ENVIRONMENT SPLIT (`settleInconclusiveProof`): an inconclusive
  //      re-runs the RUN once — a rewrite cannot fix a sandbox — and a
  //      persisting environment shape builds anyway with no first test
  //      (`buildAnywayProofEnvironmentFault`). Only the screen-unreached
  //      shape survives to step 3.
  //   2. GREEN — a check that cannot fail. One ordinary briefed retry
  //      (Piece D); green again and the ticket builds anyway with no first
  //      test (`buildAnywayNoFailingCheck`), carrying its real history.
  //   3. SCREEN-UNREACHED — the run reported a colour but nothing proves the
  //      check reached its screen, twice on the same bytes. A deterministic
  //      check fault: one briefed retry naming exactly that, then the same
  //      build-anyway outcome.
  //
  // Spec #1334 (SF1): every first-test problem ends in that ONE outcome —
  // the ticket is built, reviewed, and ships labelled
  // `shipped-without-first-test`. The judge's early pass, its weak-check
  // repair pool and its criterion amendment used to sit after this ladder
  // and buy further rewrites; all three are deleted.
  //
  // Bounded by construction: each road's retry flag spends exactly once, so
  // a ticket gets at most four writer attempts (envelope re-asks aside).
  for (;;) {
    const settled = await settleInconclusiveProof(ctx, sandbox, preSha, result);
    if (settled.kind === "stop") return settled.stage;
    result = settled.result;

    const unproven = mustFailFirstUnproven(result);
    if (unproven === undefined) break;

    if (unproven === "green") {
      greenProofs += 1;
      if (!greenRetrySpent) {
        greenRetrySpent = true;
        ctx.deps.log(
          `[issue=${ctx.issueNumber}] check-writer's check passed against ` +
            `untouched code — a check that cannot fail proves nothing. ` +
            `Giving it one more attempt (Piece D: "exactly one more go, ` +
            `then the ticket stops"), briefed via REPAIR_BRIEF with the ` +
            `classifier's reason — no longer dispatched blind, and no app ` +
            `output in the brief (ruling 6).`,
        );
        ctx.telemetry?.noteCheckWriterRetried();
        writerAttempts += 1;
        const retry = await dispatchCheckWriter(ctx, sandbox, preSha, {
          attempt: writerAttempts,
          repairBrief: mustFailFirstRetryBrief({
            reason: result.mustFailFirstReason,
          }),
          envelopeReaskSpent: envelopeReaskSpentForTicket,
        });
        if (retry.kind === "stop") return retry.stage;
        result = retry.result;
        foldCheckWriterAttempts(retry);
        continue;
      }
      return await buildAnywayNoFailingCheck(ctx, sandbox, preSha, result, "green", {
        writerAttempts,
        greenProofs,
      });
    }

    // `unproven === "inconclusive"` past the settlement is, by construction,
    // the SCREEN-UNREACHED shape — the environment shapes already stopped
    // inside `settleInconclusiveProof`. Road 3 of the ladder comment above.
    if (!unreachedRetrySpent) {
      unreachedRetrySpent = true;
      ctx.deps.log(
        `[issue=${ctx.issueNumber}] check-writer's proof ran twice and ` +
          `neither run proved the check ever reached its screen — a ` +
          `deterministic check fault (a bad import, a dead route), not a ` +
          `sandbox fault. Dispatching one briefed rewrite naming exactly ` +
          `that, instead of quarantining as an environment fault.`,
      );
      ctx.telemetry?.noteCheckWriterRetried();
      writerAttempts += 1;
      const retry = await dispatchCheckWriter(ctx, sandbox, preSha, {
        attempt: writerAttempts,
        repairBrief: unreachedScreenRetryBrief({
          reason: result.mustFailFirstReason,
        }),
        envelopeReaskSpent: envelopeReaskSpentForTicket,
      });
      if (retry.kind === "stop") return retry.stage;
      result = retry.result;
      foldCheckWriterAttempts(retry);
      continue;
    }
    return await buildAnywayNoFailingCheck(
      ctx,
      sandbox,
      preSha,
      result,
      "inconclusive",
      { writerAttempts, greenProofs },
    );
  }

  if (result.marker === "TICKET_UNCLEAR") {
    // The test-writing AI found a product question the ticket leaves open
    // (spec #1334 fix pass): stop for the owner before anything is built.
    return {
      proceed: false,
      outcome: await stopTicketUnclear(ctx, {
        question: result.ticketQuestion ?? "(the test-writing AI named no question)",
        stage: "before-any-code",
        postSha: await currentSandboxSha(sandbox, preSha, ctx),
        who: "the test-writing AI",
      }),
    };
  }

  if (result.marker === "ALREADY_BUILT") {
    // #1110: "already built" is settled by WHERE the code is, and by nothing
    // else — a mechanical location lookup, not the check-writer's reading of a
    // worktree. `disposeAlreadyBuilt` runs it: resumed saved work goes
    // straight to review; work certified on the staging branch closes with
    // the run's final PR; anything else goes to the reviewer, which closes
    // it as done only if it confirms the work is there. It never blind-closes
    // and never auto-ships an empty per-issue branch.
    return await disposeAlreadyBuilt(sandbox, ctx, preSha, result);
  }

  if (result.marker === "NEEDS_WORLD_DATA") {
    // #1198 A: this used to quarantine `stopped:no-failing-check` (handoff —
    // someone extends the practice world, then the ticket re-queues). The
    // handoff is still the right REMEDY and it is still written onto the
    // ticket below; what changed is that it no longer holds the ticket. A
    // missing fixture stops the loop writing a CHECK — it does not stop the
    // loop writing the FEATURE, and waiting on a person to extend a fixture
    // script before a single line of the ticket's own code exists is exactly
    // the trade the owner refused. The builder runs; if the work genuinely
    // cannot be done without that data, the reviewer sees it in the diff.
    const worldData = result.worldDataNeeded ?? "(no description recorded)";
    return await buildAnywayWithoutFirstTest(ctx, sandbox, preSha, {
      reason: "no-failing-check",
      logLine:
        `[issue=${ctx.issueNumber}] first-test fall-through (#1198) — ` +
        `needs-world-data, so no check could be written: ${worldData}. ` +
        `Building anyway; the reviewer's pass is the only gate.`,
      detail:
        `No first test could be written for this ticket, because the ` +
        `test data (the seed fixtures) doesn't contain the data one would need:\n\n` +
        `${worldData}\n\n` +
        `That is a description of a gap, never a proposed fix — someone ` +
        `extends the seed fixtures as its own reviewed change. Worth doing, so the NEXT ` +
        `ticket on this surface can be proven; it is no longer holding this ` +
        `one, which was built and reviewed without a first test.`,
      // No check was written, and NEEDS_WORLD_DATA offers no proof the ship
      // gate accepts — say "no check" plainly.
      marker: "NO_SCREEN_APPLIES",
    });
  }

  // Hand off through the shared tail. #1198 A: every fall-through site above
  // reaches this same function, so the check commit, the protected-path lock,
  // the freeze and the check-writer tamper guard run on a ticket built without
  // a good first test exactly as they do on a healthy one.
  return await finishCheckWriterStage(
    ctx,
    sandbox,
    preSha,
    result.marker,
    result,
  );
}

/**
 * THE TAIL EVERY PROCEEDING TICKET PASSES THROUGH — commit the check, lock
 * it, freeze it, prove the check-writer moved nothing it may not move, and
 * build the `proceed: true` result.
 *
 * EXTRACTED FROM `runCheckWriterStage` FOR #1198 A, and the extraction is
 * load-bearing rather than tidying. The fall-through paths that ticket adds
 * return `proceed: true` from deep inside the stage — six sites, each
 * previously a `return { proceed: false, ... }`. Left where they were, every
 * one of them would have skipped this tail: no commit of the check directory,
 * no protected-path lock over it, no freeze, and — worst —
 * no `enforceCheckWriterProtectedPaths`, the guard that catches the one agent
 * deciding what "correct" means editing the answer key it grades against. Six
 * quiet holes in the one place the loop cannot afford them. Routing every
 * fall-through through the SAME tail the healthy path uses means a hole here
 * has to be dug once, in the open, rather than six times by omission.
 *
 * `marker` is a parameter rather than read off `check`, for two reasons that
 * both bite. A fall-through may have NO check at all (an envelope that would
 * not parse), so there is nothing to read it from; and a fall-through whose
 * envelope contradicted its own last line, or a `NEEDS_WORLD_DATA` road that
 * wrote no check at all, carries a marker that cannot ship or an artifact that
 * must not be committed, so its caller must be able to say `NO_SCREEN_APPLIES`
 * instead of the one the result happens to hold.
 */
async function finishCheckWriterStage(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  marker: CheckWriterMarker,
  /**
   * The check-writer's own result, when this ticket has one — `undefined`
   * exactly when no envelope was ever parsed (#1198 A's unusable-envelope
   * fall-through). Every artifact is read off it optionally, so an absent
   * result reads as "there is no check", never as a crash.
   */
  check: CheckWriterResult | undefined,
  /** Set on the #1198 A fall-through; absent on every healthy ticket. */
  withoutFirstTest?: FirstTestFallThrough,
): Promise<CheckWriterStageResult> {
  // PROCEED: a genuine (or inherited) CHECKS_WRITTEN, a UNIT_CHECK_WRITTEN, or
  // NO_SCREEN_APPLIES — the ship-time gate below weighs whichever proof that
  // marker offers against what the FINISHED diff demands before this issue can
  // ship.
  //
  // A `switch`, not the if-chain this used to be (issue #956). The chain had no
  // `default` and no exhaustiveness check, so an unhandled marker fell straight
  // through to `proceed: true` carrying `noScreenApplies: false` and
  // `checkCommand: undefined` — NO check and NO guard, on one ticket, silently.
  // Adding a fifth marker is exactly the change that would have hit it. Listing
  // all five with a `never` default makes a sixth a compile error here.
  let nextPreSha = preSha;
  let nextCtx = ctx;
  // A restored edit to a frozen file can still drop the first test (its
  // re-run no longer comes back red), so the fall-through is re-decided below.
  let fallThrough = withoutFirstTest;
  // Hoisted into a local because TypeScript cannot narrow `check?.checkLocation`
  // across the statements below — an optional chain re-reads the property each
  // time, so a `!== undefined` test on one line proves nothing about the next.
  // One read, one narrowing, and the block below is byte-equivalent to the
  // `result.checkLocation` it was extracted from.
  const location = check?.checkLocation;
  switch (marker) {
    case "CHECKS_WRITTEN":
    case "UNIT_CHECK_WRITTEN": {
      // BOTH check routes commit their directory and lock it, and the lock is
      // the single most load-bearing line in this stage. `checkLocation`
      // carries the right directory and the right glob for whichever runner
      // this is (`checkDirGlobForIssue(...)` or `unitCheckDirGlobFor(...)`,
      // chosen at construction where the host package was still in hand), so
      // there is no branch here to get wrong. Without the lock the builder can
      // edit — or delete — the very check it is about to be graded by, and
      // every other part of the proof becomes decoration.
      if (sandbox.worktreePath && location !== undefined) {
      // Finding #7 (2026-08-04 review, BLOCKER): never trust
      // check-writer-prompt.md's claim that "the loop will not run an
      // uncommitted file" — it was false; the must-fail-first proof above
      // runs the worktree, uncommitted files included. If the agent forgot
      // to `git commit` its check, capturing HEAD as-is here would make
      // `nextPreSha` NOT contain the check file. The implementer's own
      // commit later sweeps the file in (an ordinary `git add -A` picks up
      // whatever is on disk), so the protected-path lock then sees the
      // check file as newly ADDED between preSha and postSha — a false
      // tamper — and its `existedAtBase: false` restore branch DELETES the
      // check entirely (see `ensureDirCommitted`'s own doc comment for the
      // full chain). Commit the check directory here, ourselves, so the
      // hand-off baseline is guaranteed to actually contain it — whether or
      // not the agent remembered. A no-op when it's already clean.
        const checkDir = location.checkDir;
        const committedSha = ensureDirCommitted(
          sandbox.worktreePath,
          checkDir,
          `chore(sandcastle): commit check-writer's check for issue #${ctx.issueNumber}\n\n` +
            `${checkDir} had uncommitted changes when the check-writer stage ` +
            `finished — committed here so the builder's hand-off baseline ` +
            `actually contains the check file (issue #916 review finding #7:\n` +
            `without this, a forgotten commit gets misread as tampering and ` +
            `the protected-path restore deletes the check).\n\n` +
            `SANDCASTLE-CHECK-DIR-COMMIT: 1`,
        );
        nextPreSha =
          committedSha ?? (await ctx.deps.captureSha(sandbox.worktreePath));
        nextCtx = {
          ...ctx,
          protectedPathGlobs: [location.checkDirGlob],
        };

        // LAYER 1 (issue #1118): THE CHECK IS FROZEN AT ACCEPTANCE.
        //
        // Taken HERE, one statement after the commit that makes this check the
        // builder's hand-off baseline, because this is the exact moment the
        // check becomes the thing the ticket will be graded by. From here on
        // the bytes are held in this process's memory, and the tamper restore
        // and every graded run of a rewritten first test read that copy.
        //
        // The frozen set is WIDER than the check file. SWE-bench's reset
        // reverts only the files its own test patch names, so an agent that
        // cannot edit the spec can still edit the runner's config, its global
        // setup, or a shared helper the spec imports — the same hole one step
        // further out. `checkFreezePathsFor` DERIVES that set by walking what
        // this check actually imports: a hand-written list is what left the
        // grading library itself unfrozen, and a hand-written list is how the
        // next one would be missed.
        //
        // ADDITIVE: a freeze that could not be taken leaves `current` as
        // `undefined`, and every consumer treats that as "behave exactly as you
        // did before this existed".
        if (ctx.frozenCheck !== undefined) {
          const frozen = freezeCheck(
            sandbox.worktreePath,
            location,
          );
          ctx.frozenCheck.current = frozen;
          if (frozen === undefined) {
            ctx.deps.logError(
              `[issue=${ctx.issueNumber}] the accepted check could not be ` +
                `frozen, so a later repair of it could not be graded against a ` +
                `known-good copy. This ticket behaves exactly as it did before ` +
                `the freeze existed.`,
            );
          } else {
            ctx.deps.log(
              `[issue=${ctx.issueNumber}] the accepted check is frozen ` +
                `(${frozen.checkDir.relPaths.length} check file(s) and ` +
                `${frozen.environment.length} setup/config file(s), ` +
                `fingerprint ${frozen.fingerprint.slice(0, 12)}). Every graded ` +
                `run restores this copy first.`,
            );
          }
        }
      } else {
        nextPreSha = preSha;
        // No worktree (a legacy/test-double handle) or no validated location:
        // there is nothing on disk to commit and no directory to name, so no
        // glob is added. Deliberately NOT falling back to the browser glob —
        // locking a directory this check may not even be in would report a
        // lock that is not holding anything.
        if (location !== undefined) {
          nextCtx = {
            ...ctx,
            protectedPathGlobs: [location.checkDirGlob],
          };
        }
      }
      break;
    }
    case "NO_SCREEN_APPLIES":
      // No check was written, so there is no directory to commit and nothing
      // to lock. The claim itself is re-checked at ship time against the
      // finished diff (`proof-demand.ts`), never here.
      break;
    // `ALREADY_BUILT` and `NEEDS_WORLD_DATA` have arms because a fall-through
    // caller could pass one: `buildAnywayWithoutFirstTest` normalizes both to
    // `NO_SCREEN_APPLIES` before it ever calls here, so arriving under one of
    // them is a CALLER BUG. Neither can ship — `proofOfferedByMarker` returns
    // `undefined` for both, which the ship gate calls
    // `check-writer-marker-cannot-ship` and never waives — so proceeding
    // would trade a stop here for a stop three agents later.
    //
    // #1198 review, S2 — THIS RETURNS, IT DOES NOT THROW. A throw out of
    // `runCheckWriterStage` lands in `runIssuePipeline`'s generic `catch`,
    // which has no arm for it, so it falls to the fixer with no check-writer
    // pass behind it — exactly the hole #914 closed by routing every check-writer failure
    // through a modelled return. A caller bug must not be able to reopen it.
    case "ALREADY_BUILT":
    case "NEEDS_WORLD_DATA":
    // `TICKET_UNCLEAR` stops in `runCheckWriterStage` before this tail; a
    // caller handing it here is the same caller bug.
    case "TICKET_UNCLEAR": {
      const callerBug =
        `[issue=${ctx.issueNumber}] stopped:run-fault — ` +
        `finishCheckWriterStage was handed marker ${marker}, which offers no ` +
        `proof at all, so the ship-time gate would refuse the diff as ` +
        `'marker-cannot-ship'. A caller falling through on one of these must ` +
        `pass NO_SCREEN_APPLIES instead. This is a bug in the loop, not a ` +
        `finding about the ticket.`;
      ctx.deps.logError(callerBug);
      await ctx.deps.quarantine(ctx.issueNumber, callerBug);
      await reportStopBestEffort(
        ctx,
        "stopped:run-fault",
        runFaultExplanation({ errorMessage: callerBug }).detail,
      );
      return {
        proceed: false,
        outcome: {
          status: "quarantined",
          finalMarker: "HALT",
          postSha: await currentSandboxSha(sandbox, preSha, ctx),
        },
      };
    }
    // Kept as a THROW, unlike the arm above: this one is unreachable at
    // COMPILE time (`never`), so it can only fire if `CHECK_WRITER_MARKERS`
    // grew a member without this switch being opened. There is no ticket-safe
    // behaviour to model for a marker nothing has decided the meaning of.
    default: {
      const unhandled: never = marker;
      throw new Error(
        `finishCheckWriterStage: no handling for check-writer marker ` +
          `${String(unhandled)} — decide here whether it writes a check that ` +
          `must be committed and locked, before adding it to ` +
          `CHECK_WRITER_MARKERS.`,
      );
    }
  }
  // #909: BEFORE handing off, catch the check-writer moving the answer key. Its
  // committed edits are absorbed into `nextPreSha` (the builder's ship base), so
  // the ship-time lock can never see them — this compares the ENTRY sha to that
  // baseline, the one window that still holds them. Excludes the check directory
  // this run legitimately created; stops the ticket on anything else.
  if (sandbox.worktreePath !== undefined) {
    const tamper = enforceCheckWriterProtectedPaths(
      sandbox.worktreePath,
      preSha,
      nextPreSha,
      location?.checkDir,
    );
    if (tamper.unmeasurable) {
      // A real change sits between the entry sha and the ship base, but git
      // could not report what it was. The frozen answer key CANNOT be cleared,
      // so the loop must not proceed as if it were clean — silence is not an
      // all-clear (the same stance `postMergeFixerProofRefusal` takes). Stop
      // the ticket for a human, honestly stating the diff was unmeasurable.
      const reason =
        `[issue=${ctx.issueNumber}] check-writer-protected-paths-unmeasurable: ` +
        `a real change lies between the ticket's entry state and the builder's ` +
        `ship base, but git could not be asked what the check-writer changed ` +
        `(git diff failed or a ref would not resolve). The frozen answer key ` +
        `cannot be proven untouched, so this is "unknowable", not "nothing was ` +
        `altered" — refusing to hand off. Usually a bad worktree state, not a ` +
        `wrong ticket.`;
      ctx.deps.logError(reason);
      throw new ProtectedPathTamperStopError({
        postSha: nextPreSha,
        nth: 1,
        violations: [],
        message: reason,
      });
    }
    if (tamper.violations.length > 0) {
      const failed = tamper.restored.filter((r) => !r.restored);
      // A restore that could not be done, or could not be committed, is an
      // environment fault: the frozen files cannot be put back, so nothing
      // may be built on them. Every other edit is undone and never stops the
      // ticket (spec #1334).
      const restoreFault = (why: string): ProtectedPathTamperStopError =>
        new ProtectedPathTamperStopError({
          postSha: nextPreSha,
          nth: 1,
          violations: tamper.violations,
          message:
            `check-writer-protected-paths-restore-failed: issue #${ctx.issueNumber} ` +
            `— the check-writer edited ${tamper.violations.join(", ")}, files the ` +
            `loop freezes against every agent, and ${why}, so the edit could not ` +
            `be undone. Quarantining for human triage.`,
        });
      if (failed.length > 0) {
        throw restoreFault(
          `the restore of ${failed.map((r) => r.path).join(", ")} failed`,
        );
      }
      const worktree = sandbox.worktreePath;
      const committable = tamper.violations.filter(
        (p) =>
          existsSync(path.join(worktree, p)) ||
          runGit(worktree, "ls-files", "--error-unmatch", "--", p).ok,
      );
      if (committable.length > 0) {
        const restoredSha = commitRestoredPaths(
          worktree,
          committable,
          `chore(sandcastle): restore protected files the check-writer edited for issue #${ctx.issueNumber}\n\n` +
            `The check-writer edited ${tamper.violations.join(", ")}, which the ` +
            `loop freezes against every agent. Each is restored byte-for-byte ` +
            `from the ticket's entry state.`,
        );
        if (restoredSha === undefined) throw restoreFault("the restore commit failed");
        nextPreSha = restoredSha;
      }
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] check-writer-protected-paths-restored: the ` +
          `check-writer committed a change to ${tamper.violations.length} ` +
          `path(s) this loop refuses to let any agent alter: ` +
          `${tamper.violations.join(", ")}. Each was restored byte-for-byte ` +
          `from the ticket's entry state; the ticket goes on.`,
      );
      // The first test's proof ran against the edited files, so it is run
      // again on the restored ones. Still red: the test stands. Anything
      // else: the ticket goes on with no first test.
      if (check !== undefined && checkKindForMarker(marker) !== undefined && fallThrough === undefined) {
        const rerun = await rerunInconclusiveProof(ctx, sandbox, check, "restored");
        if (rerun.mustFailFirst !== "red") {
          fallThrough = {
            reason: "no-failing-check",
            detail:
              `The test-writing AI edited ${tamper.violations.join(", ")} — files ` +
              `the loop freezes because a test is graded against them. They were ` +
              `restored, and the first test, run again on the restored files, ` +
              `came back '${rerun.mustFailFirst ?? "unknown"}' instead of red ` +
              `(${rerun.mustFailFirstReason ?? "no reason recorded"}).`,
          };
          await recordFirstTestFallThrough(ctx, fallThrough);
        }
      }
    }
  }
  // The four ternaries this replaced each re-asked "is this CHECKS_WRITTEN",
  // which is four chances to forget the second check marker. `checkKind` is the
  // one answer, derived once: present iff this outcome wrote a check, so the
  // three check-shaped fields ride on the same condition rather than on three
  // independent restatements of it. `screen` stays absent on the unit route
  // because there is nothing to name — a unit check has no page.
  const checkKind = checkKindForMarker(marker);
  // #1198 A: the flag rides onward on `ctx` itself, so the review rounds, the
  // fixer and the ship funnel (`shipAfterMigrations`) — each of which already
  // takes `ctx` — see it for free. See `PipelineCtx.firstTestFellThrough`'s own doc comment for the
  // whole argument, including the second reason this comment used to give
  // (a forgettable extra positional parameter) that issue #1227 retired
  // outright. Do not re-derive that dead one here.
  const outCtx: PipelineCtx =
    fallThrough === undefined
      ? nextCtx
      : { ...nextCtx, firstTestFellThrough: fallThrough };
  return {
    proceed: true,
    ctx: outCtx,
    preSha: nextPreSha,
    marker,
    checkKind,
    checkPath: checkKind !== undefined ? check?.checkPath : undefined,
    checkLocation: checkKind !== undefined ? location : undefined,
    checkCommand: checkKind !== undefined ? check?.checkCommand : undefined,
    // The unit check's hosting package, carried so the ship-time re-run can
    // rebuild a unit command with a fresh nonce (issue #972 gap 1).
    checkPackage: checkKind !== undefined ? check?.checkPackage : undefined,
    screen: checkKind === "browser" ? check?.screen : undefined,
    // Issue #1176: the ship-time harness's window scales with this.
    checkTestCount:
      checkKind !== undefined ? check?.mustFailFirstTestCount : undefined,
    // #1198 A: absent on every healthy ticket, set on the fall-through — and
    // `runIssuePipeline` copies it onto `ctx`, which is how both ship funnels
    // learn that the reviewer's pass is this ticket's only gate.
    withoutFirstTest: fallThrough,
  };
}

/**
 * Rebuild this check's run command with a FRESH nonce.
 *
 * The nonce is the key the runner's machine-readable report is signed with,
 * and `buildCheckCommand`'s own contract is one fresh nonce PER RUN: the check
 * imports real product code, so builder-authored code executes inside the
 * check's process, and replaying a nonce hands that code the report path the
 * next verdict is read from. `CheckWriterResult.checkCommand` carries the
 * nonce the check-writer's own proof already spent, so the ruling-4 green run
 * mints its own here instead of replaying it.
 *
 * `packageDir` is the check-writer's own `checkPackage` — whitelisted to
 * `packages/<name>` by the schema before anything is opened — and it is
 * REQUIRED on the unit route. This used to re-derive it by string-slicing the
 * suffix off `location.checkDir`, which was a second, hand-rolled inverse of
 * `unitCheckDirFor()`: two spellings of one path shape, and only one of them
 * would have been updated the day that shape changed. The package NAME is
 * still read off the host's disk and never from anything an agent wrote.
 */
function rebuildCheckCommandFor(
  worktreePath: string,
  location: CheckLocation,
  packageDir: string | undefined,
  nonce: string,
): string | undefined {
  if (location.kind === "browser") {
    return buildCheckCommand(location.issueNumber, location.checkPath, nonce);
  }
  if (packageDir === undefined) return undefined;
  const resolved = resolveUnitCheckPackage(worktreePath, packageDir);
  if (resolved === undefined) return undefined;
  return buildUnitCheckCommand(
    resolved.packageName,
    location.issueNumber,
    location.checkPath,
    nonce,
  );
}

/**
 * The command and nonce the SHIP-TIME re-run should actually execute (issue
 * #972 gap 1).
 *
 * The check imports real product code, so builder-authored code runs inside the
 * check's process, and `checkCommand` carries the nonce the must-fail-first
 * proof already spent — replaying it hands that code the exact report path the
 * ship verdict is read from. So when the check's location is in hand this mints
 * a FRESH nonce and REBUILDS the command around it: the rebuilt command writes
 * its report under the fresh nonce, and the evidence is read under the same one.
 * A fresh nonce on the OLD command would key the evidence to a value the command
 * never writes under, so the verdict would read `inconclusive` — the gate
 * silently switching itself off.
 *
 * Fail-closed fallback to the recovered nonce when no location is threaded
 * (every test double, any caller that ran no check-writer stage) or the rebuild
 * cannot resolve its package — exactly today's behaviour, never a false green.
 */
export function shipTimeRunCommand(opts: {
  readonly checkCommand: string;
  readonly location?: CheckLocation;
  readonly checkPackage?: string;
  readonly worktreePath?: string;
}): { readonly command: string; readonly nonce: string } {
  const fallback = {
    command: opts.checkCommand,
    nonce: checkNonceFromCommand(opts.checkCommand) ?? "",
  };
  if (opts.location === undefined || opts.worktreePath === undefined) {
    return fallback;
  }
  const freshNonce = newCheckNonce();
  const rebuilt = rebuildCheckCommandFor(
    opts.worktreePath,
    opts.location,
    opts.checkPackage,
    freshNonce,
  );
  if (rebuilt === undefined) return fallback;
  return { command: rebuilt, nonce: freshNonce };
}

/**
 * Rewrite the first test once and PROVE the rewrite, or put the accepted test
 * back. Host code reads every exit code; nothing here trusts an agent's
 * account of its own grade.
 *
 * The proof is the first test's own rule applied to the rewrite: it must FAIL
 * against the code the builder was handed (run inside `withWorktreeAt`, which
 * stands the tree back on `preSha` and proves its own restore) and PASS
 * against the code the builder produced. Anything short of that is
 * `unproven`, and the ACCEPTED test is restored and committed so the branch
 * never carries a test the run declined to certify.
 *
 * A failure to put the accepted test back throws: the working copy would hold
 * a rewrite in no commit, which strands the run's final promotion, and no
 * fall-through can make that safe.
 */
async function proveFirstTestRewrite(
  sb: SandboxHandle,
  ctx: PipelineCtx,
  opts: {
    readonly preSha: string;
    readonly currentSha: string;
    readonly brief: string;
  },
): Promise<
  | {
      readonly kind: "proved";
      readonly postSha: string;
      readonly check: RewrittenFirstTest;
    }
  | {
      readonly kind: "unproven";
      readonly postSha: string;
      readonly why: string;
    }
> {
  const worktreePath = sb.worktreePath;
  const frozen = ctx.frozenCheck?.current;
  const unproven = (why: string, postSha = opts.currentSha) =>
    ({ kind: "unproven", postSha, why }) as const;
  if (worktreePath === undefined) {
    return unproven(
      "this sandbox has no worktree on disk, so the code the builder was handed cannot be stood back up",
    );
  }
  if (frozen === undefined) {
    return unproven(
      "the run holds no frozen copy of the accepted first test, so a rewrite could be neither graded nor undone",
    );
  }
  if (opts.preSha.length === 0 || opts.currentSha.length === 0) {
    return unproven("the run does not hold both commits the proof compares");
  }
  const builderDiff = diffStatsBetween(
    ctx.args.repoRoot,
    opts.preSha,
    opts.currentSha,
  );
  if (builderDiff === null) {
    return unproven(
      "the builder's own diff could not be read, so the pre-builder proof could not be built",
    );
  }
  const hazard = replayHazardIn(builderDiff.changedFiles);
  if (hazard !== undefined) return unproven(hazard);

  ctx.telemetry?.noteFirstTestRewrite("attempted");

  /** Put the accepted test back on disk AND in a commit, then report why the
   *  rewrite did not count. */
  const putBack = (
    why: string,
  ): {
    readonly kind: "unproven";
    readonly postSha: string;
    readonly why: string;
  } => {
    const restored = restoreFrozenCheck(worktreePath, frozen);
    const sha = restored.ok
      ? ensureDirCommitted(
          worktreePath,
          frozen.location.checkDir,
          `chore(sandcastle): put back the accepted first test for issue #${ctx.issueNumber}\n\n` +
            `The reviewer said this ticket's first test was wrong and the ` +
            `test-writing AI rewrote it, but the rewrite could not be proved: ` +
            `${why}\n\nSANDCASTLE-CHECK-DIR-COMMIT: 1`,
        )
      : undefined;
    if (sha === undefined) {
      throw new Error(
        `[issue=${ctx.issueNumber}] first-test rewrite: the rewrite was refused ` +
          `(${why}) and the accepted first test could NOT be put back and ` +
          `committed${restored.ok ? "" : ` (${restored.because})`} — the ` +
          `working copy may hold a rewrite in no commit, which blocks the run's ` +
          `final promotion.`,
      );
    }
    ctx.telemetry?.noteFirstTestRewrite("stopped");
    return unproven(why, sha);
  };

  let result: CheckWriterResult;
  try {
    result = await runCheckWriter(sb, ctx, {
      attempt: 2,
      repairBrief: opts.brief,
      // This function runs the proof itself, below, against the real
      // pre-builder commit.
      proofRunByCaller: true,
    });
  } catch (err) {
    return putBack(
      `the test-writing AI could not rewrite the test — ${(err as Error).message}`,
    );
  }
  const location = result.checkLocation;
  if (
    checkKindForMarker(result.marker) === undefined ||
    location === undefined
  ) {
    return putBack(
      `the test-writing AI answered '${result.marker}' and left no test file to run`,
    );
  }
  // SAME FILE, SAME DIRECTORY. The protected-path lock and the freeze both
  // cover this ticket's ONE check directory, and every later ship site still
  // names the original file — so a rewrite that moved anywhere else would sit
  // outside the lock, or leave a ship-time run pointing at a file that is gone.
  if (
    location.checkDir !== frozen.location.checkDir ||
    location.checkPath !== frozen.location.checkPath
  ) {
    if (location.checkDir !== frozen.location.checkDir) {
      rmSync(path.join(worktreePath, location.checkDir), { recursive: true, force: true });
    }
    return putBack(
      `the rewrite landed at ${location.checkDir}/${location.checkPath}, not ` +
        `in place of this ticket's own first test ` +
        `${frozen.location.checkDir}/${frozen.location.checkPath}`,
    );
  }
  const rewrittenDir = freezeRepairedCheckDir(worktreePath, location);
  if (rewrittenDir === undefined) {
    return putBack("the rewritten test could not be read off disk");
  }
  const rewrittenFreeze = withRepairedCheckDir(frozen, rewrittenDir);
  // Committed BEFORE the red replay: `withWorktreeAt` refuses a worktree
  // holding tracked edits that are in no commit.
  const rewrittenSha = ensureDirCommitted(
    worktreePath,
    location.checkDir,
    `chore(sandcastle): commit the rewritten first test for issue #${ctx.issueNumber}\n\n` +
      `The reviewer said this ticket's first test contradicted the ticket, so ` +
      `the test-writing AI rewrote it once with the reviewer's reason. The run ` +
      `proves it next: it must FAIL against the code the builder was handed and ` +
      `PASS against the code it produced.\n\nSANDCASTLE-CHECK-DIR-COMMIT: 1`,
  );
  if (rewrittenSha === undefined) {
    return putBack("the rewritten test could not be committed");
  }

  const runFrozen = async (
    expect: "red" | "green",
  ): Promise<CheckRunVerdict> => {
    const restored = restoreFrozenCheck(worktreePath, rewrittenFreeze);
    if (!restored.ok)
      return { status: "inconclusive", reason: restored.because };
    const nonce = newCheckNonce();
    const command = rebuildCheckCommandFor(
      worktreePath,
      location,
      result.checkPackage,
      nonce,
    );
    if (command === undefined) {
      return {
        status: "inconclusive",
        reason: "no runnable command could be built for this check",
      };
    }
    ctx.status?.noteProgress?.();
    return await runCheckCommand(
      location.kind,
      sb.exec,
      command,
      expect,
      nonce,
      scaledCheckTimeoutBudgetMs(
        location.kind,
        countCheckScenarios(
          rewrittenFreeze.checkDir.bytesByRelPath
            .get(location.checkPath)
            ?.toString("utf8") ?? "",
        ),
      ),
      {
        repoRoot: ctx.args.repoRoot,
        branch: sb.branch,
        issueNumber: ctx.issueNumber,
        phase: "ship" as const,
        worktreePath,
        onError: ctx.deps.logError,
      },
      result.screen,
    );
  };

  // RED against the code the builder was handed.
  const replay = await withWorktreeAt(
    worktreePath,
    opts.preSha,
    rewrittenSha,
    async () => await runFrozen("red"),
  );
  const read = readReplayFailure(replay);
  if (!read.ok) {
    if (read.failure.worktreeUnsafe) {
      throw new Error(
        `[issue=${ctx.issueNumber}] first-test rewrite: the worktree could NOT ` +
          `be proved back where it started after the pre-builder replay — ` +
          `nothing from this ticket may ship. ${read.failure.because}`,
      );
    }
    return putBack(read.failure.because);
  }
  const red = readPostBuilderRedProof({
    status: read.value.status,
    reason: read.value.reason,
  });
  if (!red.proved) return putBack(red.because);

  // GREEN against the code the builder produced.
  const greenVerdict = await runFrozen("green");
  const green = readPostBuilderGreenProof({
    status: greenVerdict.status,
    reason: greenVerdict.reason,
  });
  if (!green.proved) return putBack(green.because);

  // The rewrite is what ships, so it becomes the accepted copy every later
  // grade and every tamper restore reads.
  const finalRestore = restoreFrozenCheck(worktreePath, rewrittenFreeze);
  if (!finalRestore.ok) return putBack(finalRestore.because);
  if (ctx.frozenCheck !== undefined) ctx.frozenCheck.current = rewrittenFreeze;
  ctx.telemetry?.noteFirstTestRewrite("repaired");
  const kind = checkKindForMarker(result.marker);
  return {
    kind: "proved",
    postSha: rewrittenSha,
    check: {
      checkLocation: location,
      checkCommand: result.checkCommand,
      checkKind: kind,
      screen: kind === "browser" ? result.screen : undefined,
      checkPackage: result.checkPackage,
    },
  };
}

/** What the first test's one rewrite returned ({@link rewriteFirstTestOnce}). */
export type FirstTestRewriteOutcome =
  /** Rewritten AND proved — red on the code the builder was handed, green on
   *  the code it produced — and the reviewer passed it on a fresh look. Every
   *  ship input must come from `rewrittenCheck`, never the pre-rewrite one. */
  | {
      readonly kind: "proved";
      readonly postSha: string;
      readonly reReview: { readonly marker: string; readonly stdout: string };
      readonly rewrittenCheck: RewrittenFirstTest;
    }
  /** The test and the code still disagree (the rewrite was unusable or could
   *  not be proved), the original test is back in place, and the reviewer
   *  passed the code on a fresh look told there is no first test behind it.
   *  Ships labelled `shipped-without-first-test`. */
  | {
      readonly kind: "dropped";
      readonly postSha: string;
      readonly reReview: { readonly marker: string; readonly stdout: string };
      readonly fellThrough: FirstTestFallThrough;
    }
  /** The reviewer refused again on the fresh look. `fellThrough` is set when
   *  the rewrite was dropped, so a later ship still carries the label;
   *  `rewrittenCheck` is set when the rewrite was PROVED, so every later
   *  round and the ship gate use the rewritten test, not the original. */
  | {
      readonly kind: "second-refusal";
      readonly postSha: string;
      readonly reReview: { readonly marker: string; readonly stdout: string };
      readonly fellThrough?: FirstTestFallThrough;
      readonly rewrittenCheck?: RewrittenFirstTest;
    };

/**
 * THE FIRST TEST'S ONE REWRITE (spec #1334). Reached only when
 * `wrongCheckRewriteEligibility` answers `rewrite`: the reviewer declared
 * `GROUNDS: WRONG-CHECK` on a ticket that has a first test of its own and has
 * not spent its rewrite yet.
 *
 *   1. The test-writing AI rewrites the test once, briefed with the
 *      reviewer's own reason ({@link firstTestRewriteBrief}).
 *   2. The host proves the rewrite ({@link proveFirstTestRewrite}): red on the
 *      code the builder was handed, green on the code it produced.
 *   3. Proved: the reviewer looks again at the code beside the rewritten test.
 *      Not proved — the test and the code still disagree: the accepted test is
 *      put back, the ticket is marked as having no first test, and the
 *      reviewer looks again told its pass is the only gate.
 *
 * The run never merges over the reviewer's objection: either way, nothing
 * ships without a fresh `ALL_CLEAR`.
 */
export async function rewriteFirstTestOnce(
  sb: SandboxHandle,
  ctx: PipelineCtx,
  opts: {
    /** The reviewer's own reason, from its `GROUNDS: WRONG-CHECK (…)` line. */
    readonly reason: string;
    /** The refusing reviewer's raw output, for its one-line findings. */
    readonly reviewStdout: string;
    readonly preSha: string;
    readonly postSha: string;
    readonly reviewerModel: string | undefined;
    readonly skillsInvoked: readonly string[];
    readonly certification: ImplementerOutputParsed | undefined;
    /** Names the site in the log line. */
    readonly where: string;
  },
): Promise<FirstTestRewriteOutcome> {
  ctx.firstTestRewriteSpent.current = true;
  const sweep = extractCategorySweep(opts.reviewStdout);
  const findings =
    sweep === null
      ? []
      : [...sweep.values()]
          .filter((e) => e.status === "finding")
          .map((e) => `- ${e.line}`);
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] ${opts.where}: the reviewer said this ticket's ` +
      `first test is wrong (GROUNDS: WRONG-CHECK) — the test-writing AI gets its ` +
      `one rewrite.`,
  );
  const proof = await proveFirstTestRewrite(sb, ctx, {
    preSha: opts.preSha,
    currentSha: opts.postSha,
    brief: firstTestRewriteBrief({ reason: opts.reason, findings }),
  });

  if (proof.kind === "proved") {
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] ${opts.where}: the rewritten first test proved ` +
        `itself — red against the code the builder was handed (${opts.preSha}), ` +
        `green against the code it produced. The reviewer is asked to look at ` +
        `${proof.postSha} again.`,
    );
    const reReview = await runReviewer(
      sb,
      ctx,
      proof.postSha,
      undefined,
      opts.reviewerModel,
      {
        name: "reviewer-check-repaired",
        skillsInvoked: opts.skillsInvoked,
        certification: opts.certification,
        implementerRebuttal:
          "(This is not the implementer's own words. On your previous pass you " +
          "said this ticket's first test contradicted the ticket. The test-writing " +
          "AI has rewritten it once with your reason, and the run proved the " +
          "rewrite red against the code the builder was handed and green against " +
          "the code it produced. Please review the current state of the code and " +
          "the rewritten test against the ticket again from scratch and give your " +
          "own independent verdict.)",
        checkWriterCheckPath: path.posix.join(
          proof.check.checkLocation.checkDir,
          proof.check.checkLocation.checkPath,
        ),
        checkWriterCheckCommand: proof.check.checkCommand,
        checkWriterScreen: proof.check.screen,
        // Always `undefined` here — a ticket already going on without a
        // first test never reaches a rewrite (`ownFirstTestState`) — but
        // carried by name like every other dispatch (#1198 F2 guard).
        checkWriterFallThrough: ctx.firstTestFellThrough,
      },
    );
    return reReview.marker === "ALL_CLEAR"
      ? {
          kind: "proved",
          postSha: proof.postSha,
          reReview,
          rewrittenCheck: proof.check,
        }
      : {
          kind: "second-refusal",
          postSha: proof.postSha,
          reReview,
          rewrittenCheck: proof.check,
        };
  }

  // THE TEST AND THE CODE STILL DISAGREE. The first test never stops a ticket
  // by itself: the ticket goes on with no first test, the reviewer's pass is
  // its only gate, and the merge is labelled `shipped-without-first-test`.
  const fellThrough: FirstTestFallThrough = {
    reason: "test-disagreed",
    detail:
      `The reviewer said this ticket's first test contradicted the ticket ` +
      `(${opts.reason.trim().length > 0 ? opts.reason.trim() : "no reason given"}). ` +
      `The test-writing AI rewrote it once with that reason, and the rewrite ` +
      `could not be used: ${proof.why} The accepted test was put back, and ` +
      `the reviewer was asked to look at the code again knowing its pass is ` +
      `the only gate.`,
  };
  ctx.deps.logError(
    `[issue=${ctx.issueNumber}] ${opts.where}: first-test fall-through — the ` +
      `rewritten first test could not be used (${proof.why}). The ticket goes ` +
      `on with no first test; the reviewer's pass is the only gate.`,
  );
  await recordFirstTestFallThrough(ctx, fellThrough);
  const reReview = await runReviewer(
    sb,
    ctx,
    proof.postSha,
    undefined,
    opts.reviewerModel,
    {
      name: "reviewer-without-first-test",
      skillsInvoked: opts.skillsInvoked,
      certification: opts.certification,
      implementerRebuttal:
        "(This is not the implementer's own words. On your previous pass you " +
        "said this ticket's first test contradicted the ticket. It was rewritten " +
        "once and the rewrite could not be proved, so the ticket now has no first " +
        "test behind it. Please review the code against the ticket again from " +
        "scratch and give your own independent verdict.)",
      checkWriterFallThrough: fellThrough,
    },
  );
  return reReview.marker === "ALL_CLEAR"
    ? { kind: "dropped", postSha: proof.postSha, reReview, fellThrough }
    : { kind: "second-refusal", postSha: proof.postSha, reReview, fellThrough };
}

/**
 * The one thing the no-verdict re-ask says (issue #1128). Substituted into
 * `review-prompt.md`'s `{{VERDICT_FORMAT_REMINDER}}`, which is EMPTY on every
 * ordinary pass.
 *
 * It quotes the shape that failed, because that is the whole lesson: the
 * reviewer on ticket #1038 did emit the right word, inside a sentence, and read
 * back its own output as compliant. Naming the exact line it wrote is what
 * separates "say it again" from "say it differently".
 *
 * WHY IT ASKS FOR THE WHOLE REVIEW AGAIN, AND NEVER CLAIMS PRIOR MEMORY: every
 * `sb.run` spawns a FRESH agent session — `lib/mac-host-sandbox.ts:335` mints a
 * new `randomUUID()` session id on every production run, so the re-ask reaches
 * a model that has never seen this commit, this diff, or the reply that failed.
 * Text telling it that it "already reviewed this", that its verdict "stands",
 * or that it must "not re-run any check" is simply false to the only reader
 * this block ever has — and it lands at the very END of `review-prompt.md`,
 * the highest-salience position, where it would outrank the review instructions
 * above it. Two ways that bites. FAIL-OPEN: when pass 1 died mid-review it left
 * no verdict at all (the exact case this retry exists for), so a cold session
 * told it already has one would find the only verdict words in front of it are
 * the `ALL_CLEAR` examples below — an obedient model then approves work nobody
 * reviewed. And SELF-INFLICTED STOP: a reviewer told not to review replies with
 * a bare token and no CATEGORY SWEEP block, `extractCategorySweep` returns
 * null, and the ticket is withheld — the re-ask manufacturing the stop it
 * exists to clear. So it asks for the full review, sweep included, and adds
 * only the format correction on top.
 */
const VERDICT_FORMAT_REASK = [
  "# RE-ASK — THE PREVIOUS ATTEMPT'S VERDICT WAS NOT READABLE",
  "",
  "Do the review exactly as instructed above, in full — the findings, the",
  "CATEGORY SWEEP block, and then the final marker. Nothing above this section",
  "is waived, shortened, or already done.",
  "",
  "One thing failed on the previous attempt, and it was the final line alone.",
  "The loop reads only the last non-empty line of your reply, and only accepts",
  "it when that line IS the bare token. That attempt ended with a sentence, and",
  "a sentence about the verdict is not the verdict. This is the shape that",
  "failed:",
  "",
  "    The review stands as delivered, with the verdict ALL_CLEAR.",
  "",
  "That is what NOT to write. It reads as an approval to a person and as no",
  "answer at all to the loop, and the ticket stops with nobody having objected.",
  "",
  "End instead with the token alone on its own line, nothing after it but an",
  "optional `Unverified:` / `Skipped:` sign-off:",
  "",
  "    ALL_CLEAR",
  "",
  "or",
  "",
  "    HAS_BLOCKERS",
].join("\n");

/**
 * What the reviewer is told on a ticket built without a first test (#1198 A).
 *
 * TWO THINGS, and both have to be said or the paragraph does harm.
 *
 * 1. **Your pass is the gate.** The rest of `review-prompt.md` tells this
 *    agent its own run of the check is a pre-flight and the ship-time harness
 *    decides. On these tickets that harness run does not happen. A reviewer
 *    that waves something through believing a second instrument will catch it
 *    is the one way this whole change could ship worse code than it means to.
 * 2. **The bar does not move.** Not "be stricter" — a reviewer told to be
 *    stricter refuses working code, which is the failure this ticket exists
 *    to stop, arriving one stage later and having cost a build. The standard
 *    is the same standard; what changed is that nothing sits behind it.
 */
function firstTestFallThroughNotice(
  fallThrough: FirstTestFallThrough,
): string {
  const because =
    fallThrough.reason === "no-failing-check"
      ? "a check was written for it, and it passed against the unchanged " +
        "code — so it could never have caught this ticket's absence"
      : "the loop could not settle whether the check written for it was " +
        "any good — its own machinery never produced a readable result";
  return (
    `**THIS TICKET HAS NO TRUSTWORTHY FIRST TEST, AND YOUR PASS IS THE ONLY ` +
    `GATE IT HAS.** Before the builder ran, ${because}.

` +
    `What that changes:

` +
    `- The line above saying your run of the check is "a PRE-FLIGHT, not the ` +
    `verdict" does NOT apply to this ticket. There is no second, ` +
    `ship-time run of that check behind you. If you emit \`ALL_CLEAR\`, this ` +
    `ships.
` +
    `- If a check path is named above, run it anyway and read the output — ` +
    `it is still the best independent evidence available — but treat a ` +
    `green from it as WEAK evidence, not proof. It is exactly the check that ` +
    `could not be trusted.
` +
    `- Lean harder on what you CAN verify yourself: read the diff against ` +
    `what the ticket asked for, run the project's own suites, and check the ` +
    `builder's own tests actually exercise the described behaviour rather ` +
    `than asserting around it.

` +
    `**Do not raise your bar.** The standard is the same standard. Refusing ` +
    `working code because the paperwork behind it is thin costs exactly what ` +
    `the missing check cost. Judge the code.`
  );
}

export async function runReviewer(
  sb: SandboxHandle,
  ctx: PipelineCtx,
  commitSha: string,
  promptFile = "./.sandcastle/review-prompt.md",
  model?: string,
  opts: {
    implementerRebuttal?: string;
    name?: string;
    skillsInvoked?: readonly string[];
    /**
     * The implementer's schema-validated certification envelope for the pass
     * being reviewed (issue #886). Rendered into `{{IMPLEMENTER_CERTIFICATION}}`.
     *
     * Omitted on the first review of already-built work, which no build pass
     * produced — `renderImplementerCertification` says so explicitly rather
     * than rendering an empty block.
     */
    certification?: ImplementerOutputParsed | undefined;
    /**
     * The check-writer's check (issue #911, Piece D), when this ticket has
     * one — absent for `NO_SCREEN_APPLIES`, and absent on the fixer's reviews
     * only when the check-writer stage never produced a check before the
     * pipeline threw (the fixer's reviews are the same `runReviewRounds` the
     * builder's are, so they carry the same fields). Rendered into
     * `{{CHECK_WRITER_*}}` so `review-prompt.md` can tell the reviewer this
     * check is AUTHORITATIVE evidence, distinct from the builder's own tests,
     * which are scaffolding only.
     */
    checkWriterCheckPath?: string;
    checkWriterCheckCommand?: string;
    checkWriterScreen?: string;
    /**
     * Set ONLY when this ticket is being built without a first test the loop
     * could stand behind (#1198 A). Rendered into
     * `{{CHECK_WRITER_FALL_THROUGH}}`, which is EMPTY on every ordinary
     * ticket — same discipline as `verdictFormatReask`: a prompt paragraph
     * that appears every time is a paragraph nobody reads.
     *
     * It exists because the fall-through changes what the reviewer's own run
     * of the check MEANS. `review-prompt.md` otherwise tells it, correctly,
     * that its run is a pre-flight and the ship-time harness decides. On
     * these tickets there is no ship-time harness run — this reviewer's pass
     * is the only gate the ticket has.
     */
    checkWriterFallThrough?: FirstTestFallThrough;
    /**
     * Set ONLY by the no-verdict re-ask below (issue #1082 fault 4, built
     * under issue #1128). Renders {@link VERDICT_FORMAT_REASK} into
     * `{{VERDICT_FORMAT_REMINDER}}`, which is empty on every ordinary pass —
     * a reviewer that formatted its verdict correctly must never be nagged
     * about it, because a prompt that always shouts is a prompt nobody reads.
     */
    verdictFormatReask?: boolean;
    /**
     * Set ONLY on the first review of work no build pass produced this
     * attempt (spec #1334, SG). Rendered into `{{REVIEW_SITUATION}}`, EMPTY
     * on every ordinary pass — see {@link reviewSituationNotice}.
     */
    situation?: ReviewSituation;
  } = {},
  // One-shot guard for the no-verdict retry. Turn-exhaustion returns partial
  // output with no marker on the last line, so extractMarker throws
  // MarkerNotFoundError — NOT a code-level rejection. Mirror the post-merge
  // reviewer: retry ONCE on the same model, then let the error propagate (the
  // runIssuePipeline catch defers it). `false` on the recursive call caps it.
  retryOnNoVerdict = true,
): Promise<{ marker: string; stdout: string }> {
  const primaryModel = model ?? ctx.args.reviewerModel;
  // Only the default reviewer pass gets a rate-limit fallback. The escalated
  // reviewer-retry pass (already on escalations[0]) has no further fallback.
  const fallbackModel =
    primaryModel === ctx.args.reviewerModel
      ? roleModelsFor(ctx.args).reviewer.escalations[0]
      : undefined;
  const skillsInvoked = opts.skillsInvoked ?? [];
  // Review the whole branch vs its fork point, not just the tip commit's
  // delta (issue #340 false-quarantined a WIP+final-commit branch). Computed
  // on the HOST where full history is reliable (the sandbox worktree shares
  // repoRoot's .git, so both refs resolve here), then passed as a concrete SHA
  // so the in-prompt `git diff` runs against two tip-reachable objects and can
  // never exit non-zero — a failing bang-command crashes the entire review.
  const reviewBase = reviewBaseForCommit(
    ctx.args.repoRoot,
    ctx.args.branch,
    commitSha,
  );
  const r = await timeIssueRole(ctx, "reviewer", () =>
    runWithRateLimitFallback(
      (m) =>
        sb.run({
          name: opts.name ?? "reviewer",
          maxIterations: 1,
          model: m,
          promptFile,
          idleTimeoutSeconds: ctx.args.reviewerTimeoutSec,
          promptArgs: {
            ITERATION: String(ctx.ticketOrdinal),
            ISSUE_NUMBER: String(ctx.issueNumber),
            // Host-read ticket text; the sandbox has no GitHub key (spec
            // #1334, SB).
            ISSUE_SPEC: issueSpecFor(ctx),
            COMMIT_SHA: commitSha,
            // The reviewer takes the base WHICHEVER rule produced it — the
            // `<sha>~1` fallback exists precisely so a review is never handed
            // an empty diff. Only measurement callers refuse it (shipDiffBase).
            REVIEW_BASE: reviewBase.ref,
            BRANCH: ctx.issue.branch,
            IMPLEMENTER_REBUTTAL: opts.implementerRebuttal ?? "",
            SKILLS_INVOKED:
              skillsInvoked.length === 0
                ? "(none invoked)"
                : skillsInvoked.join(", "),
            // Issue #886: the implementer's own report card, forwarded verbatim
            // instead of being parsed-then-discarded. The placeholder lint
            // (lib/lint-placeholders.ts) requires this key to exist for the
            // matching {{IMPLEMENTER_CERTIFICATION}} in review-prompt.md.
            IMPLEMENTER_CERTIFICATION: renderImplementerCertification(
              opts.certification,
            ),
            // Issue #911: which check (if any) is authoritative evidence for
            // this ticket, as opposed to the builder's own scaffolding
            // tests. Empty strings when this ticket has no check-writer
            // check (NO_SCREEN_APPLIES, or a pipeline that threw before the
            // check-writer stage ran).
            CHECK_WRITER_CHECK_PATH: opts.checkWriterCheckPath ?? "",
            CHECK_WRITER_CHECK_COMMAND: opts.checkWriterCheckCommand ?? "",
            CHECK_WRITER_SCREEN: opts.checkWriterScreen ?? "",
            // #1198 A: empty on every ordinary ticket. On a fall-through it
            // carries the one instruction this pass exists to deliver — see
            // `checkWriterFallThrough` above and FIRST_TEST_FALL_THROUGH_NOTICE.
            CHECK_WRITER_FALL_THROUGH:
              opts.checkWriterFallThrough !== undefined
                ? firstTestFallThroughNotice(opts.checkWriterFallThrough)
                : "",
            // Spec #1334, SG: empty on every ordinary pass. Set on the first
            // review of work no build pass produced this attempt — resumed
            // finished work, or a change the test-writer read as already
            // built — so the reviewer does not read the absent certification
            // envelope as a finding. See `reviewSituationNotice`.
            REVIEW_SITUATION:
              opts.situation !== undefined
                ? reviewSituationNotice(opts.situation)
                : "",
            // Issue #1128: empty on every ordinary pass; the no-verdict re-ask
            // below fills it with the one instruction that pass exists to
            // deliver. See VERDICT_FORMAT_REASK.
            VERDICT_FORMAT_REMINDER: opts.verdictFormatReask
              ? VERDICT_FORMAT_REASK
              : "",
          },
        }),
      primaryModel,
      fallbackModel,
      ctx.deps.log,
      `reviewer (issue=${ctx.issueNumber})`,
      "reviewer",
    ),
  );
  // Phase-1 cost telemetry (best-effort).
  await captureIssueRoleCost(ctx, "reviewer", r);
  try {
    const marker = extractMarker(r.stdout, [
      "ALL_CLEAR",
      "HAS_BLOCKERS",
    ] as const);
    if (marker === "HAS_BLOCKERS") {
      ctx.telemetry?.noteReviewerBlockers();
      ctx.runCounters?.bump("reviewerBlockers");
    }
    return { marker, stdout: r.stdout };
  } catch (err) {
    // No verdict (ran out of turns / deferred the verdict without a marker).
    // Retry ONCE on the same model; a persistent no-verdict propagates so the
    // pipeline catch can defer (release for a fresh iteration) rather than
    // quarantine clean code over a turn-exhaustion.
    // NOT counted here. This catch runs on the outer call AND again on the
    // same-model retry below, and the pipeline catch then classifies the
    // rethrown error a third time — so bumping here would report ONE
    // no-verdict as three. The pipeline catch is the single counting site.
    if (retryOnNoVerdict && err instanceof MarkerNotFoundError) {
      // THE RE-ASK CARRIES AN INSTRUCTION (issue #1082 fault 4, built under
      // issue #1128). This retry already existed and it re-ran the IDENTICAL
      // prompt, so a reviewer whose only fault was writing its verdict into a
      // sentence had no reason to write it differently the second time. On
      // 2026-08-15 ticket #1038 was stopped this way with an explicit approval
      // on the page — the reviewer ended "The review stands as delivered, with
      // the verdict ALL_CLEAR." and the run recorded no verdict at all.
      //
      // The fix is HERE and not in the parser. `lib/verdicts/parse.ts:104-109`
      // states the safety property the upward walk exists for: it stops at the
      // first line that is neither blank nor a sign-off, because searching
      // further — or scanning the body — would let "I considered ALL_CLEAR
      // but…" stand in for a verdict nobody gave. That failure runs OPEN, and
      // issue #1082 names the open direction as an immediate launch gate. So
      // the walk is left exactly as strict as it was and the reviewer is asked
      // again, plainly, for the bare token.
      //
      // BOUNDED TO ONE. `false` on the recursive call caps it, as before — this
      // is a re-ask for the FORMAT of an answer already given, never a third
      // round of review, and a model that will not say the word plainly when
      // asked twice has not given a verdict.
      ctx.deps.logError(
        `reviewer (issue=${ctx.issueNumber}) emitted no verdict (${err.message}) — ` +
          `re-asking once on the same model, with an explicit instruction to put ` +
          `the bare token alone on the final line`,
      );
      return runReviewer(
        sb,
        ctx,
        commitSha,
        promptFile,
        model,
        { ...opts, verdictFormatReask: true },
        false,
      );
    }
    throw err;
  }
}

/** What the ship-time proof gate refused, and the evidence for it. */
interface ProofGateRefusal {
  readonly message: string;
  readonly touchedPaths: readonly string[];
  readonly disagreement: DisagreementEvidence;
  /**
   * Does this refusal stop the ticket (issue #969, carried across the #956
   * router rewrite; spec #1334)?
   *
   * Exactly ONE of the things this gate says is waived — recorded, and the
   * ticket ships: "the finished diff owed a proof it did not offer". That IS
   * the screen-check judgement, and holding tickets on it is what stopped four
   * backend tickets (#805/#820/#845/#848).
   *
   * Everything else here is `neverWaived`, because nothing downstream would
   * catch it and none of it is a judgement about screens:
   *
   *   - REMOVED TEST COVERAGE. vitest's include is `src/**`, so a deleted
   *     Playwright spec ships green by being absent.
   *   - AN UNKNOWABLE ANSWER — git could not be asked what the diff changed, or
   *     what it removed while the diff carried test material. Silence is not an
   *     all-clear (see `lib/review/diff-measurement.ts`).
   *   - ANOTHER TICKET'S LOCKED CHECK. Waiving that lets a ticket edit the
   *     instrument every other gate is measured by.
   *   - A MARKER THAT CANNOT SHIP, which is a loop bug over a real, unproven
   *     diff.
   *
   * Recording a screen judgement instead of stopping on it was never a
   * licence to drop coverage or to ship on an answer nobody has.
   */
  readonly neverWaived: boolean;
}

/**
 * THE SHIP-TIME PROOF GATE (issue #956). Does this FINISHED diff owe more
 * proof than the check-writer's outcome offers — or has it deleted the
 * coverage that made everything else safe?
 *
 * ONE function, called by the ONE per-issue ship gate, `shipAfterMigrations`,
 * which the builder and the fixer both ship through (spec #1334 SG deleted
 * the old rescue road's own gate), plus the post-merge fixer's gate. There
 * used to be two separately-written copies of the old guard, and the rescue
 * copy was simply MISSING for months — a ticket whose check-writer said "no
 * screen applies", then failed review, then got recovered by an agent that
 * edited `packages/api`, shipped with no check ever having run (2026-08-04
 * review, finding #1). One gate means that cannot recur silently.
 *
 * WHAT MAKES THIS TRUSTWORTHY, and it is the property to preserve: the caller
 * hands us the SAME `changedFiles` the protected-path lock just measured, from
 * the same fork-point base, spanning EVERY implementer and retry
 * commit on the issue — not the last attempt's narrow diff. So a builder
 * cannot dodge the gate by tidying up an earlier commit, and cannot dodge it
 * by doing the damage on a round nobody re-measured.
 *
 * The order is deliberate.
 *
 * 1. REMOVED TESTS FIRST, and under EVERY marker rather than only the no-proof
 *    one. A diff that writes a perfectly good browser check can still delete
 *    the 117-file Playwright suite: the protected-path lock covers only this
 *    issue's own check directory, the ship-time run executes only the ONE check
 *    file, and `verifyTestRun` runs vitest, whose include is `src/**` — so
 *    deleted Playwright specs go green by being absent. Passing one check
 *    proves nothing about coverage the same diff removed.
 *
 *    THE TICKET MAY HAVE AGREED ALREADY. `opts.issueBody` is the issue's own
 *    text, read at CLAIM time (see {@link PipelineCtx.issueBody}), and a test
 *    file it named as an intended deletion is dropped from the removal set
 *    rather than stopped on. The rule this gate states is "it needs a person to
 *    agree", and #850 — whose acceptance criteria named the doomed file, its
 *    line count and its replacement coverage — was stopped on 2026-08-06 by a
 *    gate asking a question the ticket had already answered. What keeps that
 *    from being a way through: the source is owner-authored and fetched before
 *    any agent runs, the path must match exactly, the sentence must actually say
 *    the file goes, and a negated sentence authorises nothing. See
 *    `lib/checkwriter/proof-demand.ts`'s `preauthorizedTestDeletions`.
 *
 *    `null` back from `removedTestFiles` means git could not be asked. That is
 *    UNKNOWABLE, and it is NOT an all-clear — and no pre-authorisation changes
 *    that: "the ticket agreed to lose this file" does not answer "git could not
 *    be asked what was lost".
 *
 *    An earlier version of this comment argued the unknowable case could log
 *    and carry on, "because step 2 is independently conservative: a diff that
 *    deleted a test still CHANGED that file, so it is still in `changedFiles`
 *    and still raises a demand". That reasoning is FALSE for the case that
 *    matters. The browser instrument (`apps/*​/e2e/**`) is carved out of the
 *    demand entirely, so a deleted Playwright spec raises NO demand — step 2
 *    never looks at it, and the removal half was the only thing that did. So an
 *    unknowable removal set stops the ticket whenever the diff carries test
 *    material at all ({@link unprovableTestFiles}); a diff with no test file in
 *    it has no coverage to have lost and is unaffected, which is what keeps a
 *    git hiccup from becoming a random ticket-killer.
 *
 * 2. DEMAND VERSUS OFFER. `requiredProofForDiff` takes the strongest demand any
 *    one changed file raises; `proofOfferedByMarker` says what this outcome
 *    proves; `proofDemandSatisfied` is the one-way lattice between them —
 *    over-proving is always legal, under-proving never is.
 *
 * AND, BEFORE EITHER: a `changedFiles` of `null` means git could not say what
 * this diff changed at all. That used to arrive as an empty ARRAY, because the
 * caller measured with the fail-quiet `reviewDiffStats` — and an empty
 * changed-file list makes `requiredProofForDiff` answer `none`, a demand every
 * marker satisfies. One git hiccup at the ship funnel therefore waived this
 * entire gate. See `lib/review/diff-measurement.ts`'s `diffStatsBetween`.
 *
 * WHICH REFUSALS STOP AND WHICH ARE ONLY RECORDED: see
 * {@link ProofGateRefusal.neverWaived}. This function only labels them; the
 * call sites act on the label (stop on `neverWaived`, record the rest),
 * because only they can ship. There is no enforcement mode since spec #1334.
 *
 * `marker === undefined` means the caller ran no check-writer stage at all
 * (every pre-#911 call site, tests included) and the demand half is dormant for
 * it, exactly as the `checkWriterNoScreenApplies` boolean defaulting `false`
 * already made it. `runIssuePipeline` is the only production caller and always
 * passes a real marker.
 *
 * EXPORTED FOR ITS TESTS, and for nothing else. It is pure — every input is a
 * parameter and the only effect is `logError` — so
 * `main.proof-gate-older-test.test.mts` can put one diff in front of it and read
 * the answer, instead of driving a whole ship funnel to find out whether one
 * refusal fired. Nothing outside this file imports it in production.
 */
export function proofGateRefusal(opts: {
  readonly issueNumber: number;
  readonly marker: CheckWriterMarker | undefined;
  readonly changedFiles: readonly string[] | null;
  readonly guttedFiles: readonly string[] | null;
  /**
   * This ticket's own check directories: exactly the ones locked for it
   * (`ctx.protectedPathGlobs`, #1361), empty when it owns none. Required, so
   * no caller can forget it. Never every `issue-<N>` directory derived from
   * the number (issue #972 gap 5): an earlier run's check is not locked for
   * this ticket, so a re-dispatched ticket cannot silently edit it.
   */
  readonly ownCheckDirs: readonly string[];
  /**
   * The ticket's own body, read at claim time ({@link PipelineCtx.issueBody}).
   * A test file it named as an intended deletion is not a removal this gate has
   * to stop for — the person already agreed. `undefined` authorises nothing.
   */
  readonly issueBody?: string;
  /** `""` on the per-issue ship gate, `" (post-merge fixer)"` on that one. */
  readonly pathLabel: string;
  /**
   * THE BUILDER'S OWN WORDS, when the builder gave any (issue #1082 fault 3a,
   * built under issue #1128).
   *
   * WHY IT HAD TO BE THREADED. This gate stops a ticket for DELETING A TEST,
   * and it exists so a person can judge whether the deletion was right. The
   * report carried what the gate demanded and what the builder produced, and
   * had no field for the builder's argument at all — so the one stop whose
   * entire purpose is a human judgement handed that human only the
   * prosecution. The two older `builderAccount` sites both recorded the same
   * excuse — the implementer's raw output "is not threaded this far down the
   * call chain" — and this is that thread, run from the pipeline through
   * `shipAfterMigrations`, which the builder and the fixer both ship through.
   *
   * WHAT IT HOLDS: the implementer's `<rebuttal>` block — the one place the
   * builder states, in its own words, why it believes it is right — and nothing
   * else. It is NOT invented from the reviewer's verdict, and it is NOT the
   * implementer's whole transcript, which would bury the argument it exists to
   * surface. `undefined` when no rebuttal reached this call, and the message
   * then SAYS so rather than dropping the field: an absent line reads as
   * "nobody checked", a stated absence reads as "nothing was captured here".
   *
   * The absence it may claim is NARROW, and the wording has to stay inside it.
   * `builderAccount` is sourced only from the implementer's `<rebuttal>` block,
   * which per `implement-prompt.md` exists ONLY on a retry pass and ONLY in
   * place of code — so on the common `first-pass-only` ship the field is
   * structurally always empty. "The builder gave no reason" would therefore be
   * asserted every single time, and is frequently FALSE: the builder may well
   * have stated its reason in its transcript or its commit message, neither of
   * which this record captures. What the fallback can honestly say is that no
   * rebuttal was raised on this pass and that the builder's own words are not
   * in this record — never that no reason exists.
   */
  readonly builderAccount?: string;
  /**
   * SET WHEN THIS TICKET WAS BUILT WITHOUT A FIRST TEST (#1198 A), and the
   * ONE thing it may waive is the demand-versus-offer half below.
   *
   * ## Why the waiver has to exist
   *
   * The owner's rule is that the reviewer's pass is the only gate on these
   * tickets. Without this, a fall-through ticket would sail past the
   * check-writer stage, cost a full build and a full review, and then be
   * refused HERE — because the demand half asks what proof the marker offers,
   * and a ticket with no trustworthy check offers `none` while its diff
   * typically demands `browser`. That is the original stop moved three agents
   * later and paid for in full. Waiving it is not a loosening of the rule;
   * it is the rule the owner actually chose, enforced at the one place that
   * would otherwise contradict it.
   *
   * ## What it may NOT waive, and why each one holds
   *
   *   - REMOVED OR GUTTED TEST FILES. A different question entirely: not
   *     "was this diff proven" but "did this diff delete somebody else's
   *     proof". Nothing about a missing first test licenses deleting the
   *     117-file Playwright suite, and the removal gate is `neverWaived`.
   *   - AN UNKNOWABLE REMOVAL SET on a diff carrying test material. Same
   *     question, same answer — silence is not an all-clear.
   *   - AN UNMEASURABLE DIFF (`changedFiles === null`). "git could not say
   *     what this diff changed" is a broken worktree, not a proof judgement,
   *     and it is the one refusal that means the loop cannot see the change
   *     it is about to ship at all.
   *   - A MARKER THAT CANNOT SHIP. Unreachable by construction —
   *     `buildAnywayWithoutFirstTest` normalizes `ALREADY_BUILT` and
   *     `NEEDS_WORLD_DATA` to `NO_SCREEN_APPLIES` before the ticket ever
   *     leaves the check-writer stage — and left un-waived precisely so that
   *     if the normalization is ever broken, the ship funnel says so loudly
   *     instead of shipping on it.
   *   - ANOTHER TICKET'S LOCKED RED-FIRST CHECK. The only one of the five that
   *     lives BELOW the demand-versus-offer comparison rather than above it,
   *     so the waiver has to name it explicitly: `lockedCheckTouches` is
   *     computed first and the waiver fires only when it comes back empty.
   *     Editing the instrument every other gate here is measured by is not a
   *     proof judgement about this diff, and a ticket that could not produce
   *     its own first test has less licence to rewrite somebody else's, not
   *     more. Deleting one is caught upstream by `removedTestFiles`;
   *     MODIFYING one is caught nowhere else — `DEFAULT_PROTECTED_PATH_GLOBS`
   *     does not cover the check directories.
   */
  readonly firstTestFellThrough?: boolean;
  /**
   * EXACTLY the older-test paths the ship gate's own older-test check
   * (`verifyOlderTestEdits`, spec #1334 SH) allowed on this diff — and
   * nothing else.
   *
   * The locked-check refusal below is the one rule standing between a run and
   * another ticket's proof, so the only thing that may open it is the run's
   * OWN verification, carried in code from the gate that ran it. It is NEVER
   * parsed out of agent output, never read off a commit message, and never
   * widened to a directory: `lockedCheckTouches` matches these entries as
   * exact paths, drops any that is not itself a locked check path, and drops
   * any containing `..` — so a bad entry authorises nothing rather than
   * everything.
   *
   * Empty on every ordinary ticket, which is the overwhelming majority.
   */
  readonly authorizedOlderTestPaths?: readonly string[];
  readonly logError: (msg: string) => void;
}): ProofGateRefusal | undefined {
  // One wording, both removal branches. The fallback is a FINDING about this
  // record, not a blank and not a claim about the builder — see the field's
  // doc above for why it may not say "he gave no reason".
  const builderAccount =
    opts.builderAccount !== undefined && opts.builderAccount.trim().length > 0
      ? opts.builderAccount.trim()
      : "(the builder raised no rebuttal on this pass; its own words are not captured in this record)";
  const removed = removedTestFiles(
    opts.changedFiles,
    opts.guttedFiles,
    opts.issueBody,
  );
  if (removed === null) {
    // UNKNOWABLE. It stops the ticket only when there is coverage the silence
    // could be hiding the loss of — see the module doc above for why "carry on,
    // the demand gate will catch it" was wrong, and `unprovableTestFiles` for
    // why the cost is bounded to diffs that carry test material.
    const atRisk = unprovableTestFiles(opts.changedFiles);
    opts.logError(
      `[issue=${opts.issueNumber}] proof-gate${opts.pathLabel}: could not ask ` +
        `git which files this diff DELETED or emptied. This is "unknowable", ` +
        `not "nothing was removed"` +
        (atRisk.length > 0
          ? `, and the diff carries ${atRisk.length} test file(s), so it stops.`
          : `; the diff carries no test file, so there is no coverage the ` +
            `silence could be hiding the loss of, and it carries on.`),
    );
    if (atRisk.length > 0) {
      return {
        neverWaived: true,
        touchedPaths: atRisk,
        disagreement: {
          checkDemanded:
            "Proof that this diff did not remove test coverage. An " +
            "unknowable removal set is never waived, in either enforcement " +
            "mode (see lib/checkwriter/proof-demand.ts's unprovableTestFiles).",
          builderProduced:
            `git could not be asked what this diff removed, and the diff ` +
            `touches ${atRisk.length} test file(s): ${atRisk.join(", ")}.`,
          builderAccount,
        },
        message:
          `check-writer-test-coverage-unknowable${opts.pathLabel}: issue ` +
          `#${opts.issueNumber} — git could not be asked which files this ` +
          `diff DELETED or emptied, and the diff touches ${atRisk.length} ` +
          `test file(s) under apps/** or packages/**: ${atRisk.join(", ")}. ` +
          `Silence is not an all-clear: a deleted Playwright spec raises no ` +
          `proof demand at all (the browser instrument is carved out of the ` +
          `router) and "passes" the test gate by being absent, so the ` +
          `removal check was the only thing looking at it. This is never ` +
          `waived. Quarantining for human triage.`,
      };
    }
  } else if (removed.length > 0) {
    return {
      neverWaived: true,
      touchedPaths: removed,
      disagreement: {
        checkDemanded:
          "Test coverage under apps/** or packages/** must not be removed " +
          "without a person agreeing — no check-writer outcome waives this " +
          "(see lib/checkwriter/proof-demand.ts's removedTestFiles).",
        builderProduced:
          `The finished diff DELETED or emptied ${removed.length} test ` +
          `file(s): ${removed.join(", ")}.`,
        // The whole reason this stop exists is that a person has to judge the
        // deletion, and a judgement wants both sides.
        builderAccount,
      },
      message:
        `check-writer-test-coverage-removed${opts.pathLabel}: issue ` +
        `#${opts.issueNumber} — the finished diff DELETES or empties ` +
        `${removed.length} test file(s) under apps/** or packages/**: ` +
        `${removed.join(", ")}. This is never waived — not by any ` +
        `check-writer outcome — and ` +
        `passing this ticket's own check proves nothing about the coverage ` +
        `the same diff removed: the protected-path lock covers only this ` +
        `issue's check directory, the ship-time run executes only the ONE ` +
        `check file, and the test-verification gate runs vitest, whose ` +
        `include is src/** — so a deleted Playwright spec "passes" by being ` +
        `absent. Removing a test may well be right for this ticket; it needs ` +
        `a person to agree. To agree IN ADVANCE, put a line naming the exact ` +
        `repo-relative path in the ISSUE BODY before the run — ` +
        `"Deletes-test: <path>" — which is read when the issue is claimed, ` +
        `so nothing the builder writes can forge it. Quarantining for human ` +
        `triage.`,
    };
  }

  if (opts.marker === undefined) return undefined;

  // GIT COULD NOT SAY WHAT THIS DIFF CHANGED. Everything below reasons about
  // `changedFiles`, and an empty list is indistinguishable from "no demand" —
  // which every marker satisfies. So the gate refuses rather than answering
  // from an answer nobody has. See the module doc, and `diffStatsBetween`.
  if (opts.changedFiles === null) {
    return {
      neverWaived: true,
      touchedPaths: [],
      disagreement: {
        checkDemanded:
          "A measurable diff. The proof this ticket owes is computed from " +
          "the files it changed, so an unmeasurable diff cannot be cleared " +
          "by any check-writer outcome.",
        builderProduced:
          "git could not be asked what this diff changed, so the file list " +
          "the gate reasons about does not exist.",
      },
      message:
        `check-writer-proof-demand-unsatisfied${opts.pathLabel}: issue ` +
        `#${opts.issueNumber} — the loop could not measure this diff. ` +
        `\`git diff\` failed, so there is no changed-file list to compute a ` +
        `proof demand from. An empty list would read as "this diff owes ` +
        `nothing", which every check-writer outcome satisfies — so a single ` +
        `git hiccup would waive the whole gate. Unknowable is not an ` +
        `all-clear. Quarantining for human triage; this one usually means ` +
        `the repository or the worktree is in a bad state, not that the ` +
        `ticket is wrong.`,
    };
  }

  const offered = proofOfferedByMarker(opts.marker);
  const demand = requiredProofForDiff(opts.changedFiles);
  if (offered === undefined) {
    // NEITHER `ALREADY_BUILT` NOR `NEEDS_WORLD_DATA` CAN REACH A SHIP PATH,
    // and since #1198 A they get there by two different routes:
    //
    //   - `ALREADY_BUILT` still STOPS inside `runCheckWriterStage`
    //     (`disposeAlreadyBuilt`), so the pipeline never dispatches a builder
    //     for it.
    //   - `NEEDS_WORLD_DATA` no longer stops — it falls through and the
    //     builder runs — but `buildAnywayWithoutFirstTest` normalizes the
    //     marker to `NO_SCREEN_APPLIES` before the ticket travels, precisely
    //     so an unprovable marker cannot arrive here.
    //
    // So arriving under either is a PROGRAMMING ERROR. Answering "nothing was
    // owed" would let exactly that bug ship the diff. It stops, loudly, and
    // says what it is.
    opts.logError(
      `[issue=${opts.issueNumber}] proof-gate${opts.pathLabel}: reached the ` +
        `ship funnel carrying marker ${opts.marker}, which can never reach ` +
        `here — it either stops the ticket in the check-writer stage or is ` +
        `normalized away before the builder runs. This is a loop bug, not a ` +
        `ticket problem — but the diff is real and unproven, so it stops.`,
    );
    return {
      // A loop bug over a real, unproven diff is not a screen-check judgement,
      // so the mode has no business waiving it.
      neverWaived: true,
      touchedPaths: demand.productTouches,
      disagreement: {
        checkDemanded: `A proof of strength '${demand.demand}'.`,
        builderProduced:
          `Marker ${opts.marker}, which offers no proof at all because it is ` +
          `not supposed to reach a ship path.`,
      },
      message:
        `check-writer-marker-cannot-ship${opts.pathLabel}: issue ` +
        `#${opts.issueNumber} — this ticket reached the ship funnel with the ` +
        `check-writer outcome ${opts.marker}, which offers no proof at all ` +
        `and is never supposed to travel this far: it either stops the ` +
        `ticket before any builder runs, or is replaced by "no check ` +
        `applies" on the way past. Nothing about this diff has been proven, ` +
        `and the loop cannot say what it should have been proven against. ` +
        `Quarantining for human triage; this one is worth reading the run ` +
        `log for, because it means a stop path did not stop or a ` +
        `normalization did not normalize.`,
    };
  }
  // ANOTHER TICKET'S LOCKED RED-FIRST CHECK, computed BEFORE the
  // demand-versus-offer comparison and before any waiver can return. Carried
  // across from `no-screen-guard.ts` (issue #969): if the evidence includes a
  // check some other issue's must-fail-first proof is locked to, letting this
  // diff past would let a ticket edit the instrument every other gate here is
  // measured by. This ticket's own check directories are excluded — writing
  // one is the job — and so are the exact older-test paths the ship gate's
  // older-test check (`verifyOlderTestEdits`) allowed on this diff.
  //
  // IT SITS ABOVE THE DEMAND COMPARISON, and that is a fix, not a tidy-up
  // (#1271). It used to sit BELOW `proofDemandSatisfied`'s early return, so a
  // diff that touched another ticket's locked check and ALSO satisfied its own
  // proof demand — a browser check written for a diff that edits a sibling's
  // unit check, say — returned `undefined` and shipped with the edit
  // unexamined. Passing your own exam says nothing about whose answer key you
  // rewrote on the way.
  const lockedChecks = lockedCheckTouches(
    opts.changedFiles,
    opts.ownCheckDirs,
    opts.authorizedOlderTestPaths,
  );
  if (lockedChecks.length > 0) {
    return {
      // Never waived, on the fall-through road too: editing another ticket's proof is not a judgement about screens.
      neverWaived: true,
      touchedPaths: lockedChecks,
      disagreement: {
        checkDemanded:
          "Another ticket's locked red-first check may be edited ONLY when the " +
          "run's older-test check allowed that exact file. No check-writer " +
          "outcome waives this " +
          "(see lib/checkwriter/proof-demand.ts's lockedCheckTouches).",
        builderProduced:
          `The finished diff changed ${lockedChecks.length} file(s) that ` +
          `belong to another issue's locked check: ${lockedChecks.join(", ")}.`,
      },
      message:
        `check-writer-locked-check-touched${opts.pathLabel}: issue ` +
        `#${opts.issueNumber} — the finished diff edits ${lockedChecks.length} ` +
        `file(s) that are another issue's locked red-first check: ` +
        `${lockedChecks.join(", ")}. Those files are the instrument every ` +
        `other gate here is measured by, and this ticket's own check ` +
        `directory is already excluded, so this is a diff reaching into ` +
        `somebody else's proof, and no authorisation to edit that exact ` +
        `file reached this gate. Passing this ticket's own proof demand does not ` +
        `licence it either: what the diff owed and whose answer key it ` +
        `rewrote are two different questions. Quarantining for human triage.`,
    };
  }

  if (proofDemandSatisfied(offered, demand.demand)) return undefined;

  // #1198 A: the demand-versus-offer half, and ONLY this half, is waived for
  // a ticket the loop built without a first test. Every refusal above this
  // line has already been decided, so none of them can be reached from here
  // — see `firstTestFellThrough`'s own doc comment for why each one stays.
  //
  // `lockedChecks.length === 0` is part of the condition, not a detail: a
  // locked-check touch is a `neverWaived` refusal, and a waiver that returned
  // before computing it would hand a fall-through ticket the one hole no mode,
  // no marker and no enforcement setting is allowed to open. Deletion of
  // another ticket's check is already caught upstream by `removedTestFiles`;
  // MODIFYING one is caught only here.
  //
  // Since #1271 the locked-check block above RETURNS on a hit, so this
  // conjunct can no longer be false — and it stays written out anyway. It
  // says, at the one line where a reader is deciding what a fall-through
  // ticket may skip, that another ticket's check is not on the list. Deleting
  // it would make the waiver's correctness depend entirely on a block fifty
  // lines up staying where it is.
  if (opts.firstTestFellThrough === true && lockedChecks.length === 0) {
    opts.logError(
      `[issue=${opts.issueNumber}] proof-gate${opts.pathLabel}: this diff ` +
        `owes a '${demand.demand}' proof and the check-writer stage could ` +
        `not produce one (#1198). NOT refusing — the reviewer's pass is this ` +
        `ticket's only gate by design, and it passed. The merge carries ` +
        `\`shipped-without-first-test\`.`,
    );
    return undefined;
  }

  // Name the exact evidence, and only the evidence: the files that forced a
  // BROWSER demand when that is what was unmet, otherwise every file that owed
  // any proof at all. A stop message listing the whole diff is one nobody acts
  // on.
  const evidence =
    demand.demand === "browser"
      ? demand.screenOrFlowTouches
      : demand.productTouches;
  // THE ONE WAIVED REFUSAL — "this diff owed a proof it did not offer" IS the
  // screen-check judgement, so it is recorded and the ticket ships (spec
  // #1334). The exception is `lockedChecks`
  // above, which stops the ticket always, on the fall-through road
  // too — and since #1271 it stops it there, at its own refusal, so this line
  // can only ever read `false`. Kept as the expression rather than the
  // constant so that this refusal keeps SAYING which of the two questions it
  // answers, instead of asserting a `false` whose reason lives elsewhere.
  return {
    neverWaived: lockedChecks.length > 0,
    touchedPaths: evidence,
    disagreement: {
      // The two sides, and which is which: the DEMAND is what the finished
      // diff owes and why, the PRODUCED side is the files the builder actually
      // wrote plus the proof this ticket was carrying for them. The file list
      // lives on the produced side because that is what the builder did — it
      // is also the evidence behind the demand, but an owner opening this
      // block is looking for "what did the builder touch".
      checkDemanded:
        `A '${demand.demand}' proof. ` +
        (demand.demand === "browser"
          ? `Some of the changed files can put different pixels in front of ` +
            `a person (anything under apps/**, anything under packages/ui/, ` +
            `any .tsx/.jsx/.css/.scss in a package), and only a browser check ` +
            `proves what they put there.`
          : `Some of the changed files land inside apps/** or packages/**, ` +
            `so they owe a red-first proof at the seam they changed.`),
      builderProduced:
        `The finished diff changed ${evidence.length} file(s) that forced ` +
        `that demand: ${evidence.join(", ")}. The check-writer said ` +
        `${opts.marker}, which offers a '${offered}' proof. A photograph ` +
        `satisfies a unit demand; a unit test never satisfies a photograph ` +
        `demand; neither is satisfied by nothing.`,
    },
    message:
      `check-writer-proof-demand-unsatisfied${opts.pathLabel}: issue ` +
      `#${opts.issueNumber} — the check-writer said ${opts.marker}, which ` +
      `offers a '${offered}' proof, but the finished diff demands ` +
      `'${demand.demand}'. ${evidence.length} file(s) forced that demand: ` +
      `${evidence.join(", ")}. ` +
      (demand.demand === "browser"
        ? `A unit test cannot stand in for a photograph — anything under ` +
          `apps/**, anything under packages/ui/, and any .tsx/.jsx/.css/.scss ` +
          `in a package can put different pixels in front of a person, and ` +
          `only a browser check proves what they put there. `
        : `A bare "no screen applies" cannot stand in for a red-first proof — ` +
          `a change inside apps/** or packages/** can change a number someone ` +
          `sees even when nothing renders differently. `) +
      `Which proof a diff owes is computed from the diff itself, never from ` +
      `the claim the check-writer made before a line of it existed (see ` +
      `lib/checkwriter/proof-demand.ts). Quarantining for human triage.`,
  };
}

/**
 * #972 gap 6 — route the POST-MERGE FIXER's own committed diff through the SAME
 * never-waived removed-coverage gate the per-issue ship path enforces.
 *
 * The post-merge fixer (`post-merge-fix-prompt.md`) writes and commits code
 * DIRECTLY on `integration-candidate`, AFTER every per-issue proof gate has
 * already run and BEFORE the fast-forward that ships the round. Nothing measured
 * its diff, so a fixer that deleted a Playwright spec shipped green by being
 * absent (vitest's include is `src/**`) — the exact failure the per-issue gate
 * exists to stop, on the one writer that ran past it. The threat model (owner
 * ruling, 2026-08-15) is CARELESSNESS: a fixer whose edit lands unmeasured, not
 * one hunting a loophole.
 *
 * It reuses {@link proofGateRefusal} with NO check-writer marker, so ONLY the
 * removed-test-coverage half fires — the fixer spans the whole rollup and has no
 * marker, and the demand-versus-offer half is exactly the half a marker feeds.
 * Every refusal that half can return is `neverWaived`, so a hit here always
 * stops the promotion.
 *
 * FAIL-CLOSED, FAIL-QUIET, and NEVER THROWS.
 *   - `fromSha === toSha` (both resolved): the fixer moved nothing — a PROVABLE
 *     empty diff, so it passes.
 *   - the tip MOVED but git could not be asked what changed (a ref would not
 *     resolve, or `git diff` failed): unknowable over a real change, which is
 *     never an all-clear — it refuses. An HONEST empty diff answers
 *     `{0, []}` / `[]`, not `null`, so a no-op fixer never lands here.
 *   - otherwise the measured changed/gutted sets go to `proofGateRefusal`, whose
 *     `removedTestFiles` intersection decides.
 *
 * No `issueBody` is threaded: the fixer's work spans every issue in the round,
 * so no single ticket can pre-authorise a deletion — the gate authorises none.
 */
export function postMergeFixerProofRefusal(opts: {
  readonly repoRoot: string;
  readonly fromSha: string;
  readonly toSha: string;
  readonly logError: (msg: string) => void;
}): ProofGateRefusal | undefined {
  const { repoRoot, fromSha, toSha, logError } = opts;
  const bothResolved = fromSha !== "" && toSha !== "";
  // The fixer changed nothing — provable no-op, clean pass. (Handled up front so
  // the `null`-means-unknowable check below can be unconditional.)
  if (bothResolved && fromSha === toSha) return undefined;
  const diff = bothResolved
    ? diffStatsBetween(repoRoot, fromSha, toSha)
    : null;
  const gutted = bothResolved
    ? guttedFilesBetween(repoRoot, fromSha, toSha)
    : null;
  // The tip demonstrably moved (or a ref would not resolve while we were about
  // to ship), yet git could not report the change. Silence is not an all-clear:
  // the removed-coverage gate below only fails closed when it can SEE test
  // material in the changed set, and here it cannot see the changed set at all.
  // So state the stop directly rather than fall through to a false pass.
  if (diff === null || gutted === null) {
    logError(
      `proof-gate (post-merge fixer): the staging tip moved (${
        fromSha.slice(0, 8) || "(unresolved)"
      } -> ${
        toSha.slice(0, 8) || "(unresolved)"
      }) but git could not be asked what the fixer changed. This is ` +
        `"unknowable", not "nothing was removed" — refusing to promote.`,
    );
    return {
      neverWaived: true,
      touchedPaths: [],
      disagreement: {
        checkDemanded:
          "A measurable diff. The post-merge fixer wrote code on " +
          "integration-candidate after every per-issue proof gate ran; its " +
          "diff must be measurable so it cannot delete test coverage " +
          "unmeasured. An unknowable diff is never an all-clear.",
        builderProduced:
          "git could not be asked what the fixer changed, so there is no " +
          "changed-file list to check for removed coverage.",
      },
      message:
        "post-merge-fixer-diff-unmeasurable: the fixer's commits on " +
        "integration-candidate could not be measured (git diff failed or a " +
        "ref would not resolve), so the loop cannot prove they did not delete " +
        "a test. Silence is not an all-clear — this one usually means the " +
        "staging worktree is in a bad state, not that the fix is wrong. " +
        "Quarantining the round for human triage.",
    };
  }
  return proofGateRefusal({
    // The fixer has no single issue; the pathLabel below is what names it in the
    // record. `0` is a sentinel, not a real ticket.
    issueNumber: 0,
    // No marker: measure removed coverage only, not demand-versus-offer.
    marker: undefined,
    changedFiles: diff.changedFiles,
    guttedFiles: gutted,
    // No ticket, so no check directory is this fixer's own: every locked
    // check it touches is refused.
    ownCheckDirs: [],
    pathLabel: " (post-merge fixer)",
    logError,
  });
}

/**
 * Put a WAIVED proof-gate refusal on the record: telemetry, a loud log line,
 * and a watch section on the issue body carrying BOTH sides plus the label
 * this refusal used to stop the ticket with (issue #969; spec #1334).
 *
 * Never a silent swallow — a waived refusal nobody wrote down is
 * indistinguishable from a gate that never fired.
 *
 * `verdict: "graded-mismatch"` although no harness ran: this is the "the
 * builder and the check disagree" verdict, it is the one the label
 * `stopped:check-disagreement` maps from, and inventing a seventh verdict for
 * this shape would mean teaching every downstream reader about it.
 *
 * ONE function, so no ship path can drift into recording less than another —
 * which is exactly what happened when there were two (2026-08-04 review,
 * blocker 2b: the old rescue road's watch section rendered with no evidence
 * block at all).
 */
async function recordWaivedProofRefusal(
  ctx: PipelineCtx,
  refusal: ProofGateRefusal,
): Promise<void> {
  ctx.telemetry?.noteScreenCheck({
    verdict: "graded-mismatch",
    whenIso: new Date().toISOString(),
    rerun: false,
    pictureStored: false,
  });
  ctx.deps.logError(
    `[issue=${ctx.issueNumber}] proof-gate: recorded, not a stop — the ` +
      `finished diff owed a proof it did not offer and this ticket ships. ` +
      `${refusal.message}`,
  );
  try {
    await ctx.deps.reportScreenCheckWatch?.(ctx.issueNumber, {
      verdict: "graded-mismatch",
      detail: refusal.message,
      disagreement: refusal.disagreement,
      wouldHaveStoppedAs: "stopped:check-disagreement",
    });
  } catch (e) {
    ctx.deps.logError(
      `reportScreenCheckWatch failed for issue #${ctx.issueNumber}: ` +
        `${(e as Error).message}`,
    );
  }
}

/**
 * Apply migrations from the final accepted state and mark the issue done.
 * Migrations are deferred until after the final ALL_CLEAR so that only the
 * accepted SQL hits the dev DB — intermediate state from a failed first
 * attempt never leaks. Returns the IssueOutcome the caller should bubble up.
 */
/**
 * Issue F: which prompt-leg path an issue traversed to its terminal outcome.
 * Partitioned by the reviewer-pass that decided the outcome (the three exit
 * boundaries the loop has):
 *   - `first-pass-only`  — shipped on reviewer attempt 1's ALL_CLEAR, no retry
 *   - `critique-retry`   — decided by reviewer attempt 2 (ship OR escalated-
 *                          retry quarantine), i.e. the HAS_BLOCKERS → implementer
 *                          attempt 2 → reviewer attempt 2 leg
 *   - `implementer-retry` — decided by the round-3 grant (implementer attempt 3
 *                          → reviewer attempt 3, ship OR quarantine)
 *
 * Note (intentional): every reviewer-attempt-2 exit also ran implementer
 * attempt 2, so "critique-retry" and "implementer-retry" overlap on the fact
 * that an implementer retry happened. We partition by the deciding reviewer
 * pass (the exit boundary) rather than by "did an implementer retry run", so
 * each terminal outcome carries exactly one path token.
 *
 * `critique-retry` is a historical name for the reviewer's SECOND attempt. It
 * has nothing to do with the design-critique stage spec #1334 deleted, and
 * telemetry rows on disk carry it, so it is not renamed.
 */
type PromptLegPath =
  | "first-pass-only"
  | "critique-retry"
  | "implementer-retry"
  /** Shipped by the fixer (spec #1334, SG), on any of its rounds. */
  | "fixer";

/**
 * Every path with UNCOMMITTED state in `worktreePath` — modified, staged,
 * deleted, renamed, or untracked — or `undefined` if git could not be asked.
 *
 * Feeds {@link enforceProtectedPaths}'s worktree half (2026-08-04 review, F1).
 * `--untracked-files=all` is deliberate on two counts: without it git collapses
 * a wholly-new directory to a single `?? dir/` entry, which no file glob would
 * match and no restore could act on; and an ADDED file inside a locked check
 * directory has to count as tampering, because Playwright globs that directory
 * and grades whatever it finds there — dropping in a second, always-passing
 * spec is the same hole as rewriting the first one. `restoreProtectedPaths`
 * already handles that case correctly (absent at base → the file is deleted).
 *
 * `-z` rather than the default output because porcelain v1 QUOTES any path
 * containing a space, a quote or a non-ASCII byte, and a quoted path would
 * silently fail to match its own glob. With `-z` each record is
 * `XY <path>\0`, and a rename/copy record is followed by one extra `\0`-
 * terminated field holding the ORIGINAL path — both sides are returned, since
 * renaming a locked file both removes it from where the harness expects it and
 * creates something new.
 *
 * Uses `execFileSync` rather than {@link runGit} for one specific reason:
 * `runGit` TRIMS its stdout, and an unstaged-only modification's status code
 * is `" M"` — a LEADING SPACE. Trimming shifts that first record by one byte,
 * so `record.slice(3)` silently returns a path with its first character
 * chopped off, which then matches no glob at all. A lock that fails open on
 * the single most common form of the thing it is watching for is worse than
 * no lock, so this reads the bytes git actually wrote.
 */
function dirtyWorktreePaths(worktreePath: string): string[] | undefined {
  let raw: string;
  try {
    raw = execFileSync(
      "git",
      ["status", "--porcelain", "-z", "--untracked-files=all"],
      { cwd: worktreePath, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    );
  } catch {
    return undefined;
  }
  const fields = raw.split("\0");
  const paths: string[] = [];
  for (let i = 0; i < fields.length; i += 1) {
    const record = fields[i];
    // "XY path" — anything shorter is the empty trailing field, not a record.
    if (record === undefined || record.length < 4) continue;
    paths.push(record.slice(3));
    if (/[RC]/.test(record.slice(0, 2))) {
      const originalPath = fields[i + 1];
      i += 1;
      if (originalPath !== undefined && originalPath.length > 0) {
        paths.push(originalPath);
      }
    }
  }
  return paths;
}

/**
 * Is `violationPath` exactly the bytes the run itself last ACCEPTED for it —
 * `ctx.frozenCheck.current`, which a PROVED first-test rewrite (spec #1334,
 * `proveFirstTestRewrite`) updates to the rewrite's freeze?
 *
 * ## Why this exists
 *
 * A proved rewrite changes the check directory on purpose, between what the
 * builder was handed (`preSha`) and what ships. Compared only against
 * `preSha`, the rewrite itself would read as tampering. So tampering means
 * "the check differs from the ACCEPTED bytes", and `ctx.frozenCheck.current`
 * IS the accepted bytes at the moment this runs — the original acceptance when
 * no rewrite has happened, the rewrite's own freeze when one has.
 *
 * ## Why this cannot mask real tampering
 *
 * A path that differs from the current frozen bytes still fails this match
 * (the `onDisk`/`acceptedBytes` comparison below), so it reaches the ordinary
 * tamper path further down — counted, and restored from the freeze. Only a
 * byte-for-byte match with what the run's own proof certified is treated as
 * authorized.
 *
 * ## Why the live worktree, not another `git show`
 *
 * `postSha`'s tree is what the caller measured `shipDiff`/`dirtyPaths`
 * against, but the UNCOMMITTED half of this lock (see the comment on
 * `dirtyWorktreePaths` above) grades bytes that were never committed at all —
 * a `git show postSha:<path>` would come back empty for those. Reading the
 * live worktree instead covers both halves with one read, and by the time
 * this runs the worktree IS the state about to ship (`restoreFrozenCheck`
 * already wrote the repair's own bytes back onto disk as its own last step).
 *
 * ## Why a COMMITTED violation also needs the `postSha` bytes checked
 *
 * The disk check alone has a hole: a violation detected from the COMMITTED
 * diff (`preSha` → `postSha` content actually changed) ships whatever is at
 * `postSha`, not whatever happens to be on disk right now. A builder can
 * commit tampered check bytes and then revert the file on disk back to the
 * frozen bytes — disk matches, the exemption would fire, no restore runs, no
 * tamper gets counted, and the TAMPERED COMMIT still merges. So for a path
 * that came from the committed-diff detector, `fromCommittedDiff` is `true`
 * and this also requires `git show postSha:<path>` to equal the frozen
 * bytes — either check failing means the violation stands. A path that is
 * ONLY dirty/uncommitted (`fromCommittedDiff` false) has no meaningful
 * `postSha` blob to check against (see the paragraph above), so it keeps the
 * disk-only check it always had.
 */
function violationMatchesAcceptedCheck(
  worktreePath: string,
  frozen: FrozenCheck | undefined,
  violationPath: string,
  postSha: string,
  fromCommittedDiff: boolean,
): boolean {
  if (frozen === undefined) return false;
  const checkDir = frozen.location.checkDir;
  if (violationPath !== checkDir && !violationPath.startsWith(`${checkDir}/`)) {
    // Outside the frozen check's own directory entirely — e.g. one of the
    // frozen tsconfig seeds. A repair never rewrites those, so there is
    // nothing here for them to legitimately match.
    return false;
  }
  const relPath =
    violationPath === checkDir ? "" : violationPath.slice(checkDir.length + 1);
  const acceptedBytes = frozen.checkDir.bytesByRelPath.get(relPath);
  // Not a path the accepted freeze recorded at all — e.g. a file smuggled in
  // beside the repair rather than part of it. Fails safe: still a violation.
  if (acceptedBytes === undefined) return false;
  let onDisk: Buffer | undefined;
  try {
    const abs = path.join(worktreePath, violationPath);
    onDisk = existsSync(abs) ? readFileSync(abs) : undefined;
  } catch {
    return false; // Unreadable is not "matches" — fail safe, still a violation.
  }
  if (onDisk === undefined || !acceptedBytes.equals(onDisk)) return false;
  if (!fromCommittedDiff) return true;
  // Also ships from a real commit — the disk match alone is not enough (see
  // doc comment above). `readBlobAt` fails safe: `undefined` on any git
  // failure or a missing blob, which is treated as "does not match" below.
  const shipped = readBlobAt(worktreePath, postSha, violationPath);
  return shipped !== undefined && acceptedBytes.equals(shipped);
}

/**
 * The protected-path lock (issue #909 / Piece C of
 * `docs/specs/2026-08-04-screen-check-design-lock.md`) — the ship-funnel
 * enforcement point for {@link resolveProtectedPathGlobs} /
 * {@link detectProtectedPathViolations}.
 *
 * WHAT IT DOES ON A CLEAN DIFF: nothing. Returns `postSha` unchanged, no git
 * call beyond the two already-done diff/glob computations — the common case
 * costs nothing extra.
 *
 * WHAT IT DOES ON A TAMPERED DIFF, following Piece C exactly:
 *   1. Always records the tamper — `ctx.telemetry?.noteChecksTampered()` is
 *      called BEFORE any other decision, so the count exists even if
 *      everything after it throws. "Always recorded in words, never silent."
 *   2. On the SECOND tamper this issue has recorded (this run — see
 *      `noteChecksTampered`'s own doc comment on how "twice, ever" survives
 *      a redispatch), the ticket stops HERE, without attempting a restore —
 *      "twice on one ticket and the ticket stops regardless of the result".
 *   3. On the first tamper, the protected path(s) are restored byte-for-byte
 *      — the first test's own files from the run's FROZEN copy of it (the
 *      accepted test, or its proved rewrite — spec #1334), everything else
 *      from `preSha` — and committed on top of `postSha` (message carries the
 *      original commit's message forward so its lint/test certification
 *      tokens survive the restore). The NEW commit sha is returned; every
 *      gate that runs after this call (`checkLintCert`, `checkTestCert`,
 *      `verifyTestRun`, the migration/journal gates) then grades THAT commit
 *      — which is Piece C's "restore the original file and re-run it against
 *      the code the builder actually wrote" using the loop's existing
 *      verification gates as the "it", since issue #911's acceptance-check
 *      file does not exist yet to re-run instead. If those downstream gates
 *      pass, the ticket ships on the restored code; if they throw (as they
 *      already do today on a real failure), this issue quarantines exactly
 *      the way any other ship-time gate failure does — the closest available
 *      approximation of "hand off to the existing retry ladder" without
 *      Piece H's five-label ladder rebuild, which is explicitly later,
 *      separate build work (see the spec's Build-order table, step 6).
 *
 * Throws (→ quarantine, same as every other gate in `shipAfterMigrations`)
 * when a restore cannot be safely attempted or verified — there is no path in
 * which a detected violation is allowed to ship un-restored.
 */
export async function enforceProtectedPaths(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  preSha: string,
  postSha: string,
  shipDiff: DiffStats,
): Promise<ProtectedPathsOutcome> {
  const protectedGlobs = resolveProtectedPathGlobs(ctx.protectedPathGlobs);
  // `shipDiff` is measured from `shipDiffBase` — deliberately the issue
  // branch's FORK POINT, not `preSha` (see that function's own doc comment
  // on why: it must never narrow the telemetry record across a checkpoint
  // resume). The check-writer stage (issue #911) advances `preSha` PAST
  // its own hand-off commit, so `shipDiff.changedFiles` ALWAYS includes
  // that commit's files whenever a real `CHECKS_WRITTEN` check exists —
  // they live inside the now-protected per-issue check directory. Without
  // the second filter below, every such ticket reads as tampered on its
  // own check-writer's commit, on every dispatch. Filtering by whether the
  // path's CONTENT actually differs between `preSha` (what the builder was
  // handed) and `postSha` (what shipped) keeps `shipDiff`'s wider
  // fork-point reach for genuine tamper detection across a resume, while
  // excluding a file the check-writer itself added earlier in this same
  // dispatch that the builder never subsequently touched. See
  // `pathContentChangedBetween`'s own doc comment (issue #914 finding).
  const worktreePath = sandbox.worktreePath;
  // A ticket's first test — the check-writer's, or a resumed ticket's saved
  // one (#1361) — is committed after the fork point, so a builder that
  // COMMITS its deletion leaves it absent at both ends of `shipDiff`, where
  // the lock never sees it. So the lock also reads what changed since
  // `preSha`, the builder's hand-off. `--no-renames` is required: with rename
  // detection a committed `git mv` lists only the NEW path, so the moved
  // first test's old path escaped the lock. The wider read can also re-apply
  // a saved-work edit to a default-protected file if the builder reverts it;
  // that is accepted.
  const sincePreSha =
    worktreePath !== undefined && preSha !== ""
      ? runGit(worktreePath, "diff", "--name-only", "-z", "--no-renames", preSha, postSha)
      : undefined;
  if (sincePreSha !== undefined && !sincePreSha.ok) {
    // Reported, never silent — the same outcome as the unreadable worktree
    // scan below: an extra layer on top of the fork-point diff, so a git
    // hiccup returns the lock to that diff's strength, never below it.
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] protected-paths-since-handoff-unreadable: ` +
        `could not diff ${preSha}..${postSha} in ${worktreePath}, so a ` +
        `COMMITTED deletion or move of a locked first test could not be ruled ` +
        `out. The fork-point half of the lock still ran.`,
    );
  }
  const candidateViolations = detectProtectedPathViolations(
    [
      ...new Set([
        ...shipDiff.changedFiles,
        ...(sincePreSha?.ok === true
          ? sincePreSha.stdout.split("\0").filter((p) => p.length > 0)
          : []),
      ]),
    ],
    protectedGlobs,
  );
  const violations =
    worktreePath === undefined || preSha === ""
      ? [...candidateViolations]
      : candidateViolations.filter((p) =>
          pathContentChangedBetween(worktreePath, preSha, postSha, p),
        );
  // Tracks which violations were detected from a REAL COMMIT (the diff
  // between `preSha` and `postSha`, or the e2e-script/tsconfig content-level
  // companions below, which compare the same two commits) rather than only
  // from the uncommitted worktree scan further down. Read by
  // `violationMatchesAcceptedCheck` — see its doc comment on why a
  // committed violation needs its `postSha` bytes checked too, not just
  // disk (issue #1177 exemption hardening).
  const committedDiffViolationPaths = new Set(violations);
  // UNCOMMITTED tampering (2026-08-04 review, F1). Everything above is a
  // COMMIT-TO-COMMIT measurement, but the browser gate below grades the LIVE
  // WORKTREE: `runScreenCheckHarness` is handed `worktreePath`/`exec` and
  // `runOnce` (lib/harness/run-harness-check.ts) simply execs the check
  // command there — it never checks out `postSha` and never demands a clean
  // tree. So the bytes Playwright loads are the bytes ON DISK. A builder that
  // edits a protected path and never runs `git add` therefore changes what
  // gets graded while leaving `shipDiff.changedFiles` — and the shipped
  // commit — perfectly clean. `main.mts` has no `git add -A` sweep that would
  // fold such an edit into a commit (the only `ensureDirCommitted` call site
  // is the check-writer hand-off, a different moment), so nothing else closes
  // this.
  //
  // Deliberately matched with the SAME pure matcher the commit path uses
  // (`detectProtectedPathViolations` over `pathMatchesGlob`) rather than
  // handing the globs to git as a pathspec: git's pathspec wildcards and this
  // project's own glob semantics are not the same language, and one lock must
  // not have two different ideas of what it covers.
  const dirtyPaths =
    worktreePath === undefined ? undefined : dirtyWorktreePaths(worktreePath);
  if (worktreePath !== undefined && dirtyPaths === undefined) {
    // Reported, never silent. A failed probe and a clean tree must not read
    // the same — but this scan is an EXTRA layer on top of the commit-diff
    // lock, so a git hiccup here returns the gate to its previous strength
    // rather than below it, and quarantining a whole ticket over it is the
    // trade `detectProtectedPathViolations`'s own doc comment already
    // refused ("a telemetry-adjacent throw can kill a $300 night for a
    // reason that has nothing to do with the lock actually working").
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] protected-paths-worktree-unreadable: could ` +
        `not run \`git status\` in ${worktreePath}, so an UNCOMMITTED edit to ` +
        `a protected path could not be ruled out. The commit-diff half of the ` +
        `lock still ran.`,
    );
  }
  for (const p of detectProtectedPathViolations(
    dirtyPaths ?? [],
    protectedGlobs,
  )) {
    if (!violations.includes(p)) violations.push(p);
  }
  // Content-level companion check (issue #914 hardening) — see
  // `e2e-script-guard.ts`'s own doc comment for why `apps/nextjs/
  // package.json` is watched by FIELD, not by the glob mechanism above:
  // that file is edited by ordinary feature tickets constantly (adding an
  // npm dependency), so blanket-protecting the whole path would silently
  // revert every legitimate dependency addition. This only fires when the
  // `scripts.e2e` VALUE itself changed — retargeting the command every
  // check's verdict runs through is the same class of hole as editing the
  // check file directly.
  const guardedPkg = e2eScriptGuardedPackageJson();
  if (
    guardedPkg !== null &&
    worktreePath !== undefined &&
    preSha !== "" &&
    shipDiff.changedFiles.includes(guardedPkg) &&
    !violations.includes(guardedPkg) &&
    e2eScriptTampered(worktreePath, preSha, postSha, guardedPkg)
  ) {
    violations.push(guardedPkg);
    committedDiffViolationPaths.add(guardedPkg);
  }
  // Content-level companion for the frozen tsconfigs (issue #1135, MEDIUM 1) —
  // see `tsconfig-guard.ts`'s own doc comment. `check-freeze.ts` freezes three
  // tsconfigs that decide what a graded check SEES (`apps/nextjs/e2e/
  // tsconfig.json`, `apps/nextjs/e2e/checks/tsconfig.json`, and a unit check's
  // `${pkg}/tsconfig.json`); the freeze restores them at GRADE time, but none
  // is on `DEFAULT_PROTECTED_PATH_GLOBS`, so a `paths` remap or an
  // `include`/`exclude` edit was reported as drift and then SHIPPED once the
  // graded run — using the restored copy — passed. A whole-file glob was
  // rejected because a unit check's `${pkg}/tsconfig.json` is an ordinary
  // package config feature work edits, so this fires only when one of the three
  // GRADED fields changed. The frozen check's location names which tsconfig
  // seeds to watch; absent a freeze there is no check to protect.
  const frozenLocation = ctx.frozenCheck?.current?.location;
  if (worktreePath !== undefined && preSha !== "" && frozenLocation !== undefined) {
    for (const tsconfigPath of frozenTsconfigSeedsFor(frozenLocation)) {
      if (
        shipDiff.changedFiles.includes(tsconfigPath) &&
        !violations.includes(tsconfigPath) &&
        tsconfigGradingTampered(worktreePath, preSha, postSha, tsconfigPath)
      ) {
        violations.push(tsconfigPath);
        committedDiffViolationPaths.add(tsconfigPath);
      }
    }
  }
  // Issue #1177 fix: a violation whose bytes are exactly what the run's own
  // proved first-test rewrite just certified is not tampering — see
  // `violationMatchesAcceptedCheck`'s own doc comment for the false-positive
  // this closes on the reviewer-refusal road. Filtered last, after every
  // candidate (commit-diff, uncommitted, e2e-script, tsconfig) has been
  // gathered, so this can never suppress a violation none of those detectors
  // actually found.
  if (worktreePath !== undefined) {
    const frozen = ctx.frozenCheck?.current;
    for (let i = violations.length - 1; i >= 0; i -= 1) {
      const p = violations[i]!;
      if (
        violationMatchesAcceptedCheck(
          worktreePath,
          frozen,
          p,
          postSha,
          committedDiffViolationPaths.has(p),
        )
      ) {
        violations.splice(i, 1);
      }
    }
  }
  if (violations.length === 0) {
    return { sha: postSha, restoredFirstTest: false, restoredPaths: [] };
  }

  // Recorded before any other decision — see the function doc.
  const tamperCount = ctx.telemetry?.noteChecksTampered();
  // No bag (a bare test ctx) can't tell "first" from "second"; treated as
  // first, matching every other `ctx.telemetry?.` call site's no-op-on-absent
  // contract rather than inventing a stricter behavior only reachable when
  // instrumentation itself is missing.
  const nth = tamperCount ?? 1;
  ctx.deps.logError(
    `[issue=${ctx.issueNumber}] protected-paths-tampered (#${nth} on this ` +
      `ticket): the shipped diff touched ${violations.length} path(s) this ` +
      `loop refuses to let an agent change: ${violations.join(", ")}.`,
  );

  // Every edit — the first or a later one — is restored and the restored
  // test re-run at ship; an edit never stops the ticket by itself (spec
  // #1334). Only a restore that cannot be done stops it, below.

  if (sandbox.worktreePath === undefined || preSha === "") {
    throw new ProtectedPathTamperStopError({
      postSha,
      nth,
      violations,
      message:
        `protected-paths-unrestorable: issue #${ctx.issueNumber} touched a ` +
        `protected path (${violations.join(", ")}) but the sandbox exposes no ` +
        `worktree, or no base commit, to restore it from — the tampering ` +
        `cannot be safely undone. Quarantining for human triage.`,
    });
  }

  // THE FIRST TEST IS RESTORED FROM THE FREEZE, never from `preSha` (spec
  // #1334). After a reviewer's `WRONG-CHECK` buys a proved rewrite, `preSha`
  // still holds the OLD, wrong test, and restoring from it would silently put
  // the wrong test back and re-run it. The freeze always holds the test the
  // run last accepted — the original or its proved rewrite — so paths inside
  // the frozen check directory come from there. Everything else is restored
  // from `preSha` exactly as before.
  const frozenForRestore = ctx.frozenCheck?.current;
  const inFrozenCheckDir = (p: string): boolean =>
    frozenForRestore !== undefined &&
    p.startsWith(`${frozenForRestore.location.checkDir}/`);
  // Read by the ship-time run of the first test: a restored test that then
  // fails is a red result on the builder's code, never a first-test
  // fall-through (spec #1334: a tampered test never counts).
  const restoredFirstTest = violations.some(inFrozenCheckDir);
  const restoreOutcomes = [
    ...restoreProtectedPaths(
      sandbox.worktreePath,
      preSha,
      violations.filter((p) => !inFrozenCheckDir(p)),
    ),
    ...(frozenForRestore === undefined
      ? []
      : restoreFrozenCheckPaths(
          sandbox.worktreePath,
          frozenForRestore,
          violations.filter(inFrozenCheckDir),
        )),
  ];
  const failed = restoreOutcomes.filter((r) => !r.restored);
  if (failed.length > 0) {
    throw new ProtectedPathTamperStopError({
      postSha,
      nth,
      violations,
      message:
        `protected-paths-restore-failed: issue #${ctx.issueNumber} — could not ` +
        `restore ${failed.map((r) => `${r.path}${r.error ? ` (${r.error})` : ""}`).join(", ")} ` +
        `byte-for-byte from ${preSha}. Quarantining for human triage.`,
    });
  }

  // Which restored paths can git actually be asked to stage? A path the
  // builder only ever created ON DISK (the untracked-smuggle case the
  // worktree scan above now catches) has been restored by DELETING it, and it
  // was never in the index either — so `git add -A -- <that path>` matches
  // neither the worktree nor the index and FAILS OUTRIGHT, taking the whole
  // batch with it. Its restore is already complete and already recorded; it
  // simply has nothing to contribute to a commit.
  const restoredIn = sandbox.worktreePath;
  const committablePaths = violations.filter(
    (p) =>
      existsSync(path.join(restoredIn, p)) ||
      runGit(restoredIn, "ls-files", "--error-unmatch", "--", p).ok,
  );
  if (committablePaths.length === 0) {
    // Nothing entered git, so nothing needs to leave it: `postSha`'s tree was
    // always correct and is what downstream gates should grade. An empty
    // marker commit here would also have to be built from an EMPTY pathspec,
    // which `git add -A --` reads as "the entire tree".
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] protected-paths: restored ${violations.length} ` +
        `path(s) that existed only in the worktree (never committed) — ${postSha} ` +
        `already carries the correct tree, so no restore commit was needed.`,
    );
    return { sha: postSha, restoredFirstTest, restoredPaths: violations };
  }

  const originalMessageResult = runGit(
    sandbox.worktreePath,
    "show",
    "-s",
    "--format=%B",
    postSha,
  );
  if (!originalMessageResult.ok) {
    throw new ProtectedPathTamperStopError({
      postSha,
      nth,
      violations,
      message:
        `protected-paths-restore-failed: issue #${ctx.issueNumber} — restored ` +
        `${violations.join(", ")} on disk but could not read ${postSha}'s ` +
        `commit message to build the restore commit: ${originalMessageResult.stderr}. ` +
        `Quarantining for human triage.`,
    });
  }
  const message = buildProtectedPathRestoreMessage(
    originalMessageResult.stdout,
    violations,
    nth,
  );
  const restoredSha = commitRestoredPaths(
    sandbox.worktreePath,
    committablePaths,
    message,
  );
  if (restoredSha === undefined) {
    throw new ProtectedPathTamperStopError({
      postSha,
      nth,
      violations,
      message:
        `protected-paths-restore-failed: issue #${ctx.issueNumber} — restored ` +
        `${violations.join(", ")} on disk but the restore commit itself failed. ` +
        `Quarantining for human triage.`,
    });
  }
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] protected-paths: restored ${violations.length} ` +
      `path(s) and shipped the restoration as ${restoredSha} — downstream gates ` +
      `now grade that commit, not the tampered one.`,
  );
  return { sha: restoredSha, restoredFirstTest, restoredPaths: violations };
}

/** What {@link enforceProtectedPaths} hands the ship funnel. */
export interface ProtectedPathsOutcome {
  /** The commit every later gate grades: `postSha`, or the restore commit. */
  readonly sha: string;
  /** True when an edit to this ticket's own first test was undone. The
   *  ship-time run of the first test then grades the RESTORED test, so a red
   *  result there is the builder's code failing it — the reviewer approved
   *  against the edited copy — and the ticket goes to the fixer instead of
   *  shipping labelled `shipped-without-first-test`. */
  readonly restoredFirstTest: boolean;
  /** Every path the lock put back. Added to the ship-time test run's scope,
   *  so a restored UNIT check (`src/__checks__/`) is re-run even when the
   *  diff that removed it no longer lists it (a resumed ticket's saved test,
   *  #1361). That run is each package's vitest suite, so a restored BROWSER
   *  check (`apps/nextjs/e2e/checks/`) is put back but not re-run here — a
   *  resumed ticket has no frozen first test, and its reviewer is the gate,
   *  exactly as before #1361. */
  readonly restoredPaths: readonly string[];
}

/**
 * Every input `shipAfterMigrations` takes beyond the ticket's `ctx` and its
 * `sandbox` — NAMED, so no caller can hand them over in the wrong order
 * (issue #1227).
 *
 * ## Why named rather than positional
 *
 * This was sixteen positional parameters. Two ADJACENT PAIRS shared a type, so
 * a swap compiled clean and shipped wrong:
 *
 * - `preSha` / `postSha`, both bare `string`. Swapped, they INVERT the diff
 *   base, and every gate below then weighs the wrong change — merging broken
 *   work, or refusing good work, with nothing to complain.
 * - `checkWriterCheckCommand` / `checkWriterScreen`, both bare optional
 *   `string`, and the only two in the old list with no doc comment between
 *   them.
 *
 * ## Why EVERY field is required — `| undefined` and not `?`
 *
 * A caller holding no value must write `undefined` against the field ON
 * PURPOSE. Forgetting a field is then a TYPE ERROR rather than a silent
 * omission, which is the whole point: `checkTestCount` was added as the
 * sixteenth positional parameter and wired into ONE of the five running call
 * sites. The other four dropped it and nothing said a word.
 *
 * That sentence is HISTORY — the shape this interface exists to make
 * impossible, not the state of the code today. Of those four, two were the
 * accident and now pass the tally; the other two ship a REPAIRED check and
 * pass `undefined` on purpose. The rule, and the test that pins it, are on
 * {@link ShipAfterMigrationsInput.checkTestCount} below.
 *
 * The three fields that once carried defaults are required for the same
 * reason — `skillsInvoked` (was `[]`), `legPath` (was `"first-pass-only"`) and
 * `checkWriterCheckKind` (was `"browser"`). Every call site that relied on a
 * default now writes that same value out, so behaviour is unchanged.
 *
 * Test call sites spread `SHIP_INPUT_DEFAULTS` (`__fixtures__/ship-input.mts`)
 * rather than restating eleven fields each. The five RUNNING call sites never
 * do, and never should: they are where this guarantee has to hold.
 */
export interface ShipAfterMigrationsInput {
  /**
   * The diff base and the finished commit. Named — never adjacent positional
   * `string`s again — because swapping them inverts every measurement the
   * gates below make (issue #1227).
   */
  readonly preSha: string;
  readonly postSha: string;
  readonly finalMarker: string;
  /**
   * The report-only rows of the review whose `ALL_CLEAR` this is — read with
   * `readReviewNotes`, labelled at the ship moment, never a gate.
   */
  readonly reviewNotes: ReviewNotes;
  readonly skillsInvoked: readonly string[];
  readonly legPath: PromptLegPath;
  /**
   * WHICH of the five things the check-writer said for this issue (issue #911
   * Piece D, widened to the proof router by issue #956). Weighed HERE against
   * the FINISHED `shipDiff` — what the diff DEMANDS versus what this marker
   * OFFERS — never trusted from the moment the claim was made. See
   * `lib/checkwriter/proof-demand.ts`'s module doc for the whole rule.
   *
   * This was a `checkWriterNoScreenApplies` boolean. It could only ask one of
   * the three questions the gate now asks, and it was a value DERIVED from
   * this marker sitting beside it — so the day a fifth marker landed, the
   * boolean kept answering for a world with four.
   *
   * `undefined` means this call site ran no check-writer stage AT ALL — every
   * pre-#911 caller, tests included — and the demand-versus-offer gate is
   * dormant for it, exactly as the boolean defaulting `false` already made it.
   * Production has no such call site: `runIssuePipeline` is the only caller
   * and always passes `checkStage.marker`.
   */
  readonly checkWriterMarker: CheckWriterMarker | undefined;
  /**
   * The check-writer's check command (`buildCheckCommand`'s output on the
   * browser route, `buildUnitCheckCommand`'s on the unit one) and the screen it
   * targets — present for a genuine `CHECKS_WRITTEN` (fresh or inherited) or a
   * `UNIT_CHECK_WRITTEN`, absent for `NO_SCREEN_APPLIES` (and `screen` is
   * absent on the unit route, which has no page to name). When present, this is
   * where issue #912's harness gate runs — see the call below. `undefined` on
   * every pre-#912 call site (tests included), which skips the gate entirely.
   */
  readonly checkWriterCheckCommand: string | undefined;
  readonly checkWriterScreen: string | undefined;
  /**
   * WHICH RUNNER re-runs `checkWriterCheckCommand` at ship time (issue #956).
   * Must be the runner the must-fail-first proof used, or the same command is
   * graded by the other runner's rules and given the other runner's budget: a
   * vitest run judged by Playwright's rules accepts a bare non-zero exit — a
   * syntax error — as a genuine failure.
   *
   * Was `= "browser"`, a default, until issue #1227 made every field required.
   * `"browser"` is still what every pre-#956 call site meant when there was
   * only one runner, and every site that relied on the default now says so.
   */
  readonly checkWriterCheckKind: CheckKind;
  /**
   * THE BUILDER'S OWN ACCOUNT of the pass that is shipping — the implementer's
   * `<rebuttal>` text, or `undefined` when it gave none (issue #1082 fault 3a,
   * built under issue #1128).
   *
   * Threaded because the deleted-test stop below is a report a PERSON has to
   * judge, and it carried only the gate's side. `proofGateRefusal`'s own doc
   * comment holds the full argument for what this may and may not contain; the
   * graded-mismatch report further down prefers it over the reviewer-verdict
   * proxy it used to fall back to, for the same reason.
   *
   * `undefined` on every pre-#1128 call site (tests included), and on every
   * `first-pass-only` ship, where a rebuttal structurally cannot exist. That
   * prints the explicit "(the builder raised no rebuttal on this pass; its own
   * words are not captured in this record)" — never a dropped field, and never
   * the wider claim that the builder had no reason.
   */
  readonly builderAccount: string | undefined;
  /**
   * WHERE the committed check lives in the worktree. The ship-time re-run
   * rebuilds the check's command from it with a fresh nonce, and its size
   * sizes that run's time window (`effectiveCheckTestCount`).
   *
   * Deliberately NOT derived from `checkWriterCheckCommand`, which embeds the
   * path inside a shell command and would have to be re-parsed to get it back.
   * `undefined` on every call site that ran no check-writer stage.
   */
  readonly checkLocation: CheckLocation | undefined;
  /**
   * The unit check's hosting package (`packages/<name>`), needed only to rebuild
   * a unit check's command with a fresh ship-time nonce (issue #972 gap 1). The
   * browser route rebuilds from `checkLocation` alone; `undefined` here makes the
   * unit rebuild fall back safely to the replayed nonce, exactly as before.
   */
  readonly checkWriterCheckPackage: string | undefined;
  /**
   * The implementer's own certification envelope for the pass that is shipping
   * (issue #871, repair 3). The driver sets what the FINISHED diff touched
   * (`commitTouchedUi`) beside what the story CLAIMED (`storyType`/`e2eRequired`)
   * and stops the ticket when the two contradict — a UI-touching diff certified
   * as needing no Playwright. `undefined` on the paths that produced no
   * certification (a rebuttal, a HALT, a stuck-abort, or a pre-#871 test call
   * site), which skips the check exactly as an absent envelope always has.
   */
  readonly implementerCertification: ImplementerOutputParsed | undefined;
  /**
   * How many graded scenarios the check-writer's PROOF RUN counted (issue
   * #1176) — `CheckWriterResult.mustFailFirstTestCount`, threaded through
   * `runCheckWriterStage`'s `checkTestCount`. This is never used alone: the
   * call below runs it through `effectiveCheckTestCount` (review finding 4),
   * which takes the LARGER of this and a fresh static read of whatever check
   * is actually being shipped — so a repaired check (a different file this
   * value was never counted against) or a stale/undercounted proof tally can
   * only ever widen the ship-time harness's scaled time window
   * (`scaledCheckTimeoutBudgetMs`), never narrow it below what the file on
   * disk demands today. `undefined` on every call site that ran no
   * check-writer stage (tests included), whose proof produced no tally, or
   * whose check was repaired after the proof ran — `effectiveCheckTestCount`
   * then falls back to the static read alone.
   *
   * Was the SIXTEENTH positional parameter, and four of the five running call
   * sites silently omitted it. That omission is what issue #1227 exists to
   * make impossible.
   */
  readonly checkTestCount: number | undefined;
}

/**
 * Per-file `+added −removed` line counts between two commits, for the
 * older-test record. `{}` when git could not be asked: a missing line count is
 * a thinner record, never a wrong decision — every rule has already run.
 */
function amendedLineStats(
  repoRoot: string,
  fromSha: string,
  toSha: string,
): Readonly<Record<string, { readonly added: number; readonly removed: number }>> {
  const res = runGit(repoRoot, "diff", "--numstat", "-z", "--no-renames", fromSha, toSha);
  if (!res.ok) return {};
  const per: Record<string, { added: number; removed: number }> = {};
  for (const record of res.stdout.split("\0")) {
    const m = /^(\d+|-)\t(\d+|-)\t(.+)$/.exec(record);
    if (m === null) continue;
    per[m[3]!] = {
      added: m[1] === "-" ? 0 : Number(m[1]),
      removed: m[2] === "-" ? 0 : Number(m[2]),
    };
  }
  return per;
}

/** What the older-test check allowed: the exact paths the locked-check
 *  refusal may excuse, and the record the ship moment writes. */
interface OlderTestEditsAllowed {
  readonly authorizedPaths: readonly string[];
  readonly amendment?: OlderTestEditRecord;
}

const NO_OLDER_TEST_EDITS: OlderTestEditsAllowed = { authorizedPaths: [] };

/**
 * THE OLDER-TEST RULE (spec #1334, slice SH). The builder or the fixer may
 * edit an OLDER ticket's test — a file under another ticket's
 * `e2e/checks/issue-<N>/` or `src/__checks__/issue-<N>/` folder — only when
 * all four hold:
 *
 *   1. the loop ran the ORIGINAL older test against the new code and saw it
 *      fail (a passing test is never changed);
 *   2. the edit stays inside that one test file;
 *   3. the test-case count is unchanged;
 *   4. no skip / only / todo / skipIf / runIf was added.
 *
 * Machine-detected from the finished diff: no agent names the file and no
 * judge rules on it. Rules 2-4 are read off the bytes first
 * (`planOlderTestEdits`), so a refusal there costs no test run. Rule 1, and
 * the edited test's own green run, use the ticket's sandbox.
 *
 * A refusal THROWS a plain `Error` whose message starts
 * `check-writer-locked-check-touched`, so it routes like any other failed
 * ship-time check: to the fixer, with the message as its brief. It is
 * deliberately not a typed ship stop, which would end the ticket on the spot.
 *
 * An ordinary ticket that touches no older test pays nothing: the answer
 * comes back before any git read or test run.
 *
 * What it cannot see: an edit that keeps the count, skips nothing, goes
 * red-then-green, and still guts an assertion (`expect(true).toBe(true)`).
 * The reviewer's prompt names that as its job.
 */
async function verifyOlderTestEdits(
  ctx: PipelineCtx,
  sandbox: SandboxHandle,
  opts: {
    readonly base: string;
    readonly head: string;
    readonly changedFiles: readonly string[] | null;
    readonly ownCheckDirs: readonly string[];
  },
): Promise<OlderTestEditsAllowed> {
  const touched = lockedCheckTouches(opts.changedFiles, opts.ownCheckDirs);
  if (touched.length === 0) return NO_OLDER_TEST_EDITS;

  const refuse = (because: string, paths: readonly string[]): never => {
    throw new Error(
      `check-writer-locked-check-touched: issue #${ctx.issueNumber} — the ` +
        `finished diff edits another ticket's test folder ` +
        `(${paths.join(", ")}) and ${because}. An older ticket's test may be ` +
        `edited only when all four hold: the run runs the ORIGINAL older test ` +
        `against the new code and sees it fail; the edit stays inside that one ` +
        `test file; its test-case count is unchanged; no skip, only, todo, ` +
        `skipIf or runIf is added. Put the older ticket's files back exactly ` +
        `as they were, or change the edit so all four hold.`,
    );
  };
  const repoRoot = ctx.args.repoRoot;
  const read = (sha: string, p: string): string | undefined =>
    readBlobAt(repoRoot, sha, p)?.toString("utf8");
  const plan = planOlderTestEdits({
    touched: touched.map((p) => ({
      path: p,
      before: read(opts.base, p),
      after: read(opts.head, p),
    })),
    preauthorizedDeletions: preauthorizedTestDeletions(ctx.issueBody),
  });
  if (!plan.ok) return refuse(plan.because, plan.paths);
  if (plan.edited.length === 0) return { authorizedPaths: plan.deleted };

  // RULE 1 and the green run need the ticket's own checkout, standing on the
  // commit being shipped, with nothing uncommitted: the red run writes the
  // ORIGINAL bytes over the file and puts the shipped bytes back after.
  const worktreePath = sandbox.worktreePath;
  const editedPaths = plan.edited.map((c) => c.path);
  if (worktreePath === undefined) {
    return refuse(
      "this sandbox has no checkout on disk, so the original older test " +
        "cannot be run to show it was failing",
      editedPaths,
    );
  }
  if ((await ctx.deps.captureSha(worktreePath)) !== opts.head) {
    return refuse(
      `the checkout is not standing on ${opts.head}, the commit being shipped, ` +
        `so a run there would not grade the new code`,
      editedPaths,
    );
  }
  const dirty = dirtyPathsIn(worktreePath);
  if (dirty === null || dirty.length > 0) {
    return refuse(
      dirty === null
        ? "git could not be asked whether the checkout is clean"
        : `the checkout has uncommitted changes (${dirty.slice(0, 5).join(", ")})`,
      editedPaths,
    );
  }

  const runOne = async (
    check: OlderCheck,
    bytes: string,
    expect: "red" | "green",
  ): Promise<CheckRunVerdict> => {
    const abs = path.join(worktreePath, check.path);
    const shipped = readFileSync(abs, "utf8");
    if (bytes !== shipped) writeFileSync(abs, bytes);
    try {
      ctx.status?.noteProgress?.();
      const nonce = newCheckNonce();
      const command = rebuildCheckCommandFor(
        worktreePath,
        check.location,
        check.packageDir,
        nonce,
      );
      if (command === undefined) {
        return {
          status: "inconclusive",
          reason: "no runnable command could be built for it",
        };
      }
      return await runCheckCommand(
        check.location.kind,
        sandbox.exec,
        command,
        expect,
        nonce,
        scaledCheckTimeoutBudgetMs(check.location.kind, countCheckScenarios(bytes)),
        {
          repoRoot,
          branch: sandbox.branch,
          issueNumber: ctx.issueNumber,
          phase: "ship" as const,
          worktreePath,
          onError: ctx.deps.logError,
        },
      );
    } finally {
      if (bytes !== shipped) writeFileSync(abs, shipped);
    }
  };

  // No running time total across these runs, on purpose (spec #1366): the
  // worst-case pre-check that did this refused a ~10-second test on a
  // 72-minute guess. Each run keeps its own scaled timeout instead.
  for (const check of plan.edited) {
    const original = read(opts.base, check.path) ?? "";
    const edited = read(opts.head, check.path) ?? "";
    const red = readPostBuilderRedProof(await runOne(check, original, "red"));
    const restored = dirtyPathsIn(worktreePath);
    if (restored === null || restored.length > 0) {
      if (!discardWorkingTreeChanges(worktreePath)) {
        throw new Error(
          `[issue=${ctx.issueNumber}] older-test check: the checkout could NOT ` +
            `be put back after running the original ${check.path} — nothing ` +
            `from this ticket may ship.`,
        );
      }
    }
    if (!red.proved) {
      return refuse(
        `nothing shows the ORIGINAL ${check.path} was failing on the new code ` +
          `(${red.because}) — a passing test is never changed`,
        [check.path],
      );
    }
    const green = readPostBuilderGreenProof(await runOne(check, edited, "green"));
    if (!green.proved) {
      return refuse(
        `the edited ${check.path} does not pass on the new code (${green.because})`,
        [check.path],
      );
    }
  }

  const stats = amendedLineStats(repoRoot, opts.base, opts.head);
  const amendment: OlderTestEditRecord = {
    amendedByIssue: ctx.issueNumber,
    runBranch: ctx.args.branch,
    commitSha: opts.head,
    files: plan.edited.map((c) => ({
      issueNumber: c.issueNumber,
      path: c.path,
      linesAdded: stats[c.path]?.added ?? 0,
      linesRemoved: stats[c.path]?.removed ?? 0,
    })),
    paths: editedPaths,
  };
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] older-test check: allowed the edit to ` +
      `${editedPaths.join(", ")} — the original failed on the new code, the ` +
      `edited one passes, case counts unchanged, nothing skipped.`,
  );
  return { authorizedPaths: [...editedPaths, ...plan.deleted], amendment };
}

export async function shipAfterMigrations(
  ctxIn: PipelineCtx,
  sandbox: SandboxHandle,
  input: ShipAfterMigrationsInput,
): Promise<IssueOutcome> {
  // `let`: the older-test check below may add the record of an allowed edit
  // to an older ticket's test, which the ship moment reads off `ctx`.
  let ctx = ctxIn;
  // Issue #1227: the named inputs are unpacked here, at the top, into exactly
  // the local names the thousand lines below have always used — so making the
  // signature safe moved the SIGNATURE and nothing else. Nothing beneath this
  // block reads `input` directly, and nothing beneath it changed.
  //
  // `postSha` and `implementerCertification` are `let` because the body
  // REASSIGNS them (`postSha` after the protected-path restore and after a proved first-test rewrite;
  // `implementerCertification` when the finished diff's UI-touching answer and
  // the observed database are folded in). A `readonly` field cannot be
  // reassigned, so these two are copied out rather than destructured as
  // constants. Every other field is read-only and stays that way.
  const {
    preSha,
    finalMarker,
    reviewNotes,
    skillsInvoked,
    legPath,
    checkWriterMarker,
    checkWriterCheckCommand,
    checkWriterScreen,
    checkWriterCheckKind,
    builderAccount,
    checkLocation,
    checkWriterCheckPackage,
    checkTestCount,
  } = input;
  let postSha = input.postSha;
  let implementerCertification = input.implementerCertification;
  // Which prompt legs actually ran before this issue shipped. Recorded at the
  // single funnel every ship path passes through, so a new leg can't be added
  // upstream without it being reported.
  ctx.telemetry?.noteShipPath(legPath);
  // Re-measure the diff here, spanning the WHOLE issue (every implementer
  // retry commit, and on a resume the previous session's commits too)
  // rather than the narrower per-attempt base the first-pass reviewer measured.
  // The base is NOT `preSha` — see shipDiffBase, which carries the full
  // argument for why this measurement can never narrow the recorded diff and
  // why the bag's last-write-wins setter is therefore correct. The recording
  // helper guards a fail-quiet git hiccup so it can never blank a real record.
  // Hoisted into a const rather than inlined: the test-verification gate below
  // needs the SAME changed-path set to scope its run, and re-deriving it with a
  // second `git diff` would let the two drift apart (different base, different
  // scope) the day either call site is edited.
  // Hoisted for the same reason `shipDiff` itself is: the removal set below
  // must be measured from the IDENTICAL base, or the two answers describe
  // different diffs and the guard reasons about a file set it never saw.
  //
  // THE BASE IS IDENTICAL. THE TIP IS NOT, and that is deliberate (issue #959).
  // `enforceProtectedPaths` below reassigns `postSha` — it can add a RESTORE
  // commit — between the `diffStatsBetween` call just below and the
  // `guttedFilesBetween` call at the proof gate, both of which read `postSha`.
  // So the changed-file set is measured to the PRE-restore tip and the removal
  // set to the POST-restore tip.
  //
  // (Named without their argument lists on purpose: the call-site rot-guard in
  // `main.test.mts` counts those names followed by `(` across the whole tree,
  // and a prose mention shaped like a call reads to it as a third measurement
  // site. Blunting the guard to fit a comment would be the wrong trade.)
  //
  // Safe, in one direction only, and the direction is the point. A restore only
  // puts PROTECTED paths back, so `gutted(base, newTip) ⊆ gutted(base, oldTip)`
  // and the entries that drop out are exactly the removals the lock just undid.
  // The gate then INTERSECTS the removal set with the changed-file set
  // (`lib/checkwriter/proof-demand.ts`), and a narrower removal set against a
  // wider changed-file set yields the narrower one.
  //
  // MOVING `guttedFilesBetween` ABOVE `enforceProtectedPaths` WAS CONSIDERED
  // AND REFUSED. It would make both answers share one tip, which reads tidier,
  // but the shared tip is the PRE-restore one — so the gate would stop a ticket
  // for coverage the lock had already put back. That is a stop on healthy work,
  // which costs a whole night's run, against a comment that was merely
  // imprecise. The comment is corrected instead.
  const shipBase = shipDiffBase(
    ctx.args.repoRoot,
    ctx.args.branch,
    preSha,
    postSha,
  );
  // Measured ONCE, read TWICE, with two different failure directions. The proof
  // gate reads `measuredShipDiff` (fail-closed: `null` means git could not be
  // asked, which is never an all-clear); the protected-path lock, the
  // test-verification scope and the telemetry record keep the fail-quiet
  // `{0, []}`. One `git diff`, so the readers cannot describe different diffs.
  const measuredShipDiff = diffStatsBetween(
    ctx.args.repoRoot,
    shipBase,
    postSha,
  );
  const shipDiff = measuredShipDiff ?? UNMEASURED_DIFF;
  recordDiffMeasurement(ctx, shipDiff);
  // Protected-path lock (issue #909 / Piece C). Runs on the FULL shipDiff
  // above — spanning every implementer and retry commit — so
  // tampering on an earlier attempt can't be laundered by tidying up on the
  // last one, and BEFORE the lint/test-cert gates below so a restored commit
  // is what those gates (and the migration/journal gate after them) actually
  // grade. See `lib/paths/protected-paths.ts` for what "protected" means
  // today (unconditionally: the practice world) and, since issue #911,
  // additionally the per-issue check directory `ctx.protectedPathGlobs`
  // carries — populated by `runCheckWriterStage`, never here.
  const protectedPaths = await enforceProtectedPaths(
    ctx,
    sandbox,
    preSha,
    postSha,
    shipDiff,
  );
  postSha = protectedPaths.sha;
  // THE PROOF GATE (issue #911 Piece D, replaced by issue #956's router) —
  // weighed against the FINISHED diff, never the check-writer's claim at the
  // moment it was made. Two refusals, one function, shared by the builder and
  // the fixer alike: a diff that DELETED test coverage (under every marker),
  // and a diff that owes more proof than its marker offers.
  //
  // Uses the same `shipDiff` the protected-path lock above just measured, from
  // the same fork-point `shipBase` — spanning every implementer and
  // retry commit on this issue, not just the last attempt's. That is
  // what makes it un-dodgeable: a builder cannot launder a violation by tidying
  // up an earlier commit, because the measurement never narrows. The removal
  // set is read from the IDENTICAL base for the same reason; two bases would
  // have the gate reasoning about a file set it never saw.
  //
  // WHAT IS WAIVED (issue #969; no mode since spec #1334). Only the
  // demand-versus-offer refusal is recorded and the ticket ships: removed
  // coverage, an unknowable answer, another ticket's locked check and a marker
  // that cannot ship all stop (`neverWaived`). `proofGateRefusal` decides
  // which is which; the code below only applies it.
  // THE OLDER-TEST RULE (spec #1334 SH) — before the proof gate, so the
  // gate's locked-check refusal excuses exactly the older-test files this
  // allowed. A refusal throws and goes to the fixer. Skipped exactly where
  // the proof gate skips its locked-check refusal: no check-writer marker.
  //
  // THE TICKET'S OWN CHECK DIRECTORIES (#1361): exactly the ones locked for
  // it, read off the lock itself so the two cannot disagree. A fresh ticket's
  // is the folder its check-writer created; a resumed ticket's are the ones
  // its saved work created (`disposeAlreadyBuilt`, CASE 3). A folder that is
  // not locked for this ticket is never its own (#972 gap 5).
  const ownDirs = (ctx.protectedPathGlobs ?? [])
    .filter((glob) => glob.endsWith("/**"))
    .map((glob) => glob.slice(0, -"/**".length));
  const olderTestEdits =
    checkWriterMarker === undefined
      ? NO_OLDER_TEST_EDITS
      : await verifyOlderTestEdits(ctx, sandbox, {
          base: shipBase,
          head: postSha,
          changedFiles: measuredShipDiff?.changedFiles ?? null,
          ownCheckDirs: ownDirs,
        });
  if (olderTestEdits.amendment !== undefined) {
    ctx = { ...ctx, olderTestEditRecord: olderTestEdits.amendment };
  }
  const proofRefusal = proofGateRefusal({
    issueNumber: ctx.issueNumber,
    marker: checkWriterMarker,
    changedFiles: measuredShipDiff?.changedFiles ?? null,
    guttedFiles: guttedFilesBetween(ctx.args.repoRoot, shipBase, postSha),
    // The folders locked for this ticket (#1361), read above.
    ownCheckDirs: ownDirs,
    issueBody: ctx.issueBody,
    pathLabel: "",
    // Issue #1128: the deleted-test refusal is a stop a person has to judge,
    // so it gets the builder's argument too, not just the gate's.
    builderAccount,
    // #1198 A: on a ticket the loop built without a first test, the
    // demand-versus-offer half of this gate is waived — and ONLY that half.
    // See `proofGateRefusal`'s `firstTestFellThrough` doc for what still
    // holds and why.
    firstTestFellThrough: ctx.firstTestFellThrough !== undefined,
    // Spec #1334 SH: the exact older-test files `verifyOlderTestEdits` just
    // allowed — and only those — are excused from the locked-check refusal.
    authorizedOlderTestPaths: olderTestEdits.authorizedPaths,
    logError: ctx.deps.logError,
  });
  if (proofRefusal !== undefined) {
    if (proofRefusal.neverWaived) {
      throw new ProofDemandUnsatisfiedStopError({
        postSha,
        touchedPaths: proofRefusal.touchedPaths,
        message: proofRefusal.message,
        disagreement: proofRefusal.disagreement,
      });
    }
    await recordWaivedProofRefusal(ctx, proofRefusal);
  }
  // THE STORY-TYPE-VS-DIFF GATE (issue #871, repair 3). The proof gate above
  // weighs the CHECK-WRITER's marker against the diff; this weighs the
  // IMPLEMENTER's own certification against it. `requiredProofForDiff` decides,
  // from the finished diff alone, whether the commit touched a rendered surface
  // (`COMMIT_TOUCHED_UI`); when it did, Playwright is required
  // (`SPEC_REQUIRES_PLAYWRIGHT`), so a certification carrying `e2eRequired=false`
  // is a self-report the diff contradicts — the exact "backend-only claim that
  // still parses clean and still ships" #871 names. The distinction is stamped
  // onto the envelope (`commitTouchedUi`) so the record carries what the diff
  // touched beside what the story called itself.
  //
  // Treated exactly like the proof gate's waived refusal: a UI-diff-vs-claim
  // contradiction IS a screen-check judgement, so it is RECORDED and the
  // ticket ships (spec #1334).
  if (implementerCertification !== undefined) {
    const changedForUi = measuredShipDiff?.changedFiles ?? null;
    implementerCertification = {
      ...implementerCertification,
      commitTouchedUi: diffCommitTouchedUi(changedForUi),
    };
    const uiClaim = decideUiClaimVsDiff({
      changedFiles: changedForUi,
      certification: implementerCertification,
    });
    if (uiClaim !== null) {
      // BOTH sides of the disagreement (issue #871). This branch once built
      // none of it and only logged: the comment claimed "the disagreement is on
      // the record" while telemetry and the issue body saw nothing (PR #1149
      // review).
      const uiDisagreement = {
        checkDemanded:
          `A browser proof. The finished diff touched a rendered surface ` +
          `(${uiClaim.screenOrFlowTouches.join(", ")}), so Playwright is ` +
          `required whatever the story called itself.`,
        builderProduced:
          `The implementer certified storyType=` +
          `"${uiClaim.claimedStoryType}", e2eRequired=false — a self-report ` +
          `the diff contradicts.`,
      };
      // RECORD the disagreement (telemetry + issue body) and ship, exactly as
      // `recordWaivedProofRefusal` does for the proof gate. A mismatch nobody
      // wrote down is indistinguishable from a gate that never fired.
      ctx.telemetry?.noteScreenCheck({
        verdict: "graded-mismatch",
        whenIso: new Date().toISOString(),
        rerun: false,
        pictureStored: false,
      });
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] story-type-vs-diff: ` +
          uiClaim.message +
          ` Recorded, not a stop — the disagreement is on the record and ` +
          `this ticket ships.`,
      );
      try {
        await ctx.deps.reportScreenCheckWatch?.(ctx.issueNumber, {
          verdict: "graded-mismatch",
          detail: uiClaim.message,
          disagreement: uiDisagreement,
          wouldHaveStoppedAs: "stopped:check-disagreement",
        });
      } catch (e) {
        ctx.deps.logError(
          `reportScreenCheckWatch failed for issue #${ctx.issueNumber}: ` +
            `${(e as Error).message}`,
        );
      }
    }
  }
  // Lint gate. Runs after the protected-path lock and before the journal/migration gates, so
  // an unlinted diff never reaches the dev DB or markDone. Dormant when the
  // project has no `lint` script or there is no code diff.
  //
  // TWO STEPS, AND THE SECOND IS THE POINT (issue #931). Step one greps the
  // shipped commit for the implementer's `SANDCASTLE-LINT: pass` cert — cheap,
  // and conclusive when it is there. When it is NOT there, the loop does not
  // quarantine on the paperwork: it RUNS LINT ITSELF and decides on what it
  // observes. #931 was correct, tested and finished, and died because its
  // builder stamped `SANDCASTLE-LINT: n/a` instead of `pass`; a recovery pass
  // fixed the stamp and nothing else and the work shipped. Asking an agent
  // whether it ran the linter, and killing finished work when the answer is
  // wrong, is the wrong instrument when the linter is right there to run.
  const lint = await ctx.deps.checkLintCert(ctx.args.repoRoot, preSha, postSha);
  if (lint.status === "missing") {
    const verified = await ctx.deps.verifyLintRun(sandbox.exec);
    if (verified.status === "fail") {
      // A REAL failing lint, worded distinctly from the paperwork complaint —
      // an owner triaging this at 8am must be able to tell "lint is broken"
      // from "the stamp is missing" without opening the diff.
      throw new Error(
        `lint-verify-failed: issue #${ctx.issueNumber} commit ${postSha} ` +
          `carries no \`${LINT_CERT_TOKEN}\` certification, so the loop ran the ` +
          `project's lint itself — and it FAILED: ${verified.reason}. This does ` +
          `not ship. Quarantining for human triage.`,
      );
    }
    if (verified.status === "inconclusive") {
      // Nothing was verified, so the missing cert stands and this quarantines
      // exactly as it did before the verification step existed. Says WHY the
      // loop could not settle it itself, so a triaging human does not re-run
      // lint by hand to discover the sandbox was the problem.
      throw new Error(
        `lint-cert-missing: issue #${ctx.issueNumber} commit ${postSha} changed ` +
          `code but its body lacks the \`${LINT_CERT_TOKEN}\` certification, and ` +
          `the project defines a \`lint\` script. The loop tried to run lint ` +
          `itself and could not: ${verified.reason}. The implementer must run ` +
          `lint and certify it passed (see implement-prompt.md), and the ` +
          `reviewer must reject an uncertified or failing lint. Quarantining ` +
          `for human triage.`,
      );
    }
    // Lint really ran and was really clean. The slice ships — and the record
    // says the LOOP certified it, never silently pretending the agent did.
    // logError, not log: the ticket is fine, but an implementer that skipped
    // its certification is a prompt-compliance defect nobody can fix unless it
    // is visible. It is a report, NOT a gate — control falls through to ship.
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] lint-self-certified: commit ${postSha} ` +
        `carried no \`${LINT_CERT_TOKEN}\` certification, so the loop ran the ` +
        `project's lint itself and observed a PASS (${verified.reason}). ` +
        `Shipping on the loop's own run; the implementer did NOT certify this.`,
    );
  }
  // Test gate (deterministic host backstop). A 1:1 mirror of the lint gate:
  // runs right after it and before the journal/migration gates, so a
  // test-uncertified diff never reaches the dev DB or markDone. Dormant when
  // the project has no `test` script or there is no code diff. The test RUN
  // happens in-sandbox (implementer runs+fixes, reviewer verifies); this only
  // confirms the implementer's `SANDCASTLE-TEST: pass` cert is present.
  const testCert = await ctx.deps.checkTestCert(
    ctx.args.repoRoot,
    preSha,
    postSha,
  );
  if (testCert.status === "missing") {
    throw new Error(
      `test-cert-missing: issue #${ctx.issueNumber} commit ${postSha} changed ` +
        `code but its body lacks the \`${TEST_CERT_TOKEN}\` certification, and ` +
        `the project defines a \`test\` script. The implementer must run the ` +
        `test suite and certify it passed (see implement-prompt.md), and the ` +
        `reviewer must reject an uncertified or failing suite. Quarantining ` +
        `for human triage.`,
    );
  }
  // Test-VERIFICATION gate. The cert gate above only proves the implementer
  // WROTE `SANDCASTLE-TEST: pass`; the host has never run anything, so agents
  // have shipped broken work with the cert present. This runs the suites of the
  // workspace packages the diff touched and compares the result to the claim.
  //
  // Engaged ONLY when the cert says "pass": there is nothing to contradict when
  // the cert gate was dormant (no test script / no code diff), and a "missing"
  // cert already threw above.
  //
  // Only an observed `fail` blocks. `inconclusive` means the suite could not
  // RUN (unresolvable toolchain, unreachable Postgres/browser, a timeout) and is
  // logged for a human but never quarantines — the same ABSENT ≠ ZERO
  // discipline `shouldRecordDiffMeasurement` applies to diff measurements.
  // Blocking on it would turn any broken host into a random ticket-killer.
  if (testCert.status === "pass") {
    // FREE PRE-FILTER, ahead of any container work. The real verification below
    // costs a full in-sandbox suite run; this rejects — for the price of a
    // couple of file reads — the one case that needs no run at all: the agent
    // certified `SANDCASTLE-TEST: pass` while its own session log shows it
    // never invoked a test command.
    //
    // It can only REJECT, never approve. A log that looks like tests ran does
    // NOT skip the real run: agents run tests mid-work and keep editing after,
    // and the log is agent-produced text. So the only other verdict is
    // `inconclusive`, and `inconclusive` falls straight through to the run —
    // as does a missing/empty/unrecognized log. See lib/testing/log-prefilter.ts.
    const logEvidence = classifyIssueAgentLogs(
      readAgentLogsForBranch(ctx.args.repoRoot, ctx.issue.branch),
    );
    if (logEvidence.evidence === "no-test-command-seen") {
      throw new Error(
        `test-verify-uninvoked: issue #${ctx.issueNumber} commit ${postSha} ` +
          `certified \`${TEST_CERT_TOKEN}\` — the agent stated the test suite ` +
          `passed — but the agent's own session log for branch ` +
          `${ctx.issue.branch} contains no test command at all: ` +
          `${logEvidence.reason}. Tests cannot have passed if none were ever ` +
          `run, so the certification is false and this does not ship. ` +
          `Quarantining for human triage.`,
      );
    }
    const verified = await ctx.deps.verifyTestRun(
      sandbox.worktreePath,
      // Plus every path the protected-path lock restored: a committed
      // deletion of a locked test is absent at both ends of `shipDiff`, so
      // without this the restored test would ship unrun (#1361).
      [...new Set([...shipDiff.changedFiles, ...protectedPaths.restoredPaths])],
      // Passed detached, which the handle types allow BY CONSTRUCTION: `exec`
      // is declared as a standalone `SandboxCommandRunner` field, so no
      // implementation may depend on `this` and no `.bind` is needed.
      // Undefined when the handle has no exec at all — the gate reports that
      // as inconclusive.
      sandbox.exec,
    );
    if (verified.status === "fail") {
      throw new Error(
        `test-verify-failed: issue #${ctx.issueNumber} commit ${postSha} ` +
          `certified \`${TEST_CERT_TOKEN}\`, but the affected packages' tests ` +
          `were re-run in the sandbox and observed a FAILURE — ${verified.reason}. The ` +
          `certification does not match reality, so this does not ship. ` +
          `Quarantining for human triage.`,
      );
    }
    if (verified.status === "inconclusive") {
      // logError, not log: this is the one outcome nobody can act on unless it
      // is visible. It is a report, NOT a gate — control falls through to ship.
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] test-verify-inconclusive: could not verify ` +
          `the \`${TEST_CERT_TOKEN}\` cert — ${verified.reason}. ` +
          `Shipping on the cert alone; the suite was NOT confirmed.`,
      );
    }
  }
  // The harness-run browser check (issue #912, Piece F). "A browser must
  // open the real page, and a ticket that cannot produce proof of that
  // stops instead of shipping" — the exact reverse of the
  // test-verify-inconclusive fall-through two blocks up. Only engaged when
  // the check-writer produced a real (fresh or inherited) `CHECKS_WRITTEN`
  // check; `checkWriterCheckCommand` is `undefined` for `NO_SCREEN_APPLIES`
  // and for every pre-#912 call site, so this whole block is a no-op there.
  //
  // #1198 A ADDS THE SECOND HALF OF THAT CONDITION, and it is the one place
  // this whole ticket could have quietly failed. A fall-through ticket often
  // DOES carry a check command — on the green-twice road the check is real,
  // it just never failed on untouched code — so without this the ticket would sail past
  // the check-writer stage, cost a build and a review, and then be stopped
  // HERE by the very instrument the loop had already decided it could not
  // stand behind. That is the original stop three agents later, paid for in
  // full, which is worse than either taking it early or not taking it at all.
  // The check is not thrown away: it reaches the REVIEWER as a pre-flight
  // (`checkWriterEvidence`), which is exactly where evidence too weak to gate
  // on still belongs.
  if (
    checkWriterCheckCommand !== undefined &&
    ctx.firstTestFellThrough === undefined
  ) {
    // THE CHEAT DETECTOR, on EVERY ticket and not only repaired ones (issue
    // #1118, layer 1). OpenAI's honeypot definition of test-tampering is: the
    // tree passes as it stands, AND something fails once the agent's edits to
    // the test files are reverted. The first half is computable from the copy
    // this run is already keeping, and it costs one `readFileSync` per frozen
    // path.
    //
    // REPORTED, NEVER ACTED ON HERE. The check directory is already protected
    // by `restoreProtectedPaths`, which runs before this and puts the check
    // back on its own; making this line change an outcome would be a second
    // opinion on a question that already has an answer. What it adds is the
    // SETUP AND CONFIG files, which nothing else watches, and the record that
    // somebody moved them.
    const frozenAtShip = ctx.frozenCheck?.current;
    if (frozenAtShip !== undefined && sandbox.worktreePath !== undefined) {
      const drift = frozenCheckDrift(sandbox.worktreePath, frozenAtShip);
      if (drift.length > 0) {
        ctx.deps.logError(
          `[issue=${ctx.issueNumber}] the check this ticket is graded by is ` +
            `NOT byte-for-byte the one that was accepted — ` +
            `${drift.join(", ")} changed after the check-writer finished. ` +
            `The graded run below uses the accepted copy regardless.`,
        );
      }
    }
    const harness = await ctx.deps.runScreenCheckHarness({
      issueNumber: ctx.issueNumber,
      // The RUN branch (Piece G: "keyed by run branch, then issue, then
      // screen" — a whole run's pictures share one predictable prefix),
      // NOT `ctx.issue.branch` (the per-issue branch this ticket's code
      // lives on).
      branch: ctx.args.branch,
      // The per-issue branch travels too, for the check-run transcript only —
      // it names the file so it lands beside this issue's agent session logs.
      sandboxBranch: sandbox.branch,
      kind: checkWriterCheckKind,
      screen: checkWriterScreen,
      checkCommand: checkWriterCheckCommand,
      // #972 gap 1: the check's own location and package, so the ship-time
      // re-run rebuilds the command with a FRESH nonce instead of replaying the
      // proof's. `undefined` package makes the unit route fall back safely.
      location: checkLocation,
      checkPackage: checkWriterCheckPackage,
      exec: sandbox.exec,
      worktreePath: sandbox.worktreePath,
      // Issue #1176, finding 4: ONE uniform computation, shared with the
      // rescue ladder above via `effectiveCheckTestCount` — the LARGER of
      // the must-fail-first proof's own tally (`checkTestCount`) and a fresh
      // static read of whatever check is ACTUALLY being shipped
      // (`checkLocation`, always correct for either case). Taking the max
      // means a stale or undercounted proof tally can only ever widen this
      // ticket's budget, never narrow it below what the file on disk demands
      // today.
      //
      // WHEN A CALL SITE HANDS THE TALLY OVER, AND WHEN IT PASSES
      // `undefined`: it hands it over when it ships the SAME check the proof
      // counted, and passes `undefined` when it ships a REPAIRED check —
      // different bytes, which that tally was never measured against. THREE
      // of this function's five running call sites ship the unrepaired check
      // and pass the tally; the other TWO are the first-test-rewrite
      // check-repair roads and pass `undefined`. The check's identity and its
      // tally always come from the same place.
      //
      // This comment used to say the tally reached only ONE site and that the
      // rest "correctly" left it out. Both halves were false: two of those
      // sites were dropping it by ACCIDENT — the same file shipped with a
      // 15-minute window on those roads and 43 minutes on the first-pass one
      // — and calling the omission correct argued against ever fixing them
      // (issue #1227 gave the tally back).
      // `main.scaled-timeout-wiring.test.mts` pins the rule at every site, so
      // a sixth site wired the wrong way round fails there even though it
      // would compile and every other test would pass.
      testCount: effectiveCheckTestCount(
        sandbox.worktreePath,
        checkLocation,
        checkTestCount,
      ),
      // Issue #1176, finding 3: the SHIP FUNNEL'S own harness call — this
      // runs inside whatever phase the caller last set (`"reviewer"` at
      // `shipAfterMigrations`'s own call site, with no phase change in
      // between), and the scaled per-attempt budget can now put up to 45
      // minutes on EACH of its up-to-two attempts (issue #1198 piece C
      // raised the ceiling from 15). See `runHarnessScreenCheck`'s
      // `onAttempt` doc comment: without this, the stall watchdog's progress
      // clock can sit frozen for up to 90 minutes — its whole window — on a
      // genuine, healthy re-run, the exact shape
      // `StatusStore.noteProgress`'s own doc comment already warns about for
      // cross-issue steps. Reusing that existing helper, not new machinery.
      onAttempt: () => ctx.status.noteProgress(),
    });
    ctx.telemetry?.noteScreenCheck(harness.record);
    // Issue #1025, guard 2 — the graded run must be PROVEN to have used this
    // job's own database clone (review blocker 1 & 2). Runs on the HARNESS
    // output (`harness.observedDatabases`), the same output the grade is read
    // from, and BEFORE the verdict branch so it bites on a GREEN run — the exact
    // moment a wrong-database pass would ship. `e2eDefinitelyRan` is a green
    // browser run (which must have printed the sentinel) OR the implementer's
    // own claim that an e2e was required and ran — either makes a missing
    // observation a fail-closed, never a silent green. Skips cleanly when no
    // clone was minted (`sandbox.jobDb` null) or the check is the unit route.
    const dbGuard = enforceObservedDatabase({
      expected: sandbox.jobDb,
      observed: harness.observedDatabases ?? [],
      checkEmitsObservation: checkWriterCheckKind === "browser",
      e2eDefinitelyRan:
        harness.verdict === "match" ||
        (implementerCertification?.e2eRequired === true &&
          implementerCertification?.e2eActuallyRan === true),
    });
    if (dbGuard !== null) {
      throw new WrongTestDatabaseStopError({
        postSha,
        message:
          `${dbGuard.message} issue #${ctx.issueNumber}: quarantining for ` +
          `human triage.`,
        disagreement: {
          checkDemanded:
            `The graded check must run against this job's own database clone ` +
            `("${sandbox.jobDb ?? "(none)"}") — the one the grader reads.`,
          builderProduced:
            dbGuard.reasonKind === "mismatch"
              ? `The graded run resolved to ${dbGuard.unexpected
                  .map((n) => `"${n}"`)
                  .join(", ")} instead.`
              : `The graded browser check passed but named no database at all, ` +
                `so the loop cannot prove which one it used.`,
        },
      });
    }
    // Record what the graded run resolved to on the certification the reviewer
    // and telemetry read — observed, not inferred (issue #1025 AC).
    if (
      implementerCertification !== undefined &&
      sandbox.jobDb != null &&
      (harness.observedDatabases ?? []).includes(sandbox.jobDb)
    ) {
      implementerCertification = {
        ...implementerCertification,
        observedDatabase: sandbox.jobDb,
      };
    }
    if (harness.verdict !== "match") {
      // Five DISTINCTLY worded records — never one shared "screen check
      // failed" message. Piece E/F: "wired distinctly — not two." Since spec
      // #1334 none of them is a stop: each is the `detail` of the watch record
      // below, and the ticket ships.
      //
      // AND HONEST ABOUT WHICH INSTRUMENT RAN (issue #956). These messages are
      // what an owner reading the issue at 8am actually reads, and
      // every one of them used to say "the harness opened <screen>" and "the
      // page" — true of Playwright, nonsense of vitest, which opens nothing and
      // has no screen to name. `runner` and `whatItRan` below carry the
      // difference; `CHECK_KIND_RUNNER_NAME` exists so the runner is named the
      // same way in every message that names it.
      //
      // Two of the five are UNREACHABLE on the unit route and stay browser-
      // worded, deliberately: `never-settled` and `claim-mismatch` are thrown
      // only by `waitForGradableScreen`'s sentinels, which live in a Playwright
      // helper and cannot be emitted by a vitest run. The other three —
      // `graded-mismatch`, `environment-fault`, `inconclusive` — are all
      // genuinely reachable there, and all three are reworded.
      const runner = CHECK_KIND_RUNNER_NAME[checkWriterCheckKind];
      const whatItRan =
        checkWriterCheckKind === "browser"
          ? `opened ${checkWriterScreen ?? "(screen not stated)"}`
          : `ran this ticket's unit check`;
      const stopErr = ((): ScreenCheckStopError => {
      if (harness.verdict === "never-settled") {
        return new ScreenCheckStopError({
          verdict: harness.verdict,
          postSha,
          screen: checkWriterScreen,
          message:
            `screen-check-could-not-grade: issue #${ctx.issueNumber} — the ` +
            `harness opened ${checkWriterScreen ?? "(screen not stated)"} and ` +
            `it never declared itself finished — ${harness.reason}. This is ` +
            `the app broken for everyone tonight, not this ticket's fault. ` +
            `Recorded, not a stop.`,
        });
      }
      if (harness.verdict === "claim-mismatch") {
        return new ScreenCheckStopError({
          verdict: harness.verdict,
          postSha,
          screen: checkWriterScreen,
          message:
            `screen-check-app-fault: issue #${ctx.issueNumber} — the harness ` +
            `opened ${checkWriterScreen ?? "(screen not stated)"}, it settled, ` +
            `and what it claimed to be showing does NOT match what the ` +
            `address asked for — ${harness.reason}. An app fault, not a wrong ` +
            `number. Recorded, not a stop.`,
        });
      }
      if (harness.verdict === "inconclusive") {
        return new ScreenCheckStopError({
          verdict: harness.verdict,
          postSha,
          screen: checkWriterScreen,
          message:
            `screen-check-inconclusive: issue #${ctx.issueNumber} — the ` +
            `harness ${whatItRan} with ${runner} and could not reach a ` +
            `confirmed result even after one re-run — ${harness.reason}. ` +
            `Recorded, not a stop.`,
        });
      }
      if (harness.verdict === "environment-fault") {
        // Finding #6 (2026-08-04 review, BLOCKER): sign-in, navigation, an
        // app 500, or a bare Playwright timeout failed BEFORE the check
        // ever reached a graded assertion — never a real builder-vs-check
        // content disagreement. Maps to the SAME stopped:could-not-grade
        // bucket as never-settled/inconclusive (loud, but does not add
        // needs-owner-decision) rather than the graded-mismatch branch
        // below, which used to be this verdict's silent default — see
        // GRADED_FIGURE_SENTINEL's own doc comment for the failure this
        // replaced.
        return new ScreenCheckStopError({
          verdict: harness.verdict,
          postSha,
          screen: checkWriterScreen,
          message:
            `screen-check-environment-fault: issue #${ctx.issueNumber} — the ` +
            `harness ${whatItRan} with ${runner} and the check failed before ` +
            `ever reaching a graded assertion — ${harness.reason}. This is an ` +
            (checkWriterCheckKind === "browser"
              ? `app/environment fault`
              : `toolchain/environment fault (the check crashed, failed to ` +
                `import, or collected no test at all — it never got as far as ` +
                `disagreeing with anything)`) +
            `, not a builder-vs-check disagreement. Recorded, not a stop.`,
        });
      }
      // graded-mismatch — the ONE verdict that is a genuine BUILDER-vs-CHECK
      // disagreement (the other three are app/environment faults, no
      // builder diff to weigh). Carries both sides, per Piece H: "the record
      // must carry both sides — what the check demanded, what the builder
      // produced, and the builder's own account of why it believes it is
      // right."
      //
      // `builderAccount` now PREFERS the builder's own words (issue #1128):
      // the implementer's `<rebuttal>` text, threaded down from the pipeline.
      // This comment used to say the implementer's output "is not threaded
      // this far down the call chain", and issue #1082 fault 3a is the bill
      // for that — a stop whose whole purpose is a human judgement handing
      // that human only one side. When the builder gave no rebuttal (the
      // common first-pass case) it falls back to the honest, available proxy
      // it always used: the reviewer, grading the builder's actual diff,
      // found no blockers on the pass that reached ALL_CLEAR. The fallback is
      // labelled as the reviewer's word, never passed off as the builder's.
      return new ScreenCheckStopError({
        verdict: harness.verdict,
        postSha,
        screen: checkWriterScreen,
        disagreement: {
          checkDemanded:
            `Check: ${checkWriterCheckCommand}\n` +
            `Runner: ${runner}\n` +
            `Screen: ${checkWriterScreen ?? "(not stated — this is a unit check)"}\n` +
            `Harness reading: ${harness.reason}`,
          builderProduced:
            `Shipped diff (${legPath}): ${shipDiff.changedFiles.length} file(s), ` +
            `${shipDiff.changedLines} line(s) — ` +
            `${shipDiff.changedFiles.slice(0, 20).join(", ") || "(no files recorded)"}`,
          builderAccount:
            builderAccount !== undefined && builderAccount.trim().length > 0
              ? `The builder's own words: ${builderAccount.trim()}`
              : `The builder gave no account of its own on the '${legPath}' ` +
                `pass (it raised no rebuttal). What the system can say instead ` +
                `is the reviewer's word, not the builder's: the reviewer ` +
                `certified ALL_CLEAR on that pass with no blockers outstanding.`,
        },
        message:
          `screen-check-graded-mismatch: issue #${ctx.issueNumber} — the ` +
          `harness ${whatItRan} with ${runner} and ` +
          (checkWriterCheckKind === "browser"
            ? // "the check disagreed", not "the figure did not match": since
              // 2026-09-01 this arm also carries a settled-then-plain-red run
              // (the nonce-keyed settled record proves the screen was
              // reached; the failing assertion was an ordinary `expect()`
              // before any graded helper). `harness.reason` says which shape
              // this one was.
              `it settled and the check's assertion disagreed with what it saw`
            : `a test body ran and an assertion disagreed with the shipped ` +
              `code`) +
          ` — ${harness.reason}. Recorded, not a stop.`,
      });
      })();
      // RECORDED, NOT A STOP (spec #1334). Everything above this line ran — the
      // check ran under its own runner, the figure or assertion was graded,
      // the receipt picture was taken and filed (browser route only), the
      // verdict is in telemetry. LOUD in the log (logError, not log — this is
      // the one outcome nobody can act on unless it is visible), recorded on
      // the issue body WITH both sides, and NOT labelled, NOT stopped. A
      // systemic verdict DOES raise an alarm here, rate-limited to one per run
      // — see `reportScreenCheckWatch`'s own alarm gate (2026-08-04 review,
      // blocker 1).
      // A TAMPERED TEST NEVER COUNTS (spec #1334). The builder edited its
      // own first test, the lock put the accepted copy back, and that copy
      // now fails on the builder's code. The reviewer approved against the
      // edited copy, so its pass proves nothing here: this is a red result on
      // the code, and it goes to the fixer like any other ship-gate failure —
      // a plain error, no new road. Only a graded mismatch counts as failing;
      // an environment fault says nothing about the code.
      if (protectedPaths.restoredFirstTest && harness.verdict === "graded-mismatch") {
        throw new Error(
          `first-test-red-after-restore: issue #${ctx.issueNumber} — the ` +
            `builder edited this ticket's own first test, the loop restored ` +
            `the accepted copy, and the restored test fails on the shipped ` +
            `code — ${harness.reason}. A tampered test never counts, so this ` +
            `ticket does not ship without its first test.`,
        );
      }
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] screen-check recorded — the check came ` +
          `back '${harness.verdict}'. A red screen check is recorded, not a ` +
          `stop, so this ticket ships. ${stopErr.message}`,
      );
      // The first test did not hold up at ship time, so this ticket ships on
      // the reviewer's pass alone — labelled `shipped-without-first-test` at
      // the ship moment below, like every other first-test fall-through.
      const redAtShip: FirstTestFallThrough = {
        reason: "red-at-ship",
        detail: stopErr.message,
      };
      await recordFirstTestFallThrough(ctx, redAtShip);
      ctx = { ...ctx, firstTestFellThrough: redAtShip };
      try {
        await ctx.deps.reportScreenCheckWatch?.(ctx.issueNumber, {
          verdict: harness.verdict,
          screen: checkWriterScreen,
          detail: stopErr.message,
          disagreement: stopErr.disagreement,
          wouldHaveStoppedAs: stopErr.stopReasonLabel,
        });
      } catch (e) {
        ctx.deps.logError(
          `reportScreenCheckWatch failed for issue #${ctx.issueNumber}: ` +
            `${(e as Error).message}`,
        );
      }
    } else {
      ctx.deps.log(
        `[issue=${ctx.issueNumber}] check matched ` +
          `(${CHECK_KIND_RUNNER_NAME[checkWriterCheckKind]}): ` +
          `${checkWriterScreen ?? checkWriterCheckCommand}` +
          `${harness.rerun ? " (after one re-run)" : ""}`,
      );
    }
  }
  void sandbox; // sandbox lifecycle handled by the caller's finally block
  // Issue F: annotate the terminal outcome with the prompt-leg path it took.
  // Emitted unconditionally (BEFORE the staging branch below) so it's visible
  // under both --staging and --no-staging.
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] shipped (marker=${finalMarker}) path=${legPath}`,
  );
  const summary = `[issue=${ctx.issueNumber}] shipped via sandcastle-loop (commit ${postSha}, branch ${ctx.issue.branch})`;
  // Under --no-staging (legacy), flip label → done immediately. Under staging
  // (default), keep the issue in `in-progress` until the merger lands it on
  // `integration-candidate`; the outer loop flips it to `merged-to-staging`
  // there, then to `done` after the post-merge fast-forward.
  if (!ctx.args.stagingEnabled) {
    // Fix 3: inline-CAS fence right before the --no-staging terminal.
    // markDone IS the ship here, so if this host lost its lease since acquire
    // (a failed heartbeat CAS) we must NOT mark done — defer instead. Flag OFF ⇒
    // fenceIssue returns true and this is a no-op. TOCTOU: a tiny window remains
    // between this CAS and markDone; per-host branches make a double-ship a
    // wasted end-of-run merge, not corruption.
    const fenced = await fenceBeforeShip(ctx);
    if (fenced) return fenced;
    // AFTER the fence, never before: a lease lost here means this host does
    // not ship the ticket at all, and labelling a ticket another host is
    // about to build would claim a build that never happened.
    await noteShippedWithoutFirstTest(ctx);
    await noteShippedWithOlderTestEdit(ctx);
    await noteShippedWithReviewNotes(ctx, reviewNotes);
    await ctx.deps.markDone(ctx.issueNumber, summary);
    // NOTE (Task B): the cross-host lane publish is intentionally NOT
    // here. markDone flips the label, but this iteration's code only reaches
    // `args.branch` via the Phase-3 batch merger, which runs AFTER every
    // per-issue pipeline. Publishing here would force-push a STALE launch-branch
    // tip missing the just-shipped commit. The --no-staging publish lives in
    // Phase 3, after the merger lands the work (mirrors the staging publish that
    // runs after fastForwardIntegration).
  } else {
    // #1198 A. Under staging the label transitions happen elsewhere and later
    // (`markMergedToStaging` in the merge phase, then
    // `promoteAllStagingToDone`), and neither of those sites has a `ctx`. The
    // fall-through label is a fact about the BUILD, not about the promotion,
    // so it lands HERE — the same moment the `--no-staging` route applies it
    // — rather than waiting for a merge phase that could fail and lose it.
    // Safe to apply while the issue still reads `in-progress`:
    // `shipped-without-first-test` is not a status label, so every later
    // `transitionLabel(n, "*", X)` leaves it exactly where it is.
    await noteShippedWithoutFirstTest(ctx);
    await noteShippedWithOlderTestEdit(ctx);
    await noteShippedWithReviewNotes(ctx, reviewNotes);
  }
  deferralCounts.delete(ctx.issueNumber);
  return { status: "ok", finalMarker, postSha, skillsInvoked };
}

/**
 * Record — on the ticket and in the telemetry row — that this build shipped
 * without a first test (#1198 A). A no-op on every ordinary ticket.
 *
 * Best-effort on the label, exactly like `applyStopLabel`: a `gh` hiccup must
 * not throw out of the ship funnel and quarantine finished, reviewed work
 * over a label. The telemetry half is set FIRST and unconditionally, so the
 * end-of-run report still says this ticket shipped on the weaker proof even
 * when GitHub could not be told.
 */
async function noteShippedWithoutFirstTest(ctx: PipelineCtx): Promise<void> {
  if (ctx.firstTestFellThrough === undefined) return;
  ctx.telemetry?.noteShippedWithoutFirstTest?.();
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] shipped WITHOUT a first test ` +
      `(${ctx.firstTestFellThrough.reason}) — the reviewer's pass alone ` +
      `(#1198). Labelling \`shipped-without-first-test\`.`,
  );
  try {
    await ctx.deps.markShippedWithoutFirstTest?.(ctx.issueNumber);
  } catch (e) {
    ctx.deps.logError(
      `markShippedWithoutFirstTest failed for issue #${ctx.issueNumber}: ` +
        `${(e as Error).message}. The merge is real; only the label saying ` +
        `its proof was weaker is missing.`,
    );
  }
}

/**
 * Record — on the ticket and in the telemetry row — what the APPROVING review
 * reported on its two report-only rows: a structure finding and/or a weak
 * first test. A no-op when it reported neither. Never a gate: best-effort on
 * each label, telemetry first, exactly like {@link noteShippedWithoutFirstTest}.
 */
async function noteShippedWithReviewNotes(
  ctx: PipelineCtx,
  notes: ReviewNotes,
): Promise<void> {
  const labels: { label: ReviewNoteLabel; text: string }[] = [];
  if (notes.structureFinding !== undefined) {
    labels.push({
      label: LABEL_SHIPPED_WITH_STRUCTURE_FINDING,
      text: notes.structureFinding,
    });
  }
  if (notes.weakFirstTest !== undefined) {
    labels.push({
      label: LABEL_SHIPPED_WITH_WEAK_FIRST_TEST,
      text: notes.weakFirstTest,
    });
  }
  if (labels.length === 0) return;
  ctx.telemetry?.noteReviewNotes?.(notes);
  for (const { label, text } of labels) {
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] the approving reviewer noted: ${text} — ` +
        `labelling \`${label}\` (never blocks).`,
    );
    try {
      await ctx.deps.markShippedWithReviewNote?.(ctx.issueNumber, label);
    } catch (e) {
      ctx.deps.logError(
        `markShippedWithReviewNote(${label}) failed for issue ` +
          `#${ctx.issueNumber}: ${(e as Error).message}. The merge is real; ` +
          `only the label is missing.`,
      );
    }
  }
}

/**
 * Record — on this ticket, on every OLDER ticket whose check it rewrote, and
 * in the telemetry row — that shipping this build required editing an older
 * ticket's loop-written test (#1271, spec #1334). A no-op on every ordinary
 * ticket.
 *
 * AT THE SHIP MOMENT, NEVER AT GATE TIME, and that is the whole placement
 * argument: an edit the gate allows can still fail a later ship-time check,
 * and then it sits on a branch nobody merges. Writing the record when the
 * edit was ALLOWED would tell a closed ticket its test had been rewritten when
 * in fact nothing of the sort reached `main`.
 *
 * Best-effort on both writes, exactly like {@link noteShippedWithoutFirstTest}:
 * a `gh` hiccup must not throw out of the ship funnel and quarantine
 * finished, reviewed work over a label or a comment-shaped body section. The
 * telemetry half is set FIRST and unconditionally, so the run's own records
 * still show the amendment even when GitHub could not be told.
 *
 * One write per DISTINCT older issue, not per file: one diff may edit
 * two files of the same older ticket, and that ticket wants one section
 * listing both — which is exactly what `buildOlderTestEditSection`
 * produces when handed the older ticket's number.
 */
async function noteShippedWithOlderTestEdit(
  ctx: PipelineCtx,
): Promise<void> {
  const amendment = ctx.olderTestEditRecord;
  if (amendment === undefined) return;
  ctx.telemetry?.noteOlderTestEditCount?.(amendment.files.length);
  // Display only (ADR 0015, "Rules for changing the loop"): did the ticket's
  // own claim-time body name the file in advance? Read with the loop's own
  // sections cut out, so a quoted stop report cannot count. Shown in the run
  // report.
  ctx.telemetry?.noteOlderTestEdits?.(
    amendment.files.map((f) => ({
      ...f,
      namedInTicket: namesPathInOwnerText(ctx.issueBody, f.path),
    })),
  );
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] shipped after amending ` +
      `${amendment.files.length} file(s) of another ticket's test under ` +
      `the older-test rules (the original failed on the new code; case ` +
      `count unchanged; nothing skipped): ` +
      `${amendment.paths.join(", ")}. Labelling ` +
      `\`shipped-with-sibling-check-amended\`.`,
  );
  try {
    await ctx.deps.markShippedWithOlderTestEdit?.(ctx.issueNumber);
  } catch (e) {
    ctx.deps.logError(
      `markShippedWithOlderTestEdit failed for issue ` +
        `#${ctx.issueNumber}: ${(e as Error).message}. The merge is real, and ` +
        `so is the amendment; only the label saying another ticket's test was ` +
        `rewritten is missing.`,
    );
  }
  const date = new Date().toISOString().slice(0, 10);
  const olderIssues = new Set(amendment.files.map((f) => f.issueNumber));
  for (const olderIssue of olderIssues) {
    try {
      const outcome = await ctx.deps.applyOlderTestEditRecord?.(
        olderIssue,
        ctx.issueNumber,
        buildOlderTestEditSection({ amendment, olderIssue, date }),
      );
      if (outcome === "already-present") {
        ctx.deps.log(
          `[issue=${ctx.issueNumber}] issue #${olderIssue} already carries ` +
            `this ticket's older-test edit record — leaving its body ` +
            `alone (#1271).`,
        );
      }
    } catch (e) {
      ctx.deps.logError(
        `applyOlderTestEditRecord(#${olderIssue}, by #${ctx.issueNumber}) ` +
          `failed: ${(e as Error).message}. The merge is real; only the note ` +
          `on the older ticket telling its owner the test was rewritten is ` +
          `missing.`,
      );
    }
  }
}

/**
 * Fix 3: fence a --no-staging ship. Runs the inline lease fence; on
 * success returns null (caller proceeds to markDone). On a lost lease, releases
 * the label back for re-claim and returns a `deferred` outcome the caller MUST
 * bubble up so the issue is neither merged nor marked done this round.
 */
async function fenceBeforeShip(ctx: PipelineCtx): Promise<IssueOutcome | null> {
  // Flag OFF ⇒ fenceIssue returns true (pass), and this is a no-op.
  if (await ctx.deps.fenceIssue(ctx.issueNumber)) return null;
  const msg =
    `[issue=${ctx.issueNumber}] lease lost at ship time (inline fence failed) — ` +
    `another host owns this issue now; deferring instead of marking done`;
  ctx.deps.logError(msg);
  try {
    await ctx.deps.release(ctx.issueNumber, msg);
  } catch (e) {
    ctx.deps.logError(
      `[issue=${ctx.issueNumber}] release after lost-lease fence failed: ${(e as Error).message}`,
    );
  }
  return { status: "deferred", finalMarker: "LEASE_LOST" };
}

/**
 * Drive a single issue through the full implement → review → (retry?) →
 * migrate → markDone pipeline. Caller wraps this in `claim` and is
 * responsible for converting our return value into ship/quarantine/error
 * counters.
 *
 * Retry ladder (when retryEnabled and escalations are configured):
 *   implementer (default) → reviewer (default) → fail → implementer
 *   (escalated, sees reviewer feedback, may rebut) → reviewer (escalated,
 *   sees rebuttal if any) → fail → quarantine.
 *
 * Migrations only apply on the ALL_CLEAR ship path. Any pipeline error goes
 * to the fixer, once; `--recovery off` switches the fixer off, and the error
 * then stops the ticket.
 */
/**
 * One build pass, as the review rounds read it — the builder's, the fixer's,
 * or the synthetic empty pass that stands for already-built work (spec
 * #1334, SG).
 */
interface BuildPass {
  readonly stdout: string;
  readonly commits: readonly { sha: string }[];
  readonly skillsInvoked: readonly string[];
  readonly certification: ImplementerOutputParsed | undefined;
}

/** The empty pass already-built work is reviewed with: no build ran, so
 *  there is no stdout, no commit, no skill record and no certification. */
const NO_BUILD_PASS: BuildPass = {
  stdout: "",
  commits: [],
  skillsInvoked: [],
  certification: undefined,
};

/** The proceed arm of the check-writer stage — everything the review rounds
 *  and the ship gate read about this ticket's first test. */
type CheckStageProceed = Extract<CheckWriterStageResult, { proceed: true }>;

/**
 * Why the review rounds ended without an `ALL_CLEAR`, carried whole so the
 * one place that stops the ticket (or hands it to the fixer) writes exactly
 * what the refusing site would have written.
 */
interface ReviewRefusal {
  readonly postSha: string;
  /** The last reviewer's own marker, e.g. `HAS_BLOCKERS`. */
  readonly finalMarker: string;
  /** The last reviewer's whole output — the fixer's brief. */
  readonly lastReviewStdout: string;
  /** The `quarantine` reason line. */
  readonly reason: string;
  /** The stop label and the body section. */
  readonly stop: { readonly label: StopReasonLabel; readonly detail: string };
}

type ReviewRoundsResult =
  | {
      readonly kind: "approved";
      readonly ctx: PipelineCtx;
      readonly ship: ShipAfterMigrationsInput;
    }
  | {
      /**
       * The reviewer confirmed, on its FIRST look and with no build run, that
       * work the test-writer called already built really is in the code.
       * Nothing was built, so nothing ships: the caller closes the ticket as
       * done instead.
       */
      readonly kind: "confirmed-already-built";
      readonly ctx: PipelineCtx;
      readonly postSha: string;
    }
  | {
      readonly kind: "refused";
      readonly ctx: PipelineCtx;
      readonly refusal: ReviewRefusal;
    };

/** The three names, phases and ship paths of one role's rounds. */
const REVIEW_ROUND_NAMES = {
  builder: {
    reviews: ["reviewer", "reviewer-retry", "reviewer-retry-2"],
    legPaths: ["first-pass-only", "critique-retry", "implementer-retry"],
    fixPhase: "implementer-retry",
    reviewPhase: "reviewer",
  },
  fixer: {
    reviews: ["fixer-reviewer", "fixer-reviewer-retry", "fixer-reviewer-retry-2"],
    legPaths: ["fixer", "fixer", "fixer"],
    fixPhase: "recovery",
    reviewPhase: "recovery",
  },
} as const satisfies Record<
  "builder" | "fixer",
  {
    reviews: readonly [string, string, string];
    legPaths: readonly [PromptLegPath, PromptLegPath, PromptLegPath];
    fixPhase: string;
    reviewPhase: string;
  }
>;

/**
 * THE REVIEW ROUNDS (spec #1334, SG) — review, then up to two fix-and-review
 * rounds, the third granted only on progress. Extracted out of
 * `runIssuePipeline` so the builder and the fixer get the SAME rounds under
 * the SAME rules: the same first-test rewrite on a `WRONG-CHECK`, the same
 * retry eligibility, the same third-round grant (`decideThirdRound`).
 *
 * Never ships and never stops. It returns either the ship-gate input for
 * the pass the reviewer approved, or the refusal; the caller ships through
 * `shipAfterMigrations` or hands the refusal on. That keeps ONE ship funnel
 * for both roles — the fixer's work gets the certificate check, the test
 * re-run and the migration apply the old rescue road skipped.
 *
 * `situation` is set when no build pass ran before the first review: the
 * work was resumed finished from a saved checkpoint, or the test-writer
 * said it is already built. The first reviewer is told so; its refusal is
 * the brief for an ordinary build round.
 */
async function runReviewRounds(
  sb: SandboxHandle,
  ctxIn: PipelineCtx,
  opts: {
    readonly role: "builder" | "fixer";
    readonly preSha: string;
    readonly checkStage: CheckStageProceed;
    readonly firstPass: BuildPass;
    readonly postSha: string;
    readonly situation?: ReviewSituation;
    /** Why the fixer was called — folded into its refusal stop. */
    readonly fixerWhy?: string;
    readonly dispatchFix: (
      attemptNumber: 2 | 3,
      feedback: string,
    ) => Promise<BuildPass>;
  },
): Promise<ReviewRoundsResult> {
  let ctx = ctxIn;
  const { role, preSha, checkStage } = opts;
  const names = REVIEW_ROUND_NAMES[role];
  let postSha = opts.postSha;
  /** The first test every round and the ship gate use: the check stage's,
   *  or — once a rewrite has PROVED itself — the rewritten one. Read off
   *  `ctx` each time, so a rewrite proved in the builder's rounds also binds
   *  the fixer's. */
  const firstTest = (): FirstTest =>
    currentFirstTest(checkStage, ctx.rewrittenFirstTest);
  const evidence = (): {
    checkWriterCheckPath?: string;
    checkWriterCheckCommand?: string;
    checkWriterScreen?: string;
    checkWriterFallThrough?: FirstTestFallThrough;
  } => ({
    checkWriterCheckPath: firstTest().checkPath,
    checkWriterCheckCommand: firstTest().checkCommand,
    checkWriterScreen: firstTest().screen,
    // Read off `ctx`, not the check stage: a first-test rewrite the reviewer
    // could not settle marks the ticket as having no first test mid-rounds,
    // and every later reviewer must be told its pass is the only gate.
    checkWriterFallThrough: ctx.firstTestFellThrough,
  });
  const shipInput = (
    pass: BuildPass,
    legPath: PromptLegPath,
    builderAccount: string,
    approvingReviewStdout: string,
  ): ShipAfterMigrationsInput => {
    const test = firstTest();
    return {
      preSha,
      postSha,
      finalMarker: "ALL_CLEAR",
      reviewNotes: readReviewNotes(approvingReviewStdout),
      skillsInvoked: pass.skillsInvoked,
      legPath,
      // Deliberately the PRE-rewrite marker: `shipAfterMigrations` reads it
      // only for its CLASS, which a rewrite never changes.
      checkWriterMarker: checkStage.marker,
      checkWriterCheckCommand: test.checkCommand,
      checkWriterScreen: test.screen,
      // `?? "browser"` is the OLD POSITIONAL DEFAULT, written where it can be
      // read (issue #1227).
      checkWriterCheckKind: test.checkKind ?? "browser",
      // Issue #1128: the builder's own words, if it gave any.
      builderAccount,
      checkLocation: test.checkLocation,
      checkWriterCheckPackage: test.checkPackage,
      // Issue #871, repair 3: the certification for the approved pass.
      implementerCertification: pass.certification,
      checkTestCount: test.checkTestCount,
    };
  };
  const refused = (
    marker: string,
    stdout: string,
    path: ReviewerRefusalPath,
    opts2: { why?: string; rewroteThenRefused?: boolean },
  ): ReviewRoundsResult => {
    const fixerPath = role === "fixer";
    const stop = reviewerRefusedExplanation({
      marker,
      path: fixerPath ? "recovery-review" : path,
      why: fixerPath ? opts.fixerWhy : opts2.why,
    });
    const reason = fixerPath
      ? `[issue=${ctx.issueNumber}] the fixer's reviewer marked ${marker}` +
        (opts2.rewroteThenRefused
          ? ` again after the first test's one rewrite`
          : "") +
        ` — the fixer's rounds are spent; quarantining.`
      : path === "no-retry-available"
        ? `[issue=${ctx.issueNumber}] reviewer marked ${marker}` +
          (opts2.rewroteThenRefused
            ? ` again after the first test's one rewrite`
            : "") +
          ` — quarantining (${opts2.why ?? ""}).`
        : path === "implementer-retry"
          ? `[issue=${ctx.issueNumber}] reviewer marked ${marker} after ` +
            `the third review — quarantining. path=implementer-retry`
          : `[issue=${ctx.issueNumber}] reviewer marked ${marker} after ` +
            `the second review — quarantining. path=critique-retry`;
    return {
      kind: "refused",
      ctx,
      refusal: {
        postSha,
        finalMarker: marker,
        lastReviewStdout: stdout,
        reason,
        stop: {
          label: stop.label,
          detail: opts2.rewroteThenRefused
            ? `${stop.detail}\n\nThe reviewer said this ticket's first ` +
              `test was wrong; it was rewritten once, and the reviewer ` +
              `refused the code again.`
            : stop.detail,
        },
      },
    };
  };

  // ROUND 1. First-pass escalation: a substantial or sensitive-path change
  // gets the stronger reviewer model on pass 1 — one strong pass beats a
  // cheap miss. Small, ordinary diffs keep the cheap default.
  ctx.status.setIssuePhase(ctx.issueNumber, names.reviewPhase);
  const review1Decision = decideFirstPassReviewerModel(ctx, postSha);
  const review1Model = review1Decision.model;
  // The diff measurement falls out of the escalation decision above, which
  // already ran `git diff --numstat`. Absent (never zeroed) when nothing was
  // measured; the helper guards it.
  recordDiffMeasurement(ctx, review1Decision.diff);
  if (review1Model !== undefined) {
    ctx.telemetry?.noteReviewerEscalated(review1Model);
  }
  const review1 = await runReviewer(sb, ctx, postSha, undefined, review1Model, {
    ...(role === "fixer" ? { name: names.reviews[0] } : {}),
    skillsInvoked: opts.firstPass.skillsInvoked,
    certification: opts.firstPass.certification,
    situation: opts.situation,
    ...evidence(),
  });
  if (review1.marker === "ALL_CLEAR") {
    if (opts.situation?.kind === "already-built") {
      return { kind: "confirmed-already-built", ctx, postSha };
    }
    return {
      kind: "approved",
      ctx,
      ship: shipInput(
        opts.firstPass,
        names.legPaths[0],
        extractRebuttal(opts.firstPass.stdout),
        review1.stdout,
      ),
    };
  }

  // Reviewer round 1 marked HAS_BLOCKERS. Decide retry vs stop.
  const implEscalations = roleModelsFor(ctx.args).implementer.escalations;
  const revEscalations = roleModelsFor(ctx.args).reviewer.escalations;
  const retryEligibility = decideRetryEligibility({
    retryEnabled: ctx.args.retryEnabled,
    implementerEscalations: implEscalations.length,
    reviewerEscalations: revEscalations.length,
  });

  // SPEC #1334: before a fix round is spent, the host reads the reviewer's
  // own GROUNDS line. A `WRONG-CHECK` — this ticket's own first test
  // contradicts the ticket and the code is right — buys the test its one
  // rewrite, because a fix round would rewrite the side that was right. It
  // applies even under `--no-retry`, which disables the BUILD rounds, not the
  // test's rewrite.
  const eligibility = wrongCheckRewriteEligibility({
    reviewStdout: review1.stdout,
    ownTest: ownFirstTestState(ctx, checkStage.checkLocation),
  });
  const firstOutcome =
    eligibility.kind === "rewrite"
      ? await rewriteFirstTestOnce(sb, ctx, {
          reason: eligibility.reason,
          reviewStdout: review1.stdout,
          preSha,
          postSha,
          reviewerModel: review1Model,
          skillsInvoked: opts.firstPass.skillsInvoked,
          certification: opts.firstPass.certification,
          where: `${names.reviews[0]} refusal`,
        })
      : eligibility;
  if (firstOutcome.kind === "proved") {
    postSha = firstOutcome.postSha;
    // The REWRITTEN identity, never `checkStage.*`'s pre-rewrite one — the
    // rewrite may not share the old file's runner or command.
    ctx = { ...ctx, rewrittenFirstTest: firstOutcome.rewrittenCheck };
    return {
      kind: "approved",
      ctx,
      ship: shipInput(
        opts.firstPass,
        names.legPaths[0],
        extractRebuttal(opts.firstPass.stdout),
        firstOutcome.reReview.stdout,
      ),
    };
  }
  if (firstOutcome.kind === "dropped") {
    // The test and the code still disagree, and the reviewer passed the
    // code: the ticket ships on that pass alone, labelled
    // `shipped-without-first-test`.
    postSha = firstOutcome.postSha;
    ctx = { ...ctx, firstTestFellThrough: firstOutcome.fellThrough };
    return {
      kind: "approved",
      ctx,
      ship: shipInput(
        opts.firstPass,
        names.legPaths[0],
        extractRebuttal(opts.firstPass.stdout),
        firstOutcome.reReview.stdout,
      ),
    };
  }
  // The fix round's brief is the LATEST refusal: the re-review when the
  // first test's rewrite was refused again, the first review otherwise.
  let latest = review1;
  const rewroteThenRefused = firstOutcome.kind === "second-refusal";
  if (firstOutcome.kind === "second-refusal") {
    postSha = firstOutcome.postSha;
    latest = firstOutcome.reReview;
    if (firstOutcome.fellThrough !== undefined) {
      ctx = { ...ctx, firstTestFellThrough: firstOutcome.fellThrough };
    }
    // A PROVED rewrite is this ticket's first test from here on: the next
    // review rounds and the ship gate use it, never the original.
    if (firstOutcome.rewrittenCheck !== undefined) {
      ctx = { ...ctx, rewrittenFirstTest: firstOutcome.rewrittenCheck };
    }
  }
  if (!retryEligibility.canRetry) {
    return refused(latest.marker, latest.stdout, "no-retry-available", {
      why: retryEligibility.why,
      rewroteThenRefused,
    });
  }

  // ROUND 2: fix (escalated, with the reviewer's feedback). The worktree is
  // NOT reset — the pass sees its own commits and either appends a fix on top
  // OR emits a <rebuttal> instead of code.
  ctx.status.setIssuePhase(ctx.issueNumber, names.fixPhase, "attempt 2");
  // A genuine retry: round 2 exists only because round 1 was rejected.
  if (role === "builder") ctx.runCounters?.bump("implementerRetries");
  const pass2 = await opts.dispatchFix(2, latest.stdout);
  const rebuttal2 = extractRebuttal(pass2.stdout);
  postSha = sb.worktreePath
    ? await ctx.deps.captureSha(sb.worktreePath)
    : (pass2.commits[pass2.commits.length - 1]?.sha ?? postSha);
  // Reviewer round 2 (escalated). A rebuttal is passed in; the reviewer
  // always has the final word.
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] running ${names.reviews[1]} on ` +
      `${revEscalations[0]}${rebuttal2 ? " (with a rebuttal)" : ""}`,
  );
  ctx.status.setIssuePhase(ctx.issueNumber, names.reviewPhase, "attempt 2");
  const review2 = await runReviewer(sb, ctx, postSha, undefined, revEscalations[0], {
    implementerRebuttal: rebuttal2,
    name: names.reviews[1],
    skillsInvoked: pass2.skillsInvoked,
    certification: pass2.certification,
    ...evidence(),
  });
  if (review2.marker === "ALL_CLEAR") {
    return {
      kind: "approved",
      ctx,
      ship: shipInput(pass2, names.legPaths[1], rebuttal2, review2.stdout),
    };
  }

  // ROUND 3 GRANT. Round 2 still says HAS_BLOCKERS, but if every category
  // round 1 flagged was resolved, round 2's findings are genuinely new and
  // the work is making progress — grant one more fix-and-review round.
  // Recurring findings still bounce: the pass is stuck. A malformed sweep
  // must NEVER produce a free extra round.
  const sweepLogError = (msg: string): void =>
    ctx.deps.logError(`[issue=${ctx.issueNumber}] CATEGORY SWEEP duplicate: ${msg}`);
  const sweep1 = extractCategorySweep(review1.stdout, sweepLogError);
  const sweep2 = extractCategorySweep(review2.stdout, sweepLogError);
  // Two mutually-exclusive grant bases (issue #1211): round 1's findings were
  // all cleared, OR round 1 named nothing readable and round 2 names a fresh,
  // stated finding. Round 2 must be readable in both.
  const round1Cleared =
    sweep2 !== null && sweep1 !== null && priorFindingsResolved(sweep1, sweep2);
  const freshLatestFinding =
    sweep2 !== null && latestSweepEarnsRound3(sweep1, sweep2);
  const thirdRound = decideThirdRound({ round1Cleared, freshLatestFinding });
  if (!thirdRound.grant) {
    const reason = thirdAttemptDenyReason(sweep1, sweep2);
    // AN UNREADABLE SWEEP IS ITS OWN VISIBLE OUTCOME (owner decision on issue
    // #1082): the INSTRUMENT failed, not the code, so it goes to logError.
    // The channel is chosen off the reason the deny actually turned on.
    if (reason.startsWith(SWEEP_UNREADABLE_REASON_PREFIX)) {
      ctx.deps.logError(`[issue=${ctx.issueNumber}] round-3 grant withheld — ${reason}`);
    } else {
      ctx.deps.log(`[issue=${ctx.issueNumber}] round-3 grant denied: ${reason}`);
    }
    return refused(review2.marker, review2.stdout, "critique-retry", {});
  }

  // ROUND 3: the final fix-and-review round.
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] ${names.reviews[1]} HAS_BLOCKERS but ` +
      `${thirdRound.basis} — granting round 3`,
  );
  ctx.status.setIssuePhase(ctx.issueNumber, names.fixPhase, "attempt 3");
  // The round-3 grant — also a retry.
  if (role === "builder") ctx.runCounters?.bump("implementerRetries");
  const pass3 = await opts.dispatchFix(3, review2.stdout);
  const rebuttal3 = extractRebuttal(pass3.stdout);
  postSha = sb.worktreePath
    ? await ctx.deps.captureSha(sb.worktreePath)
    : (pass3.commits[pass3.commits.length - 1]?.sha ?? postSha);
  ctx.deps.log(
    `[issue=${ctx.issueNumber}] running ${names.reviews[2]} on ` +
      `${revEscalations[0]}${rebuttal3 ? " (with a rebuttal)" : ""}`,
  );
  ctx.status.setIssuePhase(ctx.issueNumber, names.reviewPhase, "attempt 3");
  const review3 = await runReviewer(sb, ctx, postSha, undefined, revEscalations[0], {
    implementerRebuttal: rebuttal3,
    name: names.reviews[2],
    skillsInvoked: pass3.skillsInvoked,
    certification: pass3.certification,
    ...evidence(),
  });
  if (review3.marker === "ALL_CLEAR") {
    return {
      kind: "approved",
      ctx,
      ship: shipInput(pass3, names.legPaths[2], rebuttal3, review3.stdout),
    };
  }
  return refused(review3.marker, review3.stdout, "implementer-retry", {});
}

/**
 * The work the test-writer called already built, CONFIRMED by the reviewer
 * on its first look with nothing built (spec #1334, SG): close the ticket as
 * done. Never handed to the owner.
 *
 * Nothing was built, so nothing merges — the outcome carries
 * {@link ALREADY_BUILT_CONFIRMED_MARKER}, which keeps this ticket's empty
 * branch out of the merge batch exactly as the #1110 case-2 close does, and
 * the lease is handed back for the same reason.
 */
async function closeConfirmedAlreadyBuilt(
  ctx: PipelineCtx,
  postSha: string,
): Promise<IssueOutcome> {
  const summary =
    `[issue=${ctx.issueNumber}] the test-writing AI found this ticket's ` +
    `change already in the code, and the reviewer confirmed it against the ` +
    `ticket. Nothing was built; closing as done.`;
  ctx.deps.log(summary);
  await ctx.deps.markDone(ctx.issueNumber, summary);
  await ctx.deps.releaseIssueLease(ctx.issueNumber);
  deferralCounts.delete(ctx.issueNumber);
  return { status: "ok", finalMarker: ALREADY_BUILT_CONFIRMED_MARKER, postSha };
}

/**
 * THE FIXER (spec #1334, SG) — the ONE pass any failure hands a ticket to: a
 * review refusal after the builder's rounds, a failed ship-time check, a
 * time-out. It replaced the old recovery pass and its own rescue ship road.
 *
 *   1. One fix pass on the builder's prompt, briefed with what went wrong.
 *   2. The builder's same review rounds (`runReviewRounds`) — up to three
 *      reviews, under the same third-round rule.
 *   3. On approval, the ORDINARY ship gate (`shipAfterMigrations`), so the
 *      fixer's work gets the certificate check, the test re-run and the
 *      migration apply.
 *
 * Returns the outcome when the fixer shipped or its reviewer refused it to
 * the end (a stop). THROWS when anything inside it threw; the caller turns
 * that into the attempt's one stop. Either way there is never a second
 * fixer: the caller calls this once.
 */
async function runFixer(
  sb: SandboxHandle,
  ctxIn: PipelineCtx,
  opts: {
    readonly preSha: string;
    readonly checkStage: CheckStageProceed;
    /** What failed, for the fixer's brief and its stop. */
    readonly failure: string;
    /** The last refusing review, when the trigger was a refusal. */
    readonly lastReview?: string;
  },
): Promise<IssueOutcome> {
  let ctx = ctxIn;
  const diagnosis = diagnoseHaltCause(opts.failure);
  if (diagnosis) {
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] diagnose: ${diagnosis.cause} — hinting the fixer`,
    );
  }
  const brief = [
    `What went wrong: ${opts.failure.slice(0, 2000)}`,
    ...(diagnosis ? [`Likely cause: ${diagnosis.hint}`] : []),
    ...(opts.lastReview !== undefined
      ? ["", "The last review, verbatim:", opts.lastReview]
      : []),
  ].join("\n");
  const first: BuildPass = await runImplementer(sb, ctx, {
    role: "fixer",
    attemptNumber: 1,
    fixerBrief: brief,
    requiredSkills: ctx.requiredSkills,
  });
  const postSha = sb.worktreePath
    ? await ctx.deps.captureSha(sb.worktreePath)
    : (first.commits[first.commits.length - 1]?.sha ?? opts.preSha);
  const rounds = await runReviewRounds(sb, ctx, {
    role: "fixer",
    preSha: opts.preSha,
    checkStage: opts.checkStage,
    firstPass: first,
    postSha,
    fixerWhy:
      `the builder did not get the ticket through (${opts.failure.slice(0, 200)}), ` +
      `the fixer was handed the work with the same three review rounds, and ` +
      `the reviewer still refused`,
    dispatchFix: (attemptNumber, feedback) =>
      runImplementer(sb, ctx, {
        role: "fixer",
        attemptNumber,
        reviewerFeedback: feedback,
        requiredSkills: ctx.requiredSkills,
      }),
  });
  ctx = rounds.ctx;
  // The fixer passes no `situation`, so its rounds never confirm work as
  // already built; the arm is here only to keep the switch whole.
  if (rounds.kind === "confirmed-already-built") {
    return await closeConfirmedAlreadyBuilt(ctx, rounds.postSha);
  }
  if (rounds.kind === "approved") {
    return await shipAfterMigrations(ctx, sb, rounds.ship);
  }
  const { refusal } = rounds;
  ctx.deps.logError(refusal.reason);
  deferralCounts.delete(ctx.issueNumber);
  await ctx.deps.quarantine(ctx.issueNumber, refusal.reason);
  await reportStopBestEffort(ctx, refusal.stop.label, refusal.stop.detail);
  return {
    status: "quarantined",
    finalMarker: refusal.finalMarker,
    postSha: refusal.postSha,
  };
}

/**
 * Stop a ticket that leaves a product question open (spec #1334 fix pass):
 * `stopped:ticket-unclear` + `needs-human`, with the agent's exact question
 * written onto the issue body. The ONE producer of this stop besides the
 * missing-target check: the test-writing AI or the builder answered
 * `TICKET_UNCLEAR`. Never charged to the retry budget — it is the owner's
 * question, not a loop failure.
 */
async function stopTicketUnclear(
  ctx: PipelineCtx,
  opts: {
    readonly question: string;
    readonly stage: TicketUnclearStage;
    readonly postSha: string;
    /** Who asked, for the run log. */
    readonly who: string;
  },
): Promise<IssueOutcome> {
  deferralCounts.delete(ctx.issueNumber);
  const stop = ticketUnclearExplanation({ reason: opts.question, stage: opts.stage });
  ctx.deps.logError(
    `[issue=${ctx.issueNumber}] ticket-unclear: ${opts.who} says the ticket ` +
      `leaves a product question open — stopping for the owner. Question: ` +
      `${opts.question.slice(0, 500)}`,
  );
  try {
    await ctx.deps.quarantine(
      ctx.issueNumber,
      `[issue=${ctx.issueNumber}] ${opts.who} answered TICKET_UNCLEAR — the ` +
        `ticket leaves a product question open.`,
      { stopLabel: stop.label },
    );
  } catch (e) {
    ctx.deps.logError(`quarantine failed: ${(e as Error).message}`);
    return { status: "error", finalMarker: "TICKET_UNCLEAR", postSha: opts.postSha };
  }
  await reportStopBestEffort(ctx, stop.label, stop.detail);
  return { status: "quarantined", finalMarker: "TICKET_UNCLEAR", postSha: opts.postSha };
}

/**
 * The typed ship-gate stops that are genuine ENVIRONMENT faults: a frozen
 * file the run could not restore, and a graded run on the wrong database.
 * Each quarantines with its own label straight away — a fix pass cannot
 * settle either — and, like every stop, is charged to the retry budget.
 * Returns `undefined` for every other error. Shared by the builder's road
 * and the fixer's, so a stop thrown out of the fixer's own ship is labelled
 * exactly as the builder's would be.
 */
async function typedShipStop(
  ctx: PipelineCtx,
  err: unknown,
): Promise<IssueOutcome | undefined> {
  // The protected-path lock refused to ship a tampered diff (issue
  // #909/#914, Pieces C/H). All four sub-cases are the SAME
  // `stopped:checks-tampered` label; the split survives only in the message.
  if (err instanceof ProtectedPathTamperStopError) {
    deferralCounts.delete(ctx.issueNumber);
    ctx.deps.logError(err.message);
    try {
      await ctx.deps.quarantine(ctx.issueNumber, err.message);
    } catch (e) {
      ctx.deps.logError(`quarantine failed: ${(e as Error).message}`);
      return { status: "error", finalMarker: "HALT", postSha: err.postSha };
    }
    await reportStopBestEffort(ctx, err.stopReasonLabel, err.message);
    return {
      status: "quarantined",
      finalMarker: "HALT",
      postSha: err.postSha,
    };
  }
  // A finished diff that owed more proof than it offered, or deleted test
  // coverage (`ProofDemandUnsatisfiedStopError`), is deliberately NOT here:
  // that is a fault in the work, which the fixer can mend, so it reaches the
  // fixer like any other failure (spec #1334).
  // The GRADED run could not be proven to have used this job's own database
  // clone (issue #1025) — a deterministic wiring fault a fix pass cannot fix.
  if (err instanceof WrongTestDatabaseStopError) {
    deferralCounts.delete(ctx.issueNumber);
    ctx.deps.logError(err.message);
    try {
      await ctx.deps.quarantine(ctx.issueNumber, err.message);
    } catch (e) {
      ctx.deps.logError(`quarantine failed: ${(e as Error).message}`);
      return { status: "error", finalMarker: "HALT", postSha: err.postSha };
    }
    await reportStopBestEffort(ctx, err.stopReasonLabel, err.message, err.disagreement);
    return {
      status: "quarantined",
      finalMarker: "HALT",
      postSha: err.postSha,
    };
  }
  return undefined;
}

async function runIssuePipeline(ctx: PipelineCtx): Promise<IssueOutcome> {
  let sandbox: SandboxHandle | undefined;
  let preSha = "";
  // The settled check-writer stage, hoisted out of the try block so the
  // catch can hand it to the fixer: a `const` declared inside `try` is not
  // visible in `catch`.
  let checkStageState: CheckStageProceed | undefined;
  /**
   * Set once the try body starts handling the builder's refused review
   * rounds. Anything that handling throws — the fixer's own escapes included
   * — skips the catch's arms and propagates, so a refusal can never reach a
   * second fixer through the catch.
   */
  let handlingRefusal = false;

  // What the fixer needs about this ticket's first test. When the pipeline
  // failed before the check-writer stage settled, there is no first test:
  // the fixer proceeds as a ticket with none, marked so (the reviewer's
  // pass is then its only gate, and it ships labelled accordingly).
  const fixerCheckStage = async (failure: string): Promise<CheckStageProceed> => {
    if (checkStageState !== undefined) return checkStageState;
    const fellThrough: FirstTestFallThrough = {
      reason: "run-fault",
      detail:
        `The test-writing step never finished — the run failed before it ` +
        `settled (${failure.slice(0, 300)}). The fixer built and the ` +
        `reviewer judged this ticket with no first test.`,
    };
    await recordFirstTestFallThrough(ctx, fellThrough);
    ctx = { ...ctx, firstTestFellThrough: fellThrough };
    return {
      proceed: true,
      ctx,
      preSha,
      marker: "NO_SCREEN_APPLIES",
      withoutFirstTest: fellThrough,
    };
  };

  // Shared helper: try to defer the issue (release label, return "deferred"
  // status). Returns the outcome on success, null on budget exhaustion or
  // release failure (caller should fall through to quarantine). Bounded by
  // MAX_DEFERRALS — after that, real quarantine.
  //
  // `causeMsg` is the error that actually motivated the defer — pass it
  // explicitly so the release comment points the operator at the right
  // failure (the pipeline-level path passes errMsg; the fixer-throw path
  // passes the fixer's own thrown message).
  const tryDefer = async (
    kind: string,
    causeMsg: string,
    // Marker recorded on the deferred outcome. Defaults to the transient
    // marker; the output-token-cap path passes a distinct one so the cause
    // stays recognizable instead of being conflated with a 5xx/rate-limit.
    deferMarker: string = "TRANSIENT_ERROR",
  ): Promise<IssueOutcome | null> => {
    const c = (deferralCounts.get(ctx.issueNumber) ?? 0) + 1;
    if (c > MAX_DEFERRALS) {
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] exceeded MAX_DEFERRALS (${MAX_DEFERRALS}) — escalating to quarantine`,
      );
      deferralCounts.delete(ctx.issueNumber);
      return null;
    }
    deferralCounts.set(ctx.issueNumber, c);
    const deferReason =
      `[sandcastle-defer] [issue=${ctx.issueNumber}] ${kind} ` +
      `(attempt ${c}/${MAX_DEFERRALS}) — released for retry next iteration: ` +
      `${causeMsg.slice(0, 400)}`;
    ctx.deps.log(deferReason);
    try {
      await ctx.deps.release(ctx.issueNumber, deferReason);
      return { status: "deferred", finalMarker: deferMarker };
    } catch (releaseErr) {
      ctx.deps.logError(
        `[issue=${ctx.issueNumber}] release failed: ${(releaseErr as Error).message} — falling through to quarantine`,
      );
      return null;
    }
  };

  // Hand the ticket to the fixer, once, and turn anything the fixer itself
  // throws into the attempt's ONE stop. A fixer failure ends the attempt:
  // it is never handed to a second fixer. Called from two places: the
  // builder's refused review rounds (in the try body) and the catch. The stop's label is the note the
  // retry budget's ledger shows for this attempt.
  const fixOrStop = async (
    sb: SandboxHandle,
    trigger: {
      readonly failure: string;
      readonly lastReview?: string;
      readonly postSha?: string;
      readonly stalled: boolean;
    },
  ): Promise<IssueOutcome> => {
    ctx.status.setIssuePhase(ctx.issueNumber, "recovery");
    ctx.telemetry?.noteRecovery();
    ctx.runCounters?.bump("recoveries");
    ctx.deps.log(
      `[issue=${ctx.issueNumber}] handing the ticket to the fixer — ` +
        `${trigger.failure.slice(0, 200)}`,
    );
    const checkStage = await fixerCheckStage(trigger.failure);
    // A fixer failure ends the attempt AND saves the work (spec #1334 fix
    // pass): with cross-host sync on, the ticket's next attempt resumes from
    // its WIP ref instead of starting over (sync off: kept locally for
    // recovery by hand — see `saveWorkToWipRef`). Best-effort — a save that fails is logged, never a
    // second failure.
    const saveFixerWork = async (): Promise<void> => {
      if (sb.worktreePath === undefined || ctx.deps.saveFailedWork === undefined) return;
      const saved = await ctx.deps.saveFailedWork(sb.worktreePath, ctx.issueNumber);
      const line =
        `[issue=${ctx.issueNumber}] the fixer's work ${saved.saved ? "was" : "could NOT be"} ` +
        `saved for the next attempt — ${saved.detail}`;
      if (saved.saved) ctx.deps.log(line);
      else ctx.deps.logError(line);
    };
    try {
      const fixed = await runFixer(sb, ctx, {
        preSha,
        checkStage,
        failure: trigger.failure,
        lastReview: trigger.lastReview,
      });
      if (fixed.status === "quarantined") await saveFixerWork();
      return fixed;
    } catch (fixErr) {
      if (fixErr instanceof TicketUnclearError) {
        return await stopTicketUnclear(ctx, {
          question: fixErr.question,
          stage: "while-building",
          postSha: sb.worktreePath ? await ctx.deps.captureSha(sb.worktreePath) : preSha,
          who: "the fixer",
        });
      }
      const typed = await typedShipStop(ctx, fixErr);
      if (typed !== undefined) return typed;
      const fixMsg = (fixErr as Error).message;
      // Mirror the builder's defer policy: a vendor blip, an output-token
      // cap or a reviewer that never gave a verdict inside the fixer defers
      // the ticket instead of spending a stop on it — none of the three is a
      // judgement on the work.
      if (isTransientError(fixMsg)) {
        ctx.deps.log(
          `[issue=${ctx.issueNumber}] the fixer threw transient (${JSON.stringify(fixMsg)}) — deferring instead of quarantining`,
        );
        const deferred = await tryDefer("fixer threw transient", fixMsg);
        if (deferred) return deferred;
      } else if (isOutputCapError(fixMsg)) {
        const deferred = await tryDefer(
          "fixer hit the output-token cap",
          fixMsg,
          "OUTPUT_TOKEN_CAP",
        );
        if (deferred) return deferred;
      } else if (fixErr instanceof MarkerNotFoundError) {
        const deferred = await tryDefer("fixer's reviewer gave no verdict", fixMsg, "NO_VERDICT");
        if (deferred) return deferred;
      }
      deferralCounts.delete(ctx.issueNumber);
      await saveFixerWork();
      const reason =
        `[issue=${ctx.issueNumber}] the fixer failed: ${fixMsg.slice(0, 400)} ` +
        `(it was called because: ${trigger.failure.slice(0, 200)})`;
      ctx.deps.logError(reason);
      try {
        await ctx.deps.quarantine(ctx.issueNumber, reason);
        const stop = runFaultExplanation({
          errorMessage:
            `The fixer failed: ${fixMsg.slice(0, 1500)}\n\n` +
            `It had been handed the ticket because: ${trigger.failure.slice(0, 500)}`,
          verdictFlags: "fixer=failed",
        });
        await reportStopBestEffort(ctx, stop.label, stop.detail);
        return {
          status: "quarantined",
          finalMarker: "HALT",
          ...(trigger.postSha !== undefined ? { postSha: trigger.postSha } : {}),
          stalled: trigger.stalled || STALL_RE.test(fixMsg),
        };
      } catch (e) {
        ctx.deps.logError(`quarantine failed: ${(e as Error).message}`);
        return { status: "error", finalMarker: "HALT", stalled: trigger.stalled };
      }
    }
  };

  try {
    // #1143 / #1106 ruling 3 — "No target, no dispatch." A server-only ticket
    // (it aims at no screen) whose subject does not exist gives the
    // check-writer nothing to aim at: it guesses, writes a check that passes
    // against broken code, and the ticket dies at stopped:no-failing-check
    // having built nothing — a whole build cycle bought for nothing. Catch it
    // HERE, before a sandbox is even spun up, so no money is spent. A missing
    // target is a person's fault (#914 disposal), so it goes to a human and is
    // not re-queued by the loop. The stop reaches the ticket BODY (#914/#1105:
    // the run log is wiped nightly, so a comment would not survive).
    //
    // Fail-open when the body could not be read (`ctx.issueBody` undefined — a
    // gh fetch failure degrades it): a guard cannot prove a target is missing
    // from a body it never saw, and must not stop on a guess.
    if (ctx.issueBody !== undefined) {
      const targetAudit = auditServerTarget(ctx.issueBody);
      if (targetAudit.shouldStop) {
        const stop = ticketUnclearExplanation({
          reason:
            `This is a server-only ticket — it aims at no screen — and its ` +
            `body is missing the target block the check-writer aims at. ` +
            `Missing: ${targetAudit.missingServerTargets.join(", ")}. Add the ` +
            `three lines "Call this", "Called by" and "Expect this" (see ` +
            `docs/reference/target-block.md), or, if the subject already ` +
            `exists, record that on the \`Target:\` receipt line.`,
          stage: "before-any-code",
        });
        ctx.deps.logError(
          `[issue=${ctx.issueNumber}] no target block on a server-only ticket ` +
            `— refusing before the check-writer runs (#1143). Missing: ` +
            `${targetAudit.missingServerTargets.join(", ")}.`,
        );
        await ctx.deps.quarantine(
          ctx.issueNumber,
          `[issue=${ctx.issueNumber}] server-only ticket has no target block; ` +
            `refused before dispatch (#1143).`,
          // #1150: `ticketUnclearExplanation` is an owner-decision stop → the
          // missing-target ticket goes to a human, needs-human not quarantine.
          { stopLabel: stop.label },
        );
        await reportStopBestEffort(ctx, stop.label, stop.detail);
        return { status: "quarantined", finalMarker: "HALT", postSha: "" };
      }
    }

    sandbox = await ctx.deps.createSandbox({
      branch: ctx.issue.branch,
      implementerModel: ctx.args.implementerModel,
    });
    preSha = sandbox.worktreePath
      ? await ctx.deps.captureSha(sandbox.worktreePath)
      : "";

    // Phase 1: the check-writer (issue #911, Piece D) — before the
    // implementer ever runs. Settles on one of the four allowed outcomes.
    // Since spec #1334 SG the only thing that ends the ticket here is an
    // `ALREADY_BUILT` whose work is certified on the staging branch (it closes
    // with the run's pull request); every other already-built answer goes to
    // the reviewer with no build pass (`skipBuild`), and every way the first
    // test fails to come out good FALLS THROUGH, dispatches the builder, and
    // lets the reviewer's pass be the gate. A PROCEED result may advance
    // `ctx`/`preSha` — see
    // `runCheckWriterStage`'s own doc comment for why.
    const checkStage = await runCheckWriterStage(sandbox, ctx, preSha);
    if (!checkStage.proceed) return checkStage.outcome;
    ctx = checkStage.ctx;
    preSha = checkStage.preSha;
    checkStageState = checkStage;

    // Phase 2a: the first build pass — or none at all, when the check-writer
    // stage found the work already built (spec #1334, SG): finished saved
    // work resumed from a checkpoint, or a change the test-writer read in the
    // code. Either way the next step is the REVIEWER, never a fresh build.
    let firstPass: BuildPass;
    let postSha: string;
    if (checkStage.skipBuild !== undefined) {
      ctx.deps.log(
        `[issue=${ctx.issueNumber}] ${
          checkStage.skipBuild.kind === "resumed-built"
            ? "resumed finished work from a checkpoint"
            : "the test-writer says this change is already built"
        } — sending it straight to review, no build pass`,
      );
      firstPass = NO_BUILD_PASS;
      postSha = sandbox.worktreePath
        ? await ctx.deps.captureSha(sandbox.worktreePath)
        : preSha;
    } else {
      ctx.status.setIssuePhase(ctx.issueNumber, "implementer");
      const impl1 = await runImplementer(sandbox, ctx, {
        attemptNumber: 1,
        requiredSkills: ctx.requiredSkills,
      });
      firstPass = impl1;
      postSha = sandbox.worktreePath
        ? await ctx.deps.captureSha(sandbox.worktreePath)
        : (impl1.commits[impl1.commits.length - 1]?.sha ?? "");
    }

    // Phase 2b: the review rounds (review, then up to two fix rounds). Note:
    // migrations are deferred until AFTER ALL_CLEAR — only the final accepted
    // SQL hits the dev DB, never the intermediate state of a refused pass.
    const implEscalations = roleModelsFor(ctx.args).implementer.escalations;
    const sb = sandbox;
    const rounds = await runReviewRounds(sb, ctx, {
      role: "builder",
      preSha,
      checkStage,
      firstPass,
      postSha,
      situation: checkStage.skipBuild,
      dispatchFix: async (attemptNumber, feedback) => {
        const model = escalationForAttempt(implEscalations, attemptNumber);
        ctx.deps.log(
          `[issue=${ctx.issueNumber}] reviewer refused — fix round ` +
            `${attemptNumber} on ${model}`,
        );
        return await runImplementer(sb, ctx, {
          attemptNumber,
          model,
          reviewerFeedback: feedback,
          requiredSkills: ctx.requiredSkills,
        });
      },
    });
    ctx = rounds.ctx;
    if (rounds.kind === "confirmed-already-built") {
      return await closeConfirmedAlreadyBuilt(ctx, rounds.postSha);
    }
    if (rounds.kind === "approved") {
      return await shipAfterMigrations(ctx, sandbox, rounds.ship);
    }
    // Refused to the end. Not an error: no defer, no error-class bookkeeping
    // — either the fixer takes it, or it stops with the refusal's own words.
    handlingRefusal = true;
    const { refusal } = rounds;
    if (ctx.args.recoveryEnabled) {
      return await fixOrStop(sandbox, {
        failure:
          `the reviewer refused the builder's work after its review rounds ` +
          `(${refusal.finalMarker})`,
        lastReview: refusal.lastReviewStdout,
        postSha: refusal.postSha,
        stalled: false,
      });
    }
    deferralCounts.delete(ctx.issueNumber);
    await ctx.deps.quarantine(ctx.issueNumber, refusal.reason);
    await reportStopBestEffort(ctx, refusal.stop.label, refusal.stop.detail);
    return {
      status: "quarantined",
      finalMarker: refusal.finalMarker,
      postSha: refusal.postSha,
    };
  } catch (err) {
    if (handlingRefusal) throw err;
    const errMsg = (err as Error).message;
    // Stuck-abort with ZERO committed work (loop-cost ticket 03, checkbox 3).
    // runImplementer throws a typed StuckError here rather than the generic
    // "implementer made no commits" so this arm can quarantine IMMEDIATELY and
    // RETURN — a stuck-abort that produced nothing has no partial work for the
    // fixer to finish, and a fixer pass would re-run a spinning session.
    if (err instanceof StuckError) {
      deferralCounts.delete(ctx.issueNumber);
      const reasonCode = "stuck-abort-no-commits";
      const reason =
        `[issue=${ctx.issueNumber}] ${reasonCode}: ` +
        `stuck-abort with no committed work — quarantining ` +
        `(stuck-detector aborted a spinning implementer that produced no commits).`;
      ctx.deps.logError(reason);
      try {
        await ctx.deps.comment(
          ctx.issueNumber,
          `**Stuck-detector aborted the implementer with no committed work**\n\n` +
            `The docker stuck-detector safety net (loop-cost ticket 03) aborted a spinning implementer session, but nothing was committed, so there is no partial work to review. Quarantining instead of wasting a fixer pass. Re-queue (\`ready-for-agent\`) after checking why the implementer spun (a repeated identical tool call, e.g. polling a command).`,
        );
      } catch (e) {
        ctx.deps.logError(
          `${reasonCode} comment failed: ${(e as Error).message}`,
        );
      }
      try {
        await ctx.deps.quarantine(ctx.issueNumber, reason);
        // Issue #923: comment stays; label added. Shares `stopped:run-fault`
        // with the pipeline catch-all: to whoever triages, both mean the same
        // thing — nothing about the ticket needs changing, put it back.
        await applyStopLabelBestEffort(ctx, stuckNoCommitsExplanation());
        return { status: "quarantined", finalMarker: "HALT" };
      } catch (e) {
        ctx.deps.logError(
          `${reasonCode} quarantine failed: ${(e as Error).message}`,
        );
        return { status: "error", finalMarker: "HALT" };
      }
    }
    // The builder named a product question the ticket leaves open: a stop
    // for the owner, never the fixer (spec #1334 fix pass).
    if (err instanceof TicketUnclearError) {
      return await stopTicketUnclear(ctx, {
        question: err.question,
        stage: "while-building",
        postSha: sandbox?.worktreePath
          ? await ctx.deps.captureSha(sandbox.worktreePath)
          : preSha,
        who: "the builder",
      });
    }
    // The typed ship-gate stops: each one quarantines with its own label —
    // see `typedShipStop`.
    const typedStop = await typedShipStop(ctx, err);
    if (typedStop !== undefined) return typedStop;

    // THE FIXER (spec #1334, SG) is available when the run allows it and a
    // sandbox exists to fix in. It runs at most ONCE per attempt: the
    // refused-rounds call in the try body never reaches this catch
    // (`handlingRefusal`), and the fixer's own failures are caught inside
    // `fixOrStop`, never re-thrown into here.
    const fixerAvailable = ctx.args.recoveryEnabled && sandbox !== undefined;

    const transientVerdict = isTransientError(errMsg);
    // Output-token-cap detection: the model's response hit the max-output
    // ceiling and surfaced as an error. Distinct from transient (it's not a
    // vendor blip) and from a code-level halt (the work may be fine, just too
    // long). Deferred with a bounded budget so a re-run with the raised
    // CLAUDE_CODE_MAX_OUTPUT_TOKENS default (or a naturally shorter response)
    // can succeed, instead of the silent generic quarantine it used to get.
    const outputCapVerdict = !transientVerdict && isOutputCapError(errMsg);
    // Stall detection: surface "the sandbox stopped responding" failures
    // distinctly from "the spec was bad" failures so runMain can pause
    // the loop after a streak (sandbox-level problem, not code-level).
    // Pattern lives in STALL_RE (lib/error-classification.ts) — see its
    // definition for which error messages count.
    const stalled = STALL_RE.test(errMsg);
    // No-verdict detection: a Haiku gate (the pre-merge reviewer) ran
    // out of turns and its single-shot same-model retry ALSO produced no
    // marker, so extractMarker threw MarkerNotFoundError. This is neither a
    // vendor blip nor a code-level rejection — the gate simply never verdicted.
    // Defer (release for a fresh iteration) with a distinct marker, bounded by
    // MAX_DEFERRALS; on exhaustion it falls through to real quarantine.
    const noVerdictVerdict = err instanceof MarkerNotFoundError;
    ctx.deps.log(
      `[isTransientError-audit] issue=${ctx.issueNumber} verdict=${transientVerdict} stalled=${stalled} noVerdict=${noVerdictVerdict} outputCap=${outputCapVerdict} msg=${JSON.stringify(errMsg)}`,
    );
    // A `false` member leaves its bucket ABSENT rather than writing a 0 that
    // would claim "measured, never happened" (see RunCounters.noteErrorClass).
    ctx.runCounters?.noteErrorClass({
      transient: transientVerdict,
      stalled,
      noVerdict: noVerdictVerdict,
      outputCap: outputCapVerdict,
    });
    ctx.deps.logError(`[issue=${ctx.issueNumber}] pipeline error: ${errMsg}`);

    // Every pooled account is out (tokenmaxxing build plan 4.5). Nothing can
    // succeed until an allowance resets, so this is not a failure of the
    // ticket: release it WITHOUT spending its MAX_DEFERRALS budget (that budget
    // is what parked good tickets overnight), and close the run's gate so no
    // worker is dealt another ticket until the soonest reset.
    if (transientVerdict) {
      const allowance = ctx.deps.poolAllowance ?? REAL_ALLOWANCE_CLOCK;
      const wait = await allowanceWait(errMsg, {
        nowMs: allowance.now(),
        readAuthFiles: allowance.readAuthFiles,
      });
      if (wait !== null) {
        ctx.allowanceGate?.close(wait);
        const reason =
          `[sandcastle-defer] [issue=${ctx.issueNumber}] ${wait.detail}. ` +
          `Released for retry after ${new Date(wait.untilMs).toISOString()}; ` +
          `not counted against MAX_DEFERRALS.`;
        ctx.deps.log(reason);
        try {
          await ctx.deps.release(ctx.issueNumber, reason);
          return { status: "deferred", finalMarker: "POOL_EMPTY" };
        } catch (releaseErr) {
          ctx.deps.logError(
            `[issue=${ctx.issueNumber}] release failed: ${(releaseErr as Error).message} — falling through to the ordinary transient handling`,
          );
        }
      }
    }

    // Defer transient failures (rate-limit OR upstream 5xx) back to
    // ready-for-agent so the next iteration retries. Without this, a brief
    // Anthropic outage could quarantine many issues that would succeed on
    // retry.
    if (transientVerdict) {
      const deferred = await tryDefer("transient error", errMsg);
      if (deferred) return deferred;
      // fall through to quarantine on budget exhaustion or release failure
    }

    // Defer an output-token-cap failure with a DISTINCT marker so it never
    // disappears into a generic quarantine (audit #2). Bounded by the same
    // MAX_DEFERRALS budget; on exhaustion it falls through to a quarantine
    // whose reason still names the cap cause via the reason string below.
    if (outputCapVerdict) {
      const deferred = await tryDefer(
        "output-token-cap error",
        errMsg,
        "OUTPUT_TOKEN_CAP",
      );
      if (deferred) return deferred;
      // fall through to quarantine on budget exhaustion or release failure
    }

    // Defer a persistent no-verdict (the reviewer gate ran out of turns
    // and its same-model retry also emitted no marker) with a DISTINCT marker
    // so it never disappears into a generic quarantine. Bounded by the same
    // MAX_DEFERRALS budget; on exhaustion it falls through to a quarantine
    // below. A no-verdict is not a code-level halt, so — like the transient /
    // output-cap paths — it must not consume the fixer (guarded below).
    if (noVerdictVerdict) {
      const deferred = await tryDefer("no verdict", errMsg, "NO_VERDICT");
      if (deferred) return deferred;
      // fall through to quarantine on budget exhaustion or release failure
    }

    // Every other failure — a time-out, a failed ship-time check (lint,
    // tests, migrations), a builder that crashed — goes to the fixer. Never
    // on a transient, output-cap or no-verdict error: those already deferred
    // above, and a fix pass would only hit the same wall.
    if (
      fixerAvailable &&
      sandbox !== undefined &&
      !transientVerdict &&
      !outputCapVerdict &&
      !noVerdictVerdict
    ) {
      return await fixOrStop(sandbox, { failure: errMsg, stalled });
    }

    // Issue is heading to quarantine — clear any stale defer counter so a
    // future un-quarantine + re-claim starts fresh at attempt 1/MAX_DEFERRALS,
    // not partway through the budget.
    deferralCounts.delete(ctx.issueNumber);
    const reason = `[issue=${ctx.issueNumber}] pipeline halted (transientVerdict=${transientVerdict}, outputCapVerdict=${outputCapVerdict}, noVerdictVerdict=${noVerdictVerdict}): ${errMsg.slice(0, 400)}`;
    try {
      await ctx.deps.quarantine(ctx.issueNumber, reason);
      // Issue #923, unrecorded site 4 of 4 — the catch-all. Anything the
      // pipeline throws with no arm of its own landed here and wrote
      // nothing onto the ticket at all.
      const stopHalt = runFaultExplanation({
        errorMessage: errMsg.slice(0, 2000),
        verdictFlags:
          `transientVerdict=${transientVerdict}, ` +
          `outputCapVerdict=${outputCapVerdict}, ` +
          `noVerdictVerdict=${noVerdictVerdict}`,
      });
      await reportStopBestEffort(ctx, stopHalt.label, stopHalt.detail);
      return {
        status: "quarantined",
        finalMarker: "HALT",
        stalled,
      };
    } catch (e) {
      ctx.deps.logError(`quarantine failed: ${(e as Error).message}`);
      return { status: "error", finalMarker: "HALT", stalled };
    }
  } finally {
    if (sandbox) {
      // Issue #1260: this ticket is finished, so release the worktree lock
      // taken when its sandbox was created. THIS is the moment the ticket
      // stops being in flight — there is one sandbox per TICKET, not per
      // role, so the lock has been protecting the same worktree across the
      // check-writer, the builder and the reviewer, and nothing needs it now.
      //
      // Load-bearing, not tidiness: the SDK's own `close()` ends with
      // `git worktree remove --force` on a clean tree
      // (`@ai-hero/sandcastle/dist/index.js`), and git REFUSES that on a
      // locked worktree while swallowing the error. Skip this unlock and
      // every finished ticket leaves its worktree and its lock on disk, where
      // the later `cleanupIssueBranch` cannot remove them either.
      unlockOwnWorktree(ctx.args.repoRoot, ctx.issue.branch, runGit);
      try {
        await sandbox.close();
      } catch (err) {
        ctx.deps.logError(`sandbox.close() threw: ${(err as Error).message}`);
      }
    }
  }
}

/**
 * Ship-time accounting for ONE issue's pipeline outcome. The single call
 * site for this (the accounting loop in `runMain`) is the ONLY place an
 * issue's phase/outcome is written the instant its pipeline resolves — see
 * the comment there for why per-issue, not batch-end.
 *
 * An "ok" outcome is NOT yet the truth for either merge mode: staging still
 * has to land it on `integration-candidate` and fast-forward `args.branch`;
 * `--no-staging` still has to run the batch merger (Phase 3, after every
 * pipeline in the batch resolves). Recording it "merged" here would let the
 * dashboard claim work shipped that can still fail to land — under staging,
 * for up to a full promotion cycle; under `--no-staging`, for up to a full
 * batch (the merger doesn't start until every sibling's pipeline resolves).
 * So an "ok" outcome is deferred into `deferredOkOutcomes` and finalized by
 * `finalizeMergedAccounting` once the responsible merge step actually
 * resolves — for BOTH modes.
 *
 * Every other outcome (`quarantined` | `deferred` | `error`) is already
 * terminal at ship time — nothing downstream can undo it — so it records
 * immediately. This is the ONLY status-store phase/outcome write for an
 * issue in this iteration for that outcome; `recordOutcome` bumps
 * `status.totals` and appends a `status.history` row, so a second call for
 * the same issue would double-count both.
 *
 * The #1110 case-2 auto-close (`ALREADY_BUILT_ON_STAGING`) is an "ok" outcome
 * that is ALSO terminal at ship time: its code was already certified on
 * `integration-candidate` by a prior run, and `selectMergeBatch` deliberately
 * keeps it OUT of the merge batch — so no merge step, and no
 * `finalizeMergedAccounting`, will ever drain its deferred outcome. Deferring
 * it would strand it in the "merge" phase for the life of the run and leave
 * `status.totals` short by one. So it records immediately, keyed on the same
 * marker `selectMergeBatch` excludes on, so the two cannot drift.
 */
export function shipTimeAccounting(
  statusStore: StatusStore,
  issueNumber: number,
  outcome: IssueOutcome,
  deferredOkOutcomes: Map<number, Parameters<StatusStore["recordOutcome"]>[1]>,
): void {
  if (
    outcome.status === "ok" &&
    !builtNothing(outcome.finalMarker)
  ) {
    statusStore.setIssuePhase(issueNumber, "merge");
    deferredOkOutcomes.set(issueNumber, outcome);
  } else {
    statusStore.recordOutcome(issueNumber, outcome);
  }
}

/**
 * Terminal merged-accounting for a batch of issues whose code has actually
 * landed — a staging promotion whose fast-forward succeeded, OR (per
 * `shipTimeAccounting` above) a `--no-staging` batch merger that succeeded.
 * For each issue, record the outcome `shipTimeAccounting` withheld at ship
 * time.
 *
 * `failedPromotions` is a staging-only concept (a FF that landed the code
 * but whose GitHub label flip/close failed) — for any such issue, do NOT
 * silently record it merged: that would leave it in `merge` limbo (never
 * counted merged, never flagged) while its GitHub state is stale (still
 * open / `merged-to-staging`) and a human must finish it. Flag it
 * needs-human so the dashboard surfaces it instead of reading as normal
 * queued work. `--no-staging` has no separate promotion step (the label
 * flip already happened per-issue inside `runIssuePipeline`), so its caller
 * always passes an empty array here.
 */
export function finalizeMergedAccounting(
  statusStore: StatusStore,
  mergedIssueNums: readonly number[],
  deferredOkOutcomes: Map<number, Parameters<StatusStore["recordOutcome"]>[1]>,
  failedPromotions: readonly number[],
  branch: string,
): void {
  const failedToPromote = new Set(failedPromotions);
  for (const n of mergedIssueNums) {
    if (failedToPromote.has(n)) {
      statusStore.setIssuePhase(
        n,
        "needs-human",
        `shipped to ${branch} but GitHub promotion (label flip/close) failed — finish it by hand`,
      );
      continue;
    }
    statusStore.recordOutcome(n, deferredOkOutcomes.get(n) ?? { status: "ok" });
  }
}

/**
 * The `--limit` gh `issue list` cap used by `listOpenIssuesWithBodies`
 * (gh.ts). A returned page of exactly this many rows may be truncated, so the
 * startup WIP prune treats `length >= this` as an INCOMPLETE open set and
 * refuses to prune (never risk a dropped open issue's live WIP ref).
 */
// Raised 100 -> 500 alongside LABEL_SHIPPED_LOCAL: issues now stay OPEN until
// a human merges the run PR, so the open set grows monotonically. At the old
// cap this repo (already 84 open) would cross it and silently disable the
// startup WIP-ref prune. Keep in sync with the `--limit` in
// `listOpenIssuesWithBodies` (gh.ts) — the planning road compares the row
// count against this constant to decide the listing may be missing rows.
const GH_OPEN_ISSUE_LIST_LIMIT = 500;

/**
 * Cleanup hook 1 (SHIP-PATH). Once an issue's code has reached the
 * integration branch it has SHIPPED, so its `refs/sandcastle/wip/issue-<N>`
 * checkpoint is now stale — left in place it could resurrect merged work the
 * next time that issue number is reused. Best-effort delete each merged issue's
 * WIP ref.
 *
 * Gated on `syncEnabled`: WIP refs only exist when cross-host sync is ON, so
 * with the flag OFF this is a no-op that touches NO origin (no push), keeping
 * the flag-off path byte-for-byte unchanged. Every delete is best-effort — a
 * fault is logged LOUD-but-non-fatal (mirroring publishLaneOrLog / status sync
 * swallowing a LaneSyncError) and NEVER crashes the loop, since the code has
 * already shipped and a lingering ref is a hygiene issue the startup prune (hook
 * 2) also sweeps.
 */
export async function cleanupShippedWipRefs(
  mergedIssueNums: readonly number[],
  syncEnabled: boolean,
  repoRoot: string,
  git: GitRunner,
  logError: (msg: string) => void,
): Promise<void> {
  if (!syncEnabled) return;
  for (const n of mergedIssueNums) {
    try {
      const res = await deleteWipRef(repoRoot, n, git);
      if (!res.ok) {
        logError(
          `[wip-cleanup] failed to delete WIP ref for shipped issue #${n}: ` +
            `${res.stderr.trim() || "git push :wip failed"} — a stale ` +
            `${wipRef(n)} may resurrect merged work on a later reuse; delete ` +
            `it by hand with \`git push origin :${wipRef(n)}\``,
        );
      }
    } catch (err) {
      logError(
        `[wip-cleanup] error deleting WIP ref for shipped issue #${n}: ` +
          `${(err as Error).message}`,
      );
    }
  }
}

/**
 * Cleanup hook 2 (STARTUP PRUNE, safety net). Enumerate the WIP
 * refs on origin and delete only those whose issue is NO LONGER OPEN
 * (closed/merged) — a stale ref left by an issue that shipped without the
 * ship-path hook firing (e.g. the loop was killed post-merge).
 *
 * SAFETY INVARIANT: a checkpoint-stopped issue stays OPEN (ready-for-agent or
 * in-progress) precisely so it can resume from its WIP ref. Deleting a live
 * issue's WIP ref is data loss. So we prune ONLY issues ABSENT from the current
 * OPEN-issue set (`openIssueNums`) — every open issue, ready OR in-progress,
 * incl. a checkpoint-stopped one flipped back to ready, is KEPT. A failed
 * `ls-remote` yields `[]` (listWipRefIssues) so we never prune on a partial
 * view of the remote.
 *
 * CRITICAL: the open-issue set comes from `gh issue list --limit 100`, which
 * SILENTLY TRUNCATES when a repo has ≥100 open issues (gh.ts). An open issue
 * dropped by that cap would look "closed" here and its LIVE WIP ref would be
 * wrongly pruned — data loss. So the caller passes `openListComplete=false`
 * whenever the list may be truncated, and we SKIP the entire prune in that
 * case (Hook 1 still cleans the normal ship path; stale refs merely linger
 * until the repo drops below the cap). Never trade a possibly-live ref for
 * hygiene.
 *
 * Gated on `syncEnabled`: with the flag OFF this is a no-op touching NO origin
 * (no ls-remote, no push). Each delete is best-effort and logged non-fatally.
 */
export async function pruneStaleWipRefs(
  syncEnabled: boolean,
  openIssueNums: readonly number[],
  openListComplete: boolean,
  repoRoot: string,
  git: GitRunner,
  log: (msg: string) => void,
  logError: (msg: string) => void,
): Promise<void> {
  if (!syncEnabled) return;
  if (!openListComplete) {
    logError(
      `[wip-prune] open-issue list may be truncated (hit the gh --limit cap) — ` +
        `SKIPPING stale-WIP prune this startup so a live issue's WIP ref is ` +
        `never deleted on an incomplete open set (hook 1 still cleans the ship path)`,
    );
    return;
  }
  const open = new Set(openIssueNums);
  let wipIssues: readonly number[];
  try {
    wipIssues = await listWipRefIssues(repoRoot, git);
  } catch (err) {
    logError(
      `[wip-prune] ls-remote of the WIP namespace failed: ${(err as Error).message} ` +
        `— skipping stale-WIP prune this startup (no refs touched)`,
    );
    return;
  }
  for (const n of wipIssues) {
    // SAFETY: an OPEN issue (ready or in-progress, incl. checkpoint-stopped)
    // MUST keep its WIP ref so it can resume. Prune ONLY closed/merged issues.
    if (open.has(n)) continue;
    try {
      const res = await deleteWipRef(repoRoot, n, git);
      if (!res.ok) {
        logError(
          `[wip-prune] failed to delete stale WIP ref ${wipRef(n)} for ` +
            `closed/merged issue #${n}: ${res.stderr.trim() || "git push :wip failed"}`,
        );
      } else {
        log(`[wip-prune] deleted stale WIP ref for closed/merged issue #${n}`);
      }
    } catch (err) {
      logError(
        `[wip-prune] error deleting stale WIP ref for issue #${n}: ` +
          `${(err as Error).message}`,
      );
    }
  }
}

/**
 * Publish this host's lane ref (Task B) after it advanced the launch
 * branch, logging a LOUD-but-non-fatal message on a real push fault. Callers
 * gate on the opt-in flag; `context` names the ship path (e.g. "promoting
 * staging") for the failure message. A {@link LaneSyncError} is swallowed after
 * logging (code did not reach origin, but the loop keeps running); any other
 * error rethrows.
 */
async function publishLaneOrLog(
  deps: Deps,
  branch: string,
  context: string,
): Promise<void> {
  try {
    await deps.publishLane(branch);
  } catch (err) {
    if (err instanceof LaneSyncError) {
      deps.logError(
        `[lane] PUBLISH FAILED for ${branch} after ${context}: this host's ` +
          `code did NOT reach origin, so a peer host cannot see it. Fix ` +
          `\`gh auth setup-git\` / network connectivity. git stderr: ${err.stderr}`,
      );
    } else {
      throw err;
    }
  }
}

/**
 * SHUTDOWN reconciliation — the mirror image of the STARTUP reconciliation
 * inside {@link runMain} (which releases orphaned `in-progress` labels left by
 * a prior killed run). This one runs on the way DOWN, on a genuine stop
 * (SIGINT/SIGTERM) only, and releases the `in-progress` labels this host is
 * still holding so the ops dashboard — which reads GitHub labels, not
 * `status.json` — stops showing stopped work as "being built now".
 *
 * WHY IT IS NEEDED AT ALL, given startup already reconciles: startup only runs
 * when the loop is launched again. Between a 16:11 stop and the next launch the
 * board keeps claiming those tickets are in flight — hours of a lie the operator
 * then has to undo by hand (observed 2026-08-05 on #803/#838/#839/#840).
 *
 * TWO INDEPENDENT OWNERSHIP GUARDS, because releasing someone else's issue is
 * far worse than leaving a stale label:
 *
 *   1. `claimed` — the issues THIS run flipped to `in-progress` itself. A label
 *      this host never applied is never touched here (startup reconciliation,
 *      which runs under the single-instance lock, owns that case).
 *   2. the LIVE-lease check, verbatim from startup reconciliation: with the
 *      cross-host lease ON, an issue may have been re-claimed by a peer while
 *      we were stopping, and yanking its label mid-work is exactly the theft
 *      startup refuses to commit.
 *
 * It also re-reads the CURRENT `in-progress` set rather than trusting `claimed`
 * alone: most claimed issues have long since moved to `done`/`needs-human`, and
 * `releaseViaLabel` would happily put `ready-for-agent` back on one of those and
 * hand the next run a ticket whose code already shipped.
 *
 * BEST-EFFORT, ALWAYS: it never throws and never masks the real exit. Every
 * failure degrades to the status quo — the label stays, and the next launch's
 * startup reconciliation clears it.
 */
export async function releaseHeldLabelsOnShutdown(opts: {
  readonly deps: Pick<
    Deps,
    "release" | "listIssuesByLabel" | "leaseState" | "log" | "logError"
  >;
  /** Issues THIS run claimed (`ready-for-agent` → `in-progress`). */
  readonly claimed: ReadonlySet<number>;
  /** Mirrors `crossHostLeaseEnabled()`: gates the live-peer guard, as startup does. */
  readonly leaseEnabled: boolean;
}): Promise<void> {
  const { deps, claimed, leaseEnabled } = opts;
  if (claimed.size === 0) return;
  let mine: readonly { number: number; title: string }[];
  try {
    const inProgress = await deps.listIssuesByLabel("in-progress");
    mine = inProgress.filter((i) => claimed.has(i.number));
  } catch (err) {
    deps.logError(
      `shutdown reconciliation skipped: listIssuesByLabel failed: ` +
        `${(err as Error).message} — any in-progress label this host still ` +
        `holds is left as-is (the next launch's startup reconciliation clears it)`,
    );
    return;
  }
  if (mine.length === 0) {
    deps.log(`shutdown reconciliation: no in-progress labels left by this host`);
    return;
  }
  deps.log(
    `shutdown reconciliation: ${mine.length} issue(s) this host still holds on ` +
      `in-progress — releasing back to ready-for-agent`,
  );
  for (const issue of mine) {
    try {
      // Same guard, same wording as startup reconciliation. NOTE the call
      // ORDER at the call site: this runs AFTER `releaseAllLeases()`, so our
      // OWN leases are already gone and anything still reading `live` here
      // genuinely belongs to a peer.
      if (leaseEnabled) {
        const st = await deps.leaseState(issue.number);
        if (st === "live") {
          deps.log(
            `  skipping #${issue.number}: lease is LIVE — another host is working it; leaving in-progress`,
          );
          continue;
        }
        deps.log(
          `  #${issue.number} lease ${st} — safe to release for re-claim`,
        );
      }
      await deps.release(
        issue.number,
        `[sandcastle shutdown-reconcile] the loop working this issue was stopped ` +
          `(SIGINT/SIGTERM) before the issue reached a terminal state — released ` +
          `so the next run re-claims it instead of the board showing it in flight`,
      );
      deps.log(`  released #${issue.number}: ${issue.title}`);
    } catch (err) {
      deps.logError(
        `  failed to release #${issue.number}: ${(err as Error).message} — leaving as-is, the next launch's startup reconciliation will clear it`,
      );
    }
  }
}

// ---------------------------------------------------------------------------
// Outer loop
// ---------------------------------------------------------------------------

/** One issue's finished pipeline, ready to merge — `landTicket`'s input shape. */
type Completed = { issue: PlanIssue; outcome: IssueOutcome };

/**
 * Drive the orchestrator. Returns a structured result instead of calling
 * `process.exit` so tests can assert.
 *
 * Production CLI entry calls this then exits with the result's `exitCode`.
 */
export async function runMain(
  args: SandcastleArgs,
  deps: Deps,
): Promise<RunMainResult> {
  // Point every host-side `gh` call at the managed repo, not the launch cwd, so
  // a `--repo-root` other than cwd resolves correctly (see configureGh). Set
  // first, before the startup reconciliation issues its first `gh issue list`.
  configureGh({ cwd: args.repoRoot });

  // Every stop label (issue #914's five, issue #923's four) must actually
  // exist on GitHub
  // before any ticket can stop and try to apply one — `gh issue edit
  // --add-label` 404s on an absent label; `gh` never invents one. Idempotent
  // (`gh label create --force`) and best-effort: one label's create/update
  // failure is logged, never fatal — a token missing the `repo` scope must
  // not abort the whole run over label plumbing that only matters at the
  // (rare) moment a ticket actually stops.
  if (!args.dryRun) {
    await ensureStopLabelsExist({
      onError: (name, err) =>
        deps.logError(
          `ensureStopLabelsExist(${name}) failed: ${(err as Error).message}`,
        ),
    });
    // The four `verdict:*` labels (issue #1117), for the same reason and on
    // the same terms: the verdict lives in the issue BODY, but the label is
    // what makes "how often was the check the wrong one" one query instead
    // of a walk over every ticket the run ever stopped.
    await ensureVerdictLabelsExist({
      onError: (name, err) =>
        deps.logError(
          `ensureVerdictLabelsExist(${name}) failed: ${(err as Error).message}`,
        ),
    });
    await ensureCheckReadingLabelsExist({
      onError: (name, err) =>
        deps.logError(
          `ensureCheckReadingLabelsExist(${name}) failed: ` +
            `${(err as Error).message}`,
        ),
    });
    // `shipped-without-first-test` (#1198 A), on the same terms. It is the
    // ONE owner-visible signal that a merge went through on the reviewer's
    // pass alone, and `markShippedWithoutFirstTest` applies it with
    // `gh issue edit --add-label`, which errors when the label is absent —
    // an error its caller swallows best-effort. Without this line the signal
    // vanishes silently on any host where nobody created the label by hand
    // (#1198 review, S4).
    await ensureShippedWithoutFirstTestLabelExists({
      onError: (name, err) =>
        deps.logError(
          `ensureShippedWithoutFirstTestLabelExists(${name}) failed: ` +
            `${(err as Error).message}`,
        ),
    });
    // `shipped-with-sibling-check-amended` (#1271), for the same reason and
    // on the same terms. It is the ONE owner-visible signal that a merge
    // rewrote an OLDER ticket's test, and `markShippedWithOlderTestEdit`
    // applies it with `gh issue edit --add-label`, which errors when the label
    // is absent — an error its caller swallows best-effort.
    await ensureShippedWithOlderTestEditLabelExists({
      onError: (name, err) =>
        deps.logError(
          `ensureShippedWithOlderTestEditLabelExists(${name}) failed: ` +
            `${(err as Error).message}`,
        ),
    });
    // The two review-note labels, on the same terms: applied with
    // `--add-label` at the ship moment, best-effort.
    await ensureReviewNoteLabelsExist({
      onError: (name, err) =>
        deps.logError(
          `ensureReviewNoteLabelsExist(${name}) failed: ` +
            `${(err as Error).message}`,
        ),
    });
    // `waiting-for-session` (spec #1334 SC), on the same terms: the retry
    // budget's move to it is an `--add-label`, which errors on a label the
    // repository lacks, and that write is best-effort.
    await ensureWaitingForSessionLabelExists({
      onError: (name, err) =>
        deps.logError(
          `ensureWaitingForSessionLabelExists(${name}) failed: ` +
            `${(err as Error).message}`,
        ),
    });
  }

  // Implementer idle-timeout precedence: --implementer-timeout-sec (CLI) wins;
  // else SANDCASTLE_IMPLEMENTER_TIMEOUT_SEC from .sandcastle/.env; else the
  // hardcoded 1200 already baked into args by parseSandcastleArgs. Resolved
  // HERE rather than at parse time because loadDotenv runs in the entrypoint
  // AFTER parseSandcastleArgs but BEFORE runMain — so the .env value isn't
  // visible until now. A malformed value throws a clearly-labeled error. Lets a
  // project whose inline e2e can exceed the 20-min/1200s default raise the
  // idle timeout without passing a flag (loop-cost #02 inline-e2e mitigation).
  if (!args.implementerTimeoutSecExplicit) {
    const envTimeout = implementerTimeoutFromEnv();
    if (envTimeout !== null) {
      args = { ...args, implementerTimeoutSec: envTimeout };
    }
  }

  // TWO COUNTERS, NOT ONE (issue #969) — see `SandcastleArgs.quarantineLimit`
  // for why a parked ticket and a crash are not the same event. `ok` resets
  // both; `deferred` and lease contention touch neither.
  let consecutiveFailures = 0;
  let consecutiveQuarantines = 0;
  let lastFailingIssue: number | undefined;
  /**
   * Set on the breaker path so `finishRun` can say in the run PR that the run
   * was CUT SHORT rather than finished. Without it the PR body reads like a
   * clean night for a run that stopped itself at iteration 3 of 71.
   */
  let breakerTrip: string | undefined;
  // Issue #1179 review, deferable 5: the plain-English twin of `breakerTrip`
  // above. `breakerTrip` itself stays a raw string (it is ALSO interpolated
  // into the `deps.comment` warning and the run PR's own `> [!WARNING]`
  // banner unchanged) but it carries a bare `--quarantine-limit`/
  // `--consecutive-failure-limit` CLI flag, which is jargon nobody reading
  // "what needs me" should have to parse first. `buildFinalRunReport`
  // pairs the two into `RunReportInput.breakerTrip` so the report renders
  // the plain sentence and keeps the raw detail in parentheses.
  let breakerTripPlain: string | undefined;
  const shippedIssues: number[] = [];

  // Rehydrate GitHub-side `shipped-local` state a PRIOR run may have stranded
  // — either it crashed on an exit path this fix predates, or it hit the one
  // path even this fix cannot cover (SIGKILL, see the `finally` note below).
  // Those issues are open, labelled `shipped-local`, and have no PR closing
  // them — exactly the false-shipped signal this whole change exists to
  // kill. We deliberately do NOT fold them into `shippedIssues` / `Closes
  // #N`: there is no per-issue commit/branch record to check, so we cannot
  // verify their code is actually present on THIS run's branch, and a false
  // `Closes #N` would silently close an issue whose code never made it into
  // the PR being merged — worse than leaving it stranded. Instead they are
  // surfaced, distinctly labelled, in the run PR body for a human to verify
  // and link by hand. Best-effort: a listing failure must never block the
  // run from starting.
  let previouslyShipped: readonly { number: number; title: string }[] = [];
  try {
    const stranded = await deps.listIssuesByLabel(LABEL_SHIPPED_LOCAL);
    previouslyShipped = stranded.map((i) => ({
      number: i.number,
      title: i.title,
    }));
    if (previouslyShipped.length > 0) {
      // Issue #1179 review, deferable 7: this listing is by the
      // `shipped-local` label alone — `listIssuesByLabel` never checks
      // whether an open PR already exists for the issue, so the earlier
      // wording ("with no open PR") was a claim this scan cannot actually
      // back up. Softened to describe what was really checked.
      deps.log(
        `startup: ${previouslyShipped.length} issue(s) already carry ` +
          `'shipped-local' (stranded by a prior run — open-PR status not ` +
          `checked here) — will surface them in this run's PR for manual ` +
          `verification`,
      );
    }
  } catch (err) {
    deps.logError(
      `startup: shipped-local rehydration scan failed: ${(err as Error).message} — continuing without it`,
    );
  }

  // Run-scoped Phase-1 cost ledger. Threaded through PipelineCtx to the
  // per-issue role runners and referenced directly at the run-level (planner /
  // merger / post-merge) sites. Its `summary()` is logged at run end and its
  // total is sunk into status.json. Best-effort — capture never fails a run.
  //
  // Declared HERE, above `finishRun`, on purpose (spec #1334 SE): the run
  // report reads this ledger and `issueLedger` below, and `finishRun` is
  // called from two early startup refusals that return before the rest of
  // `runMain` runs. Declared any lower, those calls would read the ledger
  // before it exists, throw, and lose the report. `main.run-report-wiring`
  // pins the order.
  const costLedger = new CostLedger();
  // Run-scoped PER-ISSUE telemetry ledger — the sibling of the cost ledger
  // above and the timing ledger below. Those answer "which role dominated this
  // run"; this one answers "did #412 alone eat $60", which a role total smears
  // across every issue the run touched. Fed by the same dispatches via the
  // `*IssueRole` wrappers. Above `finishRun` for the same reason.
  const issueLedger = new IssueLedger();

  /**
   * Finish a run the way a run should finish: push the branch and open one
   * draft PR against the default branch, with a `Closes #N` per shipped
   * issue. Then the merge rule (tokenmaxxing#29, `settleRunPr`) merges it
   * when it is a two-way door with a small blast radius and every check is
   * green; anything else stays open for the owner.
   *
   * Called from EVERY termination path — see the call sites: the two
   * startup guard refusals below, and from the `finally` block wrapping the
   * main loop (so it also runs on the circuit breaker, the sandbox
   * stall-streak abort, the fail-loud `ELIGIBLE_SET_FAILURE` planning roads,
   * and any uncaught exception — anything that unwinds through that `try`).
   * The one
   * deliberate exception is a hot-reload restart (exit 75): that's a
   * mid-run relaunch on the SAME branch, not a completed run, and
   * `openDraftPr` never edits an existing PR's body — opening one at that
   * point would freeze the `Closes #N` list and miss everything shipped
   * after relaunching. It CANNOT run after SIGKILL: that terminates the
   * process with no in-process cleanup of any kind, so an operator who
   * force-kills the loop is still responsible for pushing/opening the PR by
   * hand.
   *
   * A promotion failure no longer suppresses the PR — the work still needs
   * to reach a human — but the PR body says so plainly instead of quietly
   * presenting a possibly-incomplete branch as a clean run.
   *
   * "Nothing to ship" (no certified issues this run, no commits ahead of the
   * default branch, AND no rehydrated stranded-from-a-prior-run issues) is a
   * true no-op: no push, no PR. Without that guard every early startup
   * refusal (lock contention, a misconfigured flag) would open an empty PR.
   * A non-empty `previouslyShipped` counts as "something to ship" even when
   * THIS run certified nothing — that's exactly the sweep-up rehydration
   * exists for.
   *
   * Best-effort and NEVER throws — whatever failure got us here, the
   * commits are already safe in git, so a push/PR failure must never mask
   * the run's real exit code or an in-flight exception.
   */
  const finishRun = async (): Promise<void> => {
    try {
      // Spec #1334 SE: the report counts EVERY open waiting-for-session
      // ticket, not only the ones this run parked — read fresh here, at the
      // end, so a peer host's or an earlier run's parked tickets count too.
      // Best-effort: on a failed listing the report falls back to what the
      // start-of-run sweep saw.
      let standingWaiting: readonly RunReportTicket[] | undefined;
      try {
        standingWaiting = (await deps.listIssuesByLabel(WAITING_FOR_SESSION_LABEL)).map(
          (i) => ({ number: i.number, title: i.title }),
        );
      } catch (err) {
        deps.logError(
          `run report: listing ${WAITING_FOR_SESSION_LABEL} tickets failed ` +
            `(${(err as Error).message}) — counting the ones this run saw instead`,
        );
      }
      const base = await defaultBranch();
      // CONTENT, not raw commit presence — and computed ONCE so both branches
      // below agree. A run whose only commit is the rework-telemetry JSONL has
      // commits ahead of base but nothing to ship; judging by commit count
      // would skip the honest "nothing to ship" log here and then fall into the
      // push-uncertified-commits branch, which would put an orphaned remote
      // branch on origin for every failed run. See
      // `branchHasShippableContent`, which also states the trade.
      const hasShippableContent = branchHasShippableContent(
        args.repoRoot,
        args.branch,
        base,
      );
      if (
        shippedIssues.length === 0 &&
        !hasShippableContent &&
        previouslyShipped.length === 0
      ) {
        deps.log("run finished with nothing to ship — no push, no PR");
        // Issue #1179: no PR exists to carry the report, and minting one
        // just to hold a report is exactly what the "Closes"-less rule two
        // lines up forbids — so this is a DELIBERATE log-only render, not a
        // missed wiring. A totally empty run still gets one, per the
        // ticket's own acceptance criterion.
        deps.log(buildFinalRunReport({ standingWaiting }));
        return;
      }
      if (shippedIssues.length === 0 && previouslyShipped.length === 0) {
        // Commits exist (in-flight work when the run ended) but nothing was
        // certified. Push so the branch isn't stranded locally; there is
        // nothing to close so no PR — a `Closes`-less PR isn't what this
        // exists for, and a human can open one by hand once something ships.
        // Every other git-touching effect in this function goes through
        // `deps.openRunPr`, which honors `--dry-run` itself; this is the one
        // path that doesn't call it, so the dry-run check has to live here.
        if (args.dryRun) {
          deps.log(
            `[dry-run] would push uncertified commits on '${args.branch}' to origin (nothing certified, no PR)`,
          );
          return;
        }
        const push = runGitLease(
          args.repoRoot,
          "push",
          "origin",
          `${args.branch}:refs/heads/${args.branch}`,
        );
        if (push.ok) {
          deps.log(
            `run ended with uncertified commits on '${args.branch}' — pushed ` +
              `to origin so it isn't stranded locally; nothing was certified, ` +
              `so no PR was opened.`,
          );
        } else {
          deps.logError(
            `run ended with uncertified commits on '${args.branch}' and the ` +
              `push to origin FAILED (${push.stderr.trim() || "unknown"}). The ` +
              `work only exists on this host — push it by hand.`,
          );
        }
        // Issue #1179: same deliberate log-only render as the branch above —
        // this run may still have quarantined or deferred tickets worth
        // reporting even though nothing shipped, and there is still no PR
        // to carry them.
        deps.log(buildFinalRunReport({ standingWaiting }));
        return;
      }
      const report = buildFinalRunReport({ standingWaiting });
      const thisHostId = resolveHostId();
      const res = await deps.openRunPr(args.branch, shippedIssues, {
        promotionFailed,
        previouslyShipped,
        breakerTrip,
        report,
        hostId: thisHostId,
      });
      // Spec #1334: whether the run PR waits for the owner — and why — is only
      // known once `openRunPr` has read the diff and the merge rule has
      // settled it (its pre-merge check included). So the merge rule runs
      // FIRST, and the report is rebuilt with its answer; this rebuilt one is
      // what the run log and the PR body carry (the upsert below overwrites
      // the body `openRunPr` just embedded). A held run reaches the owner
      // once, whatever held it.
      const settled =
        res.url && res.mergeRule !== undefined && deps.settleRunPr !== undefined
          ? await deps.settleRunPr(
              args.branch,
              res.mergeRule.change,
              res.mergeRule.headSha,
            )
          : undefined;
      const heldReasons = runHeldReasons(res.mergeRule?.change, settled);
      const finalReport =
        heldReasons.length > 0
          ? buildFinalRunReport({ standingWaiting, heldRun: { reasons: heldReasons } })
          : report;
      deps.log(finalReport);
      if (res.url) {
        deps.log(
          `run PR ready for review: ${res.url} — merging it lands the work on ` +
            `the default branch and closes ${shippedIssues.length} issue(s)` +
            (promotionFailed
              ? " (WARNING: a final promotion failed during this run — see the PR body)"
              : ""),
        );
        // Issue #1179: `openDraftPr` never edits an EXISTING PR's body, so on
        // a relaunch that finds an already-open PR (`res.url` returned
        // without a fresh create), the report embedded above is never
        // written. This second, best-effort call is what actually keeps the
        // report current — it re-fetches whatever PR body is really there
        // right now and replaces just the report's marker section, whether
        // this PR is brand new (a same-content no-op) or was reused.
        try {
          const upserted = await deps.upsertRunPrReport?.(args.branch, finalReport, thisHostId);
          if (upserted !== undefined && !upserted.updated) {
            deps.logError(
              `run report: could not update the PR body (${upserted.error ?? "unknown"}) ` +
                `— the report above is still in the run log.`,
            );
          }
        } catch (err) {
          deps.logError(
            `run report: upsertRunPrReport threw (${(err as Error).message}) ` +
              `— the report above is still in the run log.`,
          );
        }
        if (settled !== undefined) {
          deps.log(
            settled.merged
              ? `merge rule: merged ${res.url} (${settled.why})`
              : `merge rule: ${res.url} waits for ${getProjectConfig().ownerName} (${settled.why})`,
          );
        }
      } else {
        deps.logError(
          `could not open the run PR (${res.error ?? "unknown"}). The work is ` +
            `safe on branch '${args.branch}' — push it and open a PR by hand.`,
        );
      }
    } catch (err) {
      deps.logError(
        `finishRun: unexpected failure (${(err as Error).message}) — the ` +
          `commits are safe in git on branch '${args.branch}'; push/open a PR ` +
          `by hand.`,
      );
    }
  };
  const quarantinedIssues: number[] = [];
  const deferredIssues: number[] = [];
  // Issue #1179 review, blocker 1 (second half): the pipeline outcome
  // `"error"` means it could NOT even quarantine the ticket — no label, no
  // comment, nothing on GitHub at all — and before this fix such a ticket
  // was pushed into no accumulator and simply vanished from the report.
  // That is the loudest failure a run can produce, so it gets its own list
  // and renders first in "Needs you" (see `buildFinalRunReport` below).
  const erroredIssues: number[] = [];
  // Issue #1179 (the end-of-run report): titles for every ticket this run
  // actually completed a pipeline pass for, keyed by issue number. Populated
  // where `completed.push(...)` runs below — the one place a plan issue
  // (which carries `.title`) is joined back to its outcome. `shippedIssues`/
  // `quarantinedIssues`/`deferredIssues` above carry only numbers, and
  // titles matter for a report a HUMAN reads in a minute — "#1042" alone
  // forces him to go look the ticket up, exactly the archaeology this
  // report exists to remove. Best-effort by construction: a ticket this
  // report otherwise has no title for (e.g. `previouslyShipped`, which
  // already carries its own title) just renders as a bare `#N`.
  const issueTitles = new Map<number, string>();
  // Spec #1334 SC: what the retry budget did THIS run, for the report.
  // `requeuedThisRun` — tickets the start sweep put back on
  // `ready-for-agent`. `waitingThisRun` — tickets moved to
  // `waiting-for-session` this run (at the start sweep or at the moment an
  // attempt failed), each with one sentence saying why.
  // `alreadyWaitingAtStart` — open tickets ALREADY carrying
  // `waiting-for-session` when the sweep listed the queue, so the report can
  // count every waiting ticket, not only this run's.
  const requeuedThisRun: number[] = [];
  const waitingThisRun: { readonly number: number; readonly note: string }[] = [];
  const alreadyWaitingAtStart: number[] = [];
  /**
   * Issue #1179 review, blocker 1 (first half): whether EACH quarantine
   * this run actually wrote landed on the `needs-human` terminal label —
   * the rework store's `outcome` field can never answer this (every
   * quarantined issue's outcome is the literal string `"quarantined"`, see
   * `outcomeFor` in `lib/telemetry/rework-record-input.ts`), and the
   * `needs-human` decision can also come from a `{ handoff: true }` call
   * option rather than the stop label (no call site passes one since spec
   * #1334, but the option still exists). `quarantineTerminalLabel` — the SAME function
   * `quarantineViaLabel` calls to pick the real GitHub label — is the one
   * true source, so it is captured here, once, by wrapping the single
   * `deps.quarantine` entry point every stop site calls through.
   */
  const quarantineNeedsYouThisRun = new Map<number, boolean>();
  // Final review, BLOCKER K: two independent hardenings on this wrapper.
  //
  //   1. Record AFTER a successful await, never before. The pre-fix version
  //      recorded `needsYou` before `wrappedQuarantine` even ran — a `gh`
  //      failure inside it (the quarantine call itself throwing, which
  //      `main.mts`'s own callers already treat as the ticket falling
  //      through to `erroredIssues` instead) would still leave a
  //      `quarantineNeedsYouThisRun` entry behind for a ticket that was
  //      never actually quarantined at all, mislabelling it in the report.
  //   2. Idempotence against DOUBLE-WRAPPING. `deps` can be handed to
  //      `runMain` more than once against the SAME object (a test driving
  //      two consecutive runs against one fixture is the case this guards;
  //      production calls `runMain` once per process, so this never fires
  //      there). Naively skipping the wrap on a second call would leave
  //      THIS run's map permanently unpopulated — the first call's wrapper
  //      closure still points at the FIRST run's `quarantineNeedsYouThisRun`.
  //      Naively wrapping unconditionally would nest a wrapper around a
  //      wrapper, double-recording (and double-writing, since
  //      `wrappedQuarantine` would itself already be wrapped) on every call
  //      after the first. The fix: always rebind from the TRUE original —
  //      stashed on `deps` itself the first time this runs — so every
  //      `runMain` call attaches its OWN one-layer wrapper (with its own
  //      map) directly onto the original, never onto a prior wrapper.
  const ORIGINAL_QUARANTINE = Symbol.for("sandcastle.originalQuarantine");
  const depsWithOriginal = deps as Deps & {
    [ORIGINAL_QUARANTINE]?: Deps["quarantine"];
  };
  const originalQuarantine = (depsWithOriginal[ORIGINAL_QUARANTINE] ??=
    deps.quarantine.bind(deps));
  deps.quarantine = async (n, reason, opts) => {
    const result = await originalQuarantine(n, reason, opts);
    quarantineNeedsYouThisRun.set(
      n,
      quarantineTerminalLabel(opts) === LABEL_NEEDS_HUMAN,
    );
    return result;
  };
  /**
   * Issue #1179: build the one end-of-run report from everything the run
   * accumulated above. Called from every branch of `finishRun` — see its
   * three call sites for where the result is rendered.
   *
   * The rework-store read is best-effort and NEVER throws: `readReworkRecords`
   * itself already tolerates a missing file, and this catches everything
   * else (a permission error, a corrupt line count) so one bad read degrades
   * every quarantined ticket to a label-less, action-less line rather than
   * losing the report entirely — matching `buildRunReport`'s own contract
   * ("absent rows degrade to label-less plain lines").
   *
   * Filtered to `r.runId === args.runId`: the store is git-tracked and spans
   * every run this repo has ever had, so an unfiltered read would attribute
   * a PRIOR run's stop label to a ticket this run never touched.
   *
   * Issue #1179 review, blocker 3: `shippedIssues`/`deferredIssues`/
   * `quarantinedIssues` are simple per-outcome push arrays that are never
   * pruned across an iteration boundary, so the SAME issue number can land
   * in more than one of them within one run — a ticket deferred in an
   * earlier iteration and shipped in a later one (blocker 3a), or a ticket
   * whose staging merge shipped and was then quarantined by a later
   * post-merge failure (blocker 3b, `mergedIssueNums` pushed into
   * `quarantinedIssues` without being pulled out of `shippedIssues`). Fixed
   * HERE, at report-input assembly — pure and testable — rather than by
   * mutating the accumulators themselves, which several other call sites
   * still read directly (counters, the circuit breaker, `RunMainResult`).
   */
  const buildFinalRunReport = (extra: {
    /** Every open `waiting-for-session` ticket, read at the end of the run;
     *  `undefined` when that listing failed (the start sweep's view is used). */
    readonly standingWaiting: readonly RunReportTicket[] | undefined;
    /** Why the run PR was left waiting for the owner — known only after
     *  the merge rule has settled it. */
    readonly heldRun?: { readonly reasons: readonly string[] };
  }): string => {
    const reworkByIssue = new Map<number, { readonly label?: string }>();
    try {
      const { records } = readReworkRecords({
        path: reworkStorePath(args.repoRoot),
      });
      for (const r of records) {
        if (r.runId !== args.runId) continue;
        reworkByIssue.set(r.issueNumber, { label: r.stopReason?.label });
      }
    } catch (err) {
      deps.logError(
        `run report: rework store read failed (${(err as Error).message}) ` +
          `— stopped tickets render without a cause label`,
      );
    }
    const ticket = (n: number): RunReportTicket => {
      const title = issueTitles.get(n);
      return title !== undefined ? { number: n, title } : { number: n };
    };
    /**
     * #1198 A: a shipped ticket, with the notes the SHIPPED list can carry —
     * that this merge had no first test behind it and rests on the
     * reviewer's pass alone, and the approving reviewer's structure finding
     * and weak-first-test reason (`shippedTicketNote`).
     *
     * Read from the in-memory bag rather than the rework store, for the same
     * reason `stop` below prefers it: `recordIssueRework` drops any outcome
     * with no `postSha`, and the bag is populated by the ship funnel itself.
     * A ticket that FELL THROUGH but was then refused by the reviewer sets
     * `firstTestFallThrough` and never `shippedWithoutFirstTest`, so it
     * cannot reach this list wearing this note.
     */
    const shippedTicket = (n: number): RunReportTicket => {
      const row = issueBags.get(n)?.toRow();
      const noFirstTest = row?.shippedWithoutFirstTest === true;
      const note = shippedTicketNote({
        noFirstTest,
        ...(row?.structureFinding !== undefined
          ? { structureFinding: row.structureFinding }
          : {}),
        ...(row?.weakFirstTest !== undefined
          ? { weakFirstTest: row.weakFirstTest }
          : {}),
      });
      return {
        ...ticket(n),
        ...(note !== undefined ? { note } : {}),
        ...(noFirstTest ? { noFirstTest: true } : {}),
      };
    };
    // Blocker 3b: a ticket that shipped and was then quarantined by a later
    // staging post-merge failure. `quarantinedIssues` already carries it
    // (that push is correct — the ticket IS terminal-stopped); it just also
    // needs pulling OUT of `shipped` and a note explaining why it isn't
    // double-counted.
    const shippedThenQuarantined = new Set(
      shippedIssues.filter((n) => quarantinedIssues.includes(n)),
    );
    const stop = (n: number): RunReportStop => {
      const base = ticket(n);
      // Issue #1179 review, deferable 6: `recordIssueRework` drops any
      // outcome with no `postSha`, so a bare quarantine very commonly has
      // NO durable rework record at all — that used to render as "no
      // record of", even though the ticket's own in-memory bag already
      // carries the real cause. `issueBags` is populated by EVERY stop
      // writer this run used (`reportStopBestEffort`, `applyStopLabelBestEffort`,
      // `reportStopOutsidePipeline` — the staging post-merge-failure path
      // above included), so it is a second, independent, run-local source
      // for the label whenever the durable store came up empty.
      const label =
        reworkByIssue.get(n)?.label ?? issueBags.get(n)?.toRow().stopReason?.label;
      const needsYou = quarantineNeedsYouThisRun.get(n) === true;
      const note = shippedThenQuarantined.has(n)
        ? "built successfully but failed to land in the final merge — not actually shipped"
        : undefined;
      return {
        ...base,
        ...(label !== undefined ? { label } : {}),
        needsYou,
        ...(note !== undefined ? { note } : {}),
      };
    };
    const quarantinedSet = new Set(quarantinedIssues);
    const shippedSet = new Set(shippedIssues);
    // Final review, BLOCKER H (first half): `erroredIssues` is the loudest
    // outcome a ticket can have — the pipeline could not even quarantine
    // it. A ticket deferred earlier in the run and then errored later must
    // not still render under the quiet "retried automatically" heading
    // alongside its own "needs a look" line in the headline — the SAME
    // reasoning blocker 3a already applied to shipped/quarantined.
    const erroredSet = new Set(erroredIssues);
    // Blocker 3a: a ticket deferred in an earlier iteration and shipped or
    // quarantined in a later one within the SAME run must not still show
    // under the quiet "retried automatically" heading once it has a real,
    // terminal outcome.
    const effectiveDeferred = deferredIssues.filter(
      (n) => !shippedSet.has(n) && !quarantinedSet.has(n) && !erroredSet.has(n),
    );
    const effectiveShipped = shippedIssues.filter((n) => !shippedThenQuarantined.has(n));
    // Final review, BLOCKER H (second half), kept for the retry budget: a
    // ticket the start sweep re-queued earlier THIS run can still end up
    // quarantined (or waiting) by the time this report is built — the sweep
    // runs at start-of-run, the ticket's own pipeline pass runs after. The
    // terminal outcome is the one that matters when the report is read, so
    // it wins and the "re-queued" line is dropped for that ticket.
    const waitingSet = new Set(waitingThisRun.map((w) => w.number));
    const effectiveRequeued = requeuedThisRun.filter(
      (n) => !quarantinedSet.has(n) && !waitingSet.has(n),
    );
    const costSummary = costLedger.summary();
    const input: RunReportInput = {
      runId: args.runId,
      branch: args.branch,
      shipped: effectiveShipped.map(shippedTicket),
      quarantined: quarantinedIssues.map(stop),
      errored: erroredIssues.map(ticket),
      deferred: effectiveDeferred.map(ticket),
      previouslyShipped: previouslyShipped.map((i) => ({
        number: i.number,
        title: i.title,
      })),
      breakerTrip:
        breakerTrip !== undefined && breakerTripPlain !== undefined
          ? { plain: breakerTripPlain, detail: breakerTrip }
          : undefined,
      promotionFailed,
      requeued: effectiveRequeued.map(ticket),
      waiting: waitingThisRun.map((w) => ({ ...ticket(w.number), note: w.note })),
      alreadyWaiting:
        extra.standingWaiting !== undefined
          ? extra.standingWaiting.filter((t) => !waitingSet.has(t.number))
          : alreadyWaitingAtStart.filter((n) => !waitingSet.has(n)).map(ticket),
      runCost: {
        totalUsd: costSummary.totalCostUsd,
        partial: costSummary.unpricedModels.length > 0,
      },
      olderTestEdits: effectiveShipped.flatMap((n) =>
        (issueBags.get(n)?.olderTestEdits() ?? []).map((f) => ({
          byIssue: n,
          byTitle: issueTitles.get(n),
          olderIssue: f.issueNumber,
          path: f.path,
          linesAdded: f.linesAdded,
          linesRemoved: f.linesRemoved,
          namedInTicket: f.namedInTicket,
        })),
      ),
      heldRun: extra.heldRun,
    };
    return buildRunReport(input);
  };
  let iterationsRun = 0;
  const importedFilesSnapshot = snapshotImportedFiles(args.repoRoot);
  // Cross-iteration staging state — the issue number that left staging
  // in a known-bad state, or null if last iteration finished clean. Used to
  // tag the failed staging tip as `bad-merge-issue-<N>` before reset (#1191
  // finding I: this comment used to say `bad-merge-iter-<N>`, a stale name
  // from before the tag switched from an iteration ordinal to an issue
  // number — see the actual tag at `bad-merge-issue-${failureTagIssue}`).
  let lastFailedStagingIssue: number | null = null;
  // Run-level health flag (audit issue #4). Set true when a final fast-forward
  // promotion REFUSES — merged+reviewed work is then stranded on
  // `integration-candidate` and the integration branch was NOT advanced.
  // A run that ends with this flag set must NOT report `done`/exit 0: it exits
  // non-zero and finishes the status feed as `unhealthy` so the failure is
  // visible to both the operator's shell and the viewer.
  let promotionFailed = false;
  // Lane-conflict stop flag. Set true when the cross-host LANE SYNC hook
  // (below) hits an unresolved merge conflict between two hosts' lanes.
  // Previously the loop logged the conflict LOUDLY and fell through to keep
  // planning/building on the un-synced tip — that let one unreconciled
  // conflict compound into thirteen dual-edited files before a human ever
  // saw it. Now the `for` loop below `break`s out immediately on conflict so
  // this host's lane stops advancing, while still falling through to the
  // normal end-of-run cleanup + `finishRun()` in the `finally` block so
  // in-flight work is not stranded.
  let laneConflictStop = false;
  // BLOCKED-BY GATE blindness flag. Set (to the `gh` error) when the deal-time
  // half of `blockedByGate` could not read the open-issue listing even after
  // its retry. The card is refused either way — but a refusal made BLIND is
  // not evidence the queue is empty, and without this flag the run drained,
  // wrote `done`, exited 0 and printed "no claimable issues — exiting
  // cleanly": a broken instrument reported to a person as a quiet, healthy
  // night. The plan-time half throws loudly instead (it can); the deal-time
  // half cannot, because the dealer treats a throw from `validate` as VALID.
  let blockerGateBlind: string | undefined;
  // One short-lived memo over the 500-row open-issue listing, shared by BOTH
  // halves of the blocked-by gate. The plan-time sweep and the up-to-8
  // per-card deal-time checks that follow it seconds later were nine identical
  // `gh` round-trips; they are now one. INVALIDATED at every point the LOOP
  // ITSELF moves a label the gate reads — the claim site below
  // (`ready-for-agent` → `in-progress`) and every ship-time flip
  // (`invalidateOpenIssueMemoAfterShipLabels`) — so time alone is never
  // trusted to notice a change the loop made itself.
  const openIssueMemo = createMemo(() => deps.listOpenIssuesWithBodies());
  /**
   * Drop the cached open-issue listing after a SHIP-TIME label flip.
   *
   * Claiming is not the only write the gate has to see. `markDone` /
   * `promoteStagingToDone` move a finished ticket to `shipped-local`, which is
   * one of `BLOCKER_RESOLVING_LABELS` — the flip that makes every ticket
   * declaring `Blocked-by: #this` dealable. Left cached, the very next refill
   * reads a listing up to `OPEN_ISSUE_MEMO_TTL_MS` old, withholds the
   * dependent, and prints a reason (`lastPlanExclusions`) that was already
   * false when it was written.
   *
   * WHY THAT IS WORSE THAN ONE WASTED REFILL. The dealer's last resort when
   * the stack is empty and nothing is in flight is `drainMerges()` then one
   * more `refillOnce()` (`lib/pool/dealer.ts`) — a safeguard built for exactly
   * this ordering. A stale memo defeats it: the extra refill re-reads the SAME
   * cached listing, finds nothing, and `next()` returns `null`, so the run
   * ENDS on a queue that has a dealable ticket in it.
   *
   * Cheap: one `gh` round-trip per shipped ticket, minutes apart.
   */
  const invalidateOpenIssueMemoAfterShipLabels = (label: string): void => {
    openIssueMemo.invalidate();
    deps.log(
      `[blocked-by gate] open-issue listing re-read next time — a ship-time ` +
        `\`${label}\` flip changed it`,
    );
  };
  // Every ready ticket the HOST withheld at the most recent refill, and why.
  // The drained exit's "(note: …)" is built from this rather than from a
  // second `gh` fetch re-derived under a slightly different reading of the
  // rule — the predecessor did exactly that and told the operator a ticket
  // was blocked at the moment the loop was happily dealing it.
  let lastPlanExclusions: readonly PlanningExclusion[] | undefined;

  /**
   * The one open-issue read the planner runs on, through the shared memo, with
   * the same single retry `blockedByGate` spends. A second failure THROWS —
   * see `ELIGIBLE_SET_FAILURE` for why silence here reads to a person as a
   * quiet, healthy night.
   */
  const readOpenIssuesForPlanning = async (): Promise<OpenIssueListing> => {
    const { open, lastError } = await readOpenIssuesTwice(
      () => openIssueMemo.read(),
      deps.logError,
      { tag: "[planner]" },
    );
    if (open === undefined) {
      const msg =
        `${ELIGIBLE_SET_FAILURE}: could not read the open-issue listing ` +
        `(twice): ${lastError}. Refusing to plan — a planner that cannot see ` +
        `the queue produces the same empty answer as an empty queue, and the ` +
        `run would exit 0 reporting a healthy, quiet night.`;
      deps.logError(msg);
      throw new Error(msg);
    }
    return open;
  };
  // Sandbox-health detector (#902: now the pool's `CompletionBreaker` —
  // `lib/pool/breaker.ts` — with `stallLimit: 3 * args.maxConcurrent`,
  // mutated once per COMPLETION rather than once per round). When the
  // sandbox itself is degraded (orbstack memory pressure, docker hung,
  // network NAT broken) no amount of retrying will help — the loop just
  // burns tokens producing more stalls, so a run of consecutive stalled
  // completions exits non-zero with a clear "restart docker, then resume"
  // message rather than continuing to grind.
  // Set right before the exit-75 hot-reload return — tells the `finally`
  // block below to skip finishRun (see that return site for why).
  let isHotReloadRestart = false;

  // Cross-host issue lease. OFF by default — every lease dep is a
  // no-op and the reconciliation/heartbeat below take their legacy path, so a
  // single-host consumer sees byte-for-byte today's behavior. Read once here so
  // startup reconciliation and the renewal heartbeat agree on the same flag.
  const leaseEnabled = crossHostLeaseEnabled();

  // Cross-host LANE SYNC (Task B). Read once here so the iteration-
  // start sync hook and the ship/promote publish hooks agree on the same flag.
  // Sharing code across hosts WITHOUT the per-issue lease is unsafe — two hosts
  // could ship conflicting work for the SAME issue and then blindly merge each
  // other's lane. So sync REQUIRES the lease: if sync is on but the lease is
  // off, refuse to start LOUD rather than silently degrade to an unsafe mode.
  const syncEnabled = crossHostSyncEnabled();
  if (syncEnabled && !leaseEnabled) {
    deps.logError(
      `[startup] SANDCASTLE_CROSS_HOST_SYNC is enabled but ` +
        `SANDCASTLE_CROSS_HOST_LEASE is NOT. Cross-host lane sync SHARES code ` +
        `between hosts and is only safe under the per-issue lease (without it, ` +
        `two hosts can ship conflicting work for the same issue and merge each ` +
        `other's lanes). Enable SANDCASTLE_CROSS_HOST_LEASE=1 or disable ` +
        `SANDCASTLE_CROSS_HOST_SYNC. Refusing to start.`,
    );
    // A resumed run reusing an existing branch name can already have
    // unpushed commits from the interrupted session this config error is
    // blocking — finishRun no-ops when there truly is nothing to push.
    await finishRun();
    return {
      exitCode: 2,
      iterationsRun: 0,
      shippedIssues: [],
      quarantinedIssues: [],
    };
  }

  // Skill-discipline opt-in: when `SANDCASTLE.md` exists at the repo root,
  // the orchestrator re-validates each dealt card against a fresh
  // host-side label fetch, excluding any that don't carry exactly one
  // `type:` label. The check is done once at startup (SANDCASTLE.md is a
  // committed file; it doesn't appear mid-run); the filter itself runs
  // per-iteration so newly-added `type:` labels are picked up.
  const sandcastleMdPath = path.join(args.repoRoot, "SANDCASTLE.md");
  const sandcastleMdExists = existsSync(sandcastleMdPath);
  // Parse SANDCASTLE.md ONCE at startup into a `type:X → required-skills[]`
  // map. The orchestrator looks up each dispatched issue's `type:X` label
  // in this map to compute the per-issue `requiredSkills` threaded into
  // runImplementer's opts. Empty map when SANDCASTLE.md doesn't exist —
  // the per-issue lookup then yields `undefined` and the gate is a no-op
  // (backward compat for projects without the file).
  let requiredSkillsByType: ReadonlyMap<string, readonly string[]> = new Map();
  if (sandcastleMdExists) {
    deps.log(
      `SANDCASTLE.md found at ${sandcastleMdPath} — skill discipline enabled (dealt cards re-validated against host-side label fetch)`,
    );
    try {
      const mdContent = readFileSync(sandcastleMdPath, "utf8");
      requiredSkillsByType = parseRequiredSkillsByType(mdContent);
      deps.log(
        `skill-discipline: parsed ${requiredSkillsByType.size} type:X section(s) from SANDCASTLE.md`,
      );
    } catch (err) {
      deps.logError(
        `skill-discipline: failed to read/parse SANDCASTLE.md — gate disabled this run: ${(err as Error).message}`,
      );
      requiredSkillsByType = new Map();
    }
  } else {
    deps.log(
      `No SANDCASTLE.md at repo root — skill discipline disabled (no type:-label enforcement)`,
    );
  }

  // Codex backend has an empty escalation ladder by design
  // (codexModels.*.escalations === []), so a failing role quarantines on first
  // failure with no model-tier retry/recovery. Warn once at startup because
  // --recovery / --no-retry then have no escalation effect — silent under the
  // claude defaults but surprising for an operator who set them expecting a
  // retry tier.
  if (args.backend === "codex") {
    deps.log(
      `backend: codex — no escalation/recovery tier (empty ladder): a failing role quarantines on first failure; --recovery / --no-retry have no model-escalation effect this run`,
    );
  }

  // Single-instance lock — refuse to start a second loop on the same
  // checkout. Without this guard, two parallel loops will race on the
  // `in-progress` label: loop B's startup reconciliation (below) would
  // release issues loop A is mid-pipeline on, causing double-claim of
  // partial work or silent quarantine. The sandcastle-run skill ALSO
  // checks via pgrep, but that's bypassable (direct `node main.mts`
  // invocation, or worktree-rooted re-launch outside the skill); the
  // in-process lock is the canonical guard. proper-lockfile reclaims
  // after 60s of staleness so a crashed prior run doesn't permanently
  // wedge restarts.
  const loopLockPath = path.join(args.repoRoot, ".sandcastle", ".loop.lock");
  let releaseLoopLock: (() => Promise<void>) | undefined;
  try {
    releaseLoopLock = await acquireSingleInstanceLock(loopLockPath);
  } catch (err) {
    deps.logError(
      `[startup] ${(err as Error).message} A second loop on the same checkout would race with the in-progress label state — refusing to start.`,
    );
    // Same reasoning as the sync-config refusal above: a resumed run on an
    // existing branch may already carry unpushed work; finishRun no-ops
    // when there genuinely isn't any.
    await finishRun();
    return {
      exitCode: 1,
      iterationsRun: 0,
      shippedIssues: [],
      quarantinedIssues: [],
    };
  }

  // LAUNCH-TIME REAPER (the reaper fix — crash recovery). Workstream 1b chose
  // NOT to build the live-heartbeat checkpoint (see the STAGED note by the lease
  // heartbeat below) because snapshotting a worktree an agent is actively using
  // races the agent. This closes the same gap from the OTHER side: at startup —
  // when NO agent is running and the single-instance lock above guarantees no
  // live loop holds these worktrees — we run the proven post-kill reaper so a
  // HARD-killed prior run's in-flight WIP is captured (pushed to its WIP ref)
  // and its lease released BEFORE the reconciliation below frees the issue for
  // re-claim. Without this, a SIGKILL/OOM/sleep re-runs the issue from scratch
  // and strands its lease. The graceful `--now` skill already invokes this same
  // reaper; here we auto-invoke it so a crash needs no human `--now`.
  //
  // DEFECT 4: do NOT gate the reaper on a prior-status liveness probe. We hold
  // the single-instance lock acquired above, so OUR loop is provably the ONLY
  // one running here — regardless of what a stale status.json's stamped pid
  // claims. A hard-killed loop's pid can be REUSED by an unrelated live process,
  // making the probe report "alive" and (under the old gate) SKIP the reaper —
  // after which reconciliation frees the label without ever capturing the
  // surviving worktree's WIP, losing the work. So we ALWAYS run discovery. The
  // reaper is a natural no-op when no `agent/issue-<N>` worktree survives, and
  // stays SILENT unless it actually reaped something, so a clean start adds no
  // noise. Best-effort + NON-FATAL: crash recovery must never crash the loop it
  // protects. (Dropping the probe here also retires the second, drift-prone pid
  // probe DEFECT 5 flagged — the ONE remaining probe lives in the viewer.)
  // Spec #1368 decision 2: remove sandbox containers a dead run left behind
  // (they keep the agent's secrets), only when no OTHER loop runs on this
  // server — the lock above is per checkout and cannot see one elsewhere.
  // Best-effort + NON-FATAL; never prints a container's environment.
  try {
    const swept = args.dryRun
      ? { removed: [] as readonly string[] }
      : await deps.sweepLeftoverContainers();
    if (swept.removed.length > 0) {
      deps.log(
        `[startup] removed ${swept.removed.length} leftover sandbox container(s): ${swept.removed.join(", ")}`,
      );
    }
  } catch (err) {
    deps.logError(
      `[startup] leftover-container sweep skipped: ${(err as Error).message} — the loop still starts`,
    );
  }

  try {
    const reaped = await deps.checkpointInflight();
    if (reaped.length > 0) {
      deps.log(
        `[startup] launch-time reaper: rescued in-flight work from a prior killed run:\n${formatCheckpointStop([...reaped])}`,
      );
    }
  } catch (err) {
    deps.logError(
      `[startup] launch-time reaper skipped: ${(err as Error).message} — the loop still starts; a crashed prior run's WIP may need a manual \`--now\` reap`,
    );
  }

  // Spec #1368 decision 6 (loop side): the reaper above found the previous
  // run's worktrees; stamp WHY its tickets stopped into the old status file
  // (and mark that run stopped) and publish that to the dashboard BEFORE the
  // new status store replaces the file. Best-effort + NON-FATAL, like the reaper.
  if (!args.dryRun) {
    try {
      const stamped = await deps.stampStopCauses();
      if (stamped.length > 0) {
        deps.log(
          `[startup] stop cause recorded for ${stamped.map((n) => `#${n}`).join(", ")}`,
        );
      }
    } catch (err) {
      deps.logError(
        `[startup] stop-cause stamp skipped: ${(err as Error).message}`,
      );
    }
  }

  // Status feed for the `sandcastle-watch` viewer. Constructed ONLY after the
  // single-instance lock above succeeds, so a second loop that fails the lock
  // and early-returns can never clobber a live status.json. Threaded into
  // PipelineCtx so per-issue pipelines can publish phase transitions; all its
  // methods are synchronous + non-fatal (write errors route to deps.logError).
  const statusStore = createStatusStore(
    {
      branch: args.branch,
      repo: path.basename(args.repoRoot),
      repoRoot: args.repoRoot,
      startedAt: new Date().toISOString(),
      iterationsTotal: args.iterations,
      maxConcurrent: args.maxConcurrent,
      hostId: resolveHostId(),
      runId: args.runId,
    },
    {
      onError: (err) =>
        deps.logError(`status write failed: ${(err as Error).message}`),
      // Live mission-control feed. OFF unless both env vars are set, in which
      // case every commit() — including the terminal one that carries the
      // final state and cost — is pushed as it happens. Fire-and-forget: it
      // cannot block or fail the run (see lib/status/push.ts).
      pusher: createStatusPusher({
        ...pushConfigFromEnv((k) => process.env[k]),
        logError: deps.logError,
      }),
    },
  );
  // Run-scoped Phase-2 wall-clock timing ledger — the timing sibling of the cost
  // ledger. Threaded the same way; each role dispatch is wrapped in `timeRole`,
  // and its `summary()` is merged with the cost summary into `totals.perRole` at
  // run end. Best-effort — timing never fails a run.
  const timingLedger = new TimingLedger();
  // Run-wide event counters (retries, quarantines, deferrals, error classes).
  const runCounters = new RunCounters();
  // issue → its per-issue counter bag. Created here rather than inside the
  // per-issue closure so the end-of-run drain can still reach every bag; the
  // closure registers its own on entry. Mutated in place, so instrumenting the
  // pipeline changes none of its many `return` statements.
  const issueBags = new Map<number, IssueTelemetryBag>();

  /**
   * The ONE place a per-issue telemetry bag is fetched or created.
   *
   * Reuse, never replace: the per-issue closure runs once per issue PER
   * ITERATION, and a deferred issue is re-planned by the next one. A fresh
   * bag would keep only the last attempt's counters while the issue ledger
   * accumulated cost across both — a row whose dollars span two attempts
   * and whose attempt count describes one. `main.test.mts`'s rot-guard pins
   * `main.test.mts` pins that this file constructs exactly ONE bag, by
   * counting the constructor call as raw text — so even a mention of it in
   * a comment counts. It caught a second copy of this idiom the moment
   * issue #923 added one, which is why the fetch-or-create lives here now
   * instead of being written out at each use.
   */
  const bagFor = (issueNumber: number): IssueTelemetryBag => {
    const existing = issueBags.get(issueNumber) ?? new IssueTelemetryBag();
    issueBags.set(issueNumber, existing);
    return existing;
  };

  /**
   * Spec #1334 SE: write the one fixed-format run-log line for a ticket's
   * ship, stop or crash (`formatTicketEventLine` in
   * `lib/state/run-report.ts` documents the format and the grep). Four
   * callers, one per place a ticket's outcome is decided: `settleOutcome`
   * (every pipeline completion but a ship), `logLanded` (a ship, at the
   * moment the run lands it), `settleRejection` (a claim or pipeline throw),
   * `reportStopOutsidePipeline` (a stop after review — a stranded promotion
   * or a failed staging round). Through `deps.log`,
   * never `logError`: a crash line is a record, not a second error report.
   */
  const logTicketEvent = (
    issueNumber: number,
    event: TicketEvent,
    label?: string,
  ): void => {
    deps.log(
      formatTicketEventLine({
        issueNumber,
        event,
        label,
        costUsd: issueLedger.rows().find((r) => r.issue === issueNumber)?.costUsd,
      }),
    );
  };

  /** The `shipped` event line, written the moment the run LANDS each of
   *  these tickets on its branch — never when its pipeline ends (spec #1334
   *  fix pass). */
  const logLanded = (issueNumbers: readonly number[]): void => {
    for (const n of issueNumbers) logTicketEvent(n, "shipped");
  };

  /**
   * Spec #1334 SC — record one failed attempt on the ticket's retry budget
   * (`createFailedAttemptRecorder`, `lib/state/retry-budget.ts`). Called from
   * the two places an attempt ends in failure: `settleOutcome` (every
   * quarantine or error inside the pipeline) and `reportStopOutsidePipeline`
   * (a stranded promotion, a rejected staging round — tickets that settled
   * `ok` first and fail later, at landing). This attempt's cost is the issue
   * ledger's running total for the ticket in THIS process.
   */
  const recordFailedAttempt = createFailedAttemptRecorder({
    dryRun: args.dryRun,
    wentToOwner: (n) => quarantineNeedsYouThisRun.get(n) === true,
    costUsd: (n) => issueLedger.rows().find((r) => r.issue === n)?.costUsd ?? null,
    stopLabel: (n) => issueBags.get(n)?.toRow().stopReason?.label,
    runId: args.runId,
    host: resolveHostId,
    now: () => new Date(),
    record: (n, attempt) => deps.recordRetryAttempt?.(n, attempt),
    onWaiting: (n, why) => {
      waitingThisRun.push({ number: n, note: why });
      deps.log(`[issue=${n}] retry budget: moved to ${WAITING_FOR_SESSION_LABEL} — ${why}`);
    },
    logError: (line) => deps.logError(line),
  });


  /**
   * Report a stop for a ticket that is NOT inside `runIssuePipeline`, so it
   * has no `PipelineCtx` and cannot use `reportStopBestEffort`.
   *
   * Two sites need this: the staging round failing its combined review, and
   * a finished ticket stranded because the run could not move it onto the
   * branch that collects finished work.
   *
   * It writes BOTH surfaces, and that is the whole point of it existing.
   * The first version of this change wrote only the GitHub label and body,
   * leaving the durable record in `.sandcastle/telemetry/issues.jsonl`
   * empty — which is exactly the "a record that silently disagrees with the
   * ticket is worse than no record" failure `lib/telemetry/rework-store.ts`
   * warns about, and it would have made these two stops uncountable while
   * the ticket claimed otherwise.
   */
  const reportStopOutsidePipeline = async (
    issueNumber: number,
    // The two fields this function actually writes, not the whole
    // {@link StopExplanation}: one caller (the stranded-promotion handler)
    // reaches here through `handleStrandedPromotion`'s own `reportStop`
    // callback and has only a label and a rendered detail in hand. A full
    // `StopExplanation` still satisfies this structurally.
    explanation: { readonly label: StopReasonLabel; readonly detail: string },
  ): Promise<void> => {
    bagFor(issueNumber).noteStopReason({
      label: explanation.label,
      detail: explanation.detail,
    });
    logTicketEvent(issueNumber, "stopped", explanation.label);
    try {
      await deps.reportStop?.(issueNumber, {
        label: explanation.label,
        detail: explanation.detail,
      });
    } catch (err) {
      deps.logError(
        `[issue=${issueNumber}] reportStop(${explanation.label}) failed — the ` +
          `ticket is still quarantined via needs-human, but its reason may ` +
          `not have reached the ticket: ${(err as Error).message}`,
      );
    }
    // After the stop report, so a fresh read of the body sees what this stop
    // wrote (a stranded promotion's saved-work line → waiting, not retry).
    await recordFailedAttempt(issueNumber, undefined, "quarantined");
  };
  // Every issue THIS run flipped `ready-for-agent` → `in-progress` itself.
  // Populated at the single `deps.claim` call site below; read ONLY by the
  // shutdown reconciliation in the `finally` (see releaseHeldLabelsOnShutdown),
  // which needs to know which in-progress labels are OURS to release.
  //
  // Deliberately never pruned on a terminal outcome: this is an ownership
  // record ("we claimed it"), not a liveness record ("it is still in flight").
  // The shutdown pass re-reads the live `in-progress` set and intersects, so an
  // issue that has since gone `done`/`needs-human` drops out there — one
  // authoritative read beats N transition hooks we could forget to add.
  const claimedByThisHost = new Set<number>();
  // What this run WAS — resolved model map, profile, backend/provider, prompt
  // hashes — recorded up front, since identity is known as soon as the model
  // map resolves. `recordRunTelemetry` MERGES into the same object later, so
  // the run-end counters and this write cannot clobber each other.
  //
  // Wrapped: `resolveRunIdentity` reads prompt files off disk, and no telemetry
  // field is worth failing a launch over. On a throw the field is simply
  // omitted and the run proceeds. `args` is passed verbatim — the same value
  // `roleModelsFor` receives — so identity can never disagree with the map the
  // run actually used.
  let runIdentity: ReturnType<typeof resolveRunIdentity> | undefined;
  try {
    runIdentity = resolveRunIdentity(args);
    statusStore.recordRunIdentity(runIdentity);
  } catch (err) {
    deps.logError(
      `run identity skipped: ${(err as Error).message} — the run continues without it`,
    );
  }
  /**
   * Assemble and persist the two additive telemetry keys.
   *
   * Rebuilt from the FULL run-scoped accumulators on every call, never from
   * one iteration's slice: `recordIssueTelemetry` is a wholesale REPLACE, so a
   * partial flush at the end of iteration 2 would erase iteration 1. Both
   * ledgers already hold everything run-wide, so this costs nothing.
   *
   * Called at the end of each iteration's accounting AND once more in the
   * run-end drain. The per-iteration call is durability: a run SIGKILLed at 3am
   * has no in-process cleanup of any kind, so without it the whole run's
   * telemetry dies with the process.
   *
   * Never throws — it runs on the exit path, where an exception could mask the
   * real exit code.
   */
  const flushTelemetry = (): void => {
    try {
      const payload = buildTelemetryPayload({
        costSummary: costLedger.summary(),
        issueRows: issueLedger.rows(),
        issueBagRows: new Map(
          [...issueBags].map(([issue, bag]) => [issue, bag.toRow()] as const),
        ),
        runCounters: runCounters.toRunTelemetry(),
        runIdentity,
      });
      // Guarded so "absent when nothing was captured" survives: writing an
      // empty array/object would claim "measured, and there was nothing".
      if (payload.issueTelemetry !== undefined) {
        statusStore.recordIssueTelemetry(payload.issueTelemetry);
      }
      if (payload.runTelemetry !== undefined) {
        statusStore.recordRunTelemetry(payload.runTelemetry);
      }
    } catch (err) {
      deps.logError(`telemetry flush skipped: ${(err as Error).message}`);
    }
  };
  /**
   * THE DURABLE HALF of the telemetry above.
   *
   * `flushTelemetry` writes `status.json`, which is gitignored and REWRITTEN
   * every run — so every number it holds is gone the moment the next run starts,
   * and the per-issue refs that mirror it are swept by the purge at run end.
   * That makes the one question worth asking — "did the loop's shipped work have
   * to be corrected afterwards?" — permanently unanswerable. The two members
   * below append the same facts to a git-TRACKED JSONL that survives the run,
   * the purge, and the branch merge.
   *
   * Both are thin: the work lives in the top-level `recordReworkOutcome` /
   * `commitReworkStore`, which are reachable from a test. What stays here is
   * exactly what needs the run — the dedup set, the pending-commit flag, and the
   * two ledgers the record is read out of.
   */
  const reworkRecorded = new Set<number>();
  /** Set when this iteration appended at least one line, so the commit below
   *  runs only when there is something to commit. */
  let reworkPendingCommit = false;
  /**
   * The run's host identity, resolved ONCE. `resolveHostId` is also called for
   * the status store above; reading it twice risks two different answers if the
   * environment shifts mid-run, and a rework line whose `hostId` disagrees with
   * the status feed's is worse than useless for cross-host comparison. The
   * empty-string fallback lives in `buildReworkRecordInput`, where it is tested.
   */
  const reworkContext: ReworkRecordingContext = {
    storePath: reworkStorePath(args.repoRoot),
    runId: args.runId,
    hostId: resolveHostId(),
    dryRun: args.dryRun,
    recorded: reworkRecorded,
    ...(runIdentity !== undefined ? { models: runIdentity.roleModels } : {}),
    bagRowFor: (issueNumber) => issueBags.get(issueNumber)?.toRow(),
    ledgerRowFor: (issueNumber) =>
      issueLedger.rows().find((r) => r.issue === issueNumber),
    log: deps.log,
    logError: deps.logError,
  };
  /** Record one issue's terminal outcome, arming the commit below when it
   *  actually wrote a line. */
  const recordIssueRework = (
    issueNumber: number,
    status: IssueOutcome["status"],
    postSha: string | undefined,
  ): void => {
    if (recordReworkOutcome(reworkContext, issueNumber, status, postSha)) {
      reworkPendingCommit = true;
    }
  };
  /**
   * Commit the appended lines, once per iteration.
   *
   * FAILURE IS RETRIED, NOT SWALLOWED: the flag is cleared ONLY on success, so a
   * failed add/commit leaves it set and the NEXT call (the next iteration's, or
   * the run-end backstop's) genuinely tries again. Clearing it up-front — the
   * shape this replaced — made the backstop a guaranteed no-op and turned any
   * single failure into a permanent one: the file stays staged, `git status
   * --porcelain` in the launch worktree stays non-empty, and the promotion's own
   * merge then risks git's "your local changes would be overwritten" refusal,
   * stranding certified work on the staging branch while `finishRun` still opens
   * a run PR that claims to close issues whose code it does not contain.
   */
  const commitReworkRecords = (): void => {
    if (!reworkPendingCommit) return;
    if (commitReworkStore(args.repoRoot, args.branch, deps.logError)) {
      reworkPendingCommit = false;
    }
  };
  // Keep-alive: a phase can run for many minutes without a transition (the log
  // shows a 1200s idle phase), so without this the viewer would mislabel a
  // healthy loop "stale" within seconds. The timer is `unref`'d and cleared by
  // `finish()`, so it never delays a clean exit.
  statusStore.startHeartbeat();

  // Startup reconciliation: a previous loop that was killed (Ctrl-C, OOM,
  // host reboot) leaves issues stuck on `in-progress`. Without this step,
  // the new loop's planner sees those issues as unavailable (already
  // claimed) and silently skips them — or worse, the planner's blocker
  // resolution can read "issue absent from ready-for-agent → resolved"
  // and dispatch dependents prematurely. Now safe to release unconditionally
  // because the single-instance lock above guarantees no parallel loop holds
  // its own issues on `in-progress`. The deps.release stub short-circuits
  // under --dry-run with a log entry, so no extra guard needed here.
  try {
    const stale = await deps.listIssuesByLabel("in-progress");
    if (stale.length > 0) {
      deps.log(
        `startup reconciliation: ${stale.length} orphaned in-progress issue(s) — releasing back to ready-for-agent`,
      );
      for (const issue of stale) {
        try {
          // Cross-host lease: with the lease OFF, keep the legacy
          // unconditional release — an in-progress label can only be this
          // single host's own crash-orphan. With the lease ON, an in-progress
          // issue may belong to a LIVE peer host; releasing it would yank the
          // peer's active work. So consult the lease and release ONLY when it
          // is absent or expired; skip a live foreign lease.
          if (leaseEnabled) {
            const st = await deps.leaseState(issue.number);
            if (st === "live") {
              deps.log(
                `  skipping #${issue.number}: lease is LIVE — another host is working it; leaving in-progress`,
              );
              continue;
            }
            deps.log(
              `  #${issue.number} lease ${st} — safe to release for re-claim`,
            );
          }
          await deps.release(
            issue.number,
            `[sandcastle startup-reconcile] orphaned in-progress label from a prior killed run — released for re-claim by the new loop`,
          );
          deps.log(`  released #${issue.number}: ${issue.title}`);
        } catch (err) {
          deps.logError(
            `  failed to release #${issue.number}: ${(err as Error).message} — leaving as-is, planner will skip`,
          );
        }
      }
    } else {
      deps.log(`startup reconciliation: no orphaned in-progress issues`);
    }
  } catch (err) {
    deps.log(
      `startup reconciliation skipped: listIssuesByLabel failed: ${(err as Error).message}`,
    );
  }

  // Retry-budget sweep (spec #1334 SC; replaced the #1178 auto-requeue
  // sweep). A ticket the loop failed on carries a retry ledger in its body
  // (`lib/state/retry-budget.ts`); while it is under $100 and has had fewer
  // than three attempts, it goes back on `ready-for-agent` here, before
  // iteration 1. Past either limit it moves to
  // `waiting-for-session` and is listed in the run report. A `quarantine`
  // ticket with NO ledger (a stop from before the budget existed) is never
  // touched.
  //
  // No environment-health gate: the old sweep re-queued only on two
  // confirmed-healthy launch probes, because nothing else stopped a real
  // environment fault from ping-ponging. The three-attempt cap is that brake
  // now.
  //
  // Placed right after startup reconciliation: both settle inherited ticket
  // state before iteration 1, and this one needs `leaseEnabled` for the same
  // cross-host-peer reason reconciliation checks it.
  if (args.dryRun) {
    deps.log(`retry-budget sweep: skipped — --dry-run touches no labels`);
  } else {
    try {
      const openIssues = await deps.listOpenIssuesWithBodies();
      for (const i of openIssues) {
        if (i.labels.includes(WAITING_FOR_SESSION_LABEL)) {
          alreadyWaitingAtStart.push(i.number);
          if (i.title.length > 0) issueTitles.set(i.number, i.title);
        }
      }
      const candidates = openIssues.filter(
        (i) =>
          i.labels.includes(LABEL_QUARANTINE_LEGACY) &&
          i.body.includes(RETRY_BUDGET_SECTION_START),
      );
      deps.log(
        candidates.length === 0
          ? `retry-budget sweep: no quarantined ticket carries a retry ledger`
          : `retry-budget sweep: ${candidates.length} quarantined ticket(s) ` +
              `with a retry ledger — checking each against the budget`,
      );
      for (const issue of candidates) {
        try {
          if (issue.title.length > 0) issueTitles.set(issue.number, issue.title);
          // A LIVE peer lease means another host already claimed this ticket;
          // touching its labels here would be the cross-host stomp the lease
          // exists to prevent.
          if (leaseEnabled && (await deps.leaseState(issue.number)) === "live") {
            deps.log(`  retry budget: skipping #${issue.number} — lease is LIVE`);
            continue;
          }
          // Cheap pre-filter on the batch listing (STALE) — only to skip the
          // per-ticket round trip on an obvious `skip`. What gets reported is
          // keyed off the decision `applyRetryDecision` itself made on a
          // fresh fetch, so the report can never disagree with the write
          // (the #1178 final review's BLOCKER I, kept).
          const staleDecision = decideRetry({ labels: issue.labels, body: issue.body });
          if (staleDecision.action === "skip") continue;
          const result = await deps.applyRetryDecision?.(issue.number);
          if (result === undefined) continue;
          if (result.decision.action === "retry") {
            requeuedThisRun.push(issue.number);
            deps.log(
              `  retry budget: #${issue.number} re-queued — ` +
                `$${result.decision.spentUsd.toFixed(2)} spent so far`,
            );
          } else if (result.decision.action === "waiting") {
            const note = waitingNote(result.decision);
            waitingThisRun.push({ number: issue.number, note });
            deps.log(
              `  retry budget: #${issue.number} moved to ${WAITING_FOR_SESSION_LABEL} — ${note}`,
            );
          }
        } catch (err) {
          deps.logError(
            `  retry budget: #${issue.number} failed: ${(err as Error).message} — ` +
              `left untouched, the next start tries again`,
          );
        }
      }
      // A re-queued ticket must be visible to the first plan, not hidden
      // behind a listing cached before its label moved.
      if (requeuedThisRun.length > 0) openIssueMemo.invalidate();
    } catch (err) {
      deps.logError(
        `retry-budget sweep skipped: listOpenIssuesWithBodies failed: ` +
          `${(err as Error).message} — no tickets touched`,
      );
    }
  }

  // Cleanup hook 2 (startup prune, safety net): sweep WIP refs on
  // origin and delete any whose issue is no longer OPEN (closed/merged) — a
  // stale checkpoint that the ship-path hook missed (e.g. loop killed
  // post-merge). Gated on sync (no-op + touches no origin when OFF). SAFETY: an
  // open issue — ready OR in-progress, incl. a checkpoint-stopped one flipped
  // back to ready above — MUST keep its WIP ref so it can resume, so we prune
  // ONLY issues absent from the current open set. Best-effort; a fault is
  // logged non-fatal.
  if (crossHostSyncEnabled()) {
    try {
      const openIssues = await deps.listOpenIssuesWithBodies();
      // `listOpenIssuesWithBodies` caps at gh `--limit 100`; a full 100 rows
      // means the list may be truncated, so treat it as INCOMPLETE and let
      // pruneStaleWipRefs refuse rather than risk pruning a dropped open
      // issue's live WIP ref.
      const openListComplete = openIssues.length < GH_OPEN_ISSUE_LIST_LIMIT;
      await pruneStaleWipRefs(
        true,
        openIssues.map((i) => i.number),
        openListComplete,
        args.repoRoot,
        runGitLease,
        deps.log,
        deps.logError,
      );
    } catch (err) {
      deps.logError(
        `[wip-prune] startup prune skipped: listOpenIssuesWithBodies failed: ${(err as Error).message} — no WIP refs touched`,
      );
    }
  }

  // Graceful shutdown: register once. We don't abort in-flight gh calls;
  // we set a flag the outer loop checks at iteration boundaries.
  let shuttingDown = false;
  // Hoisted out of the `try` block below (where it used to be declared)
  // so `onSignal` — defined here, before that block exists — can flip it
  // directly. #1191 finding A: without this, a worker parked inside
  // `dealer.next()` is woken by a sibling's `done()` after SIGTERM and can
  // still refill from the planner and start a brand-new ticket, because
  // `stopDealing` (checked at the top of `worker()`'s loop and inside
  // `dealFromPlanner`) never got set on a signal — only on a breaker trip,
  // fatal lease error, or lane conflict via `latch()`.
  let stopDealing = false;
  const onSignal = (sig: string): void => {
    if (shuttingDown) return;
    shuttingDown = true;
    stopDealing = true;
    deps.log(`received ${sig} — finishing in-flight ops then exiting cleanly`);
    // ADDITIVE TELEMETRY ONLY (2c): surface "stopping — waiting on <phase> for
    // #N" so status tooling can distinguish a graceful drain from a healthy run.
    // This changes NO shutdown control flow — the `shuttingDown` flag set above
    // and the iteration-boundary break remain the sole abort mechanism; the
    // agent is NOT interrupted (that abort is deliberately out of scope). The
    // write is synchronous + non-fatal, like every other status write.
    statusStore.markStopping();
  };
  const sigintHandler = (): void => onSignal("SIGINT");
  const sigtermHandler = (): void => onSignal("SIGTERM");
  process.on("SIGINT", sigintHandler);
  process.on("SIGTERM", sigtermHandler);

  // Cross-host lease heartbeat. While the loop runs, renew every
  // held lease at ~ttl/3 (floored at 30s) so a live host never loses a lease
  // mid-work; a failed renewal CAS is the fence signal (logged in renewLeases).
  // Only when the lease is on. `unref` so it never holds the process open, and
  // it is always cleared in the finally below on every exit path.
  let leaseHeartbeat: ReturnType<typeof setInterval> | undefined;
  if (leaseEnabled) {
    const renewMs = Math.max(30_000, (lockTtlSecOnce() * 1000) / 3); // Fix 8
    // Cross-host STATUS SYNC also rides the heartbeat (gated). The per-iteration
    // call (below) is the deterministic trigger for fast runs, but on a LONG
    // single iteration it would never re-fire, freezing the fused multi-host
    // viewer (peers never refresh). Folding sync into the heartbeat keeps peers
    // live mid-iteration. The flag is a process-stable env flag, so snapshot it
    // once here. The double-fire is intentional + benign: syncStatusOnce is
    // idempotent (publish → fetch → setPeers).
    const syncOnHeartbeat = crossHostSyncEnabled();
    // STAGED (Workstream 1b, deliberately NOT wired here): a periodic in-flight
    // checkpoint would protect an `agent/issue-<N>` worktree against a hard crash
    // (SIGKILL/OOM) between iterations. The naive implementation — `git add -A` +
    // `git commit` on the live worktree every heartbeat — RACES the implementer
    // agent working in that same worktree (shared index.lock; moves the branch
    // HEAD out from under the agent; can commit a half-written tree). It needs a
    // non-invasive snapshot (e.g. `git stash create` → push the SHA, never moving
    // HEAD) with its own concurrency tests before it can run against live work.
    // The reusable helper (`checkpointInflightWork`) this used to call was
    // REMOVED (commit a4eab4b) along with the heartbeat wiring — it does not
    // exist in the tree today. A future non-invasive redesign has to be built
    // from scratch (git history has the old version); the FF-refused strand
    // backup (1a) and `--now` staging backup (1c) — both run when no agent is
    // concurrently active — ship in this pass.
    //
    // CRASH-RECOVERY UPDATE (Fix 2): the hard-crash gap this live
    // heartbeat would have closed is NOW closed at the OTHER end — the
    // launch-time reaper at startup (see the "LAUNCH-TIME REAPER" block above,
    // right after the single-instance lock). Because it runs before any agent is
    // spawned, it sidesteps the shared-worktree race entirely: a run killed by
    // SIGKILL/OOM/sleep is reaped on the NEXT launch (WIP pushed, lease
    // released) instead of mid-run by a heartbeat. So Workstream 1b (the
    // live-heartbeat approach) remains deliberately un-built; the crash-recovery
    // need it targeted is served at launch, not via heartbeat.
    leaseHeartbeat = setInterval(() => {
      void deps.renewLeases();
      if (syncOnHeartbeat) {
        void syncStatusOnce(statusStore, deps);
      }
    }, renewMs);
    leaseHeartbeat.unref?.();
  }

  try {
    let drained = false;
    let hotReload = false;
    let exit: RunMainResult | undefined;
    // The FIRST latched result wins — a trip, a stall, a lease-backend fault
    // and a hot-reload restart can all fire close together once `stopDealing`
    // is set (in-flight siblings keep running and can each hit their own
    // terminal condition), and the run exits with whichever reason got there
    // first.
    const latch = (r: RunMainResult): void => {
      exit ??= r;
      stopDealing = true;
    };

    // #902: rolling refill replaces the round loop. `maxConcurrent` workers
    // pull cards from a `Dealer` (lib/pool/dealer.ts) instead of every
    // worker waiting on the whole batch's slowest ticket; merges run on a
    // separate `SerialQueue` (lib/pool/serial-queue.ts) lane so a ticket's
    // slot frees the instant its pipeline resolves, not when its own merge
    // finishes; and a `CompletionBreaker` (lib/pool/breaker.ts) replaces the
    // per-round consecutiveFailures/consecutiveQuarantines/stalledStreak
    // trio with counters mutated once per COMPLETION, in the order
    // completions actually arrive. `args.iterations` keeps its internal
    // field NAME (meaning: max tickets attempted) even though the CLI flag
    // is now `--max-tickets` — renaming the field itself is deferred;
    // listed in PR #1191's deferred section.

    // Per-issue maps the old Phase 1 computed once per ROUND and Phase 2 read
    // for every issue in that same round. The pool deals cards continuously,
    // so these are now run-scoped and MERGED (never cleared) by every
    // `dealFromPlanner` call — a worker can read a card's entry any time
    // after it was dealt, however many refills later it actually starts.
    const perIssueRequiredSkillsAll = new Map<string, readonly string[]>();
    // The run's sibling-ticket briefs (`collectSiblingBriefs`), similarly
    // moved from a per-round local to a run-scoped snapshot — REPLACED
    // (not merged) on every refill from the union of what's currently in
    // flight and what was just dealt. A fail-soft prompt input (see its own
    // doc comment), so an occasionally-stale snapshot is an acceptable
    // trade for not having to track per-ticket expiry.
    let currentSiblingBriefs: readonly SiblingTicketBrief[] = [];
    // Hoisted from a per-round local (#902): an "ok" outcome's dashboard
    // accounting is deferred to `finalizeMergedAccounting`, called from
    // `landTicket` — now on the merge lane, arbitrarily later than the
    // ticket's own settlement — so the map has to outlive a single round.
    // Each issue writes its own entry once (at ship time) and `landTicket`
    // reads it once (at merge/promotion time); a shared run-scoped map is
    // safe because nothing re-reads a stale entry after that.
    const deferredOkOutcomes = new Map<
      number,
      Parameters<typeof statusStore.recordOutcome>[1]
    >();

    const mergeLane = createSerialQueue({ logError: deps.logError });
    const breaker = createCompletionBreaker({
      failureLimit: args.consecutiveFailureLimit,
      quarantineLimit: args.quarantineLimit,
      stallLimit: 3 * args.maxConcurrent,
    });
    // Processes the breaker's latched trip exactly once — every completion
    // after the trip calls this too (settleOutcome unconditionally, a
    // rejection's catch site as well), and `breaker.tripped()` keeps
    // returning the SAME trip object forever once one has latched, so
    // without this guard every remaining in-flight ticket's settlement would
    // re-log and re-comment the same trip.
    let breakerTripHandled = false;
    const handleBreakerTrip = async (): Promise<void> => {
      const trip = breaker.tripped();
      if (!trip || breakerTripHandled) return;
      breakerTripHandled = true;
      if (trip.kind === "stall") {
        deps.logError(
          `sandbox-health: ${trip.count} consecutive completions stalled — every outcome hit the wall-clock hard ceiling or SDK idle timeout. The sandbox itself is likely degraded (orbstack/docker memory pressure, network NAT broken, container daemon hung). Stop the loop, restart docker (on macOS: orbstack), then re-run. Continuing would burn tokens producing more stalls. Exiting with code 3 (sandbox-degraded abort) — distinct from code 2 (clean, just out of tickets).`,
        );
        latch({ exitCode: 3, iterationsRun, shippedIssues, quarantinedIssues });
        return;
      }
      const what =
        trip.kind === "quarantine" ? "quarantine(s)" : "consecutive failure(s)";
      const plainWhat = trip.kind === "quarantine" ? "quarantines" : "failures";
      breakerTrip = `${trip.count} consecutive ${what} ≥ limit ${trip.limit} (${trip.flag})`;
      breakerTripPlain = `${trip.count} ${plainWhat} in a row`;
      deps.logError(`Circuit breaker tripped: ${breakerTrip}`);
      if (lastFailingIssue !== undefined) {
        try {
          await deps.comment(
            lastFailingIssue,
            `sandcastle-loop circuit breaker tripped after ${breakerTrip}. ` +
              `Stopping the loop. Investigate before re-queuing this or other issues.`,
          );
        } catch (err) {
          deps.logError(
            `comment-on-breaker-trip failed: ${(err as Error).message}`,
          );
        }
      }
      // `statusStore.finish("unhealthy")` happens once, uniformly for every
      // latched exit, in the pool-drain tail below.
      latch({ exitCode: 1, iterationsRun, shippedIssues, quarantinedIssues });
    };

      const landTicket = async (
        batch: Completed[],
      ): Promise<RunMainResult | undefined> => {
      // #902: the rolling pool always lands one ticket at a time (`batch` is a
      // single-element array; the internal Phase 3-5 logic below still reads
      // it as a list, unchanged, so a one-line `BRANCHES`/`ISSUES` still fills
      // the merge prompts — moving those prompts to a true single-ticket
      // shape is deferred; listed in PR #1191's deferred section).
      // `landingIssueNum` replaces the old per-ROUND `it` this body
      // used for logging and the `bad-merge-*` staging-reset tag; there is no
      // round anymore, so it is this ticket's own issue number instead.
      const landingIssueNum = Number(batch[0]!.issue.id);
      // Phase 3: merge — only if at least one branch shipped. `selectMergeBatch`
      // excludes the #1110 case-2 auto-close, which reports `"ok"` for the ship
      // accounting but built no branch (see its doc comment for the two bugs
      // that exclusion prevents).
      const mergedBranches = selectMergeBatch(batch);
      if (mergedBranches.length === 0) {
        deps.log("no shipped branches this cycle — skipping merge phase");
        return;
      }
      // Run-level activity: merging starts here (after the stall/circuit-breaker
      // gates, which `return` without finishing — labelling earlier would freeze
      // the feed on "merging"). Covers the staging prelude + the merger run.
      statusStore.setActivity("merging");
      const mergedIssueNums = mergedBranches
        .map((b) => Number(b.id))
        .filter((n) => Number.isInteger(n) && n > 0);
      const branchesArg = mergedBranches.map((b) => `- ${b.branch}`).join("\n");
      const issuesArg = mergedBranches
        .map((i) => `- #${i.id}: ${i.title}`)
        .join("\n");

      // Staging prelude (default). Tag the previous iteration's bad staging
      // tip if the last iteration left one, then hard-reset the dedicated
      // staging worktree to the current integration tip so the merger lands
      // its work on `integration-candidate` rather than directly on the
      // integration branch. The staging worktree (set up at boot by
      // `ensureStagingWorktree`) is permanently checked out on
      // `integration-candidate`, so this is structurally race-free across
      // iterations — unlike the prior `git branch -f` against the launch
      // worktree which collided with itself on iter 2+.
      if (args.stagingEnabled) {
        if (stagingWorktreePath === "") {
          throw new Error(
            `staging is enabled but stagingWorktreePath is unset — ensureStagingWorktree() must be called during boot before runMain. ` +
              `If you're invoking runMain from a test, call __setStagingWorktreePathForTests() first or set stagingEnabled: false.`,
          );
        }
        resetStagingToIntegrationTip(
          args.repoRoot,
          stagingWorktreePath,
          args.branch,
          lastFailedStagingIssue,
          (s) => deps.log(s),
          (s) => deps.logError(s),
        );
        lastFailedStagingIssue = null;
      }
      // Under the structural fix (ensureStagingWorktree + throw-on-failure
      // in the prelude above), `args.stagingEnabled` is the authoritative
      // signal — there's no longer a "staging requested but degraded"
      // intermediate state. Keep this alias for downstream readability.
      const stagingActive = args.stagingEnabled;

      // Bounded 2-attempt merger. Attempt 1 uses `args.mergerModel`; if it
      // throws AND an escalation rung exists, discard attempt-1's partial
      // merge (reset staging back to the integration tip) and re-dispatch the
      // merger on the escalation model. Capped at 2. With an empty escalations
      // array this is byte-identical to the legacy single dispatch (one
      // attempt, same catch log, no reset). If attempt 2 also fails, mergerOk
      // stays false and the existing quarantine path runs unchanged.
      const mergerEscalations = roleModelsFor(args).merger.escalations;
      const maxMergerAttempts = mergerEscalations.length > 0 ? 2 : 1;
      const mergerOk = await runWithEscalation({
        firstModel: args.mergerModel,
        escalations: mergerEscalations,
        // Throw-based ladder: `run` catches internally and reports success as a
        // boolean so the marker-inspecting scaffold can drive it. A successful
        // dispatch returns `true` (shouldRetry=false stops the loop, mirroring
        // the old `break`); a throw returns `false` and logs the same catch line.
        run: async (mergerModel, mergerAttempt): Promise<boolean> => {
          try {
            const mergerResult = await timeRole(timingLedger, "merger", () =>
              deps.run({
                name: "merger",
                maxIterations: 1,
                model: mergerModel,
                promptFile: "./.sandcastle/merge-prompt.md",
                idleTimeoutSeconds: args.implementerTimeoutSec,
                cwd: stagingActive ? stagingWorktreePath : undefined,
                promptArgs: {
                  ITERATION: String(landingIssueNum),
                  BRANCHES: branchesArg,
                  ISSUES: issuesArg,
                },
              }),
            );
            // Phase-1 cost telemetry (best-effort). Top-level session metadata is
            // forwarded now, so this credits in production — see the planner-site note.
            await captureRoleCost(
              costLedger,
              "merger",
              mergerResult,
              deps.logError,
            );
            return true;
          } catch (err) {
            const willRetry = mergerAttempt < maxMergerAttempts;
            deps.logError(
              `merge phase threw${mergerAttempt > 1 ? ` (attempt ${mergerAttempt})` : ""}: ` +
                `${(err as Error).message} — ` +
                (willRetry
                  ? `retrying merger on escalation model`
                  : `continuing to next iteration`),
            );
            return false;
          } finally {
            // Stall-watchdog false-kill guard: this merger dispatch is bounded by
            // `withHardCeiling`, so it either completed or was ceiling-killed here.
            // Bump the genuine-progress clock so a two-attempt escalation ladder
            // (up to 2 x 60 min under the single `setActivity("merging")` bump)
            // keeps `lastProgressAt` fresh and cannot be judged stalled. Safe: a
            // hang INSIDE the dispatch never reaches this `finally`.
            statusStore.noteProgress();
          }
        },
        shouldRetry: (ok) => !ok,
        // On a retry, discard attempt-1's partial merge by resetting the
        // dedicated staging worktree back to the integration tip before the
        // escalated merger runs. `lastFailedStagingIssue` is already null
        // here (the prelude cleared it), so no bad-merge tag is written.
        beforeRetry: () => {
          if (stagingActive) {
            resetStagingToIntegrationTip(
              args.repoRoot,
              stagingWorktreePath,
              args.branch,
              lastFailedStagingIssue,
              (s) => deps.log(s),
              (s) => deps.logError(s),
            );
          }
        },
      });

      // After a successful merger, flip every shipped issue's label from
      // `in-progress` → `merged-to-staging`. Skip when staging is off
      // (legacy flow already flipped them straight to `done` inside
      // runIssuePipeline).
      if (stagingActive && mergerOk) {
        for (const n of mergedIssueNums) {
          try {
            await deps.markMergedToStaging(n);
          } catch (err) {
            deps.logError(
              `[issue=${n}] markMergedToStaging failed: ${(err as Error).message}`,
            );
          }
        }
        // The open-issue listing the blocked-by gate reads just changed. See
        // `invalidateOpenIssueMemoAfterShipLabels` for why every ship-time
        // label flip has to say so.
        invalidateOpenIssueMemoAfterShipLabels("merged-to-staging");
      }

      // Phase 4: post-merge review. Under staging, the verdict GATES the
      // fast-forward of the integration branch and triggers the fixer
      // ladder. Under --no-staging, it stays advisory (today's behavior).
      // Render the per-issue skill-invocation map for the post-merge reviewer
      // prompt. The post-merge audit sees, per issue, which skills the shipped
      // implementer actually invoked (or that none were captured) — enabling
      // the same skill-discipline checks at the rollup level that the per-issue
      // reviewer already does. Built once per iteration and reused by both the
      // first-pass and (if it runs) the escalated reviewer pass.
      statusStore.setActivity("reviewing"); // run-level: post-merge review + fixer ladder
      const skillsInvokedByIssue = new Map<string, readonly string[]>();
      for (const c of batch) {
        // Exclude the #1110 case-2 auto-close: it reports "ok" but is not in
        // the merged batch this reviewer audits, so a `#N: (none)` row for it
        // would list an issue whose code is not in the diff under review.
        if (
          c.outcome.status === "ok" &&
          !builtNothing(c.outcome.finalMarker)
        ) {
          skillsInvokedByIssue.set(
            String(c.issue.id),
            c.outcome.skillsInvoked ?? [],
          );
        }
      }
      // Render rule: numeric keys (issue IDs) keep the historical `#N:`
      // prefix so the reviewer prompt's `#N: (none)` language still
      // matches. Non-numeric keys — currently just `fixer` for the
      // post-merge-fixer's combined invocations across the rollup —
      // render as a bare label (`fixer: ...`) so the reviewer can tell
      // at a glance which row is per-issue vs. shared-across-issues.
      const renderSkillsInvokedByIssue = (
        m: ReadonlyMap<string, readonly string[]>,
      ): string =>
        m.size === 0
          ? "(no skill data captured)"
          : Array.from(m.entries())
              .map(([id, skills]) => {
                const label = /^\d+$/.test(id) ? `#${id}` : id;
                return `${label}: ${skills.length === 0 ? "(none)" : skills.join(", ")}`;
              })
              .join("\n");

      // Shared runner for both the default-model first pass and the
      // escalated re-run after the fixer. Returns BOTH marker and stdout
      // — the fixer pass needs stdout (verbatim reviewer concerns), so a
      // marker-only helper forced an inline duplicate. On a thrown call
      // we log loudly and return empty strings so the caller falls
      // through to the same "no marker emitted" path it would have taken
      // for a non-emitting reviewer; the iteration loop continues.
      const runPostMergeReviewer = async (
        model: string,
        skillsInvokedByIssueArg: ReadonlyMap<
          string,
          readonly string[]
        > = new Map(),
        retryOnStall: boolean = true,
      ): Promise<{ marker: string; stdout: string }> => {
        try {
          const r = await timeRole(timingLedger, "postMergeReviewer", () =>
            deps.run({
              name: "post-merge-reviewer",
              maxIterations: 1,
              model,
              promptFile: "./.sandcastle/post-merge-review-prompt.md",
              idleTimeoutSeconds: args.reviewerTimeoutSec,
              cwd: stagingActive ? stagingWorktreePath : undefined,
              promptArgs: {
                ITERATION: String(landingIssueNum),
                MERGE_DEPTH: String(mergedBranches.length),
                INTEGRATION_BRANCH: args.branch,
                BRANCHES: branchesArg,
                ISSUES: issuesArg,
                SKILLS_INVOKED_BY_ISSUE: renderSkillsInvokedByIssue(
                  skillsInvokedByIssueArg,
                ),
              },
            }),
          );
          // Phase-1 cost telemetry (best-effort). Top-level session metadata is
          // forwarded now, so this credits in production — see the planner-site note.
          await captureRoleCost(
            costLedger,
            "postMergeReviewer",
            r,
            deps.logError,
          );
          // "contains" mode: the reviewer sometimes writes its verdict marker
          // inside a closing sentence ("Review is done: POST_MERGE_ALL_CLEAR.")
          // rather than on a bare line — that wrongly quarantined whole merged
          // batches (#416/#417). Accept the marker embedded in the last line,
          // fail-closed if both markers appear. Other roles keep stricter modes.
          const marker = extractMarker(
            r.stdout,
            ["POST_MERGE_ALL_CLEAR", "POST_MERGE_ISSUES_FOUND"] as const,
            { mode: "contains" },
          );
          deps.log(`post-merge review: ${marker || "(no marker emitted)"}`);
          return { marker, stdout: r.stdout };
        } catch (err) {
          const msg = (err as Error).message;
          // Stall-class errors (SDK idle timeout, hard ceiling, etc.) are
          // environmental — the reviewer never got a chance to verdict.
          // Quarantining merged issues here destroys good code (observed on
          // a real run). A MarkerNotFoundError is the sibling
          // failure: the reviewer ran but ended its single turn WITHOUT a
          // verdict — it deferred / "stood by" instead of emitting a marker
          // (another real run), which the prompt now forbids but we
          // survive once if it slips through. Both classes are non-verdicts
          // on clean code, so retry once on the same model before giving up.
          const isNoVerdict = err instanceof MarkerNotFoundError;
          if (retryOnStall && (STALL_RE.test(msg) || isNoVerdict)) {
            deps.logError(
              `post-merge review ${isNoVerdict ? "emitted no verdict" : "stalled"} (${msg}) — retrying once on same model`,
            );
            return runPostMergeReviewer(model, skillsInvokedByIssueArg, false);
          }
          deps.logError(
            `post-merge review threw: ${msg} — falling through to quarantine of merged issues`,
          );
          return { marker: "", stdout: "" };
        } finally {
          // Stall-watchdog false-kill guard: each post-merge reviewer dispatch
          // is bounded by `withHardCeiling`. Bump the genuine-progress clock on
          // its completion so the "reviewing" step — first review plus up to two
          // fixer-ladder re-reviews, all under one `setActivity("reviewing")`
          // bump — keeps `lastProgressAt` fresh across a >90-min healthy run. The
          // retry path recurses, and each recursion's own `finally` bumps too, so
          // one bump lands per bounded dispatch. Safe: a hang inside the dispatch
          // never reaches this `finally` (it aborts at the ceiling first).
          statusStore.noteProgress();
        }
      };

      // First pass uses the default model.
      let { marker: postMergeMarker, stdout: postMergeFeedback } =
        await runPostMergeReviewer(
          args.postMergeReviewerModel,
          skillsInvokedByIssue,
        );

      // Fix-ladder. Only runs under staging AND only when the first pass
      // flagged ISSUES_FOUND. Bounded 2-pass loop:
      //   - pass 1: fixer on `postMergeFixer.default` (cheap first pick) →
      //             re-review → if ALL_CLEAR, done.
      //   - pass 2: only when pass-1 re-review still flags ISSUES_FOUND AND an
      //             escalation rung exists — fixer on
      //             `escalationForAttempt(postMergeFixer.escalations, 2)` →
      //             re-review → if ALL_CLEAR, done; else quarantine as today.
      // Each fixer pass is threaded the LATEST re-review feedback (we re-capture
      // the re-review's stdout into `postMergeFeedback` between passes). An
      // empty escalations array collapses this to a single pass — byte-identical
      // to the legacy one-fix-one-review behavior. The re-review always runs on
      // the reviewer's escalation model, as before.
      //
      // #972 gap 6: capture the staging tip BEFORE the fixer ladder runs. The
      // fixer commits code directly on `integration-candidate` after every
      // per-issue proof gate has run; its NET diff (this sha -> the tip after
      // the ladder) is measured below and routed through the same never-waived
      // removed-coverage gate the per-issue ship path uses, so a fixer that
      // deletes a test cannot fast-forward the round. Read now (not only inside
      // the `if`) so the after-tip comparison is against the certified tip even
      // when the fixer never runs — in which case before === after, a provable
      // empty diff that passes for free.
      const stagingTipBeforeFixer = resolveRefSha(args.repoRoot, STAGING_BRANCH);
      if (stagingActive && postMergeMarker === "POST_MERGE_ISSUES_FOUND") {
        // Route the fixer model through the run's backend, via the
        // SAME `roleModelsFor(args)` source every other role uses — never a
        // second derivation off the model, which could split from args.backend.
        const fixerSrc = roleModelsFor(args);
        const fixerEscalations = fixerSrc.postMergeFixer.escalations;
        // Marker-inspecting ladder. Each `run` = fixer dispatch + re-review;
        // it threads the LATEST re-review feedback (outer `postMergeFeedback`)
        // into the fixer prompt and re-captures BOTH marker and stdout back
        // into the outer `let`s so a following pass sees fresh feedback and the
        // promotion decision below reads the final verdict. `shouldRetry`
        // escalates only when the re-review still flags ISSUES_FOUND AND the
        // fixer itself did not throw — a thrown fixer ran no re-review, leaves
        // `postMergeMarker` at ISSUES_FOUND, and must fall straight through to
        // quarantine (no retry), exactly as the legacy `break` did.
        await runWithEscalation({
          firstModel: fixerSrc.postMergeFixer.default,
          escalations: fixerEscalations,
          shouldRetry: (r: { marker: string; fixerThrew: boolean }) =>
            r.marker === "POST_MERGE_ISSUES_FOUND" && !r.fixerThrew,
          run: async (
            fixerModel,
            fixerPass,
          ): Promise<{ marker: string; fixerThrew: boolean }> => {
            deps.log(
              `post-merge fix-loop: spawning fixer (pass ${fixerPass}, model=${fixerModel}) on ${STAGING_BRANCH}`,
            );
            let fixerOk = true;
            let fixerResult: RunHandle | undefined;
            try {
              fixerResult = await timeRole(timingLedger, "postMergeFixer", () =>
                deps.run({
                  name: "post-merge-fixer",
                  maxIterations: 1,
                  model: fixerModel,
                  promptFile: "./.sandcastle/post-merge-fix-prompt.md",
                  idleTimeoutSeconds: args.implementerTimeoutSec,
                  cwd: stagingWorktreePath,
                  promptArgs: {
                    ITERATION: String(landingIssueNum),
                    INTEGRATION_BRANCH: args.branch,
                    BRANCHES: branchesArg,
                    ISSUES: issuesArg,
                    POST_MERGE_FEEDBACK: postMergeFeedback.slice(0, 8000),
                  },
                }),
              );
            } catch (err) {
              fixerOk = false;
              deps.logError(
                `post-merge fixer threw: ${(err as Error).message} — falling through to quarantine`,
              );
            } finally {
              // Stall-watchdog false-kill guard: this fixer dispatch is bounded
              // by `withHardCeiling`, so it either completed or was ceiling-killed
              // here. Bump the genuine-progress clock so a fixer pass under the
              // single `setActivity("reviewing")` bump keeps `lastProgressAt`
              // fresh (the following re-review bumps again via
              // runPostMergeReviewer). Safe: a hang inside the dispatch never
              // reaches this `finally`.
              statusStore.noteProgress();
            }
            // A thrown fixer leaves `postMergeMarker` at ISSUES_FOUND and does NOT
            // retry (no re-review ran) — fall through to quarantine as before.
            if (!fixerOk) return { marker: postMergeMarker, fixerThrew: true };
            // Capture the fixer's Skill() invocations from its session JSONL
            // — same pattern as runImplementer (see
            // extractSkillInvocationsFromSession). The fixer is required
            // by post-merge-fix-prompt to invoke the same Required tools
            // as the original implementer for each issue it touches; the
            // re-review (next call below) needs to see those invocations
            // to credit them. Without this extraction, the fixer can
            // comply OR skip with no observable difference at re-review.
            //
            // Attribution: the fixer's work spans multiple issues in the
            // rollup, and the host has no clean way to attribute an
            // individual tool_use to one of those issues. We stash the
            // combined list under a synthetic `"fixer"` key — the
            // reviewer prompt treats this row as shared across all
            // affected issues (see post-merge-review-prompt.md).
            const fixerSkillsInvoked: string[] = [];
            for (const fxIt of fixerResult?.iterations ?? []) {
              for (const name of await resolveAndExtractSkillInvocations(
                fxIt,
                fixerModel,
              )) {
                fixerSkillsInvoked.push(name);
              }
            }
            skillsInvokedByIssue.set("fixer", fixerSkillsInvoked);
            // Phase-1 cost telemetry (best-effort). Top-level session metadata is
            // forwarded now, so this credits in production — see the planner-site note.
            await captureRoleCost(
              costLedger,
              "postMergeFixer",
              fixerResult,
              deps.logError,
            );

            // Post-merge fixer skill-discipline telemetry (DEMOTED — was a hard
            // gate before, but the gate had the exact gaming pattern that
            // motivated ADR 0006's pivot for the per-issue implementer: the
            // fixer commit can apply real principle-aligned work AND narrate
            // "Skills invoked: impeccable, polish" in its commit message, yet
            // still register zero `Skill()` tool calls. Counting tool calls
            // graded the process, not the output. The per-issue reviewer
            // sub-agent already gates each diff before it reaches the rollup;
            // the rollup-level gate was catching ritual non-compliance, not
            // actual quality regressions, and forced manual `git merge --no-ff
            // integration-candidate` recovery on every iteration. Now: compute
            // the UNION across all rollup issues and log the missing-vs-invoked
            // list for triage, but always proceed to the re-review dispatch.
            const unionRequiredSet = new Set<string>();
            const unionRequired: string[] = [];
            for (const b of mergedBranches) {
              const req = perIssueRequiredSkillsAll.get(b.id);
              if (req === undefined) continue;
              for (const s of req) {
                if (unionRequiredSet.has(s)) continue;
                unionRequiredSet.add(s);
                unionRequired.push(s);
              }
            }
            if (unionRequired.length > 0) {
              const { missing } = validateRequiredSkillsInvoked(
                unionRequired,
                fixerSkillsInvoked,
              );
              if (missing.length > 0) {
                runCounters.noteSkillMiss("postMergeFixer", missing.length);
                deps.log(
                  `[skill-discipline] WARN post-merge-fixer missed: ` +
                    `${missing.join(", ")}; invoked: ` +
                    `${fixerSkillsInvoked.length === 0 ? "(none)" : fixerSkillsInvoked.join(", ")} ` +
                    `(telemetry only — per-issue reviewer already gated each diff; ` +
                    `re-review will catch rollup-level regressions)`,
                );
              }
            }

            const reviewerEscModel =
              roleModelsFor(args).postMergeReviewer.escalations[0] ??
              args.postMergeReviewerModel;
            deps.log(
              `post-merge fix-loop: re-running reviewer (model=${reviewerEscModel}) on fixed staging`,
            );
            // Re-capture BOTH marker and stdout: the next fixer pass (if any)
            // must be threaded THIS re-review's feedback, not the stale first pass.
            ({ marker: postMergeMarker, stdout: postMergeFeedback } =
              await runPostMergeReviewer(
                reviewerEscModel,
                skillsInvokedByIssue,
              ));
            return { marker: postMergeMarker, fixerThrew: false };
          },
        });
      }

      // #972 gap 6 — the fixer's own diff must clear the never-waived
      // removed-coverage gate before it can ship. Measured ONLY when we would
      // otherwise promote (marker ALL_CLEAR): a round that already failed
      // certification quarantines below regardless, so there is nothing to gate.
      // The measurement spans the whole fixer ladder (before-tip -> current
      // staging tip) so a deletion on an EARLIER pass cannot be laundered by a
      // clean final pass, exactly as the per-issue ship gate spans every commit.
      // Fail-closed and fail-quiet inside `postMergeFixerProofRefusal`; it never
      // throws, so a git hiccup cannot crash the run.
      let fixerProofRefusal: ProofGateRefusal | undefined;
      if (stagingActive && postMergeMarker === "POST_MERGE_ALL_CLEAR") {
        fixerProofRefusal = postMergeFixerProofRefusal({
          repoRoot: args.repoRoot,
          fromSha: stagingTipBeforeFixer,
          toSha: resolveRefSha(args.repoRoot, STAGING_BRANCH),
          logError: deps.logError,
        });
        if (fixerProofRefusal !== undefined) {
          deps.logError(
            `[sandcastle it=${landingIssueNum}] post-merge fixer output REFUSED by the ` +
              `proof gate — NOT promoting this round: ${fixerProofRefusal.message}`,
          );
        }
      }

      // Promotion / quarantine decision.
      let ffSucceeded = false;
      if (stagingActive) {
        if (
          postMergeMarker === "POST_MERGE_ALL_CLEAR" &&
          mergerOk &&
          fixerProofRefusal === undefined
        ) {
          // Fast-forward integration, then promote all merged-to-staging
          // issues to done.
          ffSucceeded = fastForwardIntegration(
            args.repoRoot,
            args.branch,
            (s) => deps.log(s),
            (s) => deps.logError(s),
          );
          if (ffSucceeded) {
            const summary =
              `[sandcastle it=${landingIssueNum}] integration ${args.branch} fast-forwarded; ` +
              `staging certified by post-merge reviewer`;
            // Fix 3: inline-CAS fence immediately before the
            // GitHub promotion + lease release. Review Fix 5 — an honest
            // account of what this fence does and does NOT guard:
            // `fastForwardIntegration` (above) ALREADY merged staging (every
            // issue's commingled code) onto this host's integration branch, so
            // the fence CANNOT un-land code. What it gates is the downstream
            // GitHub promote (`promoteStagingToDone`) and the lease release: an
            // issue whose fence fails is EXCLUDED from the promote and flagged
            // needs-human, keeping its lease (so a peer won't double-promote via
            // GitHub). Correctness rests on per-host-suffixed
            // integration branches: a stray land another host already made is a
            // wasted end-of-run merge, NOT corruption — and a true pre-FF
            // per-issue exclusion is impossible (staging is one commingled
            // branch). Flag OFF ⇒ fenceIssue returns true and
            // fencedIssueNums === mergedIssueNums.
            // Review Fix 4: a fence CAS can THROW a LeaseBackendError on an
            // auth/network fault (not a lost lease). That is systemic — surface
            // the SAME loud fatal (exitCode 2 + remediation) as the acquire-path
            // Fix 2 rather than letting it escape runMain as a raw exit-1 stack
            // trace. A lost-lease (fenceIssue returns false) stays the
            // needs-human exclusion below — only a THROWN backend error halts.
            const fencedIssueNums: number[] = [];
            try {
              for (const n of mergedIssueNums) {
                // Flag OFF ⇒ fenceIssue returns true (pass).
                if (await deps.fenceIssue(n)) {
                  fencedIssueNums.push(n);
                } else {
                  // TRANSIENT, not human-triage: another host won the lease, so
                  // this is a mechanical race, not a review quarantine. Release
                  // the label back to `ready-for-agent` so the owner/next run
                  // re-claims it, and park it in the transient `needs-rerun`
                  // phase (informational row, does NOT bump the "needs you"
                  // pill). Reserve `needs-human` for REAL quarantines.
                  deps.logError(
                    `[issue=${n}] lease lost before promotion (inline fence failed) — ` +
                      `NOT shipping this round; releasing label for re-claim (needs-rerun).`,
                  );
                  try {
                    await deps.release(
                      n,
                      `lease lost before promotion — another host may own this issue; ` +
                        `released for re-claim`,
                    );
                  } catch (relErr) {
                    deps.logError(
                      `[issue=${n}] release after lost-lease fence failed (non-fatal): ` +
                        `${(relErr as Error).message}`,
                    );
                  }
                  statusStore.setIssuePhase(
                    n,
                    "needs-rerun",
                    `lease lost before promotion — released to ready-for-agent for re-claim`,
                  );
                }
              }
            } catch (err) {
              if (err instanceof LeaseBackendError) {
                deps.logError(
                  `Halting: cross-host lease backend authentication/network ` +
                    `failure at staging promotion — the fence ref push cannot ` +
                    `reach origin. Fix \`gh auth setup-git\` / network ` +
                    `connectivity and re-run. git stderr: ${err.stderr}`,
                );
                return {
                  exitCode: 2,
                  iterationsRun,
                  shippedIssues,
                  quarantinedIssues,
                };
              }
              throw err;
            }
            try {
              const promoteRes = await deps.promoteStagingToDone(
                fencedIssueNums,
                summary,
              );
              if (promoteRes.failed.length > 0) {
                deps.logError(
                  `promoteStagingToDone failed for issues: ${promoteRes.failed.join(", ")}`,
                );
              }
              // Promotion actually advanced the integration branch — NOW the
              // deferred "ok" issues are truly shipped. Record the terminal
              // merged outcome we withheld at ship time (and flag any the FF
              // landed but GitHub promotion couldn't finish). See
              // finalizeMergedAccounting.
              finalizeMergedAccounting(
                statusStore,
                fencedIssueNums,
                deferredOkOutcomes,
                promoteRes.failed,
                args.branch,
              );
              // The fast-forward landed these on the run branch: NOW they
              // shipped (even where the GitHub label flip failed after).
              logLanded(fencedIssueNums);
              // Cleanup hook 1 (ship-path): these issues' code has
              // reached the integration branch (both the promoted-ok and the
              // failed-GitHub-promotion cases — the FF landed either way), so
              // their WIP checkpoint refs are now stale. Best-effort delete
              // them so no stale ref resurrects merged work on a later reuse.
              // Gated on sync (WIP refs only exist when it's ON); a fault is
              // logged non-fatal and the loop keeps running.
              await cleanupShippedWipRefs(
                fencedIssueNums,
                crossHostSyncEnabled(),
                args.repoRoot,
                runGitLease,
                deps.logError,
              );
              // Cross-host lease: the staging path HELD each ok
              // issue's lease past ship time (the accounting loop skipped the
              // release for staging-ok). Now that promotion has actually landed
              // the code, hand the lease back — but only for issues that truly
              // promoted. Issues in `promoteRes.failed` are flagged needs-human
              // by finalizeMergedAccounting and keep their lease (it expires).
              // Fence-excluded issues also keep the lease released? No — the
              // fence already dropped their registry entry, so release is a
              // registry-guarded no-op there.
              for (const n of fencedIssueNums) {
                if (!promoteRes.failed.includes(n)) {
                  await deps.releaseIssueLease(n);
                }
              }
            } catch (err) {
              deps.logError(
                `promoteStagingToDone threw: ${(err as Error).message}`,
              );
            }
            // THE FLIP THAT UNBLOCKS SIBLINGS: `promoteStagingToDone` moves
            // every promoted issue to `shipped-local`, which is one of
            // `BLOCKER_RESOLVING_LABELS` — so a dependent declaring
            // `Blocked-by: #this` becomes dealable at this exact instant.
            // Unconditional (not gated on `promoteRes.failed`), because a
            // partial promote still moved SOME labels, and because the throw
            // path above may have flipped some before failing.
            invalidateOpenIssueMemoAfterShipLabels("shipped-local");
            // Cross-host LANE SYNC publish hook (Task B). The
            // fast-forward promoted this host's integration branch to the shared
            // ship line; publish it to this host's lane ref so a peer can sync
            // it next cycle. ONLY on the promote-SUCCESS path (never in the
            // FF-refused `else` below — that work is stranded, not shipped).
            // Gated on the opt-in flag. A LaneSyncError is a real fault (code
            // did not reach origin) surfaced LOUD but never crashes the loop.
            if (syncEnabled) {
              await publishLaneOrLog(deps, args.branch, "promoting staging");
            }
            lastFailedStagingIssue = null;
          } else {
            // Fast-forward refused — treat as a staging failure. The merged +
            // post-merge-reviewer-certified work is now stranded on
            // `integration-candidate` and the integration branch was NOT
            // advanced. Flag the whole run unhealthy so it can't exit
            // `done`/0 and silently lie that the work shipped (audit #4).
            lastFailedStagingIssue = landingIssueNum;
            promotionFailed = true;
            deps.logError(
              `[sandcastle it=${landingIssueNum}] final promotion to ${args.branch} FAILED — ` +
                `certified work is stranded on ${STAGING_BRANCH}; run will exit ` +
                `unhealthy (non-zero). Human triage required.`,
            );
            // WORKSTREAM 1 (1a) — DON'T lose the stranded work. The whole policy
            // (pin the certified tip to durable refs BEFORE any lease is
            // released → publish the lane when sync is on → surface each issue to
            // a human → release its lease) lives in `handleStrandedPromotion`,
            // unit- and real-git-tested in tests/strand-backup.test.ts. It never
            // throws: the run's unhealthy exit is decided above, not by it.
            await handleStrandedPromotion(
              runGitLease,
              {
                log: (line) => deps.log(line),
                logError: (line) => deps.logError(line),
                recordQuarantineOutcome: (n, detail) =>
                  statusStore.recordOutcome(n, {
                    status: "quarantined",
                    finalMarker: detail,
                  }),
                quarantine: (n, reason, opts) =>
                  deps.quarantine(n, reason, opts),
                // Issue #923. Routed through `reportStopOutsidePipeline` so
                // the DURABLE record is written as well as the ticket — a
                // strand recorded on GitHub but missing from
                // `.sandcastle/telemetry/issues.jsonl` would be uncountable,
                // and a strand is the one stop where a blind re-queue
                // discards work that already passed review.
                reportStop: async (n, opts) => {
                  await reportStopOutsidePipeline(n, {
                    label: opts.label,
                    detail: opts.detail,
                  });
                },
                releaseIssueLease: (n) => deps.releaseIssueLease(n),
                publishLane: (branch, context) =>
                  publishLaneOrLog(deps, branch, context),
              },
              {
                repoRoot: args.repoRoot,
                stagingBranch: STAGING_BRANCH,
                integrationBranch: args.branch,
                issues: mergedIssueNums,
                syncEnabled: crossHostSyncEnabled(),
              },
            );
          }
        } else {
          // Staging failed certification (post-fixer too) OR merger failed
          // OR no marker OR — #972 gap 6 — the fixer's OWN diff was refused by
          // the removed-coverage gate. Quarantine every merged-to-staging issue,
          // leave staging at its current tip (next iteration's reset will tag
          // it as `bad-merge-issue-<N>`).
          //
          // The fixer refusal is its own cause, distinct from a reviewer
          // rejection, so it gets its own reason + explanation: the round's code
          // passed review, but the fixer deleted test coverage (or its diff
          // could not be measured), and shipping unmeasured coverage loss is the
          // exact failure this gate exists to stop. Same blast radius as any
          // post-merge stop: the whole round, because staging is one commingled
          // branch.
          const reason =
            fixerProofRefusal !== undefined
              ? `[sandcastle it=${landingIssueNum}] the post-merge fixer's OWN diff was ` +
                `refused by the proof gate (it removed test coverage, or its ` +
                `diff could not be measured) — quarantining all issues that ` +
                `landed on ${STAGING_BRANCH} this iteration. Integration ` +
                `${args.branch} NOT advanced. ${fixerProofRefusal.message}`
              : `[sandcastle it=${landingIssueNum}] staging post-merge reviewer marked ` +
                `${postMergeMarker || "(no marker)"} after fixer pass — ` +
                `quarantining all issues that landed on ${STAGING_BRANCH} ` +
                `this iteration. Integration ${args.branch} NOT advanced.`;
          deps.logError(reason);
          for (const n of mergedIssueNums) {
            try {
              await deps.quarantine(n, reason);
              quarantinedIssues.push(n);
            } catch (err) {
              deps.logError(
                `[issue=${n}] staging-failure quarantine threw: ${(err as Error).message}`,
              );
            }
            // Issue #923, found by the review of the first pass. This site
            // sits OUTSIDE `runIssuePipeline`, so it was outside that
            // ticket's own count of sixteen — and it has the WIDEST blast
            // radius of any stop in the run: one failed round blanks EVERY
            // ticket that landed in it, not one.
            await reportStopOutsidePipeline(
              n,
              fixerProofRefusal !== undefined
                ? stagingFixerRejectedExplanation({
                    issueNumber: n,
                    siblingIssues: mergedIssueNums,
                    touchedPaths: fixerProofRefusal.touchedPaths,
                  })
                : stagingRejectedExplanation({
                    marker: postMergeMarker,
                    issueNumber: n,
                    siblingIssues: mergedIssueNums,
                  }),
            );
            // Terminal (parked for a human) — release the lease held past ship
            // time, mirroring the non-staging quarantine release above.
            await deps.releaseIssueLease(n);
          }
          lastFailedStagingIssue = landingIssueNum;
        }
      } else {
        // --no-staging leg. The Phase-3 batch merger above is what lands this
        // iteration's shipped work on `args.branch` — there's no separate
        // promotion step here, so the terminal merged-accounting write that
        // `shipTimeAccounting` withheld at ship time (see its doc comment)
        // can finalize now, the moment the merger itself resolves — closing
        // the early-"merged" window (was up to a full batch: this used to
        // record BEFORE the merger even started). No `failedPromotions`
        // concept applies here (GitHub's label flip already happened
        // per-issue inside `runIssuePipeline`, unaffected by whether the
        // merger below succeeds), so that argument is always empty.
        //
        // Deliberately unconditional on `mergerOk`: a failed merger means
        // the code never reached `args.branch`, but these issues are ALREADY
        // GitHub-`done` (the pre-existing --no-staging behavior this ticket
        // does not change) and were already unconditionally recorded merged
        // before this fix — finalizing here only moves WHEN that write
        // happens, not WHETHER. Leaving it un-finalized on merger failure
        // would instead strand these issues in `merge` phase on the
        // dashboard forever, which is a worse and NEW lie.
        finalizeMergedAccounting(
          statusStore,
          mergedIssueNums,
          deferredOkOutcomes,
          [],
          args.branch,
        );
        // The merger above is what landed them: NOW they shipped. Same
        // moment, and the same "unconditional on mergerOk" reasoning, as the
        // accounting write just above.
        logLanded(mergedIssueNums);
        // Under --no-staging the `shipped-local` flip already happened inside
        // `runIssuePipeline` (`markDone`), so `settleOutcome` has already
        // invalidated for it. Repeated here because THIS is the moment the
        // dealer's `drainMerges()` wait ends: a worker that parked on "stack
        // empty, nothing in flight, a merge is pending" refills the instant
        // this lane job returns, and it must not be served a listing cached
        // before the flip.
        invalidateOpenIssueMemoAfterShipLabels("shipped-local");
        // Cross-host LANE SYNC publish hook (Task B), --no-staging leg.
        // markDone only flips labels — this is where iteration's shipped work
        // actually reaches `args.branch`. Publish the lane HERE, after the
        // merger has advanced the launch branch, exactly ONCE per iteration
        // (never per-issue). Gated on `mergerOk` so a failed merger (nothing
        // landed) does not push a stale, no-op tip — matching the cleanup
        // gate's `!stagingActive ? mergerOk` logic below. Gated on the opt-in
        // flag. A LaneSyncError is a real fault (code did not reach origin)
        // surfaced LOUD but never crashes the loop.
        if (mergerOk && syncEnabled) {
          await publishLaneOrLog(
            deps,
            args.branch,
            "landing --no-staging merge",
          );
        }
      }

      // Phase 5: cleanup of per-issue sub-worktrees AND agent/issue-N
      // branches for issues that successfully landed THIS iteration.
      //
      // Gate logic (both conditions required):
      //   1. The specific issue's outcome.status === "ok".
      //      Quarantined / errored / deferred issues keep their branch
      //      and sub-worktree as forensic evidence.
      //   2. Mode-dependent timing:
      //      - stagingActive: AFTER post-merge review passes AND the FF
      //        to the launch branch succeeded.
      //      - !stagingActive: immediately after merger commits. Post-
      //        merge review is advisory in --no-staging and does NOT
      //        gate cleanup.
      //
      // Truth source for "which branches landed": git's own --merged
      // check, NOT the merger's output text. Partial merges (some
      // conflicts skipped) can report success while leaving branches
      // unmerged.
      const cleanupGate = stagingActive
        ? postMergeMarker === "POST_MERGE_ALL_CLEAR" && mergerOk && ffSucceeded
        : mergerOk;
      if (cleanupGate) {
        statusStore.setActivity("cleanup"); // run-level: worktree/branch cleanup
        const okIssues = batch.filter((c) => c.outcome.status === "ok");
        const candidateBranches = okIssues.map((c) => c.issue.branch);
        const landedBranches = verifyLandedBranches(
          args.repoRoot,
          args.branch,
          candidateBranches,
          (w) => deps.logError(`cleanup WARN: ${w}`),
        );
        if (landedBranches.length === 0) {
          deps.log(
            `cleanup: no agent/issue-* branches verified as merged into ${args.branch}; skipping`,
          );
        } else {
          deps.log(
            `cleanup: removing ${landedBranches.length} worktree+branch pair(s) for landed issues`,
          );
          for (const branch of landedBranches) {
            const result = cleanupIssueBranch(
              args.repoRoot,
              branch,
              args.branch,
              (w) => deps.logError(`cleanup WARN: ${w}`),
            );
            // A `skipped-*` outcome means the worktree dir or its branch
            // could not be removed. The createSandbox pre-clean now
            // self-heals stale worktrees on the next iteration, so this
            // is not a correctness failure — but the user still needs to
            // know cleanup didn't run to completion. Promote to error
            // level so the line stands out in logs.
            if (result.startsWith("skipped-")) {
              deps.logError(`cleanup ${branch}: ${result}`);
            } else {
              deps.log(`cleanup ${branch}: ${result}`);
            }
          }
        }
      }
      };
  // Extracted from the sequential accounting pass over `settled` — the
  // fulfilled branch. Kept verbatim (ledgers, bag notes, recordIssueRework,
  // lease releases): `v` is the settled promise's fulfilled value
  // (`{ issue, issueNumber, outcome }`), the same shape `s.value` had inline.
  // #902: this used to run once per issue inside a per-ROUND sequential pass,
  // guaranteeing no two issues' counter mutations could interleave. The pool
  // calls this once per COMPLETION as tickets finish in whatever order their
  // workers settle, so that guarantee now has to come from THIS function:
  // every synchronous line below (through `breaker.note`) runs to completion
  // before the first `await`, so two overlapping `settleOutcome` calls can
  // never interleave a mutation between them either — same property, new
  // reason.
  const settleOutcome = async (v: {
    issue: PlanIssue;
    issueNumber: number;
    outcome: IssueOutcome;
  }): Promise<void> => {
    issueTitles.set(v.issueNumber, v.issue.title);
    const bag = issueBags.get(v.issueNumber);
    bag?.noteOutcome(v.outcome.status);
    if (v.outcome.status === "quarantined") {
      bag?.noteQuarantine(v.outcome.finalMarker);
      runCounters.bump("quarantines");
    } else if (v.outcome.status === "deferred") {
      bag?.noteDeferral(v.outcome.finalMarker);
      runCounters.bump("deferrals");
    }
    recordIssueRework(v.issueNumber, v.outcome.status, v.outcome.postSha);
    // Spec #1334 SE: the ticket's fixed-format outcome line. A deferral is
    // an in-run retry, not an outcome, so it logs nothing. A shipped ticket
    // logs NOTHING here: its `shipped` line is written when the run lands it
    // (`logLanded`), so a ticket that later fails to land never logs both.
    // Work closed as already built never lands, so it logs its own word now.
    if (v.outcome.status === "ok") {
      if (builtNothing(v.outcome.finalMarker))
        logTicketEvent(v.issueNumber, "closed-already-built");
    } else if (v.outcome.status === "quarantined")
      logTicketEvent(v.issueNumber, "stopped", bag?.toRow().stopReason?.label);
    else if (v.outcome.status === "error") logTicketEvent(v.issueNumber, "crashed");
    // Spec #1334 SC: a failed attempt spends from the ticket's retry budget.
    // Awaited here, before the breaker bookkeeping below, would break that
    // block's "synchronous before the first await" ordering — so it is
    // started now and awaited at the end of this function.
    const retryRecord =
      v.outcome.status === "quarantined" || v.outcome.status === "error"
        ? recordFailedAttempt(
            v.issueNumber,
            v.outcome.finalMarker,
            v.outcome.status,
          )
        : undefined;

    // The completion-order breaker's two counters (#902's replacement for
    // the old per-ROUND consecutiveFailures/consecutiveQuarantines) are
    // mutated HERE, synchronously, before the lease-release await below —
    // see the function doc comment for why that ordering is load-bearing.
    const kind: CompletionKind =
      v.outcome.status === "ok"
        ? "ship"
        : v.outcome.status === "quarantined"
          ? "quarantine"
          : v.outcome.status === "deferred"
            ? "defer"
            : "error";
    breaker.note(kind, { stalled: v.outcome.stalled === true });

    if (v.outcome.status === "ok") {
      shippedIssues.push(v.issueNumber);
      // EARLIEST point a shipped ticket can stop blocking its siblings. Under
      // `--no-staging` (and on the recovery ship) `markDone` already flipped
      // this issue to `shipped-local` INSIDE the pipeline, before this
      // function ran — and the worker calls `dealer.done()` the moment it
      // returns, which wakes every parked worker into a refill. Without this
      // the refill can read a listing cached up to `OPEN_ISSUE_MEMO_TTL_MS`
      // before the flip, withhold the freshly-unblocked dependent, and print
      // a stale reason for it.
      invalidateOpenIssueMemoAfterShipLabels("shipped-local");
      if (!args.stagingEnabled) {
        await deps.releaseIssueLease(v.issueNumber);
      }
    } else if (v.outcome.status === "quarantined") {
      quarantinedIssues.push(v.issueNumber);
      lastFailingIssue = v.issueNumber;
      await deps.releaseIssueLease(v.issueNumber);
    } else if (v.outcome.status === "deferred") {
      deferredIssues.push(v.issueNumber);
      await deps.releaseIssueLease(v.issueNumber);
    } else {
      lastFailingIssue = v.issueNumber;
      erroredIssues.push(v.issueNumber);
      await deps.releaseIssueLease(v.issueNumber);
    }

    // Durability: persist telemetry now, not only at run end — a run
    // SIGKILLed overnight has no in-process cleanup, so without this the
    // whole run's per-issue cost dies with the process. Was once per ROUND;
    // rebuilt fresh from the full run-scoped ledgers every time, so calling
    // it once per COMPLETION instead is strictly more often, never partial.
    flushTelemetry();
    // The durable rework line this call just appended (`recordIssueRework`
    // above) MUST reach disk before any staging reset can run — a rework
    // commit racing a reset/fast-forward is exactly what the merge lane
    // exists to rule out, so this runs THROUGH the lane too, as its own job
    // (not bundled into the merge job below) so it still happens for a
    // completion that never merges (quarantined/deferred/error).
    void mergeLane.enqueue(
      async () => commitReworkRecords(),
      `rework-commit #${v.issueNumber}`,
    );

    // Merge = a separate serial lane, not inline here: the slot this ticket
    // held already freed the moment its pipeline resolved (the worker calls
    // `dealer.done` right after this function returns), not when its merge
    // finishes. `selectMergeBatch`'s own #1110 case-2 exclusion (the
    // `finalMarker` check) still applies, just to a one-element batch.
    if (
      v.outcome.status === "ok" &&
      !builtNothing(v.outcome.finalMarker)
    ) {
      void mergeLane.enqueue(async () => {
        const landingResult = await landTicket([
          { issue: v.issue, outcome: v.outcome },
        ]);
        if (landingResult) latch(landingResult);
      }, `merge #${v.issueNumber}`);
    }

    // Started above, before the breaker bookkeeping; never throws.
    await retryRecord;
    await handleBreakerTrip();
  };
  // Extracted from the sequential accounting pass over `settled` — the
  // rejected branch (a claim/pipeline throw, or a lease-related error).
  // Returns `leaseBackendFatal` — set locally here and handed back — instead
  // of mutating an outer flag directly, since this is now its own function
  // rather than the loop body. #902: the primary lease-contention path is now
  // handled inline in the worker (a lease loss there never reaches this
  // function at all — see `worker()`'s `!wonLease` branch); the
  // `LeaseContendedError` branch below is kept as a defensive catch-all in
  // case a lease is lost somewhere deeper in the pipeline (e.g. inside
  // `deps.claim`), exactly the scenario it originally existed for.
  const settleRejection = async (
    issue: PlanIssue,
    err: unknown,
  ): Promise<{ leaseBackendFatal: boolean }> => {
    let leaseBackendFatal = false;
    if (err instanceof LeaseContendedError) {
      // Fix 1: routine cross-host contention — a peer host got this ticket
      // first. NOT a failure: do NOT bump consecutiveFailures or set
      // lastFailingIssue (both machines deterministically pick the same top
      // tickets, so the loser contends on every one — counting these would
      // trip the breaker almost immediately). Log at low level and still
      // release (a registry-guarded no-op when we don't hold it, so it can
      // never yank the peer's lease). Modeled on the "deferred" branch.
      const issueNumber = Number(issue.id);
      deps.log(
        `[issue=${issue.id}] lease contended — another host holds it; ` +
          `skipping this ticket (not counted as a failure)`,
      );
      if (Number.isInteger(issueNumber)) {
        await deps.releaseIssueLease(issueNumber);
      }
      breaker.note("skip", { stalled: false });
    } else if (err instanceof LeaseBackendError) {
      // Fix 2: an auth/network fault touching the lease ref — NOT a rival
      // holding the lease. Systemic (every push fails), so surface it LOUD
      // and halt promptly instead of quietly counting toward the breaker.
      // Deliberately does NOT call `breaker.note` — the original round-based
      // accounting never touched the counters for this branch either, since
      // the run halts on it regardless of what the breaker would say.
      deps.logError(
        `[issue=${issue.id}] FATAL: lease git push failed — this is an ` +
          `AUTH/NETWORK fault, not contention. Check \`gh auth setup-git\` ` +
          `and network connectivity, then re-run. git stderr: ${err.stderr}`,
      );
      if (Number.isInteger(Number(issue.id))) logTicketEvent(Number(issue.id), "crashed");
      leaseBackendFatal = true; // (local to this call, returned below)
    } else {
      // claim or pre-pipeline error.
      const issueNumber = Number(issue.id);
      const msg = err instanceof Error ? err.message : String(err);
      deps.logError(`[issue=${issue.id}] outer pipeline rejected: ${msg}`);
      if (Number.isInteger(issueNumber)) logTicketEvent(issueNumber, "crashed");
      lastFailingIssue = issueNumber;
      // A lease MIGHT be held here (e.g. acquire won but claim/pipeline
      // threw). releaseIssueLease is a no-op when this host doesn't hold
      // it — including the contended-acquire throw above — so a blanket
      // release here can never yank a peer's lease.
      if (Number.isInteger(issueNumber)) {
        await deps.releaseIssueLease(issueNumber);
      }
      // Same shared STALL_RE (lib/error-classification.ts) the pipeline-catch
      // site uses: a rejection whose message matches the stall signature
      // counts toward the sandbox-health streak exactly like a stalled
      // fulfilled outcome would.
      breaker.note("error", { stalled: STALL_RE.test(msg) });
    }
    // Same durability reasoning as `settleOutcome`'s call — see its comment.
    flushTelemetry();
    return { leaseBackendFatal };
  };
    // The dealer's refill function, called at most once at a time — see
    // `dealer.ts`'s single-flight guard — whenever the stack runs dry.
    // `ctx.deal` is the dealer's own refill counter (1, 2, 3, ...), used only
    // in the run log now: it used to fill a planner prompt's `{{DEAL}}`
    // placeholder, and there is no planner prompt. The name is kept because
    // `dealer.ts`'s `plan()` seam, the run-log line and several tests all read
    // it; what it does is compute the plan, not dispatch a planner.
    const dealFromPlanner = async (ctx: {
      stackSize: number;
      deal: number;
      inFlight: readonly PlanIssue[];
    }): Promise<readonly PlanIssue[]> => {
      // Short-circuit once anything has already decided to stop — a worker
      // parked in `dealer.next()` can be woken by a sibling's `done()` and
      // re-enter a refill after `stopDealing` was already set (a breaker
      // trip, a fatal lease error, a planner fault below); without this the
      // parked worker would re-dispatch the planner for no reason while the
      // rest of the pool drains. `shuttingDown` is checked explicitly too
      // (#1191 finding A) — `onSignal` now sets `stopDealing` directly, so
      // this is belt-and-suspenders against any future path that flips
      // `shuttingDown` without going through `onSignal`.
      if (exit !== undefined || stopDealing || shuttingDown) return [];

      // Cross-host LANE SYNC hook (Task B), moved here from the top
      // of each round. Run through the merge lane so it can never interleave
      // with an in-flight merge — a lane merge and a staging reset/fast-
      // forward touching the same integration branch must never race.
      if (syncEnabled) {
        await mergeLane.enqueue(async () => {
          // Resolve the launch worktree that has the integration branch
          // checked out (where a merge must run to be visible); fall back to
          // the repo root.
          const launchWt =
            findWorktreeForBranch(args.repoRoot, args.branch)?.path ??
            args.repoRoot;
          const syncResult: LaneSyncResult = await deps.syncLanes(
            args.branch,
            launchWt,
          );
          for (const peer of syncResult.peers) {
            if (peer.status === "merged") {
              deps.log(
                `[lane] synced peer ${peer.peer} → ${args.branch} (merged)`,
              );
            } else if (peer.status === "skipped") {
              deps.log(
                `[lane] skipped peer ${peer.peer}: ${peer.reason ?? "(no reason)"} — continuing`,
              );
            } else {
              // conflict — LOUD, durable run-log signal. Stop THIS lane
              // (below) rather than continue planning/building on code that
              // never got the peer's changes merged in.
              deps.logError(
                `[lane] CONFLICT merging peer ${peer.peer} into ${args.branch}` +
                  `${
                    peer.conflictedFiles && peer.conflictedFiles.length > 0
                      ? ` (files: ${peer.conflictedFiles.join(", ")})`
                      : ""
                  } — NOT merged. Stopping this lane rather than building on an ` +
                  `un-synced tip. A human should reconcile the two lanes, then ` +
                  `resume the run.`,
              );
              laneConflictStop = true;
            }
          }
          if (!laneConflictStop) {
            // Cross-host STATUS SYNC (Task S5), also moved here.
            // Observability only — fails SOFT (never throws).
            await syncStatusOnce(statusStore, deps);
          }
        }, "sync-lanes");
        if (laneConflictStop) {
          stopDealing = true;
          return [];
        }
      }

      statusStore.setActivity("planning");

      // Phase 1: the plan (or the one-shot bypass)
      let plan: PlanIssue[];
      // Per-issue required-skills lookup, populated below if SANDCASTLE.md
      // exists AND the planner returned issues to dispatch. Empty map means
      // "skill discipline disabled for this iteration" — runImplementer
      // receives `undefined` for opts.requiredSkills and its gate is a no-op.
      // Lives in the iteration scope (not the planner-else scope) so the
      // parallel dispatch below can read it without var-hoisting tricks.
      let perIssueRequiredSkills: ReadonlyMap<string, readonly string[]> =
        new Map();
      if (args.issue !== undefined) {
        // Fetch the real ticket title so the live viewer and the run log show
        // it instead of the placeholder "issue #N" (issue #1207, item 8). The
        // placeholder stays as the fallback: a `gh` failure must not stop a
        // one-shot run, so on any error the card keeps "issue #N".
        let oneShotTitle = `issue #${args.issue}`;
        try {
          const titleOut = execFileSync(
            "gh",
            [
              "issue",
              "view",
              String(args.issue),
              "--json",
              "title",
              "--jq",
              ".title",
            ],
            // A 30s cap so a `gh` HANG (auth stall, network black-hole) throws
            // into the catch below and falls back to the placeholder, rather
            // than blocking the one-shot run before it starts (issue #1207
            // review, minor 2). A plain failure was already caught; a hang was
            // not.
            { encoding: "utf8", cwd: args.repoRoot, timeout: 30_000 },
          ).trim();
          if (titleOut.length > 0) oneShotTitle = titleOut;
        } catch (err) {
          deps.log(
            `one-shot: could not fetch title for issue #${args.issue}: ` +
              `${(err as Error).message} — using placeholder`,
          );
        }
        plan = [
          {
            id: String(args.issue),
            title: oneShotTitle,
            branch: `agent/issue-${args.issue}`,
          },
        ];
        // One-shot mode bypasses the planner but still needs the type:X
        // label + required-skills lookup for the skill-discipline gate and
        // the builder/reviewer prompts. Fetch the
        // issue's labels directly via gh and populate the per-issue maps.
        if (sandcastleMdExists) {
          try {
            const ghOut = execFileSync(
              "gh",
              [
                "issue",
                "view",
                String(args.issue),
                "--json",
                "labels",
                "--jq",
                "[.labels[].name]",
              ],
              { encoding: "utf8", cwd: args.repoRoot },
            ).trim();
            const oneShotLabels = JSON.parse(ghOut) as string[];
            const typeLabel = oneShotLabels.find((l) => l.startsWith("type:"));
            if (typeLabel !== undefined) {
              const req = requiredSkillsByType.get(typeLabel);
              const builtReq = new Map<string, readonly string[]>();
              if (req !== undefined) builtReq.set(String(args.issue), req);
              perIssueRequiredSkills = builtReq;
              deps.log(
                `one-shot: issue #${args.issue} type=${typeLabel}` +
                  ` requiredSkills=[${req?.join(", ") ?? "(unknown type)"}]`,
              );
            }
          } catch (err) {
            deps.log(
              `one-shot: failed to fetch labels for issue #${args.issue}: ` +
                `${(err as Error).message} — skill-discipline gate will skip`,
            );
          }
        }
      } else {
        // ===================================================================
        // THE PLANNER, AS CODE (2026-09-03). There is no planner agent.
        //
        // Everything this block used to ask an LLM for — drop the blocked,
        // drop the untyped, sort by priority then issue number, cap at the
        // stack size — is arithmetic, so an agent added nothing but its own
        // mistakes. It made two on 2026-09-03, an hour apart, on the SAME
        // queue: it dealt #1065 while #1065's own first line read
        // `Blocked-by: #1038` and #1038 was open, and then it dropped #1038
        // itself (blockers #1028 and #1056 both closed) on the theory that
        // "#1065, #1038 and #811 form a chain of dependencies on each other".
        // The code gate shipped for the first miss could only SUBTRACT, so it
        // could not repair the second. Now the host computes the whole answer.
        //
        // The rules live in `lib/state/eligible-set.ts` — small, pure and
        // unit-tested against that exact queue — and the prompt file they used
        // to be written in (`plan-prompt.md`) is deleted.
        // ===================================================================
        const open = await readOpenIssuesForPlanning();

        // A listing AT its `gh --limit` cap may be missing rows, so "absent"
        // stops meaning "closed" and starts meaning "cannot see it" — for a
        // candidate AND for every blocker a candidate names. This used to be
        // the planner's `<truncation-halt/>` sentinel, a string the agent was
        // asked to print about its own input; it is a comparison now.
        if (open.length >= GH_OPEN_ISSUE_LIST_LIMIT) {
          const msg =
            `${ELIGIBLE_SET_FAILURE}: the open-issue listing came back at its ` +
            `${GH_OPEN_ISSUE_LIST_LIMIT}-row cap, so a \`Blocked by:\` blocker ` +
            `may be invisible and no ticket can be proven unblocked. Refusing ` +
            `to plan — dispatching now would either deal a blocked ticket or ` +
            `end the run reporting a healthy, empty queue. Close some issues, ` +
            `or raise GH_OPEN_ISSUE_LIST_LIMIT in .sandcastle/main.mts and ` +
            `\`listOpenIssuesWithBodies\` in .sandcastle/lib/state/gh.ts together.`;
          deps.logError(msg);
          throw new Error(msg);
        }

        const decided = planDeterministic({
          openIssues: open,
          readyLabel: args.label,
          skillDisciplineOn: sandcastleMdExists,
          stackSize: ctx.stackSize,
          inFlight: ctx.inFlight,
        });
        plan = [...decided.issues];
        // Held for the drained exit's operator note, so the message and the
        // decision are the same list rather than two readings of one rule.
        lastPlanExclusions = decided.excluded;
        for (const e of decided.excluded) {
          deps.log(`skipping issue #${e.number} — ${e.reason}`);
        }

        // Per-issue `type:X` label + required-skills lookup for the
        // skill-discipline gate and the builder/reviewer prompts, read off the SAME listing the plan came from rather than a
        // second `gh` call. `eligibleForPlanning` has already refused anything
        // without exactly one `type:` label when skill discipline is on, so
        // every kept ticket here has one to find.
        if (sandcastleMdExists && plan.length > 0) {
          const labelsByNumber = new Map(open.map((i) => [i.number, i.labels]));
          const built = new Map<string, readonly string[]>();
          for (const pick of plan) {
            const labels = labelsByNumber.get(Number(pick.id)) ?? [];
            const typeLabel = labels.find((l) => l.startsWith("type:"));
            if (typeLabel === undefined) continue;
            // Empty list (type:cleanup) and "no matching section" both make the
            // gate a no-op for that ticket — but they are distinct: an empty
            // list is an explicit "none required", while a missing entry means
            // the type is unknown to SANDCASTLE.md (graceful degradation), so
            // only KNOWN types get a map entry and unknown ones stay on the
            // `undefined` no-op path.
            const req = requiredSkillsByType.get(typeLabel);
            if (req === undefined) continue;
            built.set(pick.id, req);
          }
          perIssueRequiredSkills = built;
        }
      }

      deps.log(`dealer refill #${ctx.deal}: ${plan.length} issue(s) ranked`);
      // #1191 finding G, kept DELIBERATELY REDUNDANT. `setPlan` used to run
      // over the raw plan before the dealer's own dedup against
      // `ctx.inFlight` (`dealer.ts`'s `refillOnce`), so a re-offered
      // already-building ticket was never dispatched twice (the dealer's
      // `seen` set drops it) but the viewer's status feed flipped its row back
      // to "planned" — wrong, since it is still building.
      //
      // `planDeterministic` now drops `inFlight` itself, so on the planning
      // road this filter has nothing left to remove. It stays because
      // `setPlan` must agree with the dealer about what is in flight no
      // matter WHICH road filled `plan` — the `--issue N` one-shot road above
      // never goes near `planDeterministic` — and because the cost is one
      // `Set` lookup per card.
      const inFlightIds = new Set(ctx.inFlight.map((c) => c.id));
      statusStore.setPlan(
        plan
          .filter((p) => !inFlightIds.has(p.id))
          .map((p) => ({
            number: Number(p.id),
            title: p.title,
            branch: p.branch,
          })),
      );
      for (const p of plan) {
        deps.log(`  ${p.id}: ${p.title} → ${p.branch}`);
      }

      // What every ticket dealt so far (in flight, plus this fresh refill) is
      // building, so each ticket's check-writer can write a check that
      // survives its neighbours landing. #902: was computed once per ROUND
      // over that round's whole batch; the rolling pool has no batch, so this
      // recomputes on every refill over the union of what's currently in
      // flight and what was just dealt, and REPLACES the shared run-scoped
      // snapshot each worker reads from when it builds its `PipelineCtx` —
      // close enough for a fail-soft prompt input (`collectSiblingBriefs`
      // argues both the batching and the fail-soft-ness).
      currentSiblingBriefs = await collectSiblingBriefs(
        [...ctx.inFlight, ...plan],
        {
          getIssueBody: deps.getIssueBody?.bind(deps),
          logError: deps.logError,
        },
      );
      for (const [k, v] of perIssueRequiredSkills)
        perIssueRequiredSkillsAll.set(k, v);
      return plan;
    };

    // Re-checked immediately before a worker is handed a card — the stack
    // can go stale between when it was dealt and when a worker actually gets
    // to it (a blocker reopened, its labels changed since the last refill).
    //
    // #902 DESIGN NOTE, departing from the plan's literal sketch. The sketch
    // wanted TWO separate re-checks per dealt card: (1) is the card still
    // listed at all under `ready-for-agent` (a claim-race check), and (2)
    // does it still carry exactly one `type:` label (the skill-discipline
    // gate). `stillDealable` below makes exactly ONE `gh` round-trip per
    // dealt card — `deps.listIssuesByLabel(args.label)` — and reuses that
    // ONE listing for BOTH checks, rather than the sketch's two separate
    // calls. (1) is redundant on its own terms anyway — claiming an issue
    // flips its label `ready-for-agent` → `in-progress` (`claimViaLabel`,
    // `lib/state/gh.ts`), so a card another host already claimed simply
    // fails the lease-acquire gate right after this, exactly like today, and
    // a card no longer listed under this call is treated as "still
    // dealable" for exactly that reason (see the comment below). Kept: (2),
    // the `type:` label re-check, since a label CAN legitimately change
    // between a card being dealt and a worker reaching it, and unlike a
    // claim-race it has no other gate downstream to catch it. The original
    // round-based code never made this call per-issue either — only once
    // per ROUND, for the type-label gate.
    const stillDealable = async (card: PlanIssue): Promise<boolean> => {
      // BLOCKED-BY GATE, deal-time half (2026-09-03) — and this is the half
      // that matters most. A `Blocked-by:` dependent can sit on the dealer's
      // stack for HOURS while its blocker is in flight, so a plan-time check
      // alone would let it through the moment a worker frees up. Runs BEFORE
      // the `sandcastleMdExists` early-return below, since the blocker rule
      // has nothing to do with skill discipline. `blockedByGate` never
      // throws (it fails closed internally), so the dealer's own
      // treat-a-throw-as-valid rule can never turn this into a fail-open.
      if (args.issue === undefined) {
        const gate = await blockedByGate([Number(card.id)], deps, {
          fetchOpen: () => openIssueMemo.read(),
        });
        // A blind gate here cannot throw the way the plan-time half does — a
        // throw out of `validate` is caught by the dealer and treated as
        // VALID (fail-open), which is the one outcome that must never happen.
        // So the card is still refused, and the run REMEMBERS that it was
        // refused blindly: `blockerGateBlind` turns the otherwise-clean
        // drained exit into an unhealthy, non-zero one further down.
        if (gate.unreadable) {
          blockerGateBlind = gate.failure ?? "unknown";
        }
        const reason = gate.skips.get(Number(card.id));
        if (reason !== undefined) {
          // Not claimed, not labelled: the card is dropped and the issue
          // stays `ready-for-agent` for the next refill.
          deps.log(`[blocked-by gate] #${card.id} skipped: ${reason}`);
          return false;
        }
      }
      if (!sandcastleMdExists) return true;
      const listed = await deps.listIssuesByLabel(args.label);
      const found = listed.find((i) => i.number === Number(card.id));
      // Not listed at all — most likely already claimed (see note above) or
      // closed; let the lease-acquire gate make the authoritative call
      // rather than dropping it here on a listing that can lag reality.
      if (found === undefined) return true;
      // The SAME `type:` rule runs at plan time through `eligibleForPlanning`
      // (both go through `typeLabelExclusionReason`), re-run per card here
      // since a card can sit on the stack across several refills while its
      // labels change underneath it.
      const { excluded } = filterPlanByTypeLabels(
        [card],
        new Map([[card.id, found.labels]]),
        sandcastleMdExists,
      );
      if (excluded.length > 0) {
        deps.log(`dealer: #${card.id} no longer dealable — ${excluded[0]!.reason}`);
        return false;
      }
      return true;
    };

    const allowanceGate = createAllowanceGate({
      ...(deps.poolAllowance ?? REAL_ALLOWANCE_CLOCK),
      log: deps.log,
    });
    // Attempts whose agent found the pool empty. They are released, not
    // failed, so they do not spend the run's `--iterations` ticket budget:
    // a night of waiting must not end the run before the allowance resets.
    let poolEmptyAttempts = 0;
    const ticketsCounted = (): number => iterationsRun - poolEmptyAttempts;
    const dealer = createDealer<PlanIssue>({
      stackSize: args.maxConcurrent * 2,
      deps: {
        plan: dealFromPlanner,
        validate: stillDealable,
        log: deps.log,
        // #1191 finding C: let the dealer give a just-completed merge one
        // chance to land (flipping a blocker's label) before it decides the
        // queue is drained with nothing in flight.
        pendingMerges: () => mergeLane.pending(),
        drainMerges: () => mergeLane.drain(),
      },
    });

    async function worker(): Promise<void> {
      while (!stopDealing) {
        if (shuttingDown) return;
        if (ticketsCounted() >= args.iterations) return;
        if (deps.ticketStartHook !== undefined) {
          await deps.ticketStartHook(iterationsRun + 1);
        }
        // Hot-reload detector: if any statically-imported file changed on
        // disk since startup, stop dealing and exit cleanly (code 75) once
        // the pool drains so the wrapper can relaunch with fresh imports.
        const changed = detectImportedFileChange(
          args.repoRoot,
          importedFilesSnapshot,
        );
        if (changed !== null) {
          deps.log(
            `[sandcastle] tracked file changed on disk: ${changed}. ` +
              `Exiting with code 75 so the wrapper can restart with fresh imports.`,
          );
          hotReload = true;
          stopDealing = true;
          return;
        }

        // Every pooled account is out (build plan 4.5): hold here until the
        // soonest reset rather than deal a ticket that cannot run.
        await allowanceGate.waitWhileClosed(() => shuttingDown || stopDealing);
        if (shuttingDown || stopDealing) return;
        const card = await dealer.next();
        if (card === null) {
          drained = true;
          return;
        }
        // #1191 finding A: `dealer.next()` can park this worker and only
        // resolve once a sibling's `done()` wakes it — arbitrarily long
        // after the `shuttingDown`/cap checks at the top of this loop ran.
        // Re-check synchronously, with the card already in hand, before
        // this worker commits to leasing/claiming/building it. Releasing
        // it back via `dealer.done(card)` (rather than leaving it
        // in-flight) lets a still-eligible sibling pick it up instead.
        if (shuttingDown || ticketsCounted() >= args.iterations) {
          dealer.done(card);
          return;
        }
        const issueNumber = Number(card.id);
        if (!isUsableIssueNumber(issueNumber)) {
          // The SAME predicate `collectSiblingBriefs` used to filter the
          // plan a moment ago (`lib/checkwriter/check-path.ts`), so the run
          // cannot hold two answers to "is this a real issue number". A
          // prompt-context collector drops such an entry; here it is a real
          // fault someone has to be told about, so it goes through
          // `settleRejection` (the generic "pipeline rejected" branch) to
          // count toward the breaker exactly like the original round-based
          // pool's `throw` did — dropping it silently instead would leave
          // `iterationsRun` under the cap forever with nothing to show for
          // it, since a bogus id never wins a lease either: the dealer would
          // keep re-dealing the SAME bogus card from an unchanging plan with
          // no bound on the loop.
          const r = await settleRejection(
            card,
            new Error(
              `plan issue id is not a usable issue number: ${JSON.stringify(card.id)}`,
            ),
          );
          dealer.done(card);
          if (r.leaseBackendFatal) {
            latch({
              exitCode: 2,
              iterationsRun,
              shippedIssues,
              quarantinedIssues,
            });
          }
          await handleBreakerTrip();
          continue;
        }
        // Cross-host lease gate. Acquire the atomic lease BEFORE
        // the label flip — the label is last-write-wins signage, the ref is
        // the real arbiter. `acquireIssueLease` itself can throw
        // `LeaseBackendError` (an auth/network fault pushing the lease ref) —
        // that is SYSTEMIC (every push will fail), so it halts the run
        // immediately rather than counting toward the breaker at all; it
        // never even reaches `ticketsAttempted`.
        let wonLease: boolean;
        try {
          wonLease = await deps.acquireIssueLease(issueNumber);
        } catch (err) {
          if (err instanceof LeaseBackendError) {
            deps.logError(
              `Halting: cross-host lease backend authentication/network failure. ` +
                `The lease ref push cannot reach origin — fix \`gh auth setup-git\` ` +
                `/ network connectivity and re-run.`,
            );
            latch({
              exitCode: 2,
              iterationsRun,
              shippedIssues,
              quarantinedIssues,
            });
            dealer.done(card);
            return;
          }
          dealer.done(card);
          throw err;
        }
        if (!wonLease) {
          // Routine contention — a peer holds a live lease. Not a failure:
          // logged and skipped, burns no slot, counts no attempt.
          deps.log(
            `[issue=${card.id}] lease contended — another host holds it; ` +
              `skipping this ticket (not counted as a failure)`,
          );
          dealer.done(card);
          continue;
        }

        const ordinal = ++iterationsRun;
        let settled: Completed & { issueNumber: number } | undefined;
        try {
          // Claim first — this is the only place ready-for-agent →
          // in-progress flips. If claim fails we abort the pipeline.
          await deps.claim(issueNumber);
          // The open-issue listing the blocked-by gate reads just changed —
          // this issue's label flipped `ready-for-agent` → `in-progress`, and
          // any sibling that declares `Blocked-by: #this` must see that on its
          // very next deal-time check, not up to a TTL later. See
          // `openIssueMemo`'s declaration.
          openIssueMemo.invalidate();
          // Ownership record for the SHUTDOWN reconciliation (see the
          // `claimedByThisHost` declaration): this line, and only this line,
          // is where an in-progress label becomes ours to release on a stop.
          claimedByThisHost.add(issueNumber);
          // Registered in the run-scoped map so the end-of-run drain can
          // still reach it after this closure returns. Mutated in place, so
          // no `return` inside runIssuePipeline has to change.
          const bag = bagFor(issueNumber);
          // The ticket's own text, read HERE — after the claim, before any
          // agent runs — so the ship-time removal gate can honour a deletion
          // the ticket authorised without ever reading builder-authored text.
          // See `PipelineCtx.issueBody`. A gh failure degrades to `undefined`,
          // which authorises nothing; it must never abort the pipeline.
          // The same read fills every agent prompt's `{{ISSUE_SPEC}}` (spec
          // #1334, SB): title and labels from it, body from the PINNED copy
          // below, so every agent sees the same body the removal gate trusts.
          let freshIssueBody: string | undefined;
          let freshIssueMeta:
            | { readonly title: string; readonly labels: readonly string[] }
            | undefined;
          try {
            if (deps.getIssueSpec !== undefined) {
              const read = await deps.getIssueSpec(issueNumber);
              freshIssueBody = read.body;
              freshIssueMeta = { title: read.title, labels: read.labels };
            } else {
              freshIssueBody = await deps.getIssueBody?.(issueNumber);
            }
          } catch (err) {
            deps.logError(
              `[issue=${issueNumber}] could not read the issue body: ` +
                `${(err as Error).message} — no test deletion can be ` +
                `pre-authorised for this ticket.`,
            );
          }
          // #958 item 2: pin the body to the FIRST claim. A deferral retry
          // re-deals the same issue and re-reads the body; reusing the
          // first-claim copy stops a builder that edited the ticket mid-run
          // from having a `Deletes-test:` line honoured on the retry.
          const pinned = pinnedClaimBody(issueNumber, freshIssueBody);
          if (pinned.reusedFirstClaim && pinned.changedSinceFirstClaim) {
            deps.logError(
              `[issue=${issueNumber}] the ticket body CHANGED after its first ` +
                `claim this run. The loop is using the body captured on the ` +
                `first claim and ignoring the change (#958) — a test deletion ` +
                `cannot be pre-authorised mid-run.`,
            );
          }
          const issueBody = pinned.body;
          const issueSpec =
            issueBody === undefined
              ? undefined
              : renderIssueSpec({
                  title: freshIssueMeta?.title ?? card.title,
                  labels: freshIssueMeta?.labels ?? [],
                  body: issueBody,
                });
          const ctx: PipelineCtx = {
            args,
            deps,
            ticketOrdinal: ordinal,
            issueNumber,
            issue: card,
            issueBody,
            issueSpec,
            // The rest of the currently-dealt set, minus this ticket itself —
            // a ticket reading its own entry back would treat its own
            // requirements as a neighbour's constraint to steer around.
            siblingTickets: siblingBriefsExcluding(
              currentSiblingBriefs,
              issueNumber,
            ),
            requiredSkills: perIssueRequiredSkillsAll.get(card.id),
            status: statusStore,
            costLedger,
            timingLedger,
            issueLedger,
            telemetry: bag,
            runCounters,
            allowanceGate,
            // The first test's ONE rewrite (spec #1334). Minted here, at the
            // one place a ticket begins, so every refusal site spends the
            // SAME one however the night goes.
            firstTestRewriteSpent: { current: false },
            // LAYER 1 (issue #1118). Minted empty here, at the one place a
            // ticket begins, and filled by `runCheckWriterStage` the moment a
            // check is accepted. Held in memory precisely because no
            // dispatched agent can reach it.
            frozenCheck: { current: undefined },
          };
          const outcome = await runIssuePipeline(ctx);
          if (outcome.finalMarker === "POOL_EMPTY") poolEmptyAttempts++;
          // Authoritative terminal state + totals for the viewer, written the
          // instant THIS issue's pipeline resolves — see the original Phase-2
          // note this replaced for the full "why here" reasoning.
          shipTimeAccounting(statusStore, issueNumber, outcome, deferredOkOutcomes);
          settled = { issue: card, outcome, issueNumber };
        } catch (err) {
          const r = await settleRejection(card, err);
          if (r.leaseBackendFatal) {
            latch({
              exitCode: 2,
              iterationsRun,
              shippedIssues,
              quarantinedIssues,
            });
          }
        } finally {
          dealer.done(card);
        }
        if (settled) await settleOutcome(settled);
        await handleBreakerTrip();
      }
    }

    const workerResults = await Promise.allSettled(
      Array.from({ length: args.maxConcurrent }, () => worker()),
    );
    await mergeLane.drain();
    const firstThrow = workerResults.find((r) => r.status === "rejected");
    if (firstThrow) throw (firstThrow as PromiseRejectedResult).reason;

    if (hotReload) {
      const remaining = args.iterations - ticketsCounted();
      writeFileSync(
        path.join(args.repoRoot, ".sandcastle/.restart-remaining"),
        String(remaining),
        "utf8",
      );
      // Hot-reload: the wrapper will relaunch with fresh imports, so mark the
      // feed "restarting" (not "done") — the viewer keeps the run visible
      // rather than showing it as completed.
      statusStore.finish("restarting");
      // Skip finishRun in the `finally` below: this is a mid-run relaunch on
      // the SAME branch, not a completed run. openDraftPr never edits an
      // existing PR's body, so opening one now would freeze its `Closes #N`
      // list at whatever is certified at THIS restart and silently miss
      // everything the loop ships after relaunching.
      isHotReloadRestart = true;
      return {
        exitCode: 75,
        iterationsRun,
        shippedIssues,
        quarantinedIssues,
      };
    }

    if (exit) {
      // Every `latch()` site funnels through here for the terminal status
      // write. #902 DELIBERATE FIX: the original round-based stall-abort
      // path (now `handleBreakerTrip`'s "stall" branch) returned its exit-3
      // result WITHOUT ever calling `statusStore.finish` — every other abort
      // path did, so a stalled run's status ref was left frozen on
      // `state: "running"` forever, the exact bug issue #969 fixed for the
      // OTHER abort paths. Unifying every latch through one `finish` call
      // here closes that gap for the stall path too, for free, rather than
      // reproducing the omission.
      statusStore.finish("unhealthy");
      return exit;
    }

    if (laneConflictStop) {
      deps.logError(
        `stopped after ${iterationsRun} ticket(s) — an unresolved lane ` +
          `conflict was detected merging a peer host's branch into ` +
          `${args.branch}; exiting unhealthy (code 1) instead of continuing ` +
          `to build on the un-synced tip. See the [lane] CONFLICT line above ` +
          `for the peer + conflicted files. A human must reconcile the two ` +
          `lanes before this host resumes.`,
      );
      statusStore.finish("unhealthy");
      return {
        exitCode: 1,
        iterationsRun,
        shippedIssues,
        quarantinedIssues,
      };
    }
    if (promotionFailed && !shuttingDown) {
      deps.logError(
        `out of tickets (${args.iterations}) — but a final promotion FAILED ` +
          `earlier; exiting unhealthy (code 1). Certified work is stranded on ` +
          `${STAGING_BRANCH}.`,
      );
      statusStore.finish("unhealthy");
      return {
        exitCode: 1,
        iterationsRun,
        shippedIssues,
        quarantinedIssues,
      };
    }

    if (drained) {
      // A DRAIN REACHED WHILE THE BLOCKED-BY GATE WAS BLIND IS NOT A CLEAN
      // DRAIN. The deal-time gate refuses every card it cannot check, which
      // empties the dealer and lands exactly here — so without this the run
      // wrote `done`, exited 0, and told a person "no claimable issues —
      // exiting cleanly" on the strength of a `gh` outage. Checked before the
      // note below because the note's own `gh` call would fail too.
      if (blockerGateBlind !== undefined) {
        deps.logError(
          `stopped after ${iterationsRun} ticket(s) — the queue looks empty, ` +
            `but the Blocked-by gate could not read the open-issue listing ` +
            `(${blockerGateBlind}), so every remaining ticket was refused ` +
            `WITHOUT being checked. That is a broken instrument, not an empty ` +
            `queue; exiting unhealthy (code 1). Fix \`gh\` access and re-run — ` +
            `nothing was claimed or relabelled, so the tickets are all still ` +
            `${LABEL_READY}.`,
        );
        statusStore.finish("unhealthy");
        return {
          exitCode: 1,
          iterationsRun,
          shippedIssues,
          quarantinedIssues,
        };
      }
      // Issue E: the plan silently drops issues whose body declares
      // `Blocked by: #N`, or that are missing a `type:` label. Surface those
      // at the clean exit so the operator can tell "nothing ready" from
      // "everything ready is held back".
      //
      // Fed from the LAST REFILL'S OWN `excluded` list (2026-09-03), so the
      // message and the decision are one list read once, not two readings of
      // one rule. The re-fetch below is the fallback for the one road that
      // never planned: `--issue N`, which bypasses planning entirely.
      let note = "";
      if (lastPlanExclusions !== undefined) {
        note = buildEligibilityNote(lastPlanExclusions);
      } else {
        // A gh failure here must NOT crash the clean exit — fall back to plain.
        try {
          const open = await deps.listOpenIssuesWithBodies();
          note = buildBlockedByNote(open, args.label);
        } catch (err) {
          deps.log(
            `blocked-by scan skipped: listOpenIssuesWithBodies failed: ${
              (err as Error).message
            }`,
          );
        }
      }
      deps.log(`no claimable issues — exiting cleanly${note}`);
      // Clean terminal exit (queue drained) — the common overnight-completion
      // path. `promotionFailed` cannot be true here without `laneConflictStop`
      // or the `exit` latch having already returned above first, but the
      // check is kept as a direct translation of the original round-based
      // exit (issue audit #4) rather than an inference about the new control
      // flow's reachability.
      if (promotionFailed) {
        statusStore.finish("unhealthy");
        return {
          exitCode: 1,
          iterationsRun,
          shippedIssues,
          quarantinedIssues,
        };
      }
      // The run PR is opened uniformly for every termination path by the
      // `finally` block around the main loop below — not here. #1191 finding
      // A: a parked worker woken by a sibling's `done()` after `shuttingDown`
      // was set refills empty (dealFromPlanner now short-circuits on it) and
      // this drains — that is an OPERATOR-INTERRUPTED run, not a healthy
      // "queue empty" completion, so it must report "stopped"/exit 2 exactly
      // like the cap-reached path below, not "done"/exit 0.
      statusStore.finish(shuttingDown ? "stopped" : "done");
      return {
        exitCode: shuttingDown ? 2 : 0,
        iterationsRun,
        shippedIssues,
        quarantinedIssues,
      };
    }

    deps.log(
      `ticket cap reached (${args.iterations}) — exiting with code 2 (clean — just out of tickets)`,
    );
    // The run PR is opened uniformly for every termination path (including
    // an operator-interrupted run) by the `finally` block below.
    // Completion path. A clean cap-reached / drained-queue exit is "done". A
    // SIGINT/SIGTERM `shuttingDown` break also falls through here — label
    // that run "stopped" so the viewer shows its stopped banner instead of a
    // false "done — loop finished" for an interrupted run.
    statusStore.finish(shuttingDown ? "stopped" : "done");
    return {
      exitCode: 2,
      iterationsRun,
      shippedIssues,
      quarantinedIssues,
    };
  } catch (err) {
    // EVERY THROW OUT OF THE RUN LOOP STAMPS THE STATUS FILE.
    //
    // Nine `statusStore.finish(...)` calls sit on the RETURN paths above, and
    // none of them is reachable from a throw — so a run that ended by throwing
    // left `status.json` on `state: "running"` forever, with its heartbeat
    // stopped. The viewer then showed a dead run as live, and the stall
    // watchdog (which only acts on `state === "running"`) had a permanent
    // ghost to watch. That is issue #969's bug, and it came back the moment
    // the truncation road stopped latching `exitCode: 2` and started throwing
    // `ELIGIBLE_SET_FAILURE` instead.
    //
    // ONE catch rather than a `finish` before each throw, deliberately: the
    // two `ELIGIBLE_SET_FAILURE` sites are not the only way this block can
    // throw (a worker's rejection is re-thrown at `firstThrow`, and anything
    // uncaught inside the pool unwinds through here), and a per-site stamp
    // would have to be remembered again by whoever adds the next throw.
    //
    // "unhealthy" is the honest label for all of them: a throw is never a
    // completed run. The stamp itself is wrapped so a status-write fault can
    // never replace the real error with its own, and the original error is
    // re-thrown unchanged so the CLI entry point still exits non-zero.
    try {
      statusStore.finish("unhealthy");
    } catch (stampErr) {
      deps.logError(
        `statusStore.finish("unhealthy") failed while unwinding a fatal ` +
          `error: ${(stampErr as Error).message}. The run still exits ` +
          `non-zero; only the status file's terminal state is missing.`,
      );
    }
    throw err;
  } finally {
    // Backstop commit for the durable rework lines, and it MUST run BEFORE
    // `finishRun()` below. The per-iteration commit covers every EARLY RETURN,
    // but not a THROW: the unguarded `releaseIssueLease` awaits in the
    // accounting loop sit between the append and that commit, so a throw there
    // unwinds past it and leaves the JSONL uncommitted — which strands the next
    // fast-forward. ORDERING IS THE WHOLE POINT: `finishRun` is what pushes the
    // branch to origin, so a telemetry commit made after it never reaches the
    // remote and dies with the local branch when that branch is reaped.
    // Deliberately OUTSIDE the `isHotReloadRestart` guard below: on exit 75 the
    // JSONL is still sitting uncommitted on disk and would still strand the
    // relaunched run's first promotion. A no-op whenever the iteration already
    // committed (`reworkPendingCommit` is false), so the normal path costs
    // nothing, and it cannot throw.
    commitReworkRecords();
    // Finish-and-PR — see finishRun's docstring. Runs on EVERY way the try
    // above can end: the clean/out-of-iterations returns above (which no
    // longer call it directly), the circuit breaker, the sandbox
    // stall-streak abort, the two `ELIGIBLE_SET_FAILURE` planning roads, and
    // any uncaught exception thrown from within the try — `finally` runs
    // after the `catch` above has stamped the status file and before the
    // exception continues propagating to the CLI entrypoint's
    // own catch. Skipped only for a hot-reload restart (exit 75 — a
    // mid-run relaunch, not a completed run; see that return site).
    // finishRun never throws, so it can't mask the real exit code or an
    // in-flight exception. It CANNOT run after SIGKILL — that has no
    // in-process cleanup of any kind.
    if (!isHotReloadRestart) {
      await finishRun();
    }
    // Phase-1 cost telemetry: log the per-role breakdown + total and sink the
    // total into status.json. Runs on EVERY exit path (this is the one hook all
    // paths pass through), AFTER `finish()` has stamped the terminal state — a
    // trailing synchronous commit that just adds `totals.totalCostUsd`. Purely
    // best-effort: an estimate for relative comparison, wrapped so a telemetry
    // hiccup can never mask the real exit.
    try {
      const cost = costLedger.summary();
      if (
        Object.keys(cost.perRole).length > 0 ||
        cost.unpricedModels.length > 0
      ) {
        deps.log(formatCostSummary(cost));
      }
      if (cost.totalCostUsd > 0) statusStore.recordCost(cost.totalCostUsd);
      // Phase-2 per-role breakdown: merge the cost summary (per-role dollars +
      // total tokens) with the timing summary (per-role wall-clock ms + dispatch
      // count) keyed by role, and sink it into status.json. Additive + optional —
      // only persisted when the merged record is non-empty, so a no-capture /
      // nothing-dispatched run leaves `totals.perRole` absent (backward-compat).
      const timing = timingLedger.summary();
      const perRole: Record<string, RoleBreakdown> = {};
      for (const [role, r] of Object.entries(cost.perRole)) {
        const e = (perRole[role] ??= {});
        e.costUsd = r.costUsd;
        e.tokens = totalTokens(r.tokens);
      }
      for (const [role, t] of Object.entries(timing)) {
        const e = (perRole[role] ??= {});
        e.wallMs = t.wallMs;
        e.runs = t.runs;
      }
      if (Object.keys(perRole).length > 0)
        statusStore.recordRoleBreakdown(perRole);
      // Phase-3 per-model breakdown: the ledger already knows which model ran
      // each call, so a role that escalated mid-run (default model failed,
      // retried on a stronger one) shows up as more than one row here — the
      // rows are sorted most-called-first per role, so the default model (the
      // one that ran the most) leads and anything after it is the escalation.
      // Flattened the same way perRole's tokens are, and additive + optional
      // on the same "empty means absent" contract.
      const perModel: ModelBreakdownRow[] = cost.perModel.map((m) => ({
        role: m.role,
        model: m.model,
        costUsd: m.costUsd,
        tokens: totalTokens(m.tokens),
        calls: m.calls,
      }));
      if (perModel.length > 0) statusStore.recordModelBreakdown(perModel);
      // Per-issue + per-run telemetry. `totals.perRole` above deliberately
      // keeps its FLATTENED token count (the schema types it as one number and
      // the viewer reads it); the unflattened 4-way split lives in
      // `runTelemetry.tokenEfficiency`, which is what makes cache-hit ratio and
      // cache-write waste recoverable at all.
      flushTelemetry();
    } catch (err) {
      deps.logError(`cost summary skipped: ${(err as Error).message}`);
    }
    // Drain the live feed AFTER the cost write above, so the dashboard receives
    // the run's terminal state WITH its final cost. Without this the process
    // can exit while that last request is still in flight — which is precisely
    // the update the pull-based surfaces can never provide. Best-effort and
    // time-boxed; it cannot throw and cannot delay exit beyond the request
    // timeout.
    await statusStore.flushPush();
    // Always stop the lease heartbeat, on every exit path (clean, error,
    // circuit-breaker return, hot-reload). undefined when the lease is off.
    if (leaseHeartbeat) clearInterval(leaseHeartbeat);
    process.off("SIGINT", sigintHandler);
    process.off("SIGTERM", sigtermHandler);
    // On a genuine stop (SIGINT/SIGTERM), release every lease this host still
    // holds so a peer can reclaim those issues immediately instead of waiting
    // out the 15-min TTL. Gated on `shuttingDown` so a hot-reload
    // (exit 75) or circuit-breaker error return does NOT hand off mid-work —
    // those restart/return on the SAME host. No-op when the lease is off.
    // Best-effort: a failed release self-heals via the TTL, so it must never
    // mask the real exit.
    if (shuttingDown) {
      try {
        await deps.releaseAllLeases();
      } catch (err) {
        deps.logError(
          `releaseAllLeases on shutdown failed: ${(err as Error).message} ` +
            `(leases will auto-expire via TTL)`,
        );
      }
      // …and release the GITHUB LABELS the leases' issues are still wearing.
      // The lease is the machines' arbiter; the `in-progress` LABEL is what the
      // ops dashboard reads, so releasing one without the other left the board
      // reporting "being built now" for hours after a stop (2026-08-05:
      // #803/#838/#839/#840, stopped 16:11, still claimed at 19:30).
      //
      // ORDER IS LOAD-BEARING — this runs AFTER releaseAllLeases on purpose.
      // The live-lease guard inside treats a LIVE lease as "a peer owns this,
      // leave it alone", and until the call above deletes them, THIS host's own
      // leases are live: checking first would skip every label we hold.
      //
      // Gated on `shuttingDown` exactly like the lease release: a hot-reload
      // (exit 75) or circuit-breaker return restarts on the SAME host and still
      // owns the work, so it must keep its labels. Best-effort — the helper
      // never throws, and this belt-and-braces catch guarantees a stop is never
      // masked by label bookkeeping.
      try {
        await releaseHeldLabelsOnShutdown({
          deps,
          claimed: claimedByThisHost,
          leaseEnabled,
        });
      } catch (err) {
        deps.logError(
          `shutdown reconciliation failed: ${(err as Error).message} ` +
            `(the next launch's startup reconciliation releases the labels)`,
        );
      }
    }
    if (releaseLoopLock) {
      try {
        await releaseLoopLock();
      } catch (err) {
        // Best-effort — the 60s stale TTL on proper-lockfile means a
        // failed release here won't permanently wedge the next restart.
        deps.logError(
          `release loop lock failed: ${(err as Error).message} (lock will auto-expire in 60s)`,
        );
      }
    }
  }
}

// ---------------------------------------------------------------------------
// CLI entry
// ---------------------------------------------------------------------------

/** Detect whether this file is being run directly as a script. */
function isMain(): boolean {
  if (typeof process.argv[1] !== "string") return false;
  // Resolve via URL to handle symlinks / .mts paths consistently.
  try {
    const argv1 = path.resolve(process.argv[1]);
    const here = path.resolve(new URL(import.meta.url).pathname);
    return argv1 === here;
  } catch {
    return false;
  }
}

if (isMain()) {
  void (async (): Promise<void> => {
    let parsed: { args: SandcastleArgs; showHelp: boolean };
    try {
      parsed = parseSandcastleArgs(process.argv.slice(2));
    } catch (err) {
      process.stderr.write(`error: ${(err as Error).message}\n\n${HELP_TEXT}`);
      process.exit(2);
    }
    if (parsed.showHelp) {
      process.stdout.write(HELP_TEXT);
      process.exit(0);
    }
    const { args } = parsed;

    // Load .env BEFORE preflight so provider keys are visible to envForModel.
    // Real shell exports still win — loadDotenv only fills in missing keys.
    loadDotenv(args.repoRoot);

    // Load the project's settings (.sandcastle/project.json) once, before
    // anything reads them. A missing file is every default; an INVALID file
    // stops the launch here with a message naming the bad key, because a
    // silently ignored typo could turn a safety gate off.
    try {
      setProjectConfig(loadProjectConfig(args.repoRoot));
    } catch (err) {
      process.stderr.write(`error: ${(err as Error).message}\n`);
      process.exit(2);
    }

    // Make the sandbox image current BEFORE preflight (which only inspects it,
    // side-effect free) and before any ticket is claimed: build it when missing,
    // rebuild when its Claude Code is older than the host's. A failed build
    // stops the run here; never run on a stale image silently. Spec #1368.
    const imageBoot = await bootSandboxImage(
      {
        imageName: args.imageName,
        sandbox: args.sandbox,
        dryRun: args.dryRun,
        // The one-loop lock is only taken later, inside runMain: ask the
        // server now, or a second launch rebuilds under the live loop.
        otherLoopRunning: anotherLoopRunsOnThisServer,
      },
      productionSandboxImageDeps(args.repoRoot),
      stderrImageBootLog,
    );
    if (!imageBoot.ok) process.exit(2);

    const pre = preflight(args);
    if (!pre.ok) {
      process.stderr.write(`pre-flight checks failed:\n`);
      for (const e of pre.errors) process.stderr.write(`  - ${e}\n`);
      process.exit(2);
    }

    // Code the loop writes must never land under the owner's name. See
    // `ensureAgentGitIdentity`. After preflight (which is pure by contract) and
    // before any host-side commit or merge this run makes.
    ensureAgentGitIdentity(args.repoRoot);

    if (args.allowDirtySandcastle) {
      // Make the bypass loud so it doesn't quietly become habit.
      process.stderr.write(
        "WARN: launched with --allow-dirty-sandcastle. The " +
          ".sandcastle/main.mts dirty-check was skipped. Verify your " +
          "local changes are committed before the next /sandcastle-update " +
          "or they will be clobbered.\n",
      );
    }

    if (args.allowUnreachableSandboxDb) {
      // Same discipline as the bypass above: loud, so it is visible in the run
      // log of whatever night it silently costs.
      process.stderr.write(
        "WARN: launched with --allow-unreachable-sandbox-db. Nothing has " +
          "confirmed the sandbox can reach the test database. If it cannot, " +
          "no check can run — and since #1198 that does not stop a ticket " +
          "early, it makes every ticket cost more: each one falls through " +
          "the check-writer stage, spends a full builder and reviewer pass " +
          "anyway, and ships (if at all) on the reviewer's word alone, " +
          "labelled shipped-without-first-test.\n",
      );
    }

    if (args.allowUnreachableDevBind) {
      // Same discipline as the bypass above: loud, so it is visible in the run
      // log of whatever night it silently costs.
      process.stderr.write(
        "WARN: launched with --allow-unreachable-dev-bind. Nothing has " +
          "confirmed the sandbox's dev server can bind its listen address. If " +
          "it cannot (the F12 class — a host-only bind address riding .env into " +
          "the sandbox), no browser check can run. Since #1198 that does not " +
          "stop those tickets early: every browser/screen ticket falls " +
          "through the check-writer stage, spends a full builder and " +
          "reviewer pass against an environment that cannot run a browser " +
          "check, and ships (if at all) on the reviewer's word alone, " +
          "labelled shipped-without-first-test.\n",
      );
    }

    const deps = buildDefaultDeps(args);

    // Defensive worktree-health pass (audit issue #1). A single corrupt git
    // worktree (e.g. a `00000000` dir) makes the vendored SDK's
    // `WorktreeManager.create -> listWorktrees` throw with no catch, killing
    // the whole loop on the FIRST createSandbox. We can't patch the SDK, so
    // prune the bad entry here — before staging + the first sandbox. This is
    // best-effort and NEVER throws.
    pruneCorruptWorktrees(args.repoRoot, deps.log);

    // Set up the dedicated staging worktree before runMain so the merger
    // phase always has a valid cwd that ISN'T the launch worktree. This is
    // load-bearing: without it the merger writes to the launch HEAD and
    // strands every post-iter-1 commit on `integration-candidate`.
    if (args.stagingEnabled) {
      try {
        stagingWorktreePath = await ensureStagingWorktree(
          args.repoRoot,
          args.branch,
          deps.log,
        );
        // 2026-09-04 loop-config fix: the merger and post-merge agents run in
        // this staging worktree, so it needs the loop's own Claude config
        // exactly like every per-issue sandbox does (see the createSandboxRaw
        // write above and lib/sandbox-agent-settings.ts's module doc comment).
        // Always overwritten — never into args.repoRoot, the operator's own
        // launch checkout.
        writeSandboxAgentSettings(stagingWorktreePath, {
          warn: (m) => process.stderr.write(`WARN: ${m}\n`),
        });
      } catch (err) {
        process.stderr.write(
          `staging worktree setup failed:\n  - ${(err as Error).message}\n`,
        );
        process.exit(2);
      }
    } else {
      // Under --no-staging the merger and post-merge agents run in the launch
      // checkout (args.repoRoot) under THIS machine's own Claude config —
      // nothing is written into the operator's own checkout on purpose (see
      // lib/sandbox-agent-settings.ts's module doc comment for why writing
      // there would be wrong: it is the operator's interactive checkout, not
      // a throwaway sandbox worktree).
      process.stderr.write(
        "WARN: --no-staging — the merger and post-merge agents run in the " +
          "launch checkout under this machine's own Claude config; the loop " +
          "does not write .claude/settings.local.json into args.repoRoot.\n",
      );
    }

    try {
      const result = await runMain(args, deps);
      process.exit(result.exitCode);
    } catch (err) {
      process.stderr.write(
        `fatal: ${(err as Error).stack ?? (err as Error).message}\n`,
      );
      process.exit(1);
    }
  })();
}
